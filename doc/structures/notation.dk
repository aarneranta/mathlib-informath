(; fields named by their notation: 1 as a constant, inversion as a unary operation ;)

UOper : Set -> Type.
appUOper : (A : Set) -> (op : UOper A) -> Elem A -> Elem A.

Group2__structure : (G : Set) -> (h : Proof (Monoid G)) -> ({|{-1}|} : UOper G) ->
  (inv_mul_cancel : Proof (forall G (a => Eqt G (mul G (appUOper G {|{-1}|} a) a) one))) -> Structure.

Monoid2__structure : (M : Set) -> (h : Proof (Semigroup M)) -> ({|1|} : Elem M) ->
  (one_mul : Proof (forall M (a => Eqt M (mul M {|1|} a) a))) ->
  (mul_one : Proof (forall M (a => Eqt M (mul M a {|1|}) a))) -> Structure.
