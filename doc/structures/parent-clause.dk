(; Option B: the parent as a clause, its operations as Lean's instances give them ;)

mul : (G : Set) -> Elem G -> Elem G -> Elem G.

Monoid__structure : (M : Set) -> (h : Proof (Semigroup M)) -> (one : Elem M) ->
  (one_mul : Proof (forall M (a => Eqt M (mul M one a) a))) ->
  (mul_one : Proof (forall M (a => Eqt M (mul M a one) a))) -> Structure.

CommGroup__structure : (G : Set) -> (h : Proof (Group G)) ->
  (mul_comm : Proof (forall G (a => forall G (b => Eqt G (mul G a b) (mul G b a))))) -> Structure.

CommSemigroup__structure : (G : Set) -> (h : Proof (Semigroup G)) ->
  (mul_comm : Proof (forall G (a => forall G (b => Eqt G (mul G a b) (mul G b a))))) -> Structure.
