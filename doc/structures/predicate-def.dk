(; Option D: the class as a predicate of its carrier, defined by its parent and its new fields ;)

mul : (G : Set) -> Elem G -> Elem G -> Elem G.

def CommSemigroup : (G : Set) -> Prop :=
  G => and (Semigroup G) (forall G (a => forall G (b => Eqt G (mul G a b) (mul G b a)))).

def CommGroup : (G : Set) -> Prop :=
  G => and (Group G) (forall G (a => forall G (b => Eqt G (mul G a b) (mul G b a)))).

def Monoid : (M : Set) -> Prop :=
  M => and (Semigroup M) (exists M (e => and (forall M (a => Eqt M (mul M e a) a)) (forall M (a => Eqt M (mul M a e) a)))).

def Group : (G : Set) -> Prop :=
  G => and (Monoid G) (exists (G -> G) (i => forall G (a => Eqt G (mul G (i a) a) one))).

(; Option D': the inverse as "every element has an inverse", the informal statement ;)
def Group' : (G : Set) -> Prop :=
  G => and (Monoid G) (forall G (a => exists G (b => Eqt G (mul G b a) one))).
