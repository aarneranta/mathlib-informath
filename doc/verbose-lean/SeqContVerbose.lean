open Verbose.Named in
Example "Continuity implies sequential continuity"
  Given: (f : ℝ → ℝ) (u : ℕ → ℝ) (x₀ : ℝ)
  Assume: (hu : u converges to x₀) (hf : f is continuous at x₀)
  Conclusion: f ∘ u converges to f x₀
Proof:
  Fix ε > 0
  By hf applied to ε using ε_pos we get δ such that (δ_pos : δ > 0) and (Hf : ∀ (x : ℝ), |x - x₀| ≤ δ ⇒ |f x - f x₀| ≤ ε)
  By hu applied to δ using δ_pos we get N such that (Hu : ∀ n ≥ N, |u n - x₀| ≤ δ)
  Let's prove that N works
  Fix n ≥ N
  We conclude by Hf applied to u n using Hu n n_ge
QED

open Verbose.Named in
Example "Constant sequences converge."
  Given: (u : ℕ → ℝ) (l : ℝ)
  Assume: (h : ∀ (n : ℕ), u n = l)
  Conclusion: u converges to l
Proof:
  Fix ε > 0
  Let's prove that 0 works
  Fix n
  Assume (n_ge : n ≥ 0)
  rw [h n, sub_self, abs_zero]
  We conclude by le_of_lt using ε_pos
QED

open Verbose.Named in
Example "Squeeze: the lower half"
  Given: (u : ℕ → ℝ) (v : ℕ → ℝ) (l : ℝ) (ε : ℝ) (N : ℕ) (n : ℕ)
  Assume: (hN : ∀ n ≥ N, |u n - l| ≤ ε) (h : ∀ (n : ℕ), u n ≤ v n) (hn : n ≥ N)
  Conclusion: -ε ≤ v n - l
Proof:
  By abs_le.mp using hN n hn we get (h₁ : -ε ≤ u n - l) (h₂ : u n - l ≤ ε)
  linarith [h n]
QED

