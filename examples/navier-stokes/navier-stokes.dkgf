starRingEnd__app : $\overline{#2}$
# Function.Periodic f c := ∀ x, f (x + c) = f x
Function__Periodic : $#1(\cdot + #2) = #1$
# Function.HasUncurry.uncurry f: f : X → Y → Z as a function of a pair (one shown argument)
Function__HasUncurry__uncurry : $#1$
