# Informath symbol table for grh-lean (compact edition), on top of
# mathlib-informath's definitions.dkgf, mathlib.dkgf, structures.dkgf and the
# generated grh-names.dkgf (scripts/name-table.py). Written from the Lean
# definitions and their comments, in words of Informath's lexicon where a
# phrase parses, otherwise in LaTeX. The Mathlib entries are those of
# ../riemann.dkgf.

## Mathlib constants without a fitting entry in mathlib.dkgf

# DirichletCharacter.LFunction χ s: the L-function of χ (N hidden)
DirichletCharacter__LFunction : $L(#1, #2)$
riemannZeta : "the Riemann zeta function of #1" | $\zeta(#1)$
# DirichletCharacter R n := MulChar (ZMod n) R; here always R = ℂ
DirichletCharacter : "Dirichlet character modulo #2"
# IsAlgClosure R K: K is an algebraic closure of R
IsAlgClosure : "#2 is an algebraic closure of #1"
NumberField__IsCMField : $#1 \in \mathrm{CM}$
NumberField__RingOfIntegers : $\mathcal{O}_{#1}$
# HeightOneSpectrum R: the nonzero prime ideals of the Dedekind domain R
IsDedekindDomain__HeightOneSpectrum : "nonzero prime of #1"
IsDedekindDomain__HeightOneSpectrum__adicCompletion : "completion of #1 at #2" | ${#1}_{#2}$
Padic : $\mathbb{Q}_{#1}$
PadicInt : $\mathbb{Z}_{#1}$
Matrix__GeneralLinearGroup : "general linear group of #1 over #2" | $\mathrm{GL}(#1, #2)$
Fin : $[#1]$
NumberField__maximalRealSubfield : "the maximal real subfield of #1" | ${#1}^{+}$
# HeightOneSpectrum.asIdeal v: the prime ideal v
IsDedekindDomain__HeightOneSpectrum__asIdeal : $\mathfrak{p}_{#1}$
Matrix__charpoly : "the characteristic polynomial of #1" | $\chi_{#1}$
MonoidHom__comp : "the composition of #1 and #2" | $#1 \circ #2$
RingHom__comp : "the composition of #1 and #2" | $#1 \circ #2$
Module__finrank : "the dimension of #2 over #1" | $\dim_{#1} #2$
TensorProduct__tmul : $#2 \otimes #3$
Sigma__fst : ${#1}_1$
Sigma__snd : ${#1}_2$
# coercions, read as their argument
Units__val : $#1$
RingEquiv__toRingHom : $#1$
RingHom__toMonoidHom : $#1$
Complex__ofReal : $#1$
Rat__cast : $#1$
# constants applied as functions (DFunLike.coe, Export.lean's c__app)
Algebra__algebraMap__app : $#3$
ValuationSubring__valuation__app : $v_{#1}(#2)$
ValuativeRel__valuation__app : $v(#2)$
Formalism__L2__Host__HChar__loc__app : ${#1}_{#2}(#3)$
Formalism__L2__Host__HChar__inf__app : ${#1}_{\infty}(#2)$
Ideal__absNorm__app : $\mathrm{N}#1$

# Fact P: Lean's class of the proofs of P, read as P
#COERCION Fact 1
Real__log : "the logarithm of #1" | $\log #1$
# ENat.toNat: the length (a natural number or infinity) as a natural number, read as itself
ENat__toNat : $#1$

# the claims: the theorems of Challenge state these propositions by name only;
# their statements are read with the definitions unfolded (Export.lean)
#UNFOLD_STATEMENT RiemannHypothesis RiemannZetaZerosOnLine DirichletLNonvanishingRightOfHalf DirichletLZerosOnLine PrimitiveDirichletLZerosOnLine
Complex__re : "the real part of #1" | $\operatorname{Re} #1$

## the central notions of grh-lean (src/New/Data, src/Lib/...), from their
## definitions and source comments; #k counts the shown (explicit) arguments

# class CMType E: E is a CM number field with a CM type
CMType : $#1 \in \mathrm{CM}_{\Phi}$
# abbrev 𝔸f E := FiniteAdeleRing (𝓞 E) E
_u1d538_f : "the finite adele ring of #1" | $\mathbb{A}_{#1,f}$
# abbrev 𝔸 E: ℂ^f × 𝔸_f, the adele ring of a totally complex E
_u1d538_ : "the adele ring of #1" | $\mathbb{A}_{#1}$
# abbrev FinPlace E := HeightOneSpectrum (𝓞 E)
FinPlace : "finite place of #1"
# class ThePrime p extends Fact p.Prime
ThePrime : "#1 is prime"
# structure Space n s: a hermitian space over E with a point, signs s
Space : $\mathrm{Herm}_{#1}(#2, #3)$
# structure Parameters: N₀ (18480 ∣ N₀) and a prime d ≡ N₀/2 − 1 mod N₀
Parameters : "parameter set"
# structure Data P: admissible data
Data : "admissible system for #1"
# structure Shape: ϱ hyperbolic planes, an index set κ, k₀ ∈ κ
Shape : "shape"
Shape___u3f1_ : $\varrho_{#1}$
Shape___u3ba_ : $\kappa_{#1}$
# Gf: the finite adelic unitary group; GInf: the archimedean one; G = G∞ × Gf
Gf : $G_{f}$
GInf : $G_{\infty}$
G : $G$
# USign ε := U (signMatrix ε); U J: the unitary group of J; signMatrix s = diag(s)
USign : $U(\mathrm{diag}\, #1)$
U : $U(#1)$
signMatrix : $\mathrm{diag}(#1)$
# Ω: a fixed algebraic closure of ℚ
_u3a9_ : $\overline{\mathbb{Q}}$
# OFlat: the tilt O♭ of O_{C_p}; Ainf := W(O♭)
OFlat : $\mathcal{O}^{\flat}$
Ainf : $A_{\mathrm{inf}}$
# 𝒮 V: the Banach space of integrable functions of the Weil representation of V
_u1d4ae_ : $\mathcal{S}(#1)$
# ResField w, LocField w: the residue field and the completion at a finite place w
ResField : "the residue field at #1" | $k_{#1}$
LocField : "the completion at #1" | $E_{#1}$
# Gp p := Gal(Q̄_p/Q_p)
Gp : $G_{\mathbb{Q}_{#1}}$
# Ô E: the finite adeles integral at every finite place
_ud4_ : $\hat{\mathcal{O}}_{#1}$
# class FinComplexSpace V: a finite-dimensional complex normed space
FinComplexSpace : "#1 is a finite-dimensional complex space"
# class IsHermUnit J: J is hermitian and invertible
IsHermUnit : "#1 is a hermitian unit"
# class WeilData E: Weil data on a stably unramified E
WeilData : "#1 has Weil data"
# abbrev CommAlg k: the category of commutative k-algebras; AbFunctor C: functors from C to abelian groups
CommAlg : $\mathrm{CAlg}_{#1}$
AbFunctor : $\mathrm{Fun}(#1, \mathrm{Ab})$
# abbrev SubmoduleElem S := ↥S, read as S
SubmoduleElem : $#1$

# frequent constants of Mathlib that mathlib-informath's tables have no fitting entry for
Matrix__mulVec : $#1 #2$
Star__star : $#1^{*}$
Matrix__conjTranspose : $#1^{\mathrm{H}}$
CategoryTheory__CategoryStruct__comp : $#1 \gg #2$
CategoryTheory__Functor__comp : $#2 \circ #1$
CategoryTheory__Functor__obj : $#1(#2)$
MeasureTheory__lintegral : $\int^{-} #2 \, \mathrm{d}#1$
MeasureTheory__Measure__map : ${#1}_{*} #2$
Sum__elim : $[#1, #2]$
starRingEnd : $\mathrm{conj}$
CommRingCat__of : $#1$
Units__val : $#1$
OpenSubgroup__toSubgroup : $#1$
CategoryTheory__ConcreteCategory__hom : $#1$
Module__Finite : "#2 is a finite module over #1"
MeasureTheory__Integrable : "#1 is integrable with respect to #2"
