Formalism__HC__PChar : "primitive Dirichlet character"
Formalism__HC__PChar__N : "the conductor of #1"
Formalism__HC__PChar__val : $#1(#2)$
Subtype__val__app : $#1(#2)$
DFunLike__coe__app : $#1(#2)$
# PadicComplex p = ℂ_p, PadicAlgCl p = an algebraic closure of ℚ_p (the generated entries break on "p-adic")
PadicComplex : $\mathbb{C}_{#1}$
PadicAlgCl : $\overline{\mathbb{Q}}_{#1}$
