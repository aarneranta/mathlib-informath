# Informath symbol table for the constants of riemann-hypothesis-original
# (Levent Alpöge's submission, src/ tree 24df20b), on top of mathlib-informath's
# definitions.dkgf and mathlib.dkgf and the generated riemann-names.dkgf.
# The source has no comments: each entry is written from the Lean definition
# (cited) and the identifier, in words of Informath's lexicon where a phrase
# parses (RunInformath -parse-example), otherwise in LaTeX. #k counts the
# shown (not #HIDE) arguments, as scripts/arguments.py lists them.

## Mathlib constants without a fitting entry in mathlib.dkgf

# DirichletCharacter.LFunction χ s: the L-function of χ (N hidden)
DirichletCharacter__LFunction : $L(#1, #2)$
riemannZeta : "the Riemann zeta function of #1" | $\zeta(#1)$
# DirichletCharacter R n := MulChar (ZMod n) R; here always R = ℂ
DirichletCharacter : "Dirichlet character modulo #2"
# IsAlgClosure R K: K is an algebraic closure of R
IsAlgClosure : "#2 is an algebraic closure of #1"
NumberField__IsCMField : $#1 \in \mathrm{CM}$
NumberField__RingOfIntegers : $\mathcal{O}_{#1}$
# HeightOneSpectrum R: the nonzero prime ideals of the Dedekind domain R
IsDedekindDomain__HeightOneSpectrum : "nonzero prime of #1"
IsDedekindDomain__HeightOneSpectrum__adicCompletion : "completion of #1 at #2" | ${#1}_{#2}$
Padic : $\mathbb{Q}_{#1}$
PadicInt : $\mathbb{Z}_{#1}$
Matrix__GeneralLinearGroup : "general linear group of #1 over #2" | $\mathrm{GL}(#1, #2)$
Fin : $[#1]$
NumberField__maximalRealSubfield : "the maximal real subfield of #1" | ${#1}^{+}$
# HeightOneSpectrum.asIdeal v: the prime ideal v
IsDedekindDomain__HeightOneSpectrum__asIdeal : $\mathfrak{p}_{#1}$
Matrix__charpoly : "the characteristic polynomial of #1" | $\chi_{#1}$
MonoidHom__comp : "the composition of #1 and #2" | $#1 \circ #2$
RingHom__comp : "the composition of #1 and #2" | $#1 \circ #2$
Module__finrank : "the dimension of #2 over #1" | $\dim_{#1} #2$
TensorProduct__tmul : $#2 \otimes #3$
Sigma__fst : ${#1}_1$
Sigma__snd : ${#1}_2$
# coercions, read as their argument
Units__val : $#1$
RingEquiv__toRingHom : $#1$
RingHom__toMonoidHom : $#1$
Complex__ofReal : $#1$
Rat__cast : $#1$
# constants applied as functions (DFunLike.coe, Export.lean's c__app)
Algebra__algebraMap__app : $#3$
ValuationSubring__valuation__app : $v_{#1}(#2)$
ValuativeRel__valuation__app : $v(#2)$
Matrix__GeneralLinearGroup__det__app : $\det #1$
GlobalTheory__WeilDeligne__ineIncl__app : $#2$
GlobalTheory__WeilDeligne__WDRep___u3c1___app : $#1(#2)$
Formalism__L2__Host__HChar__loc__app : ${#1}_{#2}(#3)$
Formalism__L2__Host__HChar__inf__app : ${#1}_{\infty}(#2)$
Ideal__absNorm__app : $\mathrm{N}#1$

## Galois groups, places (Formalism/ConjugateSelfDual/Statement.lean)

# abbrev G F Ω := Ω ≃ₐ[F] Ω
Formalism__ConjugateSelfDual__G : "the Galois group of #2 over #1" | $\mathrm{Gal}(#2/#1)$
# abbrev Qbar l := PadicAlgCl l, an algebraic closure of ℚ_l
Formalism__ConjugateSelfDual__Qbar : $\overline{\mathbb{Q}}_{#1}$
# def IsPlaceOver A v := ∀ x : 𝓞 F, A.valuation x < 1 ↔ x ∈ v (the valuation ring A of Ω lies over the prime v)
Formalism__ConjugateSelfDual__IsPlaceOver : "#1 lies over #2"
# def normV v := Nat.card (𝓞 F ⧸ v.asIdeal)
Formalism__ConjugateSelfDual__normV : "the absolute norm of #1" | $\mathrm{N}#1$
# ReciprocityTheory.Gal.Dec A, Ine A: the decomposition and inertia groups of A in Gal(Ω/F)
ReciprocityTheory__Gal__Dec : "the decomposition group of #1" | $D_{#1}$
ReciprocityTheory__Gal__Ine : "the inertia group of #1" | $I_{#1}$

## Automorphic representations (AutomorphicMembership/ExpoConjOfIsCsd.lean, GaloisGeometry/DualIsConjByOne.lean)

# abbrev HChar L := the continuous characters of the ideles of L trivial on Lˣ
Formalism__L2__Host__HChar : "Hecke character of #1"
# structure CuspSub E a: an irreducible subspace of cusp forms on GL_a(𝔸_E), stable under GL_a(𝔸_f), K∞ and the Lie algebra
GlobalTheory__CuspRep__CuspSub : "cusp representation of degree #2 over #1"
# def CG E a := the cusp representations up to isomorphism; CG.mk π its class
GlobalTheory__CuspRep__CG : "cusp representation class of degree #2 over #1"
GlobalTheory__CuspRep__CG__mk : "the class of #1" | $[#1]$
# def IsRegAlg π := its infinitesimal character is the exponents of a regular algebraic infinity type
GlobalTheory__CuspRep__CG__IsRegAlg : "#1 is a regular algebraic representation"
# def infChar π τ: the infinitesimal character of π at the embedding τ : E → ℂ
GlobalTheory__CuspRep__CG__infChar : "the infinitesimal character of #1 at #2"
# def IsLocComp π w σ := ∃ f : σ.V →ₗ π.V, f ≠ 0 ∧ f intertwines σ with π at w
GlobalTheory__CuspRep__CuspSub__IsLocComp : "#3 is a local component of #1 at #2"
GlobalTheory__CuspRep__CuspSub__twist : "the twist of #1 by #2" | $#1 \otimes #2$
# structure PolarizedPair π χ: sign (χ at the infinite places is (-1)^a) and dual (π^∨ ≅ π^c ⊗ χ∘N)
GlobalTheory__ContraPair__PolarizedPair : "#2 is a polarization of #1"

## Galois representations and p-adic Hodge theory (FiniteDimensionalWdSpace.lean, DataN.lean)

# def IsSSRep ρ := every invariant subspace has an invariant complement
Formalism__MainNotions__N__IsSSRep : "#1 is semisimple"
# def IsCrysAt P Bw r := r has a model at Bw that is crystalline for the period data P
GlobalTheory__Pst__IsCrysAt : "#3 is crystalline at #2"
GlobalTheory__Pst__IsdRAt : $#3 \in \mathrm{dR}_{#2}$
GlobalTheory__Pst__IsPstAt : $#3 \in \mathrm{pst}_{#2}$
# def IsJumpsAt P Bw r τ J := J is the multiset of the Hodge-Tate jumps of r at τ
GlobalTheory__Pst__IsJumpsAt : $\mathrm{HT}_{#4}(#3) = #5$
# def wdAt P ι Bw h hj r: the Weil-Deligne representation of r at Bw (Fontaine), trivial if r is not pst
GlobalTheory__Pst__wdAt : $\mathrm{WD}_{#3}(#6)$

## The Weil group and Weil-Deligne representations (ExistsNotCongPow.lean, MonodromyZeroOfWeilDeligneRepClassIff.lean)

# def Weil h := the σ ∈ Gal(Ω/E) acting on the residue field as a power of Frobenius
GlobalTheory__WeilDeligne__Weil : "the Weil group of #1" | $W_{#1}$
# def deg σ: the power of Frobenius that σ induces
GlobalTheory__WeilDeligne__deg : "the degree of #1" | $\deg #1$
# def WD h := Weil-Deligne representations of Weil h up to isomorphism
GlobalTheory__WeilDeligne__WD : $\mathrm{WD}_{#1}$
GlobalTheory__WeilDeligne__WD__charPol : "the characteristic polynomial of #1 at #2" | $\det(X - #1(#2))$
GlobalTheory__WeilDeligne__WD__inePol : "the characteristic polynomial of #1 at #2" | $\det(X - #1(#2))$
GlobalTheory__WeilDeligne__WD__eig : $\mathrm{eig}_{#2}(#1)$
GlobalTheory__WeilDeligne__WD__frobEig : $\mathrm{eig}_{\mathrm{Frob}}(#1)$
GlobalTheory__WeilDeligne__WD__lpDim : "the dimension of #1" | $\dim #1$
GlobalTheory__WeilDeligne__WD__lpDual : "the dual of #1" | ${#1}^{\vee}$
GlobalTheory__WeilDeligne__WD__lpSum : $#1 \oplus #2$
GlobalTheory__WeilDeligne__WD__lpChar : "the tensor product of #1 and #2" | $#1 \otimes #2$
GlobalTheory__WeilDeligne__WD__lpTw : $#1 \otimes |\cdot|^{#2}$
GlobalTheory__WeilDeligne__WD__lpTwist : "the twist of #1 by #2" | $#1 \otimes #2$
GlobalTheory__WeilDeligne__WD__lpOfChar : $#2$
GlobalTheory__WeilDeligne__WD__lpSp : $\mathrm{Sp}(#2)$
# def mono0 x := the monodromy operator N of x is 0
GlobalTheory__WeilDeligne__WD__mono0 : $N_{#1} = 0$
GlobalTheory__WeilDeligne__WD__unr : "#1 is unramified"
GlobalTheory__WeilDeligne__WD__tempered : "#1 is tempered"
# def wdOf h hl ι r: the Weil-Deligne representation of the l-adic r at w (l prime to w)
GlobalTheory__WeilDeligne__wdOf : $\mathrm{WD}_{#1}(#4)$

## Representations of GL_n of a local field (NonemptyEquivMultiProdOne.lean, TwistedTraceFormula, TwistedInnerProducts)

# abbrev IrrGL k := Σ n, the irreducible smooth representations of GL_n(k) up to isomorphism
GlobalTheory__LocGL__IrrGL : "irreducible smooth representation over #1"
GlobalTheory__LocGL__IrrGL__IsCusp : "#1 is a cusp representation"
GlobalTheory__LocGL__IrrGL__rep : "the representation of #1" | $\rho_{#1}$
GlobalTheory__LocGL__IrrGL__tw : "the twist of #1 by #2" | $#1 \otimes #2$
GlobalTheory__LocGL__IrrGL__nu : $#1 \otimes |\det|^{#2}$
GlobalTheory__LocGL__IrrGL__ofChar : $#1$
# def HasSupport π s := s is the cuspidal support of π
GlobalTheory__LocGL__HasSupport : "#2 is a support of #1"
GlobalTheory__SmGL__IrrRep : "irreducible smooth representation of #1"
GlobalTheory__SmGL__Segment : "segment over #1"
GlobalTheory__SmGL__IsSmoothChar : "#1 is a smooth character"
GlobalTheory__SmGL__contra : "the dual of #1" | ${#1}^{\vee}$
GlobalTheory__SmGL__HasCentralChar : "#1 has a central character #2"
# def fixed ρ H: the vectors fixed by H
GlobalTheory__PRep__fixed : ${#1}^{#2}$
# def KOne n: the kernel of GL_n(𝒪_k) → GL_n(residue field)
GlobalTheory__SplitWeil__KOne : $K_1(\mathrm{GL}_{#2}(#1))$
# def cls π: the class of an irreducible representation in IrrGL
GlobalTheory__LocLanglands__cls : "the class of #1" | $[#1]$
# def algNorm σ := σ ⊗ |det|^((1-a)/2)
GlobalTheory__GalOfCusp__algNorm : "the algebraic normalization of #1" | ${#1}^{\mathrm{alg}}$

## Local Langlands (LocalLanglandsGL.lean, HasExponentZeroIff.lean, IsRecTOfIsRec.lean)

# structure IsLocalArtin h a: a : Weil h → (E_w)ˣ is surjective, continuous on inertia, matches degrees and global Artin reciprocity
GlobalTheory__LocLanglands__IsLocalArtin : "#2 is a local Artin map"
# def IsRec rc := ∃ a ha ε, IsDeligneEps ε ∧ Laws a ha ε rc
GlobalTheory__LocLanglands__IsRec : "#2 is a reciprocity map at #1"
GlobalTheory__LocLanglands__Laws : "#4 is a reciprocity map with respect to #1"
# def segSum rc l := ⊕ over the segments Δ of l of rc(first Δ) ⊗ |·|^((len Δ - 1)/2) ⊗ Sp(len Δ)
GlobalTheory__LocLanglands__segSum : $\bigoplus_{\Delta \in #2} #1(\Delta)$
GlobalTheory__LocLanglands__IsIrrWD : "#1 is irreducible"
GlobalTheory__LocLanglands__IsTameWD : "#1 is tame"
# def IsRecT h rc := ∃ a ha, LawsT a ha rc (the laws of a local Langlands correspondence, with TypeLaw)
UpperTheory__Zero__LLC__IsRecT : $#2 \in \mathrm{rec}_T(#1)$
UpperTheory__Zero__LLC__LawsT : $#3 \in \mathrm{rec}_T(#1)$
# def TypeLaw h rc: rc of a depth-zero type is given by Green's characters, as in the tame local Langlands
UpperTheory__Zero__LLC__TypeLaw : "#2 has the type property"
UpperTheory__Zero__LLC__Good : "#1 is good"
UpperTheory__Zero__LLC__GoodCusp : "#1 is a good cusp"
UpperTheory__Zero__LLC__Toral : "#1 is toral"

## Representations of GL_n over finite fields (LabelDatum.lean, GreenRegularCharacters.lean)

GlobalTheory__GLq__Gn : $\mathrm{GL}_{#2}(\mathbb{F}_{#1})$
GlobalTheory__GLq__IsCusp : "#1 is a cusp character"
# def IsRegularChar g d θ := the θ^(g^i), i < d, are distinct
GlobalTheory__Published__IsRegularChar : "#3 is a regular character"

## The conditions on Galois representations (WeightsConjAlt.lean, WeightsConjBis.lean)

