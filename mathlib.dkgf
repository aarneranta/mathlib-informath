# Informath symbol table for the Mathlib constants that the exported statements
# use and that mapping.tsv does not map to Informath's base.  The #k count the
# explicit arguments of the Lean constant, the ones Export.lean keeps.  The
# wordings follow the Mathlib docstrings where the grammar has their words.

# Mathlib.Data.Nat.Prime.Defs
Nat__Prime : "#1 is prime"
Nat__Primes : "prime number" | $\mathbb{P}$
Nat__minFac : "the minimal prime factor of #1" | $\operatorname{minFac}(#1)$
Nat__minFacAux : $\operatorname{minFacAux}(#1, #2)$

# used by the prime modules
Nat__Coprime : "#1 and #2 are coprime" | $#1 \perp #2$
Nat__sqrt : "the integer square root of #1" | $\lfloor \sqrt{#1} \rfloor$
Nat__descFactorial : "the decreasing factorial of #1 of order #2" | $#1^{\underline{#2}}$
Nat__pred : "the predecessor of #1" | $\operatorname{pred}(#1)$
Prime : "#1 is prime"
Irreducible : "#1 is irreducible"
BddAbove : "#1 has an upper bound"
Function__Injective : "#1 is injective"
HMod__hMod : "the remainder of #1 modulo #2" | $#1 \bmod #2$
ite : $\mathrm{if}\ #1\ \mathrm{then}\ #2\ \mathrm{else}\ #3$
# Set__ofPred (p => P) has no entry: a macro cannot show a function argument,
# and the statements using it would lose their reading
Decidable : "decision procedure for #1"

# Informath's base has Eqt (equality in a type A) without a wording
Eqt : "#2 is equal to #3" | $#2 = #3$
