# Informath symbol table for the Mathlib constants that the exported statements
# use and that mapping.tsv does not map to Informath's base.  The #k count the
# explicit arguments of the Lean constant: Export.lean keeps the implicit ones
# too, and the #HIDE lines of out/<Module>-hide.dkgf hide them before the
# entries apply.  The
# wordings follow the Mathlib docstrings where the grammar has their words.

# Mathlib.Data.Nat.Prime.Defs
Nat__Prime : "#1 is prime"
Nat__Primes : "prime number" | $\mathbb{P}$
Nat__minFac : "the smallest prime factor of #1" | $\operatorname{minFac}(#1)$
Nat__minFacAux : $\operatorname{minFacAux}(#1, #2)$

# used by the prime modules
Nat__Coprime : "#1 and #2 are coprime" | $#1 \perp #2$
Nat__sqrt : "the integer square root of #1" | $\lfloor \sqrt{#1} \rfloor$
Nat__descFactorial : "the descending factorial of #1 of order #2" | $#1^{\underline{#2}}$
Nat__pred : "the predecessor of #1" | $\operatorname{pred}(#1)$
Prime : "#1 is prime"
Irreducible : "#1 is irreducible"
BddAbove : "#1 is bounded above" | "#1 has an upper bound"
Function__Injective : "#1 is injective"
HMod__hMod : "the remainder of #1 modulo #2" | $#1 \bmod #2$
ite : $\mathrm{if}\ #1\ \mathrm{then}\ #2\ \mathrm{else}\ #3$
Decidable : "decision procedure for #1"

# Informath's base has Eqt (equality in a type A) without a wording
Eqt : equalset_Adj2 [2,3] | $#2 = #3$

# Mathlib.Data.Nat.Factorization
Nat__factorization : "the factorization of #1" | $\operatorname{factorization}(#1)$
# n.factorization p, the coercion of the finsupp applied to p (Export.lean: c__app)
Nat__factorization__app : "the multiplicity of #2 in #1" | $\operatorname{ord}_{#2}(#1)$
Nat__primeFactors : "the set of prime factors of #1" | $\operatorname{primeFactors}(#1)$
Nat__primeFactorsList : "the prime factorization of #1" | $\operatorname{primeFactorsList}(#1)$
Nat__divisors : "the set of divisors of #1" | $\operatorname{divisors}(#1)$
Nat__properDivisors : "the set of proper divisors of #1" | $\operatorname{properDivisors}(#1)$
Nat__floorRoot : "the floor root of #2 of order #1" | $\lfloor \sqrt[#1]{#2} \rfloor$
Nat__ceilRoot : "the ceiling root of #2 of order #1" | $\lceil \sqrt[#1]{#2} \rceil$
IsPrimePow : "#1 is a prime power"
padicValNat : "the valuation of #2 at #1" | $v_{#1}(#2)$

# finite sets and finitely supported functions
Finset : "finite set of #1"
Finset__card : "the cardinality of #1" | $|#1|$
Finset__range : "the range of #1" | $\{0, \dots, #1 - 1\}$
Finset__Ico : $[#1, #2)$
Set__Icc : $[#1, #2]$
Finsupp : "finitely supported function from #1 to #2" | $#1 \to_0 #2$
Finsupp__support : "the support of #1" | $\operatorname{supp}(#1)$
Finsupp__single : $\operatorname{single}(#1, #2)$
Membership__mem : "#2 is an element of #1" | $#2 \in #1$
Prod__mk : $(#1, #2)$

# binders: the bound variables of the function arguments are parameters of
# their own (as in Informath's \Summa), so these are raw macros
Finset__prod : \FinsetProd
Finset__sum : \FinsetSum
Finset__filter : \FinsetFilter
Finsupp__prod : \FinsuppProd
Subtype : \SubtypeSet
# {x | p x}, as Set.ofPred (x => p x)
Set__ofPred : \SubtypeSet
#MACRO \newcommand{\FinsetProd}[3]{\prod_{#2 \in #1} #3}
#MACRO \newcommand{\FinsetSum}[3]{\sum_{#2 \in #1} #3}
#MACRO \newcommand{\FinsetFilter}[3]{\{#1 \in #3 \mid #2\}}
#MACRO \newcommand{\FinsuppProd}[4]{\prod_{#2 \in \operatorname{supp}(#1)} #4 \,\big|_{#3 = #1(#2)}}
#MACRO \newcommand{\SubtypeSet}[2]{\{#1 \mid #2\}}
# ∀ᶠ x in l, p x and ∃ᶠ x in l, p x: Filter.Eventually (x => p x) l
# ∃! x, p x: ExistsUnique (x => p x)
ExistsUnique : \ExistsUniqueBinder
#MACRO \newcommand{\ExistsUniqueBinder}[2]{\exists! #1,\ #2}
Filter__Eventually : \FilterEventually
Filter__Frequently : \FilterFrequently
#MACRO \newcommand{\FilterEventually}[3]{\forall^{\mathrm{f}} #1 \in #3,\ #2}
#MACRO \newcommand{\FilterFrequently}[3]{\exists^{\mathrm{f}} #1 \in #3,\ #2}
Nat__factorizationLCMLeft : $\operatorname{factorizationLCMLeft}(#1, #2)$
Nat__factorizationLCMRight : $\operatorname{factorizationLCMRight}(#1, #2)$

# classes, which Export.lean declares as predicates: [CommMonoid M] is a
# hypothesis Proof (CommMonoid M)
CommMonoid : "#1 is a commutative monoid"
AddCommMonoid : "#1 is an additive commutative monoid"


# from the docstrings (suggest-entries.py, reviewed), some with the words of
# informath's grammars/Mathlib.gf
Nat__lcm : "the least common multiple of #1 and #2" | $\operatorname{lcm}(#1, #2)$
Int__natAbs : "the absolute value of #1" | $|#1|$
Prod__fst : "the first element of #1" | $\pi_1(#1)$
Prod__snd : "the second element of #1" | $\pi_2(#1)$
Union__union : "the union of #1 and #2" | $#1 \cup #2$
Finset__image : "the forward image of #2 under #1"
Finset__univ : "the universal set" | $\mathrm{univ}$
Finset__Nontrivial : "#1 is nontrivial"
Set__InjOn : "#1 is injective on #2"
IsSquare : "#1 is a square"
IsUnit : "#1 is a unit"
PNat : "positive natural number" | $\mathbb{N}^+$
Equiv : "equivalence from #1 to #2" | $#1 \simeq #2$
Max__max : "the maximum of #1 and #2" | $\max(#1, #2)$
Min__min : "the minimum of #1 and #2" | $\min(#1, #2)$
multiplicity : "the multiplicity of #1 in #2" | $\operatorname{multiplicity}(#1, #2)$
List__count : "the multiplicity of #1 in #2"
Finset__Icc : $[#1, #2]$
Finset__Ioc : $(#1, #2]$
Finset__Iic : $(-\infty, #1]$
Finset__Iio : $(-\infty, #1)$
HSMul__hSMul : $#1 \bullet #2$

# Mathlib.Order.Defs and Mathlib.Algebra: order and algebra classes, which
# Export.lean declares as predicates of their carrier
Preorder : "#1 is preordered"
PartialOrder : "#1 is partially ordered"
LinearOrder : "#1 is linearly ordered"
LE : "#1 is ordered"
Lattice : "#1 is a lattice"
DistribLattice : "#1 is a distributive lattice"
SemilatticeSup : "#1 is a join semilattice"
SemilatticeInf : "#1 is a meet semilattice"
Monoid : "#1 is a monoid"
MonoidWithZero : "#1 is a monoid with zero"
CommMonoidWithZero : "#1 is a commutative monoid with zero"
DecompositionMonoid : "#1 is a decomposition monoid"
IsPrimal : "#1 is primal"
IsCancelMulZero : "#1 is cancellative"
# relation classes: the carrier is #1, the relation #2
IsTrans : "#2 is transitive"
IsPreorder : "#2 is a preorder"
IsPartialOrder : "#2 is a partial order"
IsEquiv : "#2 is an equivalence relation"
IsStrictOrder : "#2 is a strict order"
Equivalence : NounNoun1 equivalence_relation_Noun [1]
Std__Symm : "#1 is symmetric"
Std__Irrefl : "#1 is irreflexive"
Std__Refl : "#1 is reflexive"
Std__Antisymm : "#1 is antisymmetric"
Std__Asymm : "#1 is asymmetric"
Std__Total : "#1 is total"
Std__Trichotomous : "#1 is trichotomous"
Ord__compare : "the comparison of #1 and #2" | $\operatorname{compare}(#1, #2)$
UpperSet : "upper set of #1"
SemilatticeSup__sup : "the supremum of #1 and #2" | $#1 \sqcup #2$
SemilatticeInf__inf : "the infimum of #1 and #2" | $#1 \sqcap #2$
Units : "unit of #1" | $#1^{\times}$
IsLinearOrder : "#2 is a linear order"
IsStrictWeakOrder : "#2 is a strict weak order"
IsStrictTotalOrder : "#2 is a strict total order"
Minimal : "#2 is minimal with respect to #1"
Maximal : "#2 is maximal with respect to #1"
IsUpperSet : "#1 is an upper set"
IsLowerSet : "#1 is a lower set"
LowerSet : "lower set of #1"
Subsingleton : "#1 is a subsingleton"

# Tier A (logic, sets, orders): the constants coverage.py found most often
# without a wording
Function__comp : "the composition of #1 and #2" | $#1 \circ #2$
Function__Surjective : "#1 is surjective"
Function__Bijective : "#1 is bijective"
Function__LeftInverse : "#1 is a left inverse of #2"
Function__RightInverse : "#1 is a right inverse of #2"
Function__update : $\operatorname{update}(#1, #2, #3)$
Function__invFunOn : $\operatorname{invFunOn}(#1, #2)$
Function__invFun : $\operatorname{invFun}(#1)$
Function__const : $\operatorname{const}_{#1}(#2)$
Function__Semiconj : $#1 \circ #2 = #3 \circ #1$
Function__extend : $\operatorname{extend}(#1, #2, #3)$
Nonempty : "#1 is nonempty"
Inter__inter : "the intersection of #1 and #2" | $#1 \cap #2$
SDiff__sdiff : "the difference of #1 and #2" | $#1 \setminus #2$
EmptyCollection__emptyCollection : "the empty set" | $\emptyset$
Singleton__singleton : $\{#1\}$
Insert__insert : $\{#1\} \cup #2$
SProd__sprod : "the product of #1 and #2" | $#1 \times #2$
Prod : $#1 \times #2$
Prod__swap : $\operatorname{swap}(#1)$
Sum__inl : $\operatorname{inl}(#1)$
Sum__inr : $\operatorname{inr}(#1)$
Option : $\operatorname{Option}(#1)$
Option__some : $\operatorname{some}(#1)$
Option__none : $\operatorname{none}$
Set__image : "the image of #2 under #1" | $#1[#2]$
Set__preimage : "the preimage of #2 under #1" | $#1^{-1}[#2]$
Set__MapsTo : $#1[#2] \subseteq #3$
Set__SurjOn : $#3 \subseteq #1[#2]$
Set__BijOn : "#1 is a bijection from #2 to #3"
Set__EqOn : equal_on_Adj3 [1,2,3]
Set__LeftInvOn : "#1 is a left inverse of #2 on #3"
Set__RightInvOn : "#1 is a right inverse of #2 on #3"
Set__Ici : $[#1, \infty)$
Set__Iic : $(-\infty, #1]$
Set__Ioi : $(#1, \infty)$
Set__Iio : $(-\infty, #1)$
Set__Ico : $[#1, #2)$
Set__Ioc : $(#1, #2]$
Set__Ioo : $(#1, #2)$
IsLUB : "#2 is a least upper bound of #1"
IsGLB : "#2 is a greatest lower bound of #1"
IsGreatest : "#2 is a greatest element of #1"
IsLeast : "#2 is a least element of #1"
IsCofinalFor : "#1 is cofinal in #2"
IsCoinitialFor : "#1 is coinitial in #2"
StrictMono : "#1 is strictly increasing"
StrictAnti : "#1 is strictly decreasing"
Antitone : "#1 is decreasing"
MonotoneOn : "#1 is monotone on #2"
AntitoneOn : "#1 is decreasing on #2"
StrictMonoOn : "#1 is strictly increasing on #2"
StrictAntiOn : "#1 is strictly decreasing on #2"
LT : "#1 is strictly ordered"
# the order on sets is inclusion (Export.lean: LE.le on Set or Finset)
Set__Subset : "#1 is a subset of #2" | $#1 \subseteq #2$
HasSSubset__SSubset : "#1 is a proper subset of #2" | $#1 \subset #2$
Set__univ : "the universal set" | $\mathrm{univ}$
Compl__compl : "the complement of #1" | $#1^{c}$

# Tiers B-F (groups, rings, number theory, finite sets, linear algebra,
# polynomials, topology, analysis): tested one by one against the grammar;
# where no wording parses, the formula alone
Neg__neg : "the negation of #1" | $-#1$
Inv__inv : "the inverse of #1" | $#1^{-1}$
QuotientGroup__mk : "the class of #1" | $\overline{#1}$
QuotientAddGroup__mk : "the class of #1" | $\overline{#1}$
Subgroup__zpowers : "the subgroup generated by #1" | $\langle #1 \rangle$
AddSubgroup__zmultiples : "the subgroup generated by #1" | $\langle #1 \rangle$
Nat__ModEq : "#2 is congruent to #3 modulo #1" | $#2 \equiv #3 \pmod{#1}$
Int__ModEq : "#2 is congruent to #3 modulo #1" | $#2 \equiv #3 \pmod{#1}$
AddCommGroup__ModEq : "#2 is congruent to #3 modulo #1" | $#2 \equiv #3 \pmod{#1}$
Nat__choose : "the binomial coefficient of #1 and #2" | $\binom{#1}{#2}$
Rat__num : "the numerator of #1" | $\operatorname{num}(#1)$
Rat__den : "the denominator of #1" | $\operatorname{den}(#1)$
NeZero : "#1 is nonzero" | $#1 \neq 0$
Int__gcd : "the greatest common divisor of #1 and #2" | $\gcd(#1, #2)$
Finset__erase : $#1 \setminus \{#2\}$
Polynomial__C__app : $#1$
Polynomial__X : $X$
Polynomial__coeff__app : "the coefficient of #1 at #2" | $\operatorname{coeff}(#1, #2)$
Polynomial__monomial__app : $#2 X^{#1}$
Polynomial__IsRoot : "#2 is a root of #1"
Polynomial__modByMonic : $#1 \bmod #2$
Polynomial__divByMonic : $#1 / #2$
Polynomial__eval : "the value of #2 at #1" | $#2(#1)$
Commute : "#1 commutes with #2"
Filter__Tendsto : $#1 \xrightarrow{#2} #3$
Filter__atTop : $\infty$
nhds : $#1$
Filter__EventuallyEq : $#2 =^{\mathrm{f}}_{#1} #3$
Filter__NeBot : "#1 is a proper filter"
HasDerivWithinAt : $#1'(#4) = #2 \text{ within } #3$
deriv : "the derivative of #1 at #2" | $#1'(#2)$
Real__exp : "the exponential of #1" | $e^{#1}$
dist : "the distance between #1 and #2" | $d(#1, #2)$
Nat__totient : "the totient of #1" | $\varphi(#1)$
orderOf : "the order of #1" | $\operatorname{ord}(#1)$
Matrix__det : "the determinant of #1" | $\det #1$
IsOfFinOrder : $\operatorname{ord}(#1) < \infty$
IsOfFinAddOrder : $\operatorname{ord}(#1) < \infty$
ZMod : $\mathbb{Z}/#1\mathbb{Z}$
Nat__ascFactorial : $#1^{\overline{#2}}$
Associated : $#1 \sim #2$
HasDerivAt : $#1'(#3) = #2$
Polynomial__roots : $\operatorname{roots}(#1)$
Metric__ball : $B(#1, #2)$

# classes and constants of tiers B-F still without a wording (coverage.md), tested
NormedSpace : "#2 is a normed space over #1"
LinearIndependent : "#2 is independent over #1"
Polynomial : "polynomial over #1" | $#1[X]$
Algebra : "#2 is an algebra over #1"
PseudoMetricSpace : "#1 is a pseudometric space"
MetricSpace : "#1 is a metric space"
IsDomain : "#1 is an integral domain"
Group : "#1 is a group"
AddGroup : "#1 is an additive group"
CommGroup : "#1 is a commutative group"
Ring : "#1 is a ring"
CommRing : "#1 is a commutative ring"
Field : "#1 is a field"
TopologicalSpace : "#1 is a topological space"
HasQuotient__Quotient : $#1 / #2$
Fin : $\{0, \dots, #1 - 1\}$
Ideal__IsTwoSided : "#1 is two-sided"
Nat__iterate : $#1^{[#2]}(#3)$
Equiv__symm__app : $#1^{-1}(#2)$
DFunLike__coe__app : $#1(#2)$
Multiset : "multiset of #1"
Multiset__prod : $\prod #1$
Filter : "filter on #1"
Subgroup : "subgroup of #1"
AddSubgroup : "subgroup of #1"
RingHom : "ring homomorphism from #1 to #2" | $#1 \to_{+*} #2$
MonoidHom : "monoid homomorphism from #1 to #2" | $#1 \to_{*} #2$
Submodule__span : "the span of #2" | $\operatorname{span}_{#1}(#2)$
Finset__image : "the image of #2 under #1" | $#1[#2]$
Filter__principal : "the principal filter of #1" | $\mathcal{P}(#1)$
NNReal__sqrt__app : $\sqrt{#1}$
Real__sqrt : "the square root of #1" | $\sqrt{#1}$
HasDerivAtFilter : $#1'(#3) = #2 \text{ along } #4$
Filter__EventuallyLE : $#2 \leq^{\mathrm{f}}_{#1} #3$
Dist__dist : "the distance between #1 and #2" | $d(#1, #2)$
Submodule : "submodule of #2 over #1"
Ideal : "ideal of #1"

# a third round for tiers B-F, tested
LinearIndepOn : "#2 is independent on #3 over #1"
Polynomial__ofFinsupp : $#1$
Nat__divisorsAntidiagonal : $\{(a, b) \mid a b = #1\}$
Int__divisorsAntidiag : $\{(a, b) \mid a b = #1\}$
Multiset__map : $#1[#2]$
Rat__divInt : $\frac{#1}{#2}$
Polynomial__aroots : $\operatorname{roots}_{#2}(#1)$
AddMonoidHom : "additive monoid homomorphism from #1 to #2" | $#1 \to_{+} #2$
MonoidHom__ker : "the kernel of #1" | $\ker #1$
AddMonoidHom__ker : "the kernel of #1" | $\ker #1$
HasStrictDerivAt : $#1'(#3) = #2 \text{ strictly}$
Asymptotics__IsLittleO : $#2 = o_{#1}(#3)$
RCLike : $#1 \in \{\mathbb{R}, \mathbb{C}\}$
MulOpposite__op : $#1^{\mathrm{op}}$
LeftCancelMonoid : "#1 is a left cancellative monoid"
AddLeftCancelMonoid : "#1 is an additive left cancellative monoid"
Finset__cons : $\{#1\} \cup #2$
Module__Basis : "basis of #3 over #2" | $\operatorname{Basis}_{#2}(#1, #3)$
Module__Basis__repr : $[#1]$
IsOrderedCancelAddMonoid : "#1 is an ordered cancellative additive monoid"
Polynomial__map : $#1(#2)$
Filter__EventuallyEqSet : $#2 =^{\mathrm{f}}_{#1} #3$
Filter__EventuallySubset : $#2 \subseteq^{\mathrm{f}}_{#1} #3$
Fintype__card : "the cardinality of #1" | $|#1|$
MulAction : $#1 \curvearrowright #2$

# the coercions, which readings show as the argument they coerce (#COERCION
# in out/<Module>-hide.dkgf), except where that would make the two sides of an
# equation the same, as in ↑(m - n) = ↑m - ↑n
Nat__cast : $\uparrow #1$
Int__cast : $\uparrow #1$
NatCast__natCast : $\uparrow #1$
IntCast__intCast : $\uparrow #1$
Subtype__val : $\uparrow #1$
SetLike__coe : $\uparrow #1$
Fin__val : $\uparrow #1$
Subgroup__toSubmonoid : $\uparrow #1$
AddSubgroup__toAddSubmonoid : $\uparrow #1$
Submonoid__toSubsemigroup : $\uparrow #1$
Subtype__mk : $\langle #1 \rangle$
