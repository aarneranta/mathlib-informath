Multiset__prod_map_prod : (I : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (CommMonoid M)) -> (m : Elem (Multiset I)) -> (s : Elem (Finset X)) -> (f : (Elem I -> Elem X -> M)) -> Proof (Eqt M (Multiset__prod M (Multiset__map I M (i => Finset__prod X M s (a => f i a)) m)) (Finset__prod X M s (a1 => Multiset__prod M (Multiset__map I M (i1 => f i1 a1) m)))).

(; //LEAN:Multiset.toFinset_sum_count_eq ;)
Multiset__toFinset_sum_count_eq : (I : Set) -> (s : Elem (Multiset I)) -> Proof (Eq (Finset__sum I Nat (Multiset__toFinset I s) (a => Multiset__count I a s)) (Multiset__card I s)).

