Multiset__sum_sum : (M : Set) -> (I : Set) -> (_ : Proof (AddCommMonoid M)) -> (f : (Elem I -> Multiset M)) -> (s : Elem (Finset I)) -> Proof (Eqt M (Multiset__sum M (Finset__sum I (Multiset M) s (x1 => f x1))) (Finset__sum I M s (x2 => Multiset__sum M (f x2)))).

