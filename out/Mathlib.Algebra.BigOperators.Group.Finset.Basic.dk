IsAddUnit__multisetSum_iff : (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (s : Elem (Multiset M)) -> Proof (iff (IsAddUnit M (Multiset__sum M s)) (forall M (a => if (Membership__mem M (Multiset M) s a) (IsAddUnit M a)))).

