Multiset__sum_count_eq_card : (I : Set) -> (s : Elem (Finset I)) -> (m : Elem (Multiset I)) -> (hms : Proof (forall I (a1 => if (Membership__mem I (Multiset I) m a1) (Membership__mem I (Finset I) s a1)))) -> Proof (Eq (Finset__sum I Nat s (a => Multiset__count I a m)) (Multiset__card I m)).

