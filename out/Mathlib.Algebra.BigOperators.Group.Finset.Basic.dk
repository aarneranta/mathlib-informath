Multiset__toFinset_sum_count_nsmul_eq : (I : Set) -> (s : Elem (Multiset I)) -> Proof (Eqt (Multiset I) (Finset__sum I (Multiset I) (Multiset__toFinset I s) (a => HSMul__hSMul Nat (Multiset I) (Multiset I) (Multiset__count I a s) (Singleton__singleton I (Multiset I) a))) s).

(; //LEAN:Multiset.exists_smul_of_dvd_count ;)
Multiset__exists_smul_of_dvd_count : (I : Set) -> (s : Elem (Multiset I)) -> (k : Elem Nat) -> (h : Proof (forall I (a => if (Membership__mem I (Multiset I) s a) (divide k (Multiset__count I a s))))) -> Proof (exists (Multiset I) (u => Eqt (Multiset I) s (HSMul__hSMul Nat (Multiset I) (Multiset I) k u))).

