Multiset__prod_sum : (M : Set) -> (I : Set) -> (_ : Proof (CommMonoid M)) -> (f : (Elem I -> Multiset M)) -> (s : Elem (Finset I)) -> Proof (Eqt M (Multiset__prod M (Finset__sum I (Multiset M) s (x1 => f x1))) (Finset__prod I M s (x2 => Multiset__prod M (f x2)))).

