IsUnit__prod_iff : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (_ : Proof (CommMonoid M)) -> (f : (Elem I -> M)) -> Proof (iff (IsUnit M (Finset__prod I M s (a => f a))) (forall I (a1 => if (Membership__mem I (Finset I) s a1) (IsUnit M (f a1))))).

