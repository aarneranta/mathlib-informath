IsUnit__multisetProd_iff : (M : Set) -> (_ : Proof (CommMonoid M)) -> (s : Elem (Multiset M)) -> Proof (iff (IsUnit M (Multiset__prod M s)) (forall M (a => if (Membership__mem M (Multiset M) s a) (IsUnit M a)))).

