(; //LEAN:pow_dite ;)
pow_dite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : (Proof p -> Y)) -> (c : (Proof (not p) -> Y)) -> Proof (Eqt X (pow a (dite p (h => b h) (h1 => c h1))) (dite p (h2 => pow a (b h2)) (h3 => pow a (c h3)))).

(; //LEAN:dite_vadd ;)
dite_vadd : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : (Proof p -> Y)) -> (c : (Proof (not p) -> Y)) -> Proof (Eqt X (HVAdd__hVAdd (dite p (h => b h) (h1 => c h1)) a) (dite p (h2 => HVAdd__hVAdd (b h2) a) (h3 => HVAdd__hVAdd (c h3) a))).

(; //LEAN:dite_smul ;)
dite_smul : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : (Proof p -> Y)) -> (c : (Proof (not p) -> Y)) -> Proof (Eqt X (HSMul__hSMul (dite p (h => b h) (h1 => c h1)) a) (dite p (h2 => HSMul__hSMul (b h2) a) (h3 => HSMul__hSMul (c h3) a))).

(; //LEAN:vadd_dite ;)
vadd_dite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : (Proof p -> X)) -> (b : (Proof (not p) -> X)) -> (c : Elem Y) -> Proof (Eqt X (HVAdd__hVAdd c (dite p (h => a h) (h1 => b h1))) (dite p (h2 => HVAdd__hVAdd c (a h2)) (h3 => HVAdd__hVAdd c (b h3)))).

(; //LEAN:dite_pow ;)
dite_pow : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : (Proof p -> X)) -> (b : (Proof (not p) -> X)) -> (c : Elem Y) -> Proof (Eqt X (pow (dite p (h => a h) (h1 => b h1)) c) (dite p (h2 => pow (a h2) c) (h3 => pow (b h3) c))).

(; //LEAN:smul_dite ;)
smul_dite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : (Proof p -> X)) -> (b : (Proof (not p) -> X)) -> (c : Elem Y) -> Proof (Eqt X (HSMul__hSMul c (dite p (h => a h) (h1 => b h1))) (dite p (h2 => HSMul__hSMul c (a h2)) (h3 => HSMul__hSMul c (b h3)))).

(; //LEAN:ite_vadd ;)
ite_vadd : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Y) -> Proof (Eqt X (HVAdd__hVAdd (ite p b c) a) (ite p (HVAdd__hVAdd b a) (HVAdd__hVAdd c a))).

(; //LEAN:ite_smul ;)
ite_smul : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Y) -> Proof (Eqt X (HSMul__hSMul (ite p b c) a) (ite p (HSMul__hSMul b a) (HSMul__hSMul c a))).

(; //LEAN:pow_ite ;)
def pow_ite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Y) -> Proof (Eqt X (pow a (ite p b c)) (ite p (pow a b) (pow a c))) :=
  X => Y => p => a => b => c => pow_dite X Y p a (h => b) (h1 => c).

(; //LEAN:vadd_ite ;)
vadd_ite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> Proof (Eqt X (HVAdd__hVAdd c (ite p a b)) (ite p (HVAdd__hVAdd c a) (HVAdd__hVAdd c b))).

(; //LEAN:ite_pow ;)
def ite_pow : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> Proof (Eqt X (pow (ite p a b) c) (ite p (pow a c) (pow b c))) :=
  X => Y => p => a => b => c => dite_pow X Y p (h => a) (h1 => b) c.

(; //LEAN:smul_ite ;)
smul_ite : (X : Set) -> (Y : Set) -> (p : Prop) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> Proof (Eqt X (HSMul__hSMul c (ite p a b)) (ite p (HSMul__hSMul c a) (HSMul__hSMul c b))).

(; //LEAN:comp_mul_left ;)
comp_mul_left : (X : Set) -> (_ : Proof (Semigroup X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt (Elem X -> X) (Function__comp (x3 => times x1 x3) (x4 => times y x4)) (x5 => times (times x1 y) x5)).

(; //LEAN:comp_add_left ;)
comp_add_left : (X : Set) -> (_ : Proof (AddSemigroup X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt (Elem X -> X) (Function__comp (x3 => plus x1 x3) (x4 => plus y x4)) (x5 => plus (plus x1 y) x5)).

(; //LEAN:comp_mul_right ;)
comp_mul_right : (X : Set) -> (_ : Proof (Semigroup X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt (Elem X -> X) (Function__comp (x3 => times x3 x1) (x4 => times x4 y)) (x5 => times x5 (times y x1))).

(; //LEAN:comp_add_right ;)
comp_add_right : (X : Set) -> (_ : Proof (AddSemigroup X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt (Elem X -> X) (Function__comp (x3 => plus x3 x1) (x4 => plus x4 y)) (x5 => plus x5 (plus y x1))).

(; //LEAN:ite_add_zero ;)
ite_add_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (P : Prop) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (ite P (plus a b) 0) (plus (ite P a 0) (ite P b 0))).

(; //LEAN:ite_mul_one ;)
ite_mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (P : Prop) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (ite P (times a b) 1) (times (ite P a 1) (ite P b 1))).

(; //LEAN:ite_zero_add ;)
ite_zero_add : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (P : Prop) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (ite P 0 (plus a b)) (plus (ite P 0 a) (ite P 0 b))).

(; //LEAN:ite_one_mul ;)
ite_one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (P : Prop) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (ite P 1 (times a b)) (times (ite P 1 a) (ite P 1 b))).

(; //LEAN:eq_one_iff_eq_one_of_mul_eq_one ;)
eq_one_iff_eq_one_of_mul_eq_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> (b : Elem M) -> (h : Proof (Eqt M (times a b) 1)) -> Proof (iff (Eqt M a 1) (Eqt M b 1)).

(; //LEAN:eq_zero_iff_eq_zero_of_add_eq_zero ;)
eq_zero_iff_eq_zero_of_add_eq_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> (b : Elem M) -> (h : Proof (Eqt M (plus a b) 0)) -> Proof (iff (Eqt M a 0) (Eqt M b 0)).

(; //LEAN:zero_add_eq_id ;)
zero_add_eq_id : (M : Set) -> (_ : Proof (AddZeroClass M)) -> Proof (Eqt (Elem M -> M) (x2 => plus 0 x2) id).

(; //LEAN:one_mul_eq_id ;)
def one_mul_eq_id : (M : Set) -> (_ : Proof (MulOneClass M)) -> Proof (Eqt (Elem M -> M) (x2 => times 1 x2) id) :=
  M => x => funext M (x1 => M) (x2 => times 1 x2) id (one_mul M).

(; //LEAN:add_zero_eq_id ;)
add_zero_eq_id : (M : Set) -> (_ : Proof (AddZeroClass M)) -> Proof (Eqt (Elem M -> M) (x2 => plus x2 0) id).

(; //LEAN:mul_one_eq_id ;)
def mul_one_eq_id : (M : Set) -> (_ : Proof (MulOneClass M)) -> Proof (Eqt (Elem M -> M) (x2 => times x2 1) id) :=
  M => x => funext M (x1 => M) (x2 => times x2 1) id (mul_one M).

(; //LEAN:mul_left_comm ;)
mul_left_comm : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times a (times b c)) (times b (times a c))).

(; //LEAN:add_left_comm ;)
add_left_comm : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus a (plus b c)) (plus b (plus a c))).

(; //LEAN:mul_right_comm ;)
mul_right_comm : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times (times a b) c) (times (times a c) b)).

(; //LEAN:add_right_comm ;)
add_right_comm : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus (plus a b) c) (plus (plus a c) b)).

