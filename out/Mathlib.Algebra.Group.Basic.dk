(; //LEAN:mul_left_surjective ;)
def mul_left_surjective : (G : Set) -> (_ : Proof (Group G)) -> (a : Elem G) -> Proof (Function__Surjective (x1 => times a x1)) :=
  G => x => a => forallI G (x1 => exists G (a2 => Eqt G ((x3 => times a x3) a2) x1)) (x1 => existsI G (a1 => Eqt G ((x2 => times a x2) a1) x1) (times (Inv__inv a) x1) (mul_inv_cancel_left G a x1)).

(; //LEAN:mul_right_surjective ;)
def mul_right_surjective : (G : Set) -> (_ : Proof (Group G)) -> (a : Elem G) -> Proof (Function__Surjective (x1 => times x1 a)) :=
  G => x => a => forallI G (x1 => exists G (a2 => Eqt G ((x3 => times x3 a) a2) x1)) (x1 => existsI G (a1 => Eqt G ((x2 => times x2 a) a1) x1) (times x1 (Inv__inv a)) (inv_mul_cancel_right G x1 a)).

