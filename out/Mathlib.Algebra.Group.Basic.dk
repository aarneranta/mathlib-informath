sub_sub_self : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus a (minus a b)) b).

(; //LEAN:div_eq_div_mul_div ;)
div_eq_div_mul_div : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (div a b) (times (div c b) (div a c))).

(; //LEAN:sub_eq_sub_add_sub ;)
sub_eq_sub_add_sub : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (minus a b) (plus (minus c b) (minus a c))).

(; //LEAN:div_div_cancel ;)
def div_div_cancel : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (div a (div a b)) b) :=
  G => x => a => b => div_div_self' G a b.

(; //LEAN:sub_sub_cancel ;)
sub_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus a (minus a b)) b).

(; //LEAN:sub_sub_cancel_left ;)
sub_sub_cancel_left : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus (minus a b) a) (Neg__neg b)).

(; //LEAN:div_div_cancel_left ;)
div_div_cancel_left : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (div (div a b) a) (Inv__inv b)).

(; //LEAN:eq_div_iff_mul_eq'' ;)
eq_div_iff_mul_eq'' : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G a (div b c)) (Eqt G (times c a) b)).

(; //LEAN:eq_sub_iff_add_eq' ;)
eq_sub_iff_add_eq' : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G a (minus b c)) (Eqt G (plus c a) b)).

(; //LEAN:sub_eq_iff_eq_add' ;)
sub_eq_iff_eq_add' : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G (minus a b) c) (Eqt G a (plus b c))).

(; //LEAN:div_eq_iff_eq_mul' ;)
div_eq_iff_eq_mul' : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G (div a b) c) (Eqt G a (times b c))).

(; //LEAN:div_eq_iff_comm ;)
div_eq_iff_comm : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G (div a b) c) (Eqt G (div a c) b)).

(; //LEAN:sub_eq_iff_comm ;)
sub_eq_iff_comm : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G (minus a b) c) (Eqt G (minus a c) b)).

(; //LEAN:add_sub_cancel_left ;)
add_sub_cancel_left : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus (plus a b) a) b).

(; //LEAN:mul_div_cancel_left ;)
mul_div_cancel_left : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (div (times a b) a) b).

(; //LEAN:mul_div_cancel ;)
mul_div_cancel : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (times a (div b a)) b).

(; //LEAN:add_sub_cancel ;)
add_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a (minus b a)) b).

(; //LEAN:div_mul_cancel_left ;)
div_mul_cancel_left : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (div a (times a b)) (Inv__inv b)).

(; //LEAN:sub_add_cancel_left ;)
sub_add_cancel_left : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus a (plus a b)) (Neg__neg b)).

(; //LEAN:add_add_neg_cancel'_right ;)
add_add_neg_cancel'_right : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a (plus b (Neg__neg a))) b).

(; //LEAN:mul_mul_inv_cancel'_right ;)
mul_mul_inv_cancel'_right : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (times a (times b (Inv__inv a))) b).

(; //LEAN:mul_mul_div_cancel ;)
mul_mul_div_cancel : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times (times a c) (div b c)) (times a b)).

(; //LEAN:add_add_sub_cancel ;)
add_add_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus (plus a c) (minus b c)) (plus a b)).

(; //LEAN:sub_add_add_cancel ;)
sub_add_add_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus (minus a c) (plus b c)) (plus a b)).

(; //LEAN:div_mul_mul_cancel ;)
div_mul_mul_cancel : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times (div a c) (times b c)) (times a b)).

(; //LEAN:div_mul_div_cancel' ;)
div_mul_div_cancel' : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times (div a b) (div c a)) (div c b)).

(; //LEAN:sub_add_sub_cancel' ;)
sub_add_sub_cancel' : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus (minus a b) (minus c a)) (minus c b)).

(; //LEAN:mul_div_div_cancel ;)
mul_div_div_cancel : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (div (times a b) (div a c)) (times b c)).

(; //LEAN:add_sub_sub_cancel ;)
add_sub_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (minus (plus a b) (minus a c)) (plus b c)).

(; //LEAN:sub_sub_sub_cancel_left ;)
sub_sub_sub_cancel_left : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (minus (minus c a) (minus c b)) (minus b a)).

(; //LEAN:div_div_div_cancel_left ;)
div_div_div_cancel_left : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (div (div c a) (div c b)) (div b a)).

(; //LEAN:sub_eq_sub_iff_add_eq_add ;)
sub_eq_sub_iff_add_eq_add : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (minus a b) (minus c d)) (Eqt G (plus a d) (plus c b))).

(; //LEAN:div_eq_div_iff_mul_eq_mul ;)
div_eq_div_iff_mul_eq_mul : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (div a b) (div c d)) (Eqt G (times a d) (times c b))).

(; //LEAN:mul_inv_eq_mul_inv_iff_mul_eq_mul ;)
mul_inv_eq_mul_inv_iff_mul_eq_mul : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (times a (Inv__inv b)) (times c (Inv__inv d))) (Eqt G (times a d) (times c b))).

(; //LEAN:add_neg_eq_add_neg_iff_add_eq_add ;)
add_neg_eq_add_neg_iff_add_eq_add : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (plus a (Neg__neg b)) (plus c (Neg__neg d))) (Eqt G (plus a d) (plus c b))).

(; //LEAN:inv_mul_eq_inv_mul_iff_mul_eq_mul ;)
inv_mul_eq_inv_mul_iff_mul_eq_mul : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (times (Inv__inv b) a) (times (Inv__inv d) c)) (Eqt G (times a d) (times c b))).

(; //LEAN:neg_add_eq_neg_add_iff_add_eq_add ;)
neg_add_eq_neg_add_iff_add_eq_add : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (plus (Neg__neg b) a) (plus (Neg__neg d) c)) (Eqt G (plus a d) (plus c b))).

(; //LEAN:sub_eq_sub_iff_sub_eq_sub ;)
sub_eq_sub_iff_sub_eq_sub : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (minus a b) (minus c d)) (Eqt G (minus a c) (minus b d))).

(; //LEAN:div_eq_div_iff_div_eq_div ;)
div_eq_div_iff_div_eq_div : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (iff (Eqt G (div a b) (div c d)) (Eqt G (div a c) (div b d))).

(; //LEAN:const_div_involutive ;)
def const_div_involutive : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> Proof (Function__Involutive (x1 => div a x1)) :=
  G => x => a => forallI G (x1 => Eqt G (div a (div a x1)) x1) (x1 => div_div_cancel G a x1).

(; //LEAN:const_sub_involutive ;)
const_sub_involutive : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> Proof (Function__Involutive (x1 => minus a x1)).

(; //LEAN:multiplicative_of_symm_of_total ;)
multiplicative_of_symm_of_total : (X : Set) -> (Y : Set) -> (_ : Proof (Monoid Y)) -> (p : (Elem X -> Elem X -> Prop)) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Total r)) -> (f : (Elem X -> Elem X -> Y)) -> (_ : Proof (Std__Symm p)) -> (hf_swap : Proof (forall X (a2 => forall X (b2 => if (p a2 b2) (Eqt Y (times (f a2 b2) (f b2 a2)) 1))))) -> (hmul : Proof (forall X (a1 => forall X (b1 => forall X (c1 => if (r a1 b1) (if (r b1 c1) (if (p a1 b1) (if (p b1 c1) (if (p a1 c1) (Eqt Y (f a1 c1) (times (f a1 b1) (f b1 c1)))))))))))) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (pab : Proof (p a b)) -> (pbc : Proof (p b c)) -> (pac : Proof (p a c)) -> Proof (Eqt Y (f a c) (times (f a b) (f b c))).

(; //LEAN:additive_of_symm_of_total ;)
additive_of_symm_of_total : (X : Set) -> (Y : Set) -> (_ : Proof (AddMonoid Y)) -> (p : (Elem X -> Elem X -> Prop)) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Total r)) -> (f : (Elem X -> Elem X -> Y)) -> (_ : Proof (Std__Symm p)) -> (hf_swap : Proof (forall X (a2 => forall X (b2 => if (p a2 b2) (Eqt Y (plus (f a2 b2) (f b2 a2)) 0))))) -> (hadd : Proof (forall X (a1 => forall X (b1 => forall X (c1 => if (r a1 b1) (if (r b1 c1) (if (p a1 b1) (if (p b1 c1) (if (p a1 c1) (Eqt Y (f a1 c1) (plus (f a1 b1) (f b1 c1)))))))))))) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (pab : Proof (p a b)) -> (pbc : Proof (p b c)) -> (pac : Proof (p a c)) -> Proof (Eqt Y (f a c) (plus (f a b) (f b c))).

(; //LEAN:multiplicative_of_total ;)
multiplicative_of_total : (X : Set) -> (Y : Set) -> (_ : Proof (Monoid Y)) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Total r)) -> (f : (Elem X -> Elem X -> Y)) -> (p : (Elem X -> Prop)) -> (hswap : Proof (forall X (a2 => forall X (b2 => if (p a2) (if (p b2) (Eqt Y (times (f a2 b2) (f b2 a2)) 1)))))) -> (hmul : Proof (forall X (a1 => forall X (b1 => forall X (c1 => if (r a1 b1) (if (r b1 c1) (if (p a1) (if (p b1) (if (p c1) (Eqt Y (f a1 c1) (times (f a1 b1) (f b1 c1)))))))))))) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (pa : Proof (p a)) -> (pb : Proof (p b)) -> (pc : Proof (p c)) -> Proof (Eqt Y (f a c) (times (f a b) (f b c))).

(; //LEAN:additive_of_total ;)
additive_of_total : (X : Set) -> (Y : Set) -> (_ : Proof (AddMonoid Y)) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Total r)) -> (f : (Elem X -> Elem X -> Y)) -> (p : (Elem X -> Prop)) -> (hswap : Proof (forall X (a2 => forall X (b2 => if (p a2) (if (p b2) (Eqt Y (plus (f a2 b2) (f b2 a2)) 0)))))) -> (hadd : Proof (forall X (a1 => forall X (b1 => forall X (c1 => if (r a1 b1) (if (r b1 c1) (if (p a1) (if (p b1) (if (p c1) (Eqt Y (f a1 c1) (plus (f a1 b1) (f b1 c1)))))))))))) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (pa : Proof (p a)) -> (pb : Proof (p b)) -> (pc : Proof (p c)) -> Proof (Eqt Y (f a c) (plus (f a b) (f b c))).

(; //LEAN:hom_coe_pow ;)
hom_coe_pow : (M : Set) -> (F : Set) -> (_ : Proof (Monoid F)) -> (c : (Elem F -> Elem M -> M)) -> (h1 : Proof (Eqt (Elem M -> M) (c 1) id)) -> (hmul : Proof (forall F (f1 => forall F (g => Eqt (Elem M -> M) (c (times f1 g)) (Function__comp (c f1) (c g)))))) -> (f : Elem F) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (c (pow f n)) (Nat__iterate (c f) n)).

(; //LEAN:hom_coe_nsmul ;)
hom_coe_nsmul : (M : Set) -> (F : Set) -> (_ : Proof (AddMonoid F)) -> (c : (Elem F -> Elem M -> M)) -> (h1 : Proof (Eqt (Elem M -> M) (c 0) id)) -> (hadd : Proof (forall F (f1 => forall F (g => Eqt (Elem M -> M) (c (plus f1 g)) (Function__comp (c f1) (c g)))))) -> (f : Elem F) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (c (HSMul__hSMul n f)) (Nat__iterate (c f) n)).

