mul_mul_mul_comm : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (Eqt G (times (times a b) (times c d)) (times (times a c) (times b d))).

(; //LEAN:add_add_add_comm ;)
add_add_add_comm : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (Eqt G (plus (plus a b) (plus c d)) (plus (plus a c) (plus b d))).

(; //LEAN:add_add_add_comm' ;)
add_add_add_comm' : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (Eqt G (plus (plus (plus a b) c) d) (plus (plus (plus a c) b) d)).

(; //LEAN:mul_mul_mul_comm' ;)
mul_mul_mul_comm' : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> (d : Elem G) -> Proof (Eqt G (times (times (times a b) c) d) (times (times (times a c) b) d)).

(; //LEAN:add_rotate ;)
add_rotate : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus (plus a b) c) (plus (plus b c) a)).

(; //LEAN:mul_rotate ;)
mul_rotate : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times (times a b) c) (times (times b c) a)).

(; //LEAN:add_rotate' ;)
add_rotate' : (G : Set) -> (_ : Proof (AddCommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (plus a (plus b c)) (plus b (plus c a))).

(; //LEAN:mul_rotate' ;)
mul_rotate' : (G : Set) -> (_ : Proof (CommSemigroup G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (Eqt G (times a (times b c)) (times b (times c a))).

(; //LEAN:pow_boole ;)
pow_boole : (M : Set) -> (_ : Proof (Monoid M)) -> (P : Prop) -> (a : Elem M) -> Proof (Eqt M (pow a (ite P 1 0)) (ite P a 1)).

(; //LEAN:boole_nsmul ;)
boole_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (P : Prop) -> (a : Elem M) -> Proof (Eqt M (HSMul__hSMul (ite P 1 0) a) (ite P a 0)).

(; //LEAN:pow_mul_pow_sub ;)
pow_mul_pow_sub : (M : Set) -> (_ : Proof (Monoid M)) -> (m : Elem Nat) -> (n : Elem Nat) -> (a : Elem M) -> (h : Proof (Leq m n)) -> Proof (Eqt M (times (pow a m) (pow a (minus n m))) (pow a n)).

(; //LEAN:nsmul_add_sub_nsmul ;)
nsmul_add_sub_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (m : Elem Nat) -> (n : Elem Nat) -> (a : Elem M) -> (h : Proof (Leq m n)) -> Proof (Eqt M (plus (HSMul__hSMul m a) (HSMul__hSMul (minus n m) a)) (HSMul__hSMul n a)).

