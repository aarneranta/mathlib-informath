sub_nsmul_nsmul_add : (M : Set) -> (_ : Proof (AddMonoid M)) -> (m : Elem Nat) -> (n : Elem Nat) -> (a : Elem M) -> (h : Proof (Leq m n)) -> Proof (Eqt M (plus (HSMul__hSMul (minus n m) a) (HSMul__hSMul m a)) (HSMul__hSMul n a)).

(; //LEAN:pow_sub_mul_pow ;)
pow_sub_mul_pow : (M : Set) -> (_ : Proof (Monoid M)) -> (m : Elem Nat) -> (n : Elem Nat) -> (a : Elem M) -> (h : Proof (Leq m n)) -> Proof (Eqt M (times (pow a (minus n m)) (pow a m)) (pow a n)).

(; //LEAN:sub_one_nsmul_add ;)
sub_one_nsmul_add : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem M) -> Proof (Eqt M (plus a (HSMul__hSMul (minus n 1) a)) (HSMul__hSMul n a)).

(; //LEAN:mul_pow_sub_one ;)
mul_pow_sub_one : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem M) -> Proof (Eqt M (times a (pow a (minus n 1))) (pow a n)).

(; //LEAN:pow_sub_one_mul ;)
pow_sub_one_mul : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem M) -> Proof (Eqt M (times (pow a (minus n 1)) a) (pow a n)).

(; //LEAN:add_sub_one_nsmul ;)
add_sub_one_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem M) -> Proof (Eqt M (plus (HSMul__hSMul (minus n 1) a) a) (HSMul__hSMul n a)).

(; //LEAN:pow_eq_pow_mod ;)
pow_eq_pow_mod : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (n : Elem Nat) -> (m : Elem Nat) -> (ha : Proof (Eqt M (pow a n) 1)) -> Proof (Eqt M (pow a m) (pow a (HMod__hMod m n))).

(; //LEAN:nsmul_eq_mod_nsmul ;)
nsmul_eq_mod_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (n : Elem Nat) -> (m : Elem Nat) -> (ha : Proof (Eqt M (HSMul__hSMul n a) 0)) -> Proof (Eqt M (HSMul__hSMul m a) (HSMul__hSMul (HMod__hMod m n) a)).

(; //LEAN:nsmul_add_nsmul_eq_zero ;)
nsmul_add_nsmul_eq_zero : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (b : Elem M) -> (n : Elem Nat) -> (h : Proof (Eqt M (plus a b) 0)) -> Proof (Eqt M (plus (HSMul__hSMul n a) (HSMul__hSMul n b)) 0).

(; //LEAN:pow_mul_pow_eq_one ;)
pow_mul_pow_eq_one : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (b : Elem M) -> (n : Elem Nat) -> (h : Proof (Eqt M (times a b) 1)) -> Proof (Eqt M (times (pow a n) (pow b n)) 1).

(; //LEAN:mul_left_iterate ;)
mul_left_iterate : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => times a x2) n) (x3 => times (pow a n) x3)).

(; //LEAN:add_left_iterate ;)
add_left_iterate : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => plus a x2) n) (x3 => plus (HSMul__hSMul n a) x3)).

(; //LEAN:mul_right_iterate ;)
mul_right_iterate : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => times x2 a) n) (x3 => times x3 (pow a n))).

(; //LEAN:add_right_iterate ;)
add_right_iterate : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => plus x2 a) n) (x3 => plus x3 (HSMul__hSMul n a))).

(; //LEAN:mul_left_iterate_apply ;)
mul_left_iterate_apply : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => times a x1) n b) (times (pow a n) b)).

(; //LEAN:add_left_iterate_apply ;)
add_left_iterate_apply : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => plus a x1) n b) (plus (HSMul__hSMul n a) b)).

(; //LEAN:mul_right_iterate_apply ;)
mul_right_iterate_apply : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => times x1 a) n b) (times b (pow a n))).

(; //LEAN:add_right_iterate_apply ;)
add_right_iterate_apply : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => plus x1 a) n b) (plus b (HSMul__hSMul n a))).

(; //LEAN:add_left_iterate_apply_self ;)
add_left_iterate_apply_self : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (Nat__iterate (x1 => plus a x1) n a) (HSMul__hSMul (plus n 1) a)).

(; //LEAN:mul_left_iterate_apply_self ;)
mul_left_iterate_apply_self : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (Nat__iterate (x1 => times a x1) n a) (pow a (plus n 1))).

(; //LEAN:add_right_iterate_apply_self ;)
add_right_iterate_apply_self : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (Nat__iterate (x1 => plus x1 a) n a) (HSMul__hSMul (plus n 1) a)).

(; //LEAN:mul_right_iterate_apply_self ;)
mul_right_iterate_apply_self : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (Nat__iterate (x1 => times x1 a) n a) (pow a (plus n 1))).

(; //LEAN:add_left_iterate_apply_zero ;)
add_left_iterate_apply_zero : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (a : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => plus a x1) n 0) (HSMul__hSMul n a)).

(; //LEAN:mul_left_iterate_apply_one ;)
mul_left_iterate_apply_one : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (a : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => times a x1) n 1) (pow a n)).

(; //LEAN:add_right_iterate_apply_zero ;)
add_right_iterate_apply_zero : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> (a : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => plus x1 a) n 0) (HSMul__hSMul n a)).

(; //LEAN:mul_right_iterate_apply_one ;)
mul_right_iterate_apply_one : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> (a : Elem M) -> Proof (Eqt M (Nat__iterate (x1 => times x1 a) n 1) (pow a n)).

(; //LEAN:pow_iterate ;)
pow_iterate : (M : Set) -> (_ : Proof (Monoid M)) -> (k : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => pow x2 k) n) (x3 => pow x3 (pow k n))).

(; //LEAN:nsmul_iterate ;)
nsmul_iterate : (M : Set) -> (_ : Proof (AddMonoid M)) -> (k : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (Nat__iterate (x2 => HSMul__hSMul k x2) n) (x3 => HSMul__hSMul (pow k n) x3)).

(; //LEAN:inv_unique ;)
def inv_unique : (M : Set) -> (_ : Proof (CommMonoid M)) -> (x1 : Elem M) -> (y : Elem M) -> (z : Elem M) -> (hy : Proof (Eqt M (times x1 y) 1)) -> (hz : Proof (Eqt M (times x1 z) 1)) -> Proof (Eqt M y z) :=
  M => x => x1 => y => z => hy => hz => left_inv_eq_right_inv M x1 y z (Trans__trans (mul_comm M y x1) hy) hz.

(; //LEAN:neg_unique ;)
neg_unique : (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (x1 : Elem M) -> (y : Elem M) -> (z : Elem M) -> (hy : Proof (Eqt M (plus x1 y) 0)) -> (hz : Proof (Eqt M (plus x1 z) 0)) -> Proof (Eqt M y z).

(; //LEAN:mul_pow ;)
mul_pow : (M : Set) -> (_ : Proof (CommMonoid M)) -> (a : Elem M) -> (b : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (pow (times a b) n) (times (pow a n) (pow b n))).

(; //LEAN:nsmul_add ;)
nsmul_add : (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (a : Elem M) -> (b : Elem M) -> (n : Elem Nat) -> Proof (Eqt M (HSMul__hSMul n (plus a b)) (plus (HSMul__hSMul n a) (HSMul__hSMul n b))).

(; //LEAN:mul_eq_left ;)
def mul_eq_left : (M : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (IsLeftCancelMul M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Eqt M (times a b) a) (Eqt M b 1)) :=
  M => x => h => a => b => Trans__trans (Eq__mpr (id (congrArg M Prop (times a 1) a (_a => iff (Eqt M (times a b) a) (Eqt M (times a b) _a)) (mul_one M a))) (Iff__rfl (Eqt M (times a b) a))) (mul_left_cancel_iff M a b 1).

(; //LEAN:add_eq_left ;)
add_eq_left : (M : Set) -> (_ : Proof (AddMonoid M)) -> (_ : Proof (IsLeftCancelAdd M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Eqt M (plus a b) a) (Eqt M b 0)).

(; //LEAN:left_eq_add ;)
left_eq_add : (M : Set) -> (_ : Proof (AddMonoid M)) -> (_ : Proof (IsLeftCancelAdd M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Eqt M a (plus a b)) (Eqt M b 0)).

(; //LEAN:left_eq_mul ;)
def left_eq_mul : (M : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (IsLeftCancelMul M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Eqt M a (times a b)) (Eqt M b 1)) :=
  M => x => h => a => b => Iff__trans (Eqt M a (times a b)) (Eqt M (times a b) a) (Eqt M b 1) (eq_comm M a (times a b)) (mul_eq_left M a b).

(; //LEAN:add_ne_left ;)
add_ne_left : (M : Set) -> (_ : Proof (AddMonoid M)) -> (_ : Proof (IsLeftCancelAdd M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Neq (plus a b) a) (Neq b 0)).

(; //LEAN:mul_ne_left ;)
def mul_ne_left : (M : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (IsLeftCancelMul M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (Neq (times a b) a) (Neq b 1)) :=
