(; Mathlib.Algebra.Group.Even: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:IsSquare ;)
def IsSquare : (a : Elem X) -> Prop :=
  a => exists X (r => Eqt X a (times r r)).

(; //LEAN:Even ;)
def Even : (a : Elem X) -> Prop :=
  a => exists X (r => Eqt X a (plus r r)).

(; //LEAN:isSquare_iff_exists_mul_self ;)
def isSquare_iff_exists_mul_self : (X : Set) -> (a : Elem X) -> Proof (iff (IsSquare a) (exists X (r => Eqt X a (times r r)))) :=
  X => a => Iff__rfl (IsSquare a).

(; //LEAN:even_iff_exists_add_self ;)
def even_iff_exists_add_self : (X : Set) -> (a : Elem X) -> Proof (iff (even a) (exists X (r => Eqt X a (plus r r)))) :=
  X => a => Iff__rfl (even a).

(; //LEAN:IsSquare.exists_mul_self ;)
def IsSquare__exists_mul_self : (X : Set) -> (a : Elem X) -> (h : Proof (IsSquare a)) -> Proof (exists X (r => Eqt X a (times r r))) :=
  X => a => iffEl (IsSquare a) (exists X (r => Eqt X a (times r r))) (isSquare_iff_exists_mul_self X a).

(; //LEAN:Even.exists_add_self ;)
def Even__exists_add_self : (X : Set) -> (a : Elem X) -> (h : Proof (even a)) -> Proof (exists X (r => Eqt X a (plus r r))) :=
  X => a => iffEl (even a) (exists X (r => Eqt X a (plus r r))) (even_iff_exists_add_self X a).

(; //LEAN:IsSquare.mul_self ;)
def IsSquare__mul_self : (X : Set) -> (r : Elem X) -> Proof (IsSquare (times r r)) :=
  X => r => existsI X (r1 => Eqt X (times r r) (times r1 r1)) r rfl.

(; //LEAN:Even.add_self ;)
def Even__add_self : (X : Set) -> (r : Elem X) -> Proof (even (plus r r)) :=
  X => r => existsI X (r1 => Eqt X (plus r r) (plus r1 r1)) r rfl.

(; //LEAN:isSquare_op_iff ;)
isSquare_op_iff : (X : Set) -> (a : Elem X) -> Proof (iff (IsSquare (MulOpposite__op a)) (IsSquare a)).

(; //LEAN:even_op_iff ;)
even_op_iff : (X : Set) -> (a : Elem X) -> Proof (iff (even (AddOpposite__op a)) (even a)).

(; //LEAN:even_unop_iff ;)
def even_unop_iff : (X : Set) -> (a : Elem (AddOpposite X)) -> Proof (iff (even (AddOpposite__unop a)) (even a)) :=
  X => a => Iff__symm (even (AddOpposite__op (AddOpposite__unop a))) (even (AddOpposite__unop a)) (even_op_iff X (AddOpposite__unop a)).

(; //LEAN:isSquare_unop_iff ;)
def isSquare_unop_iff : (X : Set) -> (a : Elem (MulOpposite X)) -> Proof (iff (IsSquare (MulOpposite__unop a)) (IsSquare a)) :=
  X => a => Iff__symm (IsSquare (MulOpposite__op (MulOpposite__unop a))) (IsSquare (MulOpposite__unop a)) (isSquare_op_iff X (MulOpposite__unop a)).

(; //LEAN:even_ofMul_iff ;)
def even_ofMul_iff : (X : Set) -> (a : Elem X) -> Proof (iff (even (Additive__ofMul__app a)) (IsSquare a)) :=
  X => a => Iff__rfl (even (Additive__ofMul__app a)).

(; //LEAN:isSquare_toMul_iff ;)
def isSquare_toMul_iff : (X : Set) -> (a : Elem (Additive X)) -> Proof (iff (IsSquare (Additive__toMul__app a)) (even a)) :=
  X => a => Iff__rfl (IsSquare (Additive__toMul__app a)).

(; //LEAN:isSquare_ofAdd_iff ;)
def isSquare_ofAdd_iff : (X : Set) -> (a : Elem X) -> Proof (iff (IsSquare (Multiplicative__ofAdd__app a)) (even a)) :=
  X => a => Iff__rfl (IsSquare (Multiplicative__ofAdd__app a)).

(; //LEAN:even_toAdd_iff ;)
def even_toAdd_iff : (X : Set) -> (a : Elem (Multiplicative X)) -> Proof (iff (even (Multiplicative__toAdd__app a)) (IsSquare a)) :=
  X => a => Iff__rfl (even (Multiplicative__toAdd__app a)).

(; //LEAN:Even.zero ;)
def Even__zero : (X : Set) -> (_ : Proof (AddZeroClass X)) -> Proof (even 0) :=
  X => x => existsI X (r => Eqt X 0 (plus r r)) 0 (Eq__symm X (plus 0 0) 0 (add_zero X 0)).

(; //LEAN:IsSquare.one ;)
def IsSquare__one : (X : Set) -> (_ : Proof (MulOneClass X)) -> Proof (IsSquare 1) :=
  X => x => existsI X (r => Eqt X 1 (times r r)) 1 (Eq__symm X (times 1 1) 1 (mul_one X 1)).

(; //LEAN:Even.map ;)
Even__map : (F : Set) -> (X : Set) -> (Y : Set) -> (_ : Proof (AddZeroClass X)) -> (_ : Proof (AddZeroClass Y)) -> (a : Elem X) -> (f : Elem F) -> (h1 : Proof (even a)) -> Proof (even (f a)).

(; //LEAN:IsSquare.map ;)
IsSquare__map : (F : Set) -> (X : Set) -> (Y : Set) -> (_ : Proof (MulOneClass X)) -> (_ : Proof (MulOneClass Y)) -> (a : Elem X) -> (f : Elem F) -> (h1 : Proof (IsSquare a)) -> Proof (IsSquare (f a)).

(; //LEAN:isSquare_subset_image_isSquare ;)
isSquare_subset_image_isSquare : (F : Set) -> (X : Set) -> (Y : Set) -> (_ : Proof (MulOneClass X)) -> (_ : Proof (MulOneClass Y)) -> (f : Elem F) -> (hf : Proof (Function__Surjective f)) -> Proof (Set__Subset (Set__ofPred (b => IsSquare b)) (Set__image f (Set__ofPred (a => IsSquare a)))).

(; //LEAN:even_subset_image_even ;)
even_subset_image_even : (F : Set) -> (X : Set) -> (Y : Set) -> (_ : Proof (AddZeroClass X)) -> (_ : Proof (AddZeroClass Y)) -> (f : Elem F) -> (hf : Proof (Function__Surjective f)) -> Proof (Set__Subset (Set__ofPred (b => even b)) (Set__image f (Set__ofPred (a => even a)))).

(; //LEAN:isSquare_iff_exists_sq ;)
isSquare_iff_exists_sq : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> Proof (iff (IsSquare a) (exists X (r => Eqt X a (pow r 2)))).

(; //LEAN:even_iff_exists_two_nsmul ;)
even_iff_exists_two_nsmul : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> Proof (iff (even a) (exists X (r => Eqt X a (HSMul__hSMul 2 r)))).

(; //LEAN:IsSquare.exists_sq ;)
def IsSquare__exists_sq : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> (h : Proof (IsSquare a)) -> Proof (exists X (r => Eqt X a (pow r 2))) :=
  X => x => a => iffEl (IsSquare a) (exists X (r => Eqt X a (pow r 2))) (isSquare_iff_exists_sq X a).

(; //LEAN:Even.exists_two_nsmul ;)
def Even__exists_two_nsmul : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> (h : Proof (even a)) -> Proof (exists X (r => Eqt X a (HSMul__hSMul 2 r))) :=
  X => x => a => iffEl (even a) (exists X (r => Eqt X a (HSMul__hSMul 2 r))) (even_iff_exists_two_nsmul X a).

(; //LEAN:Even.two_nsmul ;)
def Even__two_nsmul : (X : Set) -> (_ : Proof (AddMonoid X)) -> (r : Elem X) -> Proof (even (HSMul__hSMul 2 r)) :=
  X => x => r => existsI X (r1 => Eqt X (HSMul__hSMul 2 r) (plus r1 r1)) r (two_nsmul X r).

(; //LEAN:IsSquare.sq ;)
def IsSquare__sq : (X : Set) -> (_ : Proof (Monoid X)) -> (r : Elem X) -> Proof (IsSquare (pow r 2)) :=
  X => x => r => existsI X (r1 => Eqt X (pow r 2) (times r1 r1)) r (pow_two X r).

(; //LEAN:IsSquare.pow ;)
IsSquare__pow : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> (n : Elem Nat) -> (ha : Proof (IsSquare a)) -> Proof (IsSquare (pow a n)).

(; //LEAN:Even.nsmul_right ;)
Even__nsmul_right : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> (n : Elem Nat) -> (ha : Proof (even a)) -> Proof (even (HSMul__hSMul n a)).

(; //LEAN:Even.isSquare_pow ;)
Even__isSquare_pow : (X : Set) -> (_ : Proof (Monoid X)) -> (n : Elem Nat) -> (hn : Proof (even n)) -> (a : Elem X) -> Proof (IsSquare (pow a n)).

(; //LEAN:Even.nsmul_left ;)
Even__nsmul_left : (X : Set) -> (_ : Proof (AddMonoid X)) -> (n : Elem Nat) -> (hn : Proof (even n)) -> (a : Elem X) -> Proof (even (HSMul__hSMul n a)).

(; //LEAN:Even.add ;)
Even__add : (X : Set) -> (_ : Proof (AddCommSemigroup X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (even a)) -> (h1 : Proof (even b)) -> Proof (even (plus a b)).

(; //LEAN:IsSquare.mul ;)
IsSquare__mul : (X : Set) -> (_ : Proof (CommSemigroup X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (IsSquare a)) -> (h1 : Proof (IsSquare b)) -> Proof (IsSquare (times a b)).

(; //LEAN:even_neg ;)
even_neg : (X : Set) -> (_ : Proof (SubtractionMonoid X)) -> (a : Elem X) -> Proof (iff (even (Neg__neg a)) (even a)).

(; //LEAN:isSquare_inv ;)
isSquare_inv : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> Proof (iff (IsSquare (Inv__inv a)) (IsSquare a)).

(; //LEAN:IsSquare.inv ;)
def IsSquare__inv : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> (h : Proof (IsSquare a)) -> Proof (IsSquare (Inv__inv a)) :=
  X => x => a => iffEr (IsSquare (Inv__inv a)) (IsSquare a) (isSquare_inv X a).

(; //LEAN:Even.neg ;)
def Even__neg : (X : Set) -> (_ : Proof (SubtractionMonoid X)) -> (a : Elem X) -> (h : Proof (even a)) -> Proof (even (Neg__neg a)) :=
  X => x => a => iffEr (even (Neg__neg a)) (even a) (even_neg X a).

(; //LEAN:Even.zsmul_right ;)
Even__zsmul_right : (X : Set) -> (_ : Proof (SubtractionMonoid X)) -> (a : Elem X) -> (n : Elem Int) -> (h : Proof (even a)) -> Proof (even (HSMul__hSMul n a)).

(; //LEAN:IsSquare.zpow ;)
IsSquare__zpow : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> (n : Elem Int) -> (h : Proof (IsSquare a)) -> Proof (IsSquare (pow a n)).

(; //LEAN:IsSquare.div ;)
IsSquare__div : (X : Set) -> (_ : Proof (DivisionCommMonoid X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (IsSquare a)) -> (hb : Proof (IsSquare b)) -> Proof (IsSquare (div a b)).

(; //LEAN:Even.sub ;)
Even__sub : (X : Set) -> (_ : Proof (SubtractionCommMonoid X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (even a)) -> (hb : Proof (even b)) -> Proof (even (minus a b)).

(; //LEAN:Even.zsmul_left ;)
Even__zsmul_left : (X : Set) -> (_ : Proof (AddGroup X)) -> (n : Elem Int) -> (h : Proof (even n)) -> (a : Elem X) -> Proof (even (HSMul__hSMul n a)).

(; //LEAN:Even.isSquare_zpow ;)
Even__isSquare_zpow : (X : Set) -> (_ : Proof (Group X)) -> (n : Elem Int) -> (h : Proof (even n)) -> (a : Elem X) -> Proof (IsSquare (pow a n)).

