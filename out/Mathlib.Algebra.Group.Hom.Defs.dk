(; //LEAN:ZeroHom.ext ;)
def ZeroHom__ext : (M : Set) -> (N : Set) -> (f : Elem (ZeroHom M N)) -> (g : Elem (ZeroHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (ZeroHom M N) f g) :=
  M => N => f => g => h => DFunLike__ext (ZeroHom M N) M (x2 => N) f g h.

(; //LEAN:ZeroHom.ext_iff ;)
ZeroHom__ext_iff : (M : Set) -> (N : Set) -> (f : Elem (ZeroHom M N)) -> (g : Elem (ZeroHom M N)) -> Proof (iff (Eqt (ZeroHom M N) f g) (forall M (x2 => Eqt N (f x2) (g x2)))).

(; //LEAN:OneHom.ext_iff ;)
