  M => x => f => g => rfl (Elem M -> M) (times f g).

(; //LEAN:Monoid.End.coe_mul ;)
def Monoid__End__coe_mul : (M : Set) -> (_ : Proof (MulOne M)) -> (f : Elem (Monoid__End M)) -> (g : Elem (Monoid__End M)) -> Proof (Eqt (Elem M -> M) (times f g) (Function__comp f g)) :=
  M => x => f => g => rfl (Elem M -> M) (times f g).

