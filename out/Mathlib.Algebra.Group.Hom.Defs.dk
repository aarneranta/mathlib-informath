  f => g => h => OneHom__mk g (OneHom__inverse___proof_1 f g h).

(; //LEAN:ZeroHom.inverse_apply ;)
ZeroHom__inverse_apply : (M : Set) -> (N : Set) -> (f : Elem (ZeroHom M N)) -> (g : (Elem N -> M)) -> (h : Proof (Function__LeftInverse g f)) -> (x2 : Elem N) -> Proof (Eqt M (ZeroHom__inverse__app f g h x2) (g x2)).

(; //LEAN:ZeroHom.inverse ;)
def ZeroHom__inverse : (f : Elem (ZeroHom M N)) -> (g : (Elem N -> M)) -> (h : Proof (Function__LeftInverse g f)) -> Elem (ZeroHom N M) :=
