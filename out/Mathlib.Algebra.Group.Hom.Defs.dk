(; //LEAN:OneHom.inverse_apply ;)
OneHom__inverse_apply : (M : Set) -> (N : Set) -> (f : Elem (OneHom M N)) -> (g : (Elem N -> M)) -> (h : Proof (Function__LeftInverse g f)) -> (x2 : Elem N) -> Proof (Eqt M (OneHom__inverse__app f g h x2) (g x2)).

(; //LEAN:MulHom.inverse ;)
