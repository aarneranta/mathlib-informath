(; //LEAN:MonoidHom.map_inv ;)
def MonoidHom__map_inv : (X : Set) -> (Y : Set) -> (_ : Proof (Group X)) -> (_ : Proof (DivisionMonoid Y)) -> (f : Elem (MonoidHom X Y)) -> (a : Elem X) -> Proof (Eqt Y (f (Inv__inv a)) (Inv__inv (f a))) :=
