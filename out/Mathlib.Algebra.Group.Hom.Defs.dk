  M => N => f => hmul => MulHom__ext M N (MulHom__mk M N f hmul) f (forallI M (x2 => Eqt N (MulHom__mk__app f hmul x2) (MulHom__mk__app f hmul x2)) (x2 => rfl N (MulHom__mk__app f hmul x2))).

(; //LEAN:AddHom.mk_coe ;)
def AddHom__mk_coe : (M : Set) -> (N : Set) -> (f : Elem (AddHom M N)) -> (hadd : Proof (forall M (x2 => forall M (y => Eqt N (f (plus x2 y)) (plus (f x2) (f y)))))) -> Proof (Eqt (AddHom M N) (AddHom__mk M N f hadd) f) :=
  M => N => f => hadd => AddHom__ext M N (AddHom__mk M N f hadd) f (forallI M (x2 => Eqt N (AddHom__mk__app f hadd x2) (AddHom__mk__app f hadd x2)) (x2 => rfl N (AddHom__mk__app f hadd x2))).

(; //LEAN:MonoidHom.mk_coe ;)
def MonoidHom__mk_coe : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> (hmul : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun M N (OneHomClass__toOneHom M N (MonoidHom M N) f) (times x2 y)) (times (OneHom__toFun M N (OneHomClass__toOneHom M N (MonoidHom M N) f) x2) (OneHom__toFun M N (OneHomClass__toOneHom M N (MonoidHom M N) f) y)))))) -> Proof (Eqt (MonoidHom M N) (MonoidHom__mk M N (OneHomClass__toOneHom M N (MonoidHom M N) f) hmul) f) :=
  M => N => x => x1 => f => hmul => MonoidHom__ext M N (MonoidHom__mk M N (OneHomClass__toOneHom M N (MonoidHom M N) f) hmul) f (forallI M (x2 => Eqt N (MonoidHom__mk__app (OneHomClass__toOneHom M N (MonoidHom M N) f) hmul x2) (MonoidHom__mk__app (OneHomClass__toOneHom M N (MonoidHom M N) f) hmul x2)) (x2 => rfl N (MonoidHom__mk__app (OneHomClass__toOneHom M N (MonoidHom M N) f) hmul x2))).

(; //LEAN:AddMonoidHom.mk_coe ;)
def AddMonoidHom__mk_coe : (M : Set) -> (N : Set) -> (_ : Proof (AddZero M)) -> (_ : Proof (AddZero N)) -> (f : Elem (AddMonoidHom M N)) -> (hadd : Proof (forall M (x2 => forall M (y => Eqt N (ZeroHom__toFun M N (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) (plus x2 y)) (plus (ZeroHom__toFun M N (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) x2) (ZeroHom__toFun M N (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) y)))))) -> Proof (Eqt (AddMonoidHom M N) (AddMonoidHom__mk M N (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) hadd) f) :=
  M => N => x => x1 => f => hadd => AddMonoidHom__ext M N (AddMonoidHom__mk M N (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) hadd) f (forallI M (x2 => Eqt N (AddMonoidHom__mk__app (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) hadd x2) (AddMonoidHom__mk__app (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) hadd x2)) (x2 => rfl N (AddMonoidHom__mk__app (ZeroHomClass__toZeroHom M N (AddMonoidHom M N) f) hadd x2))).

(; //LEAN:OneHom.copy ;)
