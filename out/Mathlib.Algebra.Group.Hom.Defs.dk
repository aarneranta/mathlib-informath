(; //LEAN:OneHom.map_one ;)
def OneHom__map_one : (M : Set) -> (N : Set) -> (f : Elem (OneHom M N)) -> Proof (Eqt N (f 1) 1) :=
  M => N => f => OneHom__map_one' M N f.

(; //LEAN:ZeroHom.map_zero ;)
def ZeroHom__map_zero : (M : Set) -> (N : Set) -> (f : Elem (ZeroHom M N)) -> Proof (Eqt N (f 0) 0) :=
  M => N => f => ZeroHom__map_zero' M N f.

(; //LEAN:MonoidHom.map_one ;)
def MonoidHom__map_one : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> Proof (Eqt N (f 1) 1) :=
