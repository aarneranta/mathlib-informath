def MonoidHom__coe_mk : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (OneHom M N)) -> (hmul : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun M N f (times x2 y)) (times (OneHom__toFun M N f x2) (OneHom__toFun M N f y)))))) -> Proof (Eqt (Elem M -> N) (MonoidHom__mk M N f hmul) f) :=
