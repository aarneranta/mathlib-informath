(; //LEAN:MonoidHom.mk' ;)
def MonoidHom__mk' : (M : Set) -> (G : Set) -> (f : (Elem M -> G)) -> (map_mul : Proof (forall M (a => forall M (b => Eqt G (f (times a b)) (times (f a) (f b)))))) -> Elem (MonoidHom M G) :=
  M => G => f => map_mul => MonoidHom__mk M G (OneHom__mk M G f (MonoidHom__mk'___proof_1 M G f map_mul)) map_mul.

(; //LEAN:AddMonoidHom.mk' ;)
def AddMonoidHom__mk' : (M : Set) -> (G : Set) -> (f : (Elem M -> G)) -> (map_add : Proof (forall M (a => forall M (b => Eqt G (f (plus a b)) (plus (f a) (f b)))))) -> Elem (AddMonoidHom M G) :=
  M => G => f => map_add => AddMonoidHom__mk M G (ZeroHom__mk M G f (AddMonoidHom__mk'___proof_1 M G f map_add)) map_add.

(; //LEAN:AddMonoidHom.mk'_apply ;)
AddMonoidHom__mk'_apply : (M : Set) -> (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (AddZeroClass M)) -> (f : (Elem M -> G)) -> (map_add : Proof (forall M (a => forall M (b => Eqt G (f (plus a b)) (plus (f a) (f b)))))) -> Proof (Eqt (Elem M -> G) (AddMonoidHom__mk' M G f map_add) f).

(; //LEAN:MonoidHom.mk'_apply ;)
MonoidHom__mk'_apply : (M : Set) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulOneClass M)) -> (f : (Elem M -> G)) -> (map_mul : Proof (forall M (a => forall M (b => Eqt G (f (times a b)) (times (f a) (f b)))))) -> Proof (Eqt (Elem M -> G) (MonoidHom__mk' M G f map_mul) f).

(; //LEAN:OneHom.mk_coe ;)
def OneHom__mk_coe : (M : Set) -> (N : Set) -> (f : Elem (OneHom M N)) -> (h1 : Proof (Eqt N (f 1) 1)) -> Proof (Eqt (OneHom M N) (OneHom__mk M N f h1) f) :=
  M => N => f => h1 => OneHom__ext M N (OneHom__mk M N f h1) f (forallI M (x2 => Eqt N (OneHom__mk__app f h1 x2) (OneHom__mk__app f h1 x2)) (x2 => rfl N (OneHom__mk__app f h1 x2))).

(; //LEAN:ZeroHom.mk_coe ;)
def ZeroHom__mk_coe : (M : Set) -> (N : Set) -> (f : Elem (ZeroHom M N)) -> (h1 : Proof (Eqt N (f 0) 0)) -> Proof (Eqt (ZeroHom M N) (ZeroHom__mk M N f h1) f) :=
  M => N => f => h1 => ZeroHom__ext M N (ZeroHom__mk M N f h1) f (forallI M (x2 => Eqt N (ZeroHom__mk__app f h1 x2) (ZeroHom__mk__app f h1 x2)) (x2 => rfl N (ZeroHom__mk__app f h1 x2))).

(; //LEAN:MulHom.mk_coe ;)
