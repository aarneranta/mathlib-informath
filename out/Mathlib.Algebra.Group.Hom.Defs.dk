MonoidHom__comp_one : (M : Set) -> (N : Set) -> (P : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOneClass N)) -> (_ : Proof (MulOneClass P)) -> (f : Elem (MonoidHom N P)) -> Proof (Eqt (MonoidHom M P) (MonoidHom__comp f 1) 1).

