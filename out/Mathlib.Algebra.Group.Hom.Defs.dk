(; //LEAN:MonoidHom.inverse ;)
def MonoidHom__inverse : (f : Elem (MonoidHom A B)) -> (g : (Elem B -> A)) -> (h : Proof (Function__LeftInverse g f)) -> (h1 : Proof (Function__RightInverse g f)) -> Elem (MonoidHom B A) :=
  f => g => h => h1 => MonoidHom__mk (OneHom__mk g (MonoidHom__inverse___proof_3 f g h)) (MonoidHom__inverse___proof_4 f g h h1).

(; //LEAN:AddMonoidHom.inverse_apply ;)
AddMonoidHom__inverse_apply : (A : Set) -> (B : Set) -> (_ : Proof (AddMonoid A)) -> (_ : Proof (AddMonoid B)) -> (f : Elem (AddMonoidHom A B)) -> (g : (Elem B -> A)) -> (h : Proof (Function__LeftInverse g f)) -> (h1 : Proof (Function__RightInverse g f)) -> (x2 : Elem B) -> Proof (Eqt A (AddMonoidHom__inverse__app f g h h1 x2) (g x2)).

(; //LEAN:MonoidHom.inverse_apply ;)
MonoidHom__inverse_apply : (A : Set) -> (B : Set) -> (_ : Proof (Monoid A)) -> (_ : Proof (Monoid B)) -> (f : Elem (MonoidHom A B)) -> (g : (Elem B -> A)) -> (h : Proof (Function__LeftInverse g f)) -> (h1 : Proof (Function__RightInverse g f)) -> (x2 : Elem B) -> Proof (Eqt A (MonoidHom__inverse__app f g h h1 x2) (g x2)).

(; //LEAN:AddMonoidHom.inverse ;)
def AddMonoidHom__inverse : (f : Elem (AddMonoidHom A B)) -> (g : (Elem B -> A)) -> (h : Proof (Function__LeftInverse g f)) -> (h1 : Proof (Function__RightInverse g f)) -> Elem (AddMonoidHom B A) :=
  f => g => h => h1 => AddMonoidHom__mk (ZeroHom__mk g (AddMonoidHom__inverse___proof_3 f g h)) (AddMonoidHom__inverse___proof_4 f g h h1).

(; //LEAN:Monoid.End ;)
def Monoid__End : (M : Set) -> Set :=
  M => MonoidHom M M.

(; //LEAN:AddMonoid.End ;)
def AddMonoid__End : (M : Set) -> Set :=
  M => AddMonoidHom M M.

(; //LEAN:AddMonoid.End.ext ;)
def AddMonoid__End__ext : (M : Set) -> (_ : Proof (AddZero M)) -> (f : Elem (AddMonoid__End M)) -> (g : Elem (AddMonoid__End M)) -> (h : Proof (forall M (x1 => Eqt M (f x1) (g x1)))) -> Proof (Eqt (AddMonoid__End M) f g) :=
  M => x => f => g => h => DFunLike__ext (AddMonoid__End M) M (x1 => M) f g h.

(; //LEAN:Monoid.End.ext_iff ;)
Monoid__End__ext_iff : (M : Set) -> (_ : Proof (MulOne M)) -> (f : Elem (Monoid__End M)) -> (g : Elem (Monoid__End M)) -> Proof (iff (Eqt (Monoid__End M) f g) (forall M (x1 => Eqt M (f x1) (g x1)))).

(; //LEAN:Monoid.End.ext ;)
def Monoid__End__ext : (M : Set) -> (_ : Proof (MulOne M)) -> (f : Elem (Monoid__End M)) -> (g : Elem (Monoid__End M)) -> (h : Proof (forall M (x1 => Eqt M (f x1) (g x1)))) -> Proof (Eqt (Monoid__End M) f g) :=
  M => x => f => g => h => DFunLike__ext (Monoid__End M) M (x1 => M) f g h.

(; //LEAN:AddMonoid.End.ext_iff ;)
AddMonoid__End__ext_iff : (M : Set) -> (_ : Proof (AddZero M)) -> (f : Elem (AddMonoid__End M)) -> (g : Elem (AddMonoid__End M)) -> Proof (iff (Eqt (AddMonoid__End M) f g) (forall M (x1 => Eqt M (f x1) (g x1)))).

(; //LEAN:AddMonoid.End.coe_pow ;)
def AddMonoid__End__coe_pow : (M : Set) -> (_ : Proof (AddZero M)) -> (f : Elem (AddMonoid__End M)) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (pow f n) (Nat__iterate f n)) :=
  M => x => f => n => rfl (Elem M -> M) (pow f n).

(; //LEAN:Monoid.End.coe_pow ;)
def Monoid__End__coe_pow : (M : Set) -> (_ : Proof (MulOne M)) -> (f : Elem (Monoid__End M)) -> (n : Elem Nat) -> Proof (Eqt (Elem M -> M) (pow f n) (Nat__iterate f n)) :=
  M => x => f => n => rfl (Elem M -> M) (pow f n).

(; //LEAN:AddMonoid.End.coe_one ;)
def AddMonoid__End__coe_one : (M : Set) -> (_ : Proof (AddZero M)) -> Proof (Eqt (Elem M -> M) 1 id) :=
  M => x => rfl (Elem M -> M) 1.

(; //LEAN:Monoid.End.coe_one ;)
def Monoid__End__coe_one : (M : Set) -> (_ : Proof (MulOne M)) -> Proof (Eqt (Elem M -> M) 1 id) :=
