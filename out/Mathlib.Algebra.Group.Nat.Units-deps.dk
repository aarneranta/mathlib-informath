(; constants used by Mathlib.Algebra.Group.Nat.Units, declared with their translated types ;)

(; doc: Units of an `AddMonoid`, bundled version.  An element of an `AddMonoid` is a unit if it has a two-sided additive inverse. This version bundles the inverse element so that it can be computed. For a predicate see `isAddUnit`. ;)
(; //LEAN:AddUnits ;)
AddUnits : (x : Set) -> Set.

(; //LEAN:AddUnits.ext ;)
AddUnits__ext : (x : Set) -> (_ : Proof (AddMonoid x)) -> (u : Elem (AddUnits x)) -> (v : Elem (AddUnits x)) -> (huv : Proof (Eqt x (AddUnits__val u) (AddUnits__val v))) -> Proof (Eqt (AddUnits x) u v).

(; doc: The additive inverse value of `val` in the base `AddMonoid`. ;)
(; //LEAN:AddUnits.neg ;)
AddUnits__neg : (self : Elem (AddUnits x)) -> Elem x.

(; doc: The underlying value in the base `AddMonoid`. ;)
(; //LEAN:AddUnits.val ;)
AddUnits__val : (self : Elem (AddUnits x)) -> Elem x.

(; doc: `neg` is the right additive inverse of `val` in the base `AddMonoid`. ;)
(; //LEAN:AddUnits.val_neg ;)
AddUnits__val_neg : (x : Set) -> (_ : Proof (AddMonoid x)) -> (self : Elem (AddUnits x)) -> Proof (Eqt x (plus (AddUnits__val self) (AddUnits__neg self)) 0).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (x : Set) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Eqt x a b)) -> Proof (Eqt x b a).

(; doc: An element `a : M` of an `AddMonoid` is an `AddUnit` if it has a two-sided additive inverse. The actual definition says that `a` is equal to some `u : AddUnits M`, where `AddUnits M` is a bundled version of `IsAddUnit`. ;)
(; //LEAN:IsAddUnit ;)
IsAddUnit : (a : Elem M) -> Prop.

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (a : Elem M) -> Prop.

(; //LEAN:Nat.eq_one_of_dvd_one ;)
Nat__eq_one_of_dvd_one : (n : Elem Nat) -> (H : Proof (divide n 1)) -> Proof (Eq n 1).

(; //LEAN:Nat.eq_zero_of_add_eq_zero ;)
Nat__eq_zero_of_add_eq_zero : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Eq (plus n m) 0)) -> Proof (and (Eq n 0) (Eq m 0)).

(; doc: Units of a `Monoid`, bundled version. Notation: `αˣ`.  An element of a `Monoid` is a unit if it has a two-sided inverse. This version bundles the inverse element so that it can be computed. For a predicate see `IsUnit`. ;)
(; //LEAN:Units ;)
Units : (x : Set) -> Set.

(; //LEAN:Units.ext ;)
Units__ext : (x : Set) -> (_ : Proof (Monoid x)) -> (u : Elem (Units x)) -> (v : Elem (Units x)) -> (huv : Proof (Eqt x (Units__val u) (Units__val v))) -> Proof (Eqt (Units x) u v).

(; doc: The inverse value of `val` in the base `Monoid`. ;)
(; //LEAN:Units.inv ;)
Units__inv : (self : Elem (Units x)) -> Elem x.

(; doc: The underlying value in the base `Monoid`. ;)
(; //LEAN:Units.val ;)
Units__val : (self : Elem (Units x)) -> Elem x.

(; doc: `inv` is the right inverse of `val` in the base `Monoid`. ;)
(; //LEAN:Units.val_inv ;)
Units__val_inv : (x : Set) -> (_ : Proof (Monoid x)) -> (self : Elem (Units x)) -> Proof (Eqt x (times (Units__val self) (Units__inv self)) 1).

(; //LEAN:isAddUnit_iff_eq_zero ;)
isAddUnit_iff_eq_zero : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (_ : Proof (Subsingleton (AddUnits M))) -> Proof (iff (IsAddUnit a) (Eqt M a 0)).

(; //LEAN:isUnit_iff_eq_one ;)
isUnit_iff_eq_one : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (_ : Proof (Subsingleton (Units M))) -> Proof (iff (IsUnit a) (Eqt M a 1)).

