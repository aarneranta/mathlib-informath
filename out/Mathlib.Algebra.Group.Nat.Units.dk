(; Mathlib.Algebra.Group.Nat.Units: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.units_eq_one ;)
def Nat__units_eq_one : (u : Elem (Units Nat)) -> Proof (Eqt (Units Nat) u 1) :=
  u => Units__ext Nat u 1 (Nat__eq_one_of_dvd_one (Units__val u) (existsI Nat (c => Eq 1 (times (Units__val u) c)) (Units__inv u) (Eq__symm Nat (times (Units__val u) (Units__inv u)) 1 (Units__val_inv Nat u)))).

(; //LEAN:Nat.addUnits_eq_zero ;)
def Nat__addUnits_eq_zero : (u : Elem (AddUnits Nat)) -> Proof (Eqt (AddUnits Nat) u 0) :=
  u => AddUnits__ext Nat u 0 (andEl (Eq (AddUnits__val u) 0) (Eq (AddUnits__neg u) 0) (Nat__eq_zero_of_add_eq_zero (AddUnits__val u) (AddUnits__neg u) (AddUnits__val_neg Nat u))).

(; //LEAN:Nat.isUnit_iff ;)
def Nat__isUnit_iff : (n : Elem Nat) -> Proof (iff (IsUnit n) (Eq n 1)) :=
  n => isUnit_iff_eq_one Nat n.

(; //LEAN:Nat.isAddUnit_iff ;)
def Nat__isAddUnit_iff : (n : Elem Nat) -> Proof (iff (IsAddUnit n) (Eq n 0)) :=
  n => isAddUnit_iff_eq_zero Nat n.

