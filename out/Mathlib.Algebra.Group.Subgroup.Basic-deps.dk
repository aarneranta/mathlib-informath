AddMonoidHom__liftOfSurjective___proof_1 : (X : Set) -> (X1 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (f : Elem (AddMonoidHom X X1)) -> (hf : Proof (Function__Surjective X X1 f)) -> Proof (Function__RightInverse X X1 (Function__surjInv X X1 f hf) f).

(; //LEAN:AddMonoidHom.mk ;)
AddMonoidHom__mk : (M : Set) -> (N : Set) -> (toZeroHom : Elem (ZeroHom M N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (ZeroHom__toFun M N toZeroHom (plus x2 y)) (plus (ZeroHom__toFun M N toZeroHom x2) (ZeroHom__toFun M N toZeroHom y)))))) -> Elem (AddMonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `AddMonoidHomClass F M N` into an actual `AddMonoidHom`. This is declared as the default coercion from `F` to `M →+ N`. ;)
(; //LEAN:AddMonoidHom.ofClass ;)
AddMonoidHom__ofClass : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> Elem (AddMonoidHom M N).

(; doc: `Prod.map` as an `AddMonoidHom`. ;)
(; //LEAN:AddMonoidHom.prodMap ;)
AddMonoidHom__prodMap : (M : Set) -> (N : Set) -> (M' : Set) -> (N' : Set) -> (f : Elem (AddMonoidHom M M')) -> (g : Elem (AddMonoidHom N N')) -> Elem (AddMonoidHom (Prod M N) (Prod M' N')).

(; doc: The range of an `AddMonoidHom` from an `AddGroup` is an `AddSubgroup`. ;)
(; //LEAN:AddMonoidHom.range ;)
AddMonoidHom__range : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> Elem (AddSubgroup N).

(; doc: Given additive monoids `A`, `B`, the natural projection homomorphism from `A × B` to `B` ;)
(; //LEAN:AddMonoidHom.snd ;)
AddMonoidHom__snd : (M : Set) -> (N : Set) -> Elem (AddMonoidHom (Prod M N) N).

(; //LEAN:AddMonoidHom.toZeroHom ;)
AddMonoidHom__toZeroHom : (M : Set) -> (N : Set) -> (self : Elem (AddMonoidHom M N)) -> Elem (ZeroHom M N).

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (A : Set) -> (H : Elem (AddSubgroup A)) -> Prop.

(; doc: `H` is closed under additive conjugation ;)
(; //LEAN:AddSubgroup.Normal.conj_mem ;)
AddSubgroup__Normal__conj_mem : (A : Set) -> (x : Proof (AddGroup A)) -> (H : Elem (AddSubgroup A)) -> (_ : Proof (AddSubgroup__Normal A H)) -> (n : Elem A) -> (h : Proof (Membership__mem A (AddSubgroup A) H n)) -> (g : Elem A) -> Proof (Membership__mem A (AddSubgroup A) H (plus (plus g n) (Neg__neg A g))).

(; //LEAN:AddSubgroup.Normal.mk ;)
AddSubgroup__Normal__mk : (A : Set) -> (_ : Proof (AddGroup A)) -> (H : Elem (AddSubgroup A)) -> (conj_mem : Proof (forall A (n => if (Membership__mem A (AddSubgroup A) H n) (forall A (g => Membership__mem A (AddSubgroup A) H (plus (plus g n) (Neg__neg A g))))))) -> Proof (AddSubgroup__Normal A H).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype G (x1 => Membership__mem G (AddSubgroup G) K x1))).

(; doc: The `AddSubgroup` generated by a set ;)
(; //LEAN:AddSubgroup.closure ;)
AddSubgroup__closure : (G : Set) -> (k : Elem (powerset G)) -> Elem (AddSubgroup G).

(; doc: The preimage of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.comap ;)
AddSubgroup__comap : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup N)) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.comap_top ;)
AddSubgroup__comap_top : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (f : Elem (AddMonoidHom G N)) -> Proof (Eqt (AddSubgroup G) (AddSubgroup__comap G N f (Top__top (AddSubgroup N))) (Top__top (AddSubgroup G))).

(; doc: Two `AddSubgroup`s are equal if they have the same elements. ;)
(; //LEAN:AddSubgroup.ext ;)
AddSubgroup__ext : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> (h : Proof (forall G (x1 => iff (Membership__mem G (AddSubgroup G) H x1) (Membership__mem G (AddSubgroup G) K x1)))) -> Proof (Eqt (AddSubgroup G) H K).

(; //LEAN:AddSubgroup.inertia._proof_1 ;)
AddSubgroup__inertia___proof_1 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (a : Elem G) -> (b : Elem G) -> (ha : Proof (Membership__mem G (powerset G) (Set__ofPred G (sigma1 => forall M (x5 => Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M sigma1 x5) x5)))) a)) -> (hb : Proof (Membership__mem G (powerset G) (Set__ofPred G (sigma => forall M (x4 => Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M sigma x4) x4)))) b)) -> (x3 : Elem M) -> Proof (Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M (times a b) x3) x3)).

(; //LEAN:AddSubgroup.inertia._proof_3 ;)
AddSubgroup__inertia___proof_3 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> Proof (Membership__mem G (powerset G) (Set__ofPred G (sigma => forall M (x3 => Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M sigma x3) x3)))) 1).

(; //LEAN:AddSubgroup.inertia._proof_4 ;)
AddSubgroup__inertia___proof_4 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (a : Elem G) -> (ha : Proof (Membership__mem G (powerset G) (Set__ofPred G (sigma => forall M (x4 => Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M sigma x4) x4)))) a)) -> (x3 : Elem M) -> Proof (Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M (Inv__inv G a) x3) x3)).

(; //LEAN:AddSubgroup.instSetLike ;)
AddSubgroup__instSetLike : (G : Set) -> Proof (SetLike (AddSubgroup G) G).

(; //LEAN:AddSubgroup.le_normalizer ;)
AddSubgroup__le_normalizer : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (Leq H (AddSubgroup__normalizer G (SetLike__coe (AddSubgroup G) G H))).

(; doc: The image of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.map ;)
AddSubgroup__map : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup G)) -> Elem (AddSubgroup N).

(; //LEAN:AddSubgroup.mem_bot ;)
AddSubgroup__mem_bot : (G : Set) -> (_ : Proof (AddGroup G)) -> (x1 : Elem G) -> Proof (iff (Membership__mem G (AddSubgroup G) (Bot__bot (AddSubgroup G)) x1) (Eqt G x1 0)).

(; //LEAN:AddSubgroup.mem_comap ;)
AddSubgroup__mem_comap : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (K : Elem (AddSubgroup N)) -> (f : Elem (AddMonoidHom G N)) -> (x2 : Elem G) -> Proof (iff (Membership__mem G (AddSubgroup G) (AddSubgroup__comap G N f K) x2) (Membership__mem N (AddSubgroup N) K (f x2))).

(; //LEAN:AddSubgroup.mem_top ;)
AddSubgroup__mem_top : (G : Set) -> (_ : Proof (AddGroup G)) -> (x1 : Elem G) -> Proof (Membership__mem G (AddSubgroup G) (Top__top (AddSubgroup G)) x1).

(; //LEAN:AddSubgroup.mk ;)
AddSubgroup__mk : (G : Set) -> (toAddSubmonoid : Elem (AddSubmonoid G)) -> (neg_mem' : Proof (forall G (x1 => if (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G toAddSubmonoid)) x1) (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G toAddSubmonoid)) (Neg__neg G x1))))) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.normalCore._proof_1 ;)
AddSubgroup__normalCore___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (a : Elem G) -> Proof (Membership__mem G (AddSubgroup G) H (plus (plus a 0) (Neg__neg G a))).

(; //LEAN:AddSubgroup.normalCore._proof_2 ;)
AddSubgroup__normalCore___proof_2 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (x1 : Elem G) -> (x2 : Elem G) -> (ha : Proof (Membership__mem G (powerset G) (Set__ofPred G (a1 => forall G (b1 => Membership__mem G (AddSubgroup G) H (plus (plus b1 a1) (Neg__neg G b1))))) x1)) -> (hb : Proof (Membership__mem G (powerset G) (Set__ofPred G (a => forall G (b => Membership__mem G (AddSubgroup G) H (plus (plus b a) (Neg__neg G b))))) x2)) -> (c : Elem G) -> Proof (Membership__mem G (AddSubgroup G) H (plus (plus c (plus x1 x2)) (Neg__neg G c))).

(; //LEAN:AddSubgroup.normalCore._proof_3 ;)
AddSubgroup__normalCore___proof_3 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (x1 : Elem G) -> (h : Proof (Membership__mem G (powerset G) (Set__ofPred G (a => forall G (b1 => Membership__mem G (AddSubgroup G) H (plus (plus b1 a) (Neg__neg G b1))))) x1)) -> (b : Elem G) -> Proof (Membership__mem G (AddSubgroup G) H (plus (plus b (Neg__neg G x1)) (Neg__neg G b))).

(; //LEAN:AddSubgroup.normalCore_normal ;)
AddSubgroup__normalCore_normal : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (AddSubgroup__Normal G (AddSubgroup__normalCore G H)).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g + S - g = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:AddSubgroup.normalizer ;)
AddSubgroup__normalizer : (G : Set) -> (S : Elem (powerset G)) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.pi._proof_1 ;)
AddSubgroup__pi___proof_1 : (X : Set) -> (f : (Elem X -> Set)) -> (_ : Proof ((i8 : Elem X) -> AddGroup (f i8))) -> (I : Elem (powerset X)) -> (H : ((i7 : Elem X) -> AddSubgroup (f i7))) -> (x1 : ((i6 : Elem X) -> f i6)) -> (hp : Proof (Membership__mem ((i1 : Elem X) -> f i1) (powerset ((i2 : Elem X) -> f i2)) (AddSubsemigroup__carrier ((i3 : Elem X) -> f i3) (AddSubmonoid__toAddSubsemigroup ((i4 : Elem X) -> f i4) (AddSubmonoid__pi X f I (i5 => AddSubgroup__toAddSubmonoid (f i5) (H i5))))) x1)) -> (i : Elem X) -> (hI : Proof (Membership__mem X (powerset X) I i)) -> Proof (Membership__mem (f i) (AddSubgroup (f i)) (H i) (Neg__neg (f i) (x1 i))).

(; //LEAN:AddSubgroup.prod._proof_1 ;)
AddSubgroup__prod___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> (x2 : Elem (Prod G N)) -> (hx : Proof (Membership__mem (Prod G N) (powerset (Prod G N)) (AddSubsemigroup__carrier (Prod G N) (AddSubmonoid__toAddSubsemigroup (Prod G N) (AddSubmonoid__prod N G (AddSubgroup__toAddSubmonoid G H) (AddSubgroup__toAddSubmonoid N K)))) x2)) -> Proof (and (Membership__mem G (powerset G) (SetLike__coe (AddSubmonoid G) G (AddSubgroup__toAddSubmonoid G H)) (Prod__fst G N (Neg__neg (Prod G N) x2))) (Membership__mem N (powerset N) (SetLike__coe (AddSubmonoid N) N (AddSubgroup__toAddSubmonoid N K)) (Prod__snd G N (Neg__neg (Prod G N) x2)))).

(; //LEAN:AddSubgroup.prodEquiv._proof_1 ;)
AddSubgroup__prodEquiv___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> (x2 : Elem (Subtype (Prod G N) (x7 => Membership__mem (Prod G N) (AddSubgroup (Prod G N)) (AddSubgroup__prod G N H K) x7))) -> (x3 : Elem (Subtype (Prod G N) (x6 => Membership__mem (Prod G N) (AddSubgroup (Prod G N)) (AddSubgroup__prod G N H K) x6))) -> Proof (Eqt (Prod (Subtype G (x4 => Membership__mem G (AddSubgroup G) H x4)) (Subtype N (x5 => Membership__mem N (AddSubgroup N) K x5))) (Equiv__toFun (Set__Elem (Prod G N) (SProd__sprod (powerset G) (powerset N) (powerset (Prod G N)) (SetLike__coe (AddSubgroup G) G H) (SetLike__coe (AddSubgroup N) N K))) (Prod (Set__Elem G (SetLike__coe (AddSubgroup G) G H)) (Set__Elem N (SetLike__coe (AddSubgroup N) N K))) (Equiv__Set__prod G N (SetLike__coe (AddSubgroup G) G H) (SetLike__coe (AddSubgroup N) N K)) (plus x2 x3)) (Equiv__toFun (Set__Elem (Prod G N) (SProd__sprod (powerset G) (powerset N) (powerset (Prod G N)) (SetLike__coe (AddSubgroup G) G H) (SetLike__coe (AddSubgroup N) N K))) (Prod (Set__Elem G (SetLike__coe (AddSubgroup G) G H)) (Set__Elem N (SetLike__coe (AddSubgroup N) N K))) (Equiv__Set__prod G N (SetLike__coe (AddSubgroup G) G H) (SetLike__coe (AddSubgroup N) N K)) (plus x2 x3))).

(; //LEAN:AddSubgroup.range_subtype ;)
AddSubgroup__range_subtype : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (Eqt (AddSubgroup G) (AddMonoidHom__range (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) G (AddSubgroup__subtype G H)) H).

(; doc: The `AddSubgroup` generated by a set includes the set. ;)
(; //LEAN:AddSubgroup.subset_closure ;)
AddSubgroup__subset_closure : (G : Set) -> (_ : Proof (AddGroup G)) -> (k : Elem (powerset G)) -> Proof (Set__Subset G k (SetLike__coe (AddSubgroup G) G (AddSubgroup__closure G k))).

(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) G).

(; doc: Reinterpret an `AddSubgroup` as an `AddSubmonoid`. ;)
(; //LEAN:AddSubgroup.toAddSubmonoid ;)
AddSubgroup__toAddSubmonoid : (G : Set) -> (self : Elem (AddSubgroup G)) -> Elem (AddSubmonoid G).

(; doc: `AddSubgroupClass S G` states `S` is a type of subsets `s ⊆ G` that are additive subgroups of `G`. ;)
(; //LEAN:AddSubgroupClass ;)
AddSubgroupClass : (S : Set) -> (G : Set) -> Prop.

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; //LEAN:AddSubmonoid.mk ;)
AddSubmonoid__mk : (M : Set) -> (toAddSubsemigroup : Elem (AddSubsemigroup M)) -> (zero_mem' : Proof (Membership__mem M (powerset M) (AddSubsemigroup__carrier M toAddSubsemigroup) 0)) -> Elem (AddSubmonoid M).

(; doc: A version of `Set.pi` for `AddSubmonoid`s. Given an index set `I` and a family of `AddSubmonoid`s `s : Π i, AddSubmonoid f i`, `pi I s` is the `AddSubmonoid` of dependent functions `f : Π i, f i` such that `f i` belongs to `pi I s` whenever `i ∈ I`. ;)
(; //LEAN:AddSubmonoid.pi ;)
AddSubmonoid__pi : (I : Set) -> (M : (Elem I -> Set)) -> (I1 : Elem (powerset I)) -> (S : ((i1 : Elem I) -> AddSubmonoid (M i1))) -> Elem (AddSubmonoid ((i : Elem I) -> M i)).

(; doc: Given `AddSubmonoid`s `s`, `t` of `AddMonoid`s `A`, `B` respectively, `s × t` as an `AddSubmonoid` of `A × B`. ;)
(; //LEAN:AddSubmonoid.prod ;)
AddSubmonoid__prod : (N : Set) -> (M : Set) -> (s : Elem (AddSubmonoid M)) -> (t : Elem (AddSubmonoid N)) -> Elem (AddSubmonoid (Prod M N)).

(; doc: An additive submonoid of an additive monoid `M` can be considered as an additive subsemigroup of that additive monoid. ;)
(; //LEAN:AddSubmonoid.toAddSubsemigroup ;)
AddSubmonoid__toAddSubsemigroup : (M : Set) -> (self : Elem (AddSubmonoid M)) -> Elem (AddSubsemigroup M).

(; doc: The carrier of an additive subsemigroup. ;)
(; //LEAN:AddSubsemigroup.carrier ;)
AddSubsemigroup__carrier : (M : Set) -> (self : Elem (AddSubsemigroup M)) -> Elem (powerset M).

(; //LEAN:AddSubsemigroup.mk ;)
AddSubsemigroup__mk : (M : Set) -> (carrier : Elem (powerset M)) -> (add_mem' : Proof (forall M (a => forall M (b => if (Membership__mem M (powerset M) carrier a) (if (Membership__mem M (powerset M) carrier b) (Membership__mem M (powerset M) carrier (plus a b))))))) -> Elem (AddSubsemigroup M).

(; //LEAN:AddZero.toZero ;)
AddZero__toZero : (M : Set) -> Proof (Zero M).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : (X : Set) -> Elem X.

(; doc: A commutative group is a group with commutative `(*)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:CommGroup ;)
CommGroup : (G : Set) -> Prop.

(; doc: Two elements commute if `a * b = b * a`. ;)
(; //LEAN:Commute ;)
Commute : (M : Set) -> (a : Elem M) -> (b : Elem M) -> Prop.

(; doc: The quotient type of conjugacy classes of a group. ;)
(; //LEAN:ConjClasses ;)
ConjClasses : (X : Set) -> Set.

(; doc: Given a conjugacy class `a`, `carrier a` is the set it represents. ;)
(; //LEAN:ConjClasses.carrier ;)
ConjClasses__carrier : (X : Set) -> (x1 : Elem (ConjClasses X)) -> Elem (powerset X).

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : (X : Set) -> Elem X.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Set notation form of `Eq.le` ;)
(; //LEAN:Eq.subset ;)
Eq__subset : (X : Set) -> (_ : Proof (UsesSetNotationForOrder X)) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Eqt X a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; doc: The set product of two sets is equivalent to the type product of their coercions to types. ;)
(; //LEAN:Equiv.Set.prod ;)
Equiv__Set__prod : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> Elem (Equiv (Set__Elem (Prod X Y) (SProd__sprod (powerset X) (powerset Y) (powerset (Prod X Y)) s t)) (Prod (Set__Elem X s) (Set__Elem Y t))).

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: Typeclass for faithful actions. ;)
(; //LEAN:FaithfulSMul ;)
FaithfulSMul : (M : Set) -> (X : Set) -> Prop.

(; doc: A function is called bijective if it is both injective and surjective. ;)
(; //LEAN:Function.Bijective ;)
Function__Bijective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: `RightInverse g f` means that `g` is a right inverse to `f`. That is, `f ∘ g = id`. ;)
(; //LEAN:Function.RightInverse ;)
Function__RightInverse : (X : Set) -> (Y : Set) -> (g : (Elem Y -> X)) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: The inverse of a surjective function. (Unlike `invFun`, this does not require `α` to be inhabited.) ;)
(; //LEAN:Function.surjInv ;)
Function__surjInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (h : Proof (Function__Surjective X Y f)) -> (b : Elem Y) -> Elem X.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h1 : Proof (iff a b)) -> (h2 : Proof (iff b c)) -> Proof (iff a c).

(; doc: Infimum of a set ;)
(; //LEAN:InfSet.sInf ;)
InfSet__sInf : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: We say that `a` is additively conjugate to `b` if for some additive unit `c` we have `c + a + -c = b`. ;)
(; //LEAN:IsAddConj ;)
IsAddConj : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:IsAddConj.refl ;)
IsAddConj__refl : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> Proof (IsAddConj X a a).

(; //LEAN:IsAddConj.trans ;)
IsAddConj__trans : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (IsAddConj X a b)) -> (h1 : Proof (IsAddConj X b c)) -> Proof (IsAddConj X a c).

(; doc: We say that `a` is conjugate to `b` if for some unit `c` we have `c * a * c⁻¹ = b`. ;)
(; //LEAN:IsConj ;)
IsConj : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:IsConj.refl ;)
IsConj__refl : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> Proof (IsConj X a a).

(; //LEAN:IsConj.trans ;)
IsConj__trans : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (IsConj X a b)) -> (h1 : Proof (IsConj X b c)) -> Proof (IsConj X a c).

(; //LEAN:IsEmpty.forall_iff ;)
IsEmpty__forall_iff : (X : Set) -> (_ : Proof (IsEmpty X)) -> (p : (Elem X -> Prop)) -> Proof (iff (forall X (a => p a)) True).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h1 : Proof (Leq a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Maximal P x` means that `x` is a maximal element satisfying `P`. ;)
(; //LEAN:Maximal ;)
Maximal : (X : Set) -> (P : (Elem X -> Prop)) -> (x1 : Elem X) -> Prop.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of monoid morphisms as a monoid morphism. ;)
(; //LEAN:MonoidHom.comp ;)
MonoidHom__comp : (M : Set) -> (N : Set) -> (P : Set) -> (hnp : Elem (MonoidHom N P)) -> (hmn : Elem (MonoidHom M N)) -> Elem (MonoidHom M P).

(; //LEAN:MonoidHom.ext ;)
MonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> (g : Elem (MonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (MonoidHom M N) f g).

(; doc: Given monoids `M`, `N`, the natural projection homomorphism from `M × N` to `M`. ;)
(; //LEAN:MonoidHom.fst ;)
MonoidHom__fst : (M : Set) -> (N : Set) -> Elem (MonoidHom (Prod M N) M).

(; doc: Given monoids `M`, `N`, the natural inclusion homomorphism from `M` to `M × N`. ;)
(; //LEAN:MonoidHom.inl ;)
MonoidHom__inl : (M : Set) -> (N : Set) -> Elem (MonoidHom M (Prod M N)).

(; doc: Given monoids `M`, `N`, the natural inclusion homomorphism from `N` to `M × N`. ;)
(; //LEAN:MonoidHom.inr ;)
MonoidHom__inr : (M : Set) -> (N : Set) -> Elem (MonoidHom N (Prod M N)).

(; doc: The multiplicative kernel of a monoid homomorphism is the subgroup of elements `x : G` such that `f x = 1` ;)
(; //LEAN:MonoidHom.ker ;)
MonoidHom__ker : (G : Set) -> (M : Set) -> (f : Elem (MonoidHom G M)) -> Elem (Subgroup G).

(; //LEAN:MonoidHom.liftOfRightInverse._proof_2 ;)
MonoidHom__liftOfRightInverse___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (g : Elem (Subtype (MonoidHom X X2) (g2 => Leq (MonoidHom__ker X X1 f) (MonoidHom__ker X X2 g2)))) -> Proof (Leq (MonoidHom__ker X X1 f) (MonoidHom__ker X X2 (Subtype__val (MonoidHom X X2) (g1 => Leq (MonoidHom__ker X X1 f) (MonoidHom__ker X X2 g1)) g))).

