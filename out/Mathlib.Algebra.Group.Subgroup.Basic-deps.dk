(; //LEAN:AddMonoidHom.liftOfRightInverse._proof_5 ;)
AddMonoidHom__liftOfRightInverse___proof_5 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (phi : Elem (AddMonoidHom X1 X2)) -> (x3 : Elem X) -> (hx : Proof (Membership__mem X (AddSubgroup X) (AddMonoidHom__ker X X1 f) x3)) -> Proof (Membership__mem X (AddSubgroup X) (AddMonoidHom__ker X X2 (AddMonoidHom__comp X X1 X2 phi f)) x3).

(; //LEAN:AddMonoidHom.liftOfRightInverseAux._proof_1 ;)
AddMonoidHom__liftOfRightInverseAux___proof_1 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse X X1 f_neg f)) -> (g : Elem (AddMonoidHom X X2)) -> (hg : Proof (Leq (AddMonoidHom__ker X X1 f) (AddMonoidHom__ker X X2 g))) -> (x3 : Elem X1) -> (y : Elem X1) -> Proof (Eqt X2 (g (f_neg (plus x3 y))) (plus (g (f_neg x3)) (g (f_neg y)))).

