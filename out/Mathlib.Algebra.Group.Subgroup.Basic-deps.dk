(; //LEAN:MulAut.characteristic._proof_6 ;)
MulAut__characteristic___proof_6 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic G H)) -> (phi : Elem (MulAut G)) -> (h1 : Elem (Subtype G (x6 => Membership__mem G (Subgroup G) H x6))) -> Proof (Eqt (Subtype G (x1 => Membership__mem G (Subgroup G) H x1)) (Subtype__mk G (x2 => Membership__mem G (Subgroup G) H x2) (phi (Subtype__val G (x3 => Membership__mem G (Subgroup G) H x3) (Subtype__mk G (x4 => Membership__mem G (Subgroup G) H x4) (MulEquiv__symm__app phi (Subtype__val G (x5 => Membership__mem G (Subgroup G) H x5) h1)) (MulAut__characteristic___proof_2 G H phi h1)))) (MulAut__characteristic___proof_5 G H phi h1)) h1).

