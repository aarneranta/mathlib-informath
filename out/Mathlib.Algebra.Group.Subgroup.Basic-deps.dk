(; constants used by Mathlib.Algebra.Group.Subgroup.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
AddAut__addConj__app : (a1 : Elem G) -> Elem (AddAut G).

(; a constant applied as a function: DFunLike.coe ;)
AddAut__characteristic__app : (a1 : Elem (AddSubgroup G)) -> (a2 : Elem (AddAut G)) -> Elem (AddAut (Subtype (x5 => Membership__mem H x5))).

(; a constant applied as a function: DFunLike.coe ;)
AddEquiv__symm__app : (a1 : Elem (AddAut (Subtype (x2 => Membership__mem H x2)))) -> (a2 : Elem (Subtype (x3 => Membership__mem H x3))) -> Elem (Subtype (x4 => Membership__mem H x4)).

(; a constant applied as a function: DFunLike.coe ;)
AddEquiv__toAddMonoidHom__app : (a1 : Elem (AddEquiv G G)) -> (a2 : Elem G) -> Elem G.

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__fst__app : (a1 : Set) -> (a2 : Set) -> (a3 : Elem (Prod G N)) -> Elem G.

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__liftOfRightInverseAux__app : (a1 : Elem (AddMonoidHom X X1)) -> (a2 : (Elem X1 -> X)) -> (a3 : Proof (Function__RightInverse f_neg f)) -> (a4 : Elem (AddMonoidHom X X2)) -> (a5 : Proof (Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g))) -> (a6 : Elem X1) -> Elem X2.

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__liftOfRightInverse__app : (a1 : Elem (AddMonoidHom X X1)) -> (a2 : (Elem X1 -> X)) -> (a3 : Proof (Function__RightInverse f_neg f)) -> (a4 : Elem (Subtype (g1 => Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g1)))) -> Elem (AddMonoidHom X1 X2).

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__snd__app : (a1 : Set) -> (a2 : Set) -> (a3 : Elem (Prod G N)) -> Elem N.

(; a constant applied as a function: DFunLike.coe ;)
DFunLike__coe__app : (a1 : Elem (Equiv (Subtype (g1 => Leq (MonoidHom__ker f) (MonoidHom__ker g1))) (MonoidHom X1 X2))) -> (a2 : Elem (Subtype (g2 => Leq (MonoidHom__ker f) (MonoidHom__ker g2)))) -> (a3 : Elem X1) -> Elem X2.

(; a constant applied as a function: DFunLike.coe ;)
MonoidHom__liftOfRightInverseAux__app : (a1 : Elem (MonoidHom X X1)) -> (a2 : (Elem X1 -> X)) -> (a3 : Proof (Function__RightInverse f_inv f)) -> (a4 : Elem (MonoidHom X X2)) -> (a5 : Proof (Leq (MonoidHom__ker f) (MonoidHom__ker g))) -> (a6 : Elem X1) -> Elem X2.

(; a constant applied as a function: DFunLike.coe ;)
MonoidHom__liftOfRightInverse__app : (a1 : Elem (MonoidHom X X1)) -> (a2 : (Elem X1 -> X)) -> (a3 : Proof (Function__RightInverse f_inv f)) -> (a4 : Elem (Subtype (g1 => Leq (MonoidHom__ker f) (MonoidHom__ker g1)))) -> Elem (MonoidHom X1 X2).

(; a constant applied as a function: DFunLike.coe ;)
MulAut__characteristic__app : (a1 : Elem (Subgroup G)) -> (a2 : Elem (MulAut G)) -> Elem (MulAut (Subtype (x5 => Membership__mem H x5))).

(; a constant applied as a function: DFunLike.coe ;)
MulAut__conj__app : (a1 : Elem G) -> Elem (MulAut G).

(; a constant applied as a function: DFunLike.coe ;)
MulEquiv__symm__app : (a1 : Elem (MulAut (Subtype (x2 => Membership__mem H x2)))) -> (a2 : Elem (Subtype (x3 => Membership__mem H x3))) -> Elem (Subtype (x4 => Membership__mem H x4)).

(; a constant applied as a function: DFunLike.coe ;)
MulEquiv__toMonoidHom__app : (a1 : Elem (MulEquiv G G)) -> (a2 : Elem G) -> Elem G.

(; a constant applied as a function: DFunLike.coe ;)
Subtype__val__app : (a1 : Elem (Subtype (g3 => Leq (MonoidHom__ker f) (MonoidHom__ker g3)))) -> (a2 : Elem X) -> Elem X2.

(; doc: The group of additive automorphisms. ;)
(; //LEAN:AddAut ;)
AddAut : (M : Set) -> Set.

(; //LEAN:AddAut.characteristic._proof_17 ;)
AddAut__characteristic___proof_17 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Characteristic H)) -> Proof (Eqt (AddAut (Subtype (x1 => Membership__mem H x1))) (AddEquiv__mk (Equiv__mk (h1 => OfNat__ofNat__app 0 h1) (h2 => AddEquiv__symm__app 0 h2) (AddAut__characteristic___proof_12 H) (AddAut__characteristic___proof_14 H)) (AddAut__characteristic___proof_16 H)) (AddEquiv__mk (Equiv__mk (h3 => OfNat__ofNat__app 0 h3) (h4 => AddEquiv__symm__app 0 h4) (AddAut__characteristic___proof_12 H) (AddAut__characteristic___proof_14 H)) (AddAut__characteristic___proof_16 H))).

(; //LEAN:AddAut.characteristic._proof_26 ;)
AddAut__characteristic___proof_26 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Characteristic H)) -> (x1 : Elem (AddAut G)) -> (x2 : Elem (AddAut G)) -> Proof (Eqt (AddAut (Subtype (x3 => Membership__mem H x3))) (AddEquiv__mk (Equiv__mk (h1 => HAdd__hAdd__app x1 x2 h1) (h2 => AddEquiv__symm__app (plus x1 x2) h2) (AddAut__characteristic___proof_21 H x1 x2) (AddAut__characteristic___proof_23 H x1 x2)) (AddAut__characteristic___proof_25 H x1 x2)) (AddEquiv__mk (Equiv__mk (h3 => HAdd__hAdd__app x1 x2 h3) (h4 => AddEquiv__symm__app (plus x1 x2) h4) (AddAut__characteristic___proof_21 H x1 x2) (AddAut__characteristic___proof_23 H x1 x2)) (AddAut__characteristic___proof_25 H x1 x2))).

(; //LEAN:AddAut.characteristic._proof_4 ;)
AddAut__characteristic___proof_4 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Characteristic H)) -> (x1 : Elem (AddAut G)) -> (h1 : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (AddEquiv__symm__app x1 (x1 h1)) h1).

(; //LEAN:AddAut.characteristic._proof_6 ;)
AddAut__characteristic___proof_6 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Characteristic H)) -> (x1 : Elem (AddAut G)) -> (h1 : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (x1 (AddEquiv__symm__app x1 h1)) h1).

(; //LEAN:AddAut.characteristic._proof_8 ;)
AddAut__characteristic___proof_8 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Characteristic H)) -> (x1 : Elem (AddAut G)) -> (h1 : Elem (Subtype (x4 => Membership__mem H x4))) -> (k : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (x1 (plus h1 k)) (plus (x1 h1) (x1 k))).

(; doc: An additive commutative group is an additive group with commutative `(+)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:AddCommGroup ;)
AddCommGroup : (G : Set) -> Prop.

(; doc: Two elements additively commute if `a + b = b + a` ;)
(; //LEAN:AddCommute ;)
AddCommute : (a : Elem M) -> (b : Elem M) -> Prop.

(; doc: `AddEquiv α β` is the type of an equiv `α ≃ β` which preserves addition. ;)
(; //LEAN:AddEquiv ;)
AddEquiv : (A : Set) -> (B : Set) -> Set.

(; //LEAN:AddEquiv.mk ;)
AddEquiv__mk : (toEquiv : Elem (Equiv A B)) -> (map_add' : Proof (forall A (x2 => forall A (y => Eqt B (Equiv__toFun toEquiv (plus x2 y)) (plus (Equiv__toFun toEquiv x2) (Equiv__toFun toEquiv y)))))) -> Elem (AddEquiv A B).

(; doc: A bijective `AddSemigroup` homomorphism is an isomorphism ;)
(; //LEAN:AddEquiv.ofBijective ;)
AddEquiv__ofBijective : (f : Elem F) -> (hf : Proof (Function__Bijective f)) -> Elem (AddEquiv M N).

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:AddEquiv.symm ;)
AddEquiv__symm : (h : Elem (AddEquiv M N)) -> Elem (AddEquiv N M).

(; doc: `e.symm` is a left inverse of `e`, written as `e.symm (e y) = y`. ;)
(; //LEAN:AddEquiv.symm_apply_apply ;)
AddEquiv__symm_apply_apply : (M : Set) -> (N : Set) -> (e : Elem (AddEquiv M N)) -> (x2 : Elem M) -> Proof (Eqt M (AddEquiv__symm__app e (e x2)) x2).

(; doc: Extract the forward direction of an additive equivalence as an addition-preserving function. ;)
(; //LEAN:AddEquiv.toAddMonoidHom ;)
AddEquiv__toAddMonoidHom : (h : Elem (AddEquiv M N)) -> Elem (AddMonoidHom M N).

(; doc: An `AddGroup` is an `AddMonoid` with a unary `-` satisfying `-a + a = 0`.  There is also a binary operation `-` such that `a - b = a + -b`, with a default so that `a - b = a + -b` holds by definition.  Use `AddGroup.ofLeftAxioms` or `AddGroup.ofRightAxioms` to define an additive group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:AddGroup ;)
AddGroup : (A : Set) -> Prop.

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of additive monoid morphisms as an additive monoid morphism. ;)
(; //LEAN:AddMonoidHom.comp ;)
AddMonoidHom__comp : (hnp : Elem (AddMonoidHom N P)) -> (hmn : Elem (AddMonoidHom M N)) -> Elem (AddMonoidHom M P).

(; //LEAN:AddMonoidHom.ext ;)
AddMonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (AddZero M)) -> (_ : Proof (AddZero N)) -> (f : Elem (AddMonoidHom M N)) -> (g : Elem (AddMonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (AddMonoidHom M N) f g).

(; doc: Given additive monoids `A`, `B`, the natural projection homomorphism from `A × B` to `A` ;)
(; //LEAN:AddMonoidHom.fst ;)
AddMonoidHom__fst : (M : Set) -> (N : Set) -> Elem (AddMonoidHom (Prod M N) M).

(; doc: Given additive monoids `A`, `B`, the natural inclusion homomorphism from `A` to `A × B`. ;)
(; //LEAN:AddMonoidHom.inl ;)
AddMonoidHom__inl : (M : Set) -> (N : Set) -> Elem (AddMonoidHom M (Prod M N)).

(; doc: Given additive monoids `A`, `B`, the natural inclusion homomorphism from `B` to `A × B`. ;)
(; //LEAN:AddMonoidHom.inr ;)
AddMonoidHom__inr : (M : Set) -> (N : Set) -> Elem (AddMonoidHom N (Prod M N)).

(; doc: The additive kernel of an `AddMonoid` homomorphism is the `AddSubgroup` of elements such that `f x = 0` ;)
(; //LEAN:AddMonoidHom.ker ;)
AddMonoidHom__ker : (f : Elem (AddMonoidHom G M)) -> Elem (AddSubgroup G).

(; //LEAN:AddMonoidHom.liftOfRightInverse._proof_2 ;)
AddMonoidHom__liftOfRightInverse___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (g : Elem (Subtype (g1 => Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g1)))) -> Proof (Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g)).

(; //LEAN:AddMonoidHom.liftOfRightInverse._proof_3 ;)
AddMonoidHom__liftOfRightInverse___proof_3 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_neg f)) -> (g : Elem (Subtype (g3 => Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g3)))) -> Proof (Eqt (Subtype (g1 => Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g1))) ((x3 => AddMonoidHom__comp x3 f) ((g2 => AddMonoidHom__liftOfRightInverseAux f f_neg hf g2 (Subtype__property g2)) g)) g).

(; //LEAN:AddMonoidHom.liftOfRightInverse._proof_4 ;)
AddMonoidHom__liftOfRightInverse___proof_4 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_neg f)) -> (x3 : Elem (AddMonoidHom X1 X2)) -> Proof (Eqt (AddMonoidHom X1 X2) ((g => AddMonoidHom__liftOfRightInverseAux f f_neg hf g (Subtype__property g)) ((x4 => AddMonoidHom__comp x4 f) x3)) x3).

(; //LEAN:AddMonoidHom.liftOfRightInverseAux._proof_1 ;)
AddMonoidHom__liftOfRightInverseAux___proof_1 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_neg f)) -> (g : Elem (AddMonoidHom X X2)) -> (hg : Proof (Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g))) -> (x3 : Elem X1) -> (y : Elem X1) -> Proof (Eqt X2 (g (f_neg (plus x3 y))) (plus (g (f_neg x3)) (g (f_neg y)))).

(; //LEAN:AddMonoidHom.liftOfRightInverseAux._proof_2 ;)
AddMonoidHom__liftOfRightInverseAux___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_neg f)) -> (g : Elem (AddMonoidHom X X2)) -> (hg : Proof (Leq (AddMonoidHom__ker f) (AddMonoidHom__ker g))) -> Proof (Membership__mem (AddMonoidHom__ker g) (f_neg 0)).

(; //LEAN:AddMonoidHom.liftOfSurjective._proof_1 ;)
AddMonoidHom__liftOfSurjective___proof_1 : (X : Set) -> (X1 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (f : Elem (AddMonoidHom X X1)) -> (hf : Proof (Function__Surjective f)) -> Proof (Function__RightInverse (Function__surjInv hf) f).

(; //LEAN:AddMonoidHom.mk ;)
AddMonoidHom__mk : (toZeroHom : Elem (ZeroHom M N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (ZeroHom__toFun toZeroHom (plus x2 y)) (plus (ZeroHom__toFun toZeroHom x2) (ZeroHom__toFun toZeroHom y)))))) -> Elem (AddMonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `AddMonoidHomClass F M N` into an actual `AddMonoidHom`. This is declared as the default coercion from `F` to `M →+ N`. ;)
(; //LEAN:AddMonoidHom.ofClass ;)
AddMonoidHom__ofClass : (f : Elem F) -> Elem (AddMonoidHom M N).

(; doc: `Prod.map` as an `AddMonoidHom`. ;)
(; //LEAN:AddMonoidHom.prodMap ;)
AddMonoidHom__prodMap : (f : Elem (AddMonoidHom M M')) -> (g : Elem (AddMonoidHom N N')) -> Elem (AddMonoidHom (Prod M N) (Prod M' N')).

(; doc: The range of an `AddMonoidHom` from an `AddGroup` is an `AddSubgroup`. ;)
(; //LEAN:AddMonoidHom.range ;)
AddMonoidHom__range : (f : Elem (AddMonoidHom G N)) -> Elem (AddSubgroup N).

(; doc: Given additive monoids `A`, `B`, the natural projection homomorphism from `A × B` to `B` ;)
(; //LEAN:AddMonoidHom.snd ;)
AddMonoidHom__snd : (M : Set) -> (N : Set) -> Elem (AddMonoidHom (Prod M N) N).

(; //LEAN:AddMonoidHom.toZeroHom ;)
AddMonoidHom__toZeroHom : (self : Elem (AddMonoidHom M N)) -> Elem (ZeroHom M N).

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (H : Elem (AddSubgroup A)) -> Prop.

(; doc: `H` is closed under additive conjugation ;)
(; //LEAN:AddSubgroup.Normal.conj_mem ;)
AddSubgroup__Normal__conj_mem : (A : Set) -> (x : Proof (AddGroup A)) -> (H : Elem (AddSubgroup A)) -> (_ : Proof (AddSubgroup__Normal H)) -> (n : Elem A) -> (h : Proof (Membership__mem H n)) -> (g : Elem A) -> Proof (Membership__mem H (plus (plus g n) (Neg__neg g))).

(; //LEAN:AddSubgroup.Normal.mk ;)
AddSubgroup__Normal__mk : (A : Set) -> (_ : Proof (AddGroup A)) -> (H : Elem (AddSubgroup A)) -> (conj_mem : Proof (forall A (n => if (Membership__mem H n) (forall A (g => Membership__mem H (plus (plus g n) (Neg__neg g))))))) -> Proof (AddSubgroup__Normal H).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype (x1 => Membership__mem K x1))).

(; doc: The `AddSubgroup` generated by a set ;)
(; //LEAN:AddSubgroup.closure ;)
AddSubgroup__closure : (k : Elem (powerset G)) -> Elem (AddSubgroup G).

(; doc: The preimage of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.comap ;)
AddSubgroup__comap : (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup N)) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.comap_top ;)
AddSubgroup__comap_top : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (f : Elem (AddMonoidHom G N)) -> Proof (Eqt (AddSubgroup G) (AddSubgroup__comap f Top__top) Top__top).

(; doc: Two `AddSubgroup`s are equal if they have the same elements. ;)
(; //LEAN:AddSubgroup.ext ;)
AddSubgroup__ext : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> (h : Proof (forall G (x1 => iff (Membership__mem H x1) (Membership__mem K x1)))) -> Proof (Eqt (AddSubgroup G) H K).

(; //LEAN:AddSubgroup.inertia._proof_1 ;)
AddSubgroup__inertia___proof_1 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (a : Elem G) -> (b : Elem G) -> (ha : Proof (Membership__mem (Set__ofPred (x6 => forall M (x7 => Membership__mem I (minus (HSMul__hSMul x6 x7) x7)))) a)) -> (hb : Proof (Membership__mem (Set__ofPred (x4 => forall M (x5 => Membership__mem I (minus (HSMul__hSMul x4 x5) x5)))) b)) -> (x3 : Elem M) -> Proof (Membership__mem I (minus (HSMul__hSMul (times a b) x3) x3)).

(; //LEAN:AddSubgroup.inertia._proof_3 ;)
AddSubgroup__inertia___proof_3 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> Proof (Membership__mem (Set__ofPred (x3 => forall M (x4 => Membership__mem I (minus (HSMul__hSMul x3 x4) x4)))) 1).

(; //LEAN:AddSubgroup.inertia._proof_4 ;)
AddSubgroup__inertia___proof_4 : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (a : Elem G) -> (ha : Proof (Membership__mem (Set__ofPred (x4 => forall M (x5 => Membership__mem I (minus (HSMul__hSMul x4 x5) x5)))) a)) -> (x3 : Elem M) -> Proof (Membership__mem I (minus (HSMul__hSMul (Inv__inv a) x3) x3)).

(; //LEAN:AddSubgroup.instSetLike ;)
AddSubgroup__instSetLike : Proof (SetLike (AddSubgroup G) G).

(; //LEAN:AddSubgroup.le_normalizer ;)
AddSubgroup__le_normalizer : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (Leq H (AddSubgroup__normalizer H)).

(; doc: The image of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.map ;)
AddSubgroup__map : (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup G)) -> Elem (AddSubgroup N).

(; //LEAN:AddSubgroup.mem_bot ;)
AddSubgroup__mem_bot : (G : Set) -> (_ : Proof (AddGroup G)) -> (x1 : Elem G) -> Proof (iff (Membership__mem Bot__bot x1) (Eqt G x1 0)).

(; //LEAN:AddSubgroup.mem_comap ;)
AddSubgroup__mem_comap : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (K : Elem (AddSubgroup N)) -> (f : Elem (AddMonoidHom G N)) -> (x2 : Elem G) -> Proof (iff (Membership__mem (AddSubgroup__comap f K) x2) (Membership__mem K (f x2))).

(; //LEAN:AddSubgroup.mem_top ;)
AddSubgroup__mem_top : (G : Set) -> (_ : Proof (AddGroup G)) -> (x1 : Elem G) -> Proof (Membership__mem Top__top x1).

(; //LEAN:AddSubgroup.mk ;)
AddSubgroup__mk : (toAddSubmonoid : Elem (AddSubmonoid G)) -> (neg_mem' : Proof (forall G (x1 => if (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup toAddSubmonoid)) x1) (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup toAddSubmonoid)) (Neg__neg x1))))) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.normalCore._proof_1 ;)
AddSubgroup__normalCore___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (a : Elem G) -> Proof (Membership__mem H (plus (plus a 0) (Neg__neg a))).

(; //LEAN:AddSubgroup.normalCore._proof_2 ;)
AddSubgroup__normalCore___proof_2 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (x1 : Elem G) -> (x2 : Elem G) -> (ha : Proof (Membership__mem (Set__ofPred (a1 => forall G (b1 => Membership__mem H (plus (plus b1 a1) (Neg__neg b1))))) x1)) -> (hb : Proof (Membership__mem (Set__ofPred (a => forall G (b => Membership__mem H (plus (plus b a) (Neg__neg b))))) x2)) -> (c : Elem G) -> Proof (Membership__mem H (plus (plus c (plus x1 x2)) (Neg__neg c))).

(; //LEAN:AddSubgroup.normalCore._proof_3 ;)
AddSubgroup__normalCore___proof_3 : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (x1 : Elem G) -> (h : Proof (Membership__mem (Set__ofPred (a => forall G (b1 => Membership__mem H (plus (plus b1 a) (Neg__neg b1))))) x1)) -> (b : Elem G) -> Proof (Membership__mem H (plus (plus b (Neg__neg x1)) (Neg__neg b))).

(; //LEAN:AddSubgroup.normalCore_normal ;)
AddSubgroup__normalCore_normal : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (AddSubgroup__Normal (AddSubgroup__normalCore H)).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g + S - g = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:AddSubgroup.normalizer ;)
AddSubgroup__normalizer : (S : Elem (powerset G)) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.pi._proof_1 ;)
AddSubgroup__pi___proof_1 : (X : Set) -> (f : (Elem X -> Set)) -> (_ : Proof ((i4 : Elem X) -> AddGroup (f i4))) -> (I : Elem (powerset X)) -> (H : ((i3 : Elem X) -> AddSubgroup (f i3))) -> (x1 : ((i2 : Elem X) -> f i2)) -> (hp : Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__pi I (i1 => H i1)))) x1)) -> (i : Elem X) -> (hI : Proof (Membership__mem I i)) -> Proof (Membership__mem (H i) (Neg__neg (x1 i))).

(; //LEAN:AddSubgroup.prod._proof_1 ;)
AddSubgroup__prod___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> (x2 : Elem (Prod G N)) -> (hx : Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__prod H K))) x2)) -> Proof (and (Membership__mem H (Prod__fst (Neg__neg x2))) (Membership__mem K (Prod__snd (Neg__neg x2)))).

(; //LEAN:AddSubgroup.prodEquiv._proof_1 ;)
AddSubgroup__prodEquiv___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (N : Set) -> (_ : Proof (AddGroup N)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> (x2 : Elem (Subtype (x7 => Membership__mem (AddSubgroup__prod H K) x7))) -> (x3 : Elem (Subtype (x6 => Membership__mem (AddSubgroup__prod H K) x6))) -> Proof (Eqt (Prod (Subtype (x4 => Membership__mem H x4)) (Subtype (x5 => Membership__mem K x5))) (Equiv__toFun (Equiv__Set__prod H K) (plus x2 x3)) (Equiv__toFun (Equiv__Set__prod H K) (plus x2 x3))).

(; //LEAN:AddSubgroup.range_subtype ;)
AddSubgroup__range_subtype : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (Eqt (AddSubgroup G) (AddMonoidHom__range (AddSubgroup__subtype H)) H).

(; doc: The `AddSubgroup` generated by a set includes the set. ;)
(; //LEAN:AddSubgroup.subset_closure ;)
AddSubgroup__subset_closure : (G : Set) -> (_ : Proof (AddGroup G)) -> (k : Elem (powerset G)) -> Proof (Set__Subset k (AddSubgroup__closure k)).

(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype (x1 => Membership__mem H x1)) G).

(; doc: An `AddSubgroup` of an `AddGroup` inherits an `AddGroup` structure. ;)
(; //LEAN:AddSubgroup.toAddGroup ;)
AddSubgroup__toAddGroup : (H : Elem (AddSubgroup G)) -> Proof (AddGroup (Subtype (x1 => Membership__mem H x1))).

(; doc: `AddSubgroupClass S G` states `S` is a type of subsets `s ⊆ G` that are additive subgroups of `G`. ;)
(; //LEAN:AddSubgroupClass ;)
AddSubgroupClass : (S : Set) -> (G : Elem (outParam Set)) -> Prop.

(; //LEAN:AddSubmonoid.mk ;)
AddSubmonoid__mk : (toAddSubsemigroup : Elem (AddSubsemigroup M)) -> (zero_mem' : Proof (Membership__mem (AddSubsemigroup__carrier toAddSubsemigroup) 0)) -> Elem (AddSubmonoid M).

(; doc: A version of `Set.pi` for `AddSubmonoid`s. Given an index set `I` and a family of `AddSubmonoid`s `s : Π i, AddSubmonoid f i`, `pi I s` is the `AddSubmonoid` of dependent functions `f : Π i, f i` such that `f i` belongs to `pi I s` whenever `i ∈ I`. ;)
(; //LEAN:AddSubmonoid.pi ;)
AddSubmonoid__pi : (I1 : Elem (powerset I)) -> (S : ((i1 : Elem I) -> AddSubmonoid (M i1))) -> Elem (AddSubmonoid ((i : Elem I) -> M i)).

(; doc: Given `AddSubmonoid`s `s`, `t` of `AddMonoid`s `A`, `B` respectively, `s × t` as an `AddSubmonoid` of `A × B`. ;)
(; //LEAN:AddSubmonoid.prod ;)
AddSubmonoid__prod : (s : Elem (AddSubmonoid M)) -> (t : Elem (AddSubmonoid N)) -> Elem (AddSubmonoid (Prod M N)).

(; doc: An additive submonoid of an additive monoid `M` can be considered as an additive subsemigroup of that additive monoid. ;)
(; //LEAN:AddSubmonoid.toAddSubsemigroup ;)
AddSubmonoid__toAddSubsemigroup : (self : Elem (AddSubmonoid M)) -> Elem (AddSubsemigroup M).

(; doc: The carrier of an additive subsemigroup. ;)
(; //LEAN:AddSubsemigroup.carrier ;)
AddSubsemigroup__carrier : (self : Elem (AddSubsemigroup M)) -> Elem (powerset M).

(; //LEAN:AddSubsemigroup.mk ;)
AddSubsemigroup__mk : (carrier : Elem (powerset M)) -> (add_mem' : Proof (forall M (a => forall M (b => if (Membership__mem carrier a) (if (Membership__mem carrier b) (Membership__mem carrier (plus a b))))))) -> Elem (AddSubsemigroup M).

(; //LEAN:AddZero.toZero ;)
AddZero__toZero : Proof (Zero M).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: A commutative group is a group with commutative `(*)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:CommGroup ;)
CommGroup : (G : Set) -> Prop.

(; doc: Two elements commute if `a * b = b * a`. ;)
(; //LEAN:Commute ;)
Commute : (a : Elem M) -> (b : Elem M) -> Prop.

(; doc: The quotient type of conjugacy classes of a group. ;)
(; //LEAN:ConjClasses ;)
ConjClasses : (X : Set) -> Set.

(; doc: Given a conjugacy class `a`, `carrier a` is the set it represents. ;)
(; //LEAN:ConjClasses.carrier ;)
ConjClasses__carrier : (x1 : Elem (ConjClasses X)) -> Elem (powerset X).

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : Elem X.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Set notation form of `Eq.le` ;)
(; //LEAN:Eq.subset ;)
Eq__subset : (X : Set) -> (_ : Proof (UsesSetNotationForOrder X)) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; doc: The set product of two sets is equivalent to the type product of their coercions to types. ;)
(; //LEAN:Equiv.Set.prod ;)
Equiv__Set__prod : (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> Elem (Equiv (Set__Elem (SProd__sprod s t)) (Prod (Set__Elem s) (Set__Elem t))).

(; //LEAN:Equiv.mk ;)
Equiv__mk : (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: Typeclass for faithful actions. ;)
(; //LEAN:FaithfulSMul ;)
FaithfulSMul : (M : Set) -> (X : Set) -> Prop.

(; doc: A function is called bijective if it is both injective and surjective. ;)
(; //LEAN:Function.Bijective ;)
Function__Bijective : (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; doc: `RightInverse g f` means that `g` is a right inverse to `f`. That is, `f ∘ g = id`. ;)
(; //LEAN:Function.RightInverse ;)
Function__RightInverse : (g : (Elem Y -> X)) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (f : (Elem X -> Y)) -> Prop.

(; doc: The inverse of a surjective function. (Unlike `invFun`, this does not require `α` to be inhabited.) ;)
(; //LEAN:Function.surjInv ;)
Function__surjInv : (h : Proof (Function__Surjective f)) -> (b : Elem Y) -> Elem X.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: Infimum of a set ;)
(; //LEAN:InfSet.sInf ;)
InfSet__sInf : (x : Elem (powerset X)) -> Elem X.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (x : Elem X) -> Elem X.

(; doc: We say that `a` is additively conjugate to `b` if for some additive unit `c` we have `c + a + -c = b`. ;)
(; //LEAN:IsAddConj ;)
IsAddConj : (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:IsAddConj.refl ;)
IsAddConj__refl : (X : Set) -> (_ : Proof (AddMonoid X)) -> (a : Elem X) -> Proof (IsAddConj a a).

(; doc: We say that `a` is conjugate to `b` if for some unit `c` we have `c * a * c⁻¹ = b`. ;)
(; //LEAN:IsConj ;)
IsConj : (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:IsConj.refl ;)
IsConj__refl : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> Proof (IsConj a a).

(; //LEAN:IsEmpty.forall_iff ;)
IsEmpty__forall_iff : (X : Set) -> (_ : Proof (IsEmpty X)) -> (p : (Elem X -> Prop)) -> Proof (iff (forall X (a => p a)) True).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Maximal P x` means that `x` is a maximal element satisfying `P`. ;)
(; //LEAN:Maximal ;)
Maximal : (P : (Elem X -> Prop)) -> (x1 : Elem X) -> Prop.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of monoid morphisms as a monoid morphism. ;)
(; //LEAN:MonoidHom.comp ;)
MonoidHom__comp : (hnp : Elem (MonoidHom N P)) -> (hmn : Elem (MonoidHom M N)) -> Elem (MonoidHom M P).

(; //LEAN:MonoidHom.ext ;)
MonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> (g : Elem (MonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (MonoidHom M N) f g).

(; doc: Given monoids `M`, `N`, the natural projection homomorphism from `M × N` to `M`. ;)
(; //LEAN:MonoidHom.fst ;)
MonoidHom__fst : (M : Set) -> (N : Set) -> Elem (MonoidHom (Prod M N) M).

(; doc: Given monoids `M`, `N`, the natural inclusion homomorphism from `M` to `M × N`. ;)
(; //LEAN:MonoidHom.inl ;)
MonoidHom__inl : (M : Set) -> (N : Set) -> Elem (MonoidHom M (Prod M N)).

(; doc: Given monoids `M`, `N`, the natural inclusion homomorphism from `N` to `M × N`. ;)
(; //LEAN:MonoidHom.inr ;)
MonoidHom__inr : (M : Set) -> (N : Set) -> Elem (MonoidHom N (Prod M N)).

(; doc: The multiplicative kernel of a monoid homomorphism is the subgroup of elements `x : G` such that `f x = 1` ;)
(; //LEAN:MonoidHom.ker ;)
MonoidHom__ker : (f : Elem (MonoidHom G M)) -> Elem (Subgroup G).

(; //LEAN:MonoidHom.liftOfRightInverse._proof_2 ;)
MonoidHom__liftOfRightInverse___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (g : Elem (Subtype (g1 => Leq (MonoidHom__ker f) (MonoidHom__ker g1)))) -> Proof (Leq (MonoidHom__ker f) (MonoidHom__ker g)).

(; //LEAN:MonoidHom.liftOfRightInverse._proof_3 ;)
MonoidHom__liftOfRightInverse___proof_3 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_inv f)) -> (g : Elem (Subtype (g3 => Leq (MonoidHom__ker f) (MonoidHom__ker g3)))) -> Proof (Eqt (Subtype (g1 => Leq (MonoidHom__ker f) (MonoidHom__ker g1))) ((x3 => MonoidHom__comp x3 f) ((g2 => MonoidHom__liftOfRightInverseAux f f_inv hf g2 (Subtype__property g2)) g)) g).

(; //LEAN:MonoidHom.liftOfRightInverse._proof_4 ;)
MonoidHom__liftOfRightInverse___proof_4 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_inv f)) -> (x3 : Elem (MonoidHom X1 X2)) -> Proof (Eqt (MonoidHom X1 X2) ((g => MonoidHom__liftOfRightInverseAux f f_inv hf g (Subtype__property g)) ((x4 => MonoidHom__comp x4 f) x3)) x3).

(; //LEAN:MonoidHom.liftOfRightInverseAux._proof_1 ;)
MonoidHom__liftOfRightInverseAux___proof_1 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_inv f)) -> (g : Elem (MonoidHom X X2)) -> (hg : Proof (Leq (MonoidHom__ker f) (MonoidHom__ker g))) -> (x3 : Elem X1) -> (y : Elem X1) -> Proof (Eqt X2 (g (f_inv (times x3 y))) (times (g (f_inv x3)) (g (f_inv y)))).

(; //LEAN:MonoidHom.liftOfRightInverseAux._proof_2 ;)
MonoidHom__liftOfRightInverseAux___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse f_inv f)) -> (g : Elem (MonoidHom X X2)) -> (hg : Proof (Leq (MonoidHom__ker f) (MonoidHom__ker g))) -> Proof (Membership__mem (MonoidHom__ker g) (f_inv 1)).

(; //LEAN:MonoidHom.liftOfSurjective._proof_1 ;)
MonoidHom__liftOfSurjective___proof_1 : (X : Set) -> (X1 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (f : Elem (MonoidHom X X1)) -> (hf : Proof (Function__Surjective f)) -> Proof (Function__RightInverse (Function__surjInv hf) f).

(; //LEAN:MonoidHom.mk ;)
MonoidHom__mk : (toOneHom : Elem (OneHom M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun toOneHom (times x2 y)) (times (OneHom__toFun toOneHom x2) (OneHom__toFun toOneHom y)))))) -> Elem (MonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `MonoidHomClass F M N` into an actual `MonoidHom`. This is declared as the default coercion from `F` to `M →* N`. ;)
(; //LEAN:MonoidHom.ofClass ;)
MonoidHom__ofClass : (f : Elem F) -> Elem (MonoidHom M N).

(; doc: `Prod.map` as a `MonoidHom`. ;)
(; //LEAN:MonoidHom.prodMap ;)
MonoidHom__prodMap : (f : Elem (MonoidHom M M')) -> (g : Elem (MonoidHom N N')) -> Elem (MonoidHom (Prod M N) (Prod M' N')).

(; doc: The range of a monoid homomorphism from a group is a subgroup. ;)
(; //LEAN:MonoidHom.range ;)
MonoidHom__range : (f : Elem (MonoidHom G N)) -> Elem (Subgroup N).

(; doc: Given monoids `M`, `N`, the natural projection homomorphism from `M × N` to `N`. ;)
(; //LEAN:MonoidHom.snd ;)
MonoidHom__snd : (M : Set) -> (N : Set) -> Elem (MonoidHom (Prod M N) N).

(; //LEAN:MonoidHom.toOneHom ;)
MonoidHom__toOneHom : (self : Elem (MonoidHom M N)) -> Elem (OneHom M N).

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (f : (Elem X -> Y)) -> Prop.

(; doc: Type class for monoid actions on types, with notation `g • p`.  The `MulAction G P` typeclass says that the monoid `G` acts multiplicatively on a type `P`. More precisely this means that the action satisfies the two axioms `1 • p = p` and `(g₁ * g₂) • p = g₁ • (g₂ • p)`. A mathematician might simply say that the monoid `G` acts on `P`.  For example, if `G` is a group and `X` is a type, if a mathematician says say "let `G` act on the set `X`" they will probably mean `[MulAction G X]`.  [Wikidata Q288465](https://www.wikidata.org/wiki/Q288465) ;)
(; //LEAN:MulAction ;)
MulAction : (X : Set) -> (Y : Set) -> Prop.

(; doc: The group of multiplicative automorphisms. ;)
(; //LEAN:MulAut ;)
MulAut : (M : Set) -> Set.

(; //LEAN:MulAut.characteristic._proof_17 ;)
MulAut__characteristic___proof_17 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic H)) -> Proof (Eqt (MulAut (Subtype (x1 => Membership__mem H x1))) (MulEquiv__mk (Equiv__mk (h1 => OfNat__ofNat__app 1 h1) (h2 => MulEquiv__symm__app 1 h2) (MulAut__characteristic___proof_12 H) (MulAut__characteristic___proof_14 H)) (MulAut__characteristic___proof_16 H)) (MulEquiv__mk (Equiv__mk (h3 => OfNat__ofNat__app 1 h3) (h4 => MulEquiv__symm__app 1 h4) (MulAut__characteristic___proof_12 H) (MulAut__characteristic___proof_14 H)) (MulAut__characteristic___proof_16 H))).

(; //LEAN:MulAut.characteristic._proof_26 ;)
MulAut__characteristic___proof_26 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic H)) -> (x1 : Elem (MulAut G)) -> (x2 : Elem (MulAut G)) -> Proof (Eqt (MulAut (Subtype (x3 => Membership__mem H x3))) (MulEquiv__mk (Equiv__mk (h1 => HMul__hMul__app x1 x2 h1) (h2 => MulEquiv__symm__app (times x1 x2) h2) (MulAut__characteristic___proof_21 H x1 x2) (MulAut__characteristic___proof_23 H x1 x2)) (MulAut__characteristic___proof_25 H x1 x2)) (MulEquiv__mk (Equiv__mk (h3 => HMul__hMul__app x1 x2 h3) (h4 => MulEquiv__symm__app (times x1 x2) h4) (MulAut__characteristic___proof_21 H x1 x2) (MulAut__characteristic___proof_23 H x1 x2)) (MulAut__characteristic___proof_25 H x1 x2))).

(; //LEAN:MulAut.characteristic._proof_4 ;)
MulAut__characteristic___proof_4 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic H)) -> (x1 : Elem (MulAut G)) -> (h1 : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (MulEquiv__symm__app x1 (x1 h1)) h1).

(; //LEAN:MulAut.characteristic._proof_6 ;)
MulAut__characteristic___proof_6 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic H)) -> (x1 : Elem (MulAut G)) -> (h1 : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (x1 (MulEquiv__symm__app x1 h1)) h1).

(; //LEAN:MulAut.characteristic._proof_8 ;)
MulAut__characteristic___proof_8 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Characteristic H)) -> (x1 : Elem (MulAut G)) -> (h1 : Elem (Subtype (x4 => Membership__mem H x4))) -> (k : Elem (Subtype (x3 => Membership__mem H x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem H x2)) (x1 (times h1 k)) (times (x1 h1) (x1 k))).

(; doc: `MulEquiv α β` is the type of an equiv `α ≃ β` which preserves multiplication. ;)
(; //LEAN:MulEquiv ;)
MulEquiv : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MulEquiv.mk ;)
MulEquiv__mk : (toEquiv : Elem (Equiv M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (Equiv__toFun toEquiv (times x2 y)) (times (Equiv__toFun toEquiv x2) (Equiv__toFun toEquiv y)))))) -> Elem (MulEquiv M N).

(; doc: A bijective `Semigroup` homomorphism is an isomorphism ;)
(; //LEAN:MulEquiv.ofBijective ;)
MulEquiv__ofBijective : (f : Elem F) -> (hf : Proof (Function__Bijective f)) -> Elem (MulEquiv M N).

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:MulEquiv.symm ;)
MulEquiv__symm : (h : Elem (MulEquiv M N)) -> Elem (MulEquiv N M).

(; doc: `e.symm` is a left inverse of `e`, written as `e.symm (e y) = y`. ;)
(; //LEAN:MulEquiv.symm_apply_apply ;)
MulEquiv__symm_apply_apply : (M : Set) -> (N : Set) -> (e : Elem (MulEquiv M N)) -> (x2 : Elem M) -> Proof (Eqt M (MulEquiv__symm__app e (e x2)) x2).

(; doc: Extract the forward direction of a multiplicative equivalence as a multiplication-preserving function. ;)
(; //LEAN:MulEquiv.toMonoidHom ;)
MulEquiv__toMonoidHom : (h : Elem (MulEquiv M N)) -> Elem (MonoidHom M N).

(; //LEAN:MulOne.toOne ;)
MulOne__toOne : Proof (One M).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; //LEAN:OneHom.mk ;)
OneHom__mk : (toFun : (Elem M -> N)) -> (map_one' : Proof (Eqt N (toFun 1) 1)) -> Elem (OneHom M N).

(; doc: By definition, if we have `OneMemClass S M`, we have `1 ∈ s` for all `s : S`. ;)
(; //LEAN:OneMemClass.one_mem ;)
OneMemClass__one_mem : (S : Set) -> (M : Elem (outParam Set)) -> (x : Proof (One M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (OneMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem s 1).

(; doc: Evaluation of functions into an indexed collection of additive monoids at a point is an additive monoid homomorphism. This is `Function.eval i` as an `AddMonoidHom`. ;)
(; //LEAN:Pi.evalAddMonoidHom ;)
Pi__evalAddMonoidHom : (f : (Elem I -> Set)) -> (i : Elem I) -> Elem (AddMonoidHom ((i1 : Elem I) -> f i1) (f i)).

(; doc: Evaluation of functions into an indexed collection of monoids at a point is a monoid homomorphism. This is `Function.eval i` as a `MonoidHom`. ;)
(; //LEAN:Pi.evalMonoidHom ;)
Pi__evalMonoidHom : (f : (Elem I -> Set)) -> (i : Elem I) -> Elem (MonoidHom ((i1 : Elem I) -> f i1) (f i)).

(; doc: The function supported at `i`, with value `x` there, and `1` elsewhere. ;)
(; //LEAN:Pi.mulSingle ;)
Pi__mulSingle : (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; doc: The function supported at `i`, with value `x` there, and `0` elsewhere. ;)
(; //LEAN:Pi.single ;)
Pi__single : (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; //LEAN:Prod.mk_eq_one._simp_2 ;)
Prod__mk_eq_one___simp_2 : (M : Set) -> (N : Set) -> (x2 : Elem M) -> (y : Elem N) -> Proof (Eqt Prop (Eqt (Prod M N) (Prod__mk x2 y) 1) (and (Eqt M x2 1) (Eqt N y 1))).

(; //LEAN:Prod.mk_eq_zero ;)
Prod__mk_eq_zero : (M : Set) -> (N : Set) -> (x2 : Elem M) -> (y : Elem N) -> Proof (iff (Eqt (Prod M N) (Prod__mk x2 y) 0) (and (Eqt M x2 0) (Eqt N y 0))).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; doc: The binary relations `R : α → β → Prop` and `S : γ → δ → Prop` induce a binary relation on functions `LiftFun : (α → γ) → (β → δ) → Prop`. ;)
(; //LEAN:Relator.LiftFun ;)
Relator__LiftFun : (R : (Elem X -> Elem Y -> Prop)) -> (S : (Elem Z -> Elem W -> Prop)) -> (f : (Elem X -> Z)) -> (g : (Elem Y -> W)) -> Prop.

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: A set `s` is `Set.Nontrivial` if it has at least two distinct elements. ;)
(; //LEAN:Set.Nontrivial ;)
Set__Nontrivial : (s : Elem (powerset X)) -> Prop.

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Subset.trans ;)
Set__Subset__trans : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (c : Elem (powerset X)) -> (ab : Proof (Set__Subset a b)) -> (bc : Proof (Set__Subset b c)) -> Proof (Set__Subset a c).

(; //LEAN:Set.biUnion_subset_biUnion_left ;)
Set__biUnion_subset_biUnion_left : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (s' : Elem (powerset X)) -> (t : (Elem X -> powerset Y)) -> (h : Proof (Set__Subset s s')) -> Proof (Set__Subset (Set__iUnion (x => Set__iUnion (h1 => t x))) (Set__iUnion (x1 => Set__iUnion (h2 => t x1)))).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; //LEAN:Set.iUnion₂_subset ;)
Set__iUnion_u2082__subset : (X : Set) -> (I : Set) -> (x : (Elem I -> Set)) -> (s : ((i2 : Elem I) -> Elem (x i2) -> powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (forall I (i1 => forall (x i1) (j1 => Set__Subset (s i1 j1) t)))) -> Proof (Set__Subset (Set__iUnion (i => Set__iUnion (j => s i j))) t).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.mem_empty_iff_false ;)
Set__mem_empty_iff_false : (X : Set) -> (x : Elem X) -> Proof (iff (Membership__mem EmptyCollection__emptyCollection x) false).

(; //LEAN:Set.mem_univ ;)
Set__mem_univ : (X : Set) -> (x : Elem X) -> Proof (Membership__mem Set__univ x).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Given an index set `ι` and a family of sets `t : Π i, Set (α i)`, `pi s t` is the set of dependent functions `f : Πa, π a` such that `f i` belongs to `t i` whenever `i ∈ s`. ;)
(; //LEAN:Set.pi ;)
Set__pi : (s : Elem (powerset I)) -> (t : ((i1 : Elem I) -> powerset (x i1))) -> Elem (powerset ((i : Elem I) -> x i)).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; //LEAN:Set.preimage_prod_map_prod ;)
Set__preimage_prod_map_prod : (X : Set) -> (Y : Set) -> (Z : Set) -> (W : Set) -> (f : (Elem X -> Y)) -> (g : (Elem Z -> W)) -> (s : Elem (powerset Y)) -> (t : Elem (powerset W)) -> Proof (Eqt (powerset (Prod X Z)) (Set__preimage (Prod__map f g) (SProd__sprod s t)) (SProd__sprod (Set__preimage f s) (Set__preimage g t))).

(; //LEAN:Set.prod_mono ;)
Set__prod_mono : (X : Set) -> (Y : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset Y)) -> (x3 : Elem (powerset Y)) -> (hs : Proof (Set__Subset x x1)) -> (ht : Proof (Set__Subset x2 x3)) -> Proof (Set__Subset (SProd__sprod x x2) (SProd__sprod x1 x3)).

(; //LEAN:Set.range_prodMap ;)
Set__range_prodMap : (X : Set) -> (Y : Set) -> (Z : Set) -> (W : Set) -> (x : (Elem X -> Z)) -> (x1 : (Elem Y -> W)) -> Proof (Eqt (powerset (Prod Z W)) (Set__range (Prod__map x x1)) (SProd__sprod (Set__range x) (Set__range x1))).

(; //LEAN:Set.singleton_eq_singleton_iff ;)
Set__singleton_eq_singleton_iff : (X : Set) -> (x : Elem X) -> (y : Elem X) -> Proof (iff (Eqt (powerset X) (Singleton__singleton x) (Singleton__singleton y)) (Eqt X x y)).

(; //LEAN:Set.singleton_eq_singleton_iff._simp_1 ;)
Set__singleton_eq_singleton_iff___simp_1 : (X : Set) -> (x : Elem X) -> (y : Elem X) -> Proof (Eqt Prop (Eqt (powerset X) (Singleton__singleton x) (Singleton__singleton y)) (Eqt X x y)).

(; //LEAN:Set.singleton_prod_singleton ;)
Set__singleton_prod_singleton : (X : Set) -> (Y : Set) -> (a : Elem X) -> (b : Elem Y) -> Proof (Eqt (powerset (Prod X Y)) (SProd__sprod (Singleton__singleton a) (Singleton__singleton b)) (Singleton__singleton (Prod__mk a b))).

(; //LEAN:Set.subset_pi_iff ;)
Set__subset_pi_iff : (I : Set) -> (x : (Elem I -> Set)) -> (s : Elem (powerset I)) -> (t : ((i2 : Elem I) -> powerset (x i2))) -> (s' : Elem (powerset ((i1 : Elem I) -> x i1))) -> Proof (iff (Set__Subset s' (Set__pi s t)) (forall I (i => if (Membership__mem s i) (Set__Subset s' (Set__preimage (x1 => x1 i) (t i)))))).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : Elem (powerset X).

(; //LEAN:Set.update_mem_pi_iff_of_mem ;)
Set__update_mem_pi_iff_of_mem : (I : Set) -> (x : (Elem I -> Set)) -> (s : Elem (powerset I)) -> (t : ((i2 : Elem I) -> powerset (x i2))) -> (a : ((i1 : Elem I) -> x i1)) -> (i : Elem I) -> (b : Elem (x i)) -> (ha : Proof (Membership__mem (Set__pi s t) a)) -> Proof (iff (Membership__mem (Set__pi s t) (Function__update a i b)) (if (Membership__mem s i) (Membership__mem (t i) b))).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set` is injective. ;)
(; //LEAN:SetLike.coe_injective ;)
SetLike__coe_injective : (A : Set) -> (B : Elem (outParam Set)) -> Proof (Function__Injective self).

(; doc: Note: implementers of `SetLike` must copy this lemma in order to tag it with `@[ext]`. ;)
(; //LEAN:SetLike.ext ;)
SetLike__ext : (A : Set) -> (B : Set) -> (p : Elem A) -> (q : Elem A) -> (h : Proof (forall B (x => iff (Membership__mem p x) (Membership__mem q x)))) -> Proof (Eqt A p q).

(; //LEAN:SetLike.ext'_iff ;)
SetLike__ext'_iff : (A : Set) -> (B : Set) -> (p : Elem A) -> (q : Elem A) -> Proof (iff (Eqt A p q) (Eqt (powerset B) p q)).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (H : Elem (Subgroup G)) -> Prop.

(; doc: `H` is closed under conjugation ;)
(; //LEAN:Subgroup.Normal.conj_mem ;)
Subgroup__Normal__conj_mem : (G : Set) -> (x : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal H)) -> (n : Elem G) -> (h : Proof (Membership__mem H n)) -> (g : Elem G) -> Proof (Membership__mem H (times (times g n) (Inv__inv g))).

(; //LEAN:Subgroup.Normal.mk ;)
Subgroup__Normal__mk : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (conj_mem : Proof (forall G (n => if (Membership__mem H n) (forall G (g => Membership__mem H (times (times g n) (Inv__inv g))))))) -> Proof (Subgroup__Normal H).

(; doc: The `Subgroup` generated by a set. ;)
(; //LEAN:Subgroup.closure ;)
Subgroup__closure : (k : Elem (powerset G)) -> Elem (Subgroup G).

(; doc: The preimage of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.comap ;)
Subgroup__comap : (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup N)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.comap_top ;)
Subgroup__comap_top : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (f : Elem (MonoidHom G N)) -> Proof (Eqt (Subgroup G) (Subgroup__comap f Top__top) Top__top).

(; doc: Two subgroups are equal if they have the same elements. ;)
(; //LEAN:Subgroup.ext ;)
Subgroup__ext : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> (h : Proof (forall G (x1 => iff (Membership__mem H x1) (Membership__mem K x1)))) -> Proof (Eqt (Subgroup G) H K).

(; //LEAN:Subgroup.instSetLike ;)
Subgroup__instSetLike : Proof (SetLike (Subgroup G) G).

(; //LEAN:Subgroup.le_normalizer ;)
Subgroup__le_normalizer : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Leq H (Subgroup__normalizer H)).

(; doc: The image of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.map ;)
Subgroup__map : (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup G)) -> Elem (Subgroup N).

(; //LEAN:Subgroup.mem_comap._simp_2 ;)
Subgroup__mem_comap___simp_2 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (K : Elem (Subgroup N)) -> (f : Elem (MonoidHom G N)) -> (x2 : Elem G) -> Proof (Eqt Prop (Membership__mem (Subgroup__comap f K) x2) (Membership__mem K (f x2))).

(; //LEAN:Subgroup.mk ;)
Subgroup__mk : (toSubmonoid : Elem (Submonoid G)) -> (inv_mem' : Proof (forall G (x1 => if (Membership__mem (Subsemigroup__carrier toSubmonoid) x1) (Membership__mem (Subsemigroup__carrier toSubmonoid) (Inv__inv x1))))) -> Elem (Subgroup G).

(; //LEAN:Subgroup.normalCore._proof_1 ;)
Subgroup__normalCore___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (a : Elem G) -> Proof (Membership__mem H (times (times a 1) (Inv__inv a))).

(; //LEAN:Subgroup.normalCore._proof_2 ;)
Subgroup__normalCore___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (x1 : Elem G) -> (x2 : Elem G) -> (ha : Proof (Membership__mem (Set__ofPred (a1 => forall G (b1 => Membership__mem H (times (times b1 a1) (Inv__inv b1))))) x1)) -> (hb : Proof (Membership__mem (Set__ofPred (a => forall G (b => Membership__mem H (times (times b a) (Inv__inv b))))) x2)) -> (c : Elem G) -> Proof (Membership__mem H (times (times c (times x1 x2)) (Inv__inv c))).

(; //LEAN:Subgroup.normalCore._proof_3 ;)
Subgroup__normalCore___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (x1 : Elem G) -> (h : Proof (Membership__mem (Set__ofPred (a => forall G (b1 => Membership__mem H (times (times b1 a) (Inv__inv b1))))) x1)) -> (b : Elem G) -> Proof (Membership__mem H (times (times b (Inv__inv x1)) (Inv__inv b))).

(; //LEAN:Subgroup.normalCore_normal ;)
Subgroup__normalCore_normal : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Subgroup__Normal (Subgroup__normalCore H)).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g * S * g⁻¹ = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:Subgroup.normalizer ;)
Subgroup__normalizer : (S : Elem (powerset G)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.pi._proof_1 ;)
Subgroup__pi___proof_1 : (X : Set) -> (f : (Elem X -> Set)) -> (_ : Proof ((i4 : Elem X) -> Group (f i4))) -> (I : Elem (powerset X)) -> (H : ((i3 : Elem X) -> Subgroup (f i3))) -> (x1 : ((i2 : Elem X) -> f i2)) -> (hp : Proof (Membership__mem (Subsemigroup__carrier (Submonoid__pi I (i1 => H i1))) x1)) -> (i : Elem X) -> (hI : Proof (Membership__mem I i)) -> Proof (Membership__mem (H i) (Inv__inv (x1 i))).

(; //LEAN:Subgroup.prod._proof_1 ;)
Subgroup__prod___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> (x2 : Elem (Prod G N)) -> (hx : Proof (Membership__mem (Subsemigroup__carrier (Submonoid__prod H K)) x2)) -> Proof (and (Membership__mem H (Prod__fst (Inv__inv x2))) (Membership__mem K (Prod__snd (Inv__inv x2)))).

(; //LEAN:Subgroup.prodEquiv._proof_1 ;)
Subgroup__prodEquiv___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> (x2 : Elem (Subtype (x7 => Membership__mem (Subgroup__prod H K) x7))) -> (x3 : Elem (Subtype (x6 => Membership__mem (Subgroup__prod H K) x6))) -> Proof (Eqt (Prod (Subtype (x4 => Membership__mem H x4)) (Subtype (x5 => Membership__mem K x5))) (Equiv__toFun (Equiv__Set__prod H K) (times x2 x3)) (Equiv__toFun (Equiv__Set__prod H K) (times x2 x3))).

(; //LEAN:Subgroup.range_subtype ;)
Subgroup__range_subtype : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Eqt (Subgroup G) (MonoidHom__range (Subgroup__subtype H)) H).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:Subgroup.subgroupOf ;)
Subgroup__subgroupOf : (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem (Subgroup (Subtype (x1 => Membership__mem K x1))).

(; doc: The subgroup generated by a set includes the set. ;)
(; //LEAN:Subgroup.subset_closure ;)
Subgroup__subset_closure : (G : Set) -> (_ : Proof (Group G)) -> (k : Elem (powerset G)) -> Proof (Set__Subset k (Subgroup__closure k)).

(; doc: The natural group hom from a subgroup of group `G` to `G`. ;)
(; //LEAN:Subgroup.subtype ;)
Subgroup__subtype : (H : Elem (Subgroup G)) -> Elem (MonoidHom (Subtype (x1 => Membership__mem H x1)) G).

(; //LEAN:Subgroup.subtype_injective ;)
Subgroup__subtype_injective : (G : Set) -> (_ : Proof (Group G)) -> (s : Elem (Subgroup G)) -> Proof (Function__Injective (Subgroup__subtype s)).

(; doc: A subgroup of a group inherits a group structure. ;)
(; //LEAN:Subgroup.toGroup ;)
Subgroup__toGroup : (H : Elem (Subgroup G)) -> Proof (Group (Subtype (x1 => Membership__mem H x1))).

(; doc: `SubgroupClass S G` states `S` is a type of subsets `s ⊆ G` that are subgroups of `G`. ;)
(; //LEAN:SubgroupClass ;)
SubgroupClass : (S : Set) -> (G : Elem (outParam Set)) -> Prop.

(; //LEAN:Submonoid.mk ;)
Submonoid__mk : (toSubsemigroup : Elem (Subsemigroup M)) -> (one_mem' : Proof (Membership__mem (Subsemigroup__carrier toSubsemigroup) 1)) -> Elem (Submonoid M).

(; doc: A version of `Set.pi` for `Submonoid`s. Given an index set `I` and a family of `Submonoid`s `s : Π i, Submonoid f i`, `pi I s` is the `Submonoid` of dependent functions `f : Π i, f i` such that `f i` belongs to `Pi I s` whenever `i ∈ I`. ;)
(; //LEAN:Submonoid.pi ;)
Submonoid__pi : (I1 : Elem (powerset I)) -> (S : ((i1 : Elem I) -> Submonoid (M i1))) -> Elem (Submonoid ((i : Elem I) -> M i)).

(; doc: Given `Submonoid`s `s`, `t` of `Monoid`s `M`, `N` respectively, `s × t` as a `Submonoid` of `M × N`. ;)
(; //LEAN:Submonoid.prod ;)
Submonoid__prod : (s : Elem (Submonoid M)) -> (t : Elem (Submonoid N)) -> Elem (Submonoid (Prod M N)).

(; doc: The carrier of a subsemigroup. ;)
(; //LEAN:Subsemigroup.carrier ;)
Subsemigroup__carrier : (self : Elem (Subsemigroup M)) -> Elem (powerset M).

(; //LEAN:Subsemigroup.mk ;)
Subsemigroup__mk : (carrier : Elem (powerset M)) -> (mul_mem' : Proof (forall M (a => forall M (b => if (Membership__mem carrier a) (if (Membership__mem carrier b) (Membership__mem carrier (times a b))))))) -> Elem (Subsemigroup M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; doc: The proof that `val` satisfies the predicate `p`. ;)
(; //LEAN:Subtype.property ;)
Subtype__property : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype (x => p x))) -> Proof (p self).

(; doc: Supremum of a set ;)
(; //LEAN:SupSet.sSup ;)
SupSet__sSup : (x : Elem (powerset X)) -> Elem X.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:ZeroHom.mk ;)
ZeroHom__mk : (toFun : (Elem M -> N)) -> (map_zero' : Proof (Eqt N (toFun 0) 0)) -> Elem (ZeroHom M N).

(; doc: The underlying function ;)
(; //LEAN:ZeroHom.toFun ;)
ZeroHom__toFun : (self : Elem (ZeroHom M N)) -> (x2 : Elem M) -> Elem N.

(; doc: By definition, if we have `ZeroMemClass S M`, we have `0 ∈ s` for all `s : S`. ;)
(; //LEAN:ZeroMemClass.zero_mem ;)
ZeroMemClass__zero_mem : (S : Set) -> (M : Elem (outParam Set)) -> (x : Proof (Zero M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (ZeroMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem s 0).

(; doc: Given an element `a`, `addConjugatesOf a` is the set of additive conjugates. ;)
(; //LEAN:addConjugatesOf ;)
addConjugatesOf : (a : Elem X) -> Elem (powerset X).

(; //LEAN:add_zero ;)
add_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus a 0) a).

(; //LEAN:and_congr ;)
and_congr : (a : Prop) -> (c : Prop) -> (b : Prop) -> (d : Prop) -> (h : Proof (iff a c)) -> (h1 : Proof (iff b d)) -> Proof (iff (and a b) (and c d)).

(; //LEAN:and_self ;)
and_self : (p : Prop) -> Proof (Eqt Prop (and p p) p).

(; //LEAN:and_true ;)
and_true : (p : Prop) -> Proof (Eqt Prop (and p True) p).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: Given an element `a`, `conjugatesOf a` is the set of conjugates. ;)
(; //LEAN:conjugatesOf ;)
conjugatesOf : (a : Elem X) -> Elem (powerset X).

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; //LEAN:eq_true ;)
eq_true : (p : Prop) -> (h : Proof p) -> Proof (Eqt Prop p True).

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; //LEAN:forall_const ;)
forall_const : (b : Prop) -> (X : Set) -> Proof (iff (forall X (x => b)) b).

(; //LEAN:funext_iff ;)
funext_iff : (X : Set) -> (x : (Elem X -> Set)) -> (f : ((x4 : Elem X) -> x x4)) -> (g : ((x3 : Elem X) -> x x3)) -> Proof (iff (Eqt ((x1 : Elem X) -> x x1) f g) (forall X (x2 => Eqt (x x2) (f x2) (g x2)))).

(; //LEAN:ge_of_eq ;)
ge_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; //LEAN:ge_trans ;)
ge_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq c b)) -> Proof (Leq c a).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (s : (Elem I -> X)) -> Elem X.

(; //LEAN:iInf_le_of_le ;)
iInf_le_of_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (i : Elem I) -> (h : Proof (Leq (f i) a)) -> Proof (Leq (iInf f) a).

(; doc: Indexed supremum ;)
(; //LEAN:iSup ;)
iSup : (s : (Elem I -> X)) -> Elem X.

(; //LEAN:iSup_le ;)
iSup_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (h : Proof (forall I (i => Leq (f i) a))) -> Proof (Leq (iSup f) a).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:iff_of_eq ;)
iff_of_eq : (a : Prop) -> (b : Prop) -> (h : Proof (Eqt Prop a b)) -> Proof (iff a b).

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:implies_congr ;)
implies_congr : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (h : Proof (Eqt Set X X1)) -> (h1 : Proof (Eqt Set X2 X3)) -> Proof (Eqt Set (Elem X -> X2) (Elem X1 -> X3)).

(; //LEAN:implies_congr_ctx ;)
implies_congr_ctx : (X : Prop) -> (X1 : Prop) -> (X2 : Prop) -> (X3 : Prop) -> (h : Proof (Eqt Prop X X1)) -> (h1 : Proof (if X1 (Eqt Prop X2 X3))) -> Proof (Eqt Prop (if X X2) (if X1 X3)).

(; //LEAN:implies_true ;)
implies_true : (X : Set) -> Proof (Eqt Prop (forall X (x => True)) True).

(; doc: `inferInstance` synthesizes a value of any target type by typeclass inference. This function has the same type signature as the identity function, but the square brackets on the `[i : α]` argument means that it will attempt to construct this argument by typeclass inference. (This will fail if `α` is not a `class`.) Example: ``` #check (inferInstance : Inhabited Nat) -- Inhabited Nat  def foo : Inhabited (Nat × Nat) :=   inferInstance  example : foo.default = (default, default) :=   rfl ``` ;)
(; //LEAN:inferInstance ;)
inferInstance : Elem X.

(; //LEAN:inv_one ;)
inv_one : (G : Set) -> (_ : Proof (InvOneClass G)) -> Proof (Eqt G (Inv__inv 1) 1).

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_iInf ;)
le_iInf : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (h : Proof (forall I (i => Leq a (f i)))) -> Proof (Leq a (iInf f)).

(; //LEAN:le_iSup_of_le ;)
le_iSup_of_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (i : Elem I) -> (h : Proof (Leq a (f i))) -> Proof (Leq a (iSup f)).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: The relation `≤` on a preorder is reflexive. ;)
(; //LEAN:le_refl ;)
le_refl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: Group homomorphisms preserve inverse.  See note [hom simp lemma priority] ;)
(; //LEAN:map_inv ;)
map_inv : (G : Set) -> (H : Set) -> (F : Set) -> (_ : Proof (Group G)) -> (_ : Proof (DivisionMonoid H)) -> (f : Elem F) -> (a : Elem G) -> Proof (Eqt H (f (Inv__inv a)) (Inv__inv (f a))).

(; doc: See note [hom simp lemma priority] ;)
(; //LEAN:map_mul ;)
map_mul : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (x3 : Elem M) -> (y : Elem M) -> Proof (Eqt N (f (times x3 y)) (times (f x3) (f y))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:neg_zero ;)
neg_zero : (G : Set) -> (_ : Proof (NegZeroClass G)) -> Proof (Eqt G (Neg__neg 0) 0).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_mul ;)
one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times 1 a) a).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

(; //LEAN:true_and ;)
true_and : (p : Prop) -> Proof (Eqt Prop (and True p) p).

(; //LEAN:zero_add ;)
zero_add : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus 0 a) a).

