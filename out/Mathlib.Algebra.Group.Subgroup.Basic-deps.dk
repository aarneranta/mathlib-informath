(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.mem_empty_iff_false ;)
Set__mem_empty_iff_false : (X : Set) -> (x : Elem X) -> Proof (iff (Membership__mem X (powerset X) (EmptyCollection__emptyCollection (powerset X)) x) false).

(; //LEAN:Set.mem_univ ;)
Set__mem_univ : (X : Set) -> (x : Elem X) -> Proof (Membership__mem X (powerset X) (Set__univ X) x).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Given an index set `ι` and a family of sets `t : Π i, Set (α i)`, `pi s t` is the set of dependent functions `f : Πa, π a` such that `f i` belongs to `t i` whenever `i ∈ s`. ;)
(; //LEAN:Set.pi ;)
Set__pi : (I : Set) -> (alpha : (Elem I -> Set)) -> (s : Elem (powerset I)) -> (t : ((i1 : Elem I) -> powerset (alpha i1))) -> Elem (powerset ((i : Elem I) -> alpha i)).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; //LEAN:Set.preimage_prod_map_prod ;)
Set__preimage_prod_map_prod : (X : Set) -> (Y : Set) -> (Z : Set) -> (W : Set) -> (f : (Elem X -> Y)) -> (g : (Elem Z -> W)) -> (s : Elem (powerset Y)) -> (t : Elem (powerset W)) -> Proof (Eqt (powerset (Prod X Z)) (Set__preimage (Prod X Z) (Prod Y W) (Prod__map X Y Z W f g) (SProd__sprod (powerset Y) (powerset W) (powerset (Prod Y W)) s t)) (SProd__sprod (powerset X) (powerset Z) (powerset (Prod X Z)) (Set__preimage X Y f s) (Set__preimage Z W g t))).

(; //LEAN:Set.prod_mono ;)
Set__prod_mono : (X : Set) -> (Y : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> (t1 : Elem (powerset Y)) -> (t2 : Elem (powerset Y)) -> (hs : Proof (Set__Subset X s1 s2)) -> (ht : Proof (Set__Subset Y t1 t2)) -> Proof (Set__Subset (Prod X Y) (SProd__sprod (powerset X) (powerset Y) (powerset (Prod X Y)) s1 t1) (SProd__sprod (powerset X) (powerset Y) (powerset (Prod X Y)) s2 t2)).

(; //LEAN:Set.range_prodMap ;)
Set__range_prodMap : (X : Set) -> (Y : Set) -> (Z : Set) -> (W : Set) -> (m1 : (Elem X -> Z)) -> (m2 : (Elem Y -> W)) -> Proof (Eqt (powerset (Prod Z W)) (Set__range (Prod Z W) (Prod X Y) (Prod__map X Z Y W m1 m2)) (SProd__sprod (powerset Z) (powerset W) (powerset (Prod Z W)) (Set__range Z X m1) (Set__range W Y m2))).

(; //LEAN:Set.singleton_eq_singleton_iff ;)
Set__singleton_eq_singleton_iff : (X : Set) -> (x : Elem X) -> (y : Elem X) -> Proof (iff (Eqt (powerset X) (Singleton__singleton X (powerset X) x) (Singleton__singleton X (powerset X) y)) (Eqt X x y)).

(; //LEAN:Set.singleton_eq_singleton_iff._simp_1 ;)
Set__singleton_eq_singleton_iff___simp_1 : (X : Set) -> (x : Elem X) -> (y : Elem X) -> Proof (Eqt Prop (Eqt (powerset X) (Singleton__singleton X (powerset X) x) (Singleton__singleton X (powerset X) y)) (Eqt X x y)).

(; //LEAN:Set.singleton_prod_singleton ;)
Set__singleton_prod_singleton : (X : Set) -> (Y : Set) -> (a : Elem X) -> (b : Elem Y) -> Proof (Eqt (powerset (Prod X Y)) (SProd__sprod (powerset X) (powerset Y) (powerset (Prod X Y)) (Singleton__singleton X (powerset X) a) (Singleton__singleton Y (powerset Y) b)) (Singleton__singleton (Prod X Y) (powerset (Prod X Y)) (Prod__mk X Y a b))).

(; //LEAN:Set.subset_pi_iff ;)
Set__subset_pi_iff : (I : Set) -> (alpha : (Elem I -> Set)) -> (s : Elem (powerset I)) -> (t : ((i5 : Elem I) -> powerset (alpha i5))) -> (s' : Elem (powerset ((i4 : Elem I) -> alpha i4))) -> Proof (iff (Set__Subset ((i : Elem I) -> alpha i) s' (Set__pi I alpha s t)) (forall I (i1 => if (Membership__mem I (powerset I) s i1) (Set__Subset ((i2 : Elem I) -> alpha i2) s' (Set__preimage ((i3 : Elem I) -> alpha i3) (alpha i1) (x => x i1) (t i1)))))).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : (X : Set) -> Elem (powerset X).

(; //LEAN:Set.update_mem_pi_iff_of_mem ;)
Set__update_mem_pi_iff_of_mem : (I : Set) -> (alpha : (Elem I -> Set)) -> (s : Elem (powerset I)) -> (t : ((i5 : Elem I) -> powerset (alpha i5))) -> (a : ((i4 : Elem I) -> alpha i4)) -> (i : Elem I) -> (b : Elem (alpha i)) -> (ha : Proof (Membership__mem ((i2 : Elem I) -> alpha i2) (powerset ((i3 : Elem I) -> alpha i3)) (Set__pi I alpha s t) a)) -> Proof (iff (Membership__mem ((a1 : Elem I) -> alpha a1) (powerset ((i1 : Elem I) -> alpha i1)) (Set__pi I alpha s t) (Function__update I alpha a i b)) (if (Membership__mem I (powerset I) s i) (Membership__mem (alpha i) (powerset (alpha i)) (t i) b))).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set`. ;)
(; //LEAN:SetLike.coe ;)
SetLike__coe : (A : Set) -> (B : Set) -> (x : Elem A) -> Elem (powerset B).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set` is injective. ;)
(; //LEAN:SetLike.coe_injective ;)
SetLike__coe_injective : (A : Set) -> (B : Set) -> Proof (Function__Injective A (powerset B) (SetLike__coe A B)).

(; doc: Note: implementers of `SetLike` must copy this lemma in order to tag it with `@[ext]`. ;)
(; //LEAN:SetLike.ext ;)
SetLike__ext : (A : Set) -> (B : Set) -> (p : Elem A) -> (q : Elem A) -> (h : Proof (forall B (x => iff (Membership__mem B A p x) (Membership__mem B A q x)))) -> Proof (Eqt A p q).

(; //LEAN:SetLike.ext'_iff ;)
SetLike__ext'_iff : (A : Set) -> (B : Set) -> (p : Elem A) -> (q : Elem A) -> Proof (iff (Eqt A p q) (Eqt (powerset B) (SetLike__coe A B p) (SetLike__coe A B q))).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (X : Set) -> (Y : Set) -> (x : Elem X) -> Elem Y.

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (G : Set) -> (H : Elem (Subgroup G)) -> Prop.

(; doc: `H` is closed under conjugation ;)
(; //LEAN:Subgroup.Normal.conj_mem ;)
Subgroup__Normal__conj_mem : (G : Set) -> (x : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal G H)) -> (n : Elem G) -> (h : Proof (Membership__mem G (Subgroup G) H n)) -> (g : Elem G) -> Proof (Membership__mem G (Subgroup G) H (times (times g n) (Inv__inv G g))).

(; //LEAN:Subgroup.Normal.mk ;)
Subgroup__Normal__mk : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (conj_mem : Proof (forall G (n => if (Membership__mem G (Subgroup G) H n) (forall G (g => Membership__mem G (Subgroup G) H (times (times g n) (Inv__inv G g))))))) -> Proof (Subgroup__Normal G H).

(; doc: The `Subgroup` generated by a set. ;)
(; //LEAN:Subgroup.closure ;)
Subgroup__closure : (G : Set) -> (k : Elem (powerset G)) -> Elem (Subgroup G).

(; doc: The preimage of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.comap ;)
Subgroup__comap : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup N)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.comap_top ;)
Subgroup__comap_top : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (f : Elem (MonoidHom G N)) -> Proof (Eqt (Subgroup G) (Subgroup__comap G N f (Top__top (Subgroup N))) (Top__top (Subgroup G))).

(; doc: Two subgroups are equal if they have the same elements. ;)
(; //LEAN:Subgroup.ext ;)
Subgroup__ext : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> (h : Proof (forall G (x1 => iff (Membership__mem G (Subgroup G) H x1) (Membership__mem G (Subgroup G) K x1)))) -> Proof (Eqt (Subgroup G) H K).

(; //LEAN:Subgroup.instSetLike ;)
Subgroup__instSetLike : (G : Set) -> Proof (SetLike (Subgroup G) G).

(; //LEAN:Subgroup.le_normalizer ;)
Subgroup__le_normalizer : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Leq H (Subgroup__normalizer G (SetLike__coe (Subgroup G) G H))).

(; doc: The image of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.map ;)
Subgroup__map : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup G)) -> Elem (Subgroup N).

(; //LEAN:Subgroup.mem_comap._simp_2 ;)
Subgroup__mem_comap___simp_2 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (K : Elem (Subgroup N)) -> (f : Elem (MonoidHom G N)) -> (x2 : Elem G) -> Proof (Eqt Prop (Membership__mem G (Subgroup G) (Subgroup__comap G N f K) x2) (Membership__mem N (Subgroup N) K (f x2))).

(; //LEAN:Subgroup.mk ;)
Subgroup__mk : (G : Set) -> (toSubmonoid : Elem (Submonoid G)) -> (inv_mem' : Proof (forall G (x1 => if (Membership__mem G (powerset G) (Subsemigroup__carrier G (Submonoid__toSubsemigroup G toSubmonoid)) x1) (Membership__mem G (powerset G) (Subsemigroup__carrier G (Submonoid__toSubsemigroup G toSubmonoid)) (Inv__inv G x1))))) -> Elem (Subgroup G).

(; //LEAN:Subgroup.normalCore._proof_1 ;)
Subgroup__normalCore___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (a : Elem G) -> Proof (Membership__mem G (Subgroup G) H (times (times a 1) (Inv__inv G a))).

(; //LEAN:Subgroup.normalCore._proof_2 ;)
Subgroup__normalCore___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (x1 : Elem G) -> (x2 : Elem G) -> (ha : Proof (Membership__mem G (powerset G) (Set__ofPred G (a1 => forall G (b1 => Membership__mem G (Subgroup G) H (times (times b1 a1) (Inv__inv G b1))))) x1)) -> (hb : Proof (Membership__mem G (powerset G) (Set__ofPred G (a => forall G (b => Membership__mem G (Subgroup G) H (times (times b a) (Inv__inv G b))))) x2)) -> (c : Elem G) -> Proof (Membership__mem G (Subgroup G) H (times (times c (times x1 x2)) (Inv__inv G c))).

(; //LEAN:Subgroup.normalCore._proof_3 ;)
Subgroup__normalCore___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (x1 : Elem G) -> (h : Proof (Membership__mem G (powerset G) (Set__ofPred G (a => forall G (b1 => Membership__mem G (Subgroup G) H (times (times b1 a) (Inv__inv G b1))))) x1)) -> (b : Elem G) -> Proof (Membership__mem G (Subgroup G) H (times (times b (Inv__inv G x1)) (Inv__inv G b))).

(; //LEAN:Subgroup.normalCore_normal ;)
Subgroup__normalCore_normal : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Subgroup__Normal G (Subgroup__normalCore G H)).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g * S * g⁻¹ = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:Subgroup.normalizer ;)
Subgroup__normalizer : (G : Set) -> (S : Elem (powerset G)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.pi._proof_1 ;)
Subgroup__pi___proof_1 : (X : Set) -> (f : (Elem X -> Set)) -> (_ : Proof ((i8 : Elem X) -> Group (f i8))) -> (I : Elem (powerset X)) -> (H : ((i7 : Elem X) -> Subgroup (f i7))) -> (x1 : ((i6 : Elem X) -> f i6)) -> (hp : Proof (Membership__mem ((i1 : Elem X) -> f i1) (powerset ((i2 : Elem X) -> f i2)) (Subsemigroup__carrier ((i3 : Elem X) -> f i3) (Submonoid__toSubsemigroup ((i4 : Elem X) -> f i4) (Submonoid__pi X f I (i5 => Subgroup__toSubmonoid (f i5) (H i5))))) x1)) -> (i : Elem X) -> (hI : Proof (Membership__mem X (powerset X) I i)) -> Proof (Membership__mem (f i) (Subgroup (f i)) (H i) (Inv__inv (f i) (x1 i))).

(; //LEAN:Subgroup.prod._proof_1 ;)
Subgroup__prod___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> (x2 : Elem (Prod G N)) -> (hx : Proof (Membership__mem (Prod G N) (powerset (Prod G N)) (Subsemigroup__carrier (Prod G N) (Submonoid__toSubsemigroup (Prod G N) (Submonoid__prod N G (Subgroup__toSubmonoid G H) (Subgroup__toSubmonoid N K)))) x2)) -> Proof (and (Membership__mem G (powerset G) (SetLike__coe (Submonoid G) G (Subgroup__toSubmonoid G H)) (Prod__fst G N (Inv__inv (Prod G N) x2))) (Membership__mem N (powerset N) (SetLike__coe (Submonoid N) N (Subgroup__toSubmonoid N K)) (Prod__snd G N (Inv__inv (Prod G N) x2)))).

(; //LEAN:Subgroup.prodEquiv._proof_1 ;)
Subgroup__prodEquiv___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Set) -> (_ : Proof (Group N)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> (x2 : Elem (Subtype (Prod G N) (x7 => Membership__mem (Prod G N) (Subgroup (Prod G N)) (Subgroup__prod G N H K) x7))) -> (x3 : Elem (Subtype (Prod G N) (x6 => Membership__mem (Prod G N) (Subgroup (Prod G N)) (Subgroup__prod G N H K) x6))) -> Proof (Eqt (Prod (Subtype G (x4 => Membership__mem G (Subgroup G) H x4)) (Subtype N (x5 => Membership__mem N (Subgroup N) K x5))) (Equiv__toFun (Set__Elem (Prod G N) (SProd__sprod (powerset G) (powerset N) (powerset (Prod G N)) (SetLike__coe (Subgroup G) G H) (SetLike__coe (Subgroup N) N K))) (Prod (Set__Elem G (SetLike__coe (Subgroup G) G H)) (Set__Elem N (SetLike__coe (Subgroup N) N K))) (Equiv__Set__prod G N (SetLike__coe (Subgroup G) G H) (SetLike__coe (Subgroup N) N K)) (times x2 x3)) (Equiv__toFun (Set__Elem (Prod G N) (SProd__sprod (powerset G) (powerset N) (powerset (Prod G N)) (SetLike__coe (Subgroup G) G H) (SetLike__coe (Subgroup N) N K))) (Prod (Set__Elem G (SetLike__coe (Subgroup G) G H)) (Set__Elem N (SetLike__coe (Subgroup N) N K))) (Equiv__Set__prod G N (SetLike__coe (Subgroup G) G H) (SetLike__coe (Subgroup N) N K)) (times x2 x3))).

(; //LEAN:Subgroup.range_subtype ;)
Subgroup__range_subtype : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Eqt (Subgroup G) (MonoidHom__range (Subtype G (x1 => Membership__mem G (Subgroup G) H x1)) G (Subgroup__subtype G H)) H).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:Subgroup.subgroupOf ;)
Subgroup__subgroupOf : (G : Set) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem (Subgroup (Subtype G (x1 => Membership__mem G (Subgroup G) K x1))).

(; doc: The subgroup generated by a set includes the set. ;)
(; //LEAN:Subgroup.subset_closure ;)
Subgroup__subset_closure : (G : Set) -> (_ : Proof (Group G)) -> (k : Elem (powerset G)) -> Proof (Set__Subset G k (SetLike__coe (Subgroup G) G (Subgroup__closure G k))).

(; doc: The natural group hom from a subgroup of group `G` to `G`. ;)
(; //LEAN:Subgroup.subtype ;)
Subgroup__subtype : (G : Set) -> (H : Elem (Subgroup G)) -> Elem (MonoidHom (Subtype G (x1 => Membership__mem G (Subgroup G) H x1)) G).

(; //LEAN:Subgroup.subtype_injective ;)
Subgroup__subtype_injective : (G : Set) -> (_ : Proof (Group G)) -> (s : Elem (Subgroup G)) -> Proof (Function__Injective (Subtype G (x1 => Membership__mem G (Subgroup G) s x1)) G (Subgroup__subtype G s)).

(; doc: Reinterpret a `Subgroup` as a `Submonoid`. ;)
(; //LEAN:Subgroup.toSubmonoid ;)
Subgroup__toSubmonoid : (G : Set) -> (self : Elem (Subgroup G)) -> Elem (Submonoid G).

(; doc: `SubgroupClass S G` states `S` is a type of subsets `s ⊆ G` that are subgroups of `G`. ;)
(; //LEAN:SubgroupClass ;)
SubgroupClass : (S : Set) -> (G : Set) -> Prop.

(; doc: A submonoid of a monoid `M` is a subset containing 1 and closed under multiplication. ;)
(; //LEAN:Submonoid ;)
Submonoid : (M : Set) -> Set.

(; //LEAN:Submonoid.mk ;)
Submonoid__mk : (M : Set) -> (toSubsemigroup : Elem (Subsemigroup M)) -> (one_mem' : Proof (Membership__mem M (powerset M) (Subsemigroup__carrier M toSubsemigroup) 1)) -> Elem (Submonoid M).

(; doc: A version of `Set.pi` for `Submonoid`s. Given an index set `I` and a family of `Submonoid`s `s : Π i, Submonoid f i`, `pi I s` is the `Submonoid` of dependent functions `f : Π i, f i` such that `f i` belongs to `Pi I s` whenever `i ∈ I`. ;)
(; //LEAN:Submonoid.pi ;)
Submonoid__pi : (I : Set) -> (M : (Elem I -> Set)) -> (I1 : Elem (powerset I)) -> (S : ((i1 : Elem I) -> Submonoid (M i1))) -> Elem (Submonoid ((i : Elem I) -> M i)).

(; doc: Given `Submonoid`s `s`, `t` of `Monoid`s `M`, `N` respectively, `s × t` as a `Submonoid` of `M × N`. ;)
(; //LEAN:Submonoid.prod ;)
Submonoid__prod : (N : Set) -> (M : Set) -> (s : Elem (Submonoid M)) -> (t : Elem (Submonoid N)) -> Elem (Submonoid (Prod M N)).

(; doc: A submonoid of a monoid `M` can be considered as a subsemigroup of that monoid. ;)
(; //LEAN:Submonoid.toSubsemigroup ;)
Submonoid__toSubsemigroup : (M : Set) -> (self : Elem (Submonoid M)) -> Elem (Subsemigroup M).

(; doc: The carrier of a subsemigroup. ;)
(; //LEAN:Subsemigroup.carrier ;)
Subsemigroup__carrier : (M : Set) -> (self : Elem (Subsemigroup M)) -> Elem (powerset M).

(; //LEAN:Subsemigroup.mk ;)
Subsemigroup__mk : (M : Set) -> (carrier : Elem (powerset M)) -> (mul_mem' : Proof (forall M (a => forall M (b => if (Membership__mem M (powerset M) carrier a) (if (Membership__mem M (powerset M) carrier b) (Membership__mem M (powerset M) carrier (times a b))))))) -> Elem (Subsemigroup M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.mk ;)
Subtype__mk : (X : Set) -> (p : (Elem X -> Prop)) -> (val : Elem X) -> (property : Proof (p val)) -> Elem (Subtype X (x => p x)).

(; doc: The proof that `val` satisfies the predicate `p`. ;)
(; //LEAN:Subtype.property ;)
Subtype__property : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Proof (p (Subtype__val X p self)).

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: Supremum of a set ;)
(; //LEAN:SupSet.sSup ;)
SupSet__sSup : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : (X : Set) -> Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:ZeroHom.mk ;)
ZeroHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_zero' : Proof (Eqt N (toFun 0) 0)) -> Elem (ZeroHom M N).

(; doc: The underlying function ;)
(; //LEAN:ZeroHom.toFun ;)
ZeroHom__toFun : (M : Set) -> (N : Set) -> (self : Elem (ZeroHom M N)) -> (x2 : Elem M) -> Elem N.

(; doc: By definition, if we have `ZeroMemClass S M`, we have `0 ∈ s` for all `s : S`. ;)
(; //LEAN:ZeroMemClass.zero_mem ;)
ZeroMemClass__zero_mem : (S : Set) -> (M : Set) -> (x : Proof (Zero M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (ZeroMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem M S s 0).

(; doc: Given an element `a`, `addConjugatesOf a` is the set of additive conjugates. ;)
(; //LEAN:addConjugatesOf ;)
addConjugatesOf : (X : Set) -> (a : Elem X) -> Elem (powerset X).

(; //LEAN:add_zero ;)
add_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus a 0) a).

(; //LEAN:and_congr ;)
and_congr : (a : Prop) -> (c : Prop) -> (b : Prop) -> (d : Prop) -> (h1 : Proof (iff a c)) -> (h2 : Proof (iff b d)) -> Proof (iff (and a b) (and c d)).

(; //LEAN:and_self ;)
and_self : (p : Prop) -> Proof (Eqt Prop (and p p) p).

(; //LEAN:and_true ;)
and_true : (p : Prop) -> Proof (Eqt Prop (and p True) p).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (f1 : (Elem X -> Y)) -> (f2 : (Elem X -> Y)) -> (a1 : Elem X) -> (a2 : Elem X) -> (h1 : Proof (Eqt (Elem X -> Y) f1 f2)) -> (h2 : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f1 a1) (f2 a2)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (a1 : Elem X) -> (a2 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f a1) (f a2)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: Given an element `a`, `conjugatesOf a` is the set of conjugates. ;)
(; //LEAN:conjugatesOf ;)
conjugatesOf : (X : Set) -> (a : Elem X) -> Elem (powerset X).

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; //LEAN:eq_true ;)
eq_true : (p : Prop) -> (h : Proof p) -> Proof (Eqt Prop p True).

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; //LEAN:forall_const ;)
forall_const : (b : Prop) -> (X : Set) -> Proof (iff (forall X (x => b)) b).

(; //LEAN:funext_iff ;)
funext_iff : (X : Set) -> (beta : (Elem X -> Set)) -> (f : ((x3 : Elem X) -> beta x3)) -> (g : ((x2 : Elem X) -> beta x2)) -> Proof (iff (Eqt ((x : Elem X) -> beta x) f g) (forall X (x1 => Eqt (beta x1) (f x1) (g x1)))).

(; //LEAN:ge_of_eq ;)
ge_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; //LEAN:ge_trans ;)
ge_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq c b)) -> Proof (Leq c a).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; //LEAN:iInf_le_of_le ;)
iInf_le_of_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (i : Elem I) -> (h : Proof (Leq (f i) a)) -> Proof (Leq (iInf X I f) a).

(; doc: Indexed supremum ;)
(; //LEAN:iSup ;)
iSup : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; //LEAN:iSup_le ;)
iSup_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (h : Proof (forall I (i => Leq (f i) a))) -> Proof (Leq (iSup X I f) a).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:iff_of_eq ;)
iff_of_eq : (a : Prop) -> (b : Prop) -> (h : Proof (Eqt Prop a b)) -> Proof (iff a b).

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:implies_congr ;)
implies_congr : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (h1 : Proof (Eqt Set X X1)) -> (h2 : Proof (Eqt Set X2 X3)) -> Proof (Eqt Set (Elem X -> X2) (Elem X1 -> X3)).

(; //LEAN:implies_congr_ctx ;)
implies_congr_ctx : (X : Prop) -> (X1 : Prop) -> (X2 : Prop) -> (X3 : Prop) -> (h1 : Proof (Eqt Prop X X1)) -> (h2 : Proof (if X1 (Eqt Prop X2 X3))) -> Proof (Eqt Prop (if X X2) (if X1 X3)).

(; //LEAN:implies_true ;)
implies_true : (X : Set) -> Proof (Eqt Prop (forall X (x => True)) True).

(; doc: `inferInstance` synthesizes a value of any target type by typeclass inference. This function has the same type signature as the identity function, but the square brackets on the `[i : α]` argument means that it will attempt to construct this argument by typeclass inference. (This will fail if `α` is not a `class`.) Example: ``` #check (inferInstance : Inhabited Nat) -- Inhabited Nat  def foo : Inhabited (Nat × Nat) :=   inferInstance  example : foo.default = (default, default) :=   rfl ``` ;)
(; //LEAN:inferInstance ;)
inferInstance : (X : Set) -> Elem X.

(; //LEAN:inv_one ;)
inv_one : (G : Set) -> (_ : Proof (InvOneClass G)) -> Proof (Eqt G (Inv__inv G 1) 1).

(; //LEAN:isAddConj_iff ;)
isAddConj_iff : (X : Set) -> (_ : Proof (AddGroup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (IsAddConj X a b) (exists X (c => Eqt X (plus (plus c a) (Neg__neg X c)) b))).

(; //LEAN:isConj_iff ;)
isConj_iff : (X : Set) -> (_ : Proof (Group X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (IsConj X a b) (exists X (c => Eqt X (times (times c a) (Inv__inv X c)) b))).

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_iInf ;)
le_iInf : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (h : Proof (forall I (i => Leq a (f i)))) -> Proof (Leq a (iInf X I f)).

(; //LEAN:le_iSup_of_le ;)
le_iSup_of_le : (X : Set) -> (I : Set) -> (_ : Proof (CompleteLattice X)) -> (f : (Elem I -> X)) -> (a : Elem X) -> (i : Elem I) -> (h : Proof (Leq a (f i))) -> Proof (Leq a (iSup X I f)).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: The relation `≤` on a preorder is reflexive. ;)
(; //LEAN:le_refl ;)
le_refl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; //LEAN:map_add ;)
map_add : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (x3 : Elem M) -> (y : Elem M) -> Proof (Eqt N (f (plus x3 y)) (plus (f x3) (f y))).

(; doc: Group homomorphisms preserve inverse.  See note [hom simp lemma priority] ;)
(; //LEAN:map_inv ;)
map_inv : (G : Set) -> (H : Set) -> (F : Set) -> (_ : Proof (Group G)) -> (_ : Proof (DivisionMonoid H)) -> (f : Elem F) -> (a : Elem G) -> Proof (Eqt H (f (Inv__inv G a)) (Inv__inv H (f a))).

(; doc: See note [hom simp lemma priority] ;)
(; //LEAN:map_mul ;)
map_mul : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (x3 : Elem M) -> (y : Elem M) -> Proof (Eqt N (f (times x3 y)) (times (f x3) (f y))).

(; doc: Additive group homomorphisms preserve negation. ;)
(; //LEAN:map_neg ;)
map_neg : (G : Set) -> (H : Set) -> (F : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (SubtractionMonoid H)) -> (f : Elem F) -> (a : Elem G) -> Proof (Eqt H (f (Neg__neg G a)) (Neg__neg H (f a))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:neg_zero ;)
neg_zero : (G : Set) -> (_ : Proof (NegZeroClass G)) -> Proof (Eqt G (Neg__neg G 0) 0).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_mul ;)
one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times 1 a) a).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

(; //LEAN:true_and ;)
true_and : (p : Prop) -> Proof (Eqt Prop (and True p) p).

(; //LEAN:zero_add ;)
zero_add : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus 0 a) a).

