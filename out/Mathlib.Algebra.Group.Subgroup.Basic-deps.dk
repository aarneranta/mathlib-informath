(; doc: `MulEquiv α β` is the type of an equiv `α ≃ β` which preserves multiplication. ;)
(; //LEAN:MulEquiv ;)
MulEquiv : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MulEquiv.mk ;)
MulEquiv__mk : (M : Set) -> (N : Set) -> (toEquiv : Elem (Equiv M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (Equiv__toFun M N toEquiv (times x2 y)) (times (Equiv__toFun M N toEquiv x2) (Equiv__toFun M N toEquiv y)))))) -> Elem (MulEquiv M N).

(; doc: A bijective `Semigroup` homomorphism is an isomorphism ;)
(; //LEAN:MulEquiv.ofBijective ;)
MulEquiv__ofBijective : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (hf : Proof (Function__Bijective M N f)) -> Elem (MulEquiv M N).

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:MulEquiv.symm ;)
MulEquiv__symm : (M : Set) -> (N : Set) -> (h : Elem (MulEquiv M N)) -> Elem (MulEquiv N M).

(; doc: `e.symm` is a left inverse of `e`, written as `e.symm (e y) = y`. ;)
(; //LEAN:MulEquiv.symm_apply_apply ;)
MulEquiv__symm_apply_apply : (M : Set) -> (N : Set) -> (e : Elem (MulEquiv M N)) -> (x2 : Elem M) -> Proof (Eqt M (MulEquiv__symm__app e (e x2)) x2).

(; doc: Extract the forward direction of a multiplicative equivalence as a multiplication-preserving function. ;)
(; //LEAN:MulEquiv.toMonoidHom ;)
MulEquiv__toMonoidHom : (M : Set) -> (N : Set) -> (h : Elem (MulEquiv M N)) -> Elem (MonoidHom M N).

(; //LEAN:MulOne.toOne ;)
MulOne__toOne : (M : Set) -> Proof (One M).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; //LEAN:OneHom.mk ;)
OneHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_one' : Proof (Eqt N (toFun 1) 1)) -> Elem (OneHom M N).

(; doc: By definition, if we have `OneMemClass S M`, we have `1 ∈ s` for all `s : S`. ;)
(; //LEAN:OneMemClass.one_mem ;)
OneMemClass__one_mem : (S : Set) -> (M : Set) -> (x : Proof (One M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (OneMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem M S s 1).

(; doc: Evaluation of functions into an indexed collection of additive monoids at a point is an additive monoid homomorphism. This is `Function.eval i` as an `AddMonoidHom`. ;)
(; //LEAN:Pi.evalAddMonoidHom ;)
Pi__evalAddMonoidHom : (I : Set) -> (f : (Elem I -> Set)) -> (i : Elem I) -> Elem (AddMonoidHom ((i1 : Elem I) -> f i1) (f i)).

(; doc: Evaluation of functions into an indexed collection of monoids at a point is a monoid homomorphism. This is `Function.eval i` as a `MonoidHom`. ;)
(; //LEAN:Pi.evalMonoidHom ;)
Pi__evalMonoidHom : (I : Set) -> (f : (Elem I -> Set)) -> (i : Elem I) -> Elem (MonoidHom ((i1 : Elem I) -> f i1) (f i)).

(; doc: The function supported at `i`, with value `x` there, and `1` elsewhere. ;)
(; //LEAN:Pi.mulSingle ;)
Pi__mulSingle : (I : Set) -> (M : (Elem I -> Set)) -> (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; doc: The function supported at `i`, with value `x` there, and `0` elsewhere. ;)
(; //LEAN:Pi.single ;)
Pi__single : (I : Set) -> (M : (Elem I -> Set)) -> (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; //LEAN:Prod.mk_eq_one._simp_2 ;)
Prod__mk_eq_one___simp_2 : (M : Set) -> (N : Set) -> (x2 : Elem M) -> (y : Elem N) -> Proof (Eqt Prop (Eqt (Prod M N) (Prod__mk M N x2 y) 1) (and (Eqt M x2 1) (Eqt N y 1))).

(; //LEAN:Prod.mk_eq_zero ;)
Prod__mk_eq_zero : (M : Set) -> (N : Set) -> (x2 : Elem M) -> (y : Elem N) -> Proof (iff (Eqt (Prod M N) (Prod__mk M N x2 y) 0) (and (Eqt M x2 0) (Eqt N y 0))).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: The binary relations `R : α → β → Prop` and `S : γ → δ → Prop` induce a binary relation on functions `LiftFun : (α → γ) → (β → δ) → Prop`. ;)
(; //LEAN:Relator.LiftFun ;)
Relator__LiftFun : (X : Set) -> (Y : Set) -> (Z : Set) -> (W : Set) -> (R : (Elem X -> Elem Y -> Prop)) -> (S : (Elem Z -> Elem W -> Prop)) -> (f : (Elem X -> Z)) -> (g : (Elem Y -> W)) -> Prop.

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: A set `s` is `Set.Nontrivial` if it has at least two distinct elements. ;)
(; //LEAN:Set.Nontrivial ;)
Set__Nontrivial : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (X : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Subset.trans ;)
Set__Subset__trans : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (c : Elem (powerset X)) -> (ab : Proof (Set__Subset X a b)) -> (bc : Proof (Set__Subset X b c)) -> Proof (Set__Subset X a c).

(; //LEAN:Set.biUnion_subset_biUnion_left ;)
Set__biUnion_subset_biUnion_left : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (s' : Elem (powerset X)) -> (t : (Elem X -> powerset Y)) -> (h : Proof (Set__Subset X s s')) -> Proof (Set__Subset Y (Set__iUnion Y X (x => Set__iUnion Y (Membership__mem X (powerset X) s x) (h1 => t x))) (Set__iUnion Y X (x1 => Set__iUnion Y (Membership__mem X (powerset X) s' x1) (h2 => t x1)))).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (X : Set) -> (I : Set) -> (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; //LEAN:Set.iUnion₂_subset ;)
