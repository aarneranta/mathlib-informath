(; //LEAN:MonoidHom.liftOfRightInverse._proof_5 ;)
MonoidHom__liftOfRightInverse___proof_5 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (phi : Elem (MonoidHom X1 X2)) -> (x3 : Elem X) -> (hx : Proof (Membership__mem X (Subgroup X) (MonoidHom__ker X X1 f) x3)) -> Proof (Membership__mem X (Subgroup X) (MonoidHom__ker X X2 (MonoidHom__comp X X1 X2 phi f)) x3).

(; //LEAN:MonoidHom.liftOfRightInverseAux._proof_1 ;)
MonoidHom__liftOfRightInverseAux___proof_1 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse X X1 f_inv f)) -> (g : Elem (MonoidHom X X2)) -> (hg : Proof (Leq (MonoidHom__ker X X1 f) (MonoidHom__ker X X2 g))) -> (x3 : Elem X1) -> (y : Elem X1) -> Proof (Eqt X2 (g (f_inv (times x3 y))) (times (g (f_inv x3)) (g (f_inv y)))).

(; //LEAN:MonoidHom.liftOfRightInverseAux._proof_2 ;)
MonoidHom__liftOfRightInverseAux___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (_ : Proof (Group X2)) -> (f : Elem (MonoidHom X X1)) -> (f_inv : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse X X1 f_inv f)) -> (g : Elem (MonoidHom X X2)) -> (hg : Proof (Leq (MonoidHom__ker X X1 f) (MonoidHom__ker X X2 g))) -> Proof (Membership__mem X (Subgroup X) (MonoidHom__ker X X2 g) (f_inv 1)).

(; //LEAN:MonoidHom.liftOfSurjective._proof_1 ;)
MonoidHom__liftOfSurjective___proof_1 : (X : Set) -> (X1 : Set) -> (_ : Proof (Group X)) -> (_ : Proof (Group X1)) -> (f : Elem (MonoidHom X X1)) -> (hf : Proof (Function__Surjective X X1 f)) -> Proof (Function__RightInverse X X1 (Function__surjInv X X1 f hf) f).

(; //LEAN:MonoidHom.mk ;)
MonoidHom__mk : (M : Set) -> (N : Set) -> (toOneHom : Elem (OneHom M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun M N toOneHom (times x2 y)) (times (OneHom__toFun M N toOneHom x2) (OneHom__toFun M N toOneHom y)))))) -> Elem (MonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `MonoidHomClass F M N` into an actual `MonoidHom`. This is declared as the default coercion from `F` to `M →* N`. ;)
(; //LEAN:MonoidHom.ofClass ;)
MonoidHom__ofClass : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> Elem (MonoidHom M N).

(; doc: `Prod.map` as a `MonoidHom`. ;)
(; //LEAN:MonoidHom.prodMap ;)
MonoidHom__prodMap : (M : Set) -> (N : Set) -> (M' : Set) -> (N' : Set) -> (f : Elem (MonoidHom M M')) -> (g : Elem (MonoidHom N N')) -> Elem (MonoidHom (Prod M N) (Prod M' N')).

(; doc: The range of a monoid homomorphism from a group is a subgroup. ;)
(; //LEAN:MonoidHom.range ;)
MonoidHom__range : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> Elem (Subgroup N).

(; doc: Given monoids `M`, `N`, the natural projection homomorphism from `M × N` to `N`. ;)
(; //LEAN:MonoidHom.snd ;)
MonoidHom__snd : (M : Set) -> (N : Set) -> Elem (MonoidHom (Prod M N) N).

(; //LEAN:MonoidHom.toOneHom ;)
MonoidHom__toOneHom : (M : Set) -> (N : Set) -> (self : Elem (MonoidHom M N)) -> Elem (OneHom M N).

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: Type class for monoid actions on types, with notation `g • p`.  The `MulAction G P` typeclass says that the monoid `G` acts multiplicatively on a type `P`. More precisely this means that the action satisfies the two axioms `1 • p = p` and `(g₁ * g₂) • p = g₁ • (g₂ • p)`. A mathematician might simply say that the monoid `G` acts on `P`.  For example, if `G` is a group and `X` is a type, if a mathematician says say "let `G` act on the set `X`" they will probably mean `[MulAction G X]`.  [Wikidata Q288465](https://www.wikidata.org/wiki/Q288465) ;)
(; //LEAN:MulAction ;)
MulAction : (X : Set) -> (Y : Set) -> Prop.

(; doc: The group of multiplicative automorphisms. ;)
(; //LEAN:MulAut ;)
MulAut : (M : Set) -> Set.

