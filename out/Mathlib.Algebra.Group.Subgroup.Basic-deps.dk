AddMonoidHom__liftOfRightInverseAux___proof_2 : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (AddGroup X1)) -> (_ : Proof (AddGroup X2)) -> (f : Elem (AddMonoidHom X X1)) -> (f_neg : (Elem X1 -> X)) -> (hf : Proof (Function__RightInverse X X1 f_neg f)) -> (g : Elem (AddMonoidHom X X2)) -> (hg : Proof (Leq (AddMonoidHom__ker X X1 f) (AddMonoidHom__ker X X2 g))) -> Proof (Membership__mem X (AddSubgroup X) (AddMonoidHom__ker X X2 g) (f_neg 0)).

