div_mem_comm_iff : (G : Set) -> (_ : Proof (Group G)) -> (S : Set) -> (H : Elem S) -> (_ : Proof (SubgroupClass S G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Membership__mem G S H (div a b)) (Membership__mem G S H (div b a))).

(; //LEAN:sub_mem_comm_iff ;)
sub_mem_comm_iff : (G : Set) -> (_ : Proof (AddGroup G)) -> (S : Set) -> (H : Elem S) -> (_ : Proof (AddSubgroupClass S G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Membership__mem G S H (minus a b)) (Membership__mem G S H (minus b a))).

