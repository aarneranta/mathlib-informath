  G => x => H => a => b => sub_mem_comm_iff G (AddSubgroup G) H a b.

(; //LEAN:Subgroup.div_mem_comm_iff ;)
def Subgroup__div_mem_comm_iff : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Membership__mem G (Subgroup G) H (div a b)) (Membership__mem G (Subgroup G) H (div b a))) :=
