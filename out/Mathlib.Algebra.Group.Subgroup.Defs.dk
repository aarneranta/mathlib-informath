(; //LEAN:Subgroup.le_normalizer ;)
def Subgroup__le_normalizer : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Leq H (Subgroup__normalizer H)) :=
  G => x => H => forallI G (x1 => if (Membership__mem H x1) (forall G (n2 => iff (Membership__mem H n2) (Membership__mem H (times (times x1 n2) (Inv__inv x1)))))) (x1 => ifI (Membership__mem H x1) (forall G (n1 => iff (Membership__mem H n1) (Membership__mem H (times (times x1 n1) (Inv__inv x1))))) (xH => forallI G (n => iff (Membership__mem H n) (Membership__mem H (times (times x1 n) (Inv__inv x1)))) (n => Eq__mpr (id (congrArg Prop Prop (Membership__mem H n) (Membership__mem H n) (_a => iff _a (Membership__mem H (times (times x1 n) (Inv__inv x1)))) (propext (SetLike__mem_coe (Subgroup G) G H n)))) (Eq__mpr (id (congrArg Prop Prop (Membership__mem H (times (times x1 n) (Inv__inv x1))) (Membership__mem H (times (times x1 n) (Inv__inv x1))) (_a1 => iff (Membership__mem H n) _a1) (propext (SetLike__mem_coe (Subgroup G) G H (times (times x1 n) (Inv__inv x1)))))) (Eq__mpr (id (congrArg Prop Prop (Membership__mem H (times (times x1 n) (Inv__inv x1))) (Membership__mem H (times x1 n)) (_a2 => iff (Membership__mem H n) _a2) (propext (Subgroup__mul_mem_cancel_right G H (Inv__inv x1) (times x1 n) (Subgroup__inv_mem G H x1 xH))))) (Eq__mpr (id (congrArg Prop Prop (Membership__mem H (times x1 n)) (Membership__mem H n) (_a3 => iff (Membership__mem H n) _a3) (propext (Subgroup__mul_mem_cancel_left G H x1 n xH)))) (Iff__rfl (Membership__mem H n)))))))).

(; //LEAN:Set.injOn_iff_map_eq_zero ;)
Set__injOn_iff_map_eq_zero : (F : Set) -> (G : Set) -> (H : Set) -> (S : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (AddGroup H)) -> (f : Elem F) -> (_ : Proof (ZeroMemClass S G)) -> (_ : Proof (AddMemClass S G)) -> (_ : Proof (NegMemClass S G)) -> (s : Elem S) -> Proof (iff (Set__InjOn f s) (forall G (a => if (Membership__mem s a) (if (Eqt H (f a) 0) (Eqt G a 0))))).

(; //LEAN:Set.injOn_iff_map_eq_one ;)
Set__injOn_iff_map_eq_one : (F : Set) -> (G : Set) -> (H : Set) -> (S : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Group H)) -> (f : Elem F) -> (_ : Proof (OneMemClass S G)) -> (_ : Proof (MulMemClass S G)) -> (_ : Proof (InvMemClass S G)) -> (s : Elem S) -> Proof (iff (Set__InjOn f s) (forall G (a => if (Membership__mem s a) (if (Eqt H (f a) 1) (Eqt G a 1))))).

