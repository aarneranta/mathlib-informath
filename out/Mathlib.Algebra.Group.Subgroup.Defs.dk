(; //LEAN:Set.injOn_iff_map_eq_zero ;)
Set__injOn_iff_map_eq_zero : (F : Set) -> (G : Set) -> (H : Set) -> (S : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (AddGroup H)) -> (f : Elem F) -> (_ : Proof (ZeroMemClass S G)) -> (_ : Proof (AddMemClass S G)) -> (_ : Proof (NegMemClass S G)) -> (s : Elem S) -> Proof (iff (Set__InjOn G H f (SetLike__coe S G s)) (forall G (a => if (Membership__mem G S s a) (if (Eqt H (f a) 0) (Eqt G a 0))))).

(; //LEAN:Set.injOn_iff_map_eq_one ;)
Set__injOn_iff_map_eq_one : (F : Set) -> (G : Set) -> (H : Set) -> (S : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Group H)) -> (f : Elem F) -> (_ : Proof (OneMemClass S G)) -> (_ : Proof (MulMemClass S G)) -> (_ : Proof (InvMemClass S G)) -> (s : Elem S) -> Proof (iff (Set__InjOn G H f (SetLike__coe S G s)) (forall G (a => if (Membership__mem G S s a) (if (Eqt H (f a) 1) (Eqt G a 1))))).

