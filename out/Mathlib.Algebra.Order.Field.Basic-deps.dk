(; constants used by Mathlib.Algebra.Order.Field.Basic, declared with their translated types ;)

(; doc: A function `f` is antitone if `a ≤ b` implies `f b ≤ f a`. ;)
(; //LEAN:Antitone ;)
Antitone : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Antitone.map_max ;)
Antitone__map_max : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (Antitone X Y f)) -> Proof (Eqt Y (f (Max__max X a b)) (Min__min Y (f a) (f b))).

(; //LEAN:Antitone.map_min ;)
Antitone__map_min : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (Antitone X Y f)) -> Proof (Eqt Y (f (Min__min X a b)) (Max__max Y (f a) (f b))).

(; doc: A function `f` is antitone on `s` if, for all `a, b ∈ s`, `a ≤ b` implies `f b ≤ f a`. ;)
(; //LEAN:AntitoneOn ;)
AntitoneOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A commutative ring is a ring with commutative multiplication. ;)
(; //LEAN:CommRing ;)
CommRing : (X : Set) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: **Alias** of `lt_of_eq_of_lt`. ;)
(; //LEAN:Eq.trans_lt ;)
Eq__trans_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: A `Field` is a `CommRing` with multiplicative inverses for nonzero elements.  An instance of `Field K` includes maps `ratCast : ℚ → K` and `qsmul : ℚ → K → K`. Those two fields are needed to implement the `DivisionRing K → Algebra ℚ K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ` itself). See also note [forgetful inheritance].  If the field has positive characteristic `p`, our division by zero convention forces `ratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:Field ;)
Field : (K : Set) -> Prop.

(; doc: A type `G₀` is a “group with zero” if it is a monoid with zero element (distinct from `1`) such that every nonzero element is invertible. The type is required to come with an “inverse” function, and the inverse of `0` must be `0`.  Examples include division rings and the ordered monoids that are the target of valuations in general valuation theory. ;)
(; //LEAN:GroupWithZero ;)
GroupWithZero : (X : Set) -> Prop.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: `a` is a greatest lower bound of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsGLB ;)
IsGLB : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> Prop.

(; doc: `a` is a least upper bound of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsLUB ;)
IsLUB : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> Prop.

(; doc: A strict ordered semiring is a nontrivial semiring with a partial order such that addition is strictly monotone and multiplication by a positive number is strictly monotone. ;)
(; //LEAN:IsStrictOrderedRing ;)
IsStrictOrderedRing : (R : Set) -> Prop.

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: **Alias** of `ne_of_gt`. ;)
(; //LEAN:LT.lt.ne' ;)
LT__lt__ne' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; doc: **Alias** of `lt_of_lt_of_eq`. ;)
(; //LEAN:LT.lt.trans_eq ;)
LT__lt__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Lt a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Lt a c).

(; doc: A linear order is reflexive, transitive, antisymmetric and total relation `≤`. We assume that every linear ordered type has decidable `(≤)`, `(<)`, and `(=)`. ;)
(; //LEAN:LinearOrder ;)
LinearOrder : (X : Set) -> Prop.

(; doc: An extension for `positivity`. ;)
(; //LEAN:Mathlib.Meta.Positivity.PositivityExt ;)
Mathlib__Meta__Positivity__PositivityExt : Set.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `α →*₀ β` is the type of functions `α → β` that preserve the `MonoidWithZero` structure.  `MonoidWithZeroHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : α →*₀ β)`, you should parametrize over `(F : Type*) [MonoidWithZeroHomClass F α β] (f : F)`.  When you extend this structure, make sure to extend `MonoidWithZeroHomClass`. ;)
(; //LEAN:MonoidWithZeroHom ;)
MonoidWithZeroHom : (X : Set) -> (Y : Set) -> Set.

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Monotone.comp ;)
Monotone__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (_ : Proof (Preorder Z)) -> (g : (Elem Y -> Z)) -> (f : (Elem X -> Y)) -> (hg : Proof (Monotone Y Z g)) -> (hf : Proof (Monotone X Y f)) -> Proof (Monotone X Z (Function__comp X Y Z g f)).

(; //LEAN:Monotone.map_max ;)
Monotone__map_max : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (Monotone X Y f)) -> Proof (Eqt Y (f (Max__max X a b)) (Max__max Y (f a) (f b))).

(; //LEAN:Monotone.map_min ;)
Monotone__map_min : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (Monotone X Y f)) -> Proof (Eqt Y (f (Min__min X a b)) (Min__min Y (f a) (f b))).

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; //LEAN:Nat.cast_zero ;)
Nat__cast_zero : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> Proof (Eqt R (Nat__cast R 0) 0).

(; //LEAN:Nat.one_le_cast_iff_ne_zero ;)
Nat__one_le_cast_iff_ne_zero : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (n : Elem Nat) -> Proof (iff (Leq 1 (Nat__cast X n)) (Neq n 0)).

(; //LEAN:Nat.one_lt_cast ;)
Nat__one_lt_cast : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (n : Elem Nat) -> Proof (iff (Lt 1 (Nat__cast X n)) (Lt 1 n)).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: Predicate typeclass for expressing that `a * b = 0` implies `a = 0` or `b = 0` for all `a` and `b` of type `M₀`. It is weaker than `IsCancelMulZero` in general, but equivalent to it if `M₀` is a (not necessarily unital or associative) ring. ;)
(; //LEAN:NoZeroDivisors ;)
NoZeroDivisors : (X : Set) -> Prop.

(; doc: A partial order is a reflexive, transitive, antisymmetric relation `≤`. ;)
(; //LEAN:PartialOrder ;)
PartialOrder : (X : Set) -> Prop.

(; doc: A preorder is a reflexive, transitive relation `≤`. In a preorder, `a < b` means `a ≤ b ∧ ¬b ≤ a`, and `<` is defined this way by default. You can override this definition to set a better def-eq. ;)
(; //LEAN:Preorder ;)
Preorder : (X : Set) -> Prop.

(; doc: A `Semifield` is a `CommSemiring` with multiplicative inverses for nonzero elements.  An instance of `Semifield K` includes maps `nnratCast : ℚ≥0 → K` and `nnqsmul : ℚ≥0 → K → K`. Those two fields are needed to implement the `DivisionSemiring K → Algebra ℚ≥0 K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ≥0` itself). See also note [forgetful inheritance].  If the semifield has positive characteristic `p`, our division by zero convention forces `nnratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:Semifield ;)
Semifield : (K : Set) -> Prop.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Iio b` is the left-infinite right-open interval $(-∞, b)$. ;)
(; //LEAN:Set.Iio ;)
Set__Iio : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ioi a` is the left-open right-infinite interval $(a, ∞)$. ;)
(; //LEAN:Set.Ioi ;)
Set__Ioi : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.mem_Ioi ;)
Set__mem_Ioi : (X : Set) -> (_ : Proof (Preorder X)) -> (b : Elem X) -> (x1 : Elem X) -> Proof (iff (Membership__mem X (powerset X) (Set__Ioi X b) x1) (Lt b x1)).

(; doc: A function `f` is strictly antitone if `a < b` implies `f b < f a`. ;)
(; //LEAN:StrictAnti ;)
StrictAnti : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f` is strictly antitone on `s` if, for all `a, b ∈ s`, `a < b` implies `f b < f a`. ;)
(; //LEAN:StrictAntiOn ;)
StrictAntiOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A function `f` is strictly monotone if `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMono ;)
StrictMono : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: `abs a`, denoted `|a|`, is the absolute value of `a` ;)
(; //LEAN:abs ;)
abs : (X : Set) -> (a : Elem X) -> Elem X.

(; doc: `abs` as a `MonoidWithZeroHom`. ;)
(; //LEAN:absHom ;)
absHom : (X : Set) -> Elem (MonoidWithZeroHom X X).

(; //LEAN:antitoneOn_iff_forall_lt ;)
antitoneOn_iff_forall_lt : (X : Set) -> (Y : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Proof (iff (AntitoneOn X Y f s) (forall X (a => if (Membership__mem X (powerset X) s a) (forall X (b => if (Membership__mem X (powerset X) s b) (if (Lt a b) (Leq (f b) (f a)))))))).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: "Dependent" if-then-else, normally written via the notation `if h : c then t(h) else e(h)`, is sugar for `dite c (fun h => t(h)) (fun h => e(h))`, and it is the same as `if c then t else e` except that `t` is allowed to depend on a proof `h : c`, and `e` can depend on `h : ¬c`. (Both branches use the same name for the hypothesis, even though it has different types in the two cases.)  We use this to be able to communicate the if-then-else condition to the branches. For example, `Array.get arr i h` expects a proof `h : i < arr.size` in order to avoid a bounds check, so you can write `if h : i < arr.size then arr.get i h else ...` to avoid the bounds check inside the if branch. (Of course in this case we have only lifted the check into an explicit `if`, but we could also use this proof multiple times or derive `i < arr.size` from some other proposition that we are checking in the `if`.)  Conventions for notations in identifiers:   * The recommended spelling of `if h : c then t else e` in identifiers is `dite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:dite ;)
dite : (X : Set) -> (c : Prop) -> (t : (Proof c -> X)) -> (e : (Proof (not c) -> X)) -> Elem X.

(; //LEAN:div_le_div_iff_of_pos_left ;)
div_le_div_iff_of_pos_left : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> (hc : Proof (Lt 0 c)) -> Proof (iff (Leq (div a b) (div a c)) (Leq c b)).

(; //LEAN:div_le_div_of_nonneg_right ;)
div_le_div_of_nonneg_right : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hc : Proof (Leq 0 c)) -> Proof (Leq (div a c) (div b c)).

(; //LEAN:div_lt_div_iff_of_pos_left ;)
div_lt_div_iff_of_pos_left : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> (hc : Proof (Lt 0 c)) -> Proof (iff (Lt (div a b) (div a c)) (Lt c b)).

(; //LEAN:div_lt_div_of_pos_right ;)
div_lt_div_of_pos_right : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Lt a b)) -> (hc : Proof (Lt 0 c)) -> Proof (Lt (div a c) (div b c)).

(; //LEAN:div_ne_zero ;)
div_ne_zero : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Neq a 0)) -> (hb : Proof (Neq b 0)) -> Proof (Neq (div a b) 0).

(; //LEAN:div_nonneg ;)
div_nonneg : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Leq 0 a)) -> (hb : Proof (Leq 0 b)) -> Proof (Leq 0 (div a b)).

(; //LEAN:div_pos ;)
div_pos : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (Lt 0 (div a b)).

(; //LEAN:div_zero ;)
div_zero : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (a : Elem X) -> Proof (Eqt X (div a 0) 0).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; doc: See `inv_anti₀` for the implication from right-to-left with one fewer assumption. ;)
(; //LEAN:inv_le_inv₀ ;)
inv_le_inv_u2080_ : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (iff (Leq (Inv__inv X a) (Inv__inv X b)) (Leq b a)).

(; doc: See `inv_strictAnti₀` for the implication from right-to-left with one fewer assumption. ;)
(; //LEAN:inv_lt_inv₀ ;)
inv_lt_inv_u2080_ : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (iff (Lt (Inv__inv X a) (Inv__inv X b)) (Lt b a)).

(; //LEAN:le_of_lt ;)
le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; //LEAN:map_div₀ ;)
map_div_u2080_ : (X : Set) -> (X1 : Set) -> (F : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (GroupWithZero X1)) -> (f : Elem F) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X1 (f (div a b)) (div (f a) (f b))).

(; doc: A monoid homomorphism between groups with zeros sending `0` to `0` sends `a⁻¹` to `(f a)⁻¹`. ;)
(; //LEAN:map_inv₀ ;)
map_inv_u2080_ : (X : Set) -> (X1 : Set) -> (F : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (GroupWithZero X1)) -> (f : Elem F) -> (a : Elem X) -> Proof (Eqt X1 (f (Inv__inv X a)) (Inv__inv X1 (f a))).

(; //LEAN:one_div ;)
one_div : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (a : Elem G) -> Proof (Eqt G (div 1 a) (Inv__inv G a)).

(; //LEAN:one_div_neg_one_eq_neg_one ;)
one_div_neg_one_eq_neg_one : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> Proof (Eqt R (div 1 (Neg__neg R 1)) (Neg__neg R 1)).

(; //LEAN:sub_le_sub ;)
sub_le_sub : (X : Set) -> (_ : Proof (AddCommGroup X)) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (hab : Proof (Leq a b)) -> (hcd : Proof (Leq c d)) -> Proof (Leq (minus a d) (minus b c)).

(; doc: For `a - -b = a + b`, see `sub_neg_eq_add`. ;)
(; //LEAN:sub_neg ;)
sub_neg : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt (minus a b) 0) (Lt a b)).

(; //LEAN:sub_pos ;)
sub_pos : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt 0 (minus a b)) (Lt b a)).

(; doc: **Alias** of the reverse direction of `sub_pos`. ;)
(; //LEAN:sub_pos_of_lt ;)
sub_pos_of_lt : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (h1 : Proof (Lt b a)) -> Proof (Lt 0 (minus a b)).

(; doc: See `zero_lt_one'` for a version with the type explicit. ;)
(; //LEAN:zero_lt_one ;)
zero_lt_one : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> Proof (Lt 0 1).

(; doc: See `zero_lt_two'` for a version with the type explicit. ;)
(; //LEAN:zero_lt_two ;)
zero_lt_two : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> Proof (Lt 0 2).

(; //LEAN:zpow_zero ;)
zpow_zero : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (a : Elem G) -> Proof (Eqt G (pow a 0) 1).

