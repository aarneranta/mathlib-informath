(; constants used by Mathlib.Algebra.Polynomial.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidAlgebra__coeff__app : (a1 : Elem (AddMonoidAlgebra R Nat)) -> (a2 : Elem Nat) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__comp__app : (a1 : Elem (AddMonoidHom (Polynomial R) M)) -> (a2 : Elem (AddMonoidHom R (Polynomial R))) -> (a3 : Elem R) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__symm__app : (a1 : Elem (LinearEquiv (RingHom__id R) (Polynomial R) (AddMonoidAlgebra R Nat))) -> (a2 : Elem (AddMonoidAlgebra R Nat)) -> Elem (Polynomial R).

(; a constant applied as a function: DFunLike.coe ;)
LinearMap__comp__app : (a1 : Elem (LinearMap (RingHom__id R) (Polynomial R) M)) -> (a2 : Elem (LinearMap (RingHom__id R) R (Polynomial R))) -> (a3 : Elem R) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__C__app : (a1 : Elem R) -> Elem (Polynomial R).

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__coeff__app : (a1 : Elem (Polynomial R)) -> (a2 : Elem Nat) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__monomial__app : (a1 : Elem Nat) -> (a2 : Elem R) -> Elem (Polynomial R).

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__ofMultiset__app : (a1 : Elem (Multiset R)) -> Elem (Polynomial R).

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__toFinsuppIsoLinear__app : (a1 : Set) -> (a2 : Elem (Polynomial R)) -> Elem (AddMonoidAlgebra R Nat).

(; a constant applied as a function: DFunLike.coe ;)
Polynomial__toFinsuppIso__app : (a1 : Set) -> (a2 : Elem (Polynomial R)) -> Elem (AddMonoidAlgebra R Nat).

(; a constant applied as a function: DFunLike.coe ;)
RingEquiv__symm__app : (a1 : Elem (RingEquiv (Polynomial R) (AddMonoidAlgebra R Nat))) -> (a2 : Elem (AddMonoidAlgebra R Nat)) -> Elem (Polynomial R).

(; doc: `AddChar A M` is the type of maps `A → M`, for `A` an additive monoid and `M` a multiplicative monoid, which intertwine addition in `A` with multiplication in `M`.  We only put the typeclasses needed for the definition, although in practice we are usually interested in much more specific cases (e.g. when `A` is a group and `M` a commutative ring). ;)
(; //LEAN:AddChar ;)
AddChar : (A : Set) -> (M : Set) -> Set.

(; //LEAN:AddChar.mk ;)
AddChar__mk : (toFun : (Elem A -> M)) -> (map_zero_eq_one' : Proof (Eqt M (toFun 0) 1)) -> (map_add_eq_mul' : Proof (forall A (a => forall A (b => Eqt M (toFun (plus a b)) (times (toFun a) (toFun b)))))) -> Elem (AddChar A M).

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; //LEAN:AddHom.mk ;)
AddHom__mk : (toFun : (Elem M -> N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (toFun (plus x2 y)) (plus (toFun x2) (toFun y)))))) -> Elem (AddHom M N).

(; doc: The underlying function ;)
(; //LEAN:AddHom.toFun ;)
AddHom__toFun : (self : Elem (AddHom M N)) -> (x2 : Elem M) -> Elem N.

(; doc: The additive monoid algebra over a semiring `R` generated by the additive monoid `M`.  It is the type of finite formal `R`-linear combinations of terms of `M`, endowed with the convolution product. ;)
(; //LEAN:AddMonoidAlgebra ;)
AddMonoidAlgebra : (R : Set) -> (M : Set) -> Set.

(; doc: The coefficients `M →₀ R` of an element of the additive monoid algebra `R[M]`. ;)
(; //LEAN:AddMonoidAlgebra.coeff ;)
AddMonoidAlgebra__coeff : (self : Elem (AddMonoidAlgebra R M)) -> Elem (Finsupp M R).

(; doc: `AddMonoidAlgebra.coeff` as an equiv. ;)
(; //LEAN:AddMonoidAlgebra.coeffEquiv ;)
AddMonoidAlgebra__coeffEquiv : Elem (Equiv (AddMonoidAlgebra R M) (Finsupp M R)).

(; doc: Remove a term from an element of the additive monoid algebra. ;)
(; //LEAN:AddMonoidAlgebra.erase ;)
AddMonoidAlgebra__erase : (m : Elem M) -> (x1 : Elem (AddMonoidAlgebra R M)) -> Elem (AddMonoidAlgebra R M).

(; //LEAN:AddMonoidAlgebra.erase_single ;)
AddMonoidAlgebra__erase_single : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (m : Elem M) -> (r : Elem R) -> Proof (Eqt (AddMonoidAlgebra R M) (AddMonoidAlgebra__erase m (AddMonoidAlgebra__single m r)) 0).

(; //LEAN:AddMonoidAlgebra.erase_zero ;)
AddMonoidAlgebra__erase_zero : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (m : Elem M) -> Proof (Eqt (AddMonoidAlgebra R M) (AddMonoidAlgebra__erase m 0) 0).

(; doc: `AddMonoidAlgebra.single m r` for `m : M`, `r : R` is the element `rm : R[M]`. ;)
(; //LEAN:AddMonoidAlgebra.single ;)
AddMonoidAlgebra__single : (m : Elem M) -> (r : Elem R) -> Elem (AddMonoidAlgebra R M).

(; //LEAN:AddMonoidAlgebra.single_mul_single ;)
AddMonoidAlgebra__single_mul_single : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (x2 : Elem M) -> (x3 : Elem M) -> (x4 : Elem R) -> (x5 : Elem R) -> Proof (Eqt (AddMonoidAlgebra R M) (times (AddMonoidAlgebra__single x2 x4) (AddMonoidAlgebra__single x3 x5)) (AddMonoidAlgebra__single (plus x2 x3) (times x4 x5))).

(; //LEAN:AddMonoidAlgebra.single_right_injective ;)
AddMonoidAlgebra__single_right_injective : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (m : Elem M) -> Proof (Function__Injective (AddMonoidAlgebra__single m)).

(; //LEAN:AddMonoidAlgebra.smul_single ;)
AddMonoidAlgebra__smul_single : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (A : Set) -> (_ : Proof (SMulZeroClass A R)) -> (a : Elem A) -> (m : Elem M) -> (r : Elem R) -> Proof (Eqt (AddMonoidAlgebra R M) (HSMul__hSMul a (AddMonoidAlgebra__single m r)) (AddMonoidAlgebra__single m (HSMul__hSMul a r))).

(; doc: Replace the `m`-th coefficient of an element `x` of the monoid algebra by a given value `r : R`. If `r = 0`, this is equal to `x.erase m`. ;)
(; //LEAN:AddMonoidAlgebra.update ;)
AddMonoidAlgebra__update : (m : Elem M) -> (r : Elem R) -> (x1 : Elem (AddMonoidAlgebra R M)) -> Elem (AddMonoidAlgebra R M).

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of additive monoid morphisms as an additive monoid morphism. ;)
(; //LEAN:AddMonoidHom.comp ;)
AddMonoidHom__comp : (hnp : Elem (AddMonoidHom N P)) -> (hmn : Elem (AddMonoidHom M N)) -> Elem (AddMonoidHom M P).

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; doc: The `AddSubmonoid` generated by a set ;)
(; //LEAN:AddSubmonoid.closure ;)
AddSubmonoid__closure : (s : Elem (powerset M)) -> Elem (AddSubmonoid M).

(; doc: Typeclass for expressing that a type `M` with addition and a zero satisfies `0 + a = a` and `a + 0 = a` for all `a : M`. ;)
(; //LEAN:AddZeroClass ;)
AddZeroClass : (M : Set) -> Prop.

(; doc: A commutative ring is a ring with commutative multiplication. ;)
(; //LEAN:CommRing ;)
CommRing : (X : Set) -> Prop.

(; doc: Two elements commute if `a * b = b * a`. ;)
(; //LEAN:Commute ;)
Commute : (a : Elem M) -> (b : Elem M) -> Prop.

(; //LEAN:DFunLike.congr_fun ;)
DFunLike__congr_fun : (F : Set) -> (X : Set) -> (x : (Elem X -> Set)) -> (f : Elem F) -> (g : Elem F) -> (h : Proof (Eqt F f g)) -> (x1 : Elem X) -> Proof (Eqt (x x1) (f x1) (g x1)).

(; doc: Typeclass for scalar multiplication that preserves `0` and `+` on the right.  This is exactly `DistribMulAction` without the `MulAction` part. ;)
(; //LEAN:DistribSMul ;)
DistribSMul : (M : Set) -> (A : Set) -> Prop.

(; doc: A `DivisionRing` is a `Ring` with multiplicative inverses for nonzero elements.  An instance of `DivisionRing K` includes maps `ratCast : ℚ → K` and `qsmul : ℚ → K → K`. Those two fields are needed to implement the `DivisionRing K → Algebra ℚ K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ` itself). See also note [forgetful inheritance]. Similarly, there are maps `nnratCast ℚ≥0 → K` and `nnqsmul : ℚ≥0 → K → K` to implement the `DivisionSemiring K → Algebra ℚ≥0 K` instance.  If the division ring has positive characteristic `p`, our division by zero convention forces `ratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:DivisionRing ;)
DivisionRing : (K : Set) -> Prop.

(; doc: A `DivisionSemiring` is a `Semiring` with multiplicative inverses for nonzero elements.  An instance of `DivisionSemiring K` includes maps `nnratCast : ℚ≥0 → K` and `nnqsmul : ℚ≥0 → K → K`. Those two fields are needed to implement the `DivisionSemiring K → Algebra ℚ≥0 K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ≥0` itself). See also note [forgetful inheritance].  If the division semiring has positive characteristic `p`, our division by zero convention forces `nnratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:DivisionSemiring ;)
DivisionSemiring : (K : Set) -> Prop.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : Elem X.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: The backward map of an equivalence.  Do NOT use `e.invFun` directly. Use the coercion of `e.symm` instead. ;)
(; //LEAN:Equiv.invFun ;)
Equiv__invFun : (self : Elem (Equiv X Y)) -> (x : Elem Y) -> Elem X.

(; //LEAN:Equiv.mk ;)
Equiv__mk : (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: The forward map of an equivalence.  Do NOT use directly. Use the coercion instead. ;)
(; //LEAN:Equiv.toFun ;)
Equiv__toFun : (self : Elem (Equiv X Y)) -> (x : Elem X) -> Elem Y.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: The property `s.Nonempty` expresses the fact that the finset `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Finset.Nonempty ;)
Finset__Nonempty : (s : Elem (Finset X)) -> Prop.

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (s : Elem (Finset X)) -> Elem Nat.

(; doc: `erase s a` is the set `s - {a}`, that is, the elements of `s` which are not equal to `a`. ;)
(; //LEAN:Finset.erase ;)
Finset__erase : (s : Elem (Finset X)) -> (a : Elem X) -> Elem (Finset X).

(; doc: `image f s` is the forward image of `s` under `f`. ;)
(; //LEAN:Finset.image ;)
Finset__image : (f : (Elem X -> Y)) -> (s : Elem (Finset X)) -> Elem (Finset Y).

(; //LEAN:Finset.mem_insert_of_mem ;)
Finset__mem_insert_of_mem : (X : Set) -> (s : Elem (Finset X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Membership__mem s a)) -> Proof (Membership__mem (Insert__insert b s) a).

(; //LEAN:Finset.mem_insert_self ;)
Finset__mem_insert_self : (X : Set) -> (a : Elem X) -> (s : Elem (Finset X)) -> Proof (Membership__mem (Insert__insert a s) a).

(; //LEAN:Finset.mem_singleton_self ;)
Finset__mem_singleton_self : (X : Set) -> (a : Elem X) -> Proof (Membership__mem (Singleton__singleton a) a).

(; //LEAN:Finset.nonempty_iff_ne_empty ;)
Finset__nonempty_iff_ne_empty : (X : Set) -> (s : Elem (Finset X)) -> Proof (iff (Finset__Nonempty s) (Neq s EmptyCollection__emptyCollection)).

(; //LEAN:Finset.singleton_subset_iff ;)
Finset__singleton_subset_iff : (X : Set) -> (s : Elem (Finset X)) -> (a : Elem X) -> Proof (iff (Set__Subset (Singleton__singleton a) s) (Membership__mem s a)).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; //LEAN:Finset.union_subset ;)
Finset__union_subset : (X : Set) -> (s : Elem (Finset X)) -> (t : Elem (Finset X)) -> (u : Elem (Finset X)) -> (hs : Proof (Set__Subset s u)) -> (h : Proof (Set__Subset t u)) -> Proof (Set__Subset (Union__union s t) u).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (X : Set) -> (M : Set) -> Set.

(; //LEAN:Finsupp.finite_range ;)
Finsupp__finite_range : (X : Set) -> (M : Set) -> (f : Elem (Finsupp X M)) -> Proof (Set__Finite (Set__range f)).

(; //LEAN:Finsupp.single_eq_of_ne ;)
Finsupp__single_eq_of_ne : (X : Set) -> (M : Set) -> (a : Elem X) -> (a' : Elem X) -> (b : Elem M) -> (h : Proof (Neq a' a)) -> Proof (Eqt M (Finsupp__single__app a b a') 0).

(; //LEAN:Finsupp.single_eq_same ;)
Finsupp__single_eq_same : (X : Set) -> (M : Set) -> (a : Elem X) -> (b : Elem M) -> Proof (Eqt M (Finsupp__single__app a b a) b).

(; //LEAN:Finsupp.smul_sum ;)
Finsupp__smul_sum : (X : Set) -> (Y : Set) -> (R : Set) -> (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (DistribSMul R M)) -> (v : Elem (Finsupp X Y)) -> (c : Elem R) -> (h : (Elem X -> Elem Y -> M)) -> Proof (Eqt M (HSMul__hSMul c (Finsupp__sum v h)) (Finsupp__sum v (a => b => HSMul__hSMul c (h a b)))).

(; //LEAN:Finsupp.sum_of_support_subset ;)
Finsupp__sum_of_support_subset : (X : Set) -> (M : Set) -> (N : Set) -> (_ : Proof (AddCommMonoid N)) -> (f : Elem (Finsupp X M)) -> (s : Elem (Finset X)) -> (hs : Proof (Set__Subset (Finsupp__support f) s)) -> (g : (Elem X -> Elem M -> N)) -> (h : Proof (forall X (i => if (Membership__mem s i) (Eqt N (g i 0) 0)))) -> Proof (Eqt N (Finsupp__sum f g) (Finset__sum s (x2 => g x2 (f x2)))).

(; //LEAN:Finsupp.sum_single_index ;)
Finsupp__sum_single_index : (X : Set) -> (M : Set) -> (N : Set) -> (_ : Proof (AddCommMonoid N)) -> (a : Elem X) -> (b : Elem M) -> (h : (Elem X -> Elem M -> N)) -> (h_zero : Proof (Eqt N (h a 0) 0)) -> Proof (Eqt N (Finsupp__sum (Finsupp__single a b) h) (h a b)).

(; //LEAN:Finsupp.sum_smul_index ;)
Finsupp__sum_smul_index : (X : Set) -> (M : Set) -> (R : Set) -> (_ : Proof (MulZeroClass R)) -> (_ : Proof (AddCommMonoid M)) -> (g : Elem (Finsupp X R)) -> (b : Elem R) -> (h : (Elem X -> Elem R -> M)) -> (h0 : Proof (forall X (i1 => Eqt M (h i1 0) 0))) -> Proof (Eqt M (Finsupp__sum (HSMul__hSMul b g) h) (Finsupp__sum g (i => a => h i (times b a)))).

(; //LEAN:Finsupp.sum_smul_index' ;)
Finsupp__sum_smul_index' : (X : Set) -> (M : Set) -> (N : Set) -> (R : Set) -> (_ : Proof (SMulZeroClass R M)) -> (_ : Proof (AddCommMonoid N)) -> (g : Elem (Finsupp X M)) -> (b : Elem R) -> (h : (Elem X -> Elem M -> N)) -> (h0 : Proof (forall X (i1 => Eqt N (h i1 0) 0))) -> Proof (Eqt N (Finsupp__sum (HSMul__hSMul b g) h) (Finsupp__sum g (i => c => h i (HSMul__hSMul b c)))).

(; doc: The support of a finitely supported function (aka `Finsupp`). ;)
(; //LEAN:Finsupp.support ;)
Finsupp__support : (self : Elem (Finsupp X M)) -> Elem (Finset X).

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Function.Injective.comp ;)
Function__Injective__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (g : (Elem Y -> Z)) -> (f : (Elem X -> Y)) -> (hg : Proof (Function__Injective g)) -> (hf : Proof (Function__Injective f)) -> Proof (Function__Injective (Function__comp g f)).

(; //LEAN:Function.Injective.eq_iff ;)
Function__Injective__eq_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (I : Proof (Function__Injective f)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt Y (f a) (f b)) (Eqt X a b)).

(; //LEAN:Function.Injective.eq_iff' ;)
Function__Injective__eq_iff' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (I : Proof (Function__Injective f)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> (h : Proof (Eqt Y (f b) c)) -> Proof (iff (Eqt Y (f a) c) (Eqt X a b)).

(; doc: Pull back a `NoZeroDivisors` instance along an injective function. ;)
(; //LEAN:Function.Injective.noZeroDivisors ;)
Function__Injective__noZeroDivisors : (X : Set) -> (X1 : Set) -> (f : (Elem X -> X1)) -> (hf : Proof (Function__Injective f)) -> (zero : Proof (Eqt X1 (f 0) 0)) -> (mul : Proof (forall X (x4 => forall X (y => Eqt X1 (f (times x4 y)) (times (f x4) (f y)))))) -> (_ : Proof (NoZeroDivisors X1)) -> Proof (NoZeroDivisors X).

(; doc: If the codomain of an injective function is a subsingleton, then the domain is a subsingleton as well. ;)
(; //LEAN:Function.Injective.subsingleton ;)
Function__Injective__subsingleton : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (_ : Proof (Subsingleton Y)) -> Proof (Subsingleton X).

(; doc: Replacing the value of a function at a given point by a given value. ;)
(; //LEAN:Function.update ;)
Function__update : (f : ((a1 : Elem X) -> x a1)) -> (a' : Elem X) -> (v : Elem (x a')) -> (a : Elem X) -> Elem (x a).

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: **Alias** of `not_congr`. ;)
(; //LEAN:Iff.not ;)
Iff__not : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff (not a) (not b)).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `insert x xs` inserts the element `x` into the collection `xs`. ;)
(; //LEAN:Insert.insert ;)
Insert__insert : (x1 : Elem x) -> (x2 : Elem Z) -> Elem Z.

(; doc: An `M`-regular element is an element `c` such that multiplication on the left by `c` is an injective map `M → M`. ;)
(; //LEAN:IsSMulRegular ;)
IsSMulRegular : (M : Set) -> (c : Elem R) -> Prop.

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: Although `TrailingParserDescr` is an abbreviation for `ParserDescr`, Lean will look at the declared type in order to determine whether to add the parser to the leading or trailing parser table. The determination is done automatically by the `syntax` command. ;)
(; //LEAN:Lean.TrailingParserDescr ;)
Lean__TrailingParserDescr : Set.

(; doc: A linear equivalence is an invertible linear map. ;)
(; //LEAN:LinearEquiv ;)
LinearEquiv : (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> Set.

(; //LEAN:LinearEquiv.mk ;)
LinearEquiv__mk : (toLinearMap : Elem (LinearMap x2 M X)) -> (invFun : (Elem X -> M)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun (AddHom__toFun (LinearMap__toAddHom toLinearMap))) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun (AddHom__toFun (LinearMap__toAddHom toLinearMap))) Equiv__right_inv___autoParam)) -> Elem (LinearEquiv x2 M X).

(; doc: A map `f` between an `R`-module and an `S`-module over a ring homomorphism `σ : R →+* S` is semilinear if it satisfies the two properties `f (x + y) = f x + f y` and `f (c • x) = (σ c) • f x`. Elements of `LinearMap σ M M₂` (available under the notation `M →ₛₗ[σ] M₂`) are bundled versions of such maps. For plain linear maps (i.e. for which `σ = RingHom.id R`), the notation `M →ₗ[R] M₂` is available. An unbundled version of plain linear maps is available with the predicate `IsLinearMap`, but it should be avoided most of the time. ;)
(; //LEAN:LinearMap ;)
LinearMap : (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> Set.

(; doc: Composition of two linear maps is a linear map ;)
(; //LEAN:LinearMap.comp ;)
LinearMap__comp : (f : Elem (LinearMap x10 X4 X5)) -> (g : Elem (LinearMap x9 X3 X4)) -> Elem (LinearMap x11 X3 X5).

(; doc: If two linear maps are equal, they are equal at each point. ;)
(; //LEAN:LinearMap.congr_fun ;)
LinearMap__congr_fun : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module S X)) -> (x6 : Elem (RingHom R S)) -> (f : Elem (LinearMap x6 M X)) -> (g : Elem (LinearMap x6 M X)) -> (h : Proof (Eqt (LinearMap x6 M X) f g)) -> (x7 : Elem M) -> Proof (Eqt X (f x7) (g x7)).

(; //LEAN:LinearMap.map_eq_zero_iff ;)
LinearMap__map_eq_zero_iff : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module S X)) -> (x6 : Elem (RingHom R S)) -> (f : Elem (LinearMap x6 M X)) -> (h : Proof (Function__Injective f)) -> (x7 : Elem M) -> Proof (iff (Eqt X (f x7) 0) (Eqt M x7 0)).

(; //LEAN:LinearMap.map_zero ;)
LinearMap__map_zero : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module S X)) -> (x6 : Elem (RingHom R S)) -> (f : Elem (LinearMap x6 M X)) -> Proof (Eqt X (f 0) 0).

(; //LEAN:LinearMap.mk ;)
LinearMap__mk : (toAddHom : Elem (AddHom M X)) -> (map_smul' : Proof (forall R (m => forall M (x7 => Eqt X (AddHom__toFun toAddHom (HSMul__hSMul m x7)) (HSMul__hSMul (x2 m) (AddHom__toFun toAddHom x7)))))) -> Elem (LinearMap x2 M X).

(; doc: The `AddHom` underlying a `LinearMap`. ;)
(; //LEAN:LinearMap.toAddHom ;)
LinearMap__toAddHom : (self : Elem (LinearMap x2 M X)) -> Elem (AddHom M X).

(; doc: Convert a linear map to an additive monoid hom. ;)
(; //LEAN:LinearMap.toAddMonoidHom ;)
LinearMap__toAddMonoidHom : (f : Elem (LinearMap x6 X X1)) -> Elem (AddMonoidHom X X1).

(; //LEAN:LinearMap.toAddMonoidHom_injective ;)
LinearMap__toAddMonoidHom_injective : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module S X)) -> (x6 : Elem (RingHom R S)) -> Proof (Function__Injective LinearMap__toAddMonoidHom).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: A module is a generalization of vector spaces to a scalar semiring. It consists of a scalar semiring `R` and an additive monoid of "vectors" `M`, connected by a "scalar multiplication" operation `r • x : M` (where `r : R` and `x : M`) with some natural associativity and distributivity axioms similar to those on a ring. ;)
(; //LEAN:Module ;)
Module : (R : Set) -> (M : Set) -> Prop.

(; //LEAN:MonoidHom.mk ;)
MonoidHom__mk : (toOneHom : Elem (OneHom M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun toOneHom (times x2 y)) (times (OneHom__toFun toOneHom x2) (OneHom__toFun toOneHom y)))))) -> Elem (MonoidHom M N).

(; doc: `Multiset α` is the quotient of `List α` by list permutation. The result is a type of finite sets with duplicates allowed. ;)
(; //LEAN:Multiset ;)
Multiset : (X : Set) -> Set.

(; doc: `map f s` is the lift of the list `map` operation. The multiplicity of `b` in `map f s` is the number of `a ∈ s` (counting multiplicity) such that `f a = b`. ;)
(; //LEAN:Multiset.map ;)
Multiset__map : (f : (Elem X -> Y)) -> (s : Elem (Multiset X)) -> Elem (Multiset Y).

(; doc: Product of a multiset given a commutative monoid structure on `M`. `prod {a, b, c} = a * b * c` ;)
(; //LEAN:Multiset.prod ;)
Multiset__prod : (x1 : Elem (Multiset M)) -> Elem M.

(; doc: Nonnegative rational numbers. ;)
(; //LEAN:NNRat ;)
NNRat : Set.

(; doc: Canonical homomorphism from `ℚ≥0` to a division semiring `K`.  This is just the bare function in order to aid in creating instances of `DivisionSemiring`. ;)
(; //LEAN:NNRat.cast ;)
NNRat__cast : (x1 : Elem NNRat) -> Elem K.

(; doc: A type class for natural numbers which are greater than or equal to `2`.  `NeZero` and `AtLeastTwo` are used for numeric literals, and also for groups of related lemmas sharing a common value of `n` that needs to be nonzero, or at least `2`, and where it is convenient to pass this information implicitly. Instances for these classes cover some of the cases where it is most structurally obvious from the syntactic form of `n` that it satisfies the required conditions, such as `m + 1`. Less widely used cases may be defined as lemmas rather than global instances and then made into instances locally where needed. If implicit arguments, appearing before other explicit arguments, are allowed to be `autoParam`s in a future version of Lean, such an `autoParam` that is proved `by lia` might be a more general replacement for the use of typeclass inference for this purpose. ;)
(; //LEAN:Nat.AtLeastTwo ;)
Nat__AtLeastTwo : (n : Elem Nat) -> Prop.

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; doc: Predicate typeclass for expressing that `a * b = 0` implies `a = 0` or `b = 0` for all `a` and `b` of type `M₀`. It is weaker than `IsCancelMulZero` in general, but equivalent to it if `M₀` is a (not necessarily unital or associative) ring. ;)
(; //LEAN:NoZeroDivisors ;)
NoZeroDivisors : (X : Set) -> Prop.

(; doc: Predicate typeclass for expressing that a type is not reduced to a single element. In rings, this is equivalent to `0 ≠ 1`. In vector spaces, this is equivalent to positive dimension. ;)
(; //LEAN:Nontrivial ;)
Nontrivial : (X : Set) -> Prop.

(; doc: The `OfNat.ofNat` function is automatically inserted by the parser when the user writes a numeric literal like `1 : α`. Implementations of this typeclass can therefore customize the behavior of `n : α` based on `n` and `α`. ;)
(; //LEAN:OfNat.ofNat ;)
OfNat__ofNat : (x : Elem Nat) -> Elem X.

(; //LEAN:OneHom.mk ;)
OneHom__mk : (toFun : (Elem M -> N)) -> (map_one' : Proof (Eqt N (toFun 1) 1)) -> Elem (OneHom M N).

(; //LEAN:Or.resolve_left ;)
Or__resolve_left : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (na : Proof (not a)) -> Proof b.

(; //LEAN:Polynomial.C._proof_1 ;)
Polynomial__C___proof_1 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Eqt (Polynomial R) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) 1) 1).

(; //LEAN:Polynomial.C._proof_2 ;)
Polynomial__C___proof_2 : (R : Set) -> (_ : Proof (Semiring R)) -> (x1 : Elem R) -> (y : Elem R) -> Proof (Eqt (Polynomial R) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) (times x1 y)) (times (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) x1) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) y))).

(; //LEAN:Polynomial.C._proof_3 ;)
Polynomial__C___proof_3 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Eqt (Polynomial R) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) 0) 0).

(; //LEAN:Polynomial.C._proof_4 ;)
Polynomial__C___proof_4 : (R : Set) -> (_ : Proof (Semiring R)) -> (x1 : Elem R) -> (y : Elem R) -> Proof (Eqt (Polynomial R) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) (plus x1 y)) (plus (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) x1) (AddHom__toFun (LinearMap__toAddHom (Polynomial__monomial 0)) y))).

(; //LEAN:Polynomial.monomial._proof_2 ;)
Polynomial__monomial___proof_2 : (R : Set) -> (_ : Proof (Semiring R)) -> (n : Elem Nat) -> (x1 : Elem R) -> (y : Elem R) -> Proof (Eqt (Polynomial R) (Polynomial__ofFinsupp (AddMonoidAlgebra__single n (plus x1 y))) (plus (Polynomial__ofFinsupp (AddMonoidAlgebra__single n x1)) (Polynomial__ofFinsupp (AddMonoidAlgebra__single n y)))).

(; //LEAN:Polynomial.monomial._proof_3 ;)
Polynomial__monomial___proof_3 : (R : Set) -> (_ : Proof (Semiring R)) -> (n : Elem Nat) -> (r : Elem R) -> (x1 : Elem R) -> Proof (Eqt (Polynomial R) (Polynomial__ofFinsupp (AddMonoidAlgebra__single n (HSMul__hSMul r x1))) (HSMul__hSMul (RingHom__id__app R r) (Polynomial__ofFinsupp (AddMonoidAlgebra__single n x1)))).

(; //LEAN:Polynomial.ofFinsupp.injEq ;)
Polynomial__ofFinsupp__injEq : (R : Set) -> (_ : Proof (Semiring R)) -> (toFinsupp : Elem (AddMonoidAlgebra R Nat)) -> (toFinsupp1 : Elem (AddMonoidAlgebra R Nat)) -> Proof (Eqt Prop (Eqt (Polynomial R) (Polynomial__ofFinsupp toFinsupp) (Polynomial__ofFinsupp toFinsupp1)) (Eqt (AddMonoidAlgebra R Nat) toFinsupp toFinsupp1)).

(; //LEAN:Polynomial.ofMultiset._proof_1 ;)
Polynomial__ofMultiset___proof_1 : (R : Set) -> (_ : Proof (CommRing R)) -> Proof (Eqt (Polynomial R) (Multiset__prod (Multiset__map (a => minus Polynomial__X (Polynomial__C__app a)) 0)) 1).

(; //LEAN:Polynomial.ofMultiset._proof_2 ;)
Polynomial__ofMultiset___proof_2 : (R : Set) -> (_ : Proof (CommRing R)) -> (a : Elem (Multiset R)) -> (b : Elem (Multiset R)) -> Proof (Eqt (Polynomial R) (Multiset__prod (Multiset__map (a1 => minus Polynomial__X (Polynomial__C__app a1)) (plus a b))) (times (Multiset__prod (Multiset__map (a2 => minus Polynomial__X (Polynomial__C__app a2)) a)) (Multiset__prod (Multiset__map (a3 => minus Polynomial__X (Polynomial__C__app a3)) b)))).

(; //LEAN:Polynomial.support.match_1 ;)
Polynomial__support__match_1 : (motive : (Elem (Polynomial R) -> Set)) -> (x1 : Elem (Polynomial R)) -> (h_1 : ((p : Elem (AddMonoidAlgebra R Nat)) -> motive (Polynomial__ofFinsupp p))) -> Elem (motive x1).

(; //LEAN:Polynomial.toFinsuppIso._proof_1 ;)
Polynomial__toFinsuppIso___proof_1 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Function__LeftInverse Polynomial__ofFinsupp Polynomial__toFinsupp).

(; //LEAN:Polynomial.toFinsuppIso._proof_2 ;)
Polynomial__toFinsuppIso___proof_2 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Function__RightInverse Polynomial__ofFinsupp Polynomial__toFinsupp).

(; //LEAN:Polynomial.toFinsuppIsoLinear._proof_1 ;)
Polynomial__toFinsuppIsoLinear___proof_1 : (R : Set) -> (_ : Proof (Semiring R)) -> (x1 : Elem (Polynomial R)) -> (y : Elem (Polynomial R)) -> Proof (Eqt (AddMonoidAlgebra R Nat) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)) (plus x1 y)) (plus (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)) x1) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)) y))).

(; //LEAN:Polynomial.toFinsuppIsoLinear._proof_2 ;)
Polynomial__toFinsuppIsoLinear___proof_2 : (R : Set) -> (_ : Proof (Semiring R)) -> (x1 : Elem R) -> (x2 : Elem (Polynomial R)) -> Proof (Eqt (AddMonoidAlgebra R Nat) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)) (HSMul__hSMul x1 x2)) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)) (HSMul__hSMul x1 x2))).

(; //LEAN:Polynomial.toFinsuppIsoLinear._proof_3 ;)
Polynomial__toFinsuppIsoLinear___proof_3 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Function__LeftInverse (Equiv__invFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R))) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)))).

(; //LEAN:Polynomial.toFinsuppIsoLinear._proof_4 ;)
Polynomial__toFinsuppIsoLinear___proof_4 : (R : Set) -> (_ : Proof (Semiring R)) -> Proof (Function__RightInverse (Equiv__invFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R))) (Equiv__toFun (RingEquiv__toEquiv (Polynomial__toFinsuppIso R)))).

(; doc: Canonical homomorphism from `Rat` to a division ring `K`. This is just the bare function in order to aid in creating instances of `DivisionRing`. ;)
(; //LEAN:Rat.cast ;)
Rat__cast : (x1 : Elem Rat) -> Elem K.

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: An equivalence between two (non-unital non-associative semi)rings that preserves the algebraic structure. ;)
(; //LEAN:RingEquiv ;)
RingEquiv : (R : Set) -> (S : Set) -> Set.

(; //LEAN:RingEquiv.injective ;)
RingEquiv__injective : (R : Set) -> (S : Set) -> (e : Elem (RingEquiv R S)) -> Proof (Function__Injective e).

(; //LEAN:RingEquiv.mk ;)
RingEquiv__mk : (toEquiv : Elem (Equiv R S)) -> (map_mul' : Proof (forall R (x5 => forall R (y1 => Eqt S (Equiv__toFun toEquiv (times x5 y1)) (times (Equiv__toFun toEquiv x5) (Equiv__toFun toEquiv y1)))))) -> (map_add' : Proof (forall R (x4 => forall R (y => Eqt S (Equiv__toFun toEquiv (plus x4 y)) (plus (Equiv__toFun toEquiv x4) (Equiv__toFun toEquiv y)))))) -> Elem (RingEquiv R S).

(; doc: The inverse of a ring isomorphism is a ring isomorphism. ;)
(; //LEAN:RingEquiv.symm ;)
RingEquiv__symm : (e : Elem (RingEquiv R S)) -> Elem (RingEquiv S R).

(; doc: The "plain" equivalence of types underlying an equivalence of (semi)rings. ;)
(; //LEAN:RingEquiv.toEquiv ;)
RingEquiv__toEquiv : (self : Elem (RingEquiv R S)) -> Elem (Equiv R S).

(; doc: Bundled semiring homomorphisms; use this for bundled ring homomorphisms too.  This extends from both `MonoidHom` and `MonoidWithZeroHom` in order to put the fields in a sensible order, even though `MonoidWithZeroHom` already extends `MonoidHom`. ;)
(; //LEAN:RingHom ;)
RingHom : (X : Set) -> (Y : Set) -> Set.

(; doc: The identity ring homomorphism from a semiring to itself. ;)
(; //LEAN:RingHom.id ;)
RingHom__id : (X : Set) -> Elem (RingHom X X).

(; doc: Ring homomorphisms preserve addition. ;)
(; //LEAN:RingHom.map_add ;)
RingHom__map_add : (X : Set) -> (Y : Set) -> (x : Proof (NonAssocSemiring X)) -> (x1 : Proof (NonAssocSemiring Y)) -> (f : Elem (RingHom X Y)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Y (f (plus a b)) (plus (f a) (f b))).

(; doc: Ring homomorphisms preserve multiplication. ;)
(; //LEAN:RingHom.map_mul ;)
RingHom__map_mul : (X : Set) -> (Y : Set) -> (x : Proof (NonAssocSemiring X)) -> (x1 : Proof (NonAssocSemiring Y)) -> (f : Elem (RingHom X Y)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Y (f (times a b)) (times (f a) (f b))).

(; //LEAN:RingHom.map_pow ;)
RingHom__map_pow : (X : Set) -> (Y : Set) -> (_ : Proof (Semiring X)) -> (_ : Proof (Semiring Y)) -> (f : Elem (RingHom X Y)) -> (a : Elem X) -> (n : Elem Nat) -> Proof (Eqt Y (f (pow a n)) (pow (f a) n)).

(; //LEAN:RingHom.mk ;)
RingHom__mk : (toMonoidHom : Elem (MonoidHom X Y)) -> (map_zero' : Proof (Eqt Y (OneHom__toFun (MonoidHom__toOneHom toMonoidHom) 0) 0)) -> (map_add' : Proof (forall X (x2 => forall X (y => Eqt Y (OneHom__toFun (MonoidHom__toOneHom toMonoidHom) (plus x2 y)) (plus (OneHom__toFun (MonoidHom__toOneHom toMonoidHom) x2) (OneHom__toFun (MonoidHom__toOneHom toMonoidHom) y)))))) -> Elem (RingHom X Y).

(; doc: Typeclass for scalar multiplication that preserves `0` on the right. ;)
(; //LEAN:SMulZeroClass ;)
SMulZeroClass : (M : Set) -> (A : Set) -> Prop.

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; //LEAN:Semiring.toNonAssocSemiring ;)
Semiring__toNonAssocSemiring : Proof (NonAssocSemiring X).

(; doc: A set is finite if the corresponding `Subtype` is finite, i.e., if there exists a natural `n : ℕ` and an equivalence `s ≃ Fin n`. ;)
(; //LEAN:Set.Finite ;)
Set__Finite : (s : Elem (powerset X)) -> Prop.

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (f : (Elem I -> X)) -> Elem (powerset X).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: **Alias** of `congrArg`. ;)
(; //LEAN:congr_arg ;)
congr_arg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:iff_of_eq ;)
iff_of_eq : (a : Prop) -> (b : Prop) -> (h : Proof (Eqt Prop a b)) -> Proof (iff a b).

(; doc: `inferInstance` synthesizes a value of any target type by typeclass inference. This function has the same type signature as the identity function, but the square brackets on the `[i : α]` argument means that it will attempt to construct this argument by typeclass inference. (This will fail if `α` is not a `class`.) Example: ``` #check (inferInstance : Inhabited Nat) -- Inhabited Nat  def foo : Inhabited (Nat × Nat) :=   inferInstance  example : foo.default = (default, default) :=   rfl ``` ;)
(; //LEAN:inferInstance ;)
inferInstance : Elem X.

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; //LEAN:map_natCast ;)
map_natCast : (R : Set) -> (S : Set) -> (F : Set) -> (_ : Proof (NonAssocSemiring R)) -> (_ : Proof (NonAssocSemiring S)) -> (f : Elem F) -> (n : Elem Nat) -> Proof (Eqt S (f n) n).

(; doc: Additive group homomorphisms preserve negation. ;)
(; //LEAN:map_neg ;)
map_neg : (G : Set) -> (H : Set) -> (F : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (SubtractionMonoid H)) -> (f : Elem F) -> (a : Elem G) -> Proof (Eqt H (f (Neg__neg a)) (Neg__neg (f a))).

(; doc: Additive group homomorphisms preserve subtraction. ;)
(; //LEAN:map_sub ;)
map_sub : (G : Set) -> (H : Set) -> (F : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (SubtractionMonoid H)) -> (f : Elem F) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt H (f (minus a b)) (minus (f a) (f b))).

(; //LEAN:map_sum ;)
map_sum : (I : Set) -> (M : Set) -> (N : Set) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid N)) -> (G : Set) -> (g : Elem G) -> (f : (Elem I -> M)) -> (s : Elem (Finset I)) -> Proof (Eqt N (g (Finset__sum s (x3 => f x3))) (Finset__sum s (x4 => g (f x4)))).

(; //LEAN:map_zero ;)
map_zero : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> Proof (Eqt N (f 0) 0).

(; //LEAN:mt ;)
mt : (a : Prop) -> (b : Prop) -> (h : Proof (if a b)) -> (h1 : Proof (not b)) -> Proof (not a).

(; //LEAN:not_false_eq_true ;)
not_false_eq_true : Proof (Eqt Prop (not false) True).

(; //LEAN:nsmul_eq_mul ;)
nsmul_eq_mul : (X : Set) -> (_ : Proof (NonAssocSemiring X)) -> (n : Elem Nat) -> (a : Elem X) -> Proof (Eqt X (HSMul__hSMul n a) (times n a)).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_ne_zero._simp_1 ;)
one_ne_zero___simp_1 : (X : Set) -> (_ : Proof (NeZero 1)) -> Proof (Eqt Prop (Eqt X 1 0) false).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: A type is either a subsingleton or nontrivial. ;)
(; //LEAN:subsingleton_or_nontrivial ;)
subsingleton_or_nontrivial : (X : Set) -> Proof (or (Subsingleton X) (Nontrivial X)).

