(; //LEAN:Prime ;)
def Prime : (M : Set) -> (p : Elem M) -> Prop :=
  M => p => and (Neq p 0) (and (not (IsUnit M p)) (forall M (a => forall M (b => if (divide p (times a b)) (or (divide p a) (divide p b)))))).

(; //LEAN:Prime.ne_zero ;)
def Prime__ne_zero : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (Neq p 0) :=
  M => x => p => hp => andEl (Neq p 0) (and (not (IsUnit M p)) (forall M (a => forall M (b => if (divide p (times a b)) (or (divide p a) (divide p b)))))) hp.

(; //LEAN:Prime.not_isUnit ;)
def Prime__not_isUnit : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (not (IsUnit M p)) :=
  M => x => p => hp => andEl (not (IsUnit M p)) (forall M (a => forall M (b => if (divide p (times a b)) (or (divide p a) (divide p b))))) (andEr (Neq p 0) (and (not (IsUnit M p)) (forall M (a1 => forall M (b1 => if (divide p (times a1 b1)) (or (divide p a1) (divide p b1)))))) hp).

(; //LEAN:Prime.not_dvd_one ;)
def Prime__not_dvd_one : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (not (divide p 1)) :=
  M => x => p => hp => mt (divide p 1) (IsUnit M p) (ifI (divide p 1) (IsUnit M p) (h => isUnit_of_dvd_one M p h)) (Prime__not_isUnit M p hp).

(; //LEAN:Prime.ne_one ;)
Prime__ne_one : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (Neq p 1).

(; //LEAN:Prime.dvd_or_dvd ;)
def Prime__dvd_or_dvd : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> (a : Elem M) -> (b : Elem M) -> (h : Proof (divide p (times a b))) -> Proof (or (divide p a) (divide p b)) :=
  M => x => p => hp => a => b => h => andEr (not (IsUnit M p)) (forall M (a1 => forall M (b1 => if (divide p (times a1 b1)) (or (divide p a1) (divide p b1))))) (andEr (Neq p 0) (and (not (IsUnit M p)) (forall M (a2 => forall M (b2 => if (divide p (times a2 b2)) (or (divide p a2) (divide p b2)))))) hp) a b h.

(; //LEAN:Prime.dvd_mul ;)
def Prime__dvd_mul : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (divide p (times a b)) (or (divide p a) (divide p b))) :=
  M => x => p => hp => a => b => iffI (divide p (times a b)) (or (divide p a) (divide p b)) (Prime__dvd_or_dvd M p hp a b) (h => orE (divide p a) (divide p b) (divide p (times a b)) h (h1 => dvd_mul_of_dvd_left M p a h1 b) (h2 => dvd_mul_of_dvd_right M p b h2 a)).

(; //LEAN:Prime.isPrimal ;)
def Prime__isPrimal : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (IsPrimal M p) :=
  M => x => p => hp => forallI M (_a => forall M (_b1 => if (divide p (times _a _b1)) (exists M (a15 => exists M (a27 => and (divide a15 _a) (and (divide a27 _b1) (Eqt M p (times a15 a27)))))))) (_a => forallI M (_b => if (divide p (times _a _b)) (exists M (a14 => exists M (a26 => and (divide a14 _a) (and (divide a26 _b) (Eqt M p (times a14 a26))))))) (_b => ifI (divide p (times _a _b)) (exists M (a13 => exists M (a25 => and (divide a13 _a) (and (divide a25 _b) (Eqt M p (times a13 a25)))))) (dvd => orE (divide p _a) (divide p _b) (exists M (a1 => exists M (a2 => and (divide a1 _a) (and (divide a2 _b) (Eqt M p (times a1 a2)))))) (Prime__dvd_or_dvd M p hp _a _b dvd) (h => existsI M (a11 => exists M (a21 => and (divide a11 _a) (and (divide a21 _b) (Eqt M p (times a11 a21))))) p (existsI M (a22 => and (divide p _a) (and (divide a22 _b) (Eqt M p (times p a22)))) 1 (andI (divide p _a) (and (divide 1 _b) (Eqt M p (times p 1))) h (andI (divide 1 _b) (Eqt M p (times p 1)) (one_dvd M _b) (Eq__symm M (times p 1) p (mul_one M p)))))) (h1 => existsI M (a12 => exists M (a23 => and (divide a12 _a) (and (divide a23 _b) (Eqt M p (times a12 a23))))) 1 (existsI M (a24 => and (divide 1 _a) (and (divide a24 _b) (Eqt M p (times 1 a24)))) p (andI (divide 1 _a) (and (divide p _b) (Eqt M p (times 1 p))) (one_dvd M _a) (andI (divide p _b) (Eqt M p (times 1 p)) h1 (Eq__symm M (times 1 p) p (one_mul M p))))))))).

(; //LEAN:Prime.not_dvd_mul ;)
def Prime__not_dvd_mul : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> (a : Elem M) -> (b : Elem M) -> (ha : Proof (not (divide p a))) -> (hb : Proof (not (divide p b))) -> Proof (not (divide p (times a b))) :=
  M => x => p => hp => a => b => ha => hb => iffEr (not (divide p (times a b))) (not (or (divide p a) (divide p b))) (Iff__not (divide p (times a b)) (or (divide p a) (divide p b)) (Prime__dvd_mul M p hp a b)) (iffEr (not (or (divide p a) (divide p b))) (and (not (divide p a)) (not (divide p b))) (not_or (divide p a) (divide p b)) (andI (not (divide p a)) (not (divide p b)) ha hb)).

(; //LEAN:Prime.dvd_of_dvd_pow ;)
Prime__dvd_of_dvd_pow : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> (a : Elem M) -> (n : Elem Nat) -> (h : Proof (divide p (pow a n))) -> Proof (divide p a).

(; //LEAN:Prime.dvd_pow_iff_dvd ;)
def Prime__dvd_pow_iff_dvd : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> (a : Elem M) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (iff (divide p (pow a n)) (divide p a)) :=
  M => x => p => hp => a => n => hn => iffI (divide p (pow a n)) (divide p a) (Prime__dvd_of_dvd_pow M p hp a n) (h => dvd_pow M p a h n hn).

(; //LEAN:not_prime_zero ;)
def not_prime_zero : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> Proof (not (Prime M 0)) :=
  M => x => ifI (Prime M 0) false (h => Prime__ne_zero M 0 h (rfl M 0)).

(; //LEAN:not_prime_one ;)
def not_prime_one : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> Proof (not (Prime M 1)) :=
  M => x => ifI (Prime M 1) false (h => Prime__not_isUnit M 1 h (isUnit_one M)).

(; //LEAN:Irreducible.not_dvd_isUnit ;)
def Irreducible__not_dvd_isUnit : (M : Set) -> (_ : Proof (CommMonoid M)) -> (p : Elem M) -> (u : Elem M) -> (hp : Proof (Irreducible M p)) -> (hu : Proof (IsUnit M u)) -> Proof (not (divide p u)) :=
  M => x => p => u => hp => hu => mt (divide p u) (IsUnit M p) (ifI (divide p u) (IsUnit M p) (h => isUnit_of_dvd_unit M p u h hu)) (Irreducible__not_isUnit M p hp).

(; //LEAN:Irreducible.not_dvd_one ;)
def Irreducible__not_dvd_one : (M : Set) -> (_ : Proof (CommMonoid M)) -> (p : Elem M) -> (hp : Proof (Irreducible M p)) -> Proof (not (divide p 1)) :=
  M => x => p => hp => Irreducible__not_dvd_isUnit M p 1 hp (isUnit_one M).

(; //LEAN:Irreducible.not_dvd_unit ;)
def Irreducible__not_dvd_unit : (M : Set) -> (_ : Proof (CommMonoid M)) -> (p : Elem M) -> (u : Elem (Units M)) -> (hp : Proof (Irreducible M p)) -> Proof (not (divide p (Units__val M u))) :=
  M => x => p => u => hp => Irreducible__not_dvd_isUnit M p (Units__val M u) hp (Units__isUnit M u).

(; //LEAN:Irreducible.isUnit_of_mul_self_dvd ;)
Irreducible__isUnit_of_mul_self_dvd : (M : Set) -> (_ : Proof (CommMonoid M)) -> (p : Elem M) -> (a : Elem M) -> (hp : Proof (Irreducible M p)) -> (ha : Proof (divide (times a a) p)) -> Proof (IsUnit M a).

(; //LEAN:not_irreducible_zero ;)
not_irreducible_zero : (M : Set) -> (_ : Proof (MonoidWithZero M)) -> Proof (not (Irreducible M 0)).

(; //LEAN:Irreducible.ne_zero ;)
Irreducible__ne_zero : (M : Set) -> (_ : Proof (MonoidWithZero M)) -> (p : Elem M) -> (h : Proof (Irreducible M p)) -> Proof (Neq p 0).

(; //LEAN:Irreducible.dvd_symm ;)
Irreducible__dvd_symm : (M : Set) -> (_ : Proof (Monoid M)) -> (p : Elem M) -> (q : Elem M) -> (hp : Proof (Irreducible M p)) -> (hq : Proof (Irreducible M q)) -> (h : Proof (divide p q)) -> Proof (divide q p).

(; //LEAN:Irreducible.dvd_comm ;)
def Irreducible__dvd_comm : (M : Set) -> (_ : Proof (Monoid M)) -> (p : Elem M) -> (q : Elem M) -> (hp : Proof (Irreducible M p)) -> (hq : Proof (Irreducible M q)) -> Proof (iff (divide p q) (divide q p)) :=
  M => x => p => q => hp => hq => iffI (divide p q) (divide q p) (Irreducible__dvd_symm M p q hp hq) (Irreducible__dvd_symm M q p hq hp).

(; //LEAN:Irreducible.prime_of_isPrimal ;)
def Irreducible__prime_of_isPrimal : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (a : Elem M) -> (irr : Proof (Irreducible M a)) -> (primal : Proof (IsPrimal M a)) -> Proof (Prime M a) :=
  M => x => a => irr => primal => andI (Neq a 0) (and (not (IsUnit M a)) (forall M (a1 => forall M (b => if (divide a (times a1 b)) (or (divide a a1) (divide a b)))))) (Irreducible__ne_zero M a irr) (andI (not (IsUnit M a)) (forall M (a2 => forall M (b1 => if (divide a (times a2 b1)) (or (divide a a2) (divide a b1))))) (Irreducible__not_isUnit M a irr) (a3 => forallI M (b2 => if (divide a (times a3 b2)) (or (divide a a3) (divide a b2))) (b2 => ifI (divide a (times a3 b2)) (or (divide a a3) (divide a b2)) (dvd => existsE M (a11 => exists M (a21 => and (divide a11 a3) (and (divide a21 b2) (Eqt M a (times a11 a21))))) (or (divide a a3) (divide a b2)) (ifE (divide a (times a3 b2)) (exists M (a14 => exists M (a24 => and (divide a14 a3) (and (divide a24 b2) (Eqt M a (times a14 a24)))))) (forallE M (c1 => if (divide a (times a3 c1)) (exists M (a13 => exists M (a23 => and (divide a13 a3) (and (divide a23 c1) (Eqt M a (times a13 a23))))))) (forallE M (b3 => forall M (c => if (divide a (times b3 c)) (exists M (a12 => exists M (a22 => and (divide a12 b3) (and (divide a22 c) (Eqt M a (times a12 a22)))))))) primal a3) b2) dvd) (d1 => h4 => existsE M (a25 => and (divide d1 a3) (and (divide a25 b2) (Eqt M a (times d1 a25)))) (or (divide a a3) (divide a b2)) h4 (d2 => h5 => Eq__ndrec M (times d1 d2) (a4 => if (Irreducible M a4) (if (IsPrimal M a4) (if (divide a4 (times a3 b2)) (or (divide a4 a3) (divide a4 b2))))) (ifI (Irreducible M (times d1 d2)) (if (IsPrimal M (times d1 d2)) (if (divide (times d1 d2) (times a3 b2)) (or (divide (times d1 d2) a3) (divide (times d1 d2) b2)))) (irr2 => ifI (IsPrimal M (times d1 d2)) (if (divide (times d1 d2) (times a3 b2)) (or (divide (times d1 d2) a3) (divide (times d1 d2) b2))) (primal2 => ifI (divide (times d1 d2) (times a3 b2)) (or (divide (times d1 d2) a3) (divide (times d1 d2) b2)) (dvd2 => Or__imp (IsUnit M d2) (divide (times d1 d2) a3) (IsUnit M d1) (divide (times d1 d2) b2) (ifI (IsUnit M d2) (divide (times d1 d2) a3) (h6 => iffEr (divide (times d1 d2) a3) (divide d1 a3) (IsUnit__mul_right_dvd M d1 a3 d2 h6) (andEl (divide d1 a3) (and (divide d2 b2) (Eqt M a (times d1 d2))) h5))) (ifI (IsUnit M d1) (divide (times d1 d2) b2) (h7 => iffEr (divide (times d1 d2) b2) (divide d2 b2) (IsUnit__mul_left_dvd M d2 b2 d1 h7) (andEl (divide d2 b2) (Eqt M a (times d1 d2)) (andEr (divide d1 a3) (and (divide d2 b2) (Eqt M a (times d1 d2))) h5)))) (Or__symm (IsUnit M d1) (IsUnit M d2) (of_irreducible_mul M d1 d2 irr2)))))) a (Eq__symm M a (times d1 d2) (andEr (divide d2 b2) (Eqt M a (times d1 d2)) (andEr (divide d1 a3) (and (divide d2 b2) (Eqt M a (times d1 d2))) h5))) irr primal dvd)))))).

(; //LEAN:Irreducible.prime ;)
def Irreducible__prime : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (_ : Proof (DecompositionMonoid M)) -> (a : Elem M) -> (irr : Proof (Irreducible M a)) -> Proof (Prime M a) :=
  M => x => h => a => irr => Irreducible__prime_of_isPrimal M a irr (DecompositionMonoid__primal M (SemigroupWithZero__toSemigroup M) a).

(; //LEAN:Prime.irreducible ;)
def Prime__irreducible : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (_ : Proof (IsCancelMulZero M)) -> (p : Elem M) -> (hp : Proof (Prime M p)) -> Proof (Irreducible M p) :=
  M => x => h => p => hp => Irreducible__mk M p (Prime__not_isUnit M p hp) (forallI M (a => forall M (b1 => if (Eqt M p (times a b1)) (or (IsUnit M a) (IsUnit M b1)))) (a => forallI M (b => if (Eqt M p (times a b)) (or (IsUnit M a) (IsUnit M b))) (b => ifI (Eqt M p (times a b)) (or (IsUnit M a) (IsUnit M b)) (h1 => Eq__ndrec M (times a b) (p1 => if (Prime M p1) (or (IsUnit M a) (IsUnit M b))) (ifI (Prime M (times a b)) (or (IsUnit M a) (IsUnit M b)) (hp2 => Or__imp (divide (times a b) b) (IsUnit M a) (divide (times a b) a) (IsUnit M b) (ifI (divide (times a b) b) (IsUnit M a) (h2 => isUnit_of_dvd_one M a (iffEl (divide (times a b) (times 1 b)) (divide a 1) (mul_dvd_mul_iff_right M a 1 b (right_ne_zero_of_mul M a b (Prime__ne_zero M (times a b) hp2))) (dvd_mul_of_dvd_right M (times a b) b h2 1)))) (ifI (divide (times a b) a) (IsUnit M b) (h3 => isUnit_of_dvd_one M b (iffEl (divide (times a b) (times a 1)) (divide b 1) (mul_dvd_mul_iff_left M a b 1 (left_ne_zero_of_mul M a b (Prime__ne_zero M (times a b) hp2))) (dvd_mul_of_dvd_left M (times a b) a h3 1)))) (Or__symm (divide (times a b) a) (divide (times a b) b) (Prime__dvd_or_dvd M (times a b) hp2 a b (dvd_rfl M (times a b)))))) p (Eq__symm M p (times a b) h1) hp)))).

(; //LEAN:irreducible_iff_prime ;)
def irreducible_iff_prime : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (_ : Proof (IsCancelMulZero M)) -> (_ : Proof (DecompositionMonoid M)) -> (a : Elem M) -> Proof (iff (Irreducible M a) (Prime M a)) :=
  M => x => h => h1 => a => iffI (Irreducible M a) (Prime M a) (Irreducible__prime M a) (Prime__irreducible M a).

