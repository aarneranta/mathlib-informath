(; constants used by Mathlib.Algebra.Ring.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__mulRight__app : (a1 : Elem R) -> (a2 : Elem R) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
AddMonoid__End__mulLeft__app : (a1 : Elem R) -> Elem (AddMonoid__End R).

(; a constant applied as a function: DFunLike.coe ;)
AddMonoid__End__mulRight__app : (a1 : Elem R) -> Elem (AddMonoid__End R).

(; a constant applied as a function: DFunLike.coe ;)
DFunLike__coe__app : (a1 : Elem (AddMonoidHom R (AddMonoid__End R))) -> (a2 : Elem R) -> (a3 : Elem R) -> Elem R.

(; doc: `M →ₙ+ N` is the type of functions `M → N` that preserve addition. The `ₙ` in the notation stands for "non-unital" because it is intended to match the notation for `NonUnitalAlgHom` and `NonUnitalRingHom`, so a `AddHom` is a non-unital additive monoid hom.  When possible, instead of parametrizing results over `(f : AddHom M N)`, you should parametrize over `(F : Type*) [AddHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddHomClass`. ;)
(; //LEAN:AddHom ;)
AddHom : (M : Set) -> (N : Set) -> Set.

(; //LEAN:AddHom.mk ;)
AddHom__mk : (toFun : (Elem M -> N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (toFun (plus x2 y)) (plus (toFun x2) (toFun y)))))) -> Elem (AddHom M N).

(; //LEAN:AddHom.mulLeft._proof_1 ;)
AddHom__mulLeft___proof_1 : (R : Set) -> (_ : Proof (Distrib R)) -> (r : Elem R) -> (b : Elem R) -> (c : Elem R) -> Proof (Eqt R (times r (plus b c)) (plus (times r b) (times r c))).

(; //LEAN:AddHom.mulRight._proof_1 ;)
AddHom__mulRight___proof_1 : (R : Set) -> (_ : Proof (Distrib R)) -> (r : Elem R) -> (x1 : Elem R) -> (x2 : Elem R) -> Proof (Eqt R (times (plus x1 x2) r) (plus (times x1 r) (times x2 r))).

(; doc: The monoid of endomorphisms. ;)
(; //LEAN:AddMonoid.End ;)
AddMonoid__End : (M : Set) -> Set.

(; //LEAN:AddMonoid.toAddZeroClass ;)
AddMonoid__toAddZeroClass : Proof (AddZeroClass M).

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of additive monoid morphisms as an additive monoid morphism. ;)
(; //LEAN:AddMonoidHom.comp ;)
AddMonoidHom__comp : (hnp : Elem (AddMonoidHom N P)) -> (hmn : Elem (AddMonoidHom M N)) -> Elem (AddMonoidHom M P).

(; doc: The expression `fun m q ↦ f m (g q)` as an `AddMonoidHom`.  Note that the expression `fun q n ↦ f (g q) n` is simply `AddMonoidHom.comp`.  This also exists as a `LinearMap` version, `LinearMap.compl₂` ;)
(; //LEAN:AddMonoidHom.compl₂ ;)
AddMonoidHom__compl_u2082_ : (f : Elem (AddMonoidHom M (AddMonoidHom N P))) -> (g : Elem (AddMonoidHom Q N)) -> Elem (AddMonoidHom M (AddMonoidHom Q P)).

(; doc: The expression `fun m n ↦ g (f m n)` as an `AddMonoidHom`.  This also exists as a `LinearMap` version, `LinearMap.compr₂` ;)
(; //LEAN:AddMonoidHom.compr₂ ;)
AddMonoidHom__compr_u2082_ : (f : Elem (AddMonoidHom M (AddMonoidHom N P))) -> (g : Elem (AddMonoidHom P Q)) -> Elem (AddMonoidHom M (AddMonoidHom N Q)).

(; //LEAN:AddMonoidHom.ext ;)
AddMonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (AddZero M)) -> (_ : Proof (AddZero N)) -> (f : Elem (AddMonoidHom M N)) -> (g : Elem (AddMonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (AddMonoidHom M N) f g).

(; //LEAN:AddMonoidHom.ext_iff₂ ;)
AddMonoidHom__ext_iff_u2082_ : (M : Set) -> (N : Set) -> (P : Set) -> (x : Proof (AddZeroClass M)) -> (x1 : Proof (AddZeroClass N)) -> (x2 : Proof (AddCommMonoid P)) -> (f : Elem (AddMonoidHom M (AddMonoidHom N P))) -> (g : Elem (AddMonoidHom M (AddMonoidHom N P))) -> Proof (iff (Eqt (AddMonoidHom M (AddMonoidHom N P)) f g) (forall M (x3 => forall N (y => Eqt P (DFunLike__coe__app f x3 y) (DFunLike__coe__app g x3 y))))).

(; doc: `flip` arguments of `f : M →+ N →+ P` ;)
(; //LEAN:AddMonoidHom.flip ;)
AddMonoidHom__flip : (f : Elem (AddMonoidHom M (AddMonoidHom N P))) -> Elem (AddMonoidHom N (AddMonoidHom M P)).

(; //LEAN:AddMonoidHom.mk ;)
AddMonoidHom__mk : (toZeroHom : Elem (ZeroHom M N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (ZeroHom__toFun toZeroHom (plus x2 y)) (plus (ZeroHom__toFun toZeroHom x2) (ZeroHom__toFun toZeroHom y)))))) -> Elem (AddMonoidHom M N).

(; //LEAN:AddMonoidHom.mul._proof_1 ;)
AddMonoidHom__mul___proof_1 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> Proof (Eqt (AddMonoidHom R R) (AddMonoidHom__mulLeft 0) 0).

(; //LEAN:AddMonoidHom.mul._proof_2 ;)
AddMonoidHom__mul___proof_2 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> (a : Elem R) -> (b : Elem R) -> Proof (Eqt (AddMonoidHom R R) (AddMonoidHom__mulLeft (plus a b)) (plus (AddMonoidHom__mulLeft a) (AddMonoidHom__mulLeft b))).

(; //LEAN:AddMonoidHom.mulLeft._proof_1 ;)
AddMonoidHom__mulLeft___proof_1 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> (r : Elem R) -> Proof (Eqt R (times r 0) 0).

(; //LEAN:AddMonoidHom.mulLeft._proof_2 ;)
AddMonoidHom__mulLeft___proof_2 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> (r : Elem R) -> (b : Elem R) -> (c : Elem R) -> Proof (Eqt R (times r (plus b c)) (plus (times r b) (times r c))).

(; //LEAN:AddMonoidHom.mulRight._proof_1 ;)
AddMonoidHom__mulRight___proof_1 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> (r : Elem R) -> Proof (Eqt R (times 0 r) 0).

(; //LEAN:AddMonoidHom.mulRight._proof_2 ;)
AddMonoidHom__mulRight___proof_2 : (R : Set) -> (_ : Proof (NonUnitalNonAssocSemiring R)) -> (r : Elem R) -> (x1 : Elem R) -> (x2 : Elem R) -> Proof (Eqt R (times (plus x1 x2) r) (plus (times x1 r) (times x2 r))).

(; doc: Two elements commute if `a * b = b * a`. ;)
(; //LEAN:Commute ;)
Commute : (a : Elem M) -> (b : Elem M) -> Prop.

(; //LEAN:Commute.all ;)
Commute__all : (S : Set) -> (_ : Proof (CommMagma S)) -> (a : Elem S) -> (b : Elem S) -> Proof (Commute a b).

(; //LEAN:DFunLike.ext_iff ;)
DFunLike__ext_iff : (F : Set) -> (X : Set) -> (x : (Elem X -> Set)) -> (f : Elem F) -> (g : Elem F) -> Proof (iff (Eqt F f g) (forall X (x1 => Eqt (x x1) (f x1) (g x1)))).

(; doc: A typeclass stating that multiplication is left and right distributive over addition. ;)
(; //LEAN:Distrib ;)
Distrib : (R : Set) -> Prop.

(; doc: A `DivisionMonoid` is a `DivInvMonoid` with involutive inversion and such that `(a * b)⁻¹ = b⁻¹ * a⁻¹` and `a * b = 1 → a⁻¹ = b`.  This is the immediate common ancestor of `Group` and `GroupWithZero`. ;)
(; //LEAN:DivisionMonoid ;)
DivisionMonoid : (G : Set) -> Prop.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: Typeclass for a negation operator that distributes across multiplication.  This is useful for dealing with submonoids of a ring that contain `-1` without having to duplicate lemmas. ;)
(; //LEAN:HasDistribNeg ;)
HasDistribNeg : (X : Set) -> Prop.

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (x : Elem X) -> Elem X.

(; doc: A mixin for cancellative multiplication by nonzero elements. ;)
(; //LEAN:IsCancelMulZero ;)
IsCancelMulZero : (X : Set) -> Prop.

(; doc: A domain is a nontrivial semiring such that multiplication by a nonzero element is cancellative on both sides. In other words, a nontrivial semiring `R` satisfying `∀ {a b c : R}, a ≠ 0 → a * b = a * c → b = c` and `∀ {a b c : R}, b ≠ 0 → a * b = c * b → a = c`.  This is implemented as a mixin for `Semiring α`. To obtain an integral domain use `[CommRing α] [IsDomain α]`. ;)
(; //LEAN:IsDomain ;)
IsDomain : (X : Set) -> Prop.

(; //LEAN:IsDomain.mk ;)
IsDomain__mk : (X : Set) -> (_ : Proof (Semiring X)) -> (_ : Proof (IsCancelMulZero X)) -> Proof (IsDomain X).

(; doc: A mixin for left cancellative multiplication by nonzero elements. ;)
(; //LEAN:IsLeftCancelMulZero ;)
IsLeftCancelMulZero : (X : Set) -> Prop.

(; doc: A left-regular element is an element `c` such that multiplication on the left by `c` is injective. ;)
(; //LEAN:IsLeftRegular ;)
IsLeftRegular : (c : Elem R) -> Prop.

(; doc: A regular element is an element `c` such that multiplication by `c` both on the left and on the right is injective. ;)
(; //LEAN:IsRegular ;)
IsRegular : (c : Elem R) -> Prop.

(; doc: A mixin for right cancellative multiplication by nonzero elements. ;)
(; //LEAN:IsRightCancelMulZero ;)
IsRightCancelMulZero : (X : Set) -> Prop.

(; doc: A right-regular element is an element `c` such that multiplication on the right by `c` is injective. ;)
(; //LEAN:IsRightRegular ;)
IsRightRegular : (c : Elem R) -> Prop.

(; doc: An element `a` is *self-inverse* if `a⁻¹ = a`. ;)
(; //LEAN:IsSelfInv ;)
IsSelfInv : (a : Elem X) -> Prop.

(; doc: An element `a` is *self-negative* if `-a = a`. ;)
(; //LEAN:IsSelfNeg ;)
IsSelfNeg : (a : Elem X) -> Prop.

(; doc: TFAE: The Following (propositions) Are Equivalent.  The `tfae_have` and `tfae_finish` tactics can be useful in proofs with `TFAE` goals. ;)
(; //LEAN:List.TFAE ;)
List__TFAE : (l : Elem (List Prop)) -> Prop.

(; doc: The list whose first element is `head`, where `tail` is the rest of the list. Usually written `head :: tail`.  Conventions for notations in identifiers:   * The recommended spelling of `::` in identifiers is `cons`.   * The recommended spelling of `[a]` in identifiers is `singleton`. ;)
(; //LEAN:List.cons ;)
List__cons : (head : Elem X) -> (tail : Elem (List X)) -> Elem (List X).

(; doc: The empty list, usually written `[]`.  Conventions for notations in identifiers:   * The recommended spelling of `[]` in identifiers is `nil`. ;)
(; //LEAN:List.nil ;)
List__nil : Elem (List X).

(; doc: Zero is a right absorbing element for multiplication ;)
(; //LEAN:MulZeroClass.mul_zero ;)
MulZeroClass__mul_zero : (X : Set) -> (_ : Proof (MulZeroClass X)) -> (a : Elem X) -> Proof (Eqt X (times a 0) 0).

(; doc: Zero is a left absorbing element for multiplication ;)
(; //LEAN:MulZeroClass.zero_mul ;)
MulZeroClass__zero_mul : (X : Set) -> (_ : Proof (MulZeroClass X)) -> (a : Elem X) -> Proof (Eqt X (times 0 a) 0).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; doc: Predicate typeclass for expressing that `a * b = 0` implies `a = 0` or `b = 0` for all `a` and `b` of type `M₀`. It is weaker than `IsCancelMulZero` in general, but equivalent to it if `M₀` is a (not necessarily unital or associative) ring. ;)
(; //LEAN:NoZeroDivisors ;)
NoZeroDivisors : (X : Set) -> Prop.

(; //LEAN:NoZeroDivisors.mk ;)
NoZeroDivisors__mk : (X : Set) -> (eq_zero_or_eq_zero_of_mul_eq_zero : Proof (forall X (a => forall X (b => if (Eqt X (times a b) 0) (or (Eqt X a 0) (Eqt X b 0)))))) -> Proof (NoZeroDivisors X).

(; doc: A unital but not-necessarily-associative ring. ;)
(; //LEAN:NonAssocRing ;)
NonAssocRing : (X : Set) -> Prop.

(; doc: A non-unital commutative ring is a `NonUnitalRing` with commutative multiplication. ;)
(; //LEAN:NonUnitalCommRing ;)
NonUnitalCommRing : (X : Set) -> Prop.

(; doc: A not-necessarily-unital, not-necessarily-associative, but commutative semiring. ;)
(; //LEAN:NonUnitalNonAssocCommSemiring ;)
NonUnitalNonAssocCommSemiring : (X : Set) -> Prop.

(; doc: A not-necessarily-unital, not-necessarily-associative ring. ;)
(; //LEAN:NonUnitalNonAssocRing ;)
NonUnitalNonAssocRing : (X : Set) -> Prop.

(; doc: A not-necessarily-unital, not-necessarily-associative semiring. See `CommutatorRing` and the documentation thereof in case you need a `NonUnitalNonAssocSemiring` instance on a Lie ring or a Lie algebra. ;)
(; //LEAN:NonUnitalNonAssocSemiring ;)
NonUnitalNonAssocSemiring : (X : Set) -> Prop.

(; //LEAN:NonUnitalNonAssocSemiring.toAddCommMonoid ;)
NonUnitalNonAssocSemiring__toAddCommMonoid : Proof (AddCommMonoid X).

(; doc: Predicate typeclass for expressing that a type is not reduced to a single element. In rings, this is equivalent to `0 ≠ 1`. In vector spaces, this is equivalent to positive dimension. ;)
(; //LEAN:Nontrivial ;)
Nontrivial : (X : Set) -> Prop.

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; //LEAN:Subsingleton.eq_zero ;)
Subsingleton__eq_zero : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> Proof (Eqt X a 0).

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; //LEAN:ZeroHom.mk ;)
ZeroHom__mk : (toFun : (Elem M -> N)) -> (map_zero' : Proof (Eqt N (toFun 0) 0)) -> Elem (ZeroHom M N).

(; //LEAN:add_right_inj ;)
add_right_inj : (G : Set) -> (_ : Proof (IsLeftCancelAdd G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Eqt G (plus a b) (plus a c)) (Eqt G b c)).

(; //LEAN:add_zero ;)
add_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus a 0) a).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: **Alias** of `div_eq_mul_inv`.  ---  Dividing by an element is the same as multiplying by its inverse.  This is a duplicate of `DivInvMonoid.div_eq_mul_inv` ensuring that the types unfold better. ;)
(; //LEAN:division_def ;)
division_def : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (div a b) (times a (Inv__inv b))).

(; //LEAN:eq_one_div_of_mul_eq_one_right ;)
eq_one_div_of_mul_eq_one_right : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X (times a b) 1)) -> Proof (Eqt X b (div 1 a)).

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:inv_eq_one_div ;)
inv_eq_one_div : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (x1 : Elem G) -> Proof (Eqt G (Inv__inv x1) (div 1 x1)).

(; //LEAN:mul_neg ;)
mul_neg : (X : Set) -> (_ : Proof (HasDistribNeg X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (times a (Neg__neg b)) (Neg__neg (times a b))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:mul_one_div ;)
mul_one_div : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> Proof (Eqt G (times x1 (div 1 y)) (div x1 y)).

(; doc: **Alias** of `mul_sub_left_distrib`. ;)
(; //LEAN:mul_sub ;)
mul_sub : (X : Set) -> (_ : Proof (NonUnitalNonAssocRing X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (times a (minus b c)) (minus (times a b) (times a c))).

(; //LEAN:neg_eq_neg_one_mul ;)
neg_eq_neg_one_mul : (X : Set) -> (_ : Proof (MulOneClass X)) -> (_ : Proof (HasDistribNeg X)) -> (a : Elem X) -> Proof (Eqt X (Neg__neg a) (times (Neg__neg 1) a)).

(; //LEAN:neg_mul_eq_mul_neg ;)
neg_mul_eq_mul_neg : (X : Set) -> (_ : Proof (HasDistribNeg X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (Neg__neg (times a b)) (times a (Neg__neg b))).

(; //LEAN:neg_mul_neg ;)
neg_mul_neg : (X : Set) -> (_ : Proof (HasDistribNeg X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (times (Neg__neg a) (Neg__neg b)) (times a b)).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_div_mul_one_div_rev ;)
one_div_mul_one_div_rev : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (times (div 1 a) (div 1 b)) (div 1 (times b a))).

(; //LEAN:one_mul ;)
one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times 1 a) a).

(; //LEAN:one_ne_zero ;)
one_ne_zero : (X : Set) -> (_ : Proof (NeZero 1)) -> Proof (Neq 1 0).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:sub_eq_zero ;)
sub_eq_zero : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Eqt G (minus a b) 0) (Eqt G a b)).

(; doc: **Alias** of `mul_sub_right_distrib`. ;)
(; //LEAN:sub_mul ;)
sub_mul : (X : Set) -> (_ : Proof (NonUnitalNonAssocRing X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (times (minus a b) c) (minus (times a c) (times b c))).

(; //LEAN:sub_self ;)
sub_self : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> Proof (Eqt G (minus a a) 0).

