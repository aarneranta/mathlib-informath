(; //LEAN:inv_neg_one ;)
inv_neg_one : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> Proof (Eqt R (Inv__inv R (Neg__neg R 1)) (Neg__neg R 1)).

(; //LEAN:isSelfInv_neg_iff ;)
isSelfInv_neg_iff : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (iff (IsSelfInv R (Neg__neg R a)) (IsSelfInv R a)).

(; //LEAN:IsSelfInv.neg ;)
def IsSelfInv__neg : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (h : Proof (IsSelfInv R a)) -> Proof (IsSelfInv R (Neg__neg R a)) :=
  R => x => x1 => a => iffEr (IsSelfInv R (Neg__neg R a)) (IsSelfInv R a) (isSelfInv_neg_iff R a).

(; //LEAN:isSelfNeg_inv_iff ;)
isSelfNeg_inv_iff : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (iff (IsSelfNeg R (Inv__inv R a)) (IsSelfNeg R a)).

(; //LEAN:IsSelfNeg.inv ;)
def IsSelfNeg__inv : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (h : Proof (IsSelfNeg R a)) -> Proof (IsSelfNeg R (Inv__inv R a)) :=
  R => x => x1 => a => iffEr (IsSelfNeg R (Inv__inv R a)) (IsSelfNeg R a) (isSelfNeg_inv_iff R a).

