inv_neg : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (Eqt R (Inv__inv (Neg__neg a)) (Neg__neg (Inv__inv a))).

(; //LEAN:inv_neg_one ;)
inv_neg_one : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> Proof (Eqt R (Inv__inv (Neg__neg 1)) (Neg__neg 1)).

(; //LEAN:isSelfInv_neg_iff ;)
isSelfInv_neg_iff : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (iff (IsSelfInv (Neg__neg a)) (IsSelfInv a)).

(; //LEAN:IsSelfInv.neg ;)
def IsSelfInv__neg : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (h : Proof (IsSelfInv a)) -> Proof (IsSelfInv (Neg__neg a)) :=
  R => x => x1 => a => iffEr (IsSelfInv (Neg__neg a)) (IsSelfInv a) (isSelfInv_neg_iff R a).

(; //LEAN:isSelfNeg_inv_iff ;)
isSelfNeg_inv_iff : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (iff (IsSelfNeg (Inv__inv a)) (IsSelfNeg a)).

(; //LEAN:IsSelfNeg.inv ;)
def IsSelfNeg__inv : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (h : Proof (IsSelfNeg a)) -> Proof (IsSelfNeg (Inv__inv a)) :=
  R => x => x1 => a => iffEr (IsSelfNeg (Inv__inv a)) (IsSelfNeg a) (isSelfNeg_inv_iff R a).

