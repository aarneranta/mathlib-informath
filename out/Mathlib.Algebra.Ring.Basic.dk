div_neg_eq_neg_div' : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (b : Elem R) -> (a : Elem R) -> Proof (Eqt R (div a (Neg__neg b)) (div (Neg__neg a) b)).

