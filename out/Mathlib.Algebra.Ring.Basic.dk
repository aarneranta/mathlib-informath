(; //LEAN:neg_div ;)
neg_div : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (b : Elem R) -> Proof (Eqt R (div (Neg__neg R b) a) (Neg__neg R (div b a))).

(; //LEAN:neg_div' ;)
neg_div' : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (b : Elem R) -> Proof (Eqt R (Neg__neg R (div b a)) (div (Neg__neg R b) a)).

(; //LEAN:neg_div_neg_eq ;)
neg_div_neg_eq : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> (b : Elem R) -> Proof (Eqt R (div (Neg__neg R a) (Neg__neg R b)) (div a b)).

(; //LEAN:neg_inv ;)
neg_inv : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (a : Elem R) -> Proof (Eqt R (Neg__neg R (Inv__inv R a)) (Inv__inv R (Neg__neg R a))).

(; //LEAN:div_neg ;)
div_neg : (R : Set) -> (_ : Proof (DivisionMonoid R)) -> (_ : Proof (HasDistribNeg R)) -> (b : Elem R) -> (a : Elem R) -> Proof (Eqt R (div a (Neg__neg R b)) (Neg__neg R (div a b))).

