   },
   {
    "unit": "enough",
    "prop": "Eqt X (plus (pow a (plus (times 2 k) 1)) (pow b (plus (times 2 k) 1))) 0",
    "by": "obtain ⟨k, rfl⟩ := hn",
    "depth": 0
   },
   {
    "unit": "induction",
    "by": "induction k with | zero => simpa | succ k ih => ?_",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X (plus (pow a (plus (times 2 0) 1)) (pow b (plus (times 2 0) 1))) 0",
    "by": "simpa",
    "method": "simplification",
    "depth": 0
   },
   {
    "unit": "verify",
    "prop": "(Eqt X (pow a 2) (pow b 2))",
    "by": "have : a ^ 2 = b ^ 2 := add_right_cancel <|",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X (plus (pow a 2) (times a b)) 0",
    "by": "rw [sq, ← mul_add, hab, mul_zero]",
    "method": "rewriting",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X 0 (plus (pow b 2) (times a b))",
    "by": "rw [sq, ← add_mul, add_comm, hab, zero_mul]",
    "method": "rewriting",
    "depth": 0
   },
   {
    "unit": "enough",
    "prop": "Eqt X (plus (plus (pow a (plus (times 2 (plus k 1)) 1)) (pow b (plus (times 2 (plus k 1)) 1))) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (plus 0 (times (pow b (plus (times 2 k) 1)) (pow a 2)))",
    "by": "refine add_right_cancel (b := b ^ (2 * k + 1) * a ^ 2) ?_",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X (plus (plus (pow a (plus (times 2 (plus k 1)) 1)) (pow b (plus (times 2 (plus k 1)) 1))) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (plus 0 (times (pow b (plus (times 2 k) 1)) (pow a 2)))",
    "by": "calc",
    "depth": 0
   },
   {
    "unit": "enough",
    "prop": "Eqt X (plus (plus (pow a (plus (times 2 (plus k 1)) 1)) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (pow b (plus (times 2 (plus k 1)) 1))) (plus (plus (pow a (plus (plus (times 2 k) 1) 2)) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (pow b (plus (times 2 k) 3)))",
    "by": "rw [add_mul, ← pow_add, add_right_comm]",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X (plus (plus (pow a (plus (times 2 (plus k 1)) 1)) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (pow b (plus (times 2 (plus k 1)) 1))) (plus (plus (pow a (plus (plus (times 2 k) 1) 2)) (times (pow b (plus (times 2 k) 1)) (pow a 2))) (pow b (plus (times 2 k) 3)))",
    "by": "rfl",
    "method": "definition",
    "depth": 0
   },
   {
    "unit": "conclusion",
    "prop": "Eqt X (plus (times (plus (pow a (plus (times 2 k) 1)) (pow b (plus (times 2 k) 1))) (pow a 2)) (pow b (plus (times 2 k) 3))) (plus 0 (times (pow b (plus (times 2 k) 1)) (pow a 2)))",
    "by": "rw [ih, zero_mul, zero_add, zero_add, this, ← pow_add]",
    "method": "rewriting",
    "depth": 0
   }
  ]
