  "name": "Odd__pow_add_pow_eq_zero",
  "lean": "Odd.pow_add_pow_eq_zero",
  "steps": [
   {
    "unit": "hypos",
    "hypos": [
     [
      "k",
      "Elem Nat"
     ]
    ],
    "by": "obtain ⟨k, rfl⟩ := hn",
