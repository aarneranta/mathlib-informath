  X => f => n => hf => hne => iffI (Eqt (Elem X -> X) (Nat__iterate f n) f) (odd n) (H => iffEl (not (even n)) (odd n) (Nat__not_even_iff_odd n) (hn => ifE (Eqt (Elem X -> X) f id) false hne (Eq__mp (congrArg Prop Prop (Eqt (Elem X -> X) id f) (Eqt (Elem X -> X) f id) (_a => _a) (propext (Eqt (Elem X -> X) id f) (Eqt (Elem X -> X) f id) (eq_comm (Elem X -> X) id f))) (Eq__mp (congrArg (Elem X -> X) Prop (Nat__iterate f n) id (_a1 => Eqt (Elem X -> X) _a1 f) (Function__Involutive__iterate_even X f n hf hn)) H)))) (Function__Involutive__iterate_odd X f n hf).

(; //LEAN:Function.Involutive.iterate_eq_id ;)
def Function__Involutive__iterate_eq_id : (X : Set) -> (f : (Elem X -> X)) -> (n : Elem Nat) -> (hf : Proof (Function__Involutive f)) -> (hne : Proof (Neq f id)) -> Proof (iff (Eqt (Elem X -> X) (Nat__iterate f n) id) (even n)) :=
  X => f => n => hf => hne => iffI (Eqt (Elem X -> X) (Nat__iterate f n) id) (even n) (H => iffEl (not (odd n)) (even n) (Nat__not_odd_iff_even n) (hn => ifE (Eqt (Elem X -> X) f id) false hne (Eq__mp (congrArg (Elem X -> X) Prop (Nat__iterate f n) f (_a => Eqt (Elem X -> X) _a id) (Function__Involutive__iterate_odd X f n hf hn)) H))) (Function__Involutive__iterate_even X f n hf).

(; //LEAN:neg_one_pow_eq_ite ;)
neg_one_pow_eq_ite : (R : Set) -> (_ : Proof (Monoid R)) -> (_ : Proof (HasDistribNeg R)) -> (n : Elem Nat) -> Proof (Eqt R (pow (Neg__neg 1) n) (ite (even n) 1 (Neg__neg 1))).

(; //LEAN:neg_one_pow_congr ;)
neg_one_pow_congr : (R : Set) -> (_ : Proof (Monoid R)) -> (_ : Proof (HasDistribNeg R)) -> (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (iff (even m) (even n))) -> Proof (Eqt R (pow (Neg__neg 1) m) (pow (Neg__neg 1) n)).

(; //LEAN:neg_one_pow_eq_one_iff_even ;)
neg_one_pow_eq_one_iff_even : (R : Set) -> (_ : Proof (Monoid R)) -> (_ : Proof (HasDistribNeg R)) -> (n : Elem Nat) -> (h : Proof (Neq (Neg__neg 1) 1)) -> Proof (iff (Eqt R (pow (Neg__neg 1) n) 1) (even n)).

(; //LEAN:neg_one_pow_eq_neg_one_iff_odd ;)
neg_one_pow_eq_neg_one_iff_odd : (R : Set) -> (_ : Proof (Monoid R)) -> (_ : Proof (HasDistribNeg R)) -> (n : Elem Nat) -> (h : Proof (Neq (Neg__neg 1) 1)) -> Proof (iff (Eqt R (pow (Neg__neg 1) n) (Neg__neg 1)) (odd n)).

(; //LEAN:Even.neg_zpow ;)
Even__neg_zpow : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (_ : Proof (HasDistribNeg X)) -> (n : Elem Int) -> (h : Proof (even n)) -> (a : Elem X) -> Proof (Eqt X (pow (Neg__neg a) n) (pow a n)).

(; //LEAN:Even.neg_one_zpow ;)
Even__neg_one_zpow : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (_ : Proof (HasDistribNeg X)) -> (n : Elem Int) -> (h : Proof (even n)) -> Proof (Eqt X (pow (Neg__neg 1) n) 1).

(; //LEAN:neg_one_zpow_eq_ite ;)
neg_one_zpow_eq_ite : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (_ : Proof (HasDistribNeg X)) -> (n : Elem Int) -> Proof (Eqt X (pow (Neg__neg 1) n) (ite (even n) 1 (Neg__neg 1))).

(; //LEAN:natCast_eq_zero_of_even_of_two_eq_zero ;)
natCast_eq_zero_of_even_of_two_eq_zero : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> (n : Elem Nat) -> (hn : Proof (even n)) -> (h : Proof (Eqt R 2 0)) -> Proof (Eqt R n 0).

(; //LEAN:natCast_eq_one_of_odd_of_two_eq_zero ;)
natCast_eq_one_of_odd_of_two_eq_zero : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> (n : Elem Nat) -> (hn : Proof (odd n)) -> (h : Proof (Eqt R 2 0)) -> Proof (Eqt R n 1).

(; //LEAN:natCast_eq_zero_or_one_of_two_eq_zero ;)
natCast_eq_zero_or_one_of_two_eq_zero : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> (n : Elem Nat) -> (h : Proof (Eqt R 2 0)) -> Proof (or (Eqt R n 0) (Eqt R n 1)).

