(; //LEAN:HasDerivAtFilter ;)
def HasDerivAtFilter : (f : (Elem X -> F)) -> (f' : Elem F) -> (L : Elem (Filter (Prod X X))) -> Prop :=
  f => f' => L => HasFDerivAtFilter f (ContinuousLinearMap__toSpanSingleton X f') L.

(; //LEAN:HasDerivWithinAt ;)
def HasDerivWithinAt : (f : (Elem X -> F)) -> (f' : Elem F) -> (s : Elem (powerset X)) -> (x4 : Elem X) -> Prop :=
  f => f' => s => x4 => HasDerivAtFilter f f' (SProd__sprod (nhdsWithin x4 s) (Pure__pure x4)).

(; //LEAN:HasDerivAt ;)
def HasDerivAt : (f : (Elem X -> F)) -> (f' : Elem F) -> (x4 : Elem X) -> Prop :=
  f => f' => x4 => HasDerivAtFilter f f' (SProd__sprod (nhds x4) (Pure__pure x4)).

(; //LEAN:HasStrictDerivAt ;)
def HasStrictDerivAt : (f : (Elem X -> F)) -> (f' : Elem F) -> (x4 : Elem X) -> Prop :=
  f => f' => x4 => HasDerivAtFilter f f' (nhds (Prod__mk x4 x4)).

(; //LEAN:derivWithin ;)
def derivWithin : (f : (Elem X -> F)) -> (s : Elem (powerset X)) -> (x4 : Elem X) -> Elem F :=
  f => s => x4 => fderivWithin__app X f s x4 1.

(; //LEAN:deriv ;)
def deriv : (f : (Elem X -> F)) -> (x4 : Elem X) -> Elem F :=
  f => x4 => fderiv__app X f x4 1.

