  X => x => F => x1 => x2 => f => f' => x3 => h => HasDerivAtFilter__tendsto_nhds X F f f' x3 (nhds x3) (le_rfl (Filter X) (nhds x3)) h.

(; //LEAN:HasDerivWithinAt.continuousOn ;)
def HasDerivWithinAt__continuousOn : (X : Set) -> (_ : Proof (NontriviallyNormedField X)) -> (F : Set) -> (_ : Proof (NormedAddCommGroup F)) -> (_ : Proof (NormedSpace X F)) -> (s : Elem (powerset X)) -> (f : (Elem X -> F)) -> (f' : (Elem X -> F)) -> (h : Proof (forall X (x3 => if (Membership__mem s x3) (HasDerivWithinAt f (f' x3) s x3)))) -> Proof (ContinuousOn f s) :=
  X => x => F => x1 => x2 => s => f => f' => h => forallI X (x3 => if (Membership__mem s x3) (ContinuousWithinAt f s x3)) (x3 => ifI (Membership__mem s x3) (ContinuousWithinAt f s x3) (hx => HasDerivWithinAt__continuousWithinAt X F f (f' x3) x3 s (ifE (Membership__mem s x3) (HasDerivWithinAt f (f' x3) s x3) (forallE X (x4 => if (Membership__mem s x4) (HasDerivWithinAt f (f' x4) s x4)) h x3) hx))).

(; //LEAN:HasDerivAt.continuousOn ;)
def HasDerivAt__continuousOn : (X : Set) -> (_ : Proof (NontriviallyNormedField X)) -> (F : Set) -> (_ : Proof (NormedAddCommGroup F)) -> (_ : Proof (NormedSpace X F)) -> (s : Elem (powerset X)) -> (f : (Elem X -> F)) -> (f' : (Elem X -> F)) -> (hderiv : Proof (forall X (x3 => if (Membership__mem s x3) (HasDerivAt f (f' x3) x3)))) -> Proof (ContinuousOn f s) :=
  X => x => F => x1 => x2 => s => f => f' => hderiv => forallI X (x3 => if (Membership__mem s x3) (ContinuousWithinAt f s x3)) (x3 => ifI (Membership__mem s x3) (ContinuousWithinAt f s x3) (hx => ContinuousAt__continuousWithinAt X F f s x3 (HasDerivAt__continuousAt X F f (f' x3) x3 (ifE (Membership__mem s x3) (HasDerivAt f (f' x3) x3) (forallE X (x4 => if (Membership__mem s x4) (HasDerivAt f (f' x4) x4)) hderiv x3) hx)))).

(; //LEAN:HasDerivAt.le_of_lip' ;)
