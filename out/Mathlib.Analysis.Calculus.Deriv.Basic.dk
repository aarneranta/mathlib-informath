(; //LEAN:HasDerivAtFilter ;)
def HasDerivAtFilter : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (L : Elem (Filter (Prod X X))) -> Prop :=
  X => F => f => f' => L => HasFDerivAtFilter X X F f (ContinuousLinearMap__toSpanSingleton X F f') L.

(; //LEAN:HasDerivWithinAt ;)
def HasDerivWithinAt : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (s : Elem (powerset X)) -> (x4 : Elem X) -> Prop :=
  X => F => f => f' => s => x4 => HasDerivAtFilter X F f f' (SProd__sprod (Filter X) (Filter X) (Filter (Prod X X)) (nhdsWithin X x4 s) (Pure__pure Filter X x4)).

(; //LEAN:HasDerivAt ;)
def HasDerivAt : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (x4 : Elem X) -> Prop :=
  X => F => f => f' => x4 => HasDerivAtFilter X F f f' (SProd__sprod (Filter X) (Filter X) (Filter (Prod X X)) (nhds X x4) (Pure__pure Filter X x4)).

(; //LEAN:HasStrictDerivAt ;)
def HasStrictDerivAt : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (x4 : Elem X) -> Prop :=
  X => F => f => f' => x4 => HasDerivAtFilter X F f f' (nhds (Prod X X) (Prod__mk X X x4 x4)).

(; //LEAN:derivWithin ;)
def derivWithin : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (s : Elem (powerset X)) -> (x4 : Elem X) -> Elem F :=
  X => F => f => s => x4 => fderivWithin__app X f s x4 1.

(; //LEAN:deriv ;)
def deriv : (X : Set) -> (F : Set) -> (f : (Elem X -> F)) -> (x4 : Elem X) -> Elem F :=
  X => F => f => x4 => fderiv__app X f x4 1.

