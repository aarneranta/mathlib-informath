(; //LEAN:HasDerivAtFilter.tendsto_nhds ;)
def HasDerivAtFilter__tendsto_nhds : (X : Set) -> (_ : Proof (NontriviallyNormedField X)) -> (F : Set) -> (_ : Proof (NormedAddCommGroup F)) -> (_ : Proof (NormedSpace X F)) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (x3 : Elem X) -> (L : Elem (Filter X)) -> (hL : Proof (Leq L (nhds x3))) -> (h : Proof (HasDerivAtFilter f f' (SProd__sprod L (Pure__pure x3)))) -> Proof (Filter__Tendsto f L (nhds (f x3))) :=
  X => x => F => x1 => x2 => f => f' => x3 => L => hL => h => HasFDerivAtFilter__tendsto_nhds X X F f (ContinuousLinearMap__toSpanSingleton X f') x3 L hL (HasDerivAtFilter__hasFDerivAtFilter X F f f' (SProd__sprod L (Pure__pure x3)) h).

(; //LEAN:HasDerivWithinAt.continuousWithinAt ;)
def HasDerivWithinAt__continuousWithinAt : (X : Set) -> (_ : Proof (NontriviallyNormedField X)) -> (F : Set) -> (_ : Proof (NormedAddCommGroup F)) -> (_ : Proof (NormedSpace X F)) -> (f : (Elem X -> F)) -> (f' : Elem F) -> (x3 : Elem X) -> (s : Elem (powerset X)) -> (h : Proof (HasDerivWithinAt f f' s x3)) -> Proof (ContinuousWithinAt f s x3) :=
