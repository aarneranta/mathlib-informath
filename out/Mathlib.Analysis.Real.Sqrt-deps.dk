(; constants used by Mathlib.Analysis.Real.Sqrt, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv NNReal NNReal)) -> (a2 : Elem NNReal) -> Elem NNReal.

(; a constant applied as a function: DFunLike.coe ;)
NNReal__sqrt__app : (a1 : Elem NNReal) -> Elem NNReal.

(; a constant applied as a function: DFunLike.coe ;)
OrderIso__symm__app : (a1 : Elem (OrderIso NNReal NNReal)) -> (a2 : Elem NNReal) -> Elem NNReal.

(; a constant applied as a function: DFunLike.coe ;)
RelIso__toEquiv__app : (a1 : Elem (OrderIso NNReal NNReal)) -> (a2 : Elem NNReal) -> Elem NNReal.

(; doc: A function between topological spaces is continuous if the preimage of every open set is open. Registered as a structure to make sure it is not unfolded by Lean. ;)
(; //LEAN:Continuous ;)
Continuous : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Continuous.comp ;)
Continuous__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (_ : Proof (TopologicalSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (_ : Proof (TopologicalSpace Z)) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> Z)) -> (hg : Proof (Continuous Y Z g)) -> (hf : Proof (Continuous X Y f)) -> Proof (Continuous X Z (Function__comp X Y Z g f)).

(; //LEAN:Continuous.tendsto ;)
Continuous__tendsto : (X : Set) -> (Y : Set) -> (_ : Proof (TopologicalSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem X -> Y)) -> (hf : Proof (Continuous X Y f)) -> (x2 : Elem X) -> Proof (Filter__Tendsto X Y f (nhds X x2) (nhds Y (f x2))).

(; doc: A function between topological spaces is continuous at a point `x₀` if `f x` tends to `f x₀` when `x` tends to `x₀`. ;)
(; //LEAN:ContinuousAt ;)
ContinuousAt : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x2 : Elem X) -> Prop.

(; doc: A function between topological spaces is continuous on a subset `s` when it's continuous at every point of `s` within `s`. ;)
(; //LEAN:ContinuousOn ;)
ContinuousOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A function between topological spaces is continuous at a point `x₀` within a subset `s` if `f x` tends to `f x₀` when `x` tends to `x₀` while staying within `s`. ;)
(; //LEAN:ContinuousWithinAt ;)
ContinuousWithinAt : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> (x2 : Elem X) -> Prop.

(; doc: **Alias** of `le_of_eq`. ;)
(; //LEAN:Eq.le ;)
Eq__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.eq_symm_apply ;)
Equiv__eq_symm_apply : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (x : Elem Y) -> (y : Elem X) -> Proof (iff (Eqt X y (Equiv__symm__app e x)) (Eqt Y (e y) x)).

(; //LEAN:Even.pow_nonneg ;)
Even__pow_nonneg : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (IsOrderedRing R)) -> (_ : Proof (ExistsAddOfLE R)) -> (n : Elem Nat) -> (hn : Proof (even n)) -> (a : Elem R) -> Proof (Leq 0 (pow a n)).

(; doc: A filter `F` on a type `α` is a collection of sets of `α` which contains the whole `α`, is upwards-closed, and is stable under intersection. We do not forbid this collection to be all sets of `α`. ;)
(; //LEAN:Filter ;)
Filter : (X : Set) -> Set.

(; doc: `Filter.Tendsto` is the generic "limit of a function" predicate. `Tendsto f l₁ l₂` asserts that for every `l₂` neighborhood `a`, the `f`-preimage of `a` is an `l₁` neighborhood. ;)
(; //LEAN:Filter.Tendsto ;)
Filter__Tendsto : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (l1 : Elem (Filter X)) -> (l2 : Elem (Filter Y)) -> Prop.

(; //LEAN:Filter.Tendsto.comp ;)
Filter__Tendsto__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> Z)) -> (x : Elem (Filter X)) -> (y : Elem (Filter Y)) -> (z : Elem (Filter Z)) -> (hg : Proof (Filter__Tendsto Y Z g y z)) -> (hf : Proof (Filter__Tendsto X Y f x y)) -> Proof (Filter__Tendsto X Z (Function__comp X Y Z g f) x z).

(; doc: `atTop` is the filter representing the limit `→ ∞` on an ordered set. It is generated by the collection of up-sets `{b | a ≤ b}`. (The preorder need not have a top element for this to be well defined, and indeed is trivial when a top element `x` exists, i.e., it coincides with `pure x`.) ;)
(; //LEAN:Filter.atTop ;)
Filter__atTop : (X : Set) -> Elem (Filter X).

(; doc: The inverse map of a filter. A set `s` belongs to `Filter.comap m f` if either of the following equivalent conditions hold.  1. There exists a set `t ∈ f` such that `m ⁻¹' t ⊆ s`. This is used as a definition. 2. The set `kernImage m s = {y | ∀ x, m x = y → x ∈ s}` belongs to `f`, see `Filter.mem_comap'`. 3. The set `(m '' sᶜ)ᶜ` belongs to `f`, see `Filter.mem_comap_iff_compl` and    `Filter.compl_mem_comap`. ;)
(; //LEAN:Filter.comap ;)
Filter__comap : (X : Set) -> (Y : Set) -> (m : (Elem X -> Y)) -> (f : Elem (Filter Y)) -> Elem (Filter X).

(; doc: The forward map of a filter ;)
(; //LEAN:Filter.map ;)
Filter__map : (X : Set) -> (Y : Set) -> (m : (Elem X -> Y)) -> (f : Elem (Filter X)) -> Elem (Filter Y).

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: **Cauchy-Schwarz inequality** for finsets, squared version. ;)
(; //LEAN:Finset.sum_mul_sq_le_sq_mul_sq ;)
Finset__sum_mul_sq_le_sq_mul_sq : (I : Set) -> (R : Set) -> (_ : Proof (CommSemiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (IsStrictOrderedRing R)) -> (_ : Proof (ExistsAddOfLE R)) -> (s : Elem (Finset I)) -> (f : (Elem I -> R)) -> (g : (Elem I -> R)) -> Proof (Leq (pow (Finset__sum I R s (i => times (f i) (g i))) 2) (times (Finset__sum I R s (i1 => pow (f i1) 2)) (Finset__sum I R s (i2 => pow (g i2) 2)))).

(; //LEAN:Finset.sum_nonneg ;)
Finset__sum_nonneg : (I : Set) -> (N : Set) -> (_ : Proof (AddCommMonoid N)) -> (_ : Proof (Preorder N)) -> (f : (Elem I -> N)) -> (s : Elem (Finset I)) -> (h1 : Proof (forall I (i1 => if (Membership__mem I (Finset I) s i1) (Leq 0 (f i1))))) -> Proof (Leq 0 (Finset__sum I N s (i => f i))).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; doc: `Int.floor a` is the greatest integer `z` such that `z ≤ a`. It is denoted with `⌊a⌋`. ;)
(; //LEAN:Int.floor ;)
Int__floor : (X : Set) -> (x3 : Elem X) -> Elem Int.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: An element `a` of a type `α` with multiplication satisfies `IsSquare a` if `a = r * r`, for some root `r : α`.  [OEIS A000290](https://oeis.org/A000290) ;)
(; //LEAN:IsSquare ;)
IsSquare : (X : Set) -> (a : Elem X) -> Prop.

(; //LEAN:IsSquare.nonneg ;)
IsSquare__nonneg : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (ExistsAddOfLE R)) -> (x2 : Elem R) -> (h3 : Proof (IsSquare R x2)) -> Proof (Leq 0 x2).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h1 : Proof (Leq a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: A `ParserDescr` is a grammar for parsers. This is used by the `syntax` command to produce parsers without having to `import Lean`. ;)
(; //LEAN:Lean.ParserDescr ;)
Lean__ParserDescr : Set.

(; doc: An extension for `positivity`. ;)
(; //LEAN:Mathlib.Meta.Positivity.PositivityExt ;)
Mathlib__Meta__Positivity__PositivityExt : Set.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: `α →*₀ β` is the type of functions `α → β` that preserve the `MonoidWithZero` structure.  `MonoidWithZeroHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : α →*₀ β)`, you should parametrize over `(F : Type*) [MonoidWithZeroHomClass F α β] (f : F)`.  When you extend this structure, make sure to extend `MonoidWithZeroHomClass`. ;)
(; //LEAN:MonoidWithZeroHom ;)
MonoidWithZeroHom : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:MonoidWithZeroHom.mk ;)
MonoidWithZeroHom__mk : (X : Set) -> (Y : Set) -> (toZeroHom : Elem (ZeroHom X Y)) -> (map_one' : Proof (Eqt Y (ZeroHom__toFun X Y toZeroHom 1) 1)) -> (map_mul' : Proof (forall X (x2 => forall X (y => Eqt Y (ZeroHom__toFun X Y toZeroHom (times x2 y)) (times (ZeroHom__toFun X Y toZeroHom x2) (ZeroHom__toFun X Y toZeroHom y)))))) -> Elem (MonoidWithZeroHom X Y).

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: Nonnegative real numbers, denoted as `ℝ≥0` within the NNReal namespace ;)
(; //LEAN:NNReal ;)
NNReal : Set.

(; doc: `x ↦ x ^ n` as an order isomorphism of `ℝ≥0`. ;)
(; //LEAN:NNReal.powOrderIso ;)
NNReal__powOrderIso : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Elem (OrderIso NNReal NNReal).

(; //LEAN:NNReal.sqrt._proof_1 ;)
NNReal__sqrt___proof_1 : Proof (Neq 2 0).

(; doc: Coercion `ℝ≥0 → ℝ`. ;)
(; //LEAN:NNReal.toReal ;)
NNReal__toReal : (x : Elem NNReal) -> Elem Real.

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; doc: `⌊a⌋₊` is the greatest natural `n` such that `n ≤ a`. If `a` is negative, then `⌊a⌋₊ = 0`. ;)
(; //LEAN:Nat.floor ;)
Nat__floor : (X : Set) -> (x3 : Elem X) -> Elem Nat.

(; doc: Integer square root function. Implemented via Newton's method. ;)
(; //LEAN:Nat.sqrt ;)
Nat__sqrt : (n : Elem Nat) -> Elem Nat.

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: An order isomorphism is an equivalence such that `a ≤ b ↔ (f a) ≤ (f b)`. This definition is an abbreviation of `RelIso (≤) (≤)`. ;)
(; //LEAN:OrderIso ;)
OrderIso : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:OrderIso.apply_symm_apply ;)
OrderIso__apply_symm_apply : (X : Set) -> (Y : Set) -> (_ : Proof (LE X)) -> (_ : Proof (LE Y)) -> (e : Elem (OrderIso X Y)) -> (x2 : Elem Y) -> Proof (Eqt Y (e (OrderIso__symm__app e x2)) x2).

(; //LEAN:OrderIso.continuous ;)
OrderIso__continuous : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (_ : Proof (TopologicalSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (_ : Proof (OrderTopology X)) -> (_ : Proof (OrderTopology Y)) -> (e : Elem (OrderIso X Y)) -> Proof (Continuous X Y e).

(; //LEAN:OrderIso.le_iff_le ;)
OrderIso__le_iff_le : (X : Set) -> (Y : Set) -> (_ : Proof (LE X)) -> (_ : Proof (LE Y)) -> (e : Elem (OrderIso X Y)) -> (x2 : Elem X) -> (y : Elem X) -> Proof (iff (Leq (e x2) (e y)) (Leq x2 y)).

(; //LEAN:OrderIso.lt_iff_lt ;)
OrderIso__lt_iff_lt : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (e : Elem (OrderIso X Y)) -> (x2 : Elem X) -> (y : Elem X) -> Proof (iff (Lt (e x2) (e y)) (Lt x2 y)).

(; doc: Inverse of an order isomorphism. ;)
(; //LEAN:OrderIso.symm ;)
OrderIso__symm : (X : Set) -> (Y : Set) -> (e : Elem (OrderIso X Y)) -> Elem (OrderIso Y X).

(; //LEAN:OrderIso.symm_apply_apply ;)
OrderIso__symm_apply_apply : (X : Set) -> (Y : Set) -> (_ : Proof (LE X)) -> (_ : Proof (LE Y)) -> (e : Elem (OrderIso X Y)) -> (x2 : Elem X) -> Proof (Eqt X (OrderIso__symm__app e (e x2)) x2).

(; doc: Makes a Galois connection from an order-preserving bijection. ;)
(; //LEAN:OrderIso.to_galoisConnection ;)
OrderIso__to_galoisConnection : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (e : Elem (OrderIso X Y)) -> Proof (GaloisConnection X Y e (OrderIso__symm X Y e)).

(; doc: Reinterpret a real number `r` as a non-negative real number. Returns `0` if `r < 0`. ;)
(; //LEAN:Real.toNNReal ;)
Real__toNNReal : (r : Elem Real) -> Elem NNReal.

(; //LEAN:RelIso.toEquiv ;)
RelIso__toEquiv : (X : Set) -> (Y : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (s : (Elem Y -> Elem Y -> Prop)) -> (self : Elem (RelIso X Y r s)) -> Elem (Equiv X Y).

(; doc: `Ici a` is the left-closed right-infinite interval $[a, ∞)$. ;)
(; //LEAN:Set.Ici ;)
Set__Ici : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: A function `f` is strictly monotone on `s` if, for all `a, b ∈ s`, `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMonoOn ;)
StrictMonoOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A topology on `X`. ;)
(; //LEAN:TopologicalSpace ;)
TopologicalSpace : (X : Set) -> Prop.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (r : (Elem X -> Elem Y -> Set)) -> (s : (Elem Y -> Elem Z -> Set)) -> (t : (Elem X -> Elem Z -> Set)) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Z) -> (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; //LEAN:ZeroHom.mk ;)
ZeroHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_zero' : Proof (Eqt N (toFun 0) 0)) -> Elem (ZeroHom M N).

(; doc: `abs a`, denoted `|a|`, is the absolute value of `a` ;)
(; //LEAN:abs ;)
abs : (X : Set) -> (a : Elem X) -> Elem X.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (a1 : Elem X) -> (a2 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f a1) (f a2)).

(; //LEAN:eq_comm ;)
eq_comm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a b) (Eqt X b a)).

(; //LEAN:even_two_mul ;)
even_two_mul : (X : Set) -> (_ : Proof (Semiring X)) -> (a : Elem X) -> Proof (even (times 2 a)).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:le_iff_le_iff_lt_iff_lt ;)
le_iff_le_iff_lt_iff_lt : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> (d : Elem Y) -> Proof (iff (iff (Leq a b) (Leq c d)) (iff (Lt b a) (Lt d c))).

(; //LEAN:lt_iff_lt_of_le_iff_le ;)
lt_iff_lt_of_le_iff_le : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (LinearOrder Y)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> (d : Elem Y) -> (H : Proof (iff (Leq a b) (Leq c d))) -> Proof (iff (Lt b a) (Lt d c)).

(; //LEAN:map_div₀ ;)
map_div_u2080_ : (X : Set) -> (X1 : Set) -> (F : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (GroupWithZero X1)) -> (f : Elem F) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X1 (f (div a b)) (div (f a) (f b))).

(; doc: A monoid homomorphism between groups with zeros sending `0` to `0` sends `a⁻¹` to `(f a)⁻¹`. ;)
(; //LEAN:map_inv₀ ;)
map_inv_u2080_ : (X : Set) -> (X1 : Set) -> (F : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (GroupWithZero X1)) -> (f : Elem F) -> (a : Elem X) -> Proof (Eqt X1 (f (Inv__inv X a)) (Inv__inv X1 (f a))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:mul_self_inj_of_nonneg ;)
mul_self_inj_of_nonneg : (X : Set) -> (_ : Proof (CommRing X)) -> (_ : Proof (NoZeroDivisors X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (IsStrictOrderedRing X)) -> (a : Elem X) -> (b : Elem X) -> (a0 : Proof (Leq 0 a)) -> (b0 : Proof (Leq 0 b)) -> Proof (iff (Eqt X (times a a) (times b b)) (Eqt X a b)).

(; //LEAN:mul_self_nonneg ;)
mul_self_nonneg : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (ExistsAddOfLE R)) -> (a : Elem R) -> Proof (Leq 0 (times a a)).

(; doc: A set is called a neighborhood of `x` if it contains an open set around `x`. The set of all neighborhoods of `x` forms a filter, the neighborhood filter at `x`, is here defined as the infimum over the principal filters of all open sets containing `x`.  [Wikidata Q3275652](https://www.wikidata.org/wiki/Q3275652) ;)
(; //LEAN:nhds ;)
nhds : (X : Set) -> (x1 : Elem X) -> Elem (Filter X).

(; doc: The "neighborhood within" filter. Elements of `𝓝[s] x` are sets containing the intersection of `s` and a neighborhood of `x`. ;)
(; //LEAN:nhdsWithin ;)
nhdsWithin : (X : Set) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> Elem (Filter X).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; //LEAN:sq_nonneg ;)
sq_nonneg : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (ExistsAddOfLE R)) -> (a : Elem R) -> Proof (Leq 0 (pow a 2)).

(; doc: See `zero_lt_one'` for a version with the type explicit. ;)
(; //LEAN:zero_lt_one ;)
zero_lt_one : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> Proof (Lt 0 1).

