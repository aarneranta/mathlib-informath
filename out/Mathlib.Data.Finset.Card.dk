  X => p => H => S => Finset__strongInduction X p (forallI (Finset X) (S1 => if (forall (Finset X) (t2 => if (HasSSubset__SSubset (Finset X) t2 S1) (p t2))) (p S1)) (S1 => ifI (forall (Finset X) (t1 => if (HasSSubset__SSubset (Finset X) t1 S1) (p t1))) (p S1) (ih => ifE (forall X (s1 => if (Membership__mem X (Finset X) S1 s1) (p (Finset__erase X S1 s1)))) (p S1) (forallE (Finset X) (S2 => if (forall X (s => if (Membership__mem X (Finset X) S2 s) (p (Finset__erase X S2 s)))) (p S2)) H S1) (forallI X (x1 => if (Membership__mem X (Finset X) S1 x1) (p (Finset__erase X S1 x1))) (x1 => ifI (Membership__mem X (Finset X) S1 x1) (p (Finset__erase X S1 x1)) (hs => ifE (HasSSubset__SSubset (Finset X) (Finset__erase X S1 x1) S1) (p (Finset__erase X S1 x1)) (forallE (Finset X) (t => if (HasSSubset__SSubset (Finset X) t S1) (p t)) ih (Finset__erase X S1 x1)) (Finset__erase_ssubset X x1 S1 hs))))))) S.

(; //LEAN:Finset.image_iterate_stabilises_lt_card ;)
Finset__image_iterate_stabilises_lt_card : (X : Set) -> (f : (Elem X -> X)) -> (s : Elem (Finset X)) -> (hs : Proof (Set__MapsTo X X f (SetLike__coe (Finset X) X s) (SetLike__coe (Finset X) X s))) -> (h : Proof (Finset__Nonempty X s)) -> Proof (exists Nat (n => and (Lt n (Finset__card X s)) (forall Nat (m => if (Leq n m) (Eqt (Finset X) (Finset__image X X (Nat__iterate X f m) s) (Finset__image X X (Nat__iterate X f n) s)))))).

(; //LEAN:Finset.image_iterate_stabilises_le_card ;)
Finset__image_iterate_stabilises_le_card : (X : Set) -> (f : (Elem X -> X)) -> (s : Elem (Finset X)) -> (hs : Proof (Set__MapsTo X X f (SetLike__coe (Finset X) X s) (SetLike__coe (Finset X) X s))) -> Proof (exists Nat (n => and (Leq n (Finset__card X s)) (forall Nat (m => if (Leq n m) (Eqt (Finset X) (Finset__image X X (Nat__iterate X f m) s) (Finset__image X X (Nat__iterate X f n) s)))))).

