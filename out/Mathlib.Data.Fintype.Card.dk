Fintype__induction_subsingleton_or_nontrivial : (P : ((X3 : Set) -> Proof (Fintype X3) -> Prop)) -> (X : Set) -> (_ : Proof (Fintype X)) -> (hbase : Proof (forall Set (X2 => forall (Fintype X2) (x3 => if (Subsingleton X2) (P X2 x3))))) -> (hstep : Proof (forall Set (X1 => forall (Fintype X1) (x1 => if (Nontrivial X1) (if (forall Set (Y => forall (Fintype Y) (x2 => if (Lt (Fintype__card Y) (Fintype__card X1)) (P Y x2)))) (P X1 x1)))))) -> Proof (P X x).

(; //LEAN:Fintype.card_fin ;)
def Fintype__card_fin : (n : Elem Nat) -> Proof (Eq (Fintype__card (Fin n)) n) :=
  n => List__length_finRange n.

(; //LEAN:Fintype.card_fin_lt_of_le ;)
Fintype__card_fin_lt_of_le : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Leq m n)) -> Proof (Eq (Fintype__card (Subtype (Fin n) (i => Lt (Fin__val n i) m))) m).

(; //LEAN:Finset.card_fin ;)
Finset__card_fin : (n : Elem Nat) -> Proof (Eq (Finset__card (Fin n) (Finset__univ (Fin n))) n).

(; //LEAN:fin_injective ;)
def fin_injective : Proof (Function__Injective Nat Set Fin) :=
  forallI Nat (m => forall Nat (n1 => if (Eqt Set (Fin m) (Fin n1)) (Eq m n1))) (m => forallI Nat (n => if (Eqt Set (Fin m) (Fin n)) (Eq m n)) (n => ifI (Eqt Set (Fin m) (Fin n)) (Eq m n) (h => Eq__trans Nat m (Fintype__card (Fin m)) n (Eq__symm Nat (Fintype__card (Fin m)) m (Fintype__card_fin m)) (Eq__trans Nat (Fintype__card (Fin m)) (Fintype__card (Fin n)) n (Fintype__card_congr (Fin m) (Fin n) (Equiv__cast (Fin m) (Fin n) h)) (Fintype__card_fin n))))).

(; //LEAN:Fin.val_eq_val_of_heq ;)
def Fin__val_eq_val_of_heq : (k : Elem Nat) -> (l : Elem Nat) -> (i : Elem (Fin k)) -> (j : Elem (Fin l)) -> (h : Proof (HEq (Fin k) i (Fin l) j)) -> Proof (Eq (Fin__val k i) (Fin__val l j)) :=
  k => l => i => j => h => iffEl (HEq (Fin k) i (Fin l) j) (Eq (Fin__val k i) (Fin__val l j)) (Fin__heq_ext_iff k l (fin_injective k l (type_eq_of_heq (Fin k) (Fin l) i j h)) i j) h.

(; //LEAN:Fin.cast_eq_cast' ;)
Fin__cast_eq_cast' : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Eqt Set (Fin n) (Fin m))) -> Proof (Eqt (Elem (Fin n) -> Fin m) (cast (Fin n) (Fin m) h) (Fin__cast n m (fin_injective n m h))).

(; //LEAN:card_finset_fin_le ;)
card_finset_fin_le : (n : Elem Nat) -> (s : Elem (Finset (Fin n))) -> Proof (Leq (Finset__card (Fin n) s) n).

