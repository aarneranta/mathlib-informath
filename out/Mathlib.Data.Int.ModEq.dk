  a => b => Int__modEq_of_dvd 1 a b (one_dvd Int (minus b a)).

(; //LEAN:Int.modEq_sub ;)
def Int__modEq_sub : (a : Elem Int) -> (b : Elem Int) -> Proof (Int__ModEq (minus a b) a b) :=
  a => b => Int__ModEq__symm (minus a b) b a (Int__modEq_of_dvd (minus a b) b a (dvd_rfl Int (minus a b))).

(; //LEAN:Int.modEq_zero_iff ;)
Int__modEq_zero_iff : (a : Elem Int) -> (b : Elem Int) -> Proof (iff (Int__ModEq 0 a b) (Eq a b)).

(; //LEAN:Int.add_modEq_left ;)
Int__add_modEq_left : (n : Elem Int) -> (a : Elem Int) -> Proof (Int__ModEq n (plus n a) a).

(; //LEAN:Int.add_modEq_right ;)
Int__add_modEq_right : (n : Elem Int) -> (a : Elem Int) -> Proof (Int__ModEq n (plus a n) a).

(; //LEAN:Int.modEq_and_modEq_iff_modEq_lcm ;)
Int__modEq_and_modEq_iff_modEq_lcm : (a : Elem Int) -> (b : Elem Int) -> (m : Elem Int) -> (n : Elem Int) -> Proof (iff (and (Int__ModEq m a b) (Int__ModEq n a b)) (Int__ModEq (Int__lcm m n) a b)).

(; //LEAN:Int.modEq_and_modEq_iff_modEq_mul ;)
Int__modEq_and_modEq_iff_modEq_mul : (a : Elem Int) -> (b : Elem Int) -> (m : Elem Int) -> (n : Elem Int) -> (hmn : Proof (Nat__Coprime (Int__natAbs m) (Int__natAbs n))) -> Proof (iff (and (Int__ModEq m a b) (Int__ModEq n a b)) (Int__ModEq (times m n) a b)).

(; //LEAN:Int.gcd_a_modEq ;)
Int__gcd_a_modEq : (a : Elem Nat) -> (b : Elem Nat) -> Proof (Int__ModEq b (times a (Nat__gcdA a b)) (gcd a b)).

(; //LEAN:Int.modEq_add_fac_self ;)
Int__modEq_add_fac_self : (a : Elem Int) -> (t : Elem Int) -> (n : Elem Int) -> Proof (Int__ModEq n (plus a (times n t)) a).

(; //LEAN:Int.mod_coprime ;)
def Int__mod_coprime : (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Nat__Coprime a b)) -> Proof (exists Int (y => Int__ModEq b (times a y) 1)) :=
  a => b => hab => existsI Int (y => Int__ModEq b (times a y) 1) (Nat__gcdA a b) (Trans__trans (of_eq_true (Int__ModEq b (times a (Nat__gcdA a b)) (plus (times a (Nat__gcdA a b)) (times b (Nat__gcdB a b)))) (Eq__trans Prop (Int__ModEq b (times a (Nat__gcdA a b)) (plus (times a (Nat__gcdA a b)) (times b (Nat__gcdB a b)))) (divide b (times b (Nat__gcdB a b))) True (Int__left_modEq_add_iff___simp_1 b (times a (Nat__gcdA a b)) (times b (Nat__gcdB a b))) (dvd_mul_right___simp_1 Int b (Nat__gcdB a b)))) (Eq__mpr (id (congrArg Int Prop (plus (times a (Nat__gcdA a b)) (times b (Nat__gcdB a b))) (gcd a b) (_a => Int__ModEq b _a 1) (Eq__symm Int (gcd a b) (plus (times a (Nat__gcdA a b)) (times b (Nat__gcdB a b))) (Nat__gcd_eq_gcd_ab a b)))) (Eq__mpr (id (congrArg Nat Prop (gcd a b) 1 (_a1 => Int__ModEq b _a1 1) (Nat__Coprime__gcd_eq_one a b hab))) (Eq__refl (HMod__hMod 1 b))))).

(; //LEAN:Int.existsUnique_equiv ;)
def Int__existsUnique_equiv : (a : Elem Int) -> (b : Elem Int) -> (hb : Proof (Lt 0 b)) -> Proof (exists Int (z => and (Leq 0 z) (and (Lt z b) (Int__ModEq b z a)))) :=
  a => b => hb => existsI Int (z => and (Leq 0 z) (and (Lt z b) (Int__ModEq b z a))) (HMod__hMod a b) (andI (Leq 0 (HMod__hMod a b)) (and (Lt (HMod__hMod a b) b) (Int__ModEq b (HMod__hMod a b) a)) (Int__emod_nonneg a b (ne_of_gt Int b 0 hb)) (andI (Lt (HMod__hMod a b) b) (Int__ModEq b (HMod__hMod a b) a) (Eq__mp (congrArg Int Prop (abs b) b (_a => Lt (HMod__hMod a b) _a) (abs_of_pos Int b hb)) (Int__emod_lt_abs a b (ne_of_gt Int b 0 hb))) (of_eq_true (Eq (HMod__hMod (HMod__hMod a b) b) (HMod__hMod a b)) (Eq__trans Prop (Eq (HMod__hMod (HMod__hMod a b) b) (HMod__hMod a b)) (Eq (HMod__hMod a b) (HMod__hMod a b)) True (congrFun' Int Prop (Eq (HMod__hMod (HMod__hMod a b) b)) (Eq (HMod__hMod a b)) (congrArg Int (Elem Int -> Prop) (HMod__hMod (HMod__hMod a b) b) (HMod__hMod a b) Eq (Int__emod_emod_of_dvd a b b (of_eq_true (divide b b) (dvd_refl___simp_1 Int b)))) (HMod__hMod a b)) (eq_self Int (HMod__hMod a b)))))).

(; //LEAN:Int.existsUnique_equiv_nat ;)
Int__existsUnique_equiv_nat : (a : Elem Int) -> (b : Elem Int) -> (hb : Proof (Lt 0 b)) -> Proof (exists Nat (z => and (Lt z b) (Int__ModEq b z a))).

(; //LEAN:Int.mod_mul_right_mod ;)
def Int__mod_mul_right_mod : (a : Elem Int) -> (b : Elem Int) -> (c : Elem Int) -> Proof (Eq (HMod__hMod (HMod__hMod a (times b c)) b) (HMod__hMod a b)) :=
  a => b => c => Int__ModEq__of_mul_right b (HMod__hMod a (times b c)) a c (Int__mod_modEq a (times b c)).

(; //LEAN:Int.mod_mul_left_mod ;)
def Int__mod_mul_left_mod : (a : Elem Int) -> (b : Elem Int) -> (c : Elem Int) -> Proof (Eq (HMod__hMod (HMod__hMod a (times b c)) c) (HMod__hMod a c)) :=
  a => b => c => Int__ModEq__of_mul_left c (HMod__hMod a (times b c)) a b (Int__mod_modEq a (times b c)).

(; //LEAN:Int.ext_ediv_modEq ;)
def Int__ext_ediv_modEq : (n : Elem Int) -> (a : Elem Int) -> (b : Elem Int) -> (h0 : Proof (Eq (div a n) (div b n))) -> (h1 : Proof (Int__ModEq n a b)) -> Proof (Eq a b) :=
  n => a => b => h0 => h1 => Int__ext_ediv_emod n a b h0 h1.

(; //LEAN:Int.ext_ediv_modEq_iff ;)
def Int__ext_ediv_modEq_iff : (n : Elem Int) -> (a : Elem Int) -> (b : Elem Int) -> Proof (iff (Eq a b) (and (Eq (div a n) (div b n)) (Int__ModEq n a b))) :=
  n => a => b => Int__ext_ediv_emod_iff n a b.

(; //LEAN:Int.modEq_iff_eq_of_div_eq ;)
Int__modEq_iff_eq_of_div_eq : (n : Elem Int) -> (a : Elem Int) -> (b : Elem Int) -> (h : Proof (Eq (div a n) (div b n))) -> Proof (iff (Int__ModEq n a b) (Eq a b)).

