(; constants used by Mathlib.Data.Nat.Factorization.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Nat__factorization__app : (a1 : Elem Nat) -> (a2 : Elem Nat) -> Elem Nat.

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; doc: A commutative monoid is a monoid with commutative `(*)`. ;)
(; //LEAN:CommMonoid ;)
CommMonoid : (M : Set) -> Prop.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (x : Set) -> Set.

(; doc: The finset $[a, b]$ of elements `x` such that `a ≤ x` and `x ≤ b`. Basically `Set.Icc a b` as a finset. ;)
(; //LEAN:Finset.Icc ;)
Finset__Icc : (a : Elem x) -> (b : Elem x) -> Elem (Finset x).

(; doc: The finset $[a, b)$ of elements `x` such that `a ≤ x` and `x < b`. Basically `Set.Ico a b` as a finset. ;)
(; //LEAN:Finset.Ico ;)
Finset__Ico : (a : Elem x) -> (b : Elem x) -> Elem (Finset x).

(; doc: The finset $(a, b]$ of elements `x` such that `a < x` and `x ≤ b`. Basically `Set.Ioc a b` as a finset. ;)
(; //LEAN:Finset.Ioc ;)
Finset__Ioc : (a : Elem x) -> (b : Elem x) -> Elem (Finset x).

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (s : Elem (Finset x)) -> Elem Nat.

(; doc: `Finset.filter p s` is the set of elements of `s` that satisfy `p`.  For example, one can use `s.filter (· ∈ t)` to get the intersection of `s` with `t : Set α` as a `Finset α` (when a `DecidablePred (· ∈ t)` instance is available). ;)
(; //LEAN:Finset.filter ;)
Finset__filter : (p : (Elem x -> Prop)) -> (s : Elem (Finset x)) -> Elem (Finset x).

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (s : Elem (Finset x)) -> (f : (Elem x -> M)) -> Elem M.

(; doc: `range n` is the set of natural numbers less than `n`. ;)
(; //LEAN:Finset.range ;)
Finset__range : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (s : Elem (Finset x)) -> (f : (Elem x -> M)) -> Elem M.

(; doc: `univ` is the universal finite set of type `Finset α` implied from the assumption `Fintype α`. ;)
(; //LEAN:Finset.univ ;)
Finset__univ : Elem (Finset x).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (x : Set) -> (M : Set) -> Set.

(; doc: `erase a f` is the finitely supported function equal to `f` except at `a` where it is equal to `0`. If `a` is not in the support of `f` then `erase a f = f`. ;)
(; //LEAN:Finsupp.erase ;)
Finsupp__erase : (a : Elem x) -> (f : Elem (Finsupp x M)) -> Elem (Finsupp x M).

(; doc: `prod f g` is the product of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.prod ;)
Finsupp__prod : (f : Elem (Finsupp x M)) -> (g : (Elem x -> Elem M -> N)) -> Elem N.

(; doc: `single a b` is the finitely supported function with value `b` at `a` and zero otherwise. ;)
(; //LEAN:Finsupp.single ;)
Finsupp__single : (a : Elem x) -> (b : Elem M) -> Elem (Finsupp x M).

(; doc: Given functions `f : β → β → φ` and `g : α → β`, produce a function `α → α → φ` that evaluates `g` on each argument, then applies `f` to the results. Can be used, e.g., to transfer a relation from `β` to `α`. ;)
(; //LEAN:Function.onFun ;)
Function__onFun : (f : (Elem x1 -> Elem x1 -> x2)) -> (g : (Elem x -> x1)) -> (x3 : Elem x) -> (x4 : Elem x) -> Elem x2.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (x1 : Elem x) -> (x2 : Elem x) -> Elem x.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x2 : Elem x1) -> (x3 : Elem x) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x1 : Elem x) -> (x2 : Elem x) -> Elem x.

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; doc: `n.factorization` is the finitely supported function `ℕ →₀ ℕ` mapping each prime factor of `n` to its multiplicity in `n`. ;)
(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; doc: The least common multiple of `m` and `n` is the smallest natural number that's evenly divisible by both `m` and `n`. Returns `0` if either `m` or `n` is `0`.  Examples:  * `Nat.lcm 9 6 = 18`  * `Nat.lcm 9 3 = 9`  * `Nat.lcm 0 3 = 0`  * `Nat.lcm 3 0 = 0` ;)
(; //LEAN:Nat.lcm ;)
Nat__lcm : (m : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

(; doc: The prime factors of a natural number as a finset. ;)
(; //LEAN:Nat.primeFactors ;)
Nat__primeFactors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `primeFactorsList n` is the prime factorization of `n`, listed in increasing order. ;)
(; //LEAN:Nat.primeFactorsList ;)
Nat__primeFactorsList : (x : Elem Nat) -> Elem (List Nat).

(; doc: A relation `r` holds pairwise if `r i j` for all `i ≠ j`. ;)
(; //LEAN:Pairwise ;)
Pairwise : (r : (Elem x -> Elem x -> Prop)) -> Prop.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (a : Elem x) -> (b : Elem x) -> Elem (powerset x).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem x -> Prop)) -> Elem (powerset x).

(; doc: For `p ≠ 1`, the `p`-adic valuation of a natural `n ≠ 0` is the largest natural number `k` such that `p^k` divides `n`. If `n = 0` or `p = 1`, then `padicValNat p n` defaults to `0`. ;)
(; //LEAN:padicValNat ;)
padicValNat : (p : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

