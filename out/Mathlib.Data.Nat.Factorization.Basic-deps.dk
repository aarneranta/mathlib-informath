(; constants used by Mathlib.Data.Nat.Factorization.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Nat__factorization__app : (a1 : Elem Nat) -> (a2 : Elem Nat) -> Elem Nat.

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; doc: A commutative monoid is a monoid with commutative `(*)`. ;)
(; //LEAN:CommMonoid ;)
CommMonoid : (M : Set) -> Prop.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Eqt X a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: **Alias** of the forward direction of `even_iff_two_dvd`. ;)
(; //LEAN:Even.two_dvd ;)
Even__two_dvd : (X : Set) -> (_ : Proof (Semiring X)) -> (a : Elem X) -> (h : Proof (even a)) -> Proof (divide 2 a).

(; doc: `FiniteMultiplicity a b` indicates that the multiplicity of `a` in `b` is finite. ;)
(; //LEAN:FiniteMultiplicity ;)
FiniteMultiplicity : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:FiniteMultiplicity.exists_eq_pow_mul_and_not_dvd ;)
FiniteMultiplicity__exists_eq_pow_mul_and_not_dvd : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> (b : Elem X) -> (hfin : Proof (FiniteMultiplicity X a b)) -> Proof (exists X (c => and (Eqt X b (times (pow a (multiplicity X a b)) c)) (not (divide a c)))).

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: The finset $[a, b]$ of elements `x` such that `a ≤ x` and `x ≤ b`. Basically `Set.Icc a b` as a finset. ;)
(; //LEAN:Finset.Icc ;)
Finset__Icc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (Finset X).

(; doc: The finset $[a, b)$ of elements `x` such that `a ≤ x` and `x < b`. Basically `Set.Ico a b` as a finset. ;)
(; //LEAN:Finset.Ico ;)
Finset__Ico : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (Finset X).

(; doc: The finset $(a, b]$ of elements `x` such that `a < x` and `x ≤ b`. Basically `Set.Ioc a b` as a finset. ;)
(; //LEAN:Finset.Ioc ;)
Finset__Ioc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (Finset X).

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (X : Set) -> (s : Elem (Finset X)) -> Elem Nat.

(; doc: `Finset.filter p s` is the set of elements of `s` that satisfy `p`.  For example, one can use `s.filter (· ∈ t)` to get the intersection of `s` with `t : Set α` as a `Finset α` (when a `DecidablePred (· ∈ t)` instance is available). ;)
(; //LEAN:Finset.filter ;)
Finset__filter : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Finset X)) -> Elem (Finset X).

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `range n` is the set of natural numbers less than `n`. ;)
(; //LEAN:Finset.range ;)
Finset__range : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `univ` is the universal finite set of type `Finset α` implied from the assumption `Fintype α`. ;)
(; //LEAN:Finset.univ ;)
Finset__univ : (X : Set) -> Elem (Finset X).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (X : Set) -> (M : Set) -> Set.

(; doc: `erase a f` is the finitely supported function equal to `f` except at `a` where it is equal to `0`. If `a` is not in the support of `f` then `erase a f = f`. ;)
(; //LEAN:Finsupp.erase ;)
Finsupp__erase : (X : Set) -> (M : Set) -> (a : Elem X) -> (f : Elem (Finsupp X M)) -> Elem (Finsupp X M).

(; //LEAN:Finsupp.mem_support_iff ;)
Finsupp__mem_support_iff : (X : Set) -> (M : Set) -> (f : Elem (Finsupp X M)) -> (a : Elem X) -> Proof (iff (Membership__mem X (Finset X) (Finsupp__support X M f) a) (Neq (f a) 0)).

(; //LEAN:Finsupp.notMem_support_iff ;)
Finsupp__notMem_support_iff : (X : Set) -> (M : Set) -> (f : Elem (Finsupp X M)) -> (a : Elem X) -> Proof (iff (not (Membership__mem X (Finset X) (Finsupp__support X M f) a)) (Eqt M (f a) 0)).

(; doc: `prod f g` is the product of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.prod ;)
Finsupp__prod : (X : Set) -> (M : Set) -> (N : Set) -> (f : Elem (Finsupp X M)) -> (g : (Elem X -> Elem M -> N)) -> Elem N.

(; doc: `single a b` is the finitely supported function with value `b` at `a` and zero otherwise. ;)
(; //LEAN:Finsupp.single ;)
Finsupp__single : (X : Set) -> (M : Set) -> (a : Elem X) -> (b : Elem M) -> Elem (Finsupp X M).

(; doc: The support of a finitely supported function (aka `Finsupp`). ;)
(; //LEAN:Finsupp.support ;)
Finsupp__support : (X : Set) -> (M : Set) -> (self : Elem (Finsupp X M)) -> Elem (Finset X).

(; doc: Given functions `f : β → β → φ` and `g : α → β`, produce a function `α → α → φ` that evaluates `g` on each argument, then applies `f` to the results. Can be used, e.g., to transfer a relation from `β` to `α`. ;)
(; //LEAN:Function.onFun ;)
Function__onFun : (X : Set) -> (Y : Set) -> (X1 : Set) -> (f : (Elem Y -> Elem Y -> X1)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> (x1 : Elem X) -> Elem X1.

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h1 : Proof (iff a b)) -> (h2 : Proof (iff b c)) -> Proof (iff a c).

(; doc: **Alias** of `ne_of_gt`. ;)
(; //LEAN:LT.lt.ne' ;)
LT__lt__ne' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; doc: Linked lists: ordered lists, in which each element has a reference to the next element.  Most operations on linked lists take time proportional to the length of the list, because each element must be traversed to find the next element.  `List α` is isomorphic to `Array α`, but they are useful for different things: * `List α` is easier for reasoning, and `Array α` is modeled as a wrapper around `List α`. * `List α` works well as a persistent data structure, when many copies of the tail are shared. When   the value is not shared, `Array α` will have better performance because it can do destructive   updates. ;)
(; //LEAN:List ;)
List : (X : Set) -> Set.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; //LEAN:Nat.Prime.factorization_pos_of_dvd ;)
Nat__Prime__factorization_pos_of_dvd : (n : Elem Nat) -> (p : Elem Nat) -> (hp : Proof (prime p)) -> (hn : Proof (Neq n 0)) -> (h : Proof (divide p n)) -> Proof (Lt 0 (Nat__factorization__app n p)).

(; //LEAN:Nat.coprime_or_dvd_of_prime ;)
Nat__coprime_or_dvd_of_prime : (p : Elem Nat) -> (pp : Proof (prime p)) -> (i : Elem Nat) -> Proof (or (Nat__Coprime p i) (divide p i)).

(; //LEAN:Nat.div_dvd_of_dvd ;)
Nat__div_dvd_of_dvd : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (divide n m)) -> Proof (divide (div m n) m).

(; //LEAN:Nat.div_le_self ;)
Nat__div_le_self : (n : Elem Nat) -> (k : Elem Nat) -> Proof (Leq (div n k) n).

(; //LEAN:Nat.dvd_of_mem_primeFactorsList ;)
Nat__dvd_of_mem_primeFactorsList : (n : Elem Nat) -> (p : Elem Nat) -> (h : Proof (Membership__mem Nat (List Nat) (Nat__primeFactorsList n) p)) -> Proof (divide p n).

(; doc: `n.factorization` is the finitely supported function `ℕ →₀ ℕ` mapping each prime factor of `n` to its multiplicity in `n`. ;)
(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; //LEAN:Nat.finiteMultiplicity_iff ;)
Nat__finiteMultiplicity_iff : (a : Elem Nat) -> (b : Elem Nat) -> Proof (iff (FiniteMultiplicity Nat a b) (and (Neq a 1) (Lt 0 b))).

(; doc: The least common multiple of `m` and `n` is the smallest natural number that's evenly divisible by both `m` and `n`. Returns `0` if either `m` or `n` is `0`.  Examples:  * `Nat.lcm 9 6 = 18`  * `Nat.lcm 9 3 = 9`  * `Nat.lcm 0 3 = 0`  * `Nat.lcm 3 0 = 0` ;)
(; //LEAN:Nat.lcm ;)
Nat__lcm : (m : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.le_of_dvd ;)
Nat__le_of_dvd : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Lt 0 n)) -> (h1 : Proof (divide m n)) -> Proof (Leq m n).

(; //LEAN:Nat.le_of_mem_primeFactors ;)
Nat__le_of_mem_primeFactors : (n : Elem Nat) -> (p : Elem Nat) -> (h : Proof (Membership__mem Nat (Finset Nat) (Nat__primeFactors n) p)) -> Proof (Leq p n).

(; //LEAN:Nat.mem_primeFactors_iff_mem_primeFactorsList ;)
Nat__mem_primeFactors_iff_mem_primeFactorsList : (n : Elem Nat) -> (p : Elem Nat) -> Proof (iff (Membership__mem Nat (Finset Nat) (Nat__primeFactors n) p) (Membership__mem Nat (List Nat) (Nat__primeFactorsList n) p)).

(; //LEAN:Nat.mul_div_cancel' ;)
Nat__mul_div_cancel' : (n : Elem Nat) -> (m : Elem Nat) -> (H : Proof (divide n m)) -> Proof (Eq (times n (div m n)) m).

(; //LEAN:Nat.not_even_iff_odd ;)
Nat__not_even_iff_odd : (n : Elem Nat) -> Proof (iff (not (even n)) (odd n)).

(; //LEAN:Nat.ordProj_dvd ;)
Nat__ordProj_dvd : (n : Elem Nat) -> (p : Elem Nat) -> Proof (divide (pow p (Nat__factorization__app n p)) n).

(; //LEAN:Nat.pos_of_ne_zero ;)
Nat__pos_of_ne_zero : (n : Elem Nat) -> (h : Proof (Neq n 0)) -> Proof (Lt 0 n).

(; doc: The prime factors of a natural number as a finset. ;)
(; //LEAN:Nat.primeFactors ;)
Nat__primeFactors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `primeFactorsList n` is the prime factorization of `n`, listed in increasing order. ;)
(; //LEAN:Nat.primeFactorsList ;)
Nat__primeFactorsList : (x : Elem Nat) -> Elem (List Nat).

(; //LEAN:Nat.prod_factorization_pow_eq_self ;)
Nat__prod_factorization_pow_eq_self : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (Eq (Finsupp__prod Nat Nat Nat (Nat__factorization n) (x => x1 => pow x x1)) n).

(; //LEAN:Nat.succ_ne_self ;)
Nat__succ_ne_self : (n : Elem Nat) -> Proof (Neq (succ n) n).

(; //LEAN:Ne.bot_lt ;)
Ne__bot_lt : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (h : Proof (Neq a (Bot__bot X))) -> Proof (Lt (Bot__bot X) a).

(; doc: A relation `r` holds pairwise if `r i j` for all `i ≠ j`. ;)
(; //LEAN:Pairwise ;)
Pairwise : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (X : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> Prop.

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (a1 : Elem X) -> (a2 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f a1) (f a2)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; //LEAN:dvd_pow_self ;)
dvd_pow_self : (X : Set) -> (_ : Proof (Monoid X)) -> (a : Elem X) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (divide a (pow a n)).

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:mt ;)
mt : (a : Prop) -> (b : Prop) -> (h1 : Proof (if a b)) -> (h2 : Proof (not b)) -> Proof (not a).

(; doc: A `ℕ`-valued version of `emultiplicity`, returning `0` instead of `⊤`. ;)
(; //LEAN:multiplicity ;)
multiplicity : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem Nat.

(; //LEAN:not_le_of_gt ;)
not_le_of_gt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (not (Leq b a)).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:or_iff_left ;)
or_iff_left : (b : Prop) -> (a : Prop) -> (hb : Proof (not b)) -> Proof (iff (or a b) a).

(; doc: For `p ≠ 1`, the `p`-adic valuation of a natural `n ≠ 0` is the largest natural number `k` such that `p^k` divides `n`. If `n = 0` or `p = 1`, then `padicValNat p n` defaults to `0`. ;)
(; //LEAN:padicValNat ;)
padicValNat : (p : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

(; //LEAN:pow_one ;)
pow_one : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> Proof (Eqt M (pow a 1) a).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

