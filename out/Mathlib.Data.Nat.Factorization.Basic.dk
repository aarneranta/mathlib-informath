  n => hn => Eq__trans Nat n (Finsupp__prod (Nat__factorization n) (x => x1 => pow x x1)) (Finset__prod (Nat__primeFactors n) (p => pow p (Nat__factorization__app n p))) (Eq__symm Nat (Finsupp__prod (Nat__factorization n) (x2 => x3 => pow x2 x3)) n (Nat__prod_factorization_pow_eq_self n hn)) (Nat__prod_factorization_eq_prod_primeFactors n Nat (x4 => x5 => pow x4 x5)).

(; //LEAN:Nat.prod_primeFactors_coe_pow_factorization ;)
Nat__prod_primeFactors_coe_pow_factorization : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (Eq n (Finset__prod Finset__univ (p => pow p (Nat__factorization__app n p)))).

(; //LEAN:Nat.pairwise_coprime_pow_primeFactors_factorization ;)
Nat__pairwise_coprime_pow_primeFactors_factorization : (n : Elem Nat) -> Proof (Pairwise (Function__onFun Nat__Coprime (p => pow p (Nat__factorization__app n p)))).

(; //LEAN:Nat.dvd_prod_primeFactors_pow_self ;)
Nat__dvd_prod_primeFactors_pow_self : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (divide n (pow (Finset__prod (Nat__primeFactors n) (p => p)) n)).

(; //LEAN:Nat.dvd_pow_self_iff ;)
Nat__dvd_pow_self_iff : (n : Elem Nat) -> (k : Elem Nat) -> (hn : Proof (Neq n 0)) -> (hk : Proof (Neq k 0)) -> Proof (iff (divide n (pow k n)) (Leq (Nat__primeFactors n) (Nat__primeFactors k))).

(; //LEAN:Nat.exists_dvd_pow_iff ;)
Nat__exists_dvd_pow_iff : (n : Elem Nat) -> (k : Elem Nat) -> (hn : Proof (Neq n 0)) -> (hk : Proof (Neq k 0)) -> Proof (iff (exists Nat (m => divide n (pow k m))) (Leq (Nat__primeFactors n) (Nat__primeFactors k))).

(; //LEAN:Nat.card_multiples ;)
Nat__card_multiples : (n : Elem Nat) -> (p : Elem Nat) -> Proof (Eq (Finset__card (Finset__filter (e => divide p (plus e 1)) (Finset__range n))) (div n p)).

(; //LEAN:Nat.Ioc_filter_dvd_card_eq_div ;)
Nat__Ioc_filter_dvd_card_eq_div : (n : Elem Nat) -> (p : Elem Nat) -> Proof (Eq (Finset__card (Finset__filter (x => divide p x) (Finset__Ioc 0 n))) (div n p)).

(; //LEAN:Nat.card_multiples' ;)
Nat__card_multiples' : (N : Elem Nat) -> (n : Elem Nat) -> Proof (Eq (Finset__card (Finset__filter (k => and (Neq k 0) (divide n k)) (Finset__range (succ N)))) (div N n)).

(; //LEAN:Nat.exists_eq_pow_of_exponent_coprime_of_pow_eq_pow ;)
Nat__exists_eq_pow_of_exponent_coprime_of_pow_eq_pow : (a : Elem Nat) -> (b : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (hmn : Proof (Nat__Coprime m n)) -> (h : Proof (Eq (pow a m) (pow b n))) -> Proof (exists Nat (c => and (Eq a (pow c n)) (Eq b (pow c m)))).

(; //LEAN:Nat.exists_eq_pow_of_pow_eq_pow ;)
Nat__exists_eq_pow_of_pow_eq_pow : (a : Elem Nat) -> (b : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (hmn : Proof (or (Neq m 0) (Neq n 0))) -> (h : Proof (Eq (pow a m) (pow b n))) -> Proof (exists Nat (c => and (Eq a (pow c (div n (gcd m n)))) (Eq b (pow c (div m (gcd m n)))))).

