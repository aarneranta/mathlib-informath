(; constants used by Mathlib.Data.Nat.Factorization.Defs, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv PNat (Subtype (f => forall Nat (p => if (Membership__mem (Finsupp__support f) p) (prime p)))))) -> (a2 : Elem (Subtype (f1 => forall Nat (p1 => if (Membership__mem (Finsupp__support f1) p1) (prime p1))))) -> Elem PNat.

(; a constant applied as a function: DFunLike.coe ;)
Multiset__toFinsupp__app : (a1 : Elem (Multiset Nat)) -> Elem (Finsupp Nat Nat).

(; a constant applied as a function: DFunLike.coe ;)
Nat__factorizationEquiv__app : (a1 : Elem PNat) -> Elem (Subtype (f1 => forall Nat (p1 => if (Membership__mem (Finsupp__support f1) p1) (prime p1)))).

(; a constant applied as a function: DFunLike.coe ;)
Nat__factorization__app : (a1 : Elem Nat) -> (a2 : Elem Nat) -> Elem Nat.

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (x : Set) -> (x1 : Set) -> Set.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (x : Set) -> Set.

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (s : Elem (Finset x)) -> (f : (Elem x -> M)) -> Elem M.

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (s : Elem (Finset x)) -> (f : (Elem x -> M)) -> Elem M.

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (x : Set) -> (M : Set) -> Set.

(; doc: `prod f g` is the product of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.prod ;)
Finsupp__prod : (f : Elem (Finsupp x M)) -> (g : (Elem x -> Elem M -> N)) -> Elem N.

(; doc: `single a b` is the finitely supported function with value `b` at `a` and zero otherwise. ;)
(; //LEAN:Finsupp.single ;)
Finsupp__single : (a : Elem x) -> (b : Elem M) -> Elem (Finsupp x M).

(; doc: The support of a finitely supported function (aka `Finsupp`). ;)
(; //LEAN:Finsupp.support ;)
Finsupp__support : (self : Elem (Finsupp x M)) -> Elem (Finset x).

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x3 : Elem x) -> (x4 : Elem x1) -> Elem x2.

(; doc: The absolute value of an integer is its distance from `0`.  This function is overridden by the compiler with an efficient implementation. This definition is the logical model.  Examples:  * `(7 : Int).natAbs = 7`  * `(0 : Int).natAbs = 0`  * `(-11 : Int).natAbs = 11` ;)
(; //LEAN:Int.natAbs ;)
Int__natAbs : (m : Elem Int) -> Elem Nat.

(; doc: An element `a` of a type `α` with multiplication satisfies `IsSquare a` if `a = r * r`, for some root `r : α`.  [OEIS A000290](https://oeis.org/A000290) ;)
(; //LEAN:IsSquare ;)
IsSquare : (a : Elem x) -> Prop.

(; doc: A `ParserDescr` is a grammar for parsers. This is used by the `syntax` command to produce parsers without having to `import Lean`. ;)
(; //LEAN:Lean.ParserDescr ;)
Lean__ParserDescr : Set.

(; doc: Counts the number of times an element occurs in a list.  Examples: * `[1, 1, 2, 3, 5].count 1 = 2` * `[1, 1, 2, 3, 5].count 5 = 1` * `[1, 1, 2, 3, 5].count 4 = 0` ;)
(; //LEAN:List.count ;)
List__count : (a : Elem x) -> (x2 : Elem (List x)) -> Elem Nat.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x2 : Elem x1) -> (x3 : Elem x) -> Prop.

(; doc: `Multiset α` is the quotient of `List α` by list permutation. The result is a type of finite sets with duplicates allowed. ;)
(; //LEAN:Multiset ;)
Multiset : (x : Set) -> Set.

(; doc: The quotient map from `List α` to `Multiset α`. ;)
(; //LEAN:Multiset.ofList ;)
Multiset__ofList : (x1 : Elem (List x)) -> Elem (Multiset x).

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; //LEAN:Nat.factorizationEquiv.match_1 ;)
Nat__factorizationEquiv__match_1 : (motive : (Elem PNat -> Set)) -> (x : Elem PNat) -> (h_1 : ((n : Elem Nat) -> (h : Proof (Lt 0 n)) -> motive n)) -> Elem (motive x).

(; doc: Returns the smallest prime factor of `n ≠ 1`. ;)
(; //LEAN:Nat.minFac ;)
Nat__minFac : (n : Elem Nat) -> Elem Nat.

(; doc: The prime factors of a natural number as a finset. ;)
(; //LEAN:Nat.primeFactors ;)
Nat__primeFactors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `primeFactorsList n` is the prime factorization of `n`, listed in increasing order. ;)
(; //LEAN:Nat.primeFactorsList ;)
Nat__primeFactorsList : (x : Elem Nat) -> Elem (List Nat).

(; doc: `ℕ+` is the type of positive natural numbers. It is defined as a subtype, and the VM representation of `ℕ+` is the same as `ℕ` because the proof is not stored. ;)
(; //LEAN:PNat ;)
PNat : Set.

(; doc: `f` is injective on `s` if the restriction of `f` to `s` is injective. ;)
(; //LEAN:Set.InjOn ;)
Set__InjOn : (f : (Elem x -> x1)) -> (s : Elem (powerset x)) -> Prop.

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem x -> Prop)) -> Elem (powerset x).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem x -> Prop)) -> Set.

(; doc: A `ℕ`-valued version of `emultiplicity`, returning `0` instead of `⊤`. ;)
(; //LEAN:multiplicity ;)
multiplicity : (a : Elem x) -> (b : Elem x) -> Elem Nat.

(; doc: For `p ≠ 1`, the `p`-adic valuation of a natural `n ≠ 0` is the largest natural number `k` such that `p^k` divides `n`. If `n = 0` or `p = 1`, then `padicValNat p n` defaults to `0`. ;)
(; //LEAN:padicValNat ;)
padicValNat : (p : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

