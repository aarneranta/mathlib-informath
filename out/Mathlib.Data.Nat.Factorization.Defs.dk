(; Mathlib.Data.Nat.Factorization.Defs: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; //LEAN:Nat.support_factorization ;)
Nat__support_factorization : (n : Elem Nat) -> Proof (Eqt (Finset Nat) (Finsupp__support (Nat__factorization n)) (Nat__primeFactors n)).

(; //LEAN:Nat.primeFactorsList_count_eq ;)
Nat__primeFactorsList_count_eq : (n : Elem Nat) -> (p : Elem Nat) -> Proof (Eq (List__count p (Nat__primeFactorsList n)) (Nat__factorization__app n p)).

(; //LEAN:Nat.factorization_def ;)
Nat__factorization_def : (n : Elem Nat) -> (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Eq (Nat__factorization__app n p) (padicValNat p n)).

(; //LEAN:Nat.factorization_le_padicValNat ;)
Nat__factorization_le_padicValNat : (n : Elem Nat) -> (p : Elem Nat) -> Proof (Leq (Nat__factorization__app n p) (padicValNat p n)).

(; //LEAN:Nat.factorization_eq_primeFactorsList_multiset ;)
Nat__factorization_eq_primeFactorsList_multiset : (n : Elem Nat) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization n) (Multiset__toFinsupp__app (Multiset__ofList (Nat__primeFactorsList n)))).

(; //LEAN:Nat.Prime.factorization_pos_of_dvd ;)
Nat__Prime__factorization_pos_of_dvd : (n : Elem Nat) -> (p : Elem Nat) -> (hp : Proof (prime p)) -> (hn : Proof (Neq n 0)) -> (h : Proof (divide p n)) -> Proof (Lt 0 (Nat__factorization__app n p)).

(; //LEAN:Nat.multiplicity_eq_factorization ;)
Nat__multiplicity_eq_factorization : (n : Elem Nat) -> (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Eq (multiplicity p n) (Nat__factorization__app n p)).

(; //LEAN:Nat.prod_factorization_pow_eq_self ;)
Nat__prod_factorization_pow_eq_self : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (Eq (Finsupp__prod (Nat__factorization n) (x => x1 => pow x x1)) n).

(; //LEAN:Nat.eq_of_factorization_eq ;)
Nat__eq_of_factorization_eq : (a : Elem Nat) -> (b : Elem Nat) -> (ha : Proof (Neq a 0)) -> (hb : Proof (Neq b 0)) -> (h : Proof (forall Nat (p => Eq (Nat__factorization__app a p) (Nat__factorization__app b p)))) -> Proof (Eq a b).

(; //LEAN:Nat.eq_of_factorization_eq' ;)
Nat__eq_of_factorization_eq' : (a : Elem Nat) -> (b : Elem Nat) -> (ha : Proof (Neq a 0)) -> (hb : Proof (Neq b 0)) -> (h : Proof (Eqt (Finsupp Nat Nat) (Nat__factorization a) (Nat__factorization b))) -> Proof (Eq a b).

(; //LEAN:Nat.factorization_inj ;)
Nat__factorization_inj : Proof (Set__InjOn Nat__factorization (Set__ofPred (x => Neq x 0))).

(; //LEAN:Nat.factorization_zero ;)
Nat__factorization_zero : Proof (Eqt (Finsupp Nat Nat) (Nat__factorization 0) 0).

(; //LEAN:Nat.factorization_one ;)
Nat__factorization_one : Proof (Eqt (Finsupp Nat Nat) (Nat__factorization 1) 0).

(; //LEAN:Nat.factorization_eq_zero_iff ;)
Nat__factorization_eq_zero_iff : (n : Elem Nat) -> (p : Elem Nat) -> Proof (iff (Eq (Nat__factorization__app n p) 0) (or (not (prime p)) (or (not (divide p n)) (Eq n 0)))).

(; //LEAN:Nat.factorization_eq_zero_of_not_prime ;)
Nat__factorization_eq_zero_of_not_prime : (n : Elem Nat) -> (p : Elem Nat) -> (hp : Proof (not (prime p))) -> Proof (Eq (Nat__factorization__app n p) 0).

(; //LEAN:Nat.factorization_zero_right ;)
Nat__factorization_zero_right : (n : Elem Nat) -> Proof (Eq (Nat__factorization__app n 0) 0).

(; //LEAN:Nat.factorization_one_right ;)
Nat__factorization_one_right : (n : Elem Nat) -> Proof (Eq (Nat__factorization__app n 1) 0).

(; //LEAN:Nat.factorization_eq_zero_of_not_dvd ;)
Nat__factorization_eq_zero_of_not_dvd : (n : Elem Nat) -> (p : Elem Nat) -> (h : Proof (not (divide p n))) -> Proof (Eq (Nat__factorization__app n p) 0).

(; //LEAN:Nat.factorization_eq_zero_of_remainder ;)
Nat__factorization_eq_zero_of_remainder : (p : Elem Nat) -> (r : Elem Nat) -> (i : Elem Nat) -> (hr : Proof (not (divide p r))) -> Proof (Eq (Nat__factorization__app (plus (times p i) r) p) 0).

(; //LEAN:Nat.factorization_mul ;)
Nat__factorization_mul : (a : Elem Nat) -> (b : Elem Nat) -> (ha : Proof (Neq a 0)) -> (hb : Proof (Neq b 0)) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (times a b)) (plus (Nat__factorization a) (Nat__factorization b))).

(; //LEAN:Nat.factorization_le_iff_dvd ;)
Nat__factorization_le_iff_dvd : (d : Elem Nat) -> (n : Elem Nat) -> (hd : Proof (Neq d 0)) -> (hn : Proof (Neq n 0)) -> Proof (iff (Leq (Nat__factorization d) (Nat__factorization n)) (divide d n)).

(; //LEAN:Nat.factorization_prod ;)
Nat__factorization_prod : (x : Set) -> (S : Elem (Finset x)) -> (g : (Elem x -> Nat)) -> (hS : Proof (forall x (x3 => if (Membership__mem S x3) (Neq (g x3) 0)))) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (Finset__prod S (x1 => g x1))) (Finset__sum S (x2 => Nat__factorization (g x2)))).

(; //LEAN:Nat.factorization_pow ;)
Nat__factorization_pow : (n : Elem Nat) -> (k : Elem Nat) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (pow n k)) (HSMul__hSMul k (Nat__factorization n))).

(; //LEAN:Nat.isSquare_iff_even_factorization ;)
Nat__isSquare_iff_even_factorization : (n : Elem Nat) -> Proof (iff (IsSquare n) (forall Nat (p => if (prime p) (even (Nat__factorization__app n p))))).

(; //LEAN:Int.isSquare_iff_nonneg_even_factorization ;)
Int__isSquare_iff_nonneg_even_factorization : (n : Elem Int) -> Proof (iff (IsSquare n) (and (Leq 0 n) (forall Nat (p => if (prime p) (even (Nat__factorization__app (Int__natAbs n) p)))))).

(; //LEAN:Nat.Prime.factorization ;)
Nat__Prime__factorization : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization p) (Finsupp__single p 1)).

(; //LEAN:Nat.Prime.factorization_pow ;)
Nat__Prime__factorization_pow : (p : Elem Nat) -> (k : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (pow p k)) (Finsupp__single p k)).

(; //LEAN:Nat.pow_succ_factorization_not_dvd ;)
Nat__pow_succ_factorization_not_dvd : (n : Elem Nat) -> (p : Elem Nat) -> (hn : Proof (Neq n 0)) -> (hp : Proof (prime p)) -> Proof (not (divide (pow p (plus (Nat__factorization__app n p) 1)) n)).

(; //LEAN:Nat.factorization_minFac_ne_zero ;)
Nat__factorization_minFac_ne_zero : (n : Elem Nat) -> (hn : Proof (Lt 1 n)) -> Proof (Neq (Nat__factorization__app n (Nat__minFac n)) 0).

(; //LEAN:Nat.factorization_prod_pow_eq_self ;)
Nat__factorization_prod_pow_eq_self : (f : Elem (Finsupp Nat Nat)) -> (hf : Proof (forall Nat (p => if (Membership__mem (Finsupp__support f) p) (prime p)))) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (Finsupp__prod f (x => x1 => pow x x1))) f).

(; //LEAN:Nat.eq_factorization_iff ;)
Nat__eq_factorization_iff : (n : Elem Nat) -> (f : Elem (Finsupp Nat Nat)) -> (hn : Proof (Neq n 0)) -> (hf : Proof (forall Nat (p => if (Membership__mem (Finsupp__support f) p) (prime p)))) -> Proof (iff (Eqt (Finsupp Nat Nat) f (Nat__factorization n)) (Eq (Finsupp__prod f (x => x1 => pow x x1)) n)).

(; //LEAN:Nat.factorization_prod_pow_eq_self_of_le_factorization ;)
Nat__factorization_prod_pow_eq_self_of_le_factorization : (n : Elem Nat) -> (f : Elem (Finsupp Nat Nat)) -> (hf : Proof (Leq f (Nat__factorization n))) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (Finsupp__prod f (x => x1 => pow x x1))) f).

(; //LEAN:Nat.prod_pow_dvd_of_le_factorization ;)
Nat__prod_pow_dvd_of_le_factorization : (n : Elem Nat) -> (f : Elem (Finsupp Nat Nat)) -> (hf : Proof (Leq f (Nat__factorization n))) -> Proof (divide (Finsupp__prod f (x => x1 => pow x x1)) n).

(; //LEAN:Nat.dvd_prod_pow_of_factorization_le ;)
Nat__dvd_prod_pow_of_factorization_le : (n : Elem Nat) -> (f : Elem (Finsupp Nat Nat)) -> (hn : Proof (Neq n 0)) -> (hf : Proof (Leq (Nat__factorization n) f)) -> Proof (divide n (Finsupp__prod f (x => x1 => pow x x1))).

(; //LEAN:Nat.dvd_iff_exists_le_factorization ;)
Nat__dvd_iff_exists_le_factorization : (n : Elem Nat) -> (d : Elem Nat) -> (hd : Proof (Neq d 0)) -> (hn : Proof (Neq n 0)) -> Proof (iff (divide d n) (exists (Finsupp Nat Nat) (f => and (Leq f (Nat__factorization n)) (Eq d (Finsupp__prod f (x => x1 => pow x x1)))))).

(; //LEAN:Nat.factorizationEquiv ;)
Nat__factorizationEquiv : Elem (Equiv PNat (Subtype (f => forall Nat (p => if (Membership__mem (Finsupp__support f) p) (prime p))))).

(; //LEAN:Nat.factorizationEquiv_apply ;)
Nat__factorizationEquiv_apply : (x : Elem PNat) -> Proof (Eqt (Subtype (f => forall Nat (p => if (Membership__mem (Finsupp__support f) p) (prime p)))) (Nat__factorizationEquiv__app x) (Nat__factorizationEquiv__match_1 (x1 => Subtype (f2 => forall Nat (p2 => if (Membership__mem (Finsupp__support f2) p2) (prime p2)))) x (n => h3 => Nat__factorization n))).

(; //LEAN:Nat.factorizationEquiv_symm_apply_coe ;)
Nat__factorizationEquiv_symm_apply_coe : (x : Elem (Subtype (f2 => forall Nat (p2 => if (Membership__mem (Finsupp__support f2) p2) (prime p2))))) -> Proof (Eq (Equiv__symm__app Nat__factorizationEquiv x) (Finsupp__prod x (x1 => x2 => pow x1 x2))).

(; //LEAN:Nat.factorization_mul_apply_of_coprime ;)
Nat__factorization_mul_apply_of_coprime : (p : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Nat__Coprime a b)) -> Proof (Eq (Nat__factorization__app (times a b) p) (plus (Nat__factorization__app a p) (Nat__factorization__app b p))).

(; //LEAN:Nat.factorization_mul_of_coprime ;)
Nat__factorization_mul_of_coprime : (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Nat__Coprime a b)) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (times a b)) (plus (Nat__factorization a) (Nat__factorization b))).

(; //LEAN:Nat.«termOrdProj[_]_» ;)
Nat__termOrdProj_u5b___u5d__ : Elem Lean__ParserDescr.

(; //LEAN:Nat.«termOrdCompl[_]_» ;)
Nat__termOrdCompl_u5b___u5d__ : Elem Lean__ParserDescr.

(; //LEAN:Nat.ordProj_dvd ;)
Nat__ordProj_dvd : (n : Elem Nat) -> (p : Elem Nat) -> Proof (divide (pow p (Nat__factorization__app n p)) n).

(; //LEAN:Nat.ordProj_dvd_ordProj_iff_dvd ;)
Nat__ordProj_dvd_ordProj_iff_dvd : (a : Elem Nat) -> (b : Elem Nat) -> (ha : Proof (Neq a 0)) -> (hb : Proof (Neq b 0)) -> Proof (iff (forall Nat (p => divide (pow p (Nat__factorization__app a p)) (pow p (Nat__factorization__app b p)))) (divide a b)).

(; //LEAN:Nat.factorizationLCMLeft ;)
Nat__factorizationLCMLeft : (a : Elem Nat) -> (b : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.factorizationLCMRight ;)
Nat__factorizationLCMRight : (a : Elem Nat) -> (b : Elem Nat) -> Elem Nat.

