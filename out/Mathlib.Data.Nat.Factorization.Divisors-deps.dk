(; constants used by Mathlib.Data.Nat.Factorization.Divisors, declared with their translated types ;)

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (x : Set) -> Set.

(; doc: The finset $(-∞, b]$ of elements `x` such that `x ≤ b`. Basically `Set.Iic b` as a finset. ;)
(; //LEAN:Finset.Iic ;)
Finset__Iic : (a : Elem x) -> Elem (Finset x).

(; doc: The finset $(-∞, b)$ of elements `x` such that `x < b`. Basically `Set.Iio b` as a finset. ;)
(; //LEAN:Finset.Iio ;)
Finset__Iio : (a : Elem x) -> Elem (Finset x).

(; doc: `attach s` takes the elements of `s` and forms a new set of elements of the subtype `{x // x ∈ s}`. ;)
(; //LEAN:Finset.attach ;)
Finset__attach : (s : Elem (Finset x)) -> Elem (Finset (Subtype (x1 => Membership__mem s x1))).

(; doc: `image f s` is the forward image of `s` under `f`. ;)
(; //LEAN:Finset.image ;)
Finset__image : (f : (Elem x -> x1)) -> (s : Elem (Finset x)) -> Elem (Finset x1).

(; doc: When `f` is an embedding of `α` in `β` and `s` is a finset in `α`, then `s.map f` is the image finset in `β`. The embedding condition guarantees that there are no duplicates in the image. ;)
(; //LEAN:Finset.map ;)
Finset__map : (f : Elem (Function__Embedding x x1)) -> (s : Elem (Finset x)) -> Elem (Finset x1).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (x : Set) -> (M : Set) -> Set.

(; doc: `prod f g` is the product of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.prod ;)
Finsupp__prod : (f : Elem (Finsupp x M)) -> (g : (Elem x -> Elem M -> N)) -> Elem N.

(; //LEAN:Function.Embedding.mk ;)
Function__Embedding__mk : (toFun : (Elem x -> x1)) -> (inj' : Proof (Function__Injective toFun)) -> Elem (Function__Embedding x x1).

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem x -> x1)) -> Prop.

(; doc: `divisors n` is the `Finset` of divisors of `n`. By convention, we set `divisors 0 = ∅`. ;)
(; //LEAN:Nat.divisors ;)
Nat__divisors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `n.factorization` is the finitely supported function `ℕ →₀ ℕ` mapping each prime factor of `n` to its multiplicity in `n`. ;)
(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; doc: `properDivisors n` is the `Finset` of divisors of `n`, other than `n`. By convention, we set `properDivisors 0 = ∅`. ;)
(; //LEAN:Nat.properDivisors ;)
Nat__properDivisors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem x -> Prop)) -> Elem (powerset x).

