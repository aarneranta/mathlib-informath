Nat__prime_composite_induction : (motive : (Elem Nat -> Prop)) -> (zero : Proof (motive 0)) -> (one : Proof (motive 1)) -> (prime : Proof (forall Nat (p => if (prime p) (motive p)))) -> (composite : Proof (forall Nat (a => if (Leq 2 a) (if (motive a) (forall Nat (b => if (Leq 2 b) (if (motive b) (motive (times a b))))))))) -> (n : Elem Nat) -> Proof (motive n).

