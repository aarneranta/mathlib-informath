(; //LEAN:Nat.recOnPosPrimePosCoprime ;)
def Nat__recOnPosPrimePosCoprime : (prime_pow : ((p : Elem Nat) -> (n : Elem Nat) -> Proof (prime p) -> Proof (Lt 0 n) -> motive (pow p n))) -> (zero : Elem (motive 0)) -> (one : Elem (motive 1)) -> (coprime : ((a1 : Elem Nat) -> (b : Elem Nat) -> Proof (Lt 1 a1) -> Proof (Lt 1 b) -> Proof (Nat__Coprime a1 b) -> Elem (motive a1) -> Elem (motive b) -> motive (times a1 b))) -> (a : Elem Nat) -> Elem (motive a) :=
  prime_pow => zero => one => coprime => a => Nat__recOnPrimePow zero one (a1 => p => n => hp' => hpa => hn => hPa => dite (Eq a1 1) (ha1 => Eq__mpr (Nat__recOnPosPrimePosCoprime___proof_1 a1 p n ha1) (Eq__mpr (Nat__recOnPosPrimePosCoprime___proof_2 p n) (prime_pow p n hp' hn))) (ha11 => coprime (pow p n) a1 (Nat__recOnPosPrimePosCoprime___proof_3 p n hp' hn) (Nat__recOnPosPrimePosCoprime___proof_4 a1 p hpa ha11) (Nat__recOnPosPrimePosCoprime___proof_5 a1 p n hp' hpa hn) (prime_pow p n hp' hn) hPa)) a.

