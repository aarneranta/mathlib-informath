def Nat__recOnPrimeCoprime : (zero : Elem (motive 0)) -> (prime_pow : ((p : Elem Nat) -> (n : Elem Nat) -> Proof (prime p) -> motive (pow p n))) -> (coprime : ((a1 : Elem Nat) -> (b : Elem Nat) -> Proof (Lt 1 a1) -> Proof (Lt 1 b) -> Proof (Nat__Coprime a1 b) -> Elem (motive a1) -> Elem (motive b) -> motive (times a1 b))) -> (a : Elem Nat) -> Elem (motive a) :=
  zero => prime_pow => coprime => a => Nat__recOnPosPrimePosCoprime (p => n => h => h1 => prime_pow p n h) zero (prime_pow 2 0 Nat__prime_two) coprime a.

