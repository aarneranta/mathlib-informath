(; constants used by Mathlib.Data.Nat.Factorization.PrimePow, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv (Prod Nat__Primes Nat) (Subtype Nat (n1 => IsPrimePow Nat n1)))) -> (a2 : Elem (Subtype Nat (n2 => IsPrimePow Nat n2))) -> Elem (Prod Nat__Primes Nat).

(; a constant applied as a function: DFunLike.coe ;)
Nat__Primes__prodNatEquiv__app : (a1 : Elem (Prod Nat__Primes Nat)) -> Elem (Subtype Nat (n1 => IsPrimePow Nat n1)).

(; a constant applied as a function: DFunLike.coe ;)
Nat__factorization__app : (a1 : Elem Nat) -> (a2 : Elem Nat) -> Elem Nat.

(; //LEAN:Dvd.intro ;)
Dvd__intro : (X : Set) -> (_ : Proof (Semigroup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X (times a c) b)) -> Proof (divide a b).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: For `p : α → Prop`, `ExistsUnique p` means that there exists a unique `x : α` with `p x`. ;)
(; //LEAN:ExistsUnique ;)
ExistsUnique : (X : Set) -> (p : (Elem X -> Prop)) -> Prop.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: A finset is nontrivial if it has at least two elements. ;)
(; //LEAN:Finset.Nontrivial ;)
Finset__Nontrivial : (X : Set) -> (s : Elem (Finset X)) -> Prop.

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (X : Set) -> (s : Elem (Finset X)) -> Elem Nat.

(; doc: `Finset.filter p s` is the set of elements of `s` that satisfy `p`.  For example, one can use `s.filter (· ∈ t)` to get the intersection of `s` with `t : Set α` as a `Finset α` (when a `DecidablePred (· ∈ t)` instance is available). ;)
(; //LEAN:Finset.filter ;)
Finset__filter : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Finset X)) -> Elem (Finset X).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (X : Set) -> (M : Set) -> Set.

(; doc: `single a b` is the finitely supported function with value `b` at `a` and zero otherwise. ;)
(; //LEAN:Finsupp.single ;)
Finsupp__single : (X : Set) -> (M : Set) -> (a : Elem X) -> (b : Elem M) -> Elem (Finsupp X M).

(; doc: `n` is a prime power if there is a prime `p` and a positive natural `k` such that `n` can be written as `p^k`. ;)
(; //LEAN:IsPrimePow ;)
IsPrimePow : (R : Set) -> (n : Elem R) -> Prop.

(; //LEAN:IsPrimePow.ne_one ;)
IsPrimePow__ne_one : (R : Set) -> (_ : Proof (CommMonoidWithZero R)) -> (n : Elem R) -> (h : Proof (IsPrimePow R n)) -> Proof (Neq n 1).

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; doc: The type of prime numbers ;)
(; //LEAN:Nat.Primes ;)
Nat__Primes : Set.

(; //LEAN:Nat.Primes.prodNatEquiv._proof_1 ;)
Nat__Primes__prodNatEquiv___proof_1 : (pk : Elem (Prod Nat__Primes Nat)) -> Proof (exists Nat (p => exists Nat (k => and (Prime Nat p) (and (Lt 0 k) (Eq (pow p k) (pow (Subtype__val Nat (p1 => prime p1) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1))))))).

(; //LEAN:Nat.Primes.prodNatEquiv._proof_2 ;)
Nat__Primes__prodNatEquiv___proof_2 : (n : Elem (Subtype Nat (n2 => IsPrimePow Nat n2))) -> Proof (prime (Nat__minFac (Subtype__val Nat (n1 => IsPrimePow Nat n1) n))).

(; //LEAN:Nat.Primes.prodNatEquiv._proof_4 ;)
Nat__Primes__prodNatEquiv___proof_4 : (n : Elem (Subtype Nat (n10 => IsPrimePow Nat n10))) -> Proof (Eqt (Subtype Nat (n1 => IsPrimePow Nat n1)) ((pk => Subtype__mk Nat (n2 => IsPrimePow Nat n2) (pow (Subtype__val Nat (p => prime p) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)) (existsI Nat (p1 => exists Nat (k => and (Prime Nat p1) (and (Lt 0 k) (Eq (pow p1 k) (pow (Subtype__val Nat (p2 => prime p2) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)))))) (Subtype__val Nat (p3 => prime p3) (Prod__fst Nat__Primes Nat pk)) (existsI Nat (k1 => and (Prime Nat (Subtype__val Nat (p4 => prime p4) (Prod__fst Nat__Primes Nat pk))) (and (Lt 0 k1) (Eq (pow (Subtype__val Nat (p5 => prime p5) (Prod__fst Nat__Primes Nat pk)) k1) (pow (Subtype__val Nat (p6 => prime p6) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1))))) (plus (Prod__snd Nat__Primes Nat pk) 1) (andI (Prime Nat (Subtype__val Nat (p7 => prime p7) (Prod__fst Nat__Primes Nat pk))) (and (Lt 0 (plus (Prod__snd Nat__Primes Nat pk) 1)) (Eq (pow (Subtype__val Nat (p8 => prime p8) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)) (pow (Subtype__val Nat (p9 => prime p9) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)))) (iffEl (prime (Subtype__val Nat (p10 => prime p10) (Prod__fst Nat__Primes Nat pk))) (Prime Nat (Subtype__val Nat (p11 => prime p11) (Prod__fst Nat__Primes Nat pk))) (Nat__prime_iff (Subtype__val Nat (p12 => prime p12) (Prod__fst Nat__Primes Nat pk))) (Subtype__prop Nat (p13 => prime p13) (Prod__fst Nat__Primes Nat pk))) (andI (Lt 0 (plus (Prod__snd Nat__Primes Nat pk) 1)) (Eq (pow (Subtype__val Nat (p14 => prime p14) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)) (pow (Subtype__val Nat (p15 => prime p15) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1))) (Nat__add_one_pos (Prod__snd Nat__Primes Nat pk)) (rfl Nat (pow (Subtype__val Nat (p16 => prime p16) (Prod__fst Nat__Primes Nat pk)) (plus (Prod__snd Nat__Primes Nat pk) 1)))))))) ((n3 => Prod__mk Nat__Primes Nat (Subtype__mk Nat (p17 => prime p17) (Nat__minFac (Subtype__val Nat (n4 => IsPrimePow Nat n4) n3)) (Nat__minFac_prime (Subtype__val Nat (n5 => IsPrimePow Nat n5) n3) (IsPrimePow__ne_one Nat (Subtype__val Nat (n6 => IsPrimePow Nat n6) n3) (Subtype__prop Nat (n7 => IsPrimePow Nat n7) n3)))) (minus (Nat__factorization__app (Subtype__val Nat (n8 => IsPrimePow Nat n8) n3) (Nat__minFac (Subtype__val Nat (n9 => IsPrimePow Nat n9) n3))) 1)) n)) n).

(; //LEAN:Nat.Primes.prodNatEquiv._proof_6 ;)
Nat__Primes__prodNatEquiv___proof_6 : (x : Elem (Prod Nat__Primes Nat)) -> Proof (Eqt (Prod Nat__Primes Nat) (Prod__mk Nat__Primes Nat (Subtype__mk Nat (p => prime p) (Nat__minFac (Subtype__val Nat (n => IsPrimePow Nat n) (Subtype__mk Nat (n1 => IsPrimePow Nat n1) (pow (Subtype__val Nat (p1 => prime p1) (Prod__fst Nat__Primes Nat x)) (plus (Prod__snd Nat__Primes Nat x) 1)) (Nat__Primes__prodNatEquiv___proof_1 x)))) (Nat__Primes__prodNatEquiv___proof_5 x)) (minus (Nat__factorization__app (Subtype__val Nat (n2 => IsPrimePow Nat n2) (Subtype__mk Nat (n3 => IsPrimePow Nat n3) (pow (Subtype__val Nat (p2 => prime p2) (Prod__fst Nat__Primes Nat x)) (plus (Prod__snd Nat__Primes Nat x) 1)) (Nat__Primes__prodNatEquiv___proof_1 x))) (Nat__minFac (Subtype__val Nat (n4 => IsPrimePow Nat n4) (Subtype__mk Nat (n5 => IsPrimePow Nat n5) (pow (Subtype__val Nat (p3 => prime p3) (Prod__fst Nat__Primes Nat x)) (plus (Prod__snd Nat__Primes Nat x) 1)) (Nat__Primes__prodNatEquiv___proof_1 x))))) 1)) x).

(; //LEAN:Nat.add_one_pos ;)
Nat__add_one_pos : (n : Elem Nat) -> Proof (Lt 0 (plus n 1)).

(; doc: `divisors n` is the `Finset` of divisors of `n`. By convention, we set `divisors 0 = ∅`. ;)
(; //LEAN:Nat.divisors ;)
Nat__divisors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `n.factorization` is the finitely supported function `ℕ →₀ ℕ` mapping each prime factor of `n` to its multiplicity in `n`. ;)
(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; doc: Returns the smallest prime factor of `n ≠ 1`. ;)
(; //LEAN:Nat.minFac ;)
Nat__minFac : (n : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.minFac_prime ;)
Nat__minFac_prime : (n : Elem Nat) -> (n1 : Proof (Neq n 1)) -> Proof (prime (Nat__minFac n)).

(; doc: The prime factors of a natural number as a finset. ;)
(; //LEAN:Nat.primeFactors ;)
Nat__primeFactors : (n : Elem Nat) -> Elem (Finset Nat).

(; //LEAN:Nat.prime_iff ;)
Nat__prime_iff : (p : Elem Nat) -> Proof (iff (prime p) (Prime Nat p)).

(; doc: An element `p` of a commutative monoid with zero (e.g., a ring) is called *prime*, if it's not zero, not a unit, and `p ∣ a * b → p ∣ a ∨ p ∣ b` for all `a`, `b`. ;)
(; //LEAN:Prime ;)
Prime : (M : Set) -> (p : Elem M) -> Prop.

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.mk ;)
Subtype__mk : (X : Set) -> (p : (Elem X -> Prop)) -> (val : Elem X) -> (property : Proof (p val)) -> Elem (Subtype X (x => p x)).

(; doc: A version of `x.property` or `x.2` where `p` is syntactically applied to the coercion of `x` instead of `x.1`. A similar result is `Subtype.mem` in `Mathlib/Data/Set/Basic.lean`. ;)
(; //LEAN:Subtype.prop ;)
Subtype__prop : (X : Set) -> (p : (Elem X -> Prop)) -> (x : Elem (Subtype X (x1 => p x1))) -> Proof (p (Subtype__val X p x)).

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

