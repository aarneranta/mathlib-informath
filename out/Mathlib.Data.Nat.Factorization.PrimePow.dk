IsPrimePow__exists_ordCompl_eq_one : (n : Elem Nat) -> (h : Proof (IsPrimePow Nat n)) -> Proof (exists Nat (p => and (prime p) (Eq (div n (pow p (Nat__factorization__app n p))) 1))).

