(; //LEAN:isPrimePow_iff_factorization_eq_single ;)
isPrimePow_iff_factorization_eq_single : (n : Elem Nat) -> Proof (iff (IsPrimePow Nat n) (exists Nat (p => exists Nat (k => and (Lt 0 k) (Eqt (Finsupp Nat Nat) (Nat__factorization n) (Finsupp__single Nat Nat p k)))))).

