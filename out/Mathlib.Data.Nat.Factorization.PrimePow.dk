isPrimePow_iff_unique_prime_dvd : (n : Elem Nat) -> Proof (iff (IsPrimePow Nat n) (ExistsUnique Nat (p => and (prime p) (divide p n)))).

(; //LEAN:isPrimePow_pow_iff ;)
isPrimePow_pow_iff : (n : Elem Nat) -> (k : Elem Nat) -> (hk : Proof (Neq k 0)) -> Proof (iff (IsPrimePow Nat (pow n k)) (IsPrimePow Nat n)).

