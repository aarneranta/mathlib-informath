isPrimePow_iff_card_primeFactors_eq_one : (n : Elem Nat) -> Proof (iff (IsPrimePow Nat n) (Eq (Finset__card Nat (Nat__primeFactors n)) 1)).

(; //LEAN:Nat.not_isPrimePow_iff_nontrivial_of_two_le ;)
