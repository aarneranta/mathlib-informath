(; Mathlib.Data.Nat.Factorization.PrimePow: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:IsPrimePow.minFac_pow_factorization_eq ;)
IsPrimePow__minFac_pow_factorization_eq : (n : Elem Nat) -> (hn : Proof (IsPrimePow n)) -> Proof (Eq (pow (Nat__minFac n) (Nat__factorization__app n (Nat__minFac n))) n).

(; //LEAN:isPrimePow_of_minFac_pow_factorization_eq ;)
isPrimePow_of_minFac_pow_factorization_eq : (n : Elem Nat) -> (h : Proof (Eq (pow (Nat__minFac n) (Nat__factorization__app n (Nat__minFac n))) n)) -> (hn : Proof (Neq n 1)) -> Proof (IsPrimePow n).

(; //LEAN:isPrimePow_iff_minFac_pow_factorization_eq ;)
isPrimePow_iff_minFac_pow_factorization_eq : (n : Elem Nat) -> (hn : Proof (Neq n 1)) -> Proof (iff (IsPrimePow n) (Eq (pow (Nat__minFac n) (Nat__factorization__app n (Nat__minFac n))) n)).

(; //LEAN:isPrimePow_iff_factorization_eq_single ;)
isPrimePow_iff_factorization_eq_single : (n : Elem Nat) -> Proof (iff (IsPrimePow n) (exists Nat (p => exists Nat (k => and (Lt 0 k) (Eqt (Finsupp Nat Nat) (Nat__factorization n) (Finsupp__single p k)))))).

(; //LEAN:isPrimePow_iff_card_primeFactors_eq_one ;)
isPrimePow_iff_card_primeFactors_eq_one : (n : Elem Nat) -> Proof (iff (IsPrimePow n) (Eq (Finset__card (Nat__primeFactors n)) 1)).

(; //LEAN:Nat.not_isPrimePow_iff_nontrivial_of_two_le ;)
Nat__not_isPrimePow_iff_nontrivial_of_two_le : (n : Elem Nat) -> (hn : Proof (Leq 2 n)) -> Proof (iff (not (IsPrimePow n)) (Finset__Nontrivial (Nat__primeFactors n))).

(; //LEAN:IsPrimePow.exists_ordCompl_eq_one ;)
IsPrimePow__exists_ordCompl_eq_one : (n : Elem Nat) -> (h : Proof (IsPrimePow n)) -> Proof (exists Nat (p => and (prime p) (Eq (div n (pow p (Nat__factorization__app n p))) 1))).

(; //LEAN:exists_ordCompl_eq_one_iff_isPrimePow ;)
exists_ordCompl_eq_one_iff_isPrimePow : (n : Elem Nat) -> (hn : Proof (Neq n 1)) -> Proof (iff (IsPrimePow n) (exists Nat (p => and (prime p) (Eq (div n (pow p (Nat__factorization__app n p))) 1)))).

(; //LEAN:isPrimePow_iff_unique_prime_dvd ;)
isPrimePow_iff_unique_prime_dvd : (n : Elem Nat) -> Proof (iff (IsPrimePow n) (ExistsUnique (p => and (prime p) (divide p n)))).

(; //LEAN:isPrimePow_pow_iff ;)
isPrimePow_pow_iff : (n : Elem Nat) -> (k : Elem Nat) -> (hk : Proof (Neq k 0)) -> Proof (iff (IsPrimePow (pow n k)) (IsPrimePow n)).

(; //LEAN:Nat.Coprime.isPrimePow_dvd_mul ;)
Nat__Coprime__isPrimePow_dvd_mul : (n : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Nat__Coprime a b)) -> (hn : Proof (IsPrimePow n)) -> Proof (iff (divide n (times a b)) (or (divide n a) (divide n b))).

(; //LEAN:Nat.mul_divisors_filter_prime_pow ;)
Nat__mul_divisors_filter_prime_pow : (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Nat__Coprime a b)) -> Proof (Eqt (Finset Nat) (Finset__filter (d => IsPrimePow d) (Nat__divisors (times a b))) (Finset__filter (d1 => IsPrimePow d1) (Union__union (Nat__divisors a) (Nat__divisors b)))).

(; //LEAN:Nat.Primes.prodNatEquiv ;)
Nat__Primes__prodNatEquiv : Elem (Equiv (Prod Nat__Primes Nat) (Subtype (n => IsPrimePow n))).

(; //LEAN:Nat.Primes.prodNatEquiv_apply ;)
Nat__Primes__prodNatEquiv_apply : (p : Elem Nat__Primes) -> (k : Elem Nat) -> Proof (Eqt (Subtype (n => IsPrimePow n)) (Nat__Primes__prodNatEquiv__app (Prod__mk p k)) (pow p (plus k 1))).

(; //LEAN:Nat.Primes.coe_prodNatEquiv_apply ;)
Nat__Primes__coe_prodNatEquiv_apply : (p : Elem Nat__Primes) -> (k : Elem Nat) -> Proof (Eq (Nat__Primes__prodNatEquiv__app (Prod__mk p k)) (pow p (plus k 1))).

(; //LEAN:Nat.Primes.prodNatEquiv_symm_apply ;)
Nat__Primes__prodNatEquiv_symm_apply : (n : Elem Nat) -> (hn : Proof (IsPrimePow n)) -> Proof (Eqt (Prod Nat__Primes Nat) (Equiv__symm__app Nat__Primes__prodNatEquiv n) (Prod__mk (Nat__minFac n) (minus (Nat__factorization__app n (Nat__minFac n)) 1))).

(; //LEAN:Nat.exponent_eq_exponent_mul_factorization_of_prime_pow_eq_base_pow ;)
Nat__exponent_eq_exponent_mul_factorization_of_prime_pow_eq_base_pow : (p : Elem Nat) -> (a : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (hp : Proof (prime p)) -> (h : Proof (Eq (pow p m) (pow a n))) -> Proof (Eq m (times n (Nat__factorization__app a p))).

(; //LEAN:Nat.exponent_dvd_of_prime_pow_eq_pow ;)
Nat__exponent_dvd_of_prime_pow_eq_pow : (p : Elem Nat) -> (a : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (hp : Proof (prime p)) -> (h : Proof (Eq (pow p m) (pow a n))) -> Proof (divide n m).

(; //LEAN:Nat.exists_base_eq_prime_pow_of_prime_pow_eq_base_pow ;)
Nat__exists_base_eq_prime_pow_of_prime_pow_eq_base_pow : (p : Elem Nat) -> (a : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (hp : Proof (prime p)) -> (hn : Proof (Neq n 0)) -> (h : Proof (Eq (pow p m) (pow a n))) -> Proof (exists Nat (k => Eq a (pow p k))).

