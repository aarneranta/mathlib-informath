(; Mathlib.Data.Nat.Factorization.Root: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.floorRoot ;)
def Nat__floorRoot : (n : Elem Nat) -> (a : Elem Nat) -> Elem Nat :=
  n => a => ite (or (Eq n 0) (Eq a 0)) 0 (Finsupp__prod (Nat__factorization a) (p => k => pow p (div k n))).

(; //LEAN:Nat.floorRoot_def ;)
Nat__floorRoot_def : (a : Elem Nat) -> (n : Elem Nat) -> Proof (Eq (Nat__floorRoot n a) (ite (or (Eq n 0) (Eq a 0)) 0 (Finsupp__prod (FloorDiv__floorDiv (Nat__factorization a) n) (x => x1 => pow x x1)))).

(; //LEAN:Nat.floorRoot_zero_left ;)
Nat__floorRoot_zero_left : (a : Elem Nat) -> Proof (Eq (Nat__floorRoot 0 a) 0).

(; //LEAN:Nat.floorRoot_zero_right ;)
Nat__floorRoot_zero_right : (n : Elem Nat) -> Proof (Eq (Nat__floorRoot n 0) 0).

(; //LEAN:Nat.floorRoot_one_left ;)
Nat__floorRoot_one_left : (a : Elem Nat) -> Proof (Eq (Nat__floorRoot 1 a) a).

(; //LEAN:Nat.floorRoot_one_right ;)
Nat__floorRoot_one_right : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (Eq (Nat__floorRoot n 1) 1).

(; //LEAN:Nat.floorRoot_pow_self ;)
Nat__floorRoot_pow_self : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem Nat) -> Proof (Eq (Nat__floorRoot n (pow a n)) a).

(; //LEAN:Nat.floorRoot_ne_zero ;)
Nat__floorRoot_ne_zero : (a : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Neq (Nat__floorRoot n a) 0) (and (Neq n 0) (Neq a 0))).

(; //LEAN:Nat.floorRoot_eq_zero ;)
Nat__floorRoot_eq_zero : (a : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Eq (Nat__floorRoot n a) 0) (or (Eq n 0) (Eq a 0))).

(; //LEAN:Nat.factorization_floorRoot ;)
Nat__factorization_floorRoot : (n : Elem Nat) -> (a : Elem Nat) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (Nat__floorRoot n a)) (FloorDiv__floorDiv (Nat__factorization a) n)).

(; //LEAN:Nat.pow_dvd_iff_dvd_floorRoot ;)
Nat__pow_dvd_iff_dvd_floorRoot : (a : Elem Nat) -> (b : Elem Nat) -> (n : Elem Nat) -> Proof (iff (divide (pow a n) b) (divide a (Nat__floorRoot n b))).

(; //LEAN:Nat.floorRoot_pow_dvd ;)
def Nat__floorRoot_pow_dvd : (a : Elem Nat) -> (n : Elem Nat) -> Proof (divide (pow (Nat__floorRoot n a) n) a) :=
  a => n => iffEr (divide (pow (Nat__floorRoot n a) n) a) (divide (Nat__floorRoot n a) (Nat__floorRoot n a)) (Nat__pow_dvd_iff_dvd_floorRoot (Nat__floorRoot n a) a n) (dvd_rfl Nat (Nat__floorRoot n a)).

(; //LEAN:Nat.ceilRoot ;)
def Nat__ceilRoot : (n : Elem Nat) -> (a : Elem Nat) -> Elem Nat :=
  n => a => ite (or (Eq n 0) (Eq a 0)) 0 (Finsupp__prod (Nat__factorization a) (p => k => pow p (div (minus (plus k n) 1) n))).

(; //LEAN:Nat.ceilRoot_def ;)
Nat__ceilRoot_def : (a : Elem Nat) -> (n : Elem Nat) -> Proof (Eq (Nat__ceilRoot n a) (ite (or (Eq n 0) (Eq a 0)) 0 (Finsupp__prod (CeilDiv__ceilDiv (Nat__factorization a) n) (x => x1 => pow x x1)))).

(; //LEAN:Nat.ceilRoot_zero_left ;)
Nat__ceilRoot_zero_left : (a : Elem Nat) -> Proof (Eq (Nat__ceilRoot 0 a) 0).

(; //LEAN:Nat.ceilRoot_zero_right ;)
Nat__ceilRoot_zero_right : (n : Elem Nat) -> Proof (Eq (Nat__ceilRoot n 0) 0).

(; //LEAN:Nat.ceilRoot_one_left ;)
Nat__ceilRoot_one_left : (a : Elem Nat) -> Proof (Eq (Nat__ceilRoot 1 a) a).

(; //LEAN:Nat.ceilRoot_one_right ;)
Nat__ceilRoot_one_right : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (Eq (Nat__ceilRoot n 1) 1).

(; //LEAN:Nat.ceilRoot_pow_self ;)
Nat__ceilRoot_pow_self : (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (a : Elem Nat) -> Proof (Eq (Nat__ceilRoot n (pow a n)) a).

(; //LEAN:Nat.ceilRoot_ne_zero ;)
Nat__ceilRoot_ne_zero : (a : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Neq (Nat__ceilRoot n a) 0) (and (Neq n 0) (Neq a 0))).

(; //LEAN:Nat.ceilRoot_eq_zero ;)
Nat__ceilRoot_eq_zero : (a : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Eq (Nat__ceilRoot n a) 0) (or (Eq n 0) (Eq a 0))).

(; //LEAN:Nat.factorization_ceilRoot ;)
Nat__factorization_ceilRoot : (n : Elem Nat) -> (a : Elem Nat) -> Proof (Eqt (Finsupp Nat Nat) (Nat__factorization (Nat__ceilRoot n a)) (CeilDiv__ceilDiv (Nat__factorization a) n)).

(; //LEAN:Nat.dvd_pow_iff_ceilRoot_dvd ;)
Nat__dvd_pow_iff_ceilRoot_dvd : (a : Elem Nat) -> (b : Elem Nat) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (iff (divide a (pow b n)) (divide (Nat__ceilRoot n a) b)).

(; //LEAN:Nat.dvd_ceilRoot_pow ;)
def Nat__dvd_ceilRoot_pow : (a : Elem Nat) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> Proof (divide a (pow (Nat__ceilRoot n a) n)) :=
  a => n => hn => iffEr (divide a (pow (Nat__ceilRoot n a) n)) (divide (Nat__ceilRoot n a) (Nat__ceilRoot n a)) (Nat__dvd_pow_iff_ceilRoot_dvd a (Nat__ceilRoot n a) n hn) (dvd_rfl Nat (Nat__ceilRoot n a)).

