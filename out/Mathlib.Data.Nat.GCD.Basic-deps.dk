(; constants used by Mathlib.Data.Nat.GCD.Basic, declared with their translated types ;)

(; doc: **Alias** of `dvd_trans`. ;)
(; //LEAN:Dvd.dvd.trans ;)
Dvd__dvd__trans : (X : Set) -> (_ : Proof (Semigroup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (divide a b)) -> (h1 : Proof (divide b c)) -> Proof (divide a c).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: `a % b` computes the remainder upon dividing `a` by `b`. The meaning of this notation is type-dependent. * For `Nat` and `Int` it satisfies `a % b + b * (a / b) = a`,   and `a % 0` is defined to be `a`.  Conventions for notations in identifiers:   * The recommended spelling of `%` in identifiers is `mod`. ;)
(; //LEAN:HMod.hMod ;)
HMod__hMod : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: `x` and `y` are relatively prime if every common divisor is a unit. ;)
(; //LEAN:IsRelPrime ;)
IsRelPrime : (x1 : Elem X) -> (y : Elem X) -> Prop.

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (a : Elem M) -> Prop.

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; //LEAN:Nat.Coprime.coprime_dvd_left ;)
Nat__Coprime__coprime_dvd_left : (m : Elem Nat) -> (k : Elem Nat) -> (n : Elem Nat) -> (H1 : Proof (divide m k)) -> (H2 : Proof (Nat__Coprime k n)) -> Proof (Nat__Coprime m n).

(; //LEAN:Nat.Coprime.coprime_dvd_right ;)
Nat__Coprime__coprime_dvd_right : (n : Elem Nat) -> (m : Elem Nat) -> (k : Elem Nat) -> (H1 : Proof (divide n m)) -> (H2 : Proof (Nat__Coprime k m)) -> Proof (Nat__Coprime k n).

(; //LEAN:Nat.Coprime.dvd_of_dvd_mul_left ;)
Nat__Coprime__dvd_of_dvd_mul_left : (k : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (H1 : Proof (Nat__Coprime k m)) -> (H2 : Proof (divide k (times m n))) -> Proof (divide k n).

(; //LEAN:Nat.Coprime.dvd_of_dvd_mul_right ;)
Nat__Coprime__dvd_of_dvd_mul_right : (k : Elem Nat) -> (n : Elem Nat) -> (m : Elem Nat) -> (H1 : Proof (Nat__Coprime k n)) -> (H2 : Proof (divide k (times m n))) -> Proof (divide k m).

(; //LEAN:Nat.dvd_gcd ;)
Nat__dvd_gcd : (k : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (divide k m)) -> (h1 : Proof (divide k n)) -> Proof (divide k (gcd m n)).

(; //LEAN:Nat.dvd_lcm_left ;)
Nat__dvd_lcm_left : (m : Elem Nat) -> (n : Elem Nat) -> Proof (divide m (Nat__lcm m n)).

(; //LEAN:Nat.dvd_lcm_right ;)
Nat__dvd_lcm_right : (m : Elem Nat) -> (n : Elem Nat) -> Proof (divide n (Nat__lcm m n)).

(; //LEAN:Nat.dvd_one ;)
Nat__dvd_one : (n : Elem Nat) -> Proof (iff (divide n 1) (Eq n 1)).

(; //LEAN:Nat.gcd_dvd_left ;)
Nat__gcd_dvd_left : (m : Elem Nat) -> (n : Elem Nat) -> Proof (divide (gcd m n) m).

(; //LEAN:Nat.gcd_dvd_right ;)
Nat__gcd_dvd_right : (m : Elem Nat) -> (n : Elem Nat) -> Proof (divide (gcd m n) n).

(; doc: The least common multiple of `m` and `n` is the smallest natural number that's evenly divisible by both `m` and `n`. Returns `0` if either `m` or `n` is `0`.  Examples:  * `Nat.lcm 9 6 = 18`  * `Nat.lcm 9 3 = 9`  * `Nat.lcm 0 3 = 0`  * `Nat.lcm 3 0 = 0` ;)
(; //LEAN:Nat.lcm ;)
Nat__lcm : (m : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; //LEAN:dvd_antisymm ;)
dvd_antisymm : (X : Set) -> (_ : Proof (CommMonoidWithZero X)) -> (_ : Proof (IsCancelMulZero X)) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (Subsingleton (Units X))) -> (h2 : Proof (divide a b)) -> (h3 : Proof (divide b a)) -> Proof (Eqt X a b).

(; //LEAN:dvd_mul_of_dvd_left ;)
dvd_mul_of_dvd_left : (X : Set) -> (_ : Proof (Semigroup X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (divide a b)) -> (c : Elem X) -> Proof (divide a (times b c)).

(; //LEAN:dvd_mul_of_dvd_right ;)
dvd_mul_of_dvd_right : (X : Set) -> (_ : Proof (CommSemigroup X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (divide a b)) -> (c : Elem X) -> Proof (divide a (times c b)).

(; //LEAN:isUnit_iff_dvd_one ;)
isUnit_iff_dvd_one : (X : Set) -> (_ : Proof (CommMonoid X)) -> (x1 : Elem X) -> Proof (iff (IsUnit x1) (divide x1 1)).

