  a => b => n => h => hb => Eq__trans Nat (HMod__hMod Nat Nat Nat a n) (HMod__hMod Nat Nat Nat b n) b h (Nat__mod_eq_of_lt b n hb).

(; //LEAN:Nat.ext_div_modEq ;)
def Nat__ext_div_modEq : (n : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> (h0 : Proof (Eq (div a n) (div b n))) -> (h1 : Proof (Nat__ModEq n a b)) -> Proof (Eq a b) :=
  n => a => b => h0 => h1 => Nat__ext_div_mod n a b h0 h1.

(; //LEAN:Nat.ext_div_modEq_iff ;)
def Nat__ext_div_modEq_iff : (n : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> Proof (iff (Eq a b) (and (Eq (div a n) (div b n)) (Nat__ModEq n a b))) :=
  n => a => b => Nat__ext_div_mod_iff n a b.

(; //LEAN:Nat.modEq_iff_eq_of_div_eq ;)
Nat__modEq_iff_eq_of_div_eq : (n : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> (h : Proof (Eq (div a n) (div b n))) -> Proof (iff (Nat__ModEq n a b) (Eq a b)).

