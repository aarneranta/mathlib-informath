(; Mathlib.Data.Nat.Prime.Basic: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.prime_mul_iff ;)
Nat__prime_mul_iff : (a : Elem Nat) -> (b : Elem Nat) -> Proof (iff (prime (times a b)) (or (and (prime a) (Eq b 1)) (and (prime b) (Eq a 1)))).

(; //LEAN:Nat.not_prime_mul ;)
Nat__not_prime_mul : (a : Elem Nat) -> (b : Elem Nat) -> (a1 : Proof (Neq a 1)) -> (b1 : Proof (Neq b 1)) -> Proof (not (prime (times a b))).

(; //LEAN:Nat.not_prime_of_mul_eq ;)
Nat__not_prime_of_mul_eq : (a : Elem Nat) -> (b : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Eq (times a b) n)) -> (h1 : Proof (Neq a 1)) -> (h2 : Proof (Neq b 1)) -> Proof (not (prime n)).

(; //LEAN:Nat.Prime.dvd_iff_eq ;)
Nat__Prime__dvd_iff_eq : (p : Elem Nat) -> (a : Elem Nat) -> (hp : Proof (prime p)) -> (a1 : Proof (Neq a 1)) -> Proof (iff (divide a p) (Eq p a)).

(; //LEAN:Nat.Prime.eq_two_or_odd ;)
Nat__Prime__eq_two_or_odd : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (or (Eq p 2) (Eq (HMod__hMod p 2) 1)).

(; //LEAN:Nat.Prime.eq_two_or_odd' ;)
Nat__Prime__eq_two_or_odd' : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (or (Eq p 2) (odd p)).

(; //LEAN:Nat.Prime.five_le_of_ne_two_of_ne_three ;)
Nat__Prime__five_le_of_ne_two_of_ne_three : (p : Elem Nat) -> (hp : Proof (prime p)) -> (h_two : Proof (Neq p 2)) -> (h_three : Proof (Neq p 3)) -> Proof (Leq 5 p).

(; //LEAN:Nat.Prime.pred_pos ;)
Nat__Prime__pred_pos : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Lt 0 (Nat__pred p)).

(; //LEAN:Nat.succ_pred_prime ;)
Nat__succ_pred_prime : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Eq (succ (Nat__pred p)) p).

(; //LEAN:Nat.exists_dvd_of_not_prime ;)
Nat__exists_dvd_of_not_prime : (n : Elem Nat) -> (n2 : Proof (Leq 2 n)) -> (np : Proof (not (prime n))) -> Proof (exists Nat (m => and (divide m n) (and (Neq m 1) (Neq m n)))).

(; //LEAN:Nat.exists_dvd_of_not_prime2 ;)
Nat__exists_dvd_of_not_prime2 : (n : Elem Nat) -> (n2 : Proof (Leq 2 n)) -> (np : Proof (not (prime n))) -> Proof (exists Nat (m => and (divide m n) (and (Leq 2 m) (Lt m n)))).

(; //LEAN:Nat.not_prime_of_dvd_of_ne ;)
Nat__not_prime_of_dvd_of_ne : (m : Elem Nat) -> (n : Elem Nat) -> (h1 : Proof (divide m n)) -> (h2 : Proof (Neq m 1)) -> (h3 : Proof (Neq m n)) -> Proof (not (prime n)).

(; //LEAN:Nat.not_prime_of_dvd_of_lt ;)
Nat__not_prime_of_dvd_of_lt : (m : Elem Nat) -> (n : Elem Nat) -> (h1 : Proof (divide m n)) -> (h2 : Proof (Leq 2 m)) -> (h3 : Proof (Lt m n)) -> Proof (not (prime n)).

(; //LEAN:Nat.not_prime_iff_exists_dvd_ne ;)
Nat__not_prime_iff_exists_dvd_ne : (n : Elem Nat) -> (h : Proof (Leq 2 n)) -> Proof (iff (not (prime n)) (exists Nat (m => and (divide m n) (and (Neq m 1) (Neq m n))))).

(; //LEAN:Nat.not_prime_iff_exists_dvd_lt ;)
Nat__not_prime_iff_exists_dvd_lt : (n : Elem Nat) -> (h : Proof (Leq 2 n)) -> Proof (iff (not (prime n)) (exists Nat (m => and (divide m n) (and (Leq 2 m) (Lt m n))))).

(; //LEAN:Nat.not_prime_iff_exists_mul_eq ;)
Nat__not_prime_iff_exists_mul_eq : (n : Elem Nat) -> (h : Proof (Leq 2 n)) -> Proof (iff (not (prime n)) (exists Nat (a => exists Nat (b => and (Lt a n) (and (Lt b n) (Eq (times a b) n)))))).

(; //LEAN:Nat.dvd_of_forall_prime_mul_dvd ;)
Nat__dvd_of_forall_prime_mul_dvd : (a : Elem Nat) -> (b : Elem Nat) -> (hdvd : Proof (forall Nat (p => if (prime p) (if (divide p a) (divide (times p a) b))))) -> Proof (divide a b).

(; //LEAN:Nat.Prime.even_iff ;)
Nat__Prime__even_iff : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (iff (even p) (Eq p 2)).

(; //LEAN:Nat.Prime.odd_iff ;)
Nat__Prime__odd_iff : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (iff (odd p) (Leq 3 p)).

(; //LEAN:Nat.Prime.odd_of_ne_two ;)
Nat__Prime__odd_of_ne_two : (p : Elem Nat) -> (hp : Proof (prime p)) -> (h_two : Proof (Neq p 2)) -> Proof (odd p).

(; //LEAN:Nat.Prime.even_sub_one ;)
Nat__Prime__even_sub_one : (p : Elem Nat) -> (hp : Proof (prime p)) -> (h2 : Proof (Neq p 2)) -> Proof (even (minus p 1)).

(; //LEAN:Nat.forall_prime_iff_two_and_odd ;)
Nat__forall_prime_iff_two_and_odd : (P : (Elem Nat -> Prop)) -> Proof (iff (forall Nat (p => if (prime p) (P p))) (and (P 2) (forall Nat (p1 => if (prime p1) (if (odd p1) (P p1)))))).

(; //LEAN:Nat.forall_prime_of_two_of_odd ;)
Nat__forall_prime_of_two_of_odd : (P : (Elem Nat -> Prop)) -> (h : Proof (and (P 2) (forall Nat (p1 => if (prime p1) (if (odd p1) (P p1)))))) -> (p : Elem Nat) -> (h1 : Proof (prime p)) -> Proof (P p).

(; //LEAN:Nat.Prime.mod_two_eq_one_iff_ne_two ;)
Nat__Prime__mod_two_eq_one_iff_ne_two : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (iff (Eq (HMod__hMod p 2) 1) (Neq p 2)).

(; //LEAN:Nat.coprime_of_dvd' ;)
Nat__coprime_of_dvd' : (m : Elem Nat) -> (n : Elem Nat) -> (H : Proof (forall Nat (k => if (prime k) (if (divide k m) (if (divide k n) (divide k 1)))))) -> Proof (Nat__Coprime m n).

(; //LEAN:Nat.Prime.dvd_iff_not_coprime ;)
Nat__Prime__dvd_iff_not_coprime : (p : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (divide p n) (not (Nat__Coprime p n))).

(; //LEAN:Nat.Prime.not_coprime_iff_dvd ;)
Nat__Prime__not_coprime_iff_dvd : (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (not (Nat__Coprime m n)) (exists Nat (p => and (prime p) (and (divide p m) (divide p n))))).

(; //LEAN:Nat.coprime_of_lt_minFac ;)
Nat__coprime_of_lt_minFac : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Neq m 0)) -> (h1 : Proof (Lt m (Nat__minFac n))) -> Proof (Nat__Coprime n m).

(; //LEAN:Nat.gcd_eq_one_of_lt_minFac ;)
Nat__gcd_eq_one_of_lt_minFac : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Neq m 0)) -> (h1 : Proof (Lt m (Nat__minFac n))) -> Proof (Eq (gcd n m) 1).

(; //LEAN:Nat.Prime.not_dvd_mul ;)
Nat__Prime__not_dvd_mul : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> (Hm : Proof (not (divide p m))) -> (Hn : Proof (not (divide p n))) -> Proof (not (divide p (times m n))).

(; //LEAN:Nat.coprime_two_left ;)
Nat__coprime_two_left : (n : Elem Nat) -> Proof (iff (Nat__Coprime 2 n) (odd n)).

(; //LEAN:Nat.coprime_two_right ;)
Nat__coprime_two_right : (n : Elem Nat) -> Proof (iff (Nat__Coprime n 2) (odd n)).

(; //LEAN:Odd.coprime_two_left ;)
Odd__coprime_two_left : (n : Elem Nat) -> (h : Proof (odd n)) -> Proof (Nat__Coprime 2 n).

(; //LEAN:Nat.Coprime.odd_of_left ;)
Nat__Coprime__odd_of_left : (n : Elem Nat) -> (h : Proof (Nat__Coprime 2 n)) -> Proof (odd n).

(; //LEAN:Odd.coprime_two_right ;)
Odd__coprime_two_right : (n : Elem Nat) -> (h : Proof (odd n)) -> Proof (Nat__Coprime n 2).

(; //LEAN:Nat.Coprime.odd_of_right ;)
Nat__Coprime__odd_of_right : (n : Elem Nat) -> (h : Proof (Nat__Coprime n 2)) -> Proof (odd n).

(; //LEAN:Nat.Prime.dvd_of_dvd_pow ;)
Nat__Prime__dvd_of_dvd_pow : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> (h : Proof (divide p (pow m n))) -> Proof (divide p m).

(; //LEAN:Nat.Prime.not_prime_pow' ;)
Nat__Prime__not_prime_pow' : (x : Elem Nat) -> (n : Elem Nat) -> (hn : Proof (Neq n 1)) -> Proof (not (prime (pow x n))).

(; //LEAN:Nat.Prime.not_prime_pow ;)
Nat__Prime__not_prime_pow : (x : Elem Nat) -> (n : Elem Nat) -> (hn : Proof (Leq 2 n)) -> Proof (not (prime (pow x n))).

(; //LEAN:Nat.Prime.eq_one_of_pow ;)
Nat__Prime__eq_one_of_pow : (x : Elem Nat) -> (n : Elem Nat) -> (h : Proof (prime (pow x n))) -> Proof (Eq n 1).

(; //LEAN:Nat.Prime.pow_eq_iff ;)
Nat__Prime__pow_eq_iff : (p : Elem Nat) -> (a : Elem Nat) -> (k : Elem Nat) -> (hp : Proof (prime p)) -> Proof (iff (Eq (pow a k) p) (and (Eq a p) (Eq k 1))).

(; //LEAN:Nat.Prime.mul_eq_prime_sq_iff ;)
Nat__Prime__mul_eq_prime_sq_iff : (x : Elem Nat) -> (y : Elem Nat) -> (p : Elem Nat) -> (hp : Proof (prime p)) -> (hx : Proof (Neq x 1)) -> (hy : Proof (Neq y 1)) -> Proof (iff (Eq (times x y) (pow p 2)) (and (Eq x p) (Eq y p))).

(; //LEAN:Nat.Prime.coprime_pow_of_not_dvd ;)
Nat__Prime__coprime_pow_of_not_dvd : (p : Elem Nat) -> (m : Elem Nat) -> (a : Elem Nat) -> (pp : Proof (prime p)) -> (h : Proof (not (divide p a))) -> Proof (Nat__Coprime a (pow p m)).

(; //LEAN:Nat.coprime_primes ;)
Nat__coprime_primes : (p : Elem Nat) -> (q : Elem Nat) -> (pp : Proof (prime p)) -> (pq : Proof (prime q)) -> Proof (iff (Nat__Coprime p q) (Neq p q)).

(; //LEAN:Nat.coprime_pow_primes ;)
Nat__coprime_pow_primes : (p : Elem Nat) -> (q : Elem Nat) -> (n : Elem Nat) -> (m : Elem Nat) -> (pp : Proof (prime p)) -> (pq : Proof (prime q)) -> (h : Proof (Neq p q)) -> Proof (Nat__Coprime (pow p n) (pow q m)).

(; //LEAN:Nat.coprime_or_dvd_of_prime ;)
Nat__coprime_or_dvd_of_prime : (p : Elem Nat) -> (pp : Proof (prime p)) -> (i : Elem Nat) -> Proof (or (Nat__Coprime p i) (divide p i)).

(; //LEAN:Nat.coprime_of_lt_prime ;)
Nat__coprime_of_lt_prime : (n : Elem Nat) -> (p : Elem Nat) -> (ne_zero : Proof (Neq n 0)) -> (hlt : Proof (Lt n p)) -> (pp : Proof (prime p)) -> Proof (Nat__Coprime p n).

(; //LEAN:Nat.eq_or_coprime_of_le_prime ;)
Nat__eq_or_coprime_of_le_prime : (n : Elem Nat) -> (p : Elem Nat) -> (ne_zero : Proof (Neq n 0)) -> (hle : Proof (Leq n p)) -> (pp : Proof (prime p)) -> Proof (or (Eq p n) (Nat__Coprime p n)).

(; //LEAN:Nat.prime_eq_prime_of_dvd_pow ;)
Nat__prime_eq_prime_of_dvd_pow : (m : Elem Nat) -> (p : Elem Nat) -> (q : Elem Nat) -> (pp : Proof (prime p)) -> (pq : Proof (prime q)) -> (h : Proof (divide p (pow q m))) -> Proof (Eq p q).

(; //LEAN:Nat.dvd_prime_pow ;)
Nat__dvd_prime_pow : (p : Elem Nat) -> (pp : Proof (prime p)) -> (m : Elem Nat) -> (i : Elem Nat) -> Proof (iff (divide i (pow p m)) (exists Nat (k => and (Leq k m) (Eq i (pow p k))))).

(; //LEAN:Nat.Prime.dvd_mul_of_dvd_ne ;)
Nat__Prime__dvd_mul_of_dvd_ne : (p1 : Elem Nat) -> (p2 : Elem Nat) -> (n : Elem Nat) -> (h_ne : Proof (Neq p1 p2)) -> (pp1 : Proof (prime p1)) -> (pp2 : Proof (prime p2)) -> (h1 : Proof (divide p1 n)) -> (h2 : Proof (divide p2 n)) -> Proof (divide (times p1 p2) n).

(; //LEAN:Nat.eq_prime_pow_of_dvd_least_prime_pow ;)
Nat__eq_prime_pow_of_dvd_least_prime_pow : (a : Elem Nat) -> (p : Elem Nat) -> (k : Elem Nat) -> (pp : Proof (prime p)) -> (h : Proof (not (divide a (pow p k)))) -> (h1 : Proof (divide a (pow p (plus k 1)))) -> Proof (Eq a (pow p (plus k 1))).

(; //LEAN:Nat.ne_one_iff_exists_prime_dvd ;)
Nat__ne_one_iff_exists_prime_dvd : (n : Elem Nat) -> Proof (iff (Neq n 1) (exists Nat (p => and (prime p) (divide p n)))).

(; //LEAN:Nat.eq_one_iff_not_exists_prime_dvd ;)
Nat__eq_one_iff_not_exists_prime_dvd : (n : Elem Nat) -> Proof (iff (Eq n 1) (forall Nat (p => if (prime p) (not (divide p n))))).

(; //LEAN:Nat.succ_dvd_or_succ_dvd_of_succ_sum_dvd_mul ;)
Nat__succ_dvd_or_succ_dvd_of_succ_sum_dvd_mul : (p : Elem Nat) -> (p_prime : Proof (prime p)) -> (m : Elem Nat) -> (n : Elem Nat) -> (k : Elem Nat) -> (l : Elem Nat) -> (hpm : Proof (divide (pow p k) m)) -> (hpn : Proof (divide (pow p l) n)) -> (hpmn : Proof (divide (pow p (plus (plus k l) 1)) (times m n))) -> Proof (or (divide (pow p (plus k 1)) m) (divide (pow p (plus l 1)) n)).

