(; //LEAN:Nat.prime_dvd_prime_iff_eq ;)
def Nat__prime_dvd_prime_iff_eq : (p : Elem Nat) -> (q : Elem Nat) -> (pp : Proof (prime p)) -> (qp : Proof (prime q)) -> Proof (iff (divide p q) (Eq p q)) :=
  p => q => pp => qp => Nat__dvd_prime_two_le q p qp (Nat__Prime__two_le p pp).

(; //LEAN:Nat.Prime.not_dvd_one ;)
def Nat__Prime__not_dvd_one : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (not (divide p 1)) :=
  p => pp => Irreducible__not_dvd_one Nat p pp.

(; //LEAN:Nat.minFac_lemma ;)
def Nat__minFac_lemma : (n : Elem Nat) -> (k : Elem Nat) -> (h : Proof (not (Lt n (times k k)))) -> Proof (Lt (minus (Nat__sqrt n) k) (minus (plus (Nat__sqrt n) 2) k)) :=
  n => k => h => Nat__sub_lt_sub_right (Nat__sqrt n) (plus (Nat__sqrt n) 2) k (iffEr (Leq k (Nat__sqrt n)) (Leq (times k k) n) (Nat__le_sqrt k n) (le_of_not_gt Nat (times k k) n h)) (Nat__lt_add_of_pos_right 2 (Nat__sqrt n) (of_decide_eq_true (Lt 0 2) (id (Eq__refl Bool__true)))).

(; //LEAN:Nat.minFacAux ;)
Nat__minFacAux : (n : Elem Nat) -> (x : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.minFac ;)
def Nat__minFac : (n : Elem Nat) -> Elem Nat :=
  n => ite (divide 2 n) 2 (Nat__minFacAux n 3).

(; //LEAN:Nat.minFac_zero ;)
def Nat__minFac_zero : Proof (Eq (Nat__minFac 0) 2) :=
  rfl.

(; //LEAN:Nat.minFac_one ;)
Nat__minFac_one : Proof (Eq (Nat__minFac 1) 1).

(; //LEAN:Nat.minFac_two ;)
Nat__minFac_two : Proof (Eq (Nat__minFac 2) 2).

(; //LEAN:Nat.minFac_eq ;)
def Nat__minFac_eq : (n : Elem Nat) -> Proof (Eq (Nat__minFac n) (ite (divide 2 n) 2 (Nat__minFacAux n 3))) :=
  n => rfl.

(; //LEAN:Nat.minFac_dvd ;)
Nat__minFac_dvd : (n : Elem Nat) -> Proof (divide (Nat__minFac n) n).

(; //LEAN:Nat.minFac_prime ;)
Nat__minFac_prime : (n : Elem Nat) -> (n1 : Proof (Neq n 1)) -> Proof (prime (Nat__minFac n)).

(; //LEAN:Nat.minFac_prime_iff ;)
Nat__minFac_prime_iff : (n : Elem Nat) -> Proof (iff (prime (Nat__minFac n)) (Neq n 1)).

(; //LEAN:Nat.minFac_le_of_dvd ;)
Nat__minFac_le_of_dvd : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Leq 2 m)) -> (h1 : Proof (divide m n)) -> Proof (Leq (Nat__minFac n) m).

(; //LEAN:Nat.minFac_pos ;)
Nat__minFac_pos : (n : Elem Nat) -> Proof (Lt 0 (Nat__minFac n)).

(; //LEAN:Nat.minFac_le ;)
def Nat__minFac_le : (n : Elem Nat) -> (H : Proof (Lt 0 n)) -> Proof (Leq (Nat__minFac n) n) :=
  n => H => Nat__le_of_dvd (Nat__minFac n) n H (Nat__minFac_dvd n).

(; //LEAN:Nat.le_minFac ;)
Nat__le_minFac : (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (or (Eq n 1) (Leq m (Nat__minFac n))) (forall Nat (p => if (prime p) (if (divide p n) (Leq m p))))).

(; //LEAN:Nat.le_minFac' ;)
Nat__le_minFac' : (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (or (Eq n 1) (Leq m (Nat__minFac n))) (forall Nat (p => if (Leq 2 p) (if (divide p n) (Leq m p))))).

(; //LEAN:Nat.prime_def_minFac ;)
Nat__prime_def_minFac : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (Eq (Nat__minFac p) p))).

(; //LEAN:Nat.Prime.minFac_eq ;)
def Nat__Prime__minFac_eq : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Eq (Nat__minFac p) p) :=
  p => hp => andEr (Leq 2 p) (Eq (Nat__minFac p) p) (iffEl (prime p) (and (Leq 2 p) (Eq (Nat__minFac p) p)) (Nat__prime_def_minFac p) hp).

(; //LEAN:Nat.decidablePrime' ;)
def Nat__decidablePrime' : (p : Elem Nat) -> Proof (Decidable (prime p)) :=
  p => decidable_of_iff' (and (Leq 2 p) (Eq (Nat__minFac p) p)) Nat__prime_def_minFac.

(; //LEAN:Nat.decidablePrime_csimp ;)
Nat__decidablePrime_csimp : Proof (Eqt ((p : Elem Nat) -> Decidable (prime p)) Nat__decidablePrime Nat__decidablePrime').

