(; //LEAN:Nat.Prime ;)
def Nat__Prime : (p : Elem Nat) -> Prop :=
  p => Irreducible p.

(; //LEAN:Nat.irreducible_iff_nat_prime ;)
def Nat__irreducible_iff_nat_prime : (a : Elem Nat) -> Proof (iff (Irreducible a) (prime a)) :=
  a => Iff__rfl (Irreducible a).

(; //LEAN:Nat.not_prime_zero ;)
Nat__not_prime_zero : Proof (not (prime 0)).

(; //LEAN:Nat.prime_zero_false ;)
def Nat__prime_zero_false : (h : Proof (prime 0)) -> Proof false :=
  Nat__not_prime_zero.

(; //LEAN:Nat.not_prime_one ;)
Nat__not_prime_one : Proof (not (prime 1)).

(; //LEAN:Nat.prime_one_false ;)
def Nat__prime_one_false : (h : Proof (prime 1)) -> Proof false :=
  Nat__not_prime_one.

(; //LEAN:Nat.Prime.ne_zero ;)
def Nat__Prime__ne_zero : (n : Elem Nat) -> (h : Proof (prime n)) -> Proof (Neq n 0) :=
  n => h => Irreducible__ne_zero Nat n h.

(; //LEAN:Nat.Prime.pos ;)
def Nat__Prime__pos : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Lt 0 p) :=
  p => pp => Nat__pos_of_ne_zero p (Nat__Prime__ne_zero p pp).

(; //LEAN:Nat.Prime.two_le ;)
Nat__Prime__two_le : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Leq 2 p).

(; //LEAN:Nat.Prime.one_lt ;)
def Nat__Prime__one_lt : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Lt 1 p) :=
  p => Nat__Prime__two_le p.

(; //LEAN:Nat.Prime.one_le ;)
def Nat__Prime__one_le : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Leq 1 p) :=
  p => hp => LT__lt__le Nat 1 p (Nat__Prime__one_lt p hp).

(; //LEAN:Nat.Prime.ne_one ;)
def Nat__Prime__ne_one : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Neq p 1) :=
  p => hp => LT__lt__ne' Nat p 1 (Nat__Prime__one_lt p hp).

(; //LEAN:Nat.Prime.eq_one_or_self_of_dvd ;)
Nat__Prime__eq_one_or_self_of_dvd : (p : Elem Nat) -> (pp : Proof (prime p)) -> (m : Elem Nat) -> (hm : Proof (divide m p)) -> Proof (or (Eq m 1) (Eq m p)).

(; //LEAN:Nat.prime_def ;)
Nat__prime_def : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (forall Nat (m => if (divide m p) (or (Eq m 1) (Eq m p)))))).

