(; Mathlib.Data.Nat.Prime.Defs: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.Prime ;)
Nat__Prime : (p : Elem Nat) -> Prop.

(; //LEAN:Nat.irreducible_iff_nat_prime ;)
Nat__irreducible_iff_nat_prime : (a : Elem Nat) -> Proof (iff (Irreducible a) (prime a)).

(; //LEAN:Nat.not_prime_zero ;)
Nat__not_prime_zero : Proof (not (prime 0)).

(; //LEAN:Nat.prime_zero_false ;)
Nat__prime_zero_false : (h : Proof (prime 0)) -> Proof false.

(; //LEAN:Nat.not_prime_one ;)
Nat__not_prime_one : Proof (not (prime 1)).

(; //LEAN:Nat.prime_one_false ;)
Nat__prime_one_false : (h : Proof (prime 1)) -> Proof false.

(; //LEAN:Nat.Prime.ne_zero ;)
Nat__Prime__ne_zero : (n : Elem Nat) -> (h : Proof (prime n)) -> Proof (Neq n 0).

(; //LEAN:Nat.Prime.pos ;)
Nat__Prime__pos : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (Lt 0 p).

(; //LEAN:Nat.Prime.two_le ;)
Nat__Prime__two_le : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Leq 2 p).

(; //LEAN:Nat.Prime.one_lt ;)
Nat__Prime__one_lt : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Lt 1 p).

(; //LEAN:Nat.Prime.one_le ;)
Nat__Prime__one_le : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Leq 1 p).

(; //LEAN:Nat.Prime.ne_one ;)
Nat__Prime__ne_one : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Neq p 1).

(; //LEAN:Nat.Prime.eq_one_or_self_of_dvd ;)
Nat__Prime__eq_one_or_self_of_dvd : (p : Elem Nat) -> (pp : Proof (prime p)) -> (m : Elem Nat) -> (hm : Proof (divide m p)) -> Proof (or (Eq m 1) (Eq m p)).

(; //LEAN:Nat.prime_def ;)
Nat__prime_def : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (forall Nat (m => if (divide m p) (or (Eq m 1) (Eq m p)))))).

(; //LEAN:Nat.prime_def_lt ;)
Nat__prime_def_lt : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (forall Nat (m => if (Lt m p) (if (divide m p) (Eq m 1)))))).

(; //LEAN:Nat.prime_def_lt' ;)
Nat__prime_def_lt' : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (forall Nat (m => if (Leq 2 m) (if (Lt m p) (not (divide m p))))))).

(; //LEAN:Nat.prime_def_le_sqrt ;)
Nat__prime_def_le_sqrt : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (forall Nat (m => if (Leq 2 m) (if (Leq m (Nat__sqrt p)) (not (divide m p))))))).

(; //LEAN:Nat.prime_iff_not_exists_mul_eq ;)
Nat__prime_iff_not_exists_mul_eq : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (not (exists Nat (m => exists Nat (n => and (Lt m p) (and (Lt n p) (Eq (times m n) p)))))))).

(; //LEAN:Nat.prime_of_coprime ;)
Nat__prime_of_coprime : (n : Elem Nat) -> (h1 : Proof (Lt 1 n)) -> (h : Proof (forall Nat (m => if (Lt m n) (if (Neq m 0) (Nat__Coprime n m))))) -> Proof (prime n).

(; //LEAN:Nat.prime_two ;)
Nat__prime_two : Proof (prime 2).

(; //LEAN:Nat.prime_three ;)
Nat__prime_three : Proof (prime 3).

(; //LEAN:Nat.prime_five ;)
Nat__prime_five : Proof (prime 5).

(; //LEAN:Nat.prime_seven ;)
Nat__prime_seven : Proof (prime 7).

(; //LEAN:Nat.prime_eleven ;)
Nat__prime_eleven : Proof (prime ((nn 1 (nd 1)))).

(; //LEAN:Nat.dvd_prime ;)
Nat__dvd_prime : (p : Elem Nat) -> (m : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (divide m p) (or (Eq m 1) (Eq m p))).

(; //LEAN:Nat.dvd_prime_two_le ;)
Nat__dvd_prime_two_le : (p : Elem Nat) -> (m : Elem Nat) -> (pp : Proof (prime p)) -> (H : Proof (Leq 2 m)) -> Proof (iff (divide m p) (Eq m p)).

(; //LEAN:Nat.prime_dvd_prime_iff_eq ;)
Nat__prime_dvd_prime_iff_eq : (p : Elem Nat) -> (q : Elem Nat) -> (pp : Proof (prime p)) -> (qp : Proof (prime q)) -> Proof (iff (divide p q) (Eq p q)).

(; //LEAN:Nat.Prime.not_dvd_one ;)
Nat__Prime__not_dvd_one : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (not (divide p 1)).

(; //LEAN:Nat.minFac_lemma ;)
Nat__minFac_lemma : (n : Elem Nat) -> (k : Elem Nat) -> (h : Proof (not (Lt n (times k k)))) -> Proof (Lt (minus (Nat__sqrt n) k) (minus (plus (Nat__sqrt n) 2) k)).

(; //LEAN:Nat.minFacAux ;)
Nat__minFacAux : (n : Elem Nat) -> (x : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.minFac ;)
Nat__minFac : (n : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.minFac_zero ;)
Nat__minFac_zero : Proof (Eq (Nat__minFac 0) 2).

(; //LEAN:Nat.minFac_one ;)
Nat__minFac_one : Proof (Eq (Nat__minFac 1) 1).

(; //LEAN:Nat.minFac_two ;)
Nat__minFac_two : Proof (Eq (Nat__minFac 2) 2).

(; //LEAN:Nat.minFac_eq ;)
Nat__minFac_eq : (n : Elem Nat) -> Proof (Eq (Nat__minFac n) (ite (divide 2 n) 2 (Nat__minFacAux n 3))).

(; //LEAN:Nat.minFac_dvd ;)
Nat__minFac_dvd : (n : Elem Nat) -> Proof (divide (Nat__minFac n) n).

(; //LEAN:Nat.minFac_prime ;)
Nat__minFac_prime : (n : Elem Nat) -> (n1 : Proof (Neq n 1)) -> Proof (prime (Nat__minFac n)).

(; //LEAN:Nat.minFac_prime_iff ;)
Nat__minFac_prime_iff : (n : Elem Nat) -> Proof (iff (prime (Nat__minFac n)) (Neq n 1)).

(; //LEAN:Nat.minFac_le_of_dvd ;)
Nat__minFac_le_of_dvd : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Leq 2 m)) -> (h1 : Proof (divide m n)) -> Proof (Leq (Nat__minFac n) m).

(; //LEAN:Nat.minFac_pos ;)
Nat__minFac_pos : (n : Elem Nat) -> Proof (Lt 0 (Nat__minFac n)).

(; //LEAN:Nat.minFac_le ;)
Nat__minFac_le : (n : Elem Nat) -> (H : Proof (Lt 0 n)) -> Proof (Leq (Nat__minFac n) n).

(; //LEAN:Nat.le_minFac ;)
Nat__le_minFac : (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (or (Eq n 1) (Leq m (Nat__minFac n))) (forall Nat (p => if (prime p) (if (divide p n) (Leq m p))))).

(; //LEAN:Nat.le_minFac' ;)
Nat__le_minFac' : (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (or (Eq n 1) (Leq m (Nat__minFac n))) (forall Nat (p => if (Leq 2 p) (if (divide p n) (Leq m p))))).

(; //LEAN:Nat.prime_def_minFac ;)
Nat__prime_def_minFac : (p : Elem Nat) -> Proof (iff (prime p) (and (Leq 2 p) (Eq (Nat__minFac p) p))).

(; //LEAN:Nat.Prime.minFac_eq ;)
Nat__Prime__minFac_eq : (p : Elem Nat) -> (hp : Proof (prime p)) -> Proof (Eq (Nat__minFac p) p).

(; //LEAN:Nat.decidablePrime' ;)
Nat__decidablePrime' : (p : Elem Nat) -> Elem (Decidable (prime p)).

(; //LEAN:Nat.decidablePrime_csimp ;)
Nat__decidablePrime_csimp : Proof (Eqt ((p : Elem Nat) -> Decidable (prime p)) Nat__decidablePrime Nat__decidablePrime').

(; //LEAN:Nat.not_prime_iff_minFac_lt ;)
Nat__not_prime_iff_minFac_lt : (n : Elem Nat) -> (n2 : Proof (Leq 2 n)) -> Proof (iff (not (prime n)) (Lt (Nat__minFac n) n)).

(; //LEAN:Nat.minFac_le_div ;)
Nat__minFac_le_div : (n : Elem Nat) -> (pos : Proof (Lt 0 n)) -> (np : Proof (not (prime n))) -> Proof (Leq (Nat__minFac n) (div n (Nat__minFac n))).

(; //LEAN:Nat.minFac_sq_le_self ;)
Nat__minFac_sq_le_self : (n : Elem Nat) -> (w : Proof (Lt 0 n)) -> (h : Proof (not (prime n))) -> Proof (Leq (pow (Nat__minFac n) 2) n).

(; //LEAN:Nat.minFac_eq_one_iff ;)
Nat__minFac_eq_one_iff : (n : Elem Nat) -> Proof (iff (Eq (Nat__minFac n) 1) (Eq n 1)).

(; //LEAN:Nat.minFac_eq_two_iff ;)
Nat__minFac_eq_two_iff : (n : Elem Nat) -> Proof (iff (Eq (Nat__minFac n) 2) (divide 2 n)).

(; //LEAN:Nat.factors_lemma ;)
Nat__factors_lemma : (k : Elem Nat) -> Proof (Lt (div (plus k 2) (Nat__minFac (plus k 2))) (plus k 2)).

(; //LEAN:Nat.exists_prime_and_dvd ;)
Nat__exists_prime_and_dvd : (n : Elem Nat) -> (hn : Proof (Neq n 1)) -> Proof (exists Nat (p => and (prime p) (divide p n))).

(; //LEAN:Nat.coprime_of_dvd ;)
Nat__coprime_of_dvd : (m : Elem Nat) -> (n : Elem Nat) -> (H : Proof (forall Nat (k => if (prime k) (if (divide k m) (not (divide k n)))))) -> Proof (Nat__Coprime m n).

(; //LEAN:Nat.Prime.coprime_iff_not_dvd ;)
Nat__Prime__coprime_iff_not_dvd : (p : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (Nat__Coprime p n) (not (divide p n))).

(; //LEAN:Nat.Prime.dvd_mul ;)
Nat__Prime__dvd_mul : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (divide p (times m n)) (or (divide p m) (divide p n))).

(; //LEAN:Nat.Prime.dvd_or_dvd ;)
Nat__Prime__dvd_or_dvd : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> (h : Proof (divide p (times m n))) -> Proof (or (divide p m) (divide p n)).

(; //LEAN:Nat.prime_iff ;)
Nat__prime_iff : (p : Elem Nat) -> Proof (iff (prime p) (Prime p)).

(; //LEAN:Prime.nat_prime ;)
Prime__nat_prime : (p : Elem Nat) -> (h : Proof (Prime p)) -> Proof (prime p).

(; //LEAN:Nat.Prime.prime ;)
Nat__Prime__prime : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Prime p).

(; //LEAN:Nat.irreducible_iff_prime ;)
Nat__irreducible_iff_prime : (p : Elem Nat) -> Proof (iff (Irreducible p) (Prime p)).

(; //LEAN:Nat.Primes ;)
Nat__Primes : Set.

(; //LEAN:Nat.Primes.coe_nat_injective ;)
Nat__Primes__coe_nat_injective : Proof (Function__Injective (p => prime p)).

(; //LEAN:Nat.Primes.coe_nat_inj ;)
Nat__Primes__coe_nat_inj : (p : Elem Nat__Primes) -> (q : Elem Nat__Primes) -> Proof (iff (Eq p q) (Eqt Nat__Primes p q)).

