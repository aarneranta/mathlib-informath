(; //LEAN:Nat.minFac_le_div ;)
Nat__minFac_le_div : (n : Elem Nat) -> (pos : Proof (Lt 0 n)) -> (np : Proof (not (prime n))) -> Proof (Leq (Nat__minFac n) (div n (Nat__minFac n))).

