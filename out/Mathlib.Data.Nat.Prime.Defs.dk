  n => w => h => Trans__trans (Trans__trans (sq Nat (Nat__minFac n)) (Nat__mul_le_mul_right (Nat__minFac n) (div n (Nat__minFac n)) (Nat__minFac n) (Nat__minFac_le_div n w h))) (Nat__div_mul_le_self n (Nat__minFac n)).

(; //LEAN:Nat.minFac_eq_one_iff ;)
Nat__minFac_eq_one_iff : (n : Elem Nat) -> Proof (iff (Eq (Nat__minFac n) 1) (Eq n 1)).

(; //LEAN:Nat.minFac_eq_two_iff ;)
Nat__minFac_eq_two_iff : (n : Elem Nat) -> Proof (iff (Eq (Nat__minFac n) 2) (divide 2 n)).

(; //LEAN:Nat.factors_lemma ;)
def Nat__factors_lemma : (k : Elem Nat) -> Proof (Lt (div (plus k 2) (Nat__minFac (plus k 2))) (plus k 2)) :=
  k => Nat__div_lt_self (plus k 2) (Nat__minFac (plus k 2)) (Nat__zero_lt_succ (plus k 1)) (Nat__Prime__one_lt (Nat__minFac (plus k 2)) (Nat__minFac_prime (plus k 2) (Nat__ne_of_gt (plus k 2) 1 (Nat__succ_lt_succ 0 (plus k 1) (Nat__zero_lt_succ k))))).

(; //LEAN:Nat.exists_prime_and_dvd ;)
def Nat__exists_prime_and_dvd : (n : Elem Nat) -> (hn : Proof (Neq n 1)) -> Proof (exists Nat (p => and (prime p) (divide p n))) :=
  n => hn => existsI Nat (p => and (prime p) (divide p n)) (Nat__minFac n) (andI (prime (Nat__minFac n)) (divide (Nat__minFac n) n) (Nat__minFac_prime n hn) (Nat__minFac_dvd n)).

(; //LEAN:Nat.coprime_of_dvd ;)
Nat__coprime_of_dvd : (m : Elem Nat) -> (n : Elem Nat) -> (H : Proof (forall Nat (k => if (prime k) (if (divide k m) (not (divide k n)))))) -> Proof (Nat__Coprime m n).

(; //LEAN:Nat.Prime.coprime_iff_not_dvd ;)
Nat__Prime__coprime_iff_not_dvd : (p : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (Nat__Coprime p n) (not (divide p n))).

(; //LEAN:Nat.Prime.dvd_mul ;)
Nat__Prime__dvd_mul : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> Proof (iff (divide p (times m n)) (or (divide p m) (divide p n))).

(; //LEAN:Nat.Prime.dvd_or_dvd ;)
def Nat__Prime__dvd_or_dvd : (p : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (pp : Proof (prime p)) -> (h : Proof (divide p (times m n))) -> Proof (or (divide p m) (divide p n)) :=
  p => m => n => pp => iffEl (divide p (times m n)) (or (divide p m) (divide p n)) (Nat__Prime__dvd_mul p m n pp).

