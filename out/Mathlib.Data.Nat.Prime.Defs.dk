(; //LEAN:Prime.nat_prime ;)
def Prime__nat_prime : (p : Elem Nat) -> (h : Proof (Prime p)) -> Proof (prime p) :=
  p => iffEr (prime p) (Prime p) (Nat__prime_iff p).

(; //LEAN:Nat.Prime.prime ;)
def Nat__Prime__prime : (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (Prime p) :=
  p => iffEl (prime p) (Prime p) (Nat__prime_iff p).

(; //LEAN:Nat.irreducible_iff_prime ;)
def Nat__irreducible_iff_prime : (p : Elem Nat) -> Proof (iff (Irreducible p) (Prime p)) :=
  p => Nat__prime_iff p.

(; //LEAN:Nat.Primes ;)
def Nat__Primes : Set :=
  Subtype (p => prime p).

(; //LEAN:Nat.Primes.coe_nat_injective ;)
def Nat__Primes__coe_nat_injective : Proof (Function__Injective (p => prime p)) :=
  Subtype__coe_injective Nat (p => prime p).

(; //LEAN:Nat.Primes.coe_nat_inj ;)
def Nat__Primes__coe_nat_inj : (p : Elem Nat__Primes) -> (q : Elem Nat__Primes) -> Proof (iff (Eq p q) (Eqt Nat__Primes p q)) :=
  p => q => Iff__symm (Eqt (Subtype (x => prime x)) p q) (Eq p q) (Subtype__ext_iff Nat prime p q).

