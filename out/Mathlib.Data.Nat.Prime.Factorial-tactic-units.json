 {
  "name": "Nat__coprime_factorial_iff",
  "lean": "Nat.coprime_factorial_iff",
  "steps": [
   {
    "unit": "enough",
    "prop": "iff (Leq (Nat__minFac m) n) (exists Nat (p => and (prime p) (and (divide p m) (divide p (factorial n)))))",
    "by": "rw [← not_le, iff_not_comm, Nat.Prime.not_coprime_iff_dvd]",
    "depth": 0
   },
   {
    "unit": "enough",
    "prop": "and (if (Leq (Nat__minFac m) n) (exists Nat (p => and (prime p) (and (divide p m) (divide p (factorial n)))))) (if (exists Nat (p => and (prime p) (and (divide p m) (divide p (factorial n))))) (Leq (Nat__minFac m) n))",
    "by": "constructor",
    "depth": 0
   },
   {
    "unit": "hypos",
    "hypos": [
     [
      "h",
      "Proof (Leq (Nat__minFac m) n)"
     ]
    ],
    "by": "intro h",
    "goal": "exists Nat (p => and (prime p) (and (divide p m) (divide p (factorial n))))",
    "depth": 1
   },
   {
    "unit": "conclusion",
    "prop": "exists Nat (p => and (prime p) (and (divide p m) (divide p (factorial n))))",
    "by": "exact ⟨m.minFac, minFac_prime hm, minFac_dvd m, Nat.dvd_factorial (minFac_pos m) h⟩",
    "depth": 1
   },
   {
    "unit": "hypos",
    "hypos": [
     [
      "p",
      "Elem Nat"
     ],
     [
      "hp",
      "Proof (prime p)"
     ],
     [
      "hdvd",
      "Proof (divide p m)"
     ],
     [
      "hdvd'",
      "Proof (divide p (factorial n))"
     ]
    ],
    "by": "rintro ⟨p, hp, hdvd, hdvd'⟩",
    "depth": 1
   },
   {
    "unit": "conclusion",
    "prop": "Leq (Nat__minFac m) n",
    "by": "exact le_trans (minFac_le_of_dvd hp.two_le hdvd) (hp.dvd_factorial.mp hdvd')",
    "depth": 1
   }
  ]
 },
