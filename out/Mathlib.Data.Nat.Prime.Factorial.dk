(; Mathlib.Data.Nat.Prime.Factorial: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.Prime.dvd_factorial ;)
Nat__Prime__dvd_factorial : (n : Elem Nat) -> (p : Elem Nat) -> (h : Proof (prime p)) -> Proof (iff (divide p (factorial n)) (Leq p n)).

(; //LEAN:Nat.coprime_factorial_iff ;)
Nat__coprime_factorial_iff : (m : Elem Nat) -> (n : Elem Nat) -> (hm : Proof (Neq m 1)) -> Proof (iff (Nat__Coprime m (factorial n)) (Lt n (Nat__minFac m))).

(; //LEAN:Nat.Prime.coprime_factorial_of_lt ;)
Nat__Prime__coprime_factorial_of_lt : (p : Elem Nat) -> (n : Elem Nat) -> (hp : Proof (prime p)) -> (hn : Proof (Lt n p)) -> Proof (Nat__Coprime p (factorial n)).

(; //LEAN:Nat.Prime.coprime_descFactorial_of_lt_of_le ;)
Nat__Prime__coprime_descFactorial_of_lt_of_le : (p : Elem Nat) -> (n : Elem Nat) -> (k : Elem Nat) -> (hp : Proof (prime p)) -> (hn : Proof (Lt n p)) -> (hk : Proof (Leq k n)) -> Proof (Nat__Coprime p (Nat__descFactorial n k)).

