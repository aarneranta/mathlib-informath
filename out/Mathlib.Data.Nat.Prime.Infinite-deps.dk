(; constants used by Mathlib.Data.Nat.Prime.Infinite, declared with their translated types ;)

(; doc: A set is bounded above if there exists an upper bound. ;)
(; //LEAN:BddAbove ;)
BddAbove : (s : Elem (powerset x)) -> Prop.

(; //LEAN:Nat.Prime.not_dvd_one ;)
Nat__Prime__not_dvd_one : (p : Elem Nat) -> (pp : Proof (prime p)) -> Proof (not (divide p 1)).

(; //LEAN:Nat.dvd_add_iff_right ;)
Nat__dvd_add_iff_right : (k : Elem Nat) -> (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (divide k m)) -> Proof (iff (divide k n) (divide k (plus m n))).

(; //LEAN:Nat.dvd_factorial ;)
Nat__dvd_factorial : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Lt 0 m)) -> (h1 : Proof (Leq m n)) -> Proof (divide m (factorial n)).

(; //LEAN:Nat.factorial_pos ;)
Nat__factorial_pos : (n : Elem Nat) -> Proof (Lt 0 (factorial n)).

(; doc: Returns the smallest prime factor of `n ≠ 1`. ;)
(; //LEAN:Nat.minFac ;)
Nat__minFac : (n : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.minFac_dvd ;)
Nat__minFac_dvd : (n : Elem Nat) -> Proof (divide (Nat__minFac n) n).

(; //LEAN:Nat.minFac_pos ;)
Nat__minFac_pos : (n : Elem Nat) -> Proof (Lt 0 (Nat__minFac n)).

(; //LEAN:Nat.minFac_prime ;)
Nat__minFac_prime : (n : Elem Nat) -> (n1 : Proof (Neq n 1)) -> Proof (prime (Nat__minFac n)).

(; //LEAN:Nat.succ_lt_succ ;)
Nat__succ_lt_succ : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Lt n m)) -> Proof (Lt (succ n) (succ m)).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem x -> Prop)) -> Elem (powerset x).

(; //LEAN:le_of_not_ge ;)
le_of_not_ge : (x : Set) -> (_ : Proof (LinearOrder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (not (Leq a b))) -> Proof (Leq b a).

(; //LEAN:ne_of_gt ;)
ne_of_gt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

