(; Mathlib.Data.Nat.Prime.Infinite: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Nat.exists_infinite_primes ;)
Nat__exists_infinite_primes : (n : Elem Nat) -> Proof (exists Nat (p => and (Leq n p) (prime p))).

(; //LEAN:Nat.not_bddAbove_setOfPred_prime ;)
Nat__not_bddAbove_setOfPred_prime : Proof (not (BddAbove (Set__ofPred (p => prime p)))).

(; //LEAN:Nat.not_bddAbove_setOf_prime ;)
Nat__not_bddAbove_setOf_prime : Proof (not (BddAbove (Set__ofPred (p => prime p)))).

