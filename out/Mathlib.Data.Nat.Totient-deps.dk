(; constants used by Mathlib.Data.Nat.Totient, declared with their translated types ;)

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: **Alias** of the forward direction of `even_iff_two_dvd`. ;)
(; //LEAN:Even.two_dvd ;)
Even__two_dvd : (X : Set) -> (_ : Proof (Semiring X)) -> (a : Elem X) -> (h : Proof (even a)) -> Proof (divide 2 a).

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: The finset $[a, b)$ of elements `x` such that `a ≤ x` and `x < b`. Basically `Set.Ico a b` as a finset. ;)
(; //LEAN:Finset.Ico ;)
Finset__Ico : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (Finset X).

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (X : Set) -> (s : Elem (Finset X)) -> Elem Nat.

(; //LEAN:Finset.card_filter_le ;)
Finset__card_filter_le : (X : Set) -> (s : Elem (Finset X)) -> (p : (Elem X -> Prop)) -> Proof (Leq (Finset__card X (Finset__filter X (x1 => p x1) s)) (Finset__card X s)).

(; //LEAN:Finset.card_lt_card ;)
Finset__card_lt_card : (X : Set) -> (s : Elem (Finset X)) -> (t : Elem (Finset X)) -> (h : Proof (HasSSubset__SSubset (Finset X) s t)) -> Proof (Lt (Finset__card X s) (Finset__card X t)).

(; //LEAN:Finset.card_range ;)
Finset__card_range : (n : Elem Nat) -> Proof (Eq (Finset__card Nat (Finset__range n)) n).

(; doc: `Finset.filter p s` is the set of elements of `s` that satisfy `p`.  For example, one can use `s.filter (· ∈ t)` to get the intersection of `s` with `t : Set α` as a `Finset α` (when a `DecidablePred (· ∈ t)` instance is available). ;)
(; //LEAN:Finset.filter ;)
Finset__filter : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Finset X)) -> Elem (Finset X).

(; //LEAN:Finset.filter_ssubset ;)
Finset__filter_ssubset : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Finset X)) -> Proof (iff (HasSSubset__SSubset (Finset X) (Finset__filter X (x1 => p x1) s) s) (exists X (x2 => and (Membership__mem X (Finset X) s x2) (not (p x2))))).

(; //LEAN:Finset.mem_range._simp_1 ;)
Finset__mem_range___simp_1 : (n : Elem Nat) -> (m : Elem Nat) -> Proof (Eqt Prop (Membership__mem Nat (Finset Nat) (Finset__range n) m) (Lt m n)).

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `range n` is the set of natural numbers less than `n`. ;)
(; //LEAN:Finset.range ;)
Finset__range : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `prod f g` is the product of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.prod ;)
Finsupp__prod : (X : Set) -> (M : Set) -> (N : Set) -> (f : Elem (Finsupp X M)) -> (g : (Elem X -> Elem M -> N)) -> Elem N.

(; doc: `Fintype α` means that `α` is finite, i.e. there are only finitely many distinct elements of type `α`. The evidence of this is a finset `elems` (a list up to permutation without duplicates), together with a proof that everything of type `α` is in the list. ;)
(; //LEAN:Fintype ;)
Fintype : (X : Set) -> Prop.

(; doc: `card α` is the number of elements in `α`, defined when `α` is a fintype. ;)
(; //LEAN:Fintype.card ;)
Fintype__card : (X : Set) -> Elem Nat.

(; doc: Strict subset relation: `a ⊂ b`  Conventions for notations in identifiers:   * The recommended spelling of `⊂` in identifiers is `ssubset`. ;)
(; //LEAN:HasSSubset.SSubset ;)
HasSSubset__SSubset : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: **Alias** of `ne_of_gt`. ;)
(; //LEAN:LT.lt.ne' ;)
LT__lt__ne' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; doc: **Alias** of `lt_of_lt_of_eq`. ;)
(; //LEAN:LT.lt.trans_eq ;)
LT__lt__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Lt a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Lt a c).

(; doc: A `ParserDescr` is a grammar for parsers. This is used by the `syntax` command to produce parsers without having to `import Lean`. ;)
(; //LEAN:Lean.ParserDescr ;)
Lean__ParserDescr : Set.

(; doc: An extension for `positivity`. ;)
(; //LEAN:Mathlib.Meta.Positivity.PositivityExt ;)
Mathlib__Meta__Positivity__PositivityExt : Set.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; doc: `Nat.card α` is the cardinality of `α` as a natural number. If `α` is infinite, `Nat.card α = 0`. ;)
(; //LEAN:Nat.card ;)
Nat__card : (X : Set) -> Elem Nat.

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; //LEAN:Nat.coprime_zero_right._simp_1 ;)
Nat__coprime_zero_right___simp_1 : (n : Elem Nat) -> Proof (Eqt Prop (Nat__Coprime n 0) (Eq n 1)).

(; doc: `divisors n` is the `Finset` of divisors of `n`. By convention, we set `divisors 0 = ∅`. ;)
(; //LEAN:Nat.divisors ;)
Nat__divisors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `n.factorization` is the finitely supported function `ℕ →₀ ℕ` mapping each prime factor of `n` to its multiplicity in `n`. ;)
(; //LEAN:Nat.factorization ;)
Nat__factorization : (n : Elem Nat) -> Elem (Finsupp Nat Nat).

(; doc: The prime factors of a natural number as a finset. ;)
(; //LEAN:Nat.primeFactors ;)
Nat__primeFactors : (n : Elem Nat) -> Elem (Finset Nat).

(; //LEAN:Nat.prime_two ;)
Nat__prime_two : Proof (prime 2).

(; doc: A type-class version of `n ≠ 0`. ;)
(; //LEAN:NeZero ;)
NeZero : (R : Set) -> (n : Elem R) -> Prop.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (X : Set) -> (s : Elem (powerset X)) -> Set.

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Units of a `Monoid`, bundled version. Notation: `αˣ`.  An element of a `Monoid` is a unit if it has a two-sided inverse. This version bundles the inverse element so that it can be computed. For a predicate see `IsUnit`. ;)
(; //LEAN:Units ;)
Units : (X : Set) -> Set.

(; doc: The integers modulo `n : ℕ`. ;)
(; //LEAN:ZMod ;)
ZMod : (x : Elem Nat) -> Set.

(; //LEAN:and_self ;)
and_self : (p : Prop) -> Proof (Eqt Prop (and p p) p).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; //LEAN:eq_false ;)
eq_false : (p : Prop) -> (h : Proof (not p)) -> Proof (Eqt Prop p false).

(; //LEAN:eq_true ;)
eq_true : (p : Prop) -> (h : Proof p) -> Proof (Eqt Prop p True).

(; //LEAN:not_false_eq_true ;)
not_false_eq_true : Proof (Eqt Prop (not false) True).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:pos_of_gt ;)
pos_of_gt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (Preorder X)) -> (_ : Proof (IsBotZeroClass X)) -> (h1 : Proof (Lt a b)) -> Proof (Lt 0 b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

