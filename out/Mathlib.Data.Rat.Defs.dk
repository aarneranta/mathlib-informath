  q => n => d => hq => hqnd => ifI (Eq n 0) false (this => ifE (Eq q 0) false hq (Eq__mp (congrArg Rat Prop (Rat__divInt n d) 0 (Eq q) (Eq__trans Rat (Rat__divInt n d) (Rat__divInt 0 d) 0 (congrFun' Int Rat (Rat__divInt n) (Rat__divInt 0) (congrArg Int (Elem Int -> Rat) n 0 Rat__divInt this) d) (Rat__zero_divInt d))) hqnd)).

(; //LEAN:Rat.mk_denom_ne_zero_of_ne_zero ;)
def Rat__mk_denom_ne_zero_of_ne_zero : (q : Elem Rat) -> (n : Elem Int) -> (d : Elem Int) -> (hq : Proof (Neq q 0)) -> (hqnd : Proof (Eq q (Rat__divInt n d))) -> Proof (Neq d 0) :=
  q => n => d => hq => hqnd => ifI (Eq d 0) false (this => ifE (Eq q 0) false hq (Eq__mp (congrArg Rat Prop (Rat__divInt n d) 0 (Eq q) (Eq__trans Rat (Rat__divInt n d) (Rat__divInt n 0) 0 (congrArg Int Rat d 0 (Rat__divInt n) this) (Rat__divInt_zero n))) hqnd)).

