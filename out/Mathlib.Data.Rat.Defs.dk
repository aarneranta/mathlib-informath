(; //LEAN:Rat.num_one ;)
def Rat__num_one : Proof (Eq (Rat__num 1) 1) :=
  rfl Int (Rat__num 1).

(; //LEAN:Rat.den_one ;)
def Rat__den_one : Proof (Eq (Rat__den 1) 1) :=
  rfl Nat (Rat__den 1).

