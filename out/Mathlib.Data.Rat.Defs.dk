(; //LEAN:Rat.neg_def ;)
Rat__neg_def : (q : Elem Rat) -> Proof (Eq (Neg__neg q) (Rat__divInt (Neg__neg (Rat__num q)) (Rat__den q))).

(; //LEAN:Rat.divInt_neg ;)
def Rat__divInt_neg : (n : Elem Int) -> (d : Elem Int) -> Proof (Eq (Rat__divInt n (Neg__neg d)) (Rat__divInt (Neg__neg n) d)) :=
  n => d => Rat__divInt_neg' n d.

