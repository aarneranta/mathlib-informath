(; //LEAN:Rat.pos ;)
def Rat__pos : (a : Elem Rat) -> Proof (Lt 0 (Rat__den a)) :=
  a => Nat__pos_of_ne_zero (Rat__den a) (Rat__den_nz a).

(; //LEAN:Rat.mk'_num_den ;)
def Rat__mk'_num_den : (q : Elem Rat) -> Proof (Eq (Rat__mk' (Rat__num q) (Rat__den q) (Rat__den_nz q) (Rat__reduced q)) q) :=
  q => rfl Rat (Rat__mk' (Rat__num q) (Rat__den q) (Rat__den_nz q) (Rat__reduced q)).

(; //LEAN:Rat.ofInt_eq_cast ;)
def Rat__ofInt_eq_cast : (n : Elem Int) -> Proof (Eq (Rat__ofInt n) n) :=
  n => rfl Rat (Rat__ofInt n).

(; //LEAN:Rat.intCast_injective ;)
def Rat__intCast_injective : Proof (Function__Injective Rat__instIntCast) :=
  forallI Int (x => forall Int (x2 => if (Eq x x2) (Eq (Rat__num x) (Rat__num x2)))) (x => forallI Int (x1 => if (Eq x x1) (Eq (Rat__num x) (Rat__num x1))) (x1 => congr_arg Rat Int x x1 Rat__num)).

(; //LEAN:Rat.natCast_injective ;)
def Rat__natCast_injective : Proof (Function__Injective Rat__instNatCast) :=
  Function__Injective__comp Nat Int Rat Rat__instIntCast instNatCastInt Rat__intCast_injective (forallI Nat (x => forall Nat (x2 => if (Eq x x2) (Eq x x2))) (x => forallI Nat (x1 => if (Eq x x1) (Eq x x1)) (x1 => iffEl (Eq x x1) (Eq x x1) (Int__natCast_inj x x1)))).

(; //LEAN:Rat.intCast_eq_one_iff ;)
def Rat__intCast_eq_one_iff : (n : Elem Int) -> Proof (iff (Eq n 1) (Eq n 1)) :=
  n => Rat__intCast_inj n 1.

(; //LEAN:Rat.natCast_eq_one_iff ;)
def Rat__natCast_eq_one_iff : (n : Elem Nat) -> Proof (iff (Eq n 1) (Eq n 1)) :=
  n => Rat__natCast_inj n 1.

(; //LEAN:Rat.mkRat_eq_divInt ;)
def Rat__mkRat_eq_divInt : (n : Elem Int) -> (d : Elem Nat) -> Proof (Eq (mkRat n d) (Rat__divInt n d)) :=
  n => d => rfl Rat (mkRat n d).

(; //LEAN:Rat.mk'_zero ;)
Rat__mk'_zero : (d : Elem Nat) -> (h : Proof (Neq d 0)) -> (w : Proof (Nat__Coprime (Int__natAbs 0) d)) -> Proof (Eq (Rat__mk' 0 d h w) 0).

(; //LEAN:Rat.num_ne_zero ;)
def Rat__num_ne_zero : (q : Elem Rat) -> Proof (iff (Neq (Rat__num q) 0) (Neq q 0)) :=
  q => Iff__not (Eq (Rat__num q) 0) (Eq q 0) (Rat__num_eq_zero q).

(; //LEAN:Rat.den_ne_zero ;)
def Rat__den_ne_zero : (q : Elem Rat) -> Proof (Neq (Rat__den q) 0) :=
  q => LT__lt__ne' Nat (Rat__den q) 0 (Rat__den_pos q).

(; //LEAN:Rat.divInt_eq_zero ;)
Rat__divInt_eq_zero : (a : Elem Int) -> (b : Elem Int) -> (b0 : Proof (Neq b 0)) -> Proof (iff (Eq (Rat__divInt a b) 0) (Eq a 0)).

(; //LEAN:Rat.divInt_ne_zero ;)
def Rat__divInt_ne_zero : (a : Elem Int) -> (b : Elem Int) -> (b0 : Proof (Neq b 0)) -> Proof (iff (Neq (Rat__divInt a b) 0) (Neq a 0)) :=
  a => b => b0 => Iff__not (Eq (Rat__divInt a b) 0) (Eq a 0) (Rat__divInt_eq_zero a b b0).

(; //LEAN:Rat.mkRat_num_den' ;)
def Rat__mkRat_num_den' : (a : Elem Rat) -> Proof (Eq (mkRat (Rat__num a) (Rat__den a)) a) :=
  Rat__mkRat_self.

(; //LEAN:Rat.intCast_eq_divInt ;)
def Rat__intCast_eq_divInt : (z : Elem Int) -> Proof (Eq z (Rat__divInt z 1)) :=
  z => Rat__mk_eq_divInt z 1 instInhabitedRat___proof_1 (Rat__ofInt___proof_1 z).

