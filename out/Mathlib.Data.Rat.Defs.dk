Rat__divInt_mul_divInt_cancel : (x : Elem Int) -> (hx : Proof (Neq x 0)) -> (n : Elem Int) -> (d : Elem Int) -> Proof (Eq (times (Rat__divInt n x) (Rat__divInt x d)) (Rat__divInt n d)).

