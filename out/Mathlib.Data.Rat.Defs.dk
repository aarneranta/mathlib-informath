(; //LEAN:Rat.mul_eq_mkRat ;)
Rat__mul_eq_mkRat : (q : Elem Rat) -> (r : Elem Rat) -> Proof (Eq (times q r) (mkRat (times (Rat__num q) (Rat__num r)) (times (Rat__den q) (Rat__den r)))).

(; //LEAN:Rat.pow_eq_mkRat ;)
Rat__pow_eq_mkRat : (q : Elem Rat) -> (n : Elem Nat) -> Proof (Eq (pow q n) (mkRat (pow (Rat__num q) n) (pow (Rat__den q) n))).

(; //LEAN:Rat.pow_eq_divInt ;)
Rat__pow_eq_divInt : (q : Elem Rat) -> (n : Elem Nat) -> Proof (Eq (pow q n) (Rat__divInt (pow (Rat__num q) n) (pow (Rat__den q) n))).

(; //LEAN:Rat.mk'_pow ;)
def Rat__mk'_pow : (num : Elem Int) -> (den : Elem Nat) -> (hd : Proof (Neq den 0)) -> (hdn : Proof (Nat__Coprime (Int__natAbs num) den)) -> (n : Elem Nat) -> Proof (Eq (pow (Rat__mk' num den hd hdn) n) (Rat__mk' (pow num n) (pow den n) (Rat__mk'_pow___proof_2 den hd n) (Rat__mk'_pow___proof_3 num den hdn n))) :=
  num => den => hd => hdn => n => rfl Rat (pow (Rat__mk' num den hd hdn) n).

(; //LEAN:Rat.inv_mkRat ;)
Rat__inv_mkRat : (a : Elem Int) -> (b : Elem Nat) -> Proof (Eq (Inv__inv (mkRat a b)) (Rat__divInt b a)).

(; //LEAN:Rat.divInt_div_divInt ;)
Rat__divInt_div_divInt : (x : Elem Int) -> (x1 : Elem Int) -> (x2 : Elem Int) -> (x3 : Elem Int) -> Proof (Eq (div (Rat__divInt x x1) (Rat__divInt x2 x3)) (Rat__divInt (times x x3) (times x1 x2))).

(; //LEAN:Rat.div_def' ;)
Rat__div_def' : (q : Elem Rat) -> (r : Elem Rat) -> Proof (Eq (div q r) (Rat__divInt (times (Rat__num q) (Rat__den r)) (times (Rat__den q) (Rat__num r)))).

