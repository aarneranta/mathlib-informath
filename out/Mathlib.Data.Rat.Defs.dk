def Rat__divInt_ne_zero_of_ne_zero : (n : Elem Int) -> (d : Elem Int) -> (h : Proof (Neq n 0)) -> (hd : Proof (Neq d 0)) -> Proof (Neq (Rat__divInt n d) 0) :=
  n => d => h => hd => iffEr (Neq (Rat__divInt n d) 0) (Neq n 0) (Rat__divInt_ne_zero n d hd) h.

(; //LEAN:Rat.add_divInt ;)
Rat__add_divInt : (a : Elem Int) -> (b : Elem Int) -> (c : Elem Int) -> Proof (Eq (Rat__divInt (plus a b) c) (plus (Rat__divInt a c) (Rat__divInt b c))).

(; //LEAN:Rat.intCast_div_eq_divInt ;)
Rat__intCast_div_eq_divInt : (n : Elem Int) -> (d : Elem Int) -> Proof (Eq (div n d) (Rat__divInt n d)).

