(; //LEAN:Rat.num_neg_eq_neg_num ;)
def Rat__num_neg_eq_neg_num : (q : Elem Rat) -> Proof (Eq (Rat__num (Neg__neg q)) (Neg__neg (Rat__num q))) :=
  q => rfl Int (Rat__num (Neg__neg q)).

(; //LEAN:Rat.num_zero ;)
def Rat__num_zero : Proof (Eq (Rat__num 0) 0) :=
  rfl Int (Rat__num 0).

(; //LEAN:Rat.den_zero ;)
def Rat__den_zero : Proof (Eq (Rat__den 0) 1) :=
  rfl Nat (Rat__den 0).

