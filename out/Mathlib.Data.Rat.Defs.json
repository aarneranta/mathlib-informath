{"lean": "Rat.lift_binop_eq", "dk": "Rat__lift_binop_eq", "kind": "theorem", "doc": "", "statement": "∀ (f : ℚ → ℚ → ℚ) (f₁ f₂ : ℤ → ℤ → ℤ → ℤ → ℤ),\n  (∀ {n₁ : ℤ} {d₁ : ℕ} {h₁ : d₁ ≠ 0} {c₁ : n₁.natAbs.Coprime d₁} {n₂ : ℤ} {d₂ : ℕ} {h₂ : d₂ ≠ 0}\n      {c₂ : n₂.natAbs.Coprime d₂},\n      f { num := n₁, den := d₁, den_nz := h₁, reduced := c₁ } { num := n₂, den := d₂, den_nz := h₂, reduced := c₂ } =\n        Rat.divInt (f₁ n₁ (↑d₁) n₂ ↑d₂) (f₂ n₁ (↑d₁) n₂ ↑d₂)) →\n    (∀ {n₁ d₁ n₂ d₂ : ℤ}, d₁ ≠ 0 → d₂ ≠ 0 → f₂ n₁ d₁ n₂ d₂ ≠ 0) →\n      ∀ (a b c d : ℤ),\n        b ≠ 0 →\n          d ≠ 0 →\n            (∀ {n₁ d₁ n₂ d₂ : ℤ},\n                a * d₁ = n₁ * b → c * d₂ = n₂ * d → f₁ n₁ d₁ n₂ d₂ * f₂ a b c d = f₁ a b c d * f₂ n₁ d₁ n₂ d₂) →\n              f (Rat.divInt a b) (Rat.divInt c d) = Rat.divInt (f₁ a b c d) (f₂ a b c d)", "line": 81, "nameLine": 81, "endLine": 97, "definiens": false},
