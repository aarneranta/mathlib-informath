(; constants used by Mathlib.Data.Set.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Equiv__setSubtypeComm__app : (a1 : (Elem X -> Prop)) -> (a2 : Elem (powerset (Subtype (a1 => p a1)))) -> Elem (Subtype (s2 => forall X (a2 => if (Membership__mem s2 a2) (p a2)))).

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv (powerset (Subtype (a1 => p a1))) (Subtype (s1 => forall X (a2 => if (Membership__mem s1 a2) (p a2)))))) -> (a2 : Elem (Subtype (s2 => forall X (a3 => if (Membership__mem s2 a3) (p a3))))) -> Elem (powerset (Subtype (a4 => p a4))).

(; a constant applied as a function: DFunLike.coe ;)
Set__memEquiv__app : (a1 : Elem (powerset X)) -> (a2 : Elem X) -> Prop.

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: Given that there exists an element satisfying `p`, returns one such element.  This is a straightforward consequence of, and equivalent to, `Classical.choice`.  See also `choose_spec`, which asserts that the returned value has property `p`. ;)
(; //LEAN:Classical.choose ;)
Classical__choose : (h : Proof (exists X (x => p x))) -> Elem X.

(; //LEAN:Classical.choose_spec ;)
Classical__choose_spec : (X : Set) -> (p : (Elem X -> Prop)) -> (h : Proof (exists X (x => p x))) -> Proof (p (Classical__choose h)).

(; doc: The Double Negation Theorem: `¬¬P` is equivalent to `P`. The left-to-right direction, double negation elimination (DNE), is classically true but not constructively. ;)
(; //LEAN:Classical.not_not ;)
Classical__not_not : (a : Prop) -> Proof (iff (not (not a)) a).

(; //LEAN:Classical.or_iff_not_imp_left ;)
Classical__or_iff_not_imp_left : (a : Prop) -> (b : Prop) -> Proof (iff (or a b) (if (not a) b)).

(; doc: Set / lattice complement  Conventions for notations in identifiers:   * The recommended spelling of `ᶜ` in identifiers is `compl`. ;)
(; //LEAN:Compl.compl ;)
Compl__compl : (x : Elem X) -> Elem X.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : Elem X.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.bijective ;)
Equiv__bijective : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Proof (Function__Bijective e).

(; //LEAN:Equiv.injective ;)
Equiv__injective : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Proof (Function__Injective e).

(; //LEAN:Equiv.mk ;)
Equiv__mk : (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; //LEAN:Equiv.setSubtypeComm._proof_1 ;)
Equiv__setSubtypeComm___proof_1 : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (powerset (Subtype (a3 => p a3)))) -> Proof (Eqt (powerset (Subtype (a => p a))) ((s1 => Set__ofPred (a1 => Membership__mem s1 a1)) ((s2 => Set__ofPred (a2 => exists (p a2) (h => Membership__mem s2 a2))) s)) s).

(; //LEAN:Equiv.setSubtypeComm._proof_2 ;)
Equiv__setSubtypeComm___proof_2 : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Subtype (s4 => forall X (a3 => if (Membership__mem s4 a3) (p a3))))) -> Proof (Eqt (Subtype (s1 => forall X (a => if (Membership__mem s1 a) (p a)))) ((s2 => Set__ofPred (a1 => exists (p a1) (h1 => Membership__mem s2 a1))) ((s3 => Set__ofPred (a2 => Membership__mem s3 a2)) s)) s).

(; //LEAN:Equiv.surjective ;)
Equiv__surjective : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Proof (Function__Surjective e).

(; //LEAN:Exists.imp ;)
Exists__imp : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => if (p a2) (q a2)))) -> (h1 : Proof (exists X (a1 => p a1))) -> Proof (exists X (a => q a)).

(; doc: A function is called bijective if it is both injective and surjective. ;)
(; //LEAN:Function.Bijective ;)
Function__Bijective : (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Function.Injective.eq_iff ;)
Function__Injective__eq_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (I : Proof (Function__Injective f)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt Y (f a) (f b)) (Eqt X a b)).

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (f : (Elem X -> Y)) -> Prop.

(; doc: Strict subset relation: `a ⊂ b`  Conventions for notations in identifiers:   * The recommended spelling of `⊂` in identifiers is `ssubset`. ;)
(; //LEAN:HasSSubset.SSubset ;)
HasSSubset__SSubset : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; //LEAN:Iff.not_right ;)
Iff__not_right : (a : Prop) -> (b : Prop) -> (h : Proof (iff (not a) b)) -> Proof (iff a (not b)).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `default` is a function that produces a "default" element of any `Inhabited` type. This element does not have any particular specified properties, but it is often an all-zeroes value. ;)
(; //LEAN:Inhabited.default ;)
Inhabited__default : Elem X.

(; doc: `a ∩ b` is the intersection of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∩` in identifiers is `inter`. ;)
(; //LEAN:Inter.inter ;)
Inter__inter : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `IsEmpty α` expresses that `α` is empty. ;)
(; //LEAN:IsEmpty ;)
IsEmpty : (X : Set) -> Prop.

(; //LEAN:IsEmpty.false ;)
IsEmpty__false : (X : Set) -> (_ : Proof (IsEmpty X)) -> (x : Elem X) -> Proof false.

(; //LEAN:IsEmpty.mk ;)
IsEmpty__mk : (X : Set) -> (false : Proof (forall X (x => false))) -> Proof (IsEmpty X).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (f : (Elem X -> Y)) -> Prop.

(; doc: `Nonempty α` is a typeclass that says that `α` is not an empty type, that is, there exists an element in the type. It differs from `Inhabited α` in that `Nonempty α` is a `Prop`, which means that it does not actually carry an element of `α`, only a proof that *there exists* such an element. Given `Nonempty α`, you can construct an element of `α` *nonconstructively* using `Classical.choice`. ;)
(; //LEAN:Nonempty ;)
Nonempty : (X : Set) -> Prop.

(; doc: `a \ b` is the set difference of `a` and `b`, consisting of all elements in `a` that are not in `b`.  Conventions for notations in identifiers:   * The recommended spelling of `\` in identifiers is `sdiff`. ;)
(; //LEAN:SDiff.sdiff ;)
SDiff__sdiff : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (s : Elem (powerset X)) -> Set.

(; doc: Membership in a set. Use the `∈` notation instead. ;)
(; //LEAN:Set.Mem ;)
Set__Mem : (self : Elem (powerset X)) -> (x : Elem X) -> Prop.

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (s : Elem (powerset X)) -> Prop.

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem a x) (Membership__mem b x)))) -> Proof (Eqt (powerset X) a b).

(; //LEAN:Set.memEquiv._proof_1 ;)
Set__memEquiv___proof_1 : (X : Set) -> Proof (Function__LeftInverse Set__ofPred Membership__mem).

(; //LEAN:Set.memEquiv._proof_2 ;)
Set__memEquiv___proof_2 : (X : Set) -> Proof (Function__RightInverse Set__ofPred Membership__mem).

(; //LEAN:Set.mem_univ ;)
Set__mem_univ : (X : Set) -> (x : Elem X) -> Proof (Membership__mem Set__univ x).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: `𝒫 s` is the set of all subsets of `s`. ;)
(; //LEAN:Set.powerset ;)
Set__powerset : (s : Elem (powerset X)) -> Elem (powerset (powerset X)).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : Elem (powerset X).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.exists ;)
Subtype__exists : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem (Subtype (a2 => p a2)) -> Prop)) -> Proof (iff (exists (Subtype (a => p a)) (x => q x)) (exists X (a1 => exists (p a1) (b => q a1)))).

(; //LEAN:Subtype.ext ;)
Subtype__ext : (X : Set) -> (p : (Elem X -> Prop)) -> (a1 : Elem (Subtype (x2 => p x2))) -> (a2 : Elem (Subtype (x1 => p x1))) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt (Subtype (x => p x)) a1 a2).

(; //LEAN:Subtype.forall ;)
Subtype__forall : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem (Subtype (a2 => p a2)) -> Prop)) -> Proof (iff (forall (Subtype (a => p a)) (x => q x)) (forall X (a1 => forall (Proof (p a1)) (b => q a1)))).

(; doc: A version of `x.property` or `x.2` where `p` is syntactically applied to the coercion of `x` instead of `x.1`. A similar result is `Subtype.mem` in `Mathlib/Data/Set/Basic.lean`. ;)
(; //LEAN:Subtype.prop ;)
Subtype__prop : (X : Set) -> (p : (Elem X -> Prop)) -> (x : Elem (Subtype (x1 => p x1))) -> Proof (p x).

(; doc: The proof that `val` satisfies the predicate `p`. ;)
(; //LEAN:Subtype.property ;)
Subtype__property : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype (x => p x))) -> Proof (p self).

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Unique α` expresses that `α` is a type with a unique term `default`.  This is implemented as a type, rather than a `Prop`-valued predicate, for good definitional properties of the default term. ;)
(; //LEAN:Unique ;)
Unique : (X : Set) -> Prop.

(; //LEAN:and_assoc ;)
and_assoc : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (and (and a b) c) (and a (and b c))).

(; //LEAN:and_comm ;)
and_comm : (a : Prop) -> (b : Prop) -> Proof (iff (and a b) (and b a)).

(; //LEAN:and_false ;)
and_false : (p : Prop) -> Proof (Eqt Prop (and p false) false).

(; //LEAN:and_iff_left ;)
and_iff_left : (b : Prop) -> (a : Prop) -> (hb : Proof b) -> Proof (iff (and a b) a).

(; //LEAN:and_left_comm ;)
and_left_comm : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (and a (and b c)) (and b (and a c))).

(; //LEAN:and_right_comm ;)
and_right_comm : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (and (and a b) c) (and (and a c) b)).

(; //LEAN:and_self_iff ;)
and_self_iff : (a : Prop) -> Proof (iff (and a a) a).

(; //LEAN:bot_lt_iff_ne_bot ;)
bot_lt_iff_ne_bot : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> Proof (iff (Lt Bot__bot a) (Neq a Bot__bot)).

(; doc: Cast across a type equality. If `h : α = β` is an equality of types, and `a : α`, then `a : β` will usually not typecheck directly, but this function will allow you to work around this and embed `a` in type `β` as `cast h a : β`.  It is best to avoid this function if you can, because it is more complicated to reason about terms containing casts, but if the types don't match up definitionally sometimes there isn't anything better you can do.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:cast ;)
cast : (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: "Dependent" if-then-else, normally written via the notation `if h : c then t(h) else e(h)`, is sugar for `dite c (fun h => t(h)) (fun h => e(h))`, and it is the same as `if c then t else e` except that `t` is allowed to depend on a proof `h : c`, and `e` can depend on `h : ¬c`. (Both branches use the same name for the hypothesis, even though it has different types in the two cases.)  We use this to be able to communicate the if-then-else condition to the branches. For example, `Array.get arr i h` expects a proof `h : i < arr.size` in order to avoid a bounds check, so you can write `if h : i < arr.size then arr.get i h else ...` to avoid the bounds check inside the if branch. (Of course in this case we have only lifted the check into an explicit `if`, but we could also use this proof multiple times or derive `i < arr.size` from some other proposition that we are checking in the `if`.)  Conventions for notations in identifiers:   * The recommended spelling of `if h : c then t else e` in identifiers is `dite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:dite ;)
dite : (c : Prop) -> (t : (Proof c -> X)) -> (e : (Proof (not c) -> X)) -> Elem X.

(; //LEAN:eq_of_forall_ge_iff ;)
eq_of_forall_ge_iff : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (H : Proof (forall X (c => iff (Leq a c) (Leq b c)))) -> Proof (Eqt X a b).

(; //LEAN:eq_or_lt_of_le ;)
eq_or_lt_of_le : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> Proof (or (Eqt X a b) (Lt a b)).

(; //LEAN:exists_or ;)
exists_or : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> Proof (iff (exists X (x => or (p x) (q x))) (or (exists X (x1 => p x1)) (exists X (x2 => q x2)))).

(; //LEAN:exists_prop._simp_1 ;)
exists_prop___simp_1 : (b : Prop) -> (a : Prop) -> Proof (Eqt Prop (exists a (_h => b)) (and a b)).

(; //LEAN:false_and ;)
false_and : (p : Prop) -> Proof (Eqt Prop (and false p) false).

(; //LEAN:false_or ;)
false_or : (p : Prop) -> Proof (Eqt Prop (or false p) p).

(; //LEAN:forall_and ;)
forall_and : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> Proof (iff (forall X (x => and (p x) (q x))) (and (forall X (x1 => p x1)) (forall X (x2 => q x2)))).

(; //LEAN:forall_congr' ;)
forall_congr' : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => iff (p a2) (q a2)))) -> Proof (iff (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:iff_false_intro ;)
iff_false_intro : (a : Prop) -> (h : Proof (not a)) -> Proof (iff a false).

(; //LEAN:iff_of_eq ;)
iff_of_eq : (a : Prop) -> (b : Prop) -> (h : Proof (Eqt Prop a b)) -> Proof (iff a b).

(; //LEAN:iff_of_true ;)
iff_of_true : (a : Prop) -> (b : Prop) -> (ha : Proof a) -> (hb : Proof b) -> Proof (iff a b).

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:iff_true_intro ;)
iff_true_intro : (a : Prop) -> (h : Proof a) -> Proof (iff a True).

(; //LEAN:imp_and ;)
imp_and : (b : Prop) -> (c : Prop) -> (X : Set) -> Proof (iff (forall X (x => and b c)) (and (forall X (x1 => b)) (forall X (x2 => c)))).

(; //LEAN:imp_iff_right ;)
imp_iff_right : (b : Prop) -> (a : Prop) -> (ha : Proof a) -> Proof (iff (if a b) b).

(; //LEAN:inf_congr_left ;)
inf_congr_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hb : Proof (Leq (Min__min a c) b)) -> (hc : Proof (Leq (Min__min a b) c)) -> Proof (Eqt X (Min__min a b) (Min__min a c)).

(; //LEAN:inf_congr_right ;)
inf_congr_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (ha : Proof (Leq (Min__min b c) a)) -> (hb : Proof (Leq (Min__min a c) b)) -> Proof (Eqt X (Min__min a c) (Min__min b c)).

(; //LEAN:inf_eq_inf_iff_left ;)
inf_eq_inf_iff_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Eqt X (Min__min a b) (Min__min a c)) (and (Leq (Min__min a c) b) (Leq (Min__min a b) c))).

(; //LEAN:inf_eq_inf_iff_right ;)
inf_eq_inf_iff_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Eqt X (Min__min a c) (Min__min b c)) (and (Leq (Min__min b c) a) (Leq (Min__min a c) b))).

(; //LEAN:inf_eq_inf_mono_left ;)
inf_eq_inf_mono_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Eqt X (Min__min a b) (Min__min a c))) -> (had : Proof (Leq d a)) -> Proof (Eqt X (Min__min d b) (Min__min d c)).

(; //LEAN:inf_eq_inf_mono_right ;)
inf_eq_inf_mono_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Eqt X (Min__min a c) (Min__min b c))) -> (hcd : Proof (Leq d c)) -> Proof (Eqt X (Min__min a d) (Min__min b d)).

(; //LEAN:inf_eq_left ;)
inf_eq_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Min__min a b) a) (Leq a b)).

(; //LEAN:inf_eq_right ;)
inf_eq_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Min__min a b) b) (Leq b a)).

(; //LEAN:inf_inf_distrib_left ;)
inf_inf_distrib_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Min__min a (Min__min b c)) (Min__min (Min__min a b) (Min__min a c))).

(; //LEAN:inf_inf_distrib_right ;)
inf_inf_distrib_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Min__min (Min__min a b) c) (Min__min (Min__min a c) (Min__min b c))).

(; //LEAN:inf_inf_inf_comm ;)
inf_inf_inf_comm : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> Proof (Eqt X (Min__min (Min__min a b) (Min__min c d)) (Min__min (Min__min a c) (Min__min b d))).

(; //LEAN:inf_le_inf ;)
inf_le_inf : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq d c)) -> Proof (Leq (Min__min b d) (Min__min a c)).

(; //LEAN:inf_lt_left ;)
inf_lt_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt (Min__min a b) a) (not (Leq a b))).

(; //LEAN:inf_lt_right ;)
inf_lt_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt (Min__min a b) b) (not (Leq b a))).

(; //LEAN:inf_sup_left ;)
inf_sup_left : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Min__min a (Max__max b c)) (Max__max (Min__min a b) (Min__min a c))).

(; //LEAN:inf_sup_right ;)
inf_sup_right : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Min__min (Max__max a b) c) (Max__max (Min__min a c) (Min__min b c))).

(; //LEAN:inf_top_eq ;)
inf_top_eq : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Eqt X (Min__min a Top__top) a).

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; //LEAN:left_eq_inf ;)
left_eq_inf : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a (Min__min a b)) (Leq a b)).

(; //LEAN:left_lt_sup ;)
left_lt_sup : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt a (Max__max a b)) (not (Leq b a))).

(; //LEAN:lt_iff_le_and_ne ;)
lt_iff_le_and_ne : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt a b) (and (Leq a b) (Neq a b))).

(; //LEAN:lt_top_iff_ne_top ;)
lt_top_iff_ne_top : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (iff (Lt a Top__top) (Neq a Top__top)).

(; //LEAN:mt ;)
mt : (a : Prop) -> (b : Prop) -> (h : Proof (if a b)) -> (h1 : Proof (not b)) -> Proof (not a).

(; //LEAN:ne_comm ;)
ne_comm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Neq a b) (Neq b a)).

(; //LEAN:nonempty_subtype ;)
nonempty_subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Proof (iff (Nonempty (Subtype (x => p x))) (exists X (a => p a))).

(; //LEAN:nonempty_subtype._simp_1 ;)
nonempty_subtype___simp_1 : (X : Set) -> (p : (Elem X -> Prop)) -> Proof (Eqt Prop (Nonempty (Subtype (x => p x))) (exists X (a => p a))).

(; //LEAN:not_iff_not ;)
not_iff_not : (a : Prop) -> (b : Prop) -> Proof (iff (iff (not a) (not b)) (iff a b)).

(; //LEAN:not_isEmpty_iff._simp_1 ;)
not_isEmpty_iff___simp_1 : (X : Set) -> Proof (Eqt Prop (not (IsEmpty X)) (Nonempty X)).

(; //LEAN:not_isEmpty_of_nonempty ;)
not_isEmpty_of_nonempty : (X : Set) -> (_ : Proof (Nonempty X)) -> Proof (not (IsEmpty X)).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:or_assoc ;)
or_assoc : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (or (or a b) c) (or a (or b c))).

(; //LEAN:or_comm ;)
or_comm : (a : Prop) -> (b : Prop) -> Proof (iff (or a b) (or b a)).

(; //LEAN:or_false ;)
or_false : (p : Prop) -> Proof (Eqt Prop (or p false) p).

(; //LEAN:or_imp ;)
or_imp : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (if (or a b) c) (and (if a c) (if b c))).

(; //LEAN:or_left_comm ;)
or_left_comm : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (or a (or b c)) (or b (or a c))).

(; //LEAN:or_right_comm ;)
or_right_comm : (a : Prop) -> (b : Prop) -> (c : Prop) -> Proof (iff (or (or a b) c) (or (or a c) b)).

(; //LEAN:or_self_iff ;)
or_self_iff : (a : Prop) -> Proof (iff (or a a) a).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:right_eq_inf ;)
right_eq_inf : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X b (Min__min a b)) (Leq b a)).

(; //LEAN:right_lt_sup ;)
right_lt_sup : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt b (Max__max a b)) (not (Leq a b))).

(; //LEAN:sup_congr_left ;)
sup_congr_left : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hb : Proof (Leq b (Max__max a c))) -> (hc : Proof (Leq c (Max__max a b))) -> Proof (Eqt X (Max__max a b) (Max__max a c)).

(; //LEAN:sup_congr_right ;)
sup_congr_right : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (ha : Proof (Leq a (Max__max b c))) -> (hb : Proof (Leq b (Max__max a c))) -> Proof (Eqt X (Max__max a c) (Max__max b c)).

(; //LEAN:sup_eq_left ;)
sup_eq_left : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Max__max a b) a) (Leq b a)).

(; //LEAN:sup_eq_right ;)
sup_eq_right : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Max__max a b) b) (Leq a b)).

(; //LEAN:sup_eq_sup_iff_left ;)
sup_eq_sup_iff_left : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Eqt X (Max__max a b) (Max__max a c)) (and (Leq b (Max__max a c)) (Leq c (Max__max a b)))).

(; //LEAN:sup_eq_sup_iff_right ;)
sup_eq_sup_iff_right : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Eqt X (Max__max a c) (Max__max b c)) (and (Leq a (Max__max b c)) (Leq b (Max__max a c)))).

(; //LEAN:sup_eq_sup_mono_left ;)
sup_eq_sup_mono_left : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Eqt X (Max__max a b) (Max__max a c))) -> (had : Proof (Leq a d)) -> Proof (Eqt X (Max__max d b) (Max__max d c)).

(; //LEAN:sup_eq_sup_mono_right ;)
sup_eq_sup_mono_right : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Eqt X (Max__max a c) (Max__max b c))) -> (hcd : Proof (Leq c d)) -> Proof (Eqt X (Max__max a d) (Max__max b d)).

(; //LEAN:sup_inf_left ;)
sup_inf_left : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c))).

(; //LEAN:sup_inf_right ;)
sup_inf_right : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max (Min__min a b) c) (Min__min (Max__max a c) (Max__max b c))).

(; //LEAN:sup_le_sup ;)
sup_le_sup : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq c d)) -> Proof (Leq (Max__max a c) (Max__max b d)).

(; //LEAN:sup_sup_distrib_left ;)
sup_sup_distrib_left : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max a (Max__max b c)) (Max__max (Max__max a b) (Max__max a c))).

(; //LEAN:sup_sup_distrib_right ;)
sup_sup_distrib_right : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max (Max__max a b) c) (Max__max (Max__max a c) (Max__max b c))).

(; //LEAN:sup_sup_sup_comm ;)
sup_sup_sup_comm : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> Proof (Eqt X (Max__max (Max__max a b) (Max__max c d)) (Max__max (Max__max a c) (Max__max b d))).

(; //LEAN:sup_top_eq ;)
sup_top_eq : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Eqt X (Max__max a Top__top) Top__top).

(; //LEAN:top_inf_eq ;)
top_inf_eq : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Eqt X (Min__min Top__top a) a).

(; //LEAN:top_le_iff ;)
top_le_iff : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (iff (Leq Top__top a) (Eqt X a Top__top)).

(; //LEAN:top_sup_eq ;)
top_sup_eq : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Eqt X (Max__max Top__top a) Top__top).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

