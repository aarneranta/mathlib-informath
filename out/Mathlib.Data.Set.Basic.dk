Set__sep_eq_self_iff_mem_true : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (Eqt (powerset X) (Set__ofPred (x => and (Membership__mem s x) (p x))) s) (forall X (x1 => if (Membership__mem s x1) (p x1)))).

(; //LEAN:Set.sep_eq_empty_iff_mem_false ;)
Set__sep_eq_empty_iff_mem_false : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (Eqt (powerset X) (Set__ofPred (x => and (Membership__mem s x) (p x))) EmptyCollection__emptyCollection) (forall X (x1 => if (Membership__mem s x1) (not (p x1))))).

(; //LEAN:Set.sep_true ;)
def Set__sep_true : (X : Set) -> (s : Elem (powerset X)) -> Proof (Eqt (powerset X) (Set__ofPred (x => and (Membership__mem s x) True)) s) :=
