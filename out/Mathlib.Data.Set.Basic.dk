(; //LEAN:Set.subset_inter_iff ;)
def Set__subset_inter_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> Proof (iff (Set__Subset r (Inter__inter s t)) (and (Set__Subset r s) (Set__Subset r t))) :=
