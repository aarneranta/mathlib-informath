(; //LEAN:Set.sep_ext_iff ;)
Set__sep_ext_iff : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> Proof (iff (Eqt (powerset X) (Set__ofPred (x => and (Membership__mem s x) (p x))) (Set__ofPred (x1 => and (Membership__mem s x1) (q x1)))) (forall X (x2 => if (Membership__mem s x2) (iff (p x2) (q x2))))).

