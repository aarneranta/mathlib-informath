  X => x => Set__ext X Set__univ (Singleton__singleton Inhabited__default) (forallI X (x1 => iff (Membership__mem Set__univ x1) (Membership__mem (Singleton__singleton Inhabited__default) x1)) (x1 => iff_of_true (Membership__mem Set__univ x1) (Membership__mem (Singleton__singleton Inhabited__default) x1) trivial (Subsingleton__elim X x1 Inhabited__default))).

(; //LEAN:Set.ssubset_univ_iff ;)
def Set__ssubset_univ_iff : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset s Set__univ) (Neq s Set__univ)) :=
  X => s => lt_top_iff_ne_top (powerset X) s.

(; //LEAN:Set.ssubset_univ_iff_nonempty_compl ;)
Set__ssubset_univ_iff_nonempty_compl : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset s Set__univ) (Set__Nonempty (Compl__compl s))).

(; //LEAN:Set.Nonempty.ssubset_univ ;)
def Set__Nonempty__ssubset_univ : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (Set__Nonempty (Compl__compl s))) -> Proof (HasSSubset__SSubset s Set__univ) :=
  X => s => iffEr (HasSSubset__SSubset s Set__univ) (Set__Nonempty (Compl__compl s)) (Set__ssubset_univ_iff_nonempty_compl X s).

(; //LEAN:Set.compl_ssubset_univ ;)
Set__compl_ssubset_univ : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset (Compl__compl s) Set__univ) (Set__Nonempty s)).

(; //LEAN:Set.Nonempty.compl_ssubset_univ ;)
def Set__Nonempty__compl_ssubset_univ : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (Set__Nonempty s)) -> Proof (HasSSubset__SSubset (Compl__compl s) Set__univ) :=
  X => s => iffEr (HasSSubset__SSubset (Compl__compl s) Set__univ) (Set__Nonempty s) (Set__compl_ssubset_univ X s).

(; //LEAN:Set.union_def ;)
def Set__union_def : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union x x1) (Set__ofPred (a => or (Membership__mem x a) (Membership__mem x1 a)))) :=
  X => x => x1 => rfl.

(; //LEAN:Set.mem_union_left ;)
def Set__mem_union_left : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (Membership__mem a x)) -> Proof (Membership__mem (Union__union a b) x) :=
  X => x => a => b => orIl (Membership__mem a x) (Membership__mem b x).

(; //LEAN:Set.mem_union_right ;)
def Set__mem_union_right : (X : Set) -> (x : Elem X) -> (b : Elem (powerset X)) -> (a : Elem (powerset X)) -> (h : Proof (Membership__mem b x)) -> Proof (Membership__mem (Union__union a b) x) :=
  X => x => b => a => orIr (Membership__mem a x) (Membership__mem b x).

(; //LEAN:Set.mem_or_mem_of_mem_union ;)
def Set__mem_or_mem_of_mem_union : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (H : Proof (Membership__mem (Union__union a b) x)) -> Proof (or (Membership__mem a x) (Membership__mem b x)) :=
  X => x => a => b => H => H.

(; //LEAN:Set.MemUnion.elim ;)
def Set__MemUnion__elim : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (P : Prop) -> (h : Proof (Membership__mem (Union__union a b) x)) -> (h1 : Proof (if (Membership__mem a x) P)) -> (h2 : Proof (if (Membership__mem b x) P)) -> Proof P :=
  X => x => a => b => P => h => h1 => h2 => orE (Membership__mem a x) (Membership__mem b x) P h h1 h2.

(; //LEAN:Set.mem_union ;)
def Set__mem_union : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> Proof (iff (Membership__mem (Union__union a b) x) (or (Membership__mem a x) (Membership__mem b x))) :=
  X => x => a => b => Iff__rfl (Membership__mem (Union__union a b) x).

(; //LEAN:Set.union_self ;)
def Set__union_self : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union a a) a) :=
  X => a => Set__ext X (Union__union a a) a (forallI X (x => iff (or (Membership__mem a x) (Membership__mem a x)) (Membership__mem a x)) (x => or_self_iff (Membership__mem a x))).

(; //LEAN:Set.union_empty ;)
def Set__union_empty : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union a EmptyCollection__emptyCollection) a) :=
  X => a => Set__ext X (Union__union a EmptyCollection__emptyCollection) a (forallI X (x => iff (Membership__mem (Union__union a EmptyCollection__emptyCollection) x) (Membership__mem a x)) (x => iff_of_eq (Membership__mem (Union__union a EmptyCollection__emptyCollection) x) (Membership__mem a x) (or_false (Membership__mem a x)))).

(; //LEAN:Set.empty_union ;)
def Set__empty_union : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union EmptyCollection__emptyCollection a) a) :=
  X => a => Set__ext X (Union__union EmptyCollection__emptyCollection a) a (forallI X (x => iff (Membership__mem (Union__union EmptyCollection__emptyCollection a) x) (Membership__mem a x)) (x => iff_of_eq (Membership__mem (Union__union EmptyCollection__emptyCollection a) x) (Membership__mem a x) (false_or (Membership__mem a x)))).

(; //LEAN:Set.union_comm ;)
def Set__union_comm : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union a b) (Union__union b a)) :=
  X => a => b => Set__ext X (Union__union a b) (Union__union b a) (forallI X (x => iff (or (Membership__mem a x) (Membership__mem b x)) (or (Membership__mem b x) (Membership__mem a x))) (x => or_comm (Membership__mem a x) (Membership__mem b x))).

(; //LEAN:Set.union_assoc ;)
def Set__union_assoc : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (c : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (Union__union a b) c) (Union__union a (Union__union b c))) :=
  X => a => b => c => Set__ext X (Union__union (Union__union a b) c) (Union__union a (Union__union b c)) (forallI X (x => iff (or (or (Membership__mem a x) (Membership__mem b x)) (Membership__mem c x)) (or (Membership__mem a x) (or (Membership__mem b x) (Membership__mem c x)))) (x => or_assoc (Membership__mem a x) (Membership__mem b x) (Membership__mem c x))).

(; //LEAN:Set.union_left_comm ;)
def Set__union_left_comm : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union x (Union__union x1 x2)) (Union__union x1 (Union__union x x2))) :=
  X => x => x1 => x2 => Set__ext X (Union__union x (Union__union x1 x2)) (Union__union x1 (Union__union x x2)) (forallI X (x3 => iff (or (Membership__mem x x3) (or (Membership__mem x1 x3) (Membership__mem x2 x3))) (or (Membership__mem x1 x3) (or (Membership__mem x x3) (Membership__mem x2 x3)))) (x3 => or_left_comm (Membership__mem x x3) (Membership__mem x1 x3) (Membership__mem x2 x3))).

(; //LEAN:Set.union_right_comm ;)
def Set__union_right_comm : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (Union__union x x1) x2) (Union__union (Union__union x x2) x1)) :=
  X => x => x1 => x2 => Set__ext X (Union__union (Union__union x x1) x2) (Union__union (Union__union x x2) x1) (forallI X (x3 => iff (or (or (Membership__mem x x3) (Membership__mem x1 x3)) (Membership__mem x2 x3)) (or (or (Membership__mem x x3) (Membership__mem x2 x3)) (Membership__mem x1 x3))) (x3 => or_right_comm (Membership__mem x x3) (Membership__mem x1 x3) (Membership__mem x2 x3))).

(; //LEAN:Set.union_eq_left ;)
def Set__union_eq_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Union__union s t) s) (Set__Subset t s)) :=
  X => s => t => sup_eq_left (powerset X) s t.

(; //LEAN:Set.union_eq_right ;)
def Set__union_eq_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Union__union s t) t) (Set__Subset s t)) :=
  X => s => t => sup_eq_right (powerset X) s t.

(; //LEAN:Set.union_eq_self_of_subset_left ;)
def Set__union_eq_self_of_subset_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset s t)) -> Proof (Eqt (powerset X) (Union__union s t) t) :=
  X => s => t => h => iffEr (Eqt (powerset X) (Union__union s t) t) (Set__Subset s t) (Set__union_eq_right X s t) h.

(; //LEAN:Set.union_eq_self_of_subset_right ;)
def Set__union_eq_self_of_subset_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset t s)) -> Proof (Eqt (powerset X) (Union__union s t) s) :=
  X => s => t => h => iffEr (Eqt (powerset X) (Union__union s t) s) (Set__Subset t s) (Set__union_eq_left X s t) h.

(; //LEAN:Set.subset_union_left ;)
def Set__subset_union_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset s (Union__union s t)) :=
  X => s => t => forallI X (x => if (Membership__mem s x) (or (Membership__mem s x) (Membership__mem t x))) (x => orIl (Membership__mem s x) (Membership__mem t x)).

(; //LEAN:Set.subset_union_right ;)
def Set__subset_union_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset t (Union__union s t)) :=
  X => s => t => forallI X (x => if (Membership__mem t x) (or (Membership__mem s x) (Membership__mem t x))) (x => orIr (Membership__mem s x) (Membership__mem t x)).

(; //LEAN:Set.union_subset ;)
Set__union_subset : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> (sr : Proof (Set__Subset s r)) -> (tr : Proof (Set__Subset t r)) -> Proof (Set__Subset (Union__union s t) r).

(; //LEAN:Set.union_subset_iff ;)
def Set__union_subset_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (iff (Set__Subset (Union__union s t) u) (and (Set__Subset s u) (Set__Subset t u))) :=
  X => s => t => u => Iff__trans (forall X (a => if (or (Membership__mem s a) (Membership__mem t a)) (Membership__mem u a))) (forall X (a1 => and (if (Membership__mem s a1) (Membership__mem u a1)) (if (Membership__mem t a1) (Membership__mem u a1)))) (and (Set__Subset s u) (Set__Subset t u)) (forall_congr' X (x => if (or (Membership__mem s x) (Membership__mem t x)) (Membership__mem u x)) (x1 => and (if (Membership__mem s x1) (Membership__mem u x1)) (if (Membership__mem t x1) (Membership__mem u x1))) (forallI X (x2 => iff (if (or (Membership__mem s x2) (Membership__mem t x2)) (Membership__mem u x2)) (and (if (Membership__mem s x2) (Membership__mem u x2)) (if (Membership__mem t x2) (Membership__mem u x2)))) (x2 => or_imp (Membership__mem s x2) (Membership__mem t x2) (Membership__mem u x2)))) (forall_and X (a2 => if (Membership__mem s a2) (Membership__mem u a2)) (a3 => if (Membership__mem t a3) (Membership__mem u a3))).

(; //LEAN:Set.union_subset_union ;)
def Set__union_subset_union : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset X)) -> (x3 : Elem (powerset X)) -> (h : Proof (Set__Subset x x1)) -> (h1 : Proof (Set__Subset x2 x3)) -> Proof (Set__Subset (Union__union x x2) (Union__union x1 x3)) :=
  X => x => x1 => x2 => x3 => h => h1 => sup_le_sup (powerset X) x x1 x2 x3 h h1.

(; //LEAN:Set.union_subset_union_left ;)
def Set__union_subset_union_left : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset x x1)) -> Proof (Set__Subset (Union__union x t) (Union__union x1 t)) :=
  X => x => x1 => t => h => Set__union_subset_union X x x1 t t h (Set__Subset__rfl X t).

(; //LEAN:Set.union_subset_union_right ;)
def Set__union_subset_union_right : (X : Set) -> (s : Elem (powerset X)) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (h : Proof (Set__Subset x x1)) -> Proof (Set__Subset (Union__union s x) (Union__union s x1)) :=
  X => s => x => x1 => h => Set__union_subset_union X s s x x1 (Set__Subset__rfl X s) h.

(; //LEAN:Set.subset_union_of_subset_left ;)
def Set__subset_union_of_subset_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset s t)) -> (u : Elem (powerset X)) -> Proof (Set__Subset s (Union__union t u)) :=
  X => s => t => h => u => LE__le__trans (powerset X) s t (Union__union t u) h (Set__subset_union_left X t u).

(; //LEAN:Set.subset_union_of_subset_right ;)
def Set__subset_union_of_subset_right : (X : Set) -> (s : Elem (powerset X)) -> (u : Elem (powerset X)) -> (h : Proof (Set__Subset s u)) -> (t : Elem (powerset X)) -> Proof (Set__Subset s (Union__union t u)) :=
  X => s => u => h => t => LE__le__trans (powerset X) s u (Union__union t u) h (Set__subset_union_right X t u).

(; //LEAN:Set.union_congr_left ;)
def Set__union_congr_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (ht : Proof (Set__Subset t (Union__union s u))) -> (hu : Proof (Set__Subset u (Union__union s t))) -> Proof (Eqt (powerset X) (Union__union s t) (Union__union s u)) :=
  X => s => t => u => ht => hu => sup_congr_left (powerset X) s t u ht hu.

(; //LEAN:Set.union_congr_right ;)
def Set__union_congr_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (hs : Proof (Set__Subset s (Union__union t u))) -> (ht : Proof (Set__Subset t (Union__union s u))) -> Proof (Eqt (powerset X) (Union__union s u) (Union__union t u)) :=
  X => s => t => u => hs => ht => sup_congr_right (powerset X) s t u hs ht.

(; //LEAN:Set.union_eq_union_iff_left ;)
def Set__union_eq_union_iff_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Union__union s t) (Union__union s u)) (and (Set__Subset t (Union__union s u)) (Set__Subset u (Union__union s t)))) :=
  X => s => t => u => sup_eq_sup_iff_left (powerset X) s t u.

(; //LEAN:Set.union_eq_union_iff_right ;)
def Set__union_eq_union_iff_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Union__union s u) (Union__union t u)) (and (Set__Subset s (Union__union t u)) (Set__Subset t (Union__union s u)))) :=
  X => s => t => u => sup_eq_sup_iff_right (powerset X) s t u.

(; //LEAN:Set.union_eq_union_mono_left ;)
def Set__union_eq_union_mono_left : (X : Set) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) (Union__union x t) (Union__union x u))) -> (hs : Proof (Set__Subset x x1)) -> Proof (Eqt (powerset X) (Union__union x1 t) (Union__union x1 u)) :=
  X => t => u => x => x1 => h => hs => sup_eq_sup_mono_left (powerset X) x t u x1 h hs.

(; //LEAN:Set.union_eq_union_mono_right ;)
def Set__union_eq_union_mono_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) (Union__union s x) (Union__union t x))) -> (hu : Proof (Set__Subset x x1)) -> Proof (Eqt (powerset X) (Union__union s x1) (Union__union t x1)) :=
  X => s => t => x => x1 => h => hu => sup_eq_sup_mono_right (powerset X) s t x x1 h hu.

(; //LEAN:Set.union_empty_iff ;)
Set__union_empty_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Union__union s t) EmptyCollection__emptyCollection) (and (Eqt (powerset X) s EmptyCollection__emptyCollection) (Eqt (powerset X) t EmptyCollection__emptyCollection))).

(; //LEAN:Set.union_univ ;)
def Set__union_univ : (X : Set) -> (s : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union s Set__univ) Set__univ) :=
  X => s => sup_top_eq (powerset X) s.

(; //LEAN:Set.univ_union ;)
def Set__univ_union : (X : Set) -> (s : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union Set__univ s) Set__univ) :=
  X => s => top_sup_eq (powerset X) s.

(; //LEAN:Set.ssubset_union_left_iff ;)
def Set__ssubset_union_left_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset s (Union__union s t)) (not (Set__Subset t s))) :=
  X => s => t => left_lt_sup (powerset X) s t.

(; //LEAN:Set.ssubset_union_right_iff ;)
def Set__ssubset_union_right_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset t (Union__union s t)) (not (Set__Subset s t))) :=
  X => s => t => right_lt_sup (powerset X) s t.

(; //LEAN:Set.forall_mem_union ;)
Set__forall_mem_union : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (forall X (x => if (Membership__mem (Union__union s t) x) (p x))) (and (forall X (x1 => if (Membership__mem s x1) (p x1))) (forall X (x2 => if (Membership__mem t x2) (p x2))))).

(; //LEAN:Set.exists_mem_union ;)
Set__exists_mem_union : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (exists X (x => and (Membership__mem (Union__union s t) x) (p x))) (or (exists X (x1 => and (Membership__mem s x1) (p x1))) (exists X (x2 => and (Membership__mem t x2) (p x2))))).

(; //LEAN:Set.inter_def ;)
def Set__inter_def : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter x x1) (Set__ofPred (a => and (Membership__mem x a) (Membership__mem x1 a)))) :=
  X => x => x1 => rfl.

(; //LEAN:Set.mem_inter_iff ;)
def Set__mem_inter_iff : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> Proof (iff (Membership__mem (Inter__inter a b) x) (and (Membership__mem a x) (Membership__mem b x))) :=
  X => x => a => b => Iff__rfl (Membership__mem (Inter__inter a b) x).

(; //LEAN:Set.mem_inter ;)
def Set__mem_inter : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (ha : Proof (Membership__mem a x)) -> (hb : Proof (Membership__mem b x)) -> Proof (Membership__mem (Inter__inter a b) x) :=
  X => x => a => b => ha => hb => andI (Membership__mem a x) (Membership__mem b x) ha hb.

(; //LEAN:Set.mem_of_mem_inter_left ;)
def Set__mem_of_mem_inter_left : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (Membership__mem (Inter__inter a b) x)) -> Proof (Membership__mem a x) :=
  X => x => a => b => h => andEl (Membership__mem a x) (Membership__mem b x) h.

(; //LEAN:Set.mem_of_mem_inter_right ;)
def Set__mem_of_mem_inter_right : (X : Set) -> (x : Elem X) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (Membership__mem (Inter__inter a b) x)) -> Proof (Membership__mem b x) :=
  X => x => a => b => h => andEr (Membership__mem a x) (Membership__mem b x) h.

(; //LEAN:Set.inter_self ;)
def Set__inter_self : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter a a) a) :=
  X => a => Set__ext X (Inter__inter a a) a (forallI X (x => iff (and (Membership__mem a x) (Membership__mem a x)) (Membership__mem a x)) (x => and_self_iff (Membership__mem a x))).

(; //LEAN:Set.inter_empty ;)
def Set__inter_empty : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter a EmptyCollection__emptyCollection) EmptyCollection__emptyCollection) :=
  X => a => Set__ext X (Inter__inter a EmptyCollection__emptyCollection) EmptyCollection__emptyCollection (forallI X (x => iff (Membership__mem (Inter__inter a EmptyCollection__emptyCollection) x) (Membership__mem EmptyCollection__emptyCollection x)) (x => iff_of_eq (Membership__mem (Inter__inter a EmptyCollection__emptyCollection) x) (Membership__mem EmptyCollection__emptyCollection x) (and_false (Membership__mem a x)))).

(; //LEAN:Set.empty_inter ;)
def Set__empty_inter : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter EmptyCollection__emptyCollection a) EmptyCollection__emptyCollection) :=
  X => a => Set__ext X (Inter__inter EmptyCollection__emptyCollection a) EmptyCollection__emptyCollection (forallI X (x => iff (Membership__mem (Inter__inter EmptyCollection__emptyCollection a) x) (Membership__mem EmptyCollection__emptyCollection x)) (x => iff_of_eq (Membership__mem (Inter__inter EmptyCollection__emptyCollection a) x) (Membership__mem EmptyCollection__emptyCollection x) (false_and (Membership__mem a x)))).

(; //LEAN:Set.inter_comm ;)
def Set__inter_comm : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter a b) (Inter__inter b a)) :=
  X => a => b => Set__ext X (Inter__inter a b) (Inter__inter b a) (forallI X (x => iff (and (Membership__mem a x) (Membership__mem b x)) (and (Membership__mem b x) (Membership__mem a x))) (x => and_comm (Membership__mem a x) (Membership__mem b x))).

(; //LEAN:Set.inter_assoc ;)
def Set__inter_assoc : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (c : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (Inter__inter a b) c) (Inter__inter a (Inter__inter b c))) :=
