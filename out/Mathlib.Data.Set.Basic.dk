(; //LEAN:Set.subset_inter ;)
def Set__subset_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> (rs : Proof (Set__Subset r s)) -> (rt : Proof (Set__Subset r t)) -> Proof (Set__Subset r (Inter__inter s t)) :=
