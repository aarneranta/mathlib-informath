(; //LEAN:Set.mem_sep ;)
def Set__mem_sep : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (x : Elem X) -> (xs : Proof (Membership__mem s x)) -> (px : Proof (p x)) -> Proof (Membership__mem (Set__ofPred (x1 => and (Membership__mem s x1) (p x1))) x) :=
