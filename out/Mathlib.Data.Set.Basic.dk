(; //LEAN:Set.inter_subset_left ;)
def Set__inter_subset_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X (Inter__inter (powerset X) s t) s) :=
  X => s => t => forallI X (x => if (and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x)) (Membership__mem X (powerset X) s x)) (x => andEl (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x)).

(; //LEAN:Set.inter_subset_right ;)
def Set__inter_subset_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X (Inter__inter (powerset X) s t) t) :=
  X => s => t => forallI X (x => if (and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x)) (Membership__mem X (powerset X) t x)) (x => andEr (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x)).

(; //LEAN:Set.subset_inter ;)
def Set__subset_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> (rs : Proof (Set__Subset X r s)) -> (rt : Proof (Set__Subset X r t)) -> Proof (Set__Subset X r (Inter__inter (powerset X) s t)) :=
  X => s => t => r => rs => rt => forallI X (x => if (Membership__mem X (powerset X) r x) (and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x))) (x => ifI (Membership__mem X (powerset X) r x) (and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x)) (h => andI (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x) (ifE (Membership__mem X (powerset X) r x) (Membership__mem X (powerset X) s x) (forallE X (a => if (Membership__mem X (powerset X) r a) (Membership__mem X (powerset X) s a)) rs x) h) (ifE (Membership__mem X (powerset X) r x) (Membership__mem X (powerset X) t x) (forallE X (a1 => if (Membership__mem X (powerset X) r a1) (Membership__mem X (powerset X) t a1)) rt x) h))).

(; //LEAN:Set.subset_inter_iff ;)
def Set__subset_inter_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> Proof (iff (Set__Subset X r (Inter__inter (powerset X) s t)) (and (Set__Subset X r s) (Set__Subset X r t))) :=
  X => s => t => r => Iff__trans (forall X (a => if (Membership__mem X (powerset X) r a) (and (Membership__mem X (powerset X) s a) (Membership__mem X (powerset X) t a)))) (forall X (a1 => and (if (Membership__mem X (powerset X) r a1) (Membership__mem X (powerset X) s a1)) (if (Membership__mem X (powerset X) r a1) (Membership__mem X (powerset X) t a1)))) (and (Set__Subset X r s) (Set__Subset X r t)) (forall_congr' X (x => if (Membership__mem X (powerset X) r x) (and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x))) (x1 => and (if (Membership__mem X (powerset X) r x1) (Membership__mem X (powerset X) s x1)) (if (Membership__mem X (powerset X) r x1) (Membership__mem X (powerset X) t x1))) (forallI X (x2 => iff (if (Membership__mem X (powerset X) r x2) (and (Membership__mem X (powerset X) s x2) (Membership__mem X (powerset X) t x2))) (and (if (Membership__mem X (powerset X) r x2) (Membership__mem X (powerset X) s x2)) (if (Membership__mem X (powerset X) r x2) (Membership__mem X (powerset X) t x2)))) (x2 => imp_and (Membership__mem X (powerset X) s x2) (Membership__mem X (powerset X) t x2) (Membership__mem X (powerset X) r x2)))) (forall_and X (a2 => if (Membership__mem X (powerset X) r a2) (Membership__mem X (powerset X) s a2)) (a3 => if (Membership__mem X (powerset X) r a3) (Membership__mem X (powerset X) t a3))).

(; //LEAN:Set.inter_eq_left ;)
def Set__inter_eq_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Inter__inter (powerset X) s t) s) (Set__Subset X s t)) :=
  X => s => t => inf_eq_left (powerset X) s t.

(; //LEAN:Set.inter_eq_right ;)
def Set__inter_eq_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Inter__inter (powerset X) s t) t) (Set__Subset X t s)) :=
  X => s => t => inf_eq_right (powerset X) s t.

(; //LEAN:Set.left_eq_inter ;)
def Set__left_eq_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) s (Inter__inter (powerset X) s t)) (Set__Subset X s t)) :=
  X => s => t => left_eq_inf (powerset X) s t.

(; //LEAN:Set.right_eq_inter ;)
def Set__right_eq_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) t (Inter__inter (powerset X) s t)) (Set__Subset X t s)) :=
  X => s => t => right_eq_inf (powerset X) s t.

(; //LEAN:Set.inter_eq_self_of_subset_left ;)
def Set__inter_eq_self_of_subset_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset X s t)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s t) s) :=
  X => s => t => iffEr (Eqt (powerset X) (Inter__inter (powerset X) s t) s) (Set__Subset X s t) (Set__inter_eq_left X s t).

(; //LEAN:Set.inter_eq_self_of_subset_right ;)
def Set__inter_eq_self_of_subset_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset X t s)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s t) t) :=
  X => s => t => iffEr (Eqt (powerset X) (Inter__inter (powerset X) s t) t) (Set__Subset X t s) (Set__inter_eq_right X s t).

(; //LEAN:Set.inter_congr_left ;)
def Set__inter_congr_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (ht : Proof (Set__Subset X (Inter__inter (powerset X) s u) t)) -> (hu : Proof (Set__Subset X (Inter__inter (powerset X) s t) u)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s t) (Inter__inter (powerset X) s u)) :=
  X => s => t => u => ht => hu => inf_congr_left (powerset X) s t u ht hu.

(; //LEAN:Set.inter_congr_right ;)
def Set__inter_congr_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (hs : Proof (Set__Subset X (Inter__inter (powerset X) t u) s)) -> (ht : Proof (Set__Subset X (Inter__inter (powerset X) s u) t)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t u)) :=
  X => s => t => u => hs => ht => inf_congr_right (powerset X) s t u hs ht.

(; //LEAN:Set.inter_eq_inter_iff_left ;)
def Set__inter_eq_inter_iff_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Inter__inter (powerset X) s t) (Inter__inter (powerset X) s u)) (and (Set__Subset X (Inter__inter (powerset X) s u) t) (Set__Subset X (Inter__inter (powerset X) s t) u))) :=
  X => s => t => u => inf_eq_inf_iff_left (powerset X) s t u.

(; //LEAN:Set.inter_eq_inter_iff_right ;)
def Set__inter_eq_inter_iff_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t u)) (and (Set__Subset X (Inter__inter (powerset X) t u) s) (Set__Subset X (Inter__inter (powerset X) s u) t))) :=
  X => s => t => u => inf_eq_inf_iff_right (powerset X) s t u.

(; //LEAN:Set.inter_eq_inter_mono_left ;)
def Set__inter_eq_inter_mono_left : (X : Set) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) (Inter__inter (powerset X) s1 t) (Inter__inter (powerset X) s1 u))) -> (hs : Proof (Set__Subset X s2 s1)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s2 t) (Inter__inter (powerset X) s2 u)) :=
  X => t => u => s1 => s2 => h => hs => inf_eq_inf_mono_left (powerset X) s1 t u s2 h hs.

(; //LEAN:Set.inter_eq_inter_mono_right ;)
def Set__inter_eq_inter_mono_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u1 : Elem (powerset X)) -> (u2 : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) (Inter__inter (powerset X) s u1) (Inter__inter (powerset X) t u1))) -> (hu : Proof (Set__Subset X u2 u1)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s u2) (Inter__inter (powerset X) t u2)) :=
  X => s => t => u1 => u2 => h => hu => inf_eq_inf_mono_right (powerset X) s t u1 u2 h hu.

(; //LEAN:Set.inter_univ ;)
def Set__inter_univ : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) a (Set__univ X)) a) :=
  X => a => inf_top_eq (powerset X) a.

(; //LEAN:Set.univ_inter ;)
def Set__univ_inter : (X : Set) -> (a : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Set__univ X) a) a) :=
  X => a => top_inf_eq (powerset X) a.

(; //LEAN:Set.inter_subset_inter ;)
def Set__inter_subset_inter : (X : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> (t1 : Elem (powerset X)) -> (t2 : Elem (powerset X)) -> (h1 : Proof (Set__Subset X s1 t1)) -> (h2 : Proof (Set__Subset X s2 t2)) -> Proof (Set__Subset X (Inter__inter (powerset X) s1 s2) (Inter__inter (powerset X) t1 t2)) :=
  X => s1 => s2 => t1 => t2 => h1 => h2 => inf_le_inf (powerset X) t1 s1 t2 s2 h1 h2.

(; //LEAN:Set.inter_subset_inter_left ;)
def Set__inter_subset_inter_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (H : Proof (Set__Subset X s t)) -> Proof (Set__Subset X (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t u)) :=
  X => s => t => u => H => Set__inter_subset_inter X s u t u H (Set__Subset__rfl X u).

(; //LEAN:Set.inter_subset_inter_right ;)
def Set__inter_subset_inter_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (H : Proof (Set__Subset X s t)) -> Proof (Set__Subset X (Inter__inter (powerset X) u s) (Inter__inter (powerset X) u t)) :=
  X => s => t => u => H => Set__inter_subset_inter X u s u t (Set__Subset__rfl X u) H.

(; //LEAN:Set.union_inter_cancel_left ;)
def Set__union_inter_cancel_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Union__union (powerset X) s t) s) s) :=
  X => s => t => Set__inter_eq_self_of_subset_right X (Union__union (powerset X) s t) s (Set__subset_union_left X s t).

(; //LEAN:Set.union_inter_cancel_right ;)
def Set__union_inter_cancel_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Union__union (powerset X) s t) t) t) :=
  X => s => t => Set__inter_eq_self_of_subset_right X (Union__union (powerset X) s t) t (Set__subset_union_right X s t).

(; //LEAN:Set.inter_ofPred_eq_sep ;)
def Set__inter_ofPred_eq_sep : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s (Set__ofPred X (a => p a))) (Set__ofPred X (a1 => and (Membership__mem X (powerset X) s a1) (p a1)))) :=
  X => s => p => rfl (powerset X) (Inter__inter (powerset X) s (Set__ofPred X (a => p a))).

(; //LEAN:Set.ofPred_inter_eq_sep ;)
def Set__ofPred_inter_eq_sep : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Set__ofPred X (a => p a)) s) (Set__ofPred X (a1 => and (Membership__mem X (powerset X) s a1) (p a1)))) :=
  X => p => s => Set__inter_comm X (Set__ofPred X (a => p a)) s.

(; //LEAN:Set.sep_eq_inter_sep ;)
Set__sep_eq_inter_sep : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (hst : Proof (Set__Subset X s t)) -> Proof (Eqt (powerset X) (Set__ofPred X (x => and (Membership__mem X (powerset X) s x) (p x))) (Inter__inter (powerset X) s (Set__ofPred X (x1 => and (Membership__mem X (powerset X) t x1) (p x1))))).

(; //LEAN:Set.inter_ssubset_right_iff ;)
def Set__inter_ssubset_right_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset (powerset X) (Inter__inter (powerset X) s t) t) (not (Set__Subset X t s))) :=
  X => s => t => inf_lt_right (powerset X) s t.

(; //LEAN:Set.inter_ssubset_left_iff ;)
def Set__inter_ssubset_left_iff : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (HasSSubset__SSubset (powerset X) (Inter__inter (powerset X) s t) s) (not (Set__Subset X s t))) :=
  X => s => t => inf_lt_left (powerset X) s t.

(; //LEAN:Set.inter_union_distrib_left ;)
def Set__inter_union_distrib_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s (Union__union (powerset X) t u)) (Union__union (powerset X) (Inter__inter (powerset X) s t) (Inter__inter (powerset X) s u))) :=
  X => s => t => u => inf_sup_left (powerset X) s t u.

(; //LEAN:Set.union_inter_distrib_right ;)
def Set__union_inter_distrib_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Union__union (powerset X) s t) u) (Union__union (powerset X) (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t u))) :=
  X => s => t => u => inf_sup_right (powerset X) s t u.

(; //LEAN:Set.union_inter_distrib_left ;)
def Set__union_inter_distrib_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (powerset X) s (Inter__inter (powerset X) t u)) (Inter__inter (powerset X) (Union__union (powerset X) s t) (Union__union (powerset X) s u))) :=
  X => s => t => u => sup_inf_left (powerset X) s t u.

(; //LEAN:Set.inter_union_distrib_right ;)
def Set__inter_union_distrib_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (powerset X) (Inter__inter (powerset X) s t) u) (Inter__inter (powerset X) (Union__union (powerset X) s u) (Union__union (powerset X) t u))) :=
  X => s => t => u => sup_inf_right (powerset X) s t u.

(; //LEAN:Set.union_union_distrib_left ;)
def Set__union_union_distrib_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (powerset X) s (Union__union (powerset X) t u)) (Union__union (powerset X) (Union__union (powerset X) s t) (Union__union (powerset X) s u))) :=
  X => s => t => u => sup_sup_distrib_left (powerset X) s t u.

(; //LEAN:Set.union_union_distrib_right ;)
def Set__union_union_distrib_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (powerset X) (Union__union (powerset X) s t) u) (Union__union (powerset X) (Union__union (powerset X) s u) (Union__union (powerset X) t u))) :=
  X => s => t => u => sup_sup_distrib_right (powerset X) s t u.

(; //LEAN:Set.inter_inter_distrib_left ;)
def Set__inter_inter_distrib_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) s (Inter__inter (powerset X) t u)) (Inter__inter (powerset X) (Inter__inter (powerset X) s t) (Inter__inter (powerset X) s u))) :=
  X => s => t => u => inf_inf_distrib_left (powerset X) s t u.

(; //LEAN:Set.inter_inter_distrib_right ;)
def Set__inter_inter_distrib_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Inter__inter (powerset X) s t) u) (Inter__inter (powerset X) (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t u))) :=
  X => s => t => u => inf_inf_distrib_right (powerset X) s t u.

(; //LEAN:Set.union_union_union_comm ;)
def Set__union_union_union_comm : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (v : Elem (powerset X)) -> Proof (Eqt (powerset X) (Union__union (powerset X) (Union__union (powerset X) s t) (Union__union (powerset X) u v)) (Union__union (powerset X) (Union__union (powerset X) s u) (Union__union (powerset X) t v))) :=
  X => s => t => u => v => sup_sup_sup_comm (powerset X) s t u v.

(; //LEAN:Set.inter_inter_inter_comm ;)
def Set__inter_inter_inter_comm : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (u : Elem (powerset X)) -> (v : Elem (powerset X)) -> Proof (Eqt (powerset X) (Inter__inter (powerset X) (Inter__inter (powerset X) s t) (Inter__inter (powerset X) u v)) (Inter__inter (powerset X) (Inter__inter (powerset X) s u) (Inter__inter (powerset X) t v))) :=
  X => s => t => u => v => inf_inf_inf_comm (powerset X) s t u v.

(; //LEAN:Set.forall_mem_inter ;)
Set__forall_mem_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (forall X (x => if (Membership__mem X (powerset X) (Inter__inter (powerset X) s t) x) (p x))) (forall X (x1 => if (Membership__mem X (powerset X) s x1) (if (Membership__mem X (powerset X) t x1) (p x1))))).

(; //LEAN:Set.exists_mem_inter ;)
Set__exists_mem_inter : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (iff (exists X (x => and (Membership__mem X (powerset X) (Inter__inter (powerset X) s t) x) (p x))) (exists X (x1 => and (Membership__mem X (powerset X) s x1) (and (Membership__mem X (powerset X) t x1) (p x1))))).

(; //LEAN:Set.mem_sep ;)
def Set__mem_sep : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (x : Elem X) -> (xs : Proof (Membership__mem X (powerset X) s x)) -> (px : Proof (p x)) -> Proof (Membership__mem X (powerset X) (Set__ofPred X (x1 => and (Membership__mem X (powerset X) s x1) (p x1))) x) :=
  X => s => p => x => xs => px => andI (Membership__mem X (powerset X) s x) (p x) xs px.

(; //LEAN:Set.sep_mem_eq ;)
def Set__sep_mem_eq : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Eqt (powerset X) (Set__ofPred X (x => and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x))) (Inter__inter (powerset X) s t)) :=
  X => s => t => rfl (powerset X) (Set__ofPred X (x => and (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x))).

(; //LEAN:Set.mem_sep_iff ;)
def Set__mem_sep_iff : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (x : Elem X) -> Proof (iff (Membership__mem X (powerset X) (Set__ofPred X (x1 => and (Membership__mem X (powerset X) s x1) (p x1))) x) (and (Membership__mem X (powerset X) s x) (p x))) :=
  X => s => p => x => Iff__rfl (Membership__mem X (powerset X) (Set__ofPred X (x1 => and (Membership__mem X (powerset X) s x1) (p x1))) x).

(; //LEAN:Set.sep_ext_iff ;)
Set__sep_ext_iff : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> Proof (iff (Eqt (powerset X) (Set__ofPred X (x => and (Membership__mem X (powerset X) s x) (p x))) (Set__ofPred X (x1 => and (Membership__mem X (powerset X) s x1) (q x1)))) (forall X (x2 => if (Membership__mem X (powerset X) s x2) (iff (p x2) (q x2))))).

(; //LEAN:Set.sep_eq_of_subset ;)
def Set__sep_eq_of_subset : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset X s t)) -> Proof (Eqt (powerset X) (Set__ofPred X (x => and (Membership__mem X (powerset X) t x) (Membership__mem X (powerset X) s x))) s) :=
  X => s => t => h => Set__inter_eq_self_of_subset_right X t s h.

(; //LEAN:Set.sep_subset ;)
def Set__sep_subset : (X : Set) -> (s : Elem (powerset X)) -> (p : (Elem X -> Prop)) -> Proof (Set__Subset X (Set__ofPred X (x => and (Membership__mem X (powerset X) s x) (p x))) s) :=
  X => s => p => forallI X (x => if (and (Membership__mem X (powerset X) s x) (p x)) (Membership__mem X (powerset X) s x)) (x => andEl (Membership__mem X (powerset X) s x) (p x)).

