def Equiv__bijOn_symm_image : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (s : Elem (powerset X)) -> Proof (Set__BijOn (Equiv__symm e) (Set__image e s) s) :=
  X => Y => e => s => Set__BijOn__symm X Y s (Set__image e s) e (Equiv__symm e) (Equiv__invOn X Y e s (Set__image e s)) (Equiv__bijOn_image X Y e s).

(; //LEAN:Equiv.bijOn_symm ;)
def Equiv__bijOn_symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> Proof (iff (Set__BijOn (Equiv__symm e) t s) (Set__BijOn e s t)) :=
  X => Y => e => s => t => Set__bijOn_comm Y X t s (Equiv__symm e) e (Equiv__invOn Y X (Equiv__symm e) t s).

(; //LEAN:Set.BijOn.equiv_symm ;)
def Set__BijOn__equiv_symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> (h : Proof (Set__BijOn e s t)) -> Proof (Set__BijOn (Equiv__symm e) t s) :=
  X => Y => e => s => t => iffEr (Set__BijOn (Equiv__symm e) t s) (Set__BijOn e s t) (Equiv__bijOn_symm X Y e s t).

(; //LEAN:Set.BijOn.of_equiv_symm ;)
def Set__BijOn__of_equiv_symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> (h : Proof (Set__BijOn (Equiv__symm e) t s)) -> Proof (Set__BijOn e s t) :=
  X => Y => e => s => t => iffEl (Set__BijOn (Equiv__symm e) t s) (Set__BijOn e s t) (Equiv__bijOn_symm X Y e s t).

(; //LEAN:Equiv.bijOn_swap ;)
Equiv__bijOn_swap : (X : Set) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Membership__mem s a)) -> (hb : Proof (Membership__mem s b)) -> Proof (Set__BijOn (Equiv__swap a b) s s).

