(; //LEAN:Set.range_subset_iff ;)
def Set__range_subset_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (s : Elem (powerset X)) -> Proof (iff (Set__Subset X (Set__range X I f) s) (forall I (y => Membership__mem X (powerset X) s (f y)))) :=
  X => I => f => s => Set__forall_mem_range X I f (Membership__mem X (powerset X) s).

(; //LEAN:Set.range_subset_range_iff_exists_comp ;)
Set__range_subset_range_iff_exists_comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (f : (Elem X -> Z)) -> (g : (Elem Y -> Z)) -> Proof (iff (Set__Subset Z (Set__range Z X f) (Set__range Z Y g)) (exists (Elem X -> Y) (h => Eqt (Elem X -> Z) f (Function__comp X Y Z g h)))).

(; //LEAN:Set.range_eq_iff ;)
Set__range_eq_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (iff (Eqt (powerset Y) (Set__range Y X f) s) (and (forall X (a => Membership__mem Y (powerset Y) s (f a))) (forall Y (b => if (Membership__mem Y (powerset Y) s b) (exists X (a1 => Eqt Y (f a1) b)))))).

(; //LEAN:Set.range_comp_subset_range ;)
Set__range_comp_subset_range : (X : Set) -> (Y : Set) -> (Z : Set) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> Z)) -> Proof (Set__Subset Z (Set__range Z X (Function__comp X Y Z g f)) (Set__range Z Y g)).

(; //LEAN:Set.range_nonempty_iff_nonempty ;)
Set__range_nonempty_iff_nonempty : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Proof (iff (Set__Nonempty X (Set__range X I f)) (Nonempty I)).

(; //LEAN:Set.range_nonempty ;)
def Set__range_nonempty : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Proof (Set__Nonempty X (Set__range X I f)) :=
  X => I => f => iffEr (Set__Nonempty X (Set__range X I f)) (Nonempty I) (Set__range_nonempty_iff_nonempty X I f) h.

(; //LEAN:Set.range_eq_empty_iff ;)
Set__range_eq_empty_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Proof (iff (Eqt (powerset X) (Set__range X I f) (EmptyCollection__emptyCollection (powerset X))) (IsEmpty I)).

(; //LEAN:Set.range_eq_empty ;)
def Set__range_eq_empty : (X : Set) -> (I : Set) -> (_ : Proof (IsEmpty I)) -> (f : (Elem I -> X)) -> Proof (Eqt (powerset X) (Set__range X I f) (EmptyCollection__emptyCollection (powerset X))) :=
  X => I => h => f => iffEr (Eqt (powerset X) (Set__range X I f) (EmptyCollection__emptyCollection (powerset X))) (IsEmpty I) (Set__range_eq_empty_iff X I f) h.

(; //LEAN:Set.range_eq_singleton_iff ;)
Set__range_eq_singleton_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (y : Elem X) -> Proof (iff (Eqt (powerset X) (Set__range X I f) (Singleton__singleton X (powerset X) y)) (forall I (x => Eqt X (f x) y))).

(; //LEAN:Set.range_eq_singleton ;)
def Set__range_eq_singleton : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (y : Elem X) -> (hy : Proof (forall I (x => Eqt X (f x) y))) -> Proof (Eqt (powerset X) (Set__range X I f) (Singleton__singleton X (powerset X) y)) :=
  X => I => f => y => hy => iffEr (Eqt (powerset X) (Set__range X I f) (Singleton__singleton X (powerset X) y)) (forall I (x => Eqt X (f x) y)) (Set__range_eq_singleton_iff X I f y) hy.

(; //LEAN:Set.image_union_image_compl_eq_range ;)
Set__image_union_image_compl_eq_range : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (f : (Elem X -> Y)) -> Proof (Eqt (powerset Y) (Union__union (powerset Y) (Set__image X Y f s) (Set__image X Y f (Compl__compl (powerset X) s))) (Set__range Y X f)).

(; //LEAN:Set.insert_image_compl_eq_range ;)
Set__insert_image_compl_eq_range : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x : Elem X) -> Proof (Eqt (powerset Y) (Insert__insert Y (powerset Y) (f x) (Set__image X Y f (Compl__compl (powerset X) (Singleton__singleton X (powerset X) x)))) (Set__range Y X f)).

(; //LEAN:Set.image_preimage_eq_range_inter ;)
Set__image_preimage_eq_range_inter : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (t : Elem (powerset Y)) -> Proof (Eqt (powerset Y) (Set__image X Y f (Set__preimage X Y f t)) (Inter__inter (powerset Y) (Set__range Y X f) t)).

(; //LEAN:Set.image_preimage_eq_inter_range ;)
Set__image_preimage_eq_inter_range : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (t : Elem (powerset Y)) -> Proof (Eqt (powerset Y) (Set__image X Y f (Set__preimage X Y f t)) (Inter__inter (powerset Y) t (Set__range Y X f))).

(; //LEAN:Set.image_preimage_eq_of_subset ;)
Set__image_preimage_eq_of_subset : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> (hs : Proof (Set__Subset Y s (Set__range Y X f))) -> Proof (Eqt (powerset Y) (Set__image X Y f (Set__preimage X Y f s)) s).

(; //LEAN:Set.image_preimage_eq_iff ;)
Set__image_preimage_eq_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (iff (Eqt (powerset Y) (Set__image X Y f (Set__preimage X Y f s)) s) (Set__Subset Y s (Set__range Y X f))).

(; //LEAN:Set.subset_range_iff_exists_image_eq ;)
Set__subset_range_iff_exists_image_eq : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (iff (Set__Subset Y s (Set__range Y X f)) (exists (powerset X) (t => Eqt (powerset Y) (Set__image X Y f t) s))).

(; //LEAN:Set.range_image ;)
def Set__range_image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Proof (Eqt (powerset (powerset Y)) (Set__range (powerset Y) (powerset X) (Set__image X Y f)) (Set__powerset Y (Set__range Y X f))) :=
  X => Y => f => Set__ext (powerset Y) (Set__range (powerset Y) (powerset X) (Set__image X Y f)) (Set__powerset Y (Set__range Y X f)) (forallI (powerset Y) (x => iff (exists (powerset X) (t1 => Eqt (powerset Y) (Set__image X Y f t1) x)) (Set__Subset Y x (Set__range Y X f))) (x => Iff__symm (Set__Subset Y x (Set__range Y X f)) (exists (powerset X) (t => Eqt (powerset Y) (Set__image X Y f t) x)) (Set__subset_range_iff_exists_image_eq X Y f x))).

(; //LEAN:Set.exists_subset_range_and_iff ;)
Set__exists_subset_range_and_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (p : (Elem (powerset Y) -> Prop)) -> Proof (iff (exists (powerset Y) (s => and (Set__Subset Y s (Set__range Y X f)) (p s))) (exists (powerset X) (s1 => p (Set__image X Y f s1)))).

(; //LEAN:Set.forall_subset_range_iff ;)
Set__forall_subset_range_iff : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (p : (Elem (powerset Y) -> Prop)) -> Proof (iff (forall (powerset Y) (s => if (Set__Subset Y s (Set__range Y X f)) (p s))) (forall (powerset X) (s1 => p (Set__image X Y f s1)))).

(; //LEAN:Set.preimage_subset_preimage_iff ;)
Set__preimage_subset_preimage_iff : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (f : (Elem Y -> X)) -> (hs : Proof (Set__Subset X s (Set__range X Y f))) -> Proof (iff (Set__Subset Y (Set__preimage Y X f s) (Set__preimage Y X f t)) (Set__Subset X s t)).

(; //LEAN:Set.preimage_eq_preimage' ;)
Set__preimage_eq_preimage' : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (f : (Elem Y -> X)) -> (hs : Proof (Set__Subset X s (Set__range X Y f))) -> (ht : Proof (Set__Subset X t (Set__range X Y f))) -> Proof (iff (Eqt (powerset Y) (Set__preimage Y X f s) (Set__preimage Y X f t)) (Eqt (powerset X) s t)).

(; //LEAN:Set.preimage_inter_range ;)
def Set__preimage_inter_range : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (Eqt (powerset X) (Set__preimage X Y f (Inter__inter (powerset Y) s (Set__range Y X f))) (Set__preimage X Y f s)) :=
  X => Y => f => s => Set__ext X (Set__preimage X Y f (Inter__inter (powerset Y) s (Set__range Y X f))) (Set__preimage X Y f s) (forallI X (x => iff (and (Membership__mem Y (powerset Y) s (f x)) (Membership__mem Y (powerset Y) (Set__range Y X f) (f x))) (Membership__mem Y (powerset Y) s (f x))) (x => and_iff_left (Membership__mem Y (powerset Y) (Set__range Y X f) (f x)) (Membership__mem Y (powerset Y) s (f x)) (existsI X (y => Eqt Y (f y) (f x)) x (rfl Y (f x))))).

(; //LEAN:Set.preimage_range_inter ;)
Set__preimage_range_inter : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (Eqt (powerset X) (Set__preimage X Y f (Inter__inter (powerset Y) (Set__range Y X f) s)) (Set__preimage X Y f s)).

(; //LEAN:Set.preimage_image_preimage ;)
Set__preimage_image_preimage : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Proof (Eqt (powerset X) (Set__preimage X Y f (Set__image X Y f (Set__preimage X Y f s))) (Set__preimage X Y f s)).

(; //LEAN:Set.range_id ;)
def Set__range_id : (X : Set) -> Proof (Eqt (powerset X) (Set__range X X (id X)) (Set__univ X)) :=
  X => iffEr (Eqt (powerset X) (Set__range X X (id X)) (Set__univ X)) (Function__Surjective X X (id X)) (Set__range_eq_univ X X (id X)) (Function__surjective_id X).

(; //LEAN:Set.range_id' ;)
def Set__range_id' : (X : Set) -> Proof (Eqt (powerset X) (Set__range X X (x => x)) (Set__univ X)) :=
  X => Set__range_id X.

(; //LEAN:Prod.range_fst ;)
def Prod__range_fst : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset X) (Set__range X (Prod X Y) (Prod__fst X Y)) (Set__univ X)) :=
  X => Y => Function__Surjective__range_eq X (Prod X Y) (Prod__fst X Y) (Prod__fst_surjective X Y).

(; //LEAN:Prod.range_snd ;)
def Prod__range_snd : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset Y) (Set__range Y (Prod X Y) (Prod__snd X Y)) (Set__univ Y)) :=
  X => Y => Function__Surjective__range_eq Y (Prod X Y) (Prod__snd X Y) (Prod__snd_surjective X Y).

(; //LEAN:Set.range_eval ;)
def Set__range_eval : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof (forall I (i1 => Nonempty (x i1)))) -> (i : Elem I) -> Proof (Eqt (powerset (x i)) (Set__range (x i) ((x1 : Elem I) -> x x1) (Function__eval I x i)) (Set__univ (x i))) :=
  I => x => h => i => Function__Surjective__range_eq (x i) ((x1 : Elem I) -> x x1) (Function__eval I x i) (Function__surjective_eval I x i).

(; //LEAN:Set.range_inl ;)
Set__range_inl : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__ofPred (Sum X Y) (x => Eqt Bool (Sum__isLeft X Y x) Bool__true))).

(; //LEAN:Set.range_inr ;)
Set__range_inr : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__ofPred (Sum X Y) (x => Eqt Bool (Sum__isRight X Y x) Bool__true))).

(; //LEAN:Set.isCompl_range_inl_range_inr ;)
Set__isCompl_range_inl_range_inr : (X : Set) -> (Y : Set) -> Proof (IsCompl (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y))).

(; //LEAN:Set.range_inl_union_range_inr ;)
def Set__range_inl_union_range_inr : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Union__union (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y))) (Set__univ (Sum X Y))) :=
  X => Y => IsCompl__sup_eq_top (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y).

(; //LEAN:Set.range_inl_inter_range_inr ;)
def Set__range_inl_inter_range_inr : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Inter__inter (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y))) (EmptyCollection__emptyCollection (powerset (Sum X Y)))) :=
  X => Y => IsCompl__inf_eq_bot (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y).

(; //LEAN:Set.range_inr_union_range_inl ;)
def Set__range_inr_union_range_inl : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Union__union (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__range (Sum X Y) X (Sum__inl X Y))) (Set__univ (Sum X Y))) :=
  X => Y => IsCompl__sup_eq_top (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (IsCompl__symm (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y)).

(; //LEAN:Set.range_inr_inter_range_inl ;)
def Set__range_inr_inter_range_inl : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Inter__inter (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__range (Sum X Y) X (Sum__inl X Y))) (EmptyCollection__emptyCollection (powerset (Sum X Y)))) :=
  X => Y => IsCompl__inf_eq_bot (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (IsCompl__symm (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y)).

(; //LEAN:Set.preimage_inl_image_inr ;)
Set__preimage_inl_image_inr : (X : Set) -> (Y : Set) -> (s : Elem (powerset Y)) -> Proof (Eqt (powerset X) (Set__preimage X (Sum X Y) (Sum__inl X Y) (Set__image Y (Sum X Y) (Sum__inr X Y) s)) (EmptyCollection__emptyCollection (powerset X))).

(; //LEAN:Set.preimage_inr_image_inl ;)
Set__preimage_inr_image_inl : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> Proof (Eqt (powerset Y) (Set__preimage Y (Sum X Y) (Sum__inr X Y) (Set__image X (Sum X Y) (Sum__inl X Y) s)) (EmptyCollection__emptyCollection (powerset Y))).

(; //LEAN:Set.preimage_inl_range_inr ;)
Set__preimage_inl_range_inr : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset X) (Set__preimage X (Sum X Y) (Sum__inl X Y) (Set__range (Sum X Y) Y (Sum__inr X Y))) (EmptyCollection__emptyCollection (powerset X))).

(; //LEAN:Set.preimage_inr_range_inl ;)
Set__preimage_inr_range_inl : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset Y) (Set__preimage Y (Sum X Y) (Sum__inr X Y) (Set__range (Sum X Y) X (Sum__inl X Y))) (EmptyCollection__emptyCollection (powerset Y))).

(; //LEAN:Set.compl_range_inl ;)
def Set__compl_range_inl : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Compl__compl (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y))) (Set__range (Sum X Y) Y (Sum__inr X Y))) :=
  X => Y => IsCompl__compl_eq (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y).

(; //LEAN:Set.compl_range_inr ;)
def Set__compl_range_inr : (X : Set) -> (Y : Set) -> Proof (Eqt (powerset (Sum X Y)) (Compl__compl (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y))) (Set__range (Sum X Y) X (Sum__inl X Y))) :=
  X => Y => IsCompl__compl_eq (powerset (Sum X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (IsCompl__symm (powerset (Sum X Y)) (Set__range (Sum X Y) X (Sum__inl X Y)) (Set__range (Sum X Y) Y (Sum__inr X Y)) (Set__isCompl_range_inl_range_inr X Y)).

(; //LEAN:Set.preimage_sumElim ;)
Set__preimage_sumElim : (X : Set) -> (Y : Set) -> (Z : Set) -> (s : Elem (powerset Z)) -> (f : (Elem X -> Z)) -> (g : (Elem Y -> Z)) -> Proof (Eqt (powerset (Sum X Y)) (Set__preimage (Sum X Y) Z (Sum__elim X Y Z f g) s) (Union__union (powerset (Sum X Y)) (Set__image X (Sum X Y) (Sum__inl X Y) (Set__preimage X Z f s)) (Set__image Y (Sum X Y) (Sum__inr X Y) (Set__preimage Y Z g s)))).

(; //LEAN:Set.image_preimage_inl_union_image_preimage_inr ;)
Set__image_preimage_inl_union_image_preimage_inr : (X : Set) -> (Y : Set) -> (s : Elem (powerset (Sum X Y))) -> Proof (Eqt (powerset (Sum X Y)) (Union__union (powerset (Sum X Y)) (Set__image X (Sum X Y) (Sum__inl X Y) (Set__preimage X (Sum X Y) (Sum__inl X Y) s)) (Set__image Y (Sum X Y) (Sum__inr X Y) (Set__preimage Y (Sum X Y) (Sum__inr X Y) s))) s).

(; //LEAN:Set.image_sumElim ;)
Set__image_sumElim : (X : Set) -> (Y : Set) -> (Z : Set) -> (s : Elem (powerset (Sum X Y))) -> (f : (Elem X -> Z)) -> (g : (Elem Y -> Z)) -> Proof (Eqt (powerset Z) (Set__image (Sum X Y) Z (Sum__elim X Y Z f g) s) (Union__union (powerset Z) (Set__image X Z f (Set__preimage X (Sum X Y) (Sum__inl X Y) s)) (Set__image Y Z g (Set__preimage Y (Sum X Y) (Sum__inr X Y) s)))).

(; //LEAN:Set.range_quot_mk ;)
def Set__range_quot_mk : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> Proof (Eqt (powerset (Quot X r)) (Set__range (Quot X r) X (Quot__mk X r)) (Set__univ (Quot X r))) :=
  X => r => Function__Surjective__range_eq (Quot X r) X (Quot__mk X r) (Quot__mk_surjective X r).

(; //LEAN:Set.range_quot_lift ;)
def Set__range_quot_lift : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (r : (Elem I -> Elem I -> Prop)) -> (hf : Proof (forall I (x => forall I (y => if (r x y) (Eqt X (f x) (f y)))))) -> Proof (Eqt (powerset X) (Set__range X (Quot I r) (Quot__lift I r X f hf)) (Set__range X I f)) :=
  X => I => f => r => hf => Set__ext X (Set__range X (Quot I r) (Quot__lift I r X f hf)) (Set__range X I f) (forallI X (x => iff (exists (Quot I r) (y1 => Eqt X (Quot__lift I r X f hf y1) x)) (exists I (x1 => Eqt X (Quot__lift I r X f hf (Quot__mk I r x1)) x))) (x => Function__Surjective__exists I (Quot I r) (Quot__mk I r) (Quot__mk_surjective I r) (y => Eqt X (Quot__lift I r X f hf y) x))).

(; //LEAN:Set.range_quotient_mk ;)
def Set__range_quotient_mk : (X : Set) -> (s : Proof (Setoid X)) -> Proof (Eqt (powerset (Quotient X s)) (Set__range (Quotient X s) X (Quotient__mk X s)) (Set__univ (Quotient X s))) :=
  X => s => Set__range_quot_mk X (Setoid__r X).

(; //LEAN:Set.range_quotient_lift ;)
def Set__range_quotient_lift : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (_ : Proof (Setoid I)) -> (hf : Proof (forall I (a => forall I (b => if (HasEquiv__Equiv I a b) (Eqt X (f a) (f b)))))) -> Proof (Eqt (powerset X) (Set__range X (Quotient I s) (Quotient__lift I X s f hf)) (Set__range X I f)) :=
  X => I => f => s => hf => Set__range_quot_lift X I f (HasEquiv__Equiv I) hf.

(; //LEAN:Set.range_quotient_mk' ;)
def Set__range_quotient_mk' : (X : Set) -> (s : Proof (Setoid X)) -> Proof (Eqt (powerset (Quotient X s)) (Set__range (Quotient X s) X (Quotient__mk' X)) (Set__univ (Quotient X s))) :=
  X => s => Set__range_quot_mk X (Setoid__r X).

(; //LEAN:Set.Quotient.range_mk'' ;)
def Set__Quotient__range_mk'' : (X : Set) -> (sa : Proof (Setoid X)) -> Proof (Eqt (powerset (Quotient X sa)) (Set__range (Quotient X sa) X (Quotient__mk'' X sa)) (Set__univ (Quotient X sa))) :=
  X => sa => Set__range_quotient_mk X sa.

(; //LEAN:Set.range_quotient_lift_on' ;)
def Set__range_quotient_lift_on' : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (s : Proof (Setoid I)) -> (hf : Proof (forall I (a => forall I (b => if (Setoid__r I a b) (Eqt X (f a) (f b)))))) -> Proof (Eqt (powerset X) (Set__range X (Quotient I s) (x => Quotient__liftOn' I X s x f hf)) (Set__range X I f)) :=
  X => I => f => s => hf => Set__range_quot_lift X I f (Setoid__r I) hf.

(; //LEAN:Set.range_const_subset ;)
def Set__range_const_subset : (X : Set) -> (I : Set) -> (c : Elem X) -> Proof (Set__Subset X (Set__range X I (x => c)) (Singleton__singleton X (powerset X) c)) :=
  X => I => c => iffEr (Set__Subset X (Set__range X I (x => c)) (Singleton__singleton X (powerset X) c)) (forall I (y => Membership__mem X (powerset X) (Singleton__singleton X (powerset X) c) c)) (Set__range_subset_iff X I (x1 => c) (Singleton__singleton X (powerset X) c)) (x2 => rfl X c).

(; //LEAN:Set.range_const ;)
def Set__range_const : (X : Set) -> (I : Set) -> (c : Elem X) -> Proof (Eqt (powerset X) (Set__range X I (x => c)) (Singleton__singleton X (powerset X) c)) :=
