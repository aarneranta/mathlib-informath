(; //LEAN:ZMod.lift._proof_1 ;)
ZMod__lift___proof_1 : (n : Elem Nat) -> (A : Set) -> (_ : Proof (AddGroup A)) -> (x1 : Elem (AddMonoidHom Int A)) -> Proof (iff (Eqt A (x1 (Nat__cast Int n)) 0) (Leq (AddMonoidHom__ker Int (ZMod n) (Int__castAddHom (ZMod n))) (AddMonoidHom__ker Int A x1))).

(; //LEAN:ZMod.unitOfCoprime._proof_1 ;)
ZMod__unitOfCoprime___proof_1 : (n : Elem Nat) -> (x : Elem Nat) -> (h : Proof (Nat__Coprime x n)) -> Proof (Eqt (ZMod n) (times (Inv__inv (ZMod n) (Nat__cast (ZMod n) x)) (Nat__cast (ZMod n) x)) 1).

