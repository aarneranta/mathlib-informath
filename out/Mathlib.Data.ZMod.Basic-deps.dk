ZMod__unitsEquivCoprime___proof_1 : (n : Elem Nat) -> (x : Elem (Subtype (ZMod n) (x2 => Nat__Coprime (ZMod__val n x2) n))) -> Proof (Nat__Coprime (ZMod__val n (Subtype__val (ZMod n) (x1 => Nat__Coprime (ZMod__val n x1) n) x)) n).

