ZMod__ringEquivCongr_symm : (a : Elem Nat) -> (b : Elem Nat) -> (hab : Proof (Eq a b)) -> Proof (Eqt (RingEquiv (ZMod b) (ZMod a)) (RingEquiv__symm (ZMod__ringEquivCongr hab)) (ZMod__ringEquivCongr (Eq__symm hab))).

