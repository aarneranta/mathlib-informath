(; //LEAN:pow_pow_zmod_val_inv ;)
pow_pow_zmod_val_inv : (X : Set) -> (_ : Proof (Group X)) -> (n : Elem Nat) -> (hn : Proof (Eq (gcd (Nat__card X) n) 1)) -> (a : Elem X) -> Proof (Eqt X (pow (pow a n) (ZMod__val (Nat__card X) (Inv__inv (ZMod (Nat__card X)) (Nat__cast (ZMod (Nat__card X)) n)))) a).

