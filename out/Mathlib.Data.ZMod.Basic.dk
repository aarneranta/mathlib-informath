def ZMod__ringEquivCongr_intCast : (a : Elem Nat) -> (b : Elem Nat) -> (h : Proof (Eq a b)) -> (z : Elem Int) -> Proof (Eqt (ZMod b) (ZMod__ringEquivCongr__app h z) z) :=
