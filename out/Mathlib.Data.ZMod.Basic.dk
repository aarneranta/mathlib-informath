ZMod__ringEquivCongr_val : (a : Elem Nat) -> (b : Elem Nat) -> (h : Proof (Eq a b)) -> (x : Elem (ZMod a)) -> Proof (Eq (ZMod__val (ZMod__ringEquivCongr__app h x)) (ZMod__val x)).

