(; //LEAN:Nat.range_mul_add ;)
Nat__range_mul_add : (m : Elem Nat) -> (k : Elem Nat) -> Proof (Eqt (powerset Nat) (Set__range Nat Nat (n => plus (times m n) k)) (Set__ofPred Nat (n1 => and (Eqt (ZMod m) (Nat__cast (ZMod m) n1) (Nat__cast (ZMod m) k)) (Leq k n1)))).

(; //LEAN:Nat.residueClassesEquiv ;)
def Nat__residueClassesEquiv : (N : Elem Nat) -> Elem (Equiv Nat (Prod (ZMod N) Nat)) :=
  N => Equiv__mk Nat (Prod (ZMod N) Nat) (n => Prod__mk (ZMod N) Nat (Nat__cast (ZMod N) n) (div n N)) (p => plus (ZMod__val N (Prod__fst (ZMod N) Nat p)) (times N (Prod__snd (ZMod N) Nat p))) (n1 => Nat__residueClassesEquiv___proof_1 N n1) (p1 => Nat__residueClassesEquiv___proof_2 N p1).

