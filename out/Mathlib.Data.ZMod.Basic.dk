ZMod__ringEquivCongr_ringEquivCongr_apply : (a : Elem Nat) -> (b : Elem Nat) -> (c : Elem Nat) -> (hab : Proof (Eq a b)) -> (hbc : Proof (Eq b c)) -> (x : Elem (ZMod a)) -> Proof (Eqt (ZMod c) (ZMod__ringEquivCongr__app hbc (ZMod__ringEquivCongr__app hab x)) (ZMod__ringEquivCongr__app (Eq__trans hab hbc) x)).

