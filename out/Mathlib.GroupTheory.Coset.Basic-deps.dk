AddSubgroup__rightCosetEquivAddSubgroup___proof_6 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (g : Elem X) -> (x1 : Elem (Set__Elem X (HVAdd__hVAdd (AddOpposite X) (powerset X) (powerset X) (AddOpposite__op X g) (SetLike__coe (AddSubgroup X) X s)))) -> Proof (Eqt (Set__Elem X (HVAdd__hVAdd (AddOpposite X) (powerset X) (powerset X) (AddOpposite__op X g) (SetLike__coe (AddSubgroup X) X s))) (Subtype__mk X (x2 => Membership__mem X (powerset X) (HVAdd__hVAdd (AddOpposite X) (powerset X) (powerset X) (AddOpposite__op X g) (SetLike__coe (AddSubgroup X) X s)) x2) (plus (Subtype__val X (x3 => Membership__mem X (AddSubgroup X) s x3) (Subtype__mk X (x4 => Membership__mem X (AddSubgroup X) s x4) (plus (Subtype__val X (x5 => Membership__mem X (powerset X) (HVAdd__hVAdd (AddOpposite X) (powerset X) (powerset X) (AddOpposite__op X g) (SetLike__coe (AddSubgroup X) X s)) x5) x1) (Neg__neg X g)) (AddSubgroup__rightCosetEquivAddSubgroup___proof_1 X s g x1))) g) (AddSubgroup__rightCosetEquivAddSubgroup___proof_5 X s g x1)) x1).

