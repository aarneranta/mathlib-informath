QuotientGroup__quotientEquivSelf___proof_2 : (X : Set) -> (x : Elem (Group__on X)) -> (x1 : Elem X) -> (y : Elem X) -> (h : Proof (Setoid__r__in X (QuotientGroup__leftRel X (Bot__bot (Subgroup X))) x1 y)) -> Proof (Eqt X (id X x1) (id X y)).

(; //LEAN:QuotientGroup.quotientEquivSelf._proof_3 ;)
QuotientGroup__quotientEquivSelf___proof_3 : (X : Set) -> (_ : Proof (Group X)) -> (x1 : Elem (HasQuotient__Quotient X (Subgroup X) (Bot__bot (Subgroup X)))) -> Proof (Eqt (HasQuotient__Quotient X (Subgroup X) (Bot__bot (Subgroup X))) (QuotientGroup__mk X (Bot__bot (Subgroup X)) (Quotient__lift X X (QuotientGroup__leftRel X (Bot__bot (Subgroup X))) (id X) (x2 => y => h => eq_of_inv_mul_eq_one X (id X x2) (id X y) (QuotientGroup__quotientEquivSelf___proof_1 X x2 y h)) x1)) x1).

(; //LEAN:QuotientGroup.quotientEquivSelf._proof_4 ;)
QuotientGroup__quotientEquivSelf___proof_4 : (X : Set) -> (_ : Proof (Group X)) -> (x1 : Elem X) -> Proof (Eqt X (Quotient__lift X X (QuotientGroup__leftRel X (Bot__bot (Subgroup X))) (id X) (x2 => y => h => eq_of_inv_mul_eq_one X (id X x2) (id X y) (QuotientGroup__quotientEquivSelf___proof_1 X x2 y h)) (QuotientGroup__mk X (Bot__bot (Subgroup X)) x1)) x1).

(; doc: The equivalence relation corresponding to the partition of a group by right cosets of a subgroup. ;)
(; //LEAN:QuotientGroup.rightRel ;)
QuotientGroup__rightRel : (X : Set) -> (s : Elem (Subgroup X)) -> Elem (Setoid__on X).

(; doc: A semigroup is a type with an associative `(*)`. ;)
(; //LEAN:Semigroup ;)
Semigroup : (G : Set) -> Prop.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (X : Set) -> (s : Elem (powerset X)) -> Set.

(; doc: The subtypes corresponding to equal sets are equivalent.  See also `Finset.equivOfEq`. ;)
(; //LEAN:Set.equivOfEq ;)
Set__equivOfEq : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) s t)) -> Elem (Equiv (Set__Elem X s) (Set__Elem X t)).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem X (powerset X) a x) (Membership__mem X (powerset X) b x)))) -> Proof (Eqt (powerset X) a b).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (X : Set) -> (I : Set) -> (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.mem_image_of_mem ;)
Set__mem_image_of_mem : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x : Elem X) -> (a : Elem (powerset X)) -> (h : Proof (Membership__mem X (powerset X) a x)) -> Proof (Membership__mem Y (powerset Y) (Set__image X Y f a) (f x)).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : (X : Set) -> Elem (powerset X).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set`. ;)
(; //LEAN:SetLike.coe ;)
SetLike__coe : (A : Set) -> (B : Set) -> (x : Elem A) -> Elem (powerset B).

(; //LEAN:SetLike.mem_coe ;)
SetLike__mem_coe : (A : Set) -> (B : Set) -> (p : Elem A) -> (x : Elem B) -> Proof (iff (Membership__mem B (powerset B) (SetLike__coe A B p) x) (Membership__mem B A p x)).

(; doc: A setoid is a type with a distinguished equivalence relation, denoted `≈`.  The `Quotient` type constructor requires a `Setoid` instance. ;)
(; //LEAN:Setoid ;)
Setoid : (X : Set) -> Prop.

(; doc: Given types `α`, `β`, the product of two equivalence relations `r` on `α` and `s` on `β`: `(x₁, x₂), (y₁, y₂) ∈ α × β` are related by `r.prod s` iff `x₁` is related to `y₁` by `r` and `x₂` is related to `y₂` by `s`. ;)
(; //LEAN:Setoid.prod ;)
Setoid__prod : (X : Set) -> (Y : Set) -> (r : Proof (Setoid X)) -> (s : Proof (Setoid Y)) -> Elem (Setoid__on (Prod X Y)).

(; doc: Dependent pairs, in which the second element's type depends on the value of the first element. The type `Sigma β` is typically written `Σ a : α, β a` or `(a : α) × β a`.  Although its values are pairs, `Sigma` is sometimes known as the *dependent sum type*, since it is the type level version of an indexed summation. ;)
(; //LEAN:Sigma ;)
Sigma : (X : Set) -> (beta : (Elem X -> Set)) -> Set.

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (X : Set) -> (Y : Set) -> (x : Elem X) -> Elem Y.

(; doc: A function `f` is strictly monotone if `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMono ;)
StrictMono : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (G : Set) -> (H : Elem (Subgroup G)) -> Prop.

(; //LEAN:Subgroup.Normal.mk ;)
Subgroup__Normal__mk : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (conj_mem : Proof (forall G (n => if (Membership__mem G (Subgroup G) H n) (forall G (g => Membership__mem G (Subgroup G) H (times (times g n) (Inv__inv G g))))))) -> Proof (Subgroup__Normal G H).

(; doc: The preimage of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.comap ;)
Subgroup__comap : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup N)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.groupEquivQuotientProdSubgroup._proof_1 ;)
Subgroup__groupEquivQuotientProdSubgroup___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (L : Elem (HasQuotient__Quotient X (Subgroup X) s)) -> Proof (Eqt Set (Equiv (Subtype X (x1 => Eqt (HasQuotient__Quotient X (Subgroup X) s) (QuotientGroup__mk X s x1) L)) (Set__Elem X (HSMul__hSMul X (powerset X) (powerset X) (Quotient__out X (QuotientGroup__leftRel X s) L) (SetLike__coe (Subgroup X) X s)))) (Equiv (Subtype X (x2 => Eqt (HasQuotient__Quotient X (Subgroup X) s) (QuotientGroup__mk X s x2) L)) (Set__Elem X (Set__ofPred X (x3 => Eqt (HasQuotient__Quotient X (Subgroup X) s) (QuotientGroup__mk X s x3) (QuotientGroup__mk X s (Quotient__out X (QuotientGroup__leftRel X s) L))))))).

