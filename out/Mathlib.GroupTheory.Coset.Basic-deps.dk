(; constants used by Mathlib.GroupTheory.Coset.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__fiberEquivKer__app : (a1 : Elem (AddMonoidHom X H)) -> (a2 : Elem X) -> (a3 : Elem (Set__Elem (Set__preimage f (Singleton__singleton (f a))))) -> Elem (Subtype (x2 => Membership__mem (AddMonoidHom__ker f) x2)).

(; a constant applied as a function: DFunLike.coe ;)
AddMonoidHom__fiberEquiv__app : (a1 : Elem (AddMonoidHom X H)) -> (a2 : Elem X) -> (a3 : Elem X) -> (a4 : Elem (Set__Elem (Set__preimage f (Singleton__singleton (f a))))) -> Elem (Set__Elem (Set__preimage f (Singleton__singleton (f b)))).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__inclusion__app : (a1 : Proof (Leq s t)) -> (a2 : Elem (Subtype (x4 => Membership__mem s x4))) -> Elem (Subtype (x5 => Membership__mem t x5)).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__quotientAddSubgroupOfEmbeddingOfLE__app : (a1 : Elem (AddSubgroup X)) -> (a2 : Proof (Leq s t)) -> (a3 : Elem (HasQuotient__Quotient (Subtype (x2 => Membership__mem s x2)) (AddSubgroup__addSubgroupOf H s))) -> Elem (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (AddSubgroup__addSubgroupOf H t)).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__quotientEquivProdOfLE'__app : (a1 : Proof (Leq s t)) -> (a2 : (Elem (HasQuotient__Quotient X t) -> X)) -> (a3 : Proof (Function__RightInverse f QuotientAddGroup__mk)) -> (a4 : Elem (HasQuotient__Quotient X s)) -> Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (AddSubgroup__addSubgroupOf s t))).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__quotientEquivProdOfLE__app : (a1 : Proof (Leq s t)) -> (a2 : Elem (HasQuotient__Quotient X s)) -> Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x2 => Membership__mem t x2)) (AddSubgroup__addSubgroupOf s t))).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__quotientiInfAddSubgroupOfEmbedding__app : (a1 : (Elem I -> AddSubgroup X)) -> (a2 : Elem (AddSubgroup X)) -> (a3 : Elem (HasQuotient__Quotient (Subtype (x3 => Membership__mem H x3)) (AddSubgroup__addSubgroupOf (iInf (i1 => f i1)) H))) -> (a4 : Elem I) -> Elem (HasQuotient__Quotient (Subtype (x4 => Membership__mem H x4)) (AddSubgroup__addSubgroupOf (f i) H)).

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__quotientiInfEmbedding__app : (a1 : (Elem I -> AddSubgroup X)) -> (a2 : Elem (HasQuotient__Quotient X (iInf (i1 => f i1)))) -> (a3 : Elem I) -> Elem (HasQuotient__Quotient X (f i)).

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv (Set__Elem (Set__preimage f (Singleton__singleton (f a)))) (Set__Elem (Set__preimage f (Singleton__singleton (f b)))))) -> (a2 : Elem (Set__Elem (Set__preimage f (Singleton__singleton (f b))))) -> Elem (Set__Elem (Set__preimage f (Singleton__singleton (f a)))).

(; a constant applied as a function: DFunLike.coe ;)
MonoidHom__fiberEquivKer__app : (a1 : Elem (MonoidHom X H)) -> (a2 : Elem X) -> (a3 : Elem (Set__Elem (Set__preimage f (Singleton__singleton (f a))))) -> Elem (Subtype (x2 => Membership__mem (MonoidHom__ker f) x2)).

(; a constant applied as a function: DFunLike.coe ;)
MonoidHom__fiberEquiv__app : (a1 : Elem (MonoidHom X H)) -> (a2 : Elem X) -> (a3 : Elem X) -> (a4 : Elem (Set__Elem (Set__preimage f (Singleton__singleton (f a))))) -> Elem (Set__Elem (Set__preimage f (Singleton__singleton (f b)))).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__inclusion__app : (a1 : Proof (Leq s t)) -> (a2 : Elem (Subtype (x4 => Membership__mem s x4))) -> Elem (Subtype (x5 => Membership__mem t x5)).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__quotientEquivProdOfLE'__app : (a1 : Proof (Leq s t)) -> (a2 : (Elem (HasQuotient__Quotient X t) -> X)) -> (a3 : Proof (Function__RightInverse f QuotientGroup__mk)) -> (a4 : Elem (HasQuotient__Quotient X s)) -> Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (Subgroup__subgroupOf s t))).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__quotientEquivProdOfLE__app : (a1 : Proof (Leq s t)) -> (a2 : Elem (HasQuotient__Quotient X s)) -> Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x2 => Membership__mem t x2)) (Subgroup__subgroupOf s t))).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__quotientSubgroupOfEmbeddingOfLE__app : (a1 : Elem (Subgroup X)) -> (a2 : Proof (Leq s t)) -> (a3 : Elem (HasQuotient__Quotient (Subtype (x2 => Membership__mem s x2)) (Subgroup__subgroupOf H s))) -> Elem (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (Subgroup__subgroupOf H t)).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__quotientiInfEmbedding__app : (a1 : (Elem I -> Subgroup X)) -> (a2 : Elem (HasQuotient__Quotient X (iInf (i1 => f i1)))) -> (a3 : Elem I) -> Elem (HasQuotient__Quotient X (f i)).

(; a constant applied as a function: DFunLike.coe ;)
Subgroup__quotientiInfSubgroupOfEmbedding__app : (a1 : (Elem I -> Subgroup X)) -> (a2 : Elem (Subgroup X)) -> (a3 : Elem (HasQuotient__Quotient (Subtype (x3 => Membership__mem H x3)) (Subgroup__subgroupOf (iInf (i1 => f i1)) H))) -> (a4 : Elem I) -> Elem (HasQuotient__Quotient (Subtype (x4 => Membership__mem H x4)) (Subgroup__subgroupOf (f i) H)).

(; doc: The orbit of an element under an action. ;)
(; //LEAN:AddAction.orbit ;)
AddAction__orbit : (Z : Set) -> (a : Elem X) -> Elem (powerset X).

(; doc: The orbit corresponding to an element of the quotient by `AddAction.orbitRel` ;)
(; //LEAN:AddAction.orbitRel.Quotient.orbit ;)
AddAction__orbitRel__Quotient__orbit : (x2 : Elem (AddAction__orbitRel__Quotient G X)) -> Elem (powerset X).

(; doc: An `AddGroup` is an `AddMonoid` with a unary `-` satisfying `-a + a = 0`.  There is also a binary operation `-` such that `a - b = a + -b`, with a default so that `a - b = a + -b` holds by definition.  Use `AddGroup.ofLeftAxioms` or `AddGroup.ofRightAxioms` to define an additive group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:AddGroup ;)
AddGroup : (A : Set) -> Prop.

(; doc: An `AddMonoid` is an `AddSemigroup` with an element `0` such that `0 + a = a + 0 = a`. ;)
(; //LEAN:AddMonoid ;)
AddMonoid : (M : Set) -> Prop.

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: The additive kernel of an `AddMonoid` homomorphism is the `AddSubgroup` of elements such that `f x = 0` ;)
(; //LEAN:AddMonoidHom.ker ;)
AddMonoidHom__ker : (f : Elem (AddMonoidHom G M)) -> Elem (AddSubgroup G).

(; doc: The element of `αᵃᵒᵖ` that represents `x : α`. ;)
(; //LEAN:AddOpposite.op ;)
AddOpposite__op : (x : Elem X) -> Elem (AddOpposite X).

(; doc: An additive semigroup is a type with an associative `(+)`. ;)
(; //LEAN:AddSemigroup ;)
AddSemigroup : (G : Set) -> Prop.

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (H : Elem (AddSubgroup A)) -> Prop.

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype (x1 => Membership__mem K x1))).

(; doc: The preimage of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.comap ;)
AddSubgroup__comap : (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup N)) -> Elem (AddSubgroup G).

(; doc: A version of `Set.pi` for `AddSubgroup`s. Given an index set `I` and a family of submodules `s : Π i, AddSubgroup f i`, `pi I s` is the `AddSubgroup` of dependent functions `f : Π i, f i` such that `f i` belongs to `pi I s` whenever `i ∈ I`. ;)
(; //LEAN:AddSubgroup.pi ;)
AddSubgroup__pi : (I : Elem (powerset X)) -> (H : ((i1 : Elem X) -> AddSubgroup (f i1))) -> Elem (AddSubgroup ((i : Elem X) -> f i)).

(; doc: Given `AddSubgroup`s `H`, `K` of `AddGroup`s `A`, `B` respectively, `H × K` as an `AddSubgroup` of `A × B`. ;)
(; //LEAN:AddSubgroup.prod ;)
AddSubgroup__prod : (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> Elem (AddSubgroup (Prod G N)).

(; //LEAN:AddSubgroup.quotientEquivProdOfLE'._proof_1 ;)
AddSubgroup__quotientEquivProdOfLE'___proof_1 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (t : Elem (AddSubgroup X)) -> (h_le : Proof (Leq s t)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (hf : Proof (Function__RightInverse f QuotientAddGroup__mk)) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Setoid__r b c)) -> Proof (Setoid__r (plus (Neg__neg (f (Quotient__mk'' b))) b) (plus (Neg__neg (f (Quotient__mk'' c))) c)).

(; //LEAN:AddSubgroup.quotientEquivProdOfLE'._proof_2 ;)
AddSubgroup__quotientEquivProdOfLE'___proof_2 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (t : Elem (AddSubgroup X)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (a : Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (AddSubgroup__addSubgroupOf s t)))) -> (b : Elem (Subtype (x2 => Membership__mem t x2))) -> (c : Elem (Subtype (x1 => Membership__mem t x1))) -> (h : Proof (Setoid__r b c)) -> Proof (Setoid__r (plus (f (Prod__fst a)) b) (plus (f (Prod__fst a)) c)).

(; //LEAN:AddSubgroup.quotientEquivProdOfLE'._proof_5 ;)
AddSubgroup__quotientEquivProdOfLE'___proof_5 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (t : Elem (AddSubgroup X)) -> (h_le : Proof (Leq s t)) -> (x1 : Elem X) -> (x2 : Elem X) -> (h : Proof (Setoid__r x1 x2)) -> Proof (Setoid__r (id x1) (id x2)).

(; //LEAN:AddSubgroup.quotientEquivProdOfLE._proof_1 ;)
AddSubgroup__quotientEquivProdOfLE___proof_1 : (X : Set) -> (_ : Proof (AddGroup X)) -> (t : Elem (AddSubgroup X)) -> (q : Elem (Quotient (QuotientAddGroup__leftRel t))) -> Proof (Eqt (Quotient (QuotientAddGroup__leftRel t)) (Quotient__mk'' (Quotient__out q)) q).

(; //LEAN:AddSubgroup.quotientiInfAddSubgroupOfEmbedding._proof_1 ;)
AddSubgroup__quotientiInfAddSubgroupOfEmbedding___proof_1 : (X : Set) -> (_ : Proof (AddGroup X)) -> (I : Set) -> (f : (Elem I -> AddSubgroup X)) -> (i : Elem I) -> Proof (Leq (iInf f) (f i)).

(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype (x1 => Membership__mem H x1)) G).

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.mk ;)
Equiv__mk : (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: Any type is equivalent to itself. ;)
(; //LEAN:Equiv.refl ;)
Equiv__refl : (X : Set) -> Elem (Equiv X X).

(; doc: A family of equivalences `Π a, β₁ a ≃ β₂ a` generates an equivalence between `Σ a, β₁ a` and `Σ a, β₂ a`. ;)
(; //LEAN:Equiv.sigmaCongrRight ;)
Equiv__sigmaCongrRight : (F : ((a2 : Elem X) -> Equiv (x a2) (x1 a2))) -> Elem (Equiv (Sigma (a => x a)) (Sigma (a1 => x1 a1))).

(; doc: `Sigma` type with a constant fiber is equivalent to the product. ;)
(; //LEAN:Equiv.sigmaEquivProd ;)
Equiv__sigmaEquivProd : (X : Set) -> (Y : Set) -> Elem (Equiv (Sigma (x => Y)) (Prod X Y)).

(; doc: `sigmaFiberEquiv f` for `f : α → β` is the natural equivalence between the type of all fibres of `f` and the total space `α`. ;)
(; //LEAN:Equiv.sigmaFiberEquiv ;)
Equiv__sigmaFiberEquiv : (f : (Elem X -> Y)) -> Elem (Equiv (Sigma (y => Subtype (x => Eqt Y (f x) y))) X).

(; doc: Inverse of an equivalence `e : α ≃ β`. ;)
(; //LEAN:Equiv.symm ;)
Equiv__symm : (e : Elem (Equiv X Y)) -> Elem (Equiv Y X).

(; doc: Composition of equivalences `e₁ : α ≃ β` and `e₂ : β ≃ γ`. ;)
(; //LEAN:Equiv.trans ;)
Equiv__trans : (x : Elem (Equiv X Y)) -> (x1 : Elem (Equiv Y Z)) -> Elem (Equiv X Z).

(; doc: An equivalence relation `r : α → α → Prop` is a relation that is  * reflexive: `r x x`, * symmetric: `r x y` implies `r y x`, and * transitive: `r x y` and `r y z` implies `r x z`.  Equality is an equivalence relation, and equivalence relations share many of the properties of equality. ;)
(; //LEAN:Equivalence ;)
Equivalence : (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; //LEAN:Equivalence.mk ;)
Equivalence__mk : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (refl : Proof (forall X (x2 => r x2 x2))) -> (symm : Proof (forall X (x1 => forall X (y1 => if (r x1 y1) (r y1 x1))))) -> (trans : Proof (forall X (x => forall X (y => forall X (z => if (r x y) (if (r y z) (r x z))))))) -> Proof (Equivalence r).

(; doc: `α ↪ β` is a bundled injective function. ;)
(; //LEAN:Function.Embedding ;)
Function__Embedding : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Function.Embedding.mk ;)
Function__Embedding__mk : (toFun : (Elem X -> Y)) -> (inj' : Proof (Function__Injective toFun)) -> Elem (Function__Embedding X Y).

(; doc: `RightInverse g f` means that `g` is a right inverse to `f`. That is, `f ∘ g = id`. ;)
(; //LEAN:Function.RightInverse ;)
Function__RightInverse : (g : (Elem Y -> X)) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (f : (Elem X -> Y)) -> Prop.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: `a +ᵥ b` computes the sum of `a` and `b`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `+ᵥ` in identifiers is `vadd`. ;)
(; //LEAN:HVAdd.hVAdd ;)
HVAdd__hVAdd : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: `HasQuotient.Quotient A b` (denoted as `A ⧸ b`) is the quotient of the type `A` by `b`. ;)
(; //LEAN:HasQuotient.Quotient ;)
HasQuotient__Quotient : (A : Elem (outParam Set)) -> (x : Elem B) -> Set.

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (x : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MonoidHom.fiberEquivKer._proof_2 ;)
MonoidHom__fiberEquivKer___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (H : Set) -> (_ : Proof (Group H)) -> (f : Elem (MonoidHom X H)) -> (a : Elem X) -> Proof (Eqt (powerset X) (Set__preimage f (Singleton__singleton (f a))) (HSMul__hSMul a (MonoidHom__ker f))).

(; doc: The multiplicative kernel of a monoid homomorphism is the subgroup of elements `x : G` such that `f x = 1` ;)
(; //LEAN:MonoidHom.ker ;)
MonoidHom__ker : (f : Elem (MonoidHom G M)) -> Elem (Subgroup G).

(; doc: The orbit of an element under an action. ;)
(; //LEAN:MulAction.orbit ;)
MulAction__orbit : (Z : Set) -> (a : Elem X) -> Elem (powerset X).

(; doc: The orbit corresponding to an element of the quotient by `MulAction.orbitRel` ;)
(; //LEAN:MulAction.orbitRel.Quotient.orbit ;)
MulAction__orbitRel__Quotient__orbit : (x2 : Elem (MulAction__orbitRel__Quotient G X)) -> Elem (powerset X).

(; //LEAN:MulOne.toOne ;)
MulOne__toOne : Proof (One M).

(; doc: Multiplicative opposite of a type. This type inherits all additive structures on `α` and reverses left and right in multiplication. ;)
(; //LEAN:MulOpposite ;)
MulOpposite : (X : Set) -> Set.

(; doc: The element of `MulOpposite α` that represents `x : α`. ;)
(; //LEAN:MulOpposite.op ;)
MulOpposite__op : (x : Elem X) -> Elem (MulOpposite X).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; doc: By definition, if we have `OneMemClass S M`, we have `1 ∈ s` for all `s : S`. ;)
(; //LEAN:OneMemClass.one_mem ;)
OneMemClass__one_mem : (S : Set) -> (M : Elem (outParam Set)) -> (x : Proof (One M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (OneMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem s 1).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; doc: Quotient types coarsen the propositional equality for a type so that terms related by some equivalence relation are considered equal. The equivalence relation is given by an instance of `Setoid`.  Set-theoretically, `Quotient s` can seen as the set of equivalence classes of `α` modulo the `Setoid` instance's relation `s.r`. Functions from `Quotient s` must prove that they respect `s.r`: to define a function `f : Quotient s → β`, it is necessary to provide `f' : α → β` and prove that for all `x : α` and `y : α`, `s.r x y → f' x = f' y`. `Quotient.lift` implements this operation.  The key quotient operators are:  * `Quotient.mk` places elements of the underlying type `α` into the quotient.  * `Quotient.lift` allows the definition of functions from the quotient to some other type.  * `Quotient.sound` asserts the equality of elements related by `r`  * `Quotient.ind` is used to write proofs about quotients by assuming that all elements are    constructed with `Quotient.mk`.  `Quotient` is built on top of the primitive quotient type `Quot`, which does not require a proof that the relation is an equivalence relation. `Quotient` should be used instead of `Quot` for relations that actually are equivalence relations. ;)
(; //LEAN:Quotient ;)
Quotient : (s : Proof (Setoid X)) -> Set.

(; doc: Lifts a function from an underlying type to a function on a quotient, requiring that it respects the quotient's equivalence relation.  Given `s : Setoid α` and a quotient `Quotient s`, applying a function `f : α → β` requires a proof `h` that `f` respects the equivalence relation `s.r`. In this case, the function `Quotient.lift f h : Quotient s → β` computes the same values as `f`.  `Quotient.liftOn` is a version of this operation that takes the quotient value as its first explicit parameter. ;)
(; //LEAN:Quotient.lift ;)
Quotient__lift : (f : (Elem X -> Y)) -> (h : Proof (forall X (a => forall X (b => if (HasEquiv__Equiv a b) (Eqt Y (f a) (f b)))))) -> (x : Elem (Quotient s)) -> Elem Y.

(; doc: Map a function `f : α → β` that sends equivalent elements to equivalent elements to a function `Quotient sa → Quotient sb`. Useful to define unary operations on quotients. This is a version of `Quotient.map` using `Setoid.r` instead of `≈`. ;)
(; //LEAN:Quotient.map' ;)
Quotient__map' : (f : (Elem X -> Y)) -> (h : Proof (forall X (a => forall X (b => if (Setoid__r a b) (Setoid__r (f a) (f b)))))) -> (x2 : Elem (Quotient x)) -> Elem (Quotient x1).

(; doc: A version of `Quotient.mk` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.mk'' ;)
Quotient__mk'' : (a : Elem X) -> Elem (Quotient x).

(; doc: Choose an element of the equivalence class using the axiom of choice. Sound but noncomputable. ;)
(; //LEAN:Quotient.out ;)
Quotient__out : (x : Elem (Quotient s)) -> Elem X.

(; doc: The equivalence relation corresponding to the partition of a group by left cosets of a subgroup. ;)
(; //LEAN:QuotientAddGroup.leftRel ;)
QuotientAddGroup__leftRel : (s : Elem (AddSubgroup X)) -> Proof (Setoid X).

(; doc: The canonical map from an `AddGroup` `α` to the quotient `α ⧸ s`. ;)
(; //LEAN:QuotientAddGroup.mk ;)
QuotientAddGroup__mk : (a : Elem X) -> Elem (HasQuotient__Quotient X s).

(; doc: The equivalence relation corresponding to the partition of a group by right cosets of a subgroup. ;)
(; //LEAN:QuotientAddGroup.rightRel ;)
QuotientAddGroup__rightRel : (s : Elem (AddSubgroup X)) -> Proof (Setoid X).

(; //LEAN:QuotientGroup.eq ;)
QuotientGroup__eq : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt (HasQuotient__Quotient X s) (QuotientGroup__mk a) (QuotientGroup__mk b)) (Membership__mem s (times (Inv__inv a) b))).

(; doc: The equivalence relation corresponding to the partition of a group by left cosets of a subgroup. ;)
(; //LEAN:QuotientGroup.leftRel ;)
QuotientGroup__leftRel : (s : Elem (Subgroup X)) -> Proof (Setoid X).

(; doc: The canonical map from a group `α` to the quotient `α ⧸ s`. ;)
(; //LEAN:QuotientGroup.mk ;)
QuotientGroup__mk : (a : Elem X) -> Elem (HasQuotient__Quotient X s).

(; //LEAN:QuotientGroup.preimageMkEquivSubgroupProdSet._proof_10 ;)
QuotientGroup__preimageMkEquivSubgroupProdSet___proof_10 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (powerset (HasQuotient__Quotient X s))) -> (x1 : Elem (Prod (Subtype (x3 => Membership__mem s x3)) (Set__Elem t))) -> Proof (Eqt (Prod (Subtype (x2 => Membership__mem s x2)) (Set__Elem t)) (Prod__mk (times (Inv__inv (Quotient__out (QuotientGroup__mk (times (Quotient__out (Prod__snd x1)) (Prod__fst x1))))) (times (Quotient__out (Prod__snd x1)) (Prod__fst x1))) (QuotientGroup__mk (times (Quotient__out (Prod__snd x1)) (Prod__fst x1)))) x1).

(; //LEAN:QuotientGroup.preimageMkEquivSubgroupProdSet._proof_4 ;)
QuotientGroup__preimageMkEquivSubgroupProdSet___proof_4 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (powerset (HasQuotient__Quotient X s))) -> (x1 : Elem (Set__Elem (Set__preimage QuotientGroup__mk t))) -> Proof (Eqt (Set__Elem (Set__preimage QuotientGroup__mk t)) (times (Quotient__out (Prod__snd (Prod__mk (times (Inv__inv (Quotient__out (QuotientGroup__mk x1))) x1) (QuotientGroup__mk x1)))) (Prod__fst (Prod__mk (times (Inv__inv (Quotient__out (QuotientGroup__mk x1))) x1) (QuotientGroup__mk x1)))) x1).

(; //LEAN:QuotientGroup.quotientEquivSelf._proof_2 ;)
QuotientGroup__quotientEquivSelf___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (x1 : Elem X) -> (y : Elem X) -> (h : Proof (Setoid__r x1 y)) -> Proof (Eqt X (id x1) (id y)).

(; //LEAN:QuotientGroup.quotientEquivSelf._proof_3 ;)
QuotientGroup__quotientEquivSelf___proof_3 : (X : Set) -> (_ : Proof (Group X)) -> (x1 : Elem (HasQuotient__Quotient X Bot__bot)) -> Proof (Eqt (HasQuotient__Quotient X Bot__bot) (QuotientGroup__mk (Quotient__lift id (x2 => y => h => eq_of_inv_mul_eq_one (QuotientGroup__quotientEquivSelf___proof_1 X x2 y h)) x1)) x1).

(; //LEAN:QuotientGroup.quotientEquivSelf._proof_4 ;)
QuotientGroup__quotientEquivSelf___proof_4 : (X : Set) -> (_ : Proof (Group X)) -> (x1 : Elem X) -> Proof (Eqt X (Quotient__lift id (x2 => y => h => eq_of_inv_mul_eq_one (QuotientGroup__quotientEquivSelf___proof_1 X x2 y h)) (QuotientGroup__mk x1)) x1).

(; doc: The equivalence relation corresponding to the partition of a group by right cosets of a subgroup. ;)
(; //LEAN:QuotientGroup.rightRel ;)
QuotientGroup__rightRel : (s : Elem (Subgroup X)) -> Proof (Setoid X).

(; doc: A semigroup is a type with an associative `(*)`. ;)
(; //LEAN:Semigroup ;)
Semigroup : (G : Set) -> Prop.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (s : Elem (powerset X)) -> Set.

(; doc: The subtypes corresponding to equal sets are equivalent.  See also `Finset.equivOfEq`. ;)
(; //LEAN:Set.equivOfEq ;)
Set__equivOfEq : (h : Proof (Eqt (powerset X) s t)) -> Elem (Equiv (Set__Elem s) (Set__Elem t)).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem a x) (Membership__mem b x)))) -> Proof (Eqt (powerset X) a b).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.mem_image_of_mem ;)
Set__mem_image_of_mem : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x : Elem X) -> (a : Elem (powerset X)) -> (h : Proof (Membership__mem a x)) -> Proof (Membership__mem (Set__image f a) (f x)).

(; //LEAN:Set.mem_ofPred_eq ;)
Set__mem_ofPred_eq : (X : Set) -> (x : Elem X) -> (p : (Elem X -> Prop)) -> Proof (Eqt Prop (Membership__mem (Set__ofPred (y => p y)) x) (p x)).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : Elem (powerset X).

(; //LEAN:SetLike.mem_coe ;)
SetLike__mem_coe : (A : Set) -> (B : Set) -> (p : Elem A) -> (x : Elem B) -> Proof (iff (Membership__mem p x) (Membership__mem p x)).

(; doc: A setoid is a type with a distinguished equivalence relation, denoted `≈`.  The `Quotient` type constructor requires a `Setoid` instance. ;)
(; //LEAN:Setoid ;)
Setoid : (X : Set) -> Prop.

(; doc: Given types `α`, `β`, the product of two equivalence relations `r` on `α` and `s` on `β`: `(x₁, x₂), (y₁, y₂) ∈ α × β` are related by `r.prod s` iff `x₁` is related to `y₁` by `r` and `x₂` is related to `y₂` by `s`. ;)
(; //LEAN:Setoid.prod ;)
Setoid__prod : (r : Proof (Setoid X)) -> (s : Proof (Setoid Y)) -> Proof (Setoid (Prod X Y)).

(; doc: `x ≈ y` is the distinguished equivalence relation of a setoid. ;)
(; //LEAN:Setoid.r ;)
Setoid__r : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; doc: A function `f` is strictly monotone if `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMono ;)
StrictMono : (f : (Elem X -> Y)) -> Prop.

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (H : Elem (Subgroup G)) -> Prop.

(; //LEAN:Subgroup.Normal.mk ;)
Subgroup__Normal__mk : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (conj_mem : Proof (forall G (n => if (Membership__mem H n) (forall G (g => Membership__mem H (times (times g n) (Inv__inv g))))))) -> Proof (Subgroup__Normal H).

(; doc: The preimage of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.comap ;)
Subgroup__comap : (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup N)) -> Elem (Subgroup G).

(; //LEAN:Subgroup.groupEquivQuotientProdSubgroup._proof_1 ;)
Subgroup__groupEquivQuotientProdSubgroup___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (L : Elem (HasQuotient__Quotient X s)) -> Proof (Eqt Set (Equiv (Subtype (x1 => Eqt (HasQuotient__Quotient X s) (QuotientGroup__mk x1) L)) (Set__Elem (HSMul__hSMul (Quotient__out L) s))) (Equiv (Subtype (x2 => Eqt (HasQuotient__Quotient X s) (QuotientGroup__mk x2) L)) (Set__Elem (Set__ofPred (x3 => Eqt (HasQuotient__Quotient X s) (QuotientGroup__mk x3) (QuotientGroup__mk (Quotient__out L))))))).

(; //LEAN:Subgroup.groupEquivQuotientProdSubgroup._proof_2 ;)
Subgroup__groupEquivQuotientProdSubgroup___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (L : Elem (HasQuotient__Quotient X s)) -> Proof (Eqt Set (Equiv (Subtype (x1 => Eqt (Quotient (QuotientGroup__leftRel s)) (Quotient__mk'' x1) L)) (Subtype (x2 => Eqt (Quotient (QuotientGroup__leftRel s)) (Quotient__mk'' x2) (Quotient__mk'' (Quotient__out L))))) (Equiv (Subtype (x3 => Eqt (Quotient (QuotientGroup__leftRel s)) (Quotient__mk'' x3) L)) (Subtype (x4 => Eqt (Quotient (QuotientGroup__leftRel s)) (Quotient__mk'' x4) L)))).

(; doc: The inclusion homomorphism from a subgroup `H` contained in `K` to `K`. ;)
(; //LEAN:Subgroup.inclusion ;)
Subgroup__inclusion : (h : Proof (Leq H K)) -> Elem (MonoidHom (Subtype (x1 => Membership__mem H x1)) (Subtype (x2 => Membership__mem K x2))).

(; //LEAN:Subgroup.leftCosetEquivSubgroup._proof_4 ;)
Subgroup__leftCosetEquivSubgroup___proof_4 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (g : Elem X) -> (x1 : Elem (Set__Elem (HSMul__hSMul g s))) -> Proof (Eqt (Set__Elem (HSMul__hSMul g s)) (times g (times (Inv__inv g) x1)) x1).

(; //LEAN:Subgroup.leftCosetEquivSubgroup._proof_8 ;)
Subgroup__leftCosetEquivSubgroup___proof_8 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (g : Elem X) -> (x1 : Elem (Subtype (x3 => Membership__mem s x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem s x2)) (times (Inv__inv g) (times g x1)) x1).

(; doc: A subgroup contains the group's 1. ;)
(; //LEAN:Subgroup.one_mem ;)
Subgroup__one_mem : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Membership__mem H 1).

(; doc: A version of `Set.pi` for subgroups. Given an index set `I` and a family of submodules `s : Π i, Subgroup f i`, `pi I s` is the subgroup of dependent functions `f : Π i, f i` such that `f i` belongs to `pi I s` whenever `i ∈ I`. ;)
(; //LEAN:Subgroup.pi ;)
Subgroup__pi : (I : Elem (powerset X)) -> (H : ((i1 : Elem X) -> Subgroup (f i1))) -> Elem (Subgroup ((i : Elem X) -> f i)).

(; doc: Given `Subgroup`s `H`, `K` of groups `G`, `N` respectively, `H × K` as a subgroup of `G × N`. ;)
(; //LEAN:Subgroup.prod ;)
Subgroup__prod : (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> Elem (Subgroup (Prod G N)).

(; //LEAN:Subgroup.quotientEquivProdOfLE'._proof_1 ;)
Subgroup__quotientEquivProdOfLE'___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (h_le : Proof (Leq s t)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (hf : Proof (Function__RightInverse f QuotientGroup__mk)) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Setoid__r b c)) -> Proof (Setoid__r (times (Inv__inv (f (Quotient__mk'' b))) b) (times (Inv__inv (f (Quotient__mk'' c))) c)).

(; //LEAN:Subgroup.quotientEquivProdOfLE'._proof_2 ;)
Subgroup__quotientEquivProdOfLE'___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (a : Elem (Prod (HasQuotient__Quotient X t) (HasQuotient__Quotient (Subtype (x3 => Membership__mem t x3)) (Subgroup__subgroupOf s t)))) -> (b : Elem (Subtype (x2 => Membership__mem t x2))) -> (c : Elem (Subtype (x1 => Membership__mem t x1))) -> (h : Proof (Setoid__r b c)) -> Proof (Setoid__r (times (f (Prod__fst a)) b) (times (f (Prod__fst a)) c)).

(; //LEAN:Subgroup.quotientEquivProdOfLE'._proof_3 ;)
Subgroup__quotientEquivProdOfLE'___proof_3 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (h_le : Proof (Leq s t)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (hf : Proof (Function__RightInverse f QuotientGroup__mk)) -> Proof (Function__LeftInverse (a => Quotient__map' (b => times (f (Prod__fst a)) b) (b1 => c => h => Subgroup__quotientEquivProdOfLE'___proof_2 f a b1 c h) (Prod__snd a)) (a1 => Prod__mk (Quotient__map' id (x1 => x2 => h1 => iffEr (Setoid__r (id x1) (id x2)) (Membership__mem t (times (Inv__inv (id x1)) (id x2))) QuotientGroup__leftRel_apply (h_le (times (Inv__inv (id x1)) (id x2)) (iffEl (Setoid__r (id x1) (id x2)) (Membership__mem s (times (Inv__inv (id x1)) (id x2))) QuotientGroup__leftRel_apply h1))) a1) (Quotient__map' (g => times (Inv__inv (f (Quotient__mk'' g))) g) (b2 => c1 => h2 => Subgroup__quotientEquivProdOfLE'___proof_1 h_le f hf b2 c1 h2) a1))).

(; //LEAN:Subgroup.quotientEquivProdOfLE'._proof_4 ;)
Subgroup__quotientEquivProdOfLE'___proof_4 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (h_le : Proof (Leq s t)) -> (f : (Elem (HasQuotient__Quotient X t) -> X)) -> (hf : Proof (Function__RightInverse f QuotientGroup__mk)) -> Proof (Function__RightInverse (a => Quotient__map' (b => times (f (Prod__fst a)) b) (b1 => c => h => Subgroup__quotientEquivProdOfLE'___proof_2 f a b1 c h) (Prod__snd a)) (a1 => Prod__mk (Quotient__map' id (x1 => x2 => h1 => iffEr (Setoid__r (id x1) (id x2)) (Membership__mem t (times (Inv__inv (id x1)) (id x2))) QuotientGroup__leftRel_apply (h_le (times (Inv__inv (id x1)) (id x2)) (iffEl (Setoid__r (id x1) (id x2)) (Membership__mem s (times (Inv__inv (id x1)) (id x2))) QuotientGroup__leftRel_apply h1))) a1) (Quotient__map' (g => times (Inv__inv (f (Quotient__mk'' g))) g) (b2 => c1 => h2 => Subgroup__quotientEquivProdOfLE'___proof_1 h_le f hf b2 c1 h2) a1))).

(; //LEAN:Subgroup.quotientEquivProdOfLE'._proof_5 ;)
Subgroup__quotientEquivProdOfLE'___proof_5 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (h_le : Proof (Leq s t)) -> (x1 : Elem X) -> (x2 : Elem X) -> (h : Proof (Setoid__r x1 x2)) -> Proof (Setoid__r (id x1) (id x2)).

(; //LEAN:Subgroup.quotientEquivProdOfLE._proof_1 ;)
Subgroup__quotientEquivProdOfLE___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (t : Elem (Subgroup X)) -> (q : Elem (Quotient (QuotientGroup__leftRel t))) -> Proof (Eqt (Quotient (QuotientGroup__leftRel t)) (Quotient__mk'' (Quotient__out q)) q).

(; //LEAN:Subgroup.quotientSubgroupOfEmbeddingOfLE._proof_2 ;)
Subgroup__quotientSubgroupOfEmbeddingOfLE___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (H : Elem (Subgroup X)) -> (h : Proof (Leq s t)) -> (a : Elem (Subtype (x4 => Membership__mem s x4))) -> (b : Elem (Subtype (x3 => Membership__mem s x3))) -> (h1 : Proof (Setoid__r a b)) -> Proof (Setoid__r (Subgroup__inclusion__app h a) (Subgroup__inclusion__app h b)).

(; //LEAN:Subgroup.quotientSubgroupOfEmbeddingOfLE._proof_3 ;)
Subgroup__quotientSubgroupOfEmbeddingOfLE___proof_3 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (H : Elem (Subgroup X)) -> (h : Proof (Leq s t)) -> (x1 : Elem (Quotient (QuotientGroup__leftRel (Subgroup__subgroupOf H s)))) -> (x2 : Elem (Quotient (QuotientGroup__leftRel (Subgroup__subgroupOf H s)))) -> (h1 : Proof (Eqt (HasQuotient__Quotient (Subtype (x4 => Membership__mem t x4)) (Subgroup__subgroupOf H t)) (Quotient__map' (Subgroup__inclusion h) (a => b => Subgroup__quotientSubgroupOfEmbeddingOfLE___proof_2 H h a b) x1) (Quotient__map' (Subgroup__inclusion h) (a1 => b1 => Subgroup__quotientSubgroupOfEmbeddingOfLE___proof_2 H h a1 b1) x2))) -> Proof (Eqt (HasQuotient__Quotient (Subtype (x3 => Membership__mem s x3)) (Subgroup__subgroupOf H s)) x1 x2).

(; //LEAN:Subgroup.quotientSubgroupOfMapOfLE._proof_1 ;)
Subgroup__quotientSubgroupOfMapOfLE___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (t : Elem (Subgroup X)) -> (H : Elem (Subgroup X)) -> (h : Proof (Leq s t)) -> (a : Elem (Subtype (x2 => Membership__mem H x2))) -> (b : Elem (Subtype (x1 => Membership__mem H x1))) -> (h1 : Proof (Setoid__r a b)) -> Proof (Setoid__r (id a) (id b)).

(; //LEAN:Subgroup.quotientiInfEmbedding._proof_1 ;)
Subgroup__quotientiInfEmbedding___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (I : Set) -> (f : (Elem I -> Subgroup X)) -> (x1 : Elem (Quotient (QuotientGroup__leftRel (iInf (i5 => f i5))))) -> (x2 : Elem (Quotient (QuotientGroup__leftRel (iInf (i4 => f i4))))) -> (h : Proof (Eqt ((i1 : Elem I) -> HasQuotient__Quotient X (f i1)) (i2 => Subgroup__quotientMapOfLE (Subgroup__quotientiInfSubgroupOfEmbedding___proof_1 f i2) x1) (i3 => Subgroup__quotientMapOfLE (Subgroup__quotientiInfSubgroupOfEmbedding___proof_1 f i3) x2))) -> Proof (Eqt (HasQuotient__Quotient X (iInf (i => f i))) x1 x2).

(; //LEAN:Subgroup.quotientiInfSubgroupOfEmbedding._proof_1 ;)
Subgroup__quotientiInfSubgroupOfEmbedding___proof_1 : (X : Set) -> (_ : Proof (Group X)) -> (I : Set) -> (f : (Elem I -> Subgroup X)) -> (i : Elem I) -> Proof (Leq (iInf f) (f i)).

(; //LEAN:Subgroup.quotientiInfSubgroupOfEmbedding._proof_2 ;)
Subgroup__quotientiInfSubgroupOfEmbedding___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (I : Set) -> (f : (Elem I -> Subgroup X)) -> (H : Elem (Subgroup X)) -> (x1 : Elem (Quotient (QuotientGroup__leftRel (Subgroup__subgroupOf (iInf (i5 => f i5)) H)))) -> (x2 : Elem (Quotient (QuotientGroup__leftRel (Subgroup__subgroupOf (iInf (i4 => f i4)) H)))) -> (h : Proof (Eqt ((i1 : Elem I) -> HasQuotient__Quotient (Subtype (x4 => Membership__mem H x4)) (Subgroup__subgroupOf (f i1) H)) (i2 => Subgroup__quotientSubgroupOfMapOfLE H (Subgroup__quotientiInfSubgroupOfEmbedding___proof_1 f i2) x1) (i3 => Subgroup__quotientSubgroupOfMapOfLE H (Subgroup__quotientiInfSubgroupOfEmbedding___proof_1 f i3) x2))) -> Proof (Eqt (HasQuotient__Quotient (Subtype (x3 => Membership__mem H x3)) (Subgroup__subgroupOf (iInf (i => f i)) H)) x1 x2).

(; //LEAN:Subgroup.rightCosetEquivSubgroup._proof_6 ;)
Subgroup__rightCosetEquivSubgroup___proof_6 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (g : Elem X) -> (x1 : Elem (Set__Elem (HSMul__hSMul (MulOpposite__op g) s))) -> Proof (Eqt (Set__Elem (HSMul__hSMul (MulOpposite__op g) s)) (times (times x1 (Inv__inv g)) g) x1).

(; //LEAN:Subgroup.rightCosetEquivSubgroup._proof_8 ;)
Subgroup__rightCosetEquivSubgroup___proof_8 : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (g : Elem X) -> (x1 : Elem (Subtype (x3 => Membership__mem s x3))) -> Proof (Eqt (Subtype (x2 => Membership__mem s x2)) (times (times x1 g) (Inv__inv g)) x1).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:Subgroup.subgroupOf ;)
Subgroup__subgroupOf : (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem (Subgroup (Subtype (x1 => Membership__mem K x1))).

(; doc: The natural group hom from a subgroup of group `G` to `G`. ;)
(; //LEAN:Subgroup.subtype ;)
Subgroup__subtype : (H : Elem (Subgroup G)) -> Elem (MonoidHom (Subtype (x1 => Membership__mem H x1)) G).

(; doc: A submonoid of a monoid `M` is a subset containing 1 and closed under multiplication. ;)
(; //LEAN:Submonoid ;)
Submonoid : (M : Set) -> Set.

(; //LEAN:Submonoid.instSetLike ;)
Submonoid__instSetLike : Proof (SetLike (Submonoid M) M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; //LEAN:eq_comm ;)
eq_comm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a b) (Eqt X b a)).

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:implies_true ;)
implies_true : (X : Set) -> Proof (Eqt Prop (forall X (x => True)) True).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_mul ;)
one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times 1 a) a).

(; //LEAN:one_smul ;)
one_smul : (M : Set) -> (X : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (MulAction M X)) -> (b : Elem X) -> Proof (Eqt X (HSMul__hSMul 1 b) b).

(; //LEAN:piSetoid ;)
piSetoid : Proof (Setoid ((i : Elem I) -> x i)).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

