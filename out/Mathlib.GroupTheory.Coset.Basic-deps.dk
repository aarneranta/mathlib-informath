(; doc: The inclusion homomorphism from a subgroup `H` contained in `K` to `K`. ;)
(; //LEAN:Subgroup.inclusion ;)
Subgroup__inclusion : (G : Set) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> (h : Proof (Leq H K)) -> Elem (MonoidHom (Subtype G (x1 => Membership__mem G (Subgroup G) H x1)) (Subtype G (x2 => Membership__mem G (Subgroup G) K x2))).

