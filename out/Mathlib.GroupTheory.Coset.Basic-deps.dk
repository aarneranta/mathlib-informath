(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) G).

(; doc: An `AddSubgroup` contains the group's 0. ;)
(; //LEAN:AddSubgroup.zero_mem ;)
AddSubgroup__zero_mem : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (Membership__mem G (AddSubgroup G) H 0).

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; //LEAN:AddSubmonoid.instSetLike ;)
AddSubmonoid__instSetLike : (M : Set) -> Proof (SetLike (AddSubmonoid M) M).

(; //LEAN:AddZero.toZero ;)
AddZero__toZero : (M : Set) -> Proof (Zero M).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : (X : Set) -> Elem X.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Eqt X a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: Any type is equivalent to itself. ;)
(; //LEAN:Equiv.refl ;)
Equiv__refl : (X : Set) -> Elem (Equiv X X).

(; doc: A family of equivalences `Π a, β₁ a ≃ β₂ a` generates an equivalence between `Σ a, β₁ a` and `Σ a, β₂ a`. ;)
(; //LEAN:Equiv.sigmaCongrRight ;)
Equiv__sigmaCongrRight : (X : Set) -> (beta1 : (Elem X -> Set)) -> (beta2 : (Elem X -> Set)) -> (F : ((a2 : Elem X) -> Equiv (beta1 a2) (beta2 a2))) -> Elem (Equiv (Sigma X (a => beta1 a)) (Sigma X (a1 => beta2 a1))).

(; doc: `Sigma` type with a constant fiber is equivalent to the product. ;)
(; //LEAN:Equiv.sigmaEquivProd ;)
Equiv__sigmaEquivProd : (X : Set) -> (Y : Set) -> Elem (Equiv (Sigma X (x => Y)) (Prod X Y)).

(; doc: `sigmaFiberEquiv f` for `f : α → β` is the natural equivalence between the type of all fibres of `f` and the total space `α`. ;)
(; //LEAN:Equiv.sigmaFiberEquiv ;)
Equiv__sigmaFiberEquiv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Elem (Equiv (Sigma Y (y => Subtype X (x => Eqt Y (f x) y))) X).

(; doc: Inverse of an equivalence `e : α ≃ β`. ;)
(; //LEAN:Equiv.symm ;)
Equiv__symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (Equiv Y X).

(; doc: Composition of equivalences `e₁ : α ≃ β` and `e₂ : β ≃ γ`. ;)
(; //LEAN:Equiv.trans ;)
Equiv__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (e1 : Elem (Equiv X Y)) -> (e2 : Elem (Equiv Y Z)) -> Elem (Equiv X Z).

(; doc: An equivalence relation `r : α → α → Prop` is a relation that is  * reflexive: `r x x`, * symmetric: `r x y` implies `r y x`, and * transitive: `r x y` and `r y z` implies `r x z`.  Equality is an equivalence relation, and equivalence relations share many of the properties of equality. ;)
(; //LEAN:Equivalence ;)
Equivalence : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; //LEAN:Equivalence.mk ;)
Equivalence__mk : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (refl : Proof (forall X (x2 => r x2 x2))) -> (symm : Proof (forall X (x1 => forall X (y1 => if (r x1 y1) (r y1 x1))))) -> (trans : Proof (forall X (x => forall X (y => forall X (z => if (r x y) (if (r y z) (r x z))))))) -> Proof (Equivalence X r).

(; doc: `α ↪ β` is a bundled injective function. ;)
(; //LEAN:Function.Embedding ;)
Function__Embedding : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Function.Embedding.mk ;)
Function__Embedding__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (inj' : Proof (Function__Injective X Y toFun)) -> Elem (Function__Embedding X Y).

(; doc: `RightInverse g f` means that `g` is a right inverse to `f`. That is, `f ∘ g = id`. ;)
(; //LEAN:Function.RightInverse ;)
Function__RightInverse : (X : Set) -> (Y : Set) -> (g : (Elem Y -> X)) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `a +ᵥ b` computes the sum of `a` and `b`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `+ᵥ` in identifiers is `vadd`. ;)
(; //LEAN:HVAdd.hVAdd ;)
HVAdd__hVAdd : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `HasQuotient.Quotient A b` (denoted as `A ⧸ b`) is the quotient of the type `A` by `b`. ;)
(; //LEAN:HasQuotient.Quotient ;)
HasQuotient__Quotient : (A : Set) -> (B : Set) -> (x : Elem B) -> Set.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MonoidHom.fiberEquivKer._proof_2 ;)
MonoidHom__fiberEquivKer___proof_2 : (X : Set) -> (_ : Proof (Group X)) -> (H : Set) -> (_ : Proof (Group H)) -> (f : Elem (MonoidHom X H)) -> (a : Elem X) -> Proof (Eqt (powerset X) (Set__preimage X H f (Singleton__singleton H (powerset H) (f a))) (HSMul__hSMul X (powerset X) (powerset X) a (SetLike__coe (Subgroup X) X (MonoidHom__ker X H f)))).

(; doc: The multiplicative kernel of a monoid homomorphism is the subgroup of elements `x : G` such that `f x = 1` ;)
(; //LEAN:MonoidHom.ker ;)
MonoidHom__ker : (G : Set) -> (M : Set) -> (f : Elem (MonoidHom G M)) -> Elem (Subgroup G).

(; doc: The orbit of an element under an action. ;)
(; //LEAN:MulAction.orbit ;)
MulAction__orbit : (Z : Set) -> (X : Set) -> (a : Elem X) -> Elem (powerset X).

(; doc: The orbit corresponding to an element of the quotient by `MulAction.orbitRel` ;)
(; //LEAN:MulAction.orbitRel.Quotient.orbit ;)
MulAction__orbitRel__Quotient__orbit : (G : Set) -> (X : Set) -> (x2 : Elem (MulAction__orbitRel__Quotient G X)) -> Elem (powerset X).

(; //LEAN:MulOne.toOne ;)
MulOne__toOne : (M : Set) -> Proof (One M).

(; doc: Multiplicative opposite of a type. This type inherits all additive structures on `α` and reverses left and right in multiplication. ;)
(; //LEAN:MulOpposite ;)
MulOpposite : (X : Set) -> Set.

(; doc: The element of `MulOpposite α` that represents `x : α`. ;)
(; //LEAN:MulOpposite.op ;)
MulOpposite__op : (X : Set) -> (x : Elem X) -> Elem (MulOpposite X).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: By definition, if we have `OneMemClass S M`, we have `1 ∈ s` for all `s : S`. ;)
(; //LEAN:OneMemClass.one_mem ;)
OneMemClass__one_mem : (S : Set) -> (M : Set) -> (x : Proof (One M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (OneMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem M S s 1).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: Quotient types coarsen the propositional equality for a type so that terms related by some equivalence relation are considered equal. The equivalence relation is given by an instance of `Setoid`.  Set-theoretically, `Quotient s` can seen as the set of equivalence classes of `α` modulo the `Setoid` instance's relation `s.r`. Functions from `Quotient s` must prove that they respect `s.r`: to define a function `f : Quotient s → β`, it is necessary to provide `f' : α → β` and prove that for all `x : α` and `y : α`, `s.r x y → f' x = f' y`. `Quotient.lift` implements this operation.  The key quotient operators are:  * `Quotient.mk` places elements of the underlying type `α` into the quotient.  * `Quotient.lift` allows the definition of functions from the quotient to some other type.  * `Quotient.sound` asserts the equality of elements related by `r`  * `Quotient.ind` is used to write proofs about quotients by assuming that all elements are    constructed with `Quotient.mk`.  `Quotient` is built on top of the primitive quotient type `Quot`, which does not require a proof that the relation is an equivalence relation. `Quotient` should be used instead of `Quot` for relations that actually are equivalence relations. ;)
(; //LEAN:Quotient ;)
Quotient : (X : Set) -> (s : Proof (Setoid X)) -> Set.

(; doc: Lifts a function from an underlying type to a function on a quotient, requiring that it respects the quotient's equivalence relation.  Given `s : Setoid α` and a quotient `Quotient s`, applying a function `f : α → β` requires a proof `h` that `f` respects the equivalence relation `s.r`. In this case, the function `Quotient.lift f h : Quotient s → β` computes the same values as `f`.  `Quotient.liftOn` is a version of this operation that takes the quotient value as its first explicit parameter. ;)
(; //LEAN:Quotient.lift ;)
Quotient__lift : (X : Set) -> (Y : Set) -> (s : Proof (Setoid X)) -> (f : (Elem X -> Y)) -> (h : Proof (forall X (a => forall X (b => if (HasEquiv__Equiv X a b) (Eqt Y (f a) (f b)))))) -> (x : Elem (Quotient X s)) -> Elem Y.

(; doc: Map a function `f : α → β` that sends equivalent elements to equivalent elements to a function `Quotient sa → Quotient sb`. Useful to define unary operations on quotients. This is a version of `Quotient.map` using `Setoid.r` instead of `≈`. ;)
(; //LEAN:Quotient.map' ;)
Quotient__map' : (X : Set) -> (Y : Set) -> (s1 : Proof (Setoid X)) -> (s2 : Proof (Setoid Y)) -> (f : (Elem X -> Y)) -> (h : Proof (forall X (a => forall X (b => if (Setoid__r X a b) (Setoid__r Y (f a) (f b)))))) -> (x : Elem (Quotient X s1)) -> Elem (Quotient Y s2).

(; doc: A version of `Quotient.mk` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.mk'' ;)
Quotient__mk'' : (X : Set) -> (s1 : Proof (Setoid X)) -> (a : Elem X) -> Elem (Quotient X s1).

(; doc: Choose an element of the equivalence class using the axiom of choice. Sound but noncomputable. ;)
(; //LEAN:Quotient.out ;)
Quotient__out : (X : Set) -> (s : Proof (Setoid X)) -> (x : Elem (Quotient X s)) -> Elem X.

(; doc: The equivalence relation corresponding to the partition of a group by left cosets of a subgroup. ;)
(; //LEAN:QuotientAddGroup.leftRel ;)
QuotientAddGroup__leftRel : (X : Set) -> (s : Elem (AddSubgroup X)) -> Elem (Setoid__on X).

(; doc: The canonical map from an `AddGroup` `α` to the quotient `α ⧸ s`. ;)
(; //LEAN:QuotientAddGroup.mk ;)
QuotientAddGroup__mk : (X : Set) -> (s : Elem (AddSubgroup X)) -> (a : Elem X) -> Elem (HasQuotient__Quotient X (AddSubgroup X) s).

(; //LEAN:QuotientAddGroup.preimageMkEquivAddSubgroupProdSet._proof_1 ;)
QuotientAddGroup__preimageMkEquivAddSubgroupProdSet___proof_1 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (t : Elem (powerset (HasQuotient__Quotient X (AddSubgroup X) s))) -> (a : Elem (Set__Elem X (Set__preimage X (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s) t))) -> Proof (Membership__mem X (AddSubgroup X) s (plus (Neg__neg X (Quotient__out X (QuotientAddGroup__leftRel X s) (QuotientAddGroup__mk X s (Subtype__val X (x1 => Membership__mem X (powerset X) (Set__preimage X (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s) t) x1) a)))) (Subtype__val X (x2 => Membership__mem X (powerset X) (Set__preimage X (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s) t) x2) a))).

