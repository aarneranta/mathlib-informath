(; doc: A subgroup contains the group's 1. ;)
(; //LEAN:Subgroup.one_mem ;)
Subgroup__one_mem : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (Membership__mem G (Subgroup G) H 1).

(; doc: Pull a subgroup back to an opposite subgroup along `MulOpposite.unop` ;)
(; //LEAN:Subgroup.op ;)
Subgroup__op : (G : Set) -> (H : Elem (Subgroup G)) -> Elem (Subgroup (MulOpposite G)).

(; doc: A version of `Set.pi` for subgroups. Given an index set `I` and a family of submodules `s : Π i, Subgroup f i`, `pi I s` is the subgroup of dependent functions `f : Π i, f i` such that `f i` belongs to `pi I s` whenever `i ∈ I`. ;)
(; //LEAN:Subgroup.pi ;)
Subgroup__pi : (X : Set) -> (f : (Elem X -> Set)) -> (I : Elem (powerset X)) -> (H : ((i1 : Elem X) -> Subgroup (f i1))) -> Elem (Subgroup ((i : Elem X) -> f i)).

(; doc: Given `Subgroup`s `H`, `K` of groups `G`, `N` respectively, `H × K` as a subgroup of `G × N`. ;)
(; //LEAN:Subgroup.prod ;)
Subgroup__prod : (G : Set) -> (N : Set) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> Elem (Subgroup (Prod G N)).

