piSetoid__in : (I : Set) -> (alpha : (Elem I -> Set)) -> (x : Proof ((i1 : Elem I) -> Setoid (alpha i1))) -> Elem (Setoid__on ((i : Elem I) -> alpha i)).

(; doc: The orbit of an element under an action. ;)
(; //LEAN:AddAction.orbit ;)
AddAction__orbit : (Z : Set) -> (X : Set) -> (a : Elem X) -> Elem (powerset X).

(; doc: The orbit corresponding to an element of the quotient by `AddAction.orbitRel` ;)
(; //LEAN:AddAction.orbitRel.Quotient.orbit ;)
AddAction__orbitRel__Quotient__orbit : (G : Set) -> (X : Set) -> (x2 : Elem (AddAction__orbitRel__Quotient G X)) -> Elem (powerset X).

(; doc: An `AddGroup` is an `AddMonoid` with a unary `-` satisfying `-a + a = 0`.  There is also a binary operation `-` such that `a - b = a + -b`, with a default so that `a - b = a + -b` holds by definition.  Use `AddGroup.ofLeftAxioms` or `AddGroup.ofRightAxioms` to define an additive group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:AddGroup ;)
AddGroup : (A : Set) -> Prop.

(; doc: An `AddMonoid` is an `AddSemigroup` with an element `0` such that `0 + a = a + 0 = a`. ;)
(; //LEAN:AddMonoid ;)
AddMonoid : (M : Set) -> Prop.

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; //LEAN:AddMonoidHom.fiberEquivKer._proof_2 ;)
AddMonoidHom__fiberEquivKer___proof_2 : (X : Set) -> (_ : Proof (AddGroup X)) -> (H : Set) -> (_ : Proof (AddGroup H)) -> (f : Elem (AddMonoidHom X H)) -> (a : Elem X) -> Proof (Eqt (powerset X) (Set__preimage X H f (Singleton__singleton H (powerset H) (f a))) (HVAdd__hVAdd X (powerset X) (powerset X) a (SetLike__coe (AddSubgroup X) X (AddMonoidHom__ker X H f)))).

(; doc: The additive kernel of an `AddMonoid` homomorphism is the `AddSubgroup` of elements such that `f x = 0` ;)
(; //LEAN:AddMonoidHom.ker ;)
AddMonoidHom__ker : (G : Set) -> (M : Set) -> (f : Elem (AddMonoidHom G M)) -> Elem (AddSubgroup G).

(; doc: Additive opposite of a type. This type inherits all multiplicative structures on `α` and reverses left and right in addition. ;)
(; //LEAN:AddOpposite ;)
AddOpposite : (X : Set) -> Set.

(; doc: The element of `αᵃᵒᵖ` that represents `x : α`. ;)
(; //LEAN:AddOpposite.op ;)
AddOpposite__op : (X : Set) -> (x : Elem X) -> Elem (AddOpposite X).

(; doc: An additive semigroup is a type with an associative `(+)`. ;)
(; //LEAN:AddSemigroup ;)
AddSemigroup : (G : Set) -> Prop.

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (A : Set) -> (H : Elem (AddSubgroup A)) -> Prop.

(; //LEAN:AddSubgroup.Normal.mem_comm_iff ;)
AddSubgroup__Normal__mem_comm_iff : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (nH : Proof (AddSubgroup__Normal G H)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Membership__mem G (AddSubgroup G) H (plus a b)) (Membership__mem G (AddSubgroup G) H (plus b a))).

(; //LEAN:AddSubgroup.Normal.mk ;)
AddSubgroup__Normal__mk : (A : Set) -> (_ : Proof (AddGroup A)) -> (H : Elem (AddSubgroup A)) -> (conj_mem : Proof (forall A (n => if (Membership__mem A (AddSubgroup A) H n) (forall A (g => Membership__mem A (AddSubgroup A) H (plus (plus g n) (Neg__neg A g))))))) -> Proof (AddSubgroup__Normal A H).

(; //LEAN:AddSubgroup.addGroupEquivQuotientProdAddSubgroup._proof_1 ;)
AddSubgroup__addGroupEquivQuotientProdAddSubgroup___proof_1 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (L : Elem (HasQuotient__Quotient X (AddSubgroup X) s)) -> Proof (Eqt Set (Equiv (Subtype X (x1 => Eqt (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s x1) L)) (Set__Elem X (HVAdd__hVAdd X (powerset X) (powerset X) (Quotient__out X (QuotientAddGroup__leftRel X s) L) (SetLike__coe (AddSubgroup X) X s)))) (Equiv (Subtype X (x2 => Eqt (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s x2) L)) (Set__Elem X (Set__ofPred X (x3 => Eqt (HasQuotient__Quotient X (AddSubgroup X) s) (QuotientAddGroup__mk X s x3) (QuotientAddGroup__mk X s (Quotient__out X (QuotientAddGroup__leftRel X s) L))))))).

(; //LEAN:AddSubgroup.addGroupEquivQuotientProdAddSubgroup._proof_2 ;)
AddSubgroup__addGroupEquivQuotientProdAddSubgroup___proof_2 : (X : Set) -> (_ : Proof (AddGroup X)) -> (s : Elem (AddSubgroup X)) -> (L : Elem (HasQuotient__Quotient X (AddSubgroup X) s)) -> Proof (Eqt Set (Equiv (Subtype X (x1 => Eqt (Quotient X (QuotientAddGroup__leftRel X s)) (Quotient__mk'' X (QuotientAddGroup__leftRel X s) x1) L)) (Subtype X (x2 => Eqt (Quotient X (QuotientAddGroup__leftRel X s)) (Quotient__mk'' X (QuotientAddGroup__leftRel X s) x2) (Quotient__mk'' X (QuotientAddGroup__leftRel X s) (Quotient__out X (QuotientAddGroup__leftRel X s) L))))) (Equiv (Subtype X (x3 => Eqt (Quotient X (QuotientAddGroup__leftRel X s)) (Quotient__mk'' X (QuotientAddGroup__leftRel X s) x3) L)) (Subtype X (x4 => Eqt (Quotient X (QuotientAddGroup__leftRel X s)) (Quotient__mk'' X (QuotientAddGroup__leftRel X s) x4) L)))).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype G (x1 => Membership__mem G (AddSubgroup G) K x1))).

(; doc: The preimage of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.comap ;)
AddSubgroup__comap : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup N)) -> Elem (AddSubgroup G).

(; doc: The inclusion homomorphism from an additive subgroup `H` contained in `K` to `K`. ;)
(; //LEAN:AddSubgroup.inclusion ;)
AddSubgroup__inclusion : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> (h : Proof (Leq H K)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) (Subtype G (x2 => Membership__mem G (AddSubgroup G) K x2))).

(; //LEAN:AddSubgroup.leftCosetEquivAddSubgroup._proof_1 ;)
