(; //LEAN:mem_leftAddCoset ;)
def mem_leftAddCoset : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> (a : Elem X) -> (hxS : Proof (Membership__mem X (powerset X) s x1)) -> Proof (Membership__mem X (powerset X) (HVAdd__hVAdd X (powerset X) (powerset X) a s) (plus a x1)) :=
  X => s => x1 => a => hxS => Set__mem_image_of_mem X X (b => plus a b) x1 s hxS.

(; //LEAN:mem_leftCoset ;)
def mem_leftCoset : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> (a : Elem X) -> (hxS : Proof (Membership__mem X (powerset X) s x1)) -> Proof (Membership__mem X (powerset X) (HSMul__hSMul X (powerset X) (powerset X) a s) (times a x1)) :=
  X => s => x1 => a => hxS => Set__mem_image_of_mem X X (b => times a b) x1 s hxS.

(; //LEAN:mem_rightCoset ;)
def mem_rightCoset : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> (a : Elem X) -> (hxS : Proof (Membership__mem X (powerset X) s x1)) -> Proof (Membership__mem X (powerset X) (HSMul__hSMul (MulOpposite X) (powerset X) (powerset X) (MulOpposite__op X a) s) (times x1 a)) :=
  X => s => x1 => a => hxS => Set__mem_image_of_mem X X (b => times b a) x1 s hxS.

(; //LEAN:mem_rightAddCoset ;)
def mem_rightAddCoset : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> (a : Elem X) -> (hxS : Proof (Membership__mem X (powerset X) s x1)) -> Proof (Membership__mem X (powerset X) (HVAdd__hVAdd (AddOpposite X) (powerset X) (powerset X) (AddOpposite__op X a) s) (plus x1 a)) :=
  X => s => x1 => a => hxS => Set__mem_image_of_mem X X (b => plus b a) x1 s hxS.

(; //LEAN:LeftCosetEquivalence ;)
def LeftCosetEquivalence : (X : Set) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> Prop :=
  X => s => a => b => Eqt (powerset X) (HSMul__hSMul X (powerset X) (powerset X) a s) (HSMul__hSMul X (powerset X) (powerset X) b s).

(; //LEAN:LeftAddCosetEquivalence ;)
def LeftAddCosetEquivalence : (X : Set) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> Prop :=
  X => s => a => b => Eqt (powerset X) (HVAdd__hVAdd X (powerset X) (powerset X) a s) (HVAdd__hVAdd X (powerset X) (powerset X) b s).

