QuotientGroup__univ_eq_iUnion_smul : (X : Set) -> (_ : Proof (Group X)) -> (H : Elem (Subgroup X)) -> Proof (Eqt (powerset X) Set__univ (Set__iUnion (x1 => HSMul__hSMul (Quotient__out x1) H))).

(; //LEAN:QuotientAddGroup.univ_eq_iUnion_vadd ;)
QuotientAddGroup__univ_eq_iUnion_vadd : (X : Set) -> (_ : Proof (AddGroup X)) -> (H : Elem (AddSubgroup X)) -> Proof (Eqt (powerset X) Set__univ (Set__iUnion (x1 => HVAdd__hVAdd (Quotient__out x1) H))).

