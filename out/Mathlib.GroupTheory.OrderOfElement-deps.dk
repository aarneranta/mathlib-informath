subgroupOfIdempotent___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Finite G)) -> (S : Elem (powerset G)) -> (hS1 : Proof (Set__Nonempty G S)) -> (hS2 : Proof (Eqt (powerset G) (times S S) S)) -> (a : Elem G) -> (ha : Proof (Membership__mem G (powerset G) S a)) -> Proof (Membership__mem G (Submonoid G) (submonoidOfIdempotent G S hS1 hS2) (Inv__inv G a)).

