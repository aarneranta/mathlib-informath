(; constants used by Mathlib.GroupTheory.OrderOfElement, declared with their translated types ;)

(; the structures of a class on its parameters ;)
AddGroup__on : (A : Set) -> Set.

(; a constant applied as a function: DFunLike.coe ;)
Additive__ofMul__app : (a1 : Elem G) -> Elem (Additive G).

(; a constant applied as a function: DFunLike.coe ;)
Equiv__symm__app : (a1 : Elem (Equiv G G)) -> (a2 : Elem G) -> Elem G.

(; the structures of a class on its parameters ;)
Group__on : (G : Set) -> Set.

(; a constant applied as a function: DFunLike.coe ;)
Multiplicative__ofAdd__app : (a1 : Elem X) -> Elem (Multiplicative X).

(; a constant applied as a function: DFunLike.coe ;)
finEquivMultiples__app : (a1 : Proof (IsOfFinAddOrder G x1)) -> (a2 : Elem (Fin (addOrderOf G x1))) -> Elem (Subtype G (x3 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x3)).

(; a constant applied as a function: DFunLike.coe ;)
finEquivPowers__app : (a1 : Proof (IsOfFinOrder G x1)) -> (a2 : Elem (Fin (orderOf G x1))) -> Elem (Subtype G (x3 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x3)).

(; a constant applied as a function: DFunLike.coe ;)
finEquivZMultiples__app : (a1 : Proof (IsOfFinAddOrder G x1)) -> (a2 : Elem (Fin (addOrderOf G x1))) -> Elem (Subtype G (x3 => Membership__mem G (AddSubgroup G) (AddSubgroup__zmultiples G x1) x3)).

(; a constant applied as a function: DFunLike.coe ;)
finEquivZPowers__app : (a1 : Proof (IsOfFinOrder G x1)) -> (a2 : Elem (Fin (orderOf G x1))) -> Elem (Subtype G (x3 => Membership__mem G (Subgroup G) (Subgroup__zpowers G x1) x3)).

(; a constant applied as a function: DFunLike.coe ;)
multiplesEquivMultiples__app : (a1 : Proof (Eq (addOrderOf G x1) (addOrderOf G y))) -> (a2 : Elem (Subtype G (x3 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x3))) -> Elem (Subtype G (x4 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G y) x4)).

(; a constant applied as a function: DFunLike.coe ;)
nsmulCoprime__app : (a1 : Proof (Nat__Coprime (Nat__card G) n)) -> (a2 : Elem G) -> Elem G.

(; a constant applied as a function: DFunLike.coe ;)
powCoprime__app : (a1 : Proof (Nat__Coprime (Nat__card G) n)) -> (a2 : Elem G) -> Elem G.

(; a constant applied as a function: DFunLike.coe ;)
powersEquivPowers__app : (a1 : Proof (Eq (orderOf G x1) (orderOf G y))) -> (a2 : Elem (Subtype G (x3 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x3))) -> Elem (Subtype G (x4 => Membership__mem G (Submonoid G) (Submonoid__powers G y) x4)).

(; a constant applied as a function: DFunLike.coe ;)
zmultiplesEquivZMultiples__app : (a1 : Proof (Eq (addOrderOf G x1) (addOrderOf G y))) -> (a2 : Elem (Subtype G (x3 => Membership__mem G (AddSubgroup G) (AddSubgroup__zmultiples G x1) x3))) -> Elem (Subtype G (x4 => Membership__mem G (AddSubgroup G) (AddSubgroup__zmultiples G y) x4)).

(; a constant applied as a function: DFunLike.coe ;)
zpowersEquivZPowers__app : (a1 : Proof (Eq (orderOf G x1) (orderOf G y))) -> (a2 : Elem (Subtype G (x3 => Membership__mem G (Subgroup G) (Subgroup__zpowers G x1) x3))) -> Elem (Subtype G (x4 => Membership__mem G (Subgroup G) (Subgroup__zpowers G y) x4)).

(; doc: `a + b` computes the sum of `a` and `b`. See `HAdd`. ;)
(; //LEAN:Add.add ;)
Add__add : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Type class for additive monoid actions on types, with notation `g +ᵥ p`.  The `AddAction G P` typeclass says that the additive monoid `G` acts additively on a type `P`. More precisely this means that the action satisfies the two axioms `0 +ᵥ p = p` and `(g₁ + g₂) +ᵥ p = g₁ +ᵥ (g₂ +ᵥ p)`. A mathematician might simply say that the additive monoid `G` acts on `P`.  For example, if `A` is an additive group and `X` is a type, if a mathematician says say "let `A` act on the set `X`" they will usually mean `[AddAction A X]`.  [Wikidata Q288465](https://www.wikidata.org/wiki/Q288465) ;)
(; //LEAN:AddAction ;)
AddAction : (G : Set) -> (P : Set) -> Prop.

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; doc: Two elements additively commute if `a + b = b + a` ;)
(; //LEAN:AddCommute ;)
AddCommute : (M : Set) -> (a : Elem M) -> (b : Elem M) -> Prop.

(; //LEAN:AddCommute.all ;)
AddCommute__all : (S : Set) -> (_ : Proof (AddCommMagma S)) -> (a : Elem S) -> (b : Elem S) -> Proof (AddCommute S a b).

(; //LEAN:AddCommute.nsmul_sub ;)
AddCommute__nsmul_sub : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> (b : Elem G) -> (h : Proof (AddCommute G a b)) -> (n : Elem Nat) -> Proof (Eqt G (HSMul__hSMul Nat G G n (minus a b)) (minus (HSMul__hSMul Nat G G n a) (HSMul__hSMul Nat G G n b))).

(; doc: `AddEquiv α β` is the type of an equiv `α ≃ β` which preserves addition. ;)
(; //LEAN:AddEquiv ;)
AddEquiv : (A : Set) -> (B : Set) -> Set.

(; //LEAN:AddEquiv.injective ;)
AddEquiv__injective : (M : Set) -> (N : Set) -> (e : Elem (AddEquiv M N)) -> Proof (Function__Injective M N e).

(; doc: Extract the forward direction of an additive equivalence as an addition-preserving function. ;)
(; //LEAN:AddEquiv.toAddMonoidHom ;)
AddEquiv__toAddMonoidHom : (M : Set) -> (N : Set) -> (h : Elem (AddEquiv M N)) -> Elem (AddMonoidHom M N).

(; doc: An `AddGroup` is an `AddMonoid` with a unary `-` satisfying `-a + a = 0`.  There is also a binary operation `-` such that `a - b = a + -b`, with a default so that `a - b = a + -b` holds by definition.  Use `AddGroup.ofLeftAxioms` or `AddGroup.ofRightAxioms` to define an additive group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:AddGroup ;)
AddGroup : (A : Set) -> Prop.

(; //LEAN:AddGroup.mk ;)
AddGroup__mk : (A : Set) -> (neg_add_cancel : Proof (forall A (a => Eqt A (plus (Neg__neg A a) a) 0))) -> Elem (AddGroup__on A).

(; doc: An `AddGroupWithOne` is an `AddGroup` with a 1. It also contains data for the unique homomorphisms `ℕ → R` and `ℤ → R`. ;)
(; //LEAN:AddGroupWithOne ;)
AddGroupWithOne : (R : Set) -> Prop.

(; doc: An additive monoid in which addition is left-cancellative. Main examples are `ℕ` and groups. This is the right typeclass for many sum lemmas, as having a zero is useful to define the sum over the empty set, so `AddLeftCancelSemigroup` is not enough. ;)
(; //LEAN:AddLeftCancelMonoid ;)
AddLeftCancelMonoid : (M : Set) -> Prop.

(; //LEAN:AddLeftCancelMonoid.addGroupOfFinite._proof_5 ;)
AddLeftCancelMonoid__addGroupOfFinite___proof_5 : (G : Set) -> (_ : Proof (AddLeftCancelMonoid G)) -> (_ : Proof (Finite G)) -> (x1 : Elem G) -> Proof (Eqt G (plus (HSMul__hSMul Nat G G (minus (addOrderOf G x1) 1) x1) x1) 0).

(; doc: An `AddMonoid` is an `AddSemigroup` with an element `0` such that `0 + a = a + 0 = a`. ;)
(; //LEAN:AddMonoid ;)
AddMonoid : (M : Set) -> Prop.

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: An additive monoid in which addition is right-cancellative. Main examples are `ℕ` and groups. This is the right typeclass for many sum lemmas, as having a zero is useful to define the sum over the empty set, so `AddRightCancelSemigroup` is not enough. ;)
(; //LEAN:AddRightCancelMonoid ;)
AddRightCancelMonoid : (M : Set) -> Prop.

(; doc: `x` is additive semiconjugate to `y` by `a` if `a + x = y + a` ;)
(; //LEAN:AddSemiconjBy ;)
AddSemiconjBy : (M : Set) -> (a : Elem M) -> (x1 : Elem M) -> (y : Elem M) -> Prop.

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (A : Set) -> (H : Elem (AddSubgroup A)) -> Prop.

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype G (x1 => Membership__mem G (AddSubgroup G) K x1))).

(; doc: The `AddSubgroup` generated by a set ;)
(; //LEAN:AddSubgroup.closure ;)
AddSubgroup__closure : (G : Set) -> (k : Elem (powerset G)) -> Elem (AddSubgroup G).

(; doc: The index of an additive subgroup as a natural number. Returns 0 if the index is infinite.  [Wikidata Q1464168](https://www.wikidata.org/wiki/Q1464168) ;)
(; //LEAN:AddSubgroup.index ;)
AddSubgroup__index : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem Nat.

(; //LEAN:AddSubgroup.mk ;)
AddSubgroup__mk : (G : Set) -> (toAddSubmonoid : Elem (AddSubmonoid G)) -> (neg_mem' : Proof (forall G (x1 => if (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G toAddSubmonoid)) x1) (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G toAddSubmonoid)) (Neg__neg G x1))))) -> Elem (AddSubgroup G).

(; doc: If `H` and `K` are subgroups of an additive group `G`, then `relIndex H K : ℕ` is the index of `H ∩ K` in `K`. The function returns `0` if the index is infinite. ;)
(; //LEAN:AddSubgroup.relIndex ;)
AddSubgroup__relIndex : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem Nat.

(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) G).

(; doc: Reinterpret an `AddSubgroup` as an `AddSubmonoid`. ;)
(; //LEAN:AddSubgroup.toAddSubmonoid ;)
AddSubgroup__toAddSubmonoid : (G : Set) -> (self : Elem (AddSubgroup G)) -> Elem (AddSubmonoid G).

(; doc: The additive subgroup generated by an element. ;)
(; //LEAN:AddSubgroup.zmultiples ;)
AddSubgroup__zmultiples : (G : Set) -> (g : Elem G) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.zmultiples_neg ;)
AddSubgroup__zmultiples_neg : (G : Set) -> (_ : Proof (AddGroup G)) -> (g : Elem G) -> Proof (Eqt (AddSubgroup G) (AddSubgroup__zmultiples G (Neg__neg G g)) (AddSubgroup__zmultiples G g)).

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; doc: The `AddSubmonoid` generated by a set ;)
(; //LEAN:AddSubmonoid.closure ;)
AddSubmonoid__closure : (M : Set) -> (s : Elem (powerset M)) -> Elem (AddSubmonoid M).

(; //LEAN:AddSubmonoid.mk ;)
AddSubmonoid__mk : (M : Set) -> (toAddSubsemigroup : Elem (AddSubsemigroup M)) -> (zero_mem' : Proof (Membership__mem M (powerset M) (AddSubsemigroup__carrier M toAddSubsemigroup) 0)) -> Elem (AddSubmonoid M).

(; doc: The additive submonoid generated by an element. ;)
(; //LEAN:AddSubmonoid.multiples ;)
AddSubmonoid__multiples : (A : Set) -> (x1 : Elem A) -> Elem (AddSubmonoid A).

(; doc: The natural monoid hom from an `AddSubmonoid` of `AddMonoid` `M` to `M`. ;)
(; //LEAN:AddSubmonoid.subtype ;)
AddSubmonoid__subtype : (M : Set) -> (S : Elem (AddSubmonoid M)) -> Elem (AddMonoidHom (Subtype M (x1 => Membership__mem M (AddSubmonoid M) S x1)) M).

(; //LEAN:AddSubsemigroup.mk ;)
AddSubsemigroup__mk : (M : Set) -> (carrier : Elem (powerset M)) -> (add_mem' : Proof (forall M (a => forall M (b => if (Membership__mem M (powerset M) carrier a) (if (Membership__mem M (powerset M) carrier b) (Membership__mem M (powerset M) carrier (plus a b))))))) -> Elem (AddSubsemigroup M).

(; doc: Units of an `AddMonoid`, bundled version.  An element of an `AddMonoid` is a unit if it has a two-sided additive inverse. This version bundles the inverse element so that it can be computed. For a predicate see `isAddUnit`. ;)
(; //LEAN:AddUnits ;)
AddUnits : (X : Set) -> Set.

(; doc: Coercion `AddUnits M → M` as an AddMonoid homomorphism. ;)
(; //LEAN:AddUnits.coeHom ;)
AddUnits__coeHom : (M : Set) -> Elem (AddMonoidHom (AddUnits M) M).

(; //LEAN:AddUnits.coeHom_injective ;)
AddUnits__coeHom_injective : (M : Set) -> (_ : Proof (AddMonoid M)) -> Proof (Function__Injective (AddUnits M) M (AddUnits__coeHom M)).

(; //LEAN:AddUnits.mk ;)
AddUnits__mk : (X : Set) -> (val : Elem X) -> (neg : Elem X) -> (val_neg : Proof (Eqt X (plus val neg) 0)) -> (neg_val : Proof (Eqt X (plus neg val) 0)) -> Elem (AddUnits X).

(; doc: The underlying value in the base `AddMonoid`. ;)
(; //LEAN:AddUnits.val ;)
AddUnits__val : (X : Set) -> (self : Elem (AddUnits X)) -> Elem X.

(; //LEAN:AddUnits.val_injective ;)
AddUnits__val_injective : (X : Set) -> (_ : Proof (AddMonoid X)) -> Proof (Function__Injective (AddUnits X) X (AddUnits__val X)).

(; doc: If `α` carries some multiplicative structure, then `Additive α` carries the corresponding additive structure. ;)
(; //LEAN:Additive ;)
Additive : (X : Set) -> Set.

(; doc: The generator of the kernel of the unique homomorphism ℕ → R for a semiring R.  *Warning*: for a semiring `R`, `CharP R 0` and `CharZero R` need not coincide. * `CharP R 0` asks that only `0 : ℕ` maps to `0 : R` under the map `ℕ → R`; * `CharZero R` requires an injection `ℕ ↪ R`.  For instance, endowing `{0, 1}` with addition given by `max` (i.e. `1` is absorbing), shows that `CharZero {0, 1}` does not hold and yet `CharP {0, 1} 0` does. This example is formalized in `Counterexamples/CharPZeroNeCharZero.lean`. ;)
(; //LEAN:CharP ;)
CharP : (R : Set) -> (p : Elem Nat) -> Prop.

(; //LEAN:Classical.not_imp ;)
Classical__not_imp : (a : Prop) -> (b : Prop) -> Proof (iff (not (if a b)) (and a (not b))).

(; //LEAN:Classical.not_imp._simp_2 ;)
Classical__not_imp___simp_2 : (a : Prop) -> (b : Prop) -> Proof (Eqt Prop (not (if a b)) (and a (not b))).

(; doc: The Double Negation Theorem: `¬¬P` is equivalent to `P`. The left-to-right direction, double negation elimination (DNE), is classically true but not constructively. ;)
(; //LEAN:Classical.not_not ;)
Classical__not_not : (a : Prop) -> Proof (iff (not (not a)) a).

(; //LEAN:Classical.not_not._simp_2 ;)
Classical__not_not___simp_2 : (a : Prop) -> Proof (Eqt Prop (not (not a)) a).

(; doc: A commutative monoid is a monoid with commutative `(*)`. ;)
(; //LEAN:CommMonoid ;)
CommMonoid : (M : Set) -> Prop.

(; doc: Two elements commute if `a * b = b * a`. ;)
(; //LEAN:Commute ;)
Commute : (M : Set) -> (a : Elem M) -> (b : Elem M) -> Prop.

(; //LEAN:Commute.all ;)
Commute__all : (S : Set) -> (_ : Proof (CommMagma S)) -> (a : Elem S) -> (b : Elem S) -> Proof (Commute S a b).

(; //LEAN:Commute.div_pow ;)
Commute__div_pow : (G : Set) -> (_ : Proof (Group G)) -> (a : Elem G) -> (b : Elem G) -> (h : Proof (Commute G a b)) -> (n : Elem Nat) -> Proof (Eqt G (pow (div a b) n) (div (pow a n) (pow b n))).

(; doc: A `DivisionMonoid` is a `DivInvMonoid` with involutive inversion and such that `(a * b)⁻¹ = b⁻¹ * a⁻¹` and `a * b = 1 → a⁻¹ = b`.  This is the immediate common ancestor of `Group` and `GroupWithZero`. ;)
(; //LEAN:DivisionMonoid ;)
DivisionMonoid : (G : Set) -> Prop.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Non-dependent recursor for the equality type. ;)
(; //LEAN:Eq.ndrec ;)
Eq__ndrec : (X : Set) -> (a : Elem X) -> (motive : (Elem X -> Set)) -> (m : Elem (motive a)) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Elem (motive b).

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.bijective ;)
Equiv__bijective : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Proof (Function__Bijective X Y e).

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: If `f` is a bijective function, then its domain is equivalent to its codomain. ;)
(; //LEAN:Equiv.ofBijective ;)
Equiv__ofBijective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Bijective X Y f)) -> Elem (Equiv X Y).

(; doc: Inverse of an equivalence `e : α ≃ β`. ;)
(; //LEAN:Equiv.symm ;)
Equiv__symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (Equiv Y X).

(; doc: Composition of equivalences `e₁ : α ≃ β` and `e₂ : β ≃ γ`. ;)
(; //LEAN:Equiv.trans ;)
Equiv__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem (Equiv X Y)) -> (x1 : Elem (Equiv Y Z)) -> Elem (Equiv X Z).

(; doc: Existential quantification. If `p : α → Prop` is a predicate, then `∃ x : α, p x` asserts that there is some `x` of type `α` such that `p x` holds. To create an existential proof, use the `exists` tactic, or the anonymous constructor notation `⟨x, h⟩`. To unpack an existential, use `cases h` where `h` is a proof of `∃ x : α, p x`, or `let ⟨x, hx⟩ := h`.  Because Lean has proof irrelevance, any two proofs of an existential are definitionally equal. One consequence of this is that it is impossible to recover the witness of an existential from the mere fact of its existence. For example, the following does not compile: ``` example (h : ∃ x : Nat, x = x) : Nat :=   let ⟨x, _⟩ := h  -- fail, because the goal is `Nat : Type`   x ``` The error message `recursor 'Exists.casesOn' can only eliminate into Prop` means that this only works when the current goal is another proposition: ``` example (h : ∃ x : Nat, x = x) : True :=   let ⟨x, _⟩ := h  -- ok, because the goal is `True : Prop`   trivial ``` ;)
(; //LEAN:Exists ;)
Exists : (X : Set) -> (p : (Elem X -> Prop)) -> Prop.

(; doc: Wrapper for adding elementary propositions to the type class systems. Warning: this can easily be abused. See the rest of this docstring for details.  Certain propositions should not be treated as a class globally, but sometimes it is very convenient to be able to use the type class system in specific circumstances.  For example, `ZMod p` is a field if and only if `p` is a prime number. In order to be able to find this field instance automatically by type class search, we have to turn `p.Prime` into an instance implicit assumption.  On the other hand, making `Nat.Prime` a class would require a major refactoring of the library, and it is questionable whether making `Nat.Prime` a class is desirable at all. The compromise is to add the assumption `[Fact p.Prime]` to `ZMod.instField`.  In particular, this class is not intended for turning the type class system into an automated theorem prover for first-order logic. ;)
(; //LEAN:Fact ;)
Fact : (p : Prop) -> Prop.

(; doc: Natural numbers less than some upper bound.  In particular, a `Fin n` is a natural number `i` with the constraint that `i < n`. It is the canonical type with `n` elements. ;)
(; //LEAN:Fin ;)
Fin : (n : Elem Nat) -> Set.

(; doc: Creates a `Fin n` from `i : Nat` and a proof that `i < n`. ;)
(; //LEAN:Fin.mk ;)
Fin__mk : (n : Elem Nat) -> (val : Elem Nat) -> (isLt : Proof (Lt val n)) -> Elem (Fin n).

(; doc: The number that is strictly less than `n`.  `Fin.val` is a coercion, so any `Fin n` can be used in a position where a `Nat` is expected. ;)
(; //LEAN:Fin.val ;)
Fin__val : (n : Elem Nat) -> (self : Elem (Fin n)) -> Elem Nat.

(; doc: A type is `Finite` if it is in bijective correspondence to some `Fin n`.  This is similar to `Fintype`, but `Finite` is a proposition rather than data. A particular benefit to this is that `Finite` instances are definitionally equal to one another (due to proof irrelevance) rather than being merely propositionally equal, and, furthermore, `Finite` instances generally avoid the need for `Decidable` instances. One other notable difference is that `Finite` allows there to be `Finite p` instances for all `p : Prop`, which is not allowed by `Fintype` due to universe constraints. An application of this is that `Finite (x ∈ s → β x)` follows from the general instance for pi types, assuming `[∀ x, Finite (β x)]`. Implementation note: this is a reason `Finite α` is not defined as `Nonempty (Fintype α)`.  Every `Fintype` instance provides a `Finite` instance via `Finite.of_fintype`. Conversely, one can noncomputably create a `Fintype` instance from a `Finite` instance via `Fintype.ofFinite`. In a proof one might write ```lean   have := Fintype.ofFinite α ``` to obtain such an instance.  Do not write noncomputable `Fintype` instances; instead write `Finite` instances and use this `Fintype.ofFinite` interface. The `Fintype` instances should be relied upon to be computable for evaluation purposes.  Theorems should use `Finite` instead of `Fintype`, unless definitions in the theorem statement require `Fintype`. Definitions should prefer `Finite` as well, unless it is important that the definitions are meant to be computable in the reduction or `#eval` sense. ;)
(; //LEAN:Finite ;)
Finite : (X : Set) -> Prop.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: `s.card` is the number of elements of `s`, aka its cardinality.  The notation `#s` can be accessed in the `Finset` locale. ;)
(; //LEAN:Finset.card ;)
Finset__card : (X : Set) -> (s : Elem (Finset X)) -> Elem Nat.

(; //LEAN:Finset.ext ;)
Finset__ext : (X : Set) -> (x : Elem (Finset X)) -> (x1 : Elem (Finset X)) -> (h : Proof (forall X (a => iff (Membership__mem X (Finset X) x a) (Membership__mem X (Finset X) x1 a)))) -> Proof (Eqt (Finset X) x x1).

(; doc: `Finset.filter p s` is the set of elements of `s` that satisfy `p`.  For example, one can use `s.filter (· ∈ t)` to get the intersection of `s` with `t : Set α` as a `Finset α` (when a `DecidablePred (· ∈ t)` instance is available). ;)
(; //LEAN:Finset.filter ;)
Finset__filter : (X : Set) -> (p : (Elem X -> Prop)) -> (s : Elem (Finset X)) -> Elem (Finset X).

(; doc: `image f s` is the forward image of `s` under `f`. ;)
(; //LEAN:Finset.image ;)
Finset__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (Finset X)) -> Elem (Finset Y).

(; doc: Least common multiple of a finite set ;)
(; //LEAN:Finset.lcm ;)
Finset__lcm : (X : Set) -> (Y : Set) -> (s : Elem (Finset Y)) -> (f : (Elem Y -> X)) -> Elem X.

(; doc: See also `Finset.card_le_card_of_injOn`, which is a more general version of this lemma. TODO: consider deprecating, since this is just a special case of `Finset.card_le_card_of_injOn`. ;)
(; //LEAN:Finset.le_card_of_inj_on_range ;)
Finset__le_card_of_inj_on_range : (X : Set) -> (s : Elem (Finset X)) -> (n : Elem Nat) -> (f : (Elem Nat -> X)) -> (hf : Proof (forall Nat (i1 => if (Lt i1 n) (Membership__mem X (Finset X) s (f i1))))) -> (f_inj : Proof (forall Nat (i => if (Lt i n) (forall Nat (j => if (Lt j n) (if (Eqt X (f i) (f j)) (Eq i j))))))) -> Proof (Leq n (Finset__card X s)).

(; //LEAN:Finset.mem_range_iff_mem_finset_range_of_mod_eq' ;)
Finset__mem_range_iff_mem_finset_range_of_mod_eq' : (X : Set) -> (f : (Elem Nat -> X)) -> (a : Elem X) -> (n : Elem Nat) -> (hn : Proof (Lt 0 n)) -> (h : Proof (forall Nat (i1 => Eqt X (f (HMod__hMod Nat Nat Nat i1 n)) (f i1)))) -> Proof (iff (Membership__mem X (powerset X) (Set__range X Nat f) a) (Membership__mem X (Finset X) (Finset__image Nat X (i => f i) (Finset__range n)) a)).

(; //LEAN:Finset.mem_univ ;)
Finset__mem_univ : (X : Set) -> (_ : Proof (Fintype X)) -> (x1 : Elem X) -> Proof (Membership__mem X (Finset X) (Finset__univ X) x1).

(; doc: `range n` is the set of natural numbers less than `n`. ;)
(; //LEAN:Finset.range ;)
Finset__range : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `univ` is the universal finite set of type `Finset α` implied from the assumption `Fintype α`. ;)
(; //LEAN:Finset.univ ;)
Finset__univ : (X : Set) -> Elem (Finset X).

(; doc: `Fintype α` means that `α` is finite, i.e. there are only finitely many distinct elements of type `α`. The evidence of this is a finset `elems` (a list up to permutation without duplicates), together with a proof that everything of type `α` is in the list. ;)
(; //LEAN:Fintype ;)
Fintype : (X : Set) -> Prop.

(; doc: `card α` is the number of elements in `α`, defined when `α` is a fintype. ;)
(; //LEAN:Fintype.card ;)
Fintype__card : (X : Set) -> Elem Nat.

(; //LEAN:Fintype.card_eq ;)
Fintype__card_eq : (X : Set) -> (Y : Set) -> (_ : Proof (Fintype X)) -> (_ : Proof (Fintype Y)) -> Proof (iff (Eq (Fintype__card X) (Fintype__card Y)) (Nonempty (Equiv X Y))).

(; //LEAN:Fintype.card_fin ;)
Fintype__card_fin : (n : Elem Nat) -> Proof (Eq (Fintype__card (Fin n)) n).

(; doc: A function is called bijective if it is both injective and surjective. ;)
(; //LEAN:Function.Bijective ;)
Function__Bijective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A point `x` is a periodic point of `f : α → α` of period `n` if `f^[n] x = x`. Note that we do not require `0 < n` in this definition. Many theorems about periodic points need this assumption. ;)
(; //LEAN:Function.IsPeriodicPt ;)
Function__IsPeriodicPt : (X : Set) -> (f : (Elem X -> X)) -> (n : Elem Nat) -> (x : Elem X) -> Prop.

(; //LEAN:Function.IsPeriodicPt.minimalPeriod_dvd ;)
Function__IsPeriodicPt__minimalPeriod_dvd : (X : Set) -> (f : (Elem X -> X)) -> (x : Elem X) -> (n : Elem Nat) -> (hx : Proof (Function__IsPeriodicPt X f n x)) -> Proof (divide (Function__minimalPeriod X f x) n).

(; //LEAN:Function.IsPeriodicPt.minimalPeriod_le ;)
Function__IsPeriodicPt__minimalPeriod_le : (X : Set) -> (f : (Elem X -> X)) -> (x : Elem X) -> (n : Elem Nat) -> (hn : Proof (Lt 0 n)) -> (hx : Proof (Function__IsPeriodicPt X f n x)) -> Proof (Leq (Function__minimalPeriod X f x) n).

(; doc: Minimal period of a point `x` under an endomorphism `f`. If `x` is not a periodic point of `f`, then `minimalPeriod f x = 0`. ;)
(; //LEAN:Function.minimalPeriod ;)
Function__minimalPeriod : (X : Set) -> (f : (Elem X -> X)) -> (x : Elem X) -> Elem Nat.

(; //LEAN:Function.minimalPeriod_fst_dvd ;)
Function__minimalPeriod_fst_dvd : (X : Set) -> (Y : Set) -> (f : (Elem X -> X)) -> (g : (Elem Y -> Y)) -> (x : Elem (Prod X Y)) -> Proof (divide (Function__minimalPeriod X f (Prod__fst X Y x)) (Function__minimalPeriod (Prod X Y) (Prod__map X X Y Y f g) x)).

(; doc: This `sInf` can be regarded as a generalized version of LCM for possibly infinite sets and types. ;)
(; //LEAN:Function.minimalPeriod_piMap ;)
Function__minimalPeriod_piMap : (I : Set) -> (x : (Elem I -> Set)) -> (f : ((i3 : Elem I) -> Elem (x i3) -> x i3)) -> (x1 : ((i2 : Elem I) -> x i2)) -> Proof (Eq (Function__minimalPeriod ((i : Elem I) -> x i) (Pi__map I x x f) x1) (InfSet__sInf Nat (Set__ofPred Nat (n => and (Gt n 0) (forall I (i1 => divide (Function__minimalPeriod (x i1) (f i1) (x1 i1)) n)))))).

(; //LEAN:Function.minimalPeriod_piMap_fintype ;)
Function__minimalPeriod_piMap_fintype : (I : Set) -> (x : (Elem I -> Set)) -> (f : ((i3 : Elem I) -> Elem (x i3) -> x i3)) -> (x1 : ((i2 : Elem I) -> x i2)) -> (_ : Proof (Fintype I)) -> Proof (Eq (Function__minimalPeriod ((i : Elem I) -> x i) (Pi__map I x x f) x1) (Finset__lcm Nat I (Finset__univ I) (i1 => Function__minimalPeriod (x i1) (f i1) (x1 i1)))).

(; //LEAN:Function.minimalPeriod_pos_of_mem_periodicPts ;)
Function__minimalPeriod_pos_of_mem_periodicPts : (X : Set) -> (f : (Elem X -> X)) -> (x : Elem X) -> (hx : Proof (Membership__mem X (powerset X) (Function__periodicPts X f) x)) -> Proof (Lt 0 (Function__minimalPeriod X f x)).

(; //LEAN:Function.minimalPeriod_prodMap ;)
Function__minimalPeriod_prodMap : (X : Set) -> (Y : Set) -> (f : (Elem X -> X)) -> (g : (Elem Y -> Y)) -> (x : Elem (Prod X Y)) -> Proof (Eq (Function__minimalPeriod (Prod X Y) (Prod__map X X Y Y f g) x) (Nat__lcm (Function__minimalPeriod X f (Prod__fst X Y x)) (Function__minimalPeriod Y g (Prod__snd X Y x)))).

(; //LEAN:Function.minimalPeriod_single_dvd_minimalPeriod_piMap ;)
Function__minimalPeriod_single_dvd_minimalPeriod_piMap : (I : Set) -> (x : (Elem I -> Set)) -> (f : ((i3 : Elem I) -> Elem (x i3) -> x i3)) -> (x1 : ((i2 : Elem I) -> x i2)) -> (i : Elem I) -> Proof (divide (Function__minimalPeriod (x i) (f i) (x1 i)) (Function__minimalPeriod ((i1 : Elem I) -> x i1) (Pi__map I x x f) x1)).

(; //LEAN:Function.minimalPeriod_snd_dvd ;)
Function__minimalPeriod_snd_dvd : (X : Set) -> (Y : Set) -> (f : (Elem X -> X)) -> (g : (Elem Y -> Y)) -> (x : Elem (Prod X Y)) -> Proof (divide (Function__minimalPeriod Y g (Prod__snd X Y x)) (Function__minimalPeriod (Prod X Y) (Prod__map X X Y Y f g) x)).

(; //LEAN:Function.not_isPeriodicPt_of_pos_of_lt_minimalPeriod ;)
Function__not_isPeriodicPt_of_pos_of_lt_minimalPeriod : (X : Set) -> (f : (Elem X -> X)) -> (x : Elem X) -> (n : Elem Nat) -> (h : Proof (Neq n 0)) -> (h1 : Proof (Lt n (Function__minimalPeriod X f x))) -> Proof (not (Function__IsPeriodicPt X f n x)).

(; doc: The set of periodic points of a map `f : α → α`. ;)
(; //LEAN:Function.periodicPts ;)
Function__periodicPts : (X : Set) -> (f : (Elem X -> X)) -> Elem (powerset X).

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; //LEAN:Group.mk ;)
Group__mk : (G : Set) -> (inv_mul_cancel : Proof (forall G (a => Eqt G (times (Inv__inv G a) a) 1))) -> Elem (Group__on G).

(; doc: A type `G₀` is a “group with zero” if it is a monoid with zero element (distinct from `1`) such that every nonzero element is invertible. The type is required to come with an “inverse” function, and the inverse of `0` must be `0`.  Examples include division rings and the ordered monoids that are the target of valuations in general valuation theory. ;)
(; //LEAN:GroupWithZero ;)
GroupWithZero : (X : Set) -> Prop.

(; doc: `a % b` computes the remainder upon dividing `a` by `b`. The meaning of this notation is type-dependent. * For `Nat` and `Int` it satisfies `a % b + b * (a / b) = a`,   and `a % 0` is defined to be `a`.  Conventions for notations in identifiers:   * The recommended spelling of `%` in identifiers is `mod`. ;)
(; //LEAN:HMod.hMod ;)
HMod__hMod : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `a +ᵥ b` computes the sum of `a` and `b`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `+ᵥ` in identifiers is `vadd`. ;)
(; //LEAN:HVAdd.hVAdd ;)
HVAdd__hVAdd : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: **Alias** of `not_congr`. ;)
(; //LEAN:Iff.not ;)
Iff__not : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff (not a) (not b)).

(; //LEAN:Iff.not_left ;)
Iff__not_left : (a : Prop) -> (b : Prop) -> (h : Proof (iff a (not b))) -> Proof (iff (not a) b).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: Infimum of a set ;)
(; //LEAN:InfSet.sInf ;)
InfSet__sInf : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: `a ≡ b [ZMOD n]` when `a % n = b % n`. ;)
(; //LEAN:Int.ModEq ;)
Int__ModEq : (n : Elem Int) -> (a : Elem Int) -> (b : Elem Int) -> Prop.

(; //LEAN:Int.emod_add_mul_ediv ;)
Int__emod_add_mul_ediv : (a : Elem Int) -> (b : Elem Int) -> Proof (Eq (plus (HMod__hMod Int Int Int a b) (times b (div a b))) a).

(; doc: Computes the greatest common divisor of two integers as a natural number. The GCD of two integers is the largest natural number that evenly divides both. However, the GCD of a number and `0` is the number's absolute value.  This implementation uses `Nat.gcd`, which is overridden in both the kernel and the compiler to efficiently evaluate using arbitrary-precision arithmetic.  Examples: * `Int.gcd 10 15 = 5` * `Int.gcd 10 (-15) = 5` * `Int.gcd (-6) (-9) = 3` * `Int.gcd 0 5 = 5` * `Int.gcd (-7) 0 = 7` ;)
(; //LEAN:Int.gcd ;)
Int__gcd : (m : Elem Int) -> (n : Elem Int) -> Elem Nat.

(; doc: The absolute value of an integer is its distance from `0`.  This function is overridden by the compiler with an efficient implementation. This definition is the logical model.  Examples:  * `(7 : Int).natAbs = 7`  * `(0 : Int).natAbs = 0`  * `(-11 : Int).natAbs = 11` ;)
(; //LEAN:Int.natAbs ;)
Int__natAbs : (m : Elem Int) -> Elem Nat.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: An additive monoid is torsion-free if scalar multiplication by every non-zero element `n : ℕ` is injective on commuting elements (i.e., `a + b = b + a → n • a = n • b → a = b`).  For commutative additive monoids, this is equivalent to `n • a = n • b → a = b`. For additive groups, this is equivalent to `n • a = 0 → a = 0`.  Thus, this definition reconciles the notions of torsion-free for additive groups and commutative additive semigroups.  For more information, see this mathoverflow answer: https://mathoverflow.net/a/377268/95685  `IsAddTorsionFree` is weaker than `HasUniqueDiv` for general additive monoids, but equivalent to it for commutative ones. Prefer using `HasUniqueDiv` for commutative additive monoids, so that typeclass-search can derive both `HasUniqueDiv` and `IsAddTorsionFree` without us needing to introduce an expensive `[AddCommMonoid M] [IsAddTorsionFree M] : HasUniqueDiv M` instance loop.  TODO: Generalize this definition to additive semigroups once we have the `PNat` action. ;)
(; //LEAN:IsAddTorsionFree ;)
IsAddTorsionFree : (M : Set) -> Prop.

(; //LEAN:IsAddTorsionFree.mk ;)
IsAddTorsionFree__mk : (M : Set) -> (_ : Proof (AddMonoid M)) -> (eq_of_nsmul_eq_nsmul_of_addCommute : Proof (forall Nat (n => if (Neq n 0) (forall M (a => forall M (b => if (AddCommute M a b) (if (Eqt M (HSMul__hSMul Nat M M n a) (HSMul__hSMul Nat M M n b)) (Eqt M a b)))))))) -> Proof (IsAddTorsionFree M).

(; doc: An element `a : M` of an `AddMonoid` is an `AddUnit` if it has a two-sided additive inverse. The actual definition says that `a` is equal to some `u : AddUnits M`, where `AddUnits M` is a bundled version of `IsAddUnit`. ;)
(; //LEAN:IsAddUnit ;)
IsAddUnit : (M : Set) -> (a : Elem M) -> Prop.

(; doc: We say that `a` is conjugate to `b` if for some unit `c` we have `c * a * c⁻¹ = b`. ;)
(; //LEAN:IsConj ;)
IsConj : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: A monoid is torsion-free if exponentiation by every non-zero element `n : ℕ` is injective on commuting elements (i.e., `a * b = b * a → a ^ n = b ^ n → a = b`).  For commutative monoids, this is equivalent to `a ^ n = b ^ n → a = b`. For groups, this is equivalent to `a ^ n = 1 → a = 1`.  Thus, this definition reconciles the notions of torsion-free for groups and commutative semigroups.  For more information, see this mathoverflow answer: https://mathoverflow.net/a/377268/95685  `IsMulTorsionFree` is weaker than `HasUniqueRoots` for general monoids, but equivalent to it for commutative ones. Prefer using `HasUniqueRoots` over commutative monoids, so that typeclass-search can derive both `HasUniqueRoots` and `IsMulTorsionFree` without us needing to introduce an expensive `[CommMonoid M] [IsMulTorsionFree M] : HasUniqueRoots M` instance loop.  TODO: Generalize this definition to semigroups once we have the `PNat` action. ;)
(; //LEAN:IsMulTorsionFree ;)
IsMulTorsionFree : (M : Set) -> Prop.

(; //LEAN:IsMulTorsionFree.mk ;)
IsMulTorsionFree__mk : (M : Set) -> (_ : Proof (Monoid M)) -> (eq_of_pow_eq_pow_of_commute : Proof (forall Nat (n => if (Neq n 0) (forall M (a => forall M (b => if (Commute M a b) (if (Eqt M (pow a n) (pow b n)) (Eqt M a b)))))))) -> Proof (IsMulTorsionFree M).

(; //LEAN:IsOfFinAddOrder.addUnit._proof_1 ;)
IsOfFinAddOrder__addUnit___proof_1 : (M : Set) -> (_ : Proof (AddMonoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Proof (Eqt M (plus x1 (HSMul__hSMul Nat M M (minus (addOrderOf M x1) 1) x1)) 0).

(; //LEAN:IsOfFinAddOrder.addUnit._proof_2 ;)
IsOfFinAddOrder__addUnit___proof_2 : (M : Set) -> (_ : Proof (AddMonoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Proof (Eqt M (plus (HSMul__hSMul Nat M M (minus (addOrderOf M x1) 1) x1) x1) 0).

(; //LEAN:IsOfFinOrder.unit._proof_1 ;)
IsOfFinOrder__unit___proof_1 : (M : Set) -> (_ : Proof (Monoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Proof (Eqt M (times x1 (pow x1 (minus (orderOf M x1) 1))) 1).

(; //LEAN:IsOfFinOrder.unit._proof_2 ;)
IsOfFinOrder__unit___proof_2 : (M : Set) -> (_ : Proof (Monoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Proof (Eqt M (times (pow x1 (minus (orderOf M x1) 1)) x1) 1).

(; doc: An element `a` is *self-inverse* if `a⁻¹ = a`. ;)
(; //LEAN:IsSelfInv ;)
IsSelfInv : (X : Set) -> (a : Elem X) -> Prop.

(; doc: An element `a` is *self-negative* if `-a = a`. ;)
(; //LEAN:IsSelfNeg ;)
IsSelfNeg : (X : Set) -> (a : Elem X) -> Prop.

(; doc: A strict ordered semiring is a nontrivial semiring with a partial order such that addition is strictly monotone and multiplication by a positive number is strictly monotone. ;)
(; //LEAN:IsStrictOrderedRing ;)
IsStrictOrderedRing : (R : Set) -> Prop.

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (M : Set) -> (a : Elem M) -> Prop.

(; doc: **Alias** of `ne_of_gt`. ;)
(; //LEAN:LT.lt.ne' ;)
LT__lt__ne' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; doc: **Alias** of `not_le_of_gt`. ;)
(; //LEAN:LT.lt.not_ge ;)
LT__lt__not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (not (Leq b a)).

(; doc: A monoid in which multiplication is left-cancellative. ;)
(; //LEAN:LeftCancelMonoid ;)
LeftCancelMonoid : (M : Set) -> Prop.

(; //LEAN:LeftCancelMonoid.groupOfFinite._proof_5 ;)
LeftCancelMonoid__groupOfFinite___proof_5 : (G : Set) -> (_ : Proof (LeftCancelMonoid G)) -> (_ : Proof (Finite G)) -> (x1 : Elem G) -> Proof (Eqt G (times (pow x1 (minus (orderOf G x1) 1)) x1) 1).

(; doc: A linear order is reflexive, transitive, antisymmetric and total relation `≤`. We assume that every linear ordered type has decidable `(≤)`, `(<)`, and `(=)`. ;)
(; //LEAN:LinearOrder ;)
LinearOrder : (X : Set) -> Prop.

(; //LEAN:Mathlib.Tactic.Contrapose.contrapose₁ ;)
Mathlib__Tactic__Contrapose__contrapose_u2081_ : (p : Prop) -> (q : Prop) -> (h : Proof (if (not q) (not p))) -> (h1 : Proof p) -> Proof q.

(; //LEAN:Mathlib.Tactic.Push.not_forall_eq ;)
Mathlib__Tactic__Push__not_forall_eq : (X : Set) -> (s : (Elem X -> Prop)) -> Proof (Eqt Prop (not (forall X (x => s x))) (exists X (x1 => not (s x1)))).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: The monoid homomorphism including a single monoid into a dependent family of additive monoids, as functions supported at a point.  This is the `MonoidHom` version of `Pi.mulSingle`. ;)
(; //LEAN:MonoidHom.mulSingle ;)
MonoidHom__mulSingle : (I : Set) -> (f : (Elem I -> Set)) -> (i : Elem I) -> Elem (MonoidHom (f i) ((i1 : Elem I) -> f i1)).

(; doc: A type `M₀` is a “monoid with zero” if it is a monoid with zero element, and `0` is left and right absorbing. ;)
(; //LEAN:MonoidWithZero ;)
MonoidWithZero : (X : Set) -> Prop.

(; doc: Type class for monoid actions on types, with notation `g • p`.  The `MulAction G P` typeclass says that the monoid `G` acts multiplicatively on a type `P`. More precisely this means that the action satisfies the two axioms `1 • p = p` and `(g₁ * g₂) • p = g₁ • (g₂ • p)`. A mathematician might simply say that the monoid `G` acts on `P`.  For example, if `G` is a group and `X` is a type, if a mathematician says say "let `G` act on the set `X`" they will probably mean `[MulAction G X]`.  [Wikidata Q288465](https://www.wikidata.org/wiki/Q288465) ;)
(; //LEAN:MulAction ;)
MulAction : (X : Set) -> (Y : Set) -> Prop.

(; doc: `MulEquiv α β` is the type of an equiv `α ≃ β` which preserves multiplication. ;)
(; //LEAN:MulEquiv ;)
MulEquiv : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MulEquiv.injective ;)
MulEquiv__injective : (M : Set) -> (N : Set) -> (e : Elem (MulEquiv M N)) -> Proof (Function__Injective M N e).

(; doc: Extract the forward direction of a multiplicative equivalence as a multiplication-preserving function. ;)
(; //LEAN:MulEquiv.toMonoidHom ;)
MulEquiv__toMonoidHom : (M : Set) -> (N : Set) -> (h : Elem (MulEquiv M N)) -> Elem (MonoidHom M N).

(; doc: If `α` carries some additive structure, then `Multiplicative α` carries the corresponding multiplicative structure. ;)
(; //LEAN:Multiplicative ;)
Multiplicative : (X : Set) -> Set.

(; doc: `m` and `n` are coprime, or relatively prime, if their `gcd` is 1. ;)
(; //LEAN:Nat.Coprime ;)
Nat__Coprime : (m : Elem Nat) -> (n : Elem Nat) -> Prop.

(; doc: Modular equality. `n.ModEq a b`, or `a ≡ b [MOD n]`, means that `a % n = b % n`. ;)
(; //LEAN:Nat.ModEq ;)
Nat__ModEq : (n : Elem Nat) -> (a : Elem Nat) -> (b : Elem Nat) -> Prop.

(; doc: `Nat.card α` is the cardinality of `α` as a natural number. If `α` is infinite, `Nat.card α = 0`. ;)
(; //LEAN:Nat.card ;)
Nat__card : (X : Set) -> Elem Nat.

(; //LEAN:Nat.card_pos_iff ;)
Nat__card_pos_iff : (X : Set) -> Proof (iff (Lt 0 (Nat__card X)) (and (Nonempty X) (Finite X))).

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; doc: `divisors n` is the `Finset` of divisors of `n`. By convention, we set `divisors 0 = ∅`. ;)
(; //LEAN:Nat.divisors ;)
Nat__divisors : (n : Elem Nat) -> Elem (Finset Nat).

(; doc: The extended GCD `b` value in the equation `gcd x y = x * a + y * b`. ;)
(; //LEAN:Nat.gcdB ;)
Nat__gcdB : (x : Elem Nat) -> (y : Elem Nat) -> Elem Int.

(; doc: The least common multiple of `m` and `n` is the smallest natural number that's evenly divisible by both `m` and `n`. Returns `0` if either `m` or `n` is `0`.  Examples:  * `Nat.lcm 9 6 = 18`  * `Nat.lcm 9 3 = 9`  * `Nat.lcm 0 3 = 0`  * `Nat.lcm 3 0 = 0` ;)
(; //LEAN:Nat.lcm ;)
Nat__lcm : (m : Elem Nat) -> (n : Elem Nat) -> Elem Nat.

(; //LEAN:Nat.lcm_dvd_mul ;)
Nat__lcm_dvd_mul : (m : Elem Nat) -> (n : Elem Nat) -> Proof (divide (Nat__lcm m n) (times m n)).

(; //LEAN:Nat.le_of_dvd ;)
Nat__le_of_dvd : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Lt 0 n)) -> (h1 : Proof (divide m n)) -> Proof (Leq m n).

(; //LEAN:Nat.mod_add_div ;)
Nat__mod_add_div : (m : Elem Nat) -> (k : Elem Nat) -> Proof (Eq (plus (HMod__hMod Nat Nat Nat m k) (times k (div m k))) m).

(; //LEAN:Nat.mod_eq_zero_of_dvd ;)
Nat__mod_eq_zero_of_dvd : (m : Elem Nat) -> (n : Elem Nat) -> (H : Proof (divide m n)) -> Proof (Eq (HMod__hMod Nat Nat Nat n m) 0).

(; //LEAN:Nat.mod_lt ;)
Nat__mod_lt : (x : Elem Nat) -> (y : Elem Nat) -> (hy : Proof (Lt 0 y)) -> Proof (Lt (HMod__hMod Nat Nat Nat x y) y).

(; doc: Alias for `Nat.zero_lt_one`. ;)
(; //LEAN:Nat.one_pos ;)
Nat__one_pos : Proof (Lt 0 1).

(; //LEAN:Nat.pos_of_dvd_of_pos ;)
Nat__pos_of_dvd_of_pos : (m : Elem Nat) -> (n : Elem Nat) -> (H1 : Proof (divide m n)) -> (H2 : Proof (Lt 0 n)) -> Proof (Lt 0 m).

(; doc: **Alias** of `pos_of_ne_zero`.  ---  **Alias** of the reverse direction of `pos_iff_ne_zero`. ;)
(; //LEAN:Ne.pos ;)
Ne__pos : (X : Set) -> (a : Elem X) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (IsBotZeroClass X)) -> (h1 : Proof (Neq a 0)) -> Proof (Lt 0 a).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: Predicate typeclass for expressing that `a * b = 0` implies `a = 0` or `b = 0` for all `a` and `b` of type `M₀`. It is weaker than `IsCancelMulZero` in general, but equivalent to it if `M₀` is a (not necessarily unital or associative) ring. ;)
(; //LEAN:NoZeroDivisors ;)
NoZeroDivisors : (X : Set) -> Prop.

(; doc: A unital but not-necessarily-associative ring. ;)
(; //LEAN:NonAssocRing ;)
NonAssocRing : (X : Set) -> Prop.

(; doc: `Nonempty α` is a typeclass that says that `α` is not an empty type, that is, there exists an element in the type. It differs from `Inhabited α` in that `Nonempty α` is a `Prop`, which means that it does not actually carry an element of `α`, only a proof that *there exists* such an element. Given `Nonempty α`, you can construct an element of `α` *nonconstructively* using `Classical.choice`. ;)
(; //LEAN:Nonempty ;)
Nonempty : (X : Set) -> Prop.

(; doc: If `val : α`, then `α` is nonempty. ;)
(; //LEAN:Nonempty.intro ;)
Nonempty__intro : (X : Set) -> (val : Elem X) -> Proof (Nonempty X).

(; doc: The underlying set of a term of a `OneMemClass` is nonempty. ;)
(; //LEAN:OneMemClass.coe_nonempty ;)
OneMemClass__coe_nonempty : (S : Set) -> (M : Set) -> (_ : Proof (OneMemClass S M)) -> (s : Elem S) -> Proof (Set__Nonempty M (SetLike__coe S M s)).

(; //LEAN:Or.resolve_left ;)
Or__resolve_left : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (na : Proof (not a)) -> Proof b.

(; doc: A partial order is a reflexive, transitive, antisymmetric relation `≤`. ;)
(; //LEAN:PartialOrder ;)
PartialOrder : (X : Set) -> Prop.

(; doc: The function supported at `i`, with value `x` there, and `1` elsewhere. ;)
(; //LEAN:Pi.mulSingle ;)
Pi__mulSingle : (I : Set) -> (M : (Elem I -> Set)) -> (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; //LEAN:Pi.mulSingle_injective ;)
Pi__mulSingle_injective : (I : Set) -> (M : (Elem I -> Set)) -> (_ : Proof ((i1 : Elem I) -> One (M i1))) -> (i : Elem I) -> Proof (Function__Injective (M i) ((j : Elem I) -> M j) (Pi__mulSingle I M i)).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: A monoid in which multiplication is right-cancellative. ;)
(; //LEAN:RightCancelMonoid ;)
RightCancelMonoid : (M : Set) -> Prop.

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: `x` is semiconjugate to `y` by `a`, if `a * x = y * a`. ;)
(; //LEAN:SemiconjBy ;)
SemiconjBy : (M : Set) -> (a : Elem M) -> (x1 : Elem M) -> (y : Elem M) -> Prop.

(; //LEAN:Semigroup.toMul ;)
Semigroup__toMul : (G : Set) -> Proof (Mul G).

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (X : Set) -> (s : Elem (powerset X)) -> Set.

(; doc: A set is finite if the corresponding `Subtype` is finite, i.e., if there exists a natural `n : ℕ` and an equivalence `s ≃ Fin n`. ;)
(; //LEAN:Set.Finite ;)
Set__Finite : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: Projection of `Set.Finite` to its `Finite` instance. This is intended to be used with dot notation. See also `Set.Finite.Fintype` and `Set.Finite.nonempty_fintype`. ;)
(; //LEAN:Set.Finite.to_subtype ;)
Set__Finite__to_subtype : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (Set__Finite X s)) -> Proof (Finite (Set__Elem X s)).

(; doc: `Iio b` is the left-infinite right-open interval $(-∞, b)$. ;)
(; //LEAN:Set.Iio ;)
Set__Iio : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: A set is infinite if it is not finite.  This is protected so that it does not conflict with global `Infinite`. ;)
(; //LEAN:Set.Infinite ;)
Set__Infinite : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: `f` is injective on `s` if the restriction of `f` to `s` is injective. ;)
(; //LEAN:Set.InjOn ;)
Set__InjOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Nonempty.to_subtype ;)
Set__Nonempty__to_subtype : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (Set__Nonempty X s)) -> Proof (Nonempty (Set__Elem X s)).

(; doc: The subtypes corresponding to equal sets are equivalent.  See also `Finset.equivOfEq`. ;)
(; //LEAN:Set.equivOfEq ;)
Set__equivOfEq : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Eqt (powerset X) s t)) -> Elem (Equiv (Set__Elem X s) (Set__Elem X t)).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem X (powerset X) a x) (Membership__mem X (powerset X) b x)))) -> Proof (Eqt (powerset X) a b).

(; //LEAN:Set.mem_toFinset ;)
Set__mem_toFinset : (X : Set) -> (s : Elem (powerset X)) -> (_ : Proof (Fintype (Set__Elem X s))) -> (a : Elem X) -> Proof (iff (Membership__mem X (Finset X) (Set__toFinset X s) a) (Membership__mem X (powerset X) s a)).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Construct a finset enumerating a set `s`, given a `Fintype` instance. ;)
(; //LEAN:Set.toFinset ;)
Set__toFinset : (X : Set) -> (s : Elem (powerset X)) -> Elem (Finset X).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set`. ;)
(; //LEAN:SetLike.coe ;)
SetLike__coe : (A : Set) -> (B : Set) -> (x : Elem A) -> Elem (powerset B).

(; //LEAN:SetLike.mem_coe ;)
SetLike__mem_coe : (A : Set) -> (B : Set) -> (p : Elem A) -> (x : Elem B) -> Proof (iff (Membership__mem B (powerset B) (SetLike__coe A B p) x) (Membership__mem B A p x)).

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (G : Set) -> (H : Elem (Subgroup G)) -> Prop.

(; doc: The `Subgroup` generated by a set. ;)
(; //LEAN:Subgroup.closure ;)
Subgroup__closure : (G : Set) -> (k : Elem (powerset G)) -> Elem (Subgroup G).

(; doc: The index of a subgroup as a natural number. Returns `0` if the index is infinite.  [Wikidata Q1464168](https://www.wikidata.org/wiki/Q1464168) ;)
(; //LEAN:Subgroup.index ;)
Subgroup__index : (G : Set) -> (H : Elem (Subgroup G)) -> Elem Nat.

(; //LEAN:Subgroup.mk ;)
Subgroup__mk : (G : Set) -> (toSubmonoid : Elem (Submonoid G)) -> (inv_mem' : Proof (forall G (x1 => if (Membership__mem G (powerset G) (Subsemigroup__carrier G (Submonoid__toSubsemigroup G toSubmonoid)) x1) (Membership__mem G (powerset G) (Subsemigroup__carrier G (Submonoid__toSubsemigroup G toSubmonoid)) (Inv__inv G x1))))) -> Elem (Subgroup G).

(; doc: If `H` and `K` are subgroups of a group `G`, then `relIndex H K : ℕ` is the index of `H ∩ K` in `K`. The function returns `0` if the index is infinite. ;)
(; //LEAN:Subgroup.relIndex ;)
Subgroup__relIndex : (G : Set) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem Nat.

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:Subgroup.subgroupOf ;)
Subgroup__subgroupOf : (G : Set) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem (Subgroup (Subtype G (x1 => Membership__mem G (Subgroup G) K x1))).

(; doc: The natural group hom from a subgroup of group `G` to `G`. ;)
(; //LEAN:Subgroup.subtype ;)
Subgroup__subtype : (G : Set) -> (H : Elem (Subgroup G)) -> Elem (MonoidHom (Subtype G (x1 => Membership__mem G (Subgroup G) H x1)) G).

(; doc: Reinterpret a `Subgroup` as a `Submonoid`. ;)
(; //LEAN:Subgroup.toSubmonoid ;)
Subgroup__toSubmonoid : (G : Set) -> (self : Elem (Subgroup G)) -> Elem (Submonoid G).

(; doc: The subgroup generated by an element. ;)
(; //LEAN:Subgroup.zpowers ;)
Subgroup__zpowers : (G : Set) -> (g : Elem G) -> Elem (Subgroup G).

(; //LEAN:Subgroup.zpowers_inv ;)
Subgroup__zpowers_inv : (G : Set) -> (_ : Proof (Group G)) -> (g : Elem G) -> Proof (Eqt (Subgroup G) (Subgroup__zpowers G (Inv__inv G g)) (Subgroup__zpowers G g)).

(; doc: A submonoid of a monoid `M` is a subset containing 1 and closed under multiplication. ;)
(; //LEAN:Submonoid ;)
Submonoid : (M : Set) -> Set.

(; doc: The `Submonoid` generated by a set. ;)
(; //LEAN:Submonoid.closure ;)
Submonoid__closure : (M : Set) -> (s : Elem (powerset M)) -> Elem (Submonoid M).

(; //LEAN:Submonoid.mk ;)
Submonoid__mk : (M : Set) -> (toSubsemigroup : Elem (Subsemigroup M)) -> (one_mem' : Proof (Membership__mem M (powerset M) (Subsemigroup__carrier M toSubsemigroup) 1)) -> Elem (Submonoid M).

(; doc: The submonoid generated by an element. ;)
(; //LEAN:Submonoid.powers ;)
Submonoid__powers : (M : Set) -> (n : Elem M) -> Elem (Submonoid M).

(; doc: The natural monoid hom from a submonoid of monoid `M` to `M`. ;)
(; //LEAN:Submonoid.subtype ;)
Submonoid__subtype : (M : Set) -> (S : Elem (Submonoid M)) -> Elem (MonoidHom (Subtype M (x1 => Membership__mem M (Submonoid M) S x1)) M).

(; //LEAN:Subsemigroup.mk ;)
Subsemigroup__mk : (M : Set) -> (carrier : Elem (powerset M)) -> (mul_mem' : Proof (forall M (a => forall M (b => if (Membership__mem M (powerset M) carrier a) (if (Membership__mem M (powerset M) carrier b) (Membership__mem M (powerset M) carrier (times a b))))))) -> Elem (Subsemigroup M).

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: A `SubtractionMonoid` is a `SubNegMonoid` with involutive negation and such that `-(a + b) = -b + -a` and `a + b = 0 → -a = b`. ;)
(; //LEAN:SubtractionMonoid ;)
SubtractionMonoid : (G : Set) -> Prop.

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.coe_injective ;)
Subtype__coe_injective : (X : Set) -> (p : (Elem X -> Prop)) -> Proof (Function__Injective (Subtype X (x => p x)) X (a => Subtype__val X p a)).

(; //LEAN:Subtype.mk ;)
Subtype__mk : (X : Set) -> (p : (Elem X -> Prop)) -> (val : Elem X) -> (property : Proof (p val)) -> Elem (Subtype X (x => p x)).

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (r : (Elem X -> Elem Y -> Set)) -> (s : (Elem Y -> Elem Z -> Set)) -> (t : (Elem X -> Elem Z -> Set)) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Z) -> (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Units of a `Monoid`, bundled version. Notation: `αˣ`.  An element of a `Monoid` is a unit if it has a two-sided inverse. This version bundles the inverse element so that it can be computed. For a predicate see `IsUnit`. ;)
(; //LEAN:Units ;)
Units : (X : Set) -> Set.

(; doc: Coercion `Mˣ → M` as a monoid homomorphism. ;)
(; //LEAN:Units.coeHom ;)
Units__coeHom : (M : Set) -> Elem (MonoidHom (Units M) M).

(; //LEAN:Units.coeHom_injective ;)
Units__coeHom_injective : (M : Set) -> (_ : Proof (Monoid M)) -> Proof (Function__Injective (Units M) M (Units__coeHom M)).

(; //LEAN:Units.mk ;)
Units__mk : (X : Set) -> (val : Elem X) -> (inv : Elem X) -> (val_inv : Proof (Eqt X (times val inv) 1)) -> (inv_val : Proof (Eqt X (times inv val) 1)) -> Elem (Units X).

(; doc: The underlying value in the base `Monoid`. ;)
(; //LEAN:Units.val ;)
Units__val : (X : Set) -> (self : Elem (Units X)) -> Elem X.

(; //LEAN:Units.val_injective ;)
Units__val_injective : (X : Set) -> (_ : Proof (Monoid X)) -> Proof (Function__Injective (Units X) X (Units__val X)).

(; doc: The underlying set of a term of a `ZeroMemClass` is nonempty. ;)
(; //LEAN:ZeroMemClass.coe_nonempty ;)
ZeroMemClass__coe_nonempty : (S : Set) -> (M : Set) -> (_ : Proof (ZeroMemClass S M)) -> (s : Elem S) -> Proof (Set__Nonempty M (SetLike__coe S M s)).

(; doc: `abs a`, denoted `|a|`, is the absolute value of `a` ;)
(; //LEAN:abs ;)
abs : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:abs_by_cases ;)
abs_by_cases : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (P : (Elem X -> Prop)) -> (h1 : Proof (P a)) -> (h2 : Proof (P (Neg__neg X a))) -> Proof (P (abs X a)).

(; //LEAN:addSubgroupOfIdempotent._proof_1 ;)
addSubgroupOfIdempotent___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Finite G)) -> (S : Elem (powerset G)) -> (hS1 : Proof (Set__Nonempty G S)) -> (hS2 : Proof (Eqt (powerset G) (plus S S) S)) -> (a : Elem G) -> (ha : Proof (Membership__mem G (powerset G) S a)) -> Proof (Membership__mem G (AddSubmonoid G) (addSubmonoidOfIdempotent G S hS1 hS2) (Neg__neg G a)).

(; //LEAN:addSubgroupOfIdempotent._proof_2 ;)
addSubgroupOfIdempotent___proof_2 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Finite G)) -> (S : Elem (powerset G)) -> (hS1 : Proof (Set__Nonempty G S)) -> (hS2 : Proof (Eqt (powerset G) (plus S S) S)) -> (a : Elem G) -> (b : Elem G) -> (h1 : Proof (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G (addSubmonoidOfIdempotent G S hS1 hS2))) a)) -> (h2 : Proof (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G (addSubmonoidOfIdempotent G S hS1 hS2))) b)) -> Proof (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G (addSubmonoidOfIdempotent G S hS1 hS2))) (plus a b)).

(; //LEAN:addSubgroupOfIdempotent._proof_3 ;)
addSubgroupOfIdempotent___proof_3 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Finite G)) -> (S : Elem (powerset G)) -> (hS1 : Proof (Set__Nonempty G S)) -> (hS2 : Proof (Eqt (powerset G) (plus S S) S)) -> Proof (Membership__mem G (powerset G) (AddSubsemigroup__carrier G (AddSubmonoid__toAddSubsemigroup G (addSubmonoidOfIdempotent G S hS1 hS2))) 0).

(; //LEAN:addSubmonoidOfIdempotent._proof_1 ;)
addSubmonoidOfIdempotent___proof_1 : (M : Set) -> (_ : Proof (AddLeftCancelMonoid M)) -> (S : Elem (powerset M)) -> (hS2 : Proof (Eqt (powerset M) (plus S S) S)) -> (a : Elem M) -> (ha : Proof (Membership__mem M (powerset M) S a)) -> (n : Elem Nat) -> Proof (Membership__mem M (powerset M) S (HSMul__hSMul Nat M M (plus n 1) a)).

(; //LEAN:addSubmonoidOfIdempotent._proof_2 ;)
addSubmonoidOfIdempotent___proof_2 : (M : Set) -> (_ : Proof (AddLeftCancelMonoid M)) -> (_ : Proof (Finite M)) -> (S : Elem (powerset M)) -> (hS1 : Proof (Set__Nonempty M S)) -> (nsmul_mem : Proof (forall M (a => if (Membership__mem M (powerset M) S a) (forall Nat (n => Membership__mem M (powerset M) S (HSMul__hSMul Nat M M (plus n 1) a)))))) -> Proof (Membership__mem M (powerset M) S 0).

(; //LEAN:addSubmonoidOfIdempotent._proof_3 ;)
addSubmonoidOfIdempotent___proof_3 : (M : Set) -> (_ : Proof (AddLeftCancelMonoid M)) -> (S : Elem (powerset M)) -> (hS2 : Proof (Eqt (powerset M) (plus S S) S)) -> (x1 : Elem M) -> (x2 : Elem M) -> (ha : Proof (Membership__mem M (powerset M) S x1)) -> (hb : Proof (Membership__mem M (powerset M) S x2)) -> Proof (Membership__mem M (powerset M) S (plus x1 x2)).

(; //LEAN:add_nsmul ;)
add_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt M (HSMul__hSMul Nat M M (plus m n) a) (plus (HSMul__hSMul Nat M M m a) (HSMul__hSMul Nat M M n a))).

(; //LEAN:add_zero ;)
add_zero : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (a : Elem M) -> Proof (Eqt M (plus a 0) a).

(; //LEAN:add_zsmul ;)
add_zsmul : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> (m : Elem Int) -> (n : Elem Int) -> Proof (Eqt G (HSMul__hSMul Int G G (plus m n) a) (plus (HSMul__hSMul Int G G m a) (HSMul__hSMul Int G G n a))).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; //LEAN:div_eq_one ;)
div_eq_one : (G : Set) -> (_ : Proof (Group G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Eqt G (div a b) 1) (Eqt G a b)).

(; //LEAN:dvd_trans ;)
dvd_trans : (X : Set) -> (_ : Proof (Semigroup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (divide a b)) -> (h1 : Proof (divide b c)) -> Proof (divide a c).

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; //LEAN:eq_true ;)
eq_true : (p : Prop) -> (h : Proof p) -> Proof (Eqt Prop p True).

(; doc: The 'identity' equivalence between `Fin m` and `Fin n` when `m = n`. ;)
(; //LEAN:finCongr ;)
finCongr : (n : Elem Nat) -> (m : Elem Nat) -> (eq : Proof (Eq n m)) -> Elem (Equiv (Fin n) (Fin m)).

(; //LEAN:finEquivMultiples._proof_1 ;)
finEquivMultiples___proof_1 : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem (Fin (addOrderOf G x1))) -> Proof (exists Nat (y => Eqt G (HSMul__hSMul Nat G G y x1) (HSMul__hSMul Nat G G (Fin__val (addOrderOf G x1) n) x1))).

(; //LEAN:finEquivMultiples._proof_2 ;)
finEquivMultiples___proof_2 : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (hx : Proof (IsOfFinAddOrder G x1)) -> Proof (and (Function__Injective (Fin (addOrderOf G x1)) (Subtype G (x2 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x2)) (n => Subtype__mk G (x3 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x3) (HSMul__hSMul Nat G G (Fin__val (addOrderOf G x1) n) x1) (finEquivMultiples___proof_1 G x1 n))) (Function__Surjective (Fin (addOrderOf G x1)) (Subtype G (x4 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x4)) (n1 => Subtype__mk G (x5 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x5) (HSMul__hSMul Nat G G (Fin__val (addOrderOf G x1) n1) x1) (finEquivMultiples___proof_1 G x1 n1)))).

(; //LEAN:finEquivPowers._proof_1 ;)
finEquivPowers___proof_1 : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem (Fin (orderOf G x1))) -> Proof (exists Nat (y => Eqt G (pow x1 y) (pow x1 (Fin__val (orderOf G x1) n)))).

(; //LEAN:finEquivPowers._proof_2 ;)
finEquivPowers___proof_2 : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (hx : Proof (IsOfFinOrder G x1)) -> Proof (and (Function__Injective (Fin (orderOf G x1)) (Subtype G (x2 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x2)) (n => Subtype__mk G (x3 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x3) (pow x1 (Fin__val (orderOf G x1) n)) (finEquivPowers___proof_1 G x1 n))) (Function__Surjective (Fin (orderOf G x1)) (Subtype G (x4 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x4)) (n1 => Subtype__mk G (x5 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x5) (pow x1 (Fin__val (orderOf G x1) n1)) (finEquivPowers___proof_1 G x1 n1)))).

(; //LEAN:finEquivZMultiples_symm_apply._proof_1 ;)
finEquivZMultiples_symm_apply___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (x1 : Elem G) -> (n : Elem Nat) -> Proof (Eqt G ((x2 => HSMul__hSMul Int G G x2 x1) (Nat__cast Int n)) (HSMul__hSMul Nat G G n x1)).

(; //LEAN:finEquivZPowers_symm_apply._proof_1 ;)
finEquivZPowers_symm_apply___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (x1 : Elem G) -> (n : Elem Nat) -> Proof (Eqt G ((x2 => pow x1 x2) (Nat__cast Int n)) (pow x1 n)).

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: **Function extensionality.** If two functions return equal results for all possible arguments, then they are equal.  It is called “extensionality” because it provides a way to prove two objects equal based on the properties of the underlying mathematical functions, rather than based on the syntax used to denote them. Function extensionality is a theorem that can be [proved using quotient types](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=quotient-funext). ;)
(; //LEAN:funext ;)
funext : (X : Set) -> (x : (Elem X -> Set)) -> (f : ((x4 : Elem X) -> x x4)) -> (g : ((x3 : Elem X) -> x x3)) -> (h : Proof (forall X (x2 => Eqt (x x2) (f x2) (g x2)))) -> Proof (Eqt ((x1 : Elem X) -> x x1) f g).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:implies_congr ;)
implies_congr : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (h : Proof (Eqt Set X X1)) -> (h1 : Proof (Eqt Set X2 X3)) -> Proof (Eqt Set (Elem X -> X2) (Elem X1 -> X3)).

(; //LEAN:implies_true ;)
implies_true : (X : Set) -> Proof (Eqt Prop (forall X (x => True)) True).

(; //LEAN:inv_pow ;)
inv_pow : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (a : Elem X) -> (n : Elem Nat) -> Proof (Eqt X (pow (Inv__inv X a) n) (Inv__inv X (pow a n))).

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (X : Set) -> (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; doc: `mabs a`, denoted `|a|ₘ`, is the absolute value of `a`. ;)
(; //LEAN:mabs ;)
mabs : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:mabs_by_cases ;)
mabs_by_cases : (X : Set) -> (_ : Proof (Group X)) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (P : (Elem X -> Prop)) -> (h1 : Proof (P a)) -> (h2 : Proof (P (Inv__inv X a))) -> Proof (P (mabs X a)).

(; //LEAN:mul_nsmul ;)
mul_nsmul : (M : Set) -> (_ : Proof (AddMonoid M)) -> (a : Elem M) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt M (HSMul__hSMul Nat M M (times m n) a) (HSMul__hSMul Nat M M n (HSMul__hSMul Nat M M m a))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; doc: **Alias** of `Left.mul_pos`.  ---  Assumes left covariance. ;)
(; //LEAN:mul_pos ;)
mul_pos : (X : Set) -> (_ : Proof (MulZeroClass X)) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (Preorder X)) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (Lt 0 (times a b)).

(; //LEAN:mul_zsmul' ;)
mul_zsmul' : (X : Set) -> (_ : Proof (SubtractionMonoid X)) -> (a : Elem X) -> (m : Elem Int) -> (n : Elem Int) -> Proof (Eqt X (HSMul__hSMul Int X X (times m n) a) (HSMul__hSMul Int X X n (HSMul__hSMul Int X X m a))).

(; //LEAN:natCast_zsmul ;)
natCast_zsmul : (G : Set) -> (_ : Proof (SubNegMonoid G)) -> (a : Elem G) -> (n : Elem Nat) -> Proof (Eqt G (HSMul__hSMul Int G G (Nat__cast Int n) a) (HSMul__hSMul Nat G G n a)).

(; //LEAN:neg_nsmul ;)
neg_nsmul : (X : Set) -> (_ : Proof (SubtractionMonoid X)) -> (a : Elem X) -> (n : Elem Nat) -> Proof (Eqt X (HSMul__hSMul Nat X X n (Neg__neg X a)) (Neg__neg X (HSMul__hSMul Nat X X n a))).

(; //LEAN:nsmulCoprime._proof_1 ;)
nsmulCoprime___proof_1 : (n : Elem Nat) -> (G : Set) -> (_ : Proof (AddGroup G)) -> (h : Proof (Nat__Coprime (Nat__card G) n)) -> (g : Elem G) -> Proof (Eqt G ((g1 => HSMul__hSMul Int G G (Nat__gcdB (Nat__card G) n) g1) ((g2 => HSMul__hSMul Nat G G n g2) g)) g).

(; //LEAN:nsmulCoprime._proof_2 ;)
nsmulCoprime___proof_2 : (n : Elem Nat) -> (G : Set) -> (_ : Proof (AddGroup G)) -> (h : Proof (Nat__Coprime (Nat__card G) n)) -> (g : Elem G) -> Proof (Eqt G ((g1 => HSMul__hSMul Nat G G n g1) ((g2 => HSMul__hSMul Int G G (Nat__gcdB (Nat__card G) n) g2) g)) g).

(; //LEAN:nsmul_zero ;)
nsmul_zero : (M : Set) -> (_ : Proof (AddMonoid M)) -> (n : Elem Nat) -> Proof (Eqt M (HSMul__hSMul Nat M M n 0) 0).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; doc: **Alias** of `zero_lt_one`.  ---  See `zero_lt_one'` for a version with the type explicit. ;)
(; //LEAN:one_pos ;)
one_pos : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> Proof (Lt 0 1).

(; //LEAN:one_pow ;)
one_pow : (M : Set) -> (_ : Proof (Monoid M)) -> (n : Elem Nat) -> Proof (Eqt M (pow 1 n) 1).

(; //LEAN:one_zpow ;)
one_zpow : (X : Set) -> (_ : Proof (DivisionMonoid X)) -> (n : Elem Int) -> Proof (Eqt X (pow 1 n) 1).

(; //LEAN:powCardSubgroup._proof_1 ;)
powCardSubgroup___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (hS : Proof (Set__Nonempty G S)) -> Proof (Membership__mem G (powerset G) (pow S (Fintype__card G)) 1).

(; //LEAN:powCardSubgroup._proof_2 ;)
powCardSubgroup___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (one_mem : Proof (Membership__mem G (powerset G) (pow S (Fintype__card G)) 1)) -> Proof (exists G (x2 => Membership__mem G (powerset G) (pow S (Fintype__card G)) x2)).

(; //LEAN:powCardSubgroup._proof_3 ;)
powCardSubgroup___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (one_mem : Proof (Membership__mem G (powerset G) (pow S (Fintype__card G)) 1)) -> Proof (Eqt (powerset G) (times (pow S (Fintype__card G)) (pow S (Fintype__card G))) (pow S (Fintype__card G))).

(; //LEAN:powCoprime._proof_1 ;)
powCoprime___proof_1 : (n : Elem Nat) -> (G : Set) -> (_ : Proof (Group G)) -> (h : Proof (Nat__Coprime (Nat__card G) n)) -> (g : Elem G) -> Proof (Eqt G ((g1 => pow g1 (Nat__gcdB (Nat__card G) n)) ((g2 => pow g2 n) g)) g).

(; //LEAN:powCoprime._proof_2 ;)
powCoprime___proof_2 : (n : Elem Nat) -> (G : Set) -> (_ : Proof (Group G)) -> (h : Proof (Nat__Coprime (Nat__card G) n)) -> (g : Elem G) -> Proof (Eqt G ((g1 => pow g1 n) ((g2 => pow g2 (Nat__gcdB (Nat__card G) n)) g)) g).

(; //LEAN:pow_add ;)
pow_add : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt M (pow a (plus m n)) (times (pow a m) (pow a n))).

(; //LEAN:pow_mul ;)
pow_mul : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt M (pow a (times m n)) (pow (pow a m) n)).

(; //LEAN:pow_zero ;)
pow_zero : (M : Set) -> (_ : Proof (Monoid M)) -> (a : Elem M) -> Proof (Eqt M (pow a 0) 1).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Noncomputable function that outputs the unique characteristic of a semiring. ;)
(; //LEAN:ringChar ;)
ringChar : (R : Set) -> Elem Nat.

(; //LEAN:smulCardAddSubgroup._proof_1 ;)
smulCardAddSubgroup___proof_1 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (hS : Proof (Set__Nonempty G S)) -> Proof (Membership__mem G (powerset G) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S) 0).

(; //LEAN:smulCardAddSubgroup._proof_2 ;)
smulCardAddSubgroup___proof_2 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (zero_mem : Proof (Membership__mem G (powerset G) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S) 0)) -> Proof (exists G (x2 => Membership__mem G (powerset G) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S) x2)).

(; //LEAN:smulCardAddSubgroup._proof_3 ;)
smulCardAddSubgroup___proof_3 : (G : Set) -> (_ : Proof (AddGroup G)) -> (_ : Proof (Fintype G)) -> (S : Elem (powerset G)) -> (zero_mem : Proof (Membership__mem G (powerset G) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S) 0)) -> Proof (Eqt (powerset G) (plus (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S)) (HSMul__hSMul Nat (powerset G) (powerset G) (Fintype__card G) S)).

(; //LEAN:sq_eq_one_iff ;)
sq_eq_one_iff : (R : Set) -> (_ : Proof (Ring R)) -> (a : Elem R) -> (_ : Proof (NoZeroDivisors R)) -> Proof (iff (Eqt R (pow a 2) 1) (or (Eqt R a 1) (Eqt R a (Neg__neg R 1)))).

(; //LEAN:sq_nonneg ;)
sq_nonneg : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (LinearOrder R)) -> (_ : Proof (ExistsAddOfLE R)) -> (a : Elem R) -> Proof (Leq 0 (pow a 2)).

(; //LEAN:sub_eq_zero ;)
sub_eq_zero : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (iff (Eqt G (minus a b) 0) (Eqt G a b)).

