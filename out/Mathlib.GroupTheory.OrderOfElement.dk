addOrderOf_eq_of_nsmul_and_div_prime_nsmul : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (hn : Proof (Lt 0 n)) -> (hx : Proof (Eqt G (HSMul__hSMul Nat G G n x1) 0)) -> (hd : Proof (forall Nat (p => if (prime p) (if (divide p n) (Neq (HSMul__hSMul Nat G G (div n p) x1) 0))))) -> Proof (Eq (addOrderOf G x1) n).

(; //LEAN:orderOf_eq_orderOf_iff ;)
orderOf_eq_orderOf_iff : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (H : Set) -> (_ : Proof (Monoid H)) -> (y : Elem H) -> Proof (iff (Eq (orderOf G x1) (orderOf H y)) (forall Nat (n => iff (Eqt G (pow x1 n) 1) (Eqt H (pow y n) 1)))).

(; //LEAN:addOrderOf_eq_addOrderOf_iff ;)
addOrderOf_eq_addOrderOf_iff : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (H : Set) -> (_ : Proof (AddMonoid H)) -> (y : Elem H) -> Proof (iff (Eq (addOrderOf G x1) (addOrderOf H y)) (forall Nat (n => iff (Eqt G (HSMul__hSMul Nat G G n x1) 0) (Eqt H (HSMul__hSMul Nat H H n y) 0)))).

(; //LEAN:orderOf_injective ;)
orderOf_injective : (G : Set) -> (_ : Proof (Monoid G)) -> (H : Set) -> (_ : Proof (Monoid H)) -> (f : Elem (MonoidHom G H)) -> (hf : Proof (Function__Injective G H f)) -> (x2 : Elem G) -> Proof (Eq (orderOf H (f x2)) (orderOf G x2)).

(; //LEAN:addOrderOf_injective ;)
addOrderOf_injective : (G : Set) -> (_ : Proof (AddMonoid G)) -> (H : Set) -> (_ : Proof (AddMonoid H)) -> (f : Elem (AddMonoidHom G H)) -> (hf : Proof (Function__Injective G H f)) -> (x2 : Elem G) -> Proof (Eq (addOrderOf H (f x2)) (addOrderOf G x2)).

(; //LEAN:MulEquiv.orderOf_eq ;)
def MulEquiv__orderOf_eq : (G : Set) -> (_ : Proof (Monoid G)) -> (H : Set) -> (_ : Proof (Monoid H)) -> (e : Elem (MulEquiv G H)) -> (x2 : Elem G) -> Proof (Eq (orderOf H (e x2)) (orderOf G x2)) :=
  G => x => H => x1 => e => x2 => orderOf_injective G H (MulEquiv__toMonoidHom G H e) (MulEquiv__injective G H e) x2.

(; //LEAN:AddEquiv.addOrderOf_eq ;)
def AddEquiv__addOrderOf_eq : (G : Set) -> (_ : Proof (AddMonoid G)) -> (H : Set) -> (_ : Proof (AddMonoid H)) -> (e : Elem (AddEquiv G H)) -> (x2 : Elem G) -> Proof (Eq (addOrderOf H (e x2)) (addOrderOf G x2)) :=
  G => x => H => x1 => e => x2 => addOrderOf_injective G H (AddEquiv__toAddMonoidHom G H e) (AddEquiv__injective G H e) x2.

(; //LEAN:Function.Injective.isOfFinAddOrder_iff ;)
Function__Injective__isOfFinAddOrder_iff : (G : Set) -> (H : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (_ : Proof (AddMonoid H)) -> (f : Elem (AddMonoidHom G H)) -> (hf : Proof (Function__Injective G H f)) -> Proof (iff (IsOfFinAddOrder H (f x1)) (IsOfFinAddOrder G x1)).

(; //LEAN:Function.Injective.isOfFinOrder_iff ;)
Function__Injective__isOfFinOrder_iff : (G : Set) -> (H : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (_ : Proof (Monoid H)) -> (f : Elem (MonoidHom G H)) -> (hf : Proof (Function__Injective G H f)) -> Proof (iff (IsOfFinOrder H (f x1)) (IsOfFinOrder G x1)).

(; //LEAN:orderOf_submonoid ;)
def orderOf_submonoid : (G : Set) -> (_ : Proof (Monoid G)) -> (H : Elem (Submonoid G)) -> (y : Elem (Subtype G (x3 => Membership__mem G (Submonoid G) H x3))) -> Proof (Eq (orderOf G (Subtype__val G (x1 => Membership__mem G (Submonoid G) H x1) y)) (orderOf (Subtype G (x2 => Membership__mem G (Submonoid G) H x2)) y)) :=
  G => x => H => y => orderOf_injective (Subtype G (x1 => Membership__mem G (Submonoid G) H x1)) G (Submonoid__subtype G H) (Subtype__coe_injective G (x2 => Membership__mem G (Submonoid G) H x2)) y.

(; //LEAN:addOrderOf_addSubmonoid ;)
def addOrderOf_addSubmonoid : (G : Set) -> (_ : Proof (AddMonoid G)) -> (H : Elem (AddSubmonoid G)) -> (y : Elem (Subtype G (x3 => Membership__mem G (AddSubmonoid G) H x3))) -> Proof (Eq (addOrderOf G (Subtype__val G (x1 => Membership__mem G (AddSubmonoid G) H x1) y)) (addOrderOf (Subtype G (x2 => Membership__mem G (AddSubmonoid G) H x2)) y)) :=
  G => x => H => y => addOrderOf_injective (Subtype G (x1 => Membership__mem G (AddSubmonoid G) H x1)) G (AddSubmonoid__subtype G H) (Subtype__coe_injective G (x2 => Membership__mem G (AddSubmonoid G) H x2)) y.

(; //LEAN:addOrderOf_addUnits ;)
def addOrderOf_addUnits : (G : Set) -> (_ : Proof (AddMonoid G)) -> (y : Elem (AddUnits G)) -> Proof (Eq (addOrderOf G (AddUnits__val G y)) (addOrderOf (AddUnits G) y)) :=
  G => x => y => addOrderOf_injective (AddUnits G) G (AddUnits__coeHom G) (AddUnits__val_injective G) y.

(; //LEAN:orderOf_units ;)
def orderOf_units : (G : Set) -> (_ : Proof (Monoid G)) -> (y : Elem (Units G)) -> Proof (Eq (orderOf G (Units__val G y)) (orderOf (Units G) y)) :=
  G => x => y => orderOf_injective (Units G) G (Units__coeHom G) (Units__val_injective G) y.

(; //LEAN:IsAddUnit.addOrderOf_eq_zero ;)
IsAddUnit__addOrderOf_eq_zero : (G : Set) -> (_ : Proof (AddMonoid G)) -> (_ : Proof (Subsingleton (AddUnits G))) -> (x1 : Elem G) -> (h1 : Proof (IsAddUnit G x1)) -> Proof (Eq (addOrderOf G x1) 1).

(; //LEAN:IsUnit.orderOf_eq_one ;)
IsUnit__orderOf_eq_one : (G : Set) -> (_ : Proof (Monoid G)) -> (_ : Proof (Subsingleton (Units G))) -> (x1 : Elem G) -> (h1 : Proof (IsUnit G x1)) -> Proof (Eq (orderOf G x1) 1).

(; //LEAN:AddUnits.isOfFinAddOrder_val ;)
def AddUnits__isOfFinAddOrder_val : (G : Set) -> (_ : Proof (AddMonoid G)) -> (u : Elem (AddUnits G)) -> Proof (iff (IsOfFinAddOrder G (AddUnits__val G u)) (IsOfFinAddOrder (AddUnits G) u)) :=
  G => x => u => Function__Injective__isOfFinAddOrder_iff (AddUnits G) G u (AddUnits__coeHom G) (AddUnits__coeHom_injective G).

(; //LEAN:Units.isOfFinOrder_val ;)
def Units__isOfFinOrder_val : (G : Set) -> (_ : Proof (Monoid G)) -> (u : Elem (Units G)) -> Proof (iff (IsOfFinOrder G (Units__val G u)) (IsOfFinOrder (Units G) u)) :=
  G => x => u => Function__Injective__isOfFinOrder_iff (Units G) G u (Units__coeHom G) (Units__coeHom_injective G).

(; //LEAN:IsOfFinOrder.unit ;)
def IsOfFinOrder__unit : (M : Set) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Elem (Units M) :=
  M => x1 => hx => Units__mk M x1 (pow x1 (minus (orderOf M x1) 1)) (IsOfFinOrder__unit___proof_1 M x1 hx) (IsOfFinOrder__unit___proof_2 M x1 hx).

(; //LEAN:IsOfFinAddOrder.val_neg_addUnit ;)
IsOfFinAddOrder__val_neg_addUnit : (M : Set) -> (_ : Proof (AddMonoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Proof (Eqt M (AddUnits__val M (Neg__neg (AddUnits M) (IsOfFinAddOrder__addUnit M x1 hx))) (HSMul__hSMul Nat M M (minus (addOrderOf M x1) 1) x1)).

(; //LEAN:IsOfFinAddOrder.val_addUnit ;)
IsOfFinAddOrder__val_addUnit : (M : Set) -> (_ : Proof (AddMonoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Proof (Eqt M (AddUnits__val M (IsOfFinAddOrder__addUnit M x1 hx)) x1).

(; //LEAN:IsOfFinAddOrder.addUnit ;)
def IsOfFinAddOrder__addUnit : (M : Set) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Elem (AddUnits M) :=
  M => x1 => hx => AddUnits__mk M x1 (HSMul__hSMul Nat M M (minus (addOrderOf M x1) 1) x1) (IsOfFinAddOrder__addUnit___proof_1 M x1 hx) (IsOfFinAddOrder__addUnit___proof_2 M x1 hx).

(; //LEAN:IsOfFinOrder.val_inv_unit ;)
IsOfFinOrder__val_inv_unit : (M : Set) -> (_ : Proof (Monoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Proof (Eqt M (Units__val M (Inv__inv (Units M) (IsOfFinOrder__unit M x1 hx))) (pow x1 (minus (orderOf M x1) 1))).

(; //LEAN:IsOfFinOrder.val_unit ;)
IsOfFinOrder__val_unit : (M : Set) -> (_ : Proof (Monoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Proof (Eqt M (Units__val M (IsOfFinOrder__unit M x1 hx)) x1).

(; //LEAN:IsOfFinOrder.isUnit ;)
def IsOfFinOrder__isUnit : (M : Set) -> (_ : Proof (Monoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinOrder M x1)) -> Proof (IsUnit M x1) :=
  M => x => x1 => hx => existsI (Units M) (u => Eqt M (Units__val M u) x1) (IsOfFinOrder__unit M x1 hx) (rfl M (Units__val M (IsOfFinOrder__unit M x1 hx))).

(; //LEAN:IsOfFinAddOrder.isAddUnit ;)
def IsOfFinAddOrder__isAddUnit : (M : Set) -> (_ : Proof (AddMonoid M)) -> (x1 : Elem M) -> (hx : Proof (IsOfFinAddOrder M x1)) -> Proof (IsAddUnit M x1) :=
  M => x => x1 => hx => existsI (AddUnits M) (u => Eqt M (AddUnits__val M u) x1) (IsOfFinAddOrder__addUnit M x1 hx) (rfl M (AddUnits__val M (IsOfFinAddOrder__addUnit M x1 hx))).

(; //LEAN:addOrderOf_nsmul' ;)
addOrderOf_nsmul' : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (h : Proof (Neq n 0)) -> Proof (Eq (addOrderOf G (HSMul__hSMul Nat G G n x1)) (div (addOrderOf G x1) (gcd (addOrderOf G x1) n))).

(; //LEAN:orderOf_pow' ;)
orderOf_pow' : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (h : Proof (Neq n 0)) -> Proof (Eq (orderOf G (pow x1 n)) (div (orderOf G x1) (gcd (orderOf G x1) n))).

