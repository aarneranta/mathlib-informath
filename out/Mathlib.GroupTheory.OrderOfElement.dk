def IsOfFinOrder__orderOf_pos : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (h : Proof (IsOfFinOrder G x1)) -> Proof (Lt 0 (orderOf G x1)) :=
  G => x => x1 => h => Function__minimalPeriod_pos_of_mem_periodicPts G (x2 => times x1 x2) 1 h.

