IsOfFinOrder__pi : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Monoid (x i2))) -> (x2 : ((i1 : Elem I) -> x i1)) -> (_ : Proof (Finite I)) -> (h1 : Proof (forall I (i => IsOfFinOrder (x2 i)))) -> Proof (IsOfFinOrder x2).

