Pi__addOrderOf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> AddMonoid (x i2))) -> (_ : Proof (Fintype I)) -> (x3 : ((i1 : Elem I) -> x i1)) -> Proof (Eq (addOrderOf x3) (Finset__lcm Finset__univ (i => addOrderOf (x3 i)))).

(; //LEAN:Pi.orderOf ;)
def Pi__orderOf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Monoid (x i2))) -> (_ : Proof (Fintype I)) -> (x3 : ((i1 : Elem I) -> x i1)) -> Proof (Eq (orderOf x3) (Finset__lcm Finset__univ (i => orderOf (x3 i)))) :=
  I => x => x1 => x2 => x3 => Function__minimalPeriod_piMap_fintype I x (i => (Mul__proj0 ((i1 => Semigroup__toMul) i)) (x3 i)) 1.

(; //LEAN:addOrderOf_apply_dvd_addOrderOf ;)
addOrderOf_apply_dvd_addOrderOf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> AddMonoid (x i2))) -> (x2 : ((i1 : Elem I) -> x i1)) -> (i : Elem I) -> Proof (divide (addOrderOf (x2 i)) (addOrderOf x2)).

(; //LEAN:orderOf_apply_dvd_orderOf ;)
def orderOf_apply_dvd_orderOf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Monoid (x i2))) -> (x2 : ((i1 : Elem I) -> x i1)) -> (i : Elem I) -> Proof (divide (orderOf (x2 i)) (orderOf x2)) :=
  I => x => x1 => x2 => Function__minimalPeriod_single_dvd_minimalPeriod_piMap I x (i => x3 => times (x2 i) x3) (i1 => 1).

