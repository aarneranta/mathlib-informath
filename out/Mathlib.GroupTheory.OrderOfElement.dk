finEquivMultiples_symm_apply : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (hx : Proof (IsOfFinAddOrder G x1)) -> (n : Elem Nat) -> Proof (Eqt (Fin (addOrderOf G x1)) (Equiv__symm__app (finEquivMultiples G x1 hx) (Subtype__mk G (x4 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x4) (HSMul__hSMul Nat G G n x1) (existsI Nat (y => Eqt G ((x5 => HSMul__hSMul Nat G G x5 x1) y) (HSMul__hSMul Nat G G n x1)) n (rfl G ((x6 => HSMul__hSMul Nat G G x6 x1) n))))) (Fin__mk (addOrderOf G x1) (HMod__hMod Nat Nat Nat n (addOrderOf G x1)) (Nat__mod_lt n (addOrderOf G x1) (IsOfFinAddOrder__addOrderOf_pos G x1 hx)))).

