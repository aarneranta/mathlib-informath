(; //LEAN:orderOf ;)
def orderOf : (G : Set) -> (x1 : Elem G) -> Elem Nat :=
  G => x1 => Function__minimalPeriod G (x2 => times x1 x2) 1.

(; //LEAN:addOrderOf ;)
def addOrderOf : (G : Set) -> (x1 : Elem G) -> Elem Nat :=
  G => x1 => Function__minimalPeriod G (x2 => plus x1 x2) 0.

(; //LEAN:Subsingleton.orderOf_eq ;)
Subsingleton__orderOf_eq : (G : Set) -> (_ : Proof (Monoid G)) -> (_ : Proof (Subsingleton G)) -> (x1 : Elem G) -> Proof (Eq (orderOf G x1) 1).

