  X => Y => x => x1 => x2 => iffI (IsOfFinOrder x2) (and (IsOfFinOrder (Prod__fst x2)) (IsOfFinOrder (Prod__snd x2))) (h => andI (IsOfFinOrder (Prod__fst x2)) (IsOfFinOrder (Prod__snd x2)) (IsOfFinOrder__fst X Y x2 h) (IsOfFinOrder__snd X Y x2 h)) (h1 => IsOfFinOrder__prod_mk X Y (Prod__fst x2) (Prod__snd x2) (andEl (IsOfFinOrder (Prod__fst x2)) (IsOfFinOrder (Prod__snd x2)) h1) (andEr (IsOfFinOrder (Prod__fst x2)) (IsOfFinOrder (Prod__snd x2)) h1)).

(; //LEAN:IsOfFinAddOrder.prod_iff ;)
IsOfFinAddOrder__prod_iff : (X : Set) -> (Y : Set) -> (_ : Proof (AddMonoid X)) -> (_ : Proof (AddMonoid Y)) -> (x2 : Elem (Prod X Y)) -> Proof (iff (IsOfFinAddOrder x2) (and (IsOfFinAddOrder (Prod__fst x2)) (IsOfFinAddOrder (Prod__snd x2)))).

