IsOfFinOrder__finite_powers : (G : Set) -> (_ : Proof (Monoid G)) -> (a : Elem G) -> (ha : Proof (IsOfFinOrder G a)) -> Proof (Set__Finite G (SetLike__coe (Submonoid G) G (Submonoid__powers G a))).

(; //LEAN:IsOfFinAddOrder.finite_multiples ;)
IsOfFinAddOrder__finite_multiples : (G : Set) -> (_ : Proof (AddMonoid G)) -> (a : Elem G) -> (ha : Proof (IsOfFinAddOrder G a)) -> Proof (Set__Finite G (SetLike__coe (AddSubmonoid G) G (AddSubmonoid__multiples G a))).

(; //LEAN:AddCommute.addOrderOf_add_dvd_lcm ;)
AddCommute__addOrderOf_add_dvd_lcm : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> Proof (divide (addOrderOf G (plus x1 y)) (Nat__lcm (addOrderOf G x1) (addOrderOf G y))).

(; //LEAN:Commute.orderOf_mul_dvd_lcm ;)
Commute__orderOf_mul_dvd_lcm : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> Proof (divide (orderOf G (times x1 y)) (Nat__lcm (orderOf G x1) (orderOf G y))).

(; //LEAN:AddCommute.addOrderOf_dvd_lcm_add ;)
AddCommute__addOrderOf_dvd_lcm_add : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> Proof (divide (addOrderOf G y) (Nat__lcm (addOrderOf G x1) (addOrderOf G (plus x1 y)))).

(; //LEAN:Commute.orderOf_dvd_lcm_mul ;)
Commute__orderOf_dvd_lcm_mul : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> Proof (divide (orderOf G y) (Nat__lcm (orderOf G x1) (orderOf G (times x1 y)))).

(; //LEAN:Commute.orderOf_mul_dvd_mul_orderOf ;)
def Commute__orderOf_mul_dvd_mul_orderOf : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> Proof (divide (orderOf G (times x1 y)) (times (orderOf G x1) (orderOf G y))) :=
  G => x => x1 => y => h => dvd_trans Nat (orderOf G (times x1 y)) (Nat__lcm (orderOf G x1) (orderOf G y)) (times (orderOf G x1) (orderOf G y)) (Commute__orderOf_mul_dvd_lcm G x1 y h) (Nat__lcm_dvd_mul (orderOf G x1) (orderOf G y)).

(; //LEAN:AddCommute.addOrderOf_add_dvd_mul_addOrderOf ;)
def AddCommute__addOrderOf_add_dvd_mul_addOrderOf : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> Proof (divide (addOrderOf G (plus x1 y)) (times (addOrderOf G x1) (addOrderOf G y))) :=
  G => x => x1 => y => h => dvd_trans Nat (addOrderOf G (plus x1 y)) (Nat__lcm (addOrderOf G x1) (addOrderOf G y)) (times (addOrderOf G x1) (addOrderOf G y)) (AddCommute__addOrderOf_add_dvd_lcm G x1 y h) (Nat__lcm_dvd_mul (addOrderOf G x1) (addOrderOf G y)).

(; //LEAN:AddCommute.addOrderOf_add_eq_mul_addOrderOf_of_coprime ;)
AddCommute__addOrderOf_add_eq_mul_addOrderOf_of_coprime : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> (hco : Proof (Nat__Coprime (addOrderOf G x1) (addOrderOf G y))) -> Proof (Eq (addOrderOf G (plus x1 y)) (times (addOrderOf G x1) (addOrderOf G y))).

(; //LEAN:Commute.orderOf_mul_eq_mul_orderOf_of_coprime ;)
Commute__orderOf_mul_eq_mul_orderOf_of_coprime : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> (hco : Proof (Nat__Coprime (orderOf G x1) (orderOf G y))) -> Proof (Eq (orderOf G (times x1 y)) (times (orderOf G x1) (orderOf G y))).

(; //LEAN:Commute.isOfFinOrder_mul ;)
def Commute__isOfFinOrder_mul : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> (hx : Proof (IsOfFinOrder G x1)) -> (hy : Proof (IsOfFinOrder G y)) -> Proof (IsOfFinOrder G (times x1 y)) :=
  G => x => x1 => y => h => hx => hy => iffEl (Lt 0 (orderOf G (times x1 y))) (IsOfFinOrder G (times x1 y)) (orderOf_pos_iff G (times x1 y)) (Nat__pos_of_dvd_of_pos (orderOf G (times x1 y)) (times (orderOf G x1) (orderOf G y)) (Commute__orderOf_mul_dvd_mul_orderOf G x1 y h) (mul_pos Nat (orderOf G x1) (orderOf G y) (IsOfFinOrder__orderOf_pos G x1 hx) (IsOfFinOrder__orderOf_pos G y hy))).

(; //LEAN:AddCommute.isOfFinAddOrder_add ;)
def AddCommute__isOfFinAddOrder_add : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> (hx : Proof (IsOfFinAddOrder G x1)) -> (hy : Proof (IsOfFinAddOrder G y)) -> Proof (IsOfFinAddOrder G (plus x1 y)) :=
  G => x => x1 => y => h => hx => hy => iffEl (Lt 0 (addOrderOf G (plus x1 y))) (IsOfFinAddOrder G (plus x1 y)) (addOrderOf_pos_iff G (plus x1 y)) (Nat__pos_of_dvd_of_pos (addOrderOf G (plus x1 y)) (times (addOrderOf G x1) (addOrderOf G y)) (AddCommute__addOrderOf_add_dvd_mul_addOrderOf G x1 y h) (mul_pos Nat (addOrderOf G x1) (addOrderOf G y) (IsOfFinAddOrder__addOrderOf_pos G x1 hx) (IsOfFinAddOrder__addOrderOf_pos G y hy))).

(; //LEAN:Commute.orderOf_mul_eq_right_of_forall_prime_mul_dvd ;)
Commute__orderOf_mul_eq_right_of_forall_prime_mul_dvd : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> (hy : Proof (IsOfFinOrder G y)) -> (hdvd : Proof (forall Nat (p => if (prime p) (if (divide p (orderOf G x1)) (divide (times p (orderOf G x1)) (orderOf G y)))))) -> Proof (Eq (orderOf G (times x1 y)) (orderOf G y)).

(; //LEAN:AddCommute.addOrderOf_add_eq_right_of_forall_prime_mul_dvd ;)
AddCommute__addOrderOf_add_eq_right_of_forall_prime_mul_dvd : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> (hy : Proof (IsOfFinAddOrder G y)) -> (hdvd : Proof (forall Nat (p => if (prime p) (if (divide p (addOrderOf G x1)) (divide (times p (addOrderOf G x1)) (addOrderOf G y)))))) -> Proof (Eq (addOrderOf G (plus x1 y)) (addOrderOf G y)).

(; //LEAN:Commute.orderOf_mul_eq_left_of_forall_prime_mul_dvd ;)
Commute__orderOf_mul_eq_left_of_forall_prime_mul_dvd : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (Commute G x1 y)) -> (hx : Proof (IsOfFinOrder G x1)) -> (hdvd : Proof (forall Nat (p => if (prime p) (if (divide p (orderOf G y)) (divide (times p (orderOf G y)) (orderOf G x1)))))) -> Proof (Eq (orderOf G (times x1 y)) (orderOf G x1)).

(; //LEAN:AddCommute.addOrderOf_add_eq_left_of_forall_prime_mul_dvd ;)
AddCommute__addOrderOf_add_eq_left_of_forall_prime_mul_dvd : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddCommute G x1 y)) -> (hx : Proof (IsOfFinAddOrder G x1)) -> (hdvd : Proof (forall Nat (p => if (prime p) (if (divide p (addOrderOf G y)) (divide (times p (addOrderOf G y)) (addOrderOf G x1)))))) -> Proof (Eq (addOrderOf G (plus x1 y)) (addOrderOf G x1)).

(; //LEAN:addOrderOf_eq_prime_iff ;)
addOrderOf_eq_prime_iff : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> Proof (iff (Eq (addOrderOf G x1) p) (and (Eqt G (HSMul__hSMul Nat G G p x1) 0) (Neq x1 0))).

(; //LEAN:orderOf_eq_prime_iff ;)
orderOf_eq_prime_iff : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> Proof (iff (Eq (orderOf G x1) p) (and (Eqt G (pow x1 p) 1) (Neq x1 1))).

(; //LEAN:orderOf_eq_prime ;)
def orderOf_eq_prime : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> (hg : Proof (Eqt G (pow x1 p) 1)) -> (hg1 : Proof (Neq x1 1)) -> Proof (Eq (orderOf G x1) p) :=
  G => x => x1 => p => hp => hg => hg1 => iffEr (Eq (orderOf G x1) p) (and (Eqt G (pow x1 p) 1) (Neq x1 1)) (orderOf_eq_prime_iff G x1 p) (andI (Eqt G (pow x1 p) 1) (Neq x1 1) hg hg1).

(; //LEAN:addOrderOf_eq_prime ;)
def addOrderOf_eq_prime : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> (hg : Proof (Eqt G (HSMul__hSMul Nat G G p x1) 0)) -> (hg1 : Proof (Neq x1 0)) -> Proof (Eq (addOrderOf G x1) p) :=
  G => x => x1 => p => hp => hg => hg1 => iffEr (Eq (addOrderOf G x1) p) (and (Eqt G (HSMul__hSMul Nat G G p x1) 0) (Neq x1 0)) (addOrderOf_eq_prime_iff G x1 p) (andI (Eqt G (HSMul__hSMul Nat G G p x1) 0) (Neq x1 0) hg hg1).

(; //LEAN:orderOf_eq_prime_pow ;)
orderOf_eq_prime_pow : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> (hnot : Proof (not (Eqt G (pow x1 (pow p n)) 1))) -> (hfin : Proof (Eqt G (pow x1 (pow p (plus n 1))) 1)) -> Proof (Eq (orderOf G x1) (pow p (plus n 1))).

(; //LEAN:addOrderOf_eq_prime_pow ;)
addOrderOf_eq_prime_pow : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> (hnot : Proof (not (Eqt G (HSMul__hSMul Nat G G (pow p n) x1) 0))) -> (hfin : Proof (Eqt G (HSMul__hSMul Nat G G (pow p (plus n 1)) x1) 0)) -> Proof (Eq (addOrderOf G x1) (pow p (plus n 1))).

(; //LEAN:exists_addOrderOf_eq_prime_pow_iff ;)
exists_addOrderOf_eq_prime_pow_iff : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> Proof (iff (exists Nat (k => Eq (addOrderOf G x1) (pow p k))) (exists Nat (m => Eqt G (HSMul__hSMul Nat G G (pow p m) x1) 0))).

(; //LEAN:exists_orderOf_eq_prime_pow_iff ;)
exists_orderOf_eq_prime_pow_iff : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (p : Elem Nat) -> (_ : Proof (Fact (prime p))) -> Proof (iff (exists Nat (k => Eq (orderOf G x1) (pow p k))) (exists Nat (m => Eqt G (pow x1 (pow p m)) 1))).

(; //LEAN:orderOf_neg_one ;)
orderOf_neg_one : (R : Set) -> (_ : Proof (Ring R)) -> Proof (Eq (orderOf R (Neg__neg R 1)) (ite Nat (Eq (ringChar R) 2) 1 2)).

(; //LEAN:CharP.orderOf_eq_two_iff ;)
CharP__orderOf_eq_two_iff : (R : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (NoZeroDivisors R)) -> (p : Elem Nat) -> (hp : Proof (Neq p 2)) -> (_ : Proof (CharP R p)) -> (x1 : Elem R) -> Proof (iff (Eq (orderOf R x1) 2) (Eqt R x1 (Neg__neg R 1))).

(; //LEAN:finEquivPowers ;)
