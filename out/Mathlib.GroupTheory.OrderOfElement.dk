charP_of_ne_zero : (R : Set) -> (_ : Proof (NonAssocRing R)) -> (p : Elem Nat) -> (_ : Proof (Fintype R)) -> (hn : Proof (Eq (Fintype__card R) p)) -> (hR : Proof (forall Nat (i => if (Lt i p) (if (Eqt R i 0) (Eq i 0))))) -> Proof (CharP R p).

