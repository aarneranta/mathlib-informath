(; //LEAN:finEquivMultiples ;)
def finEquivMultiples : (G : Set) -> (x1 : Elem G) -> (hx : Proof (IsOfFinAddOrder G x1)) -> Elem (Equiv (Fin (addOrderOf G x1)) (Subtype G (x2 => Membership__mem G (AddSubmonoid G) (AddSubmonoid__multiples G x1) x2))) :=
