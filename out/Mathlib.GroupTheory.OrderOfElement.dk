finEquivPowers_symm_apply : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (hx : Proof (IsOfFinOrder G x1)) -> (n : Elem Nat) -> Proof (Eqt (Fin (orderOf G x1)) (Equiv__symm__app (finEquivPowers G x1 hx) (Subtype__mk G (x4 => Membership__mem G (Submonoid G) (Submonoid__powers G x1) x4) (pow x1 n) (existsI Nat (y => Eqt G ((x5 => pow x1 x5) y) (pow x1 n)) n (rfl G ((x6 => pow x1 x6) n))))) (Fin__mk (orderOf G x1) (HMod__hMod Nat Nat Nat n (orderOf G x1)) (Nat__mod_lt n (orderOf G x1) (IsOfFinOrder__orderOf_pos G x1 hx)))).

