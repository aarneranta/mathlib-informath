AddSemiconjBy__addOrderOf_eq : (G : Set) -> (_ : Proof (AddGroup G)) -> (a : Elem G) -> (x1 : Elem G) -> (y : Elem G) -> (h : Proof (AddSemiconjBy a x1 y)) -> Proof (Eq (addOrderOf x1) (addOrderOf y)).

