charP_of_prime_pow_injective : (R : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (Fintype R)) -> (p : Elem Nat) -> (n : Elem Nat) -> (_ : Proof (Fact (prime p))) -> (hn : Proof (Eq (Fintype__card R) (pow p n))) -> (hR : Proof (forall Nat (i => if (Leq i n) (if (Eqt R (pow p i) 0) (Eq i n))))) -> Proof (CharP R (pow p n)).

