addOrderOf_nsmul_of_dvd : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (dvd : Proof (divide n (addOrderOf G x1))) -> Proof (Eq (addOrderOf G (HSMul__hSMul Nat G G n x1)) (div (addOrderOf G x1) n)).

(; //LEAN:orderOf_pow_of_dvd ;)
orderOf_pow_of_dvd : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (hn : Proof (Neq n 0)) -> (dvd : Proof (divide n (orderOf G x1))) -> Proof (Eq (orderOf G (pow x1 n)) (div (orderOf G x1) n)).

(; //LEAN:orderOf_pow_orderOf_div ;)
orderOf_pow_orderOf_div : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (hx : Proof (Neq (orderOf G x1) 0)) -> (hn : Proof (divide n (orderOf G x1))) -> Proof (Eq (orderOf G (pow x1 (div (orderOf G x1) n))) n).

(; //LEAN:addOrderOf_nsmul_addOrderOf_sub ;)
addOrderOf_nsmul_addOrderOf_sub : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (hx : Proof (Neq (addOrderOf G x1) 0)) -> (hn : Proof (divide n (addOrderOf G x1))) -> Proof (Eq (addOrderOf G (HSMul__hSMul Nat G G (div (addOrderOf G x1) n) x1)) n).

(; //LEAN:IsOfFinAddOrder.addOrderOf_nsmul ;)
IsOfFinAddOrder__addOrderOf_nsmul : (G : Set) -> (_ : Proof (AddMonoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (h : Proof (IsOfFinAddOrder G x1)) -> Proof (Eq (addOrderOf G (HSMul__hSMul Nat G G n x1)) (div (addOrderOf G x1) (gcd (addOrderOf G x1) n))).

(; //LEAN:IsOfFinOrder.orderOf_pow ;)
IsOfFinOrder__orderOf_pow : (G : Set) -> (_ : Proof (Monoid G)) -> (x1 : Elem G) -> (n : Elem Nat) -> (h : Proof (IsOfFinOrder G x1)) -> Proof (Eq (orderOf G (pow x1 n)) (div (orderOf G x1) (gcd (orderOf G x1) n))).

(; //LEAN:Nat.Coprime.addOrderOf_nsmul ;)
Nat__Coprime__addOrderOf_nsmul : (G : Set) -> (_ : Proof (AddMonoid G)) -> (y : Elem G) -> (m : Elem Nat) -> (h : Proof (Nat__Coprime (addOrderOf G y) m)) -> Proof (Eq (addOrderOf G (HSMul__hSMul Nat G G m y)) (addOrderOf G y)).

(; //LEAN:Nat.Coprime.orderOf_pow ;)
Nat__Coprime__orderOf_pow : (G : Set) -> (_ : Proof (Monoid G)) -> (y : Elem G) -> (m : Elem Nat) -> (h : Proof (Nat__Coprime (orderOf G y) m)) -> Proof (Eq (orderOf G (pow y m)) (orderOf G y)).

(; //LEAN:IsOfFinAddOrder.natCard_multiples_le_addOrderOf ;)
IsOfFinAddOrder__natCard_multiples_le_addOrderOf : (G : Set) -> (_ : Proof (AddMonoid G)) -> (a : Elem G) -> (ha : Proof (IsOfFinAddOrder G a)) -> Proof (Leq (Nat__card (Set__Elem G (SetLike__coe (AddSubmonoid G) G (AddSubmonoid__multiples G a)))) (addOrderOf G a)).

(; //LEAN:IsOfFinOrder.natCard_powers_le_orderOf ;)
IsOfFinOrder__natCard_powers_le_orderOf : (G : Set) -> (_ : Proof (Monoid G)) -> (a : Elem G) -> (ha : Proof (IsOfFinOrder G a)) -> Proof (Leq (Nat__card (Set__Elem G (SetLike__coe (Submonoid G) G (Submonoid__powers G a)))) (orderOf G a)).

