def Prod__orderOf_mk : (X : Set) -> (Y : Set) -> (_ : Proof (Monoid X)) -> (_ : Proof (Monoid Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (Eq (orderOf (Prod__mk a b)) (Nat__lcm (orderOf a) (orderOf b))) :=
  X => Y => x => x1 => a => b => Prod__orderOf X Y (Prod__mk a b).

(; //LEAN:Prod.addOrderOf_mk ;)
Prod__addOrderOf_mk : (X : Set) -> (Y : Set) -> (_ : Proof (AddMonoid X)) -> (_ : Proof (AddMonoid Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (Eq (addOrderOf (Prod__mk a b)) (Nat__lcm (addOrderOf a) (addOrderOf b))).

(; //LEAN:Pi.orderOf_eq_sInf ;)
def Pi__orderOf_eq_sInf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Monoid (x i2))) -> (x2 : ((i1 : Elem I) -> x i1)) -> Proof (Eq (orderOf x2) (InfSet__sInf (Set__ofPred (n => and (Gt n 0) (forall I (i => divide (orderOf (x2 i)) n)))))) :=
  I => x => x1 => x2 => Function__minimalPeriod_piMap I x (i => (Mul__proj0 ((i1 => Semigroup__toMul) i)) (x2 i)) 1.

(; //LEAN:Pi.addOrderOf_eq_sInf ;)
Pi__addOrderOf_eq_sInf : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> AddMonoid (x i2))) -> (x2 : ((i1 : Elem I) -> x i1)) -> Proof (Eq (addOrderOf x2) (InfSet__sInf (Set__ofPred (n => and (Gt n 0) (forall I (i => divide (addOrderOf (x2 i)) n)))))).

