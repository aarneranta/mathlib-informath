(; //LEAN:QuotientGroup.mulEquivPiModRangePowMonoidHom._proof_5 ;)
QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_5 : (I : Set) -> (A : (Elem I -> Set)) -> (_ : Proof ((i1 : Elem I) -> CommGroup (A i1))) -> (n : Elem Nat) -> Proof (Eqt (Subgroup ((i : Elem I) -> A i)) (MonoidHom__range (powMonoidHom n)) (MonoidHom__ker (MonoidHom__mk (OneHom__mk (x1 => x2 => QuotientGroup__mk (x1 x2)) (QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_1 A n)) (x3 => y => QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_2 A n x3 y)))).

(; //LEAN:QuotientGroup.mulEquivPiModRangePowMonoidHom._proof_7 ;)
QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_7 : (I : Set) -> (A : (Elem I -> Set)) -> (_ : Proof ((i10 : Elem I) -> CommGroup (A i10))) -> (n : Elem Nat) -> (y : ((i9 : Elem I) -> HasQuotient__Quotient (A i9) (MonoidHom__range (powMonoidHom n)))) -> Proof (exists ((i8 : Elem I) -> A i8) (a => Eqt ((i : Elem I) -> HasQuotient__Quotient (A i) (MonoidHom__range (powMonoidHom n))) (MonoidHom__mk__app (OneHom__mk (x5 => x6 => QuotientGroup__mk (x5 x6)) (QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_1 A n)) (x7 => y2 => QuotientGroup__mulEquivPiModRangePowMonoidHom___proof_2 A n x7 y2) a) y)).

(; //LEAN:QuotientGroup.prodEquiv._proof_10 ;)
QuotientGroup__prodEquiv___proof_10 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (A : Elem (Subgroup G)) -> (B : Elem (Subgroup H)) -> (x2 : Elem G) -> (x3 : Elem H) -> (x4 : Elem G) -> (x5 : Elem H) -> (h : Proof (Setoid__r x2 x4)) -> (h1 : Proof (Setoid__r x3 x5)) -> Proof (Eqt (HasQuotient__Quotient (Prod G H) (Subgroup__prod A B)) (QuotientGroup__mk (Prod__mk x2 x3)) (QuotientGroup__mk (Prod__mk x4 x5))).

(; //LEAN:QuotientGroup.prodEquiv._proof_8 ;)
QuotientGroup__prodEquiv___proof_8 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (A : Elem (Subgroup G)) -> (B : Elem (Subgroup H)) -> (a : Elem (Prod G H)) -> (b : Elem (Prod G H)) -> (h : Proof (Setoid__r a b)) -> Proof (Eqt (Prod (HasQuotient__Quotient G A) (HasQuotient__Quotient H B)) (QuotientGroup__prodEquiv__match_1 (x2 => Prod (HasQuotient__Quotient G A) (HasQuotient__Quotient H B)) a (g => h1 => Prod__mk (QuotientGroup__mk g) (QuotientGroup__mk h1))) (QuotientGroup__prodEquiv__match_1 (x3 => Prod (HasQuotient__Quotient G A) (HasQuotient__Quotient H B)) b (g1 => h2 => Prod__mk (QuotientGroup__mk g1) (QuotientGroup__mk h2)))).

(; //LEAN:QuotientGroup.prodEquiv.match_1 ;)
QuotientGroup__prodEquiv__match_1 : (motive : (Elem (Prod G H) -> Set)) -> (x : Elem (Prod G H)) -> (h_1 : ((g : Elem G) -> (h : Elem H) -> motive (Prod__mk g h))) -> Elem (motive x).

(; //LEAN:QuotientGroup.prodMulEquiv._proof_1 ;)
QuotientGroup__prodMulEquiv___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (A : Elem (Subgroup G)) -> (B : Elem (Subgroup H)) -> (_ : Proof (Subgroup__Normal A)) -> (_ : Proof (Subgroup__Normal B)) -> (x2 : Elem (HasQuotient__Quotient (Prod G H) (Subgroup__prod A B))) -> (x3 : Elem (HasQuotient__Quotient (Prod G H) (Subgroup__prod A B))) -> Proof (Eqt (Prod (HasQuotient__Quotient G A) (HasQuotient__Quotient H B)) (Equiv__toFun (QuotientGroup__prodEquiv A B) (times x2 x3)) (times (Equiv__toFun (QuotientGroup__prodEquiv A B) x2) (Equiv__toFun (QuotientGroup__prodEquiv A B) x3))).

(; //LEAN:QuotientGroup.quotientBot._proof_1 ;)
QuotientGroup__quotientBot___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (_x : Elem G) -> Proof (Eqt G (MonoidHom__id__app G (id _x)) (MonoidHom__id__app G (id _x))).

(; //LEAN:QuotientGroup.quotientInfEquivProdNormalizerQuotient._proof_1 ;)
QuotientGroup__quotientInfEquivProdNormalizerQuotient___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (N : Elem (Subgroup G)) -> Proof (Leq H (Max__max H N)).

(; //LEAN:QuotientGroup.quotientInfEquivProdNormalizerQuotient._proof_2 ;)
QuotientGroup__quotientInfEquivProdNormalizerQuotient___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (N : Elem (Subgroup G)) -> (hLE : Proof (Leq H (Subgroup__normalizer N))) -> Proof (Eqt (Subgroup (Subtype (x1 => Membership__mem H x1))) (Subgroup__subgroupOf N H) (MonoidHom__ker (MonoidHom__comp (QuotientGroup__mk' (Subgroup__subgroupOf N (Max__max H N))) (Subgroup__inclusion le_sup_left)))).

(; //LEAN:QuotientGroup.quotientInfEquivProdNormalizerQuotient._proof_3 ;)
QuotientGroup__quotientInfEquivProdNormalizerQuotient___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (N : Elem (Subgroup G)) -> (hLE : Proof (Leq H (Subgroup__normalizer N))) -> (x1 : Elem (HasQuotient__Quotient (Subtype (x10 => Membership__mem (Max__max H N) x10)) (Subgroup__subgroupOf N (Max__max H N)))) -> Proof (exists (Subtype (x9 => Membership__mem H x9)) (a => Eqt (HasQuotient__Quotient (Subtype (x2 => Membership__mem (Max__max H N) x2)) (Subgroup__subgroupOf N (Max__max H N))) (MonoidHom__comp__app (QuotientGroup__mk' (Subgroup__subgroupOf N (Max__max H N))) (Subgroup__inclusion (QuotientGroup__quotientInfEquivProdNormalizerQuotient___proof_1 H N)) a) x1)).

(; //LEAN:QuotientGroup.quotientKerEquivOfRightInverse._proof_2 ;)
QuotientGroup__quotientKerEquivOfRightInverse___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (x3 : (Elem H -> G)) -> (h : Proof (Function__RightInverse x3 x2)) -> (x4 : Elem (HasQuotient__Quotient G (MonoidHom__ker x2))) -> Proof (Eqt (HasQuotient__Quotient G (MonoidHom__ker x2)) (Function__comp QuotientGroup__mk x3 (QuotientGroup__kerLift__app x2 x4)) x4).

(; //LEAN:QuotientGroup.quotientKerEquivOfRightInverse._proof_3 ;)
QuotientGroup__quotientKerEquivOfRightInverse___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (x3 : Elem (HasQuotient__Quotient G (MonoidHom__ker x2))) -> (y : Elem (HasQuotient__Quotient G (MonoidHom__ker x2))) -> Proof (Eqt H (OneHom__toFun (MonoidHom__toOneHom (QuotientGroup__kerLift x2)) (times x3 y)) (times (OneHom__toFun (MonoidHom__toOneHom (QuotientGroup__kerLift x2)) x3) (OneHom__toFun (MonoidHom__toOneHom (QuotientGroup__kerLift x2)) y))).

(; //LEAN:QuotientGroup.quotientKerEquivOfSurjective._proof_1 ;)
QuotientGroup__quotientKerEquivOfSurjective___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (h : Proof (Function__Surjective x2)) -> Proof (Function__HasRightInverse x2).

(; //LEAN:QuotientGroup.quotientKerEquivOfSurjective._proof_2 ;)
QuotientGroup__quotientKerEquivOfSurjective___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (h : Proof (Function__Surjective x2)) -> Proof (Function__RightInverse (Exists__choose (QuotientGroup__quotientKerEquivOfSurjective___proof_1 x2 h)) x2).

(; //LEAN:QuotientGroup.quotientKerEquivRange._proof_2 ;)
QuotientGroup__quotientKerEquivRange___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> Proof (and (Function__Injective (QuotientGroup__rangeKerLift x2)) (Function__Surjective (QuotientGroup__rangeKerLift x2))).

(; //LEAN:QuotientGroup.quotientMapSubgroupOfOfLe._proof_1 ;)
QuotientGroup__quotientMapSubgroupOfOfLe___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (A' : Elem (Subgroup G)) -> (A : Elem (Subgroup G)) -> (B' : Elem (Subgroup G)) -> (h' : Proof (Leq A' B')) -> Proof (Leq (Subgroup__comap (Subgroup__subtype A) A') (Subgroup__comap (Subgroup__subtype A) B')).

(; //LEAN:QuotientGroup.quotientMulEquivOfEq._proof_1 ;)
QuotientGroup__quotientMulEquivOfEq___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (M : Elem (Subgroup G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal M)) -> (_ : Proof (Subgroup__Normal N)) -> (h2 : Proof (Eqt (Subgroup G) M N)) -> (q : Elem (HasQuotient__Quotient G M)) -> (r : Elem (HasQuotient__Quotient G M)) -> Proof (Eqt (HasQuotient__Quotient G N) (Equiv__toFun (Subgroup__quotientEquivOfEq h2) (times q r)) (times (Equiv__toFun (Subgroup__quotientEquivOfEq h2) q) (Equiv__toFun (Subgroup__quotientEquivOfEq h2) r))).

(; //LEAN:QuotientGroup.quotientQuotientEquivQuotient._proof_1 ;)
QuotientGroup__quotientQuotientEquivQuotient___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (M : Elem (Subgroup G)) -> Proof (Leq M (Subgroup__comap (QuotientGroup__mk' N) (Subgroup__map (QuotientGroup__mk' N) M))).

(; //LEAN:QuotientGroup.quotientQuotientEquivQuotient._proof_2 ;)
QuotientGroup__quotientQuotientEquivQuotient___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (M : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal M)) -> (h : Proof (Leq N M)) -> Proof (Eqt (MonoidHom (HasQuotient__Quotient (HasQuotient__Quotient G N) (Subgroup__map (QuotientGroup__mk' N) M)) (HasQuotient__Quotient (HasQuotient__Quotient G N) (Subgroup__map (QuotientGroup__mk' N) M))) (MonoidHom__comp (QuotientGroup__map M (Subgroup__map (QuotientGroup__mk' N) M) (QuotientGroup__mk' N) (Subgroup__le_comap_map (QuotientGroup__mk' N) M)) (QuotientGroup__quotientQuotientEquivQuotientAux N M h)) (MonoidHom__id (HasQuotient__Quotient (HasQuotient__Quotient G N) (Subgroup__map (QuotientGroup__mk' N) M)))).

(; //LEAN:QuotientGroup.quotientQuotientEquivQuotient._proof_3 ;)
QuotientGroup__quotientQuotientEquivQuotient___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (M : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal M)) -> (h : Proof (Leq N M)) -> Proof (Eqt (MonoidHom (HasQuotient__Quotient G M) (HasQuotient__Quotient G M)) (MonoidHom__comp (QuotientGroup__quotientQuotientEquivQuotientAux N M h) (QuotientGroup__map M (Subgroup__map (QuotientGroup__mk' N) M) (QuotientGroup__mk' N) (Subgroup__le_comap_map (QuotientGroup__mk' N) M))) (MonoidHom__id (HasQuotient__Quotient G M))).

(; //LEAN:QuotientGroup.quotientQuotientEquivQuotientAux._proof_1 ;)
QuotientGroup__quotientQuotientEquivQuotientAux___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (M : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal M)) -> (h : Proof (Leq N M)) -> Proof (Leq (Subgroup__map (QuotientGroup__mk' N) M) (MonoidHom__ker (QuotientGroup__map N M (MonoidHom__id G) h))).

(; //LEAN:QuotientGroup.rangeKerLift._proof_3 ;)
QuotientGroup__rangeKerLift___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (g : Elem G) -> (hg : Proof (Membership__mem (MonoidHom__ker x2) g)) -> Proof (Eqt (Subtype (x3 => Membership__mem (MonoidHom__range x2) x3)) (MonoidHom__rangeRestrict__app x2 g) 1).

(; doc: Given a subgroup `s`, the function that sends a subgroup `t` to the pair consisting of its intersection with `s` and its image in the quotient `α ⧸ s` is strictly monotone, even though it is not injective in general. ;)
(; //LEAN:QuotientGroup.strictMono_comap_prod_image ;)
QuotientGroup__strictMono_comap_prod_image : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> Proof (StrictMono (t => Prod__mk (Subgroup__comap (Subgroup__subtype s) t) (Set__image QuotientGroup__mk t))).

(; //LEAN:RelIso.mk ;)
RelIso__mk : (toEquiv : Elem (Equiv X Y)) -> (map_rel_iff' : Proof (forall X (a => forall X (b => iff (s (toEquiv a) (toEquiv b)) (r a b))))) -> Elem (RelIso r s).

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (s : Elem (powerset X)) -> Set.

(; doc: `Ici a` is the left-closed right-infinite interval $[a, ∞)$. ;)
(; //LEAN:Set.Ici ;)
Set__Ici : (b : Elem X) -> Elem (powerset X).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; doc: `x ≈ y` is the distinguished equivalence relation of a setoid. ;)
(; //LEAN:Setoid.r ;)
Setoid__r : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: A function `f` is strictly monotone if `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMono ;)
StrictMono : (f : (Elem X -> Y)) -> Prop.

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A subgroup is characteristic if it is fixed by all automorphisms. Several equivalent conditions are provided by lemmas of the form `Characteristic.iff...` ;)
(; //LEAN:Subgroup.Characteristic ;)
Subgroup__Characteristic : (H : Elem (Subgroup G)) -> Prop.

(; doc: A subgroup `H` is normal if whenever `n ∈ H`, then `g * n * g⁻¹ ∈ H` for every `g : G`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:Subgroup.Normal ;)
Subgroup__Normal : (H : Elem (Subgroup G)) -> Prop.

(; doc: The center of a group `G` is the set of elements that commute with everything in `G` ;)
(; //LEAN:Subgroup.center ;)
Subgroup__center : (G : Set) -> Elem (Subgroup G).

(; //LEAN:Subgroup.characteristic_iff_comap_eq ;)
Subgroup__characteristic_iff_comap_eq : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (iff (Subgroup__Characteristic H) (forall (MulEquiv G G) (x1 => Eqt (Subgroup G) (Subgroup__comap (MulEquiv__toMonoidHom x1) H) H))).

(; //LEAN:Subgroup.characteristic_iff_map_eq ;)
Subgroup__characteristic_iff_map_eq : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> Proof (iff (Subgroup__Characteristic H) (forall (MulEquiv G G) (x1 => Eqt (Subgroup G) (Subgroup__map (MulEquiv__toMonoidHom x1) H) H))).

(; doc: The preimage of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.comap ;)
Subgroup__comap : (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup N)) -> Elem (Subgroup G).

(; doc: The inclusion homomorphism from a subgroup `H` contained in `K` to `K`. ;)
(; //LEAN:Subgroup.inclusion ;)
Subgroup__inclusion : (h : Proof (Leq H K)) -> Elem (MonoidHom (Subtype (x1 => Membership__mem H x1)) (Subtype (x2 => Membership__mem K x2))).

(; //LEAN:Subgroup.le_normalizer_of_normal ;)
Subgroup__le_normalizer_of_normal : (G : Set) -> (_ : Proof (Group G)) -> (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal H)) -> Proof (Leq K (Subgroup__normalizer H)).

(; doc: The image of a subgroup along a monoid homomorphism is a subgroup. ;)
(; //LEAN:Subgroup.map ;)
Subgroup__map : (f : Elem (MonoidHom G N)) -> (H : Elem (Subgroup G)) -> Elem (Subgroup N).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g * S * g⁻¹ = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:Subgroup.normalizer ;)
Subgroup__normalizer : (S : Elem (powerset G)) -> Elem (Subgroup G).

(; doc: Pull a subgroup back to an opposite subgroup along `MulOpposite.unop` ;)
(; //LEAN:Subgroup.op ;)
Subgroup__op : (H : Elem (Subgroup G)) -> Elem (Subgroup (MulOpposite G)).

(; doc: Given `Subgroup`s `H`, `K` of groups `G`, `N` respectively, `H × K` as a subgroup of `G × N`. ;)
(; //LEAN:Subgroup.prod ;)
Subgroup__prod : (H : Elem (Subgroup G)) -> (K : Elem (Subgroup N)) -> Elem (Subgroup (Prod G N)).

(; doc: If two subgroups `M` and `N` of `G` are equal, their quotients are in bijection. ;)
(; //LEAN:Subgroup.quotientEquivOfEq ;)
Subgroup__quotientEquivOfEq : (h : Proof (Eqt (Subgroup X) s t)) -> Elem (Equiv (HasQuotient__Quotient X s) (HasQuotient__Quotient X t)).

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:Subgroup.subgroupOf ;)
Subgroup__subgroupOf : (H : Elem (Subgroup G)) -> (K : Elem (Subgroup G)) -> Elem (Subgroup (Subtype (x1 => Membership__mem K x1))).

(; doc: The natural group hom from a subgroup of group `G` to `G`. ;)
(; //LEAN:Subgroup.subtype ;)
Subgroup__subtype : (H : Elem (Subgroup G)) -> Elem (MonoidHom (Subtype (x1 => Membership__mem H x1)) G).

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: **Alias** of `congrArg`. ;)
(; //LEAN:congr_arg ;)
congr_arg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:inv_mul_cancel ;)
inv_mul_cancel : (G : Set) -> (_ : Proof (Group G)) -> (a : Elem G) -> Proof (Eqt G (times (Inv__inv a) a) 1).

(; //LEAN:inv_one ;)
inv_one : (G : Set) -> (_ : Proof (InvOneClass G)) -> Proof (Eqt G (Inv__inv 1) 1).

(; //LEAN:map_prod ;)
map_prod : (I : Set) -> (M : Set) -> (N : Set) -> (_ : Proof (CommMonoid M)) -> (_ : Proof (CommMonoid N)) -> (G : Set) -> (g : Elem G) -> (f : (Elem I -> M)) -> (s : Elem (Finset I)) -> Proof (Eqt N (g (Finset__prod s (x3 => f x3))) (Finset__prod s (x4 => g (f x4)))).

(; doc: Multiplication by a natural `n` on a commutative additive monoid, considered as a morphism of additive monoids. ;)
(; //LEAN:nsmulAddMonoidHom ;)
nsmulAddMonoidHom : (n : Elem Nat) -> Elem (AddMonoidHom X X).

(; //LEAN:one_mul ;)
one_mul : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times 1 a) a).

(; doc: The `n`th power map on a commutative monoid for a natural `n`, considered as a morphism of monoids. ;)
(; //LEAN:powMonoidHom ;)
powMonoidHom : (n : Elem Nat) -> Elem (MonoidHom X X).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:top_unique ;)
top_unique : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> (h : Proof (Leq Top__top a)) -> Proof (Eqt X a Top__top).

(; doc: The `n`-th power map (for an integer `n`) on a commutative group, considered as a group homomorphism. ;)
(; //LEAN:zpowGroupHom ;)
zpowGroupHom : (n : Elem Int) -> Elem (MonoidHom X X).

(; doc: Multiplication by an integer `n` on a commutative additive group, considered as an additive group homomorphism. ;)
(; //LEAN:zsmulAddGroupHom ;)
zsmulAddGroupHom : (n : Elem Int) -> Elem (AddMonoidHom X X).

