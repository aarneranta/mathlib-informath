QuotientGroup__equivQuotientZPowOfEquiv___proof_3 : (A : Set) -> (B : Set) -> (_ : Proof (CommGroup A)) -> (_ : Proof (CommGroup B)) -> (e : Elem (MulEquiv A B)) -> (n : Elem Int) -> Proof (Eqt (MonoidHom (HasQuotient__Quotient A (MonoidHom__range (zpowGroupHom n))) (HasQuotient__Quotient A (MonoidHom__range (zpowGroupHom n)))) (MonoidHom__comp (QuotientGroup__homQuotientZPowOfHom (MonoidHom__ofClass (MulEquiv__symm e)) n) (QuotientGroup__homQuotientZPowOfHom (MonoidHom__ofClass e) n)) (MonoidHom__id (HasQuotient__Quotient A (MonoidHom__range (zpowGroupHom n))))).

