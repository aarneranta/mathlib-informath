QuotientGroup__eq : (X : Set) -> (_ : Proof (Group X)) -> (s : Elem (Subgroup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt (HasQuotient__Quotient X s) (QuotientGroup__mk a) (QuotientGroup__mk b)) (Membership__mem s (times (Inv__inv a) b))).

