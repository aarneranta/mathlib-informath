QuotientGroup__equivQuotientSubgroupOfOfEq___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (A' : Elem (Subgroup G)) -> (A : Elem (Subgroup G)) -> (B' : Elem (Subgroup G)) -> (B : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal (Subgroup__subgroupOf A' A))) -> (_ : Proof (Subgroup__Normal (Subgroup__subgroupOf B' B))) -> (h' : Proof (Eqt (Subgroup G) A' B')) -> (h : Proof (Eqt (Subgroup G) A B)) -> Proof (Eqt (MonoidHom (HasQuotient__Quotient (Subtype (x1 => Membership__mem A x1)) (Subgroup__subgroupOf A' A)) (HasQuotient__Quotient (Subtype (x2 => Membership__mem A x2)) (Subgroup__subgroupOf A' A))) (MonoidHom__comp (QuotientGroup__quotientMapSubgroupOfOfLe (Eq__ge h') (Eq__ge h)) (QuotientGroup__quotientMapSubgroupOfOfLe (Eq__le h') (Eq__le h))) (MonoidHom__id (HasQuotient__Quotient (Subtype (x3 => Membership__mem A x3)) (Subgroup__subgroupOf A' A)))).

(; //LEAN:QuotientGroup.equivQuotientSubgroupOfOfEq._proof_2 ;)
QuotientGroup__equivQuotientSubgroupOfOfEq___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (A' : Elem (Subgroup G)) -> (A : Elem (Subgroup G)) -> (B' : Elem (Subgroup G)) -> (B : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal (Subgroup__subgroupOf A' A))) -> (_ : Proof (Subgroup__Normal (Subgroup__subgroupOf B' B))) -> (h' : Proof (Eqt (Subgroup G) A' B')) -> (h : Proof (Eqt (Subgroup G) A B)) -> Proof (Eqt (MonoidHom (HasQuotient__Quotient (Subtype (x1 => Membership__mem B x1)) (Subgroup__subgroupOf B' B)) (HasQuotient__Quotient (Subtype (x2 => Membership__mem B x2)) (Subgroup__subgroupOf B' B))) (MonoidHom__comp (QuotientGroup__quotientMapSubgroupOfOfLe (Eq__le h') (Eq__le h)) (QuotientGroup__quotientMapSubgroupOfOfLe (Eq__ge h') (Eq__ge h))) (MonoidHom__id (HasQuotient__Quotient (Subtype (x3 => Membership__mem B x3)) (Subgroup__subgroupOf B' B)))).

