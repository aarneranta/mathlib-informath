QuotientGroup__comapMk'OrderIso___proof_1 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (H' : Elem (Subgroup (HasQuotient__Quotient G N))) -> Proof (Eqt (Subgroup (HasQuotient__Quotient G N)) (Subgroup__map (QuotientGroup__mk' N) (Subgroup__comap (QuotientGroup__mk' N) H')) H').

(; //LEAN:QuotientGroup.comapMk'OrderIso._proof_5 ;)
QuotientGroup__comapMk'OrderIso___proof_5 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (x1 : Elem (Set__Elem (Set__Ici N))) -> Proof (Eqt (Set__Elem (Set__Ici N)) (Subgroup__comap (QuotientGroup__mk' N) (Subgroup__map (QuotientGroup__mk' N) x1)) x1).

