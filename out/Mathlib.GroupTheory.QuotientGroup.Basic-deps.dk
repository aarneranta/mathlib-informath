QuotientGroup__equivQuotientSubgroupOfOfEq___proof_3 : (G : Set) -> (_ : Proof (Group G)) -> (A' : Elem (Subgroup G)) -> (B' : Elem (Subgroup G)) -> (h' : Proof (Eqt (Subgroup G) A' B')) -> Proof (Leq A' B').

