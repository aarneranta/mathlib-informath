Subgroup__inclusion__app : (a1 : Proof (Leq A B)) -> (a2 : Elem (Subtype G (x10 => Membership__mem G (Subgroup G) A x10))) -> Elem (Subtype G (x11 => Membership__mem G (Subgroup G) B x11)).

(; a constant applied as a function: DFunLike.coe ;)
Subtype__val__app : (a1 : Elem (Subtype (MonoidHom G A) (x2 => Membership__mem (MonoidHom G A) (Subgroup (MonoidHom G A)) (MonoidHom__ker (MonoidHom G A) (MonoidHom (Subtype G (x3 => Membership__mem G (Subgroup G) H x3)) A) (MonoidHom__domRestrictHom G (Subgroup G) H A)) x2))) -> (a2 : Elem G) -> Elem A.

(; doc: An additive commutative group is an additive group with commutative `(+)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:AddCommGroup ;)
AddCommGroup : (G : Set) -> Prop.

(; doc: `AddEquiv α β` is the type of an equiv `α ≃ β` which preserves addition. ;)
(; //LEAN:AddEquiv ;)
AddEquiv : (A : Set) -> (B : Set) -> Set.

(; //LEAN:AddEquiv.mk ;)
AddEquiv__mk : (A : Set) -> (B : Set) -> (toEquiv : Elem (Equiv A B)) -> (map_add' : Proof (forall A (x2 => forall A (y => Eqt B (Equiv__toFun A B toEquiv (plus x2 y)) (plus (Equiv__toFun A B toEquiv x2) (Equiv__toFun A B toEquiv y)))))) -> Elem (AddEquiv A B).

(; doc: A bijective `AddSemigroup` homomorphism is an isomorphism ;)
(; //LEAN:AddEquiv.ofBijective ;)
AddEquiv__ofBijective : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (hf : Proof (Function__Bijective M N f)) -> Elem (AddEquiv M N).

(; doc: The identity map is an additive isomorphism. ;)
(; //LEAN:AddEquiv.refl ;)
AddEquiv__refl : (M : Set) -> Elem (AddEquiv M M).

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:AddEquiv.symm ;)
AddEquiv__symm : (M : Set) -> (N : Set) -> (h : Elem (AddEquiv M N)) -> Elem (AddEquiv N M).

(; doc: Extract the forward direction of an additive equivalence as an addition-preserving function. ;)
(; //LEAN:AddEquiv.toAddMonoidHom ;)
AddEquiv__toAddMonoidHom : (M : Set) -> (N : Set) -> (h : Elem (AddEquiv M N)) -> Elem (AddMonoidHom M N).

(; doc: Transitivity of addition-preserving isomorphisms ;)
(; //LEAN:AddEquiv.trans ;)
AddEquiv__trans : (M : Set) -> (N : Set) -> (P : Set) -> (h1 : Elem (AddEquiv M N)) -> (h2 : Elem (AddEquiv N P)) -> Elem (AddEquiv M P).

(; doc: An `AddGroup` is an `AddMonoid` with a unary `-` satisfying `-a + a = 0`.  There is also a binary operation `-` such that `a - b = a + -b`, with a default so that `a - b = a + -b` holds by definition.  Use `AddGroup.ofLeftAxioms` or `AddGroup.ofRightAxioms` to define an additive group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:AddGroup ;)
AddGroup : (A : Set) -> Prop.

(; doc: `M →+ N` is the type of functions `M → N` that preserve the `AddZero` structure.  `AddMonoidHom` is also used for group homomorphisms.  When possible, instead of parametrizing results over `(f : M →+ N)`, you should parametrize over `(F : Type*) [AddMonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `AddMonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:AddMonoidHom ;)
AddMonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of additive monoid morphisms as an additive monoid morphism. ;)
(; //LEAN:AddMonoidHom.comp ;)
AddMonoidHom__comp : (M : Set) -> (N : Set) -> (P : Set) -> (hnp : Elem (AddMonoidHom N P)) -> (hmn : Elem (AddMonoidHom M N)) -> Elem (AddMonoidHom M P).

(; doc: A version of `AddMonoidHom.domRestrict` as a homomorphism. ;)
(; //LEAN:AddMonoidHom.domRestrictHom ;)
AddMonoidHom__domRestrictHom : (M : Set) -> (S : Set) -> (M' : Elem S) -> (A : Set) -> Elem (AddMonoidHom (AddMonoidHom M A) (AddMonoidHom (Subtype M (x3 => Membership__mem M S M' x3)) A)).

(; //LEAN:AddMonoidHom.ext ;)
AddMonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (AddZero M)) -> (_ : Proof (AddZero N)) -> (f : Elem (AddMonoidHom M N)) -> (g : Elem (AddMonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (AddMonoidHom M N) f g).

(; doc: The identity map from an additive monoid to itself. ;)
(; //LEAN:AddMonoidHom.id ;)
AddMonoidHom__id : (M : Set) -> Elem (AddMonoidHom M M).

(; doc: The additive kernel of an `AddMonoid` homomorphism is the `AddSubgroup` of elements such that `f x = 0` ;)
(; //LEAN:AddMonoidHom.ker ;)
AddMonoidHom__ker : (G : Set) -> (M : Set) -> (f : Elem (AddMonoidHom G M)) -> Elem (AddSubgroup G).

(; doc: If `f` is an additive monoid homomorphism then `f (a + b) = f a + f b`. ;)
(; //LEAN:AddMonoidHom.map_add ;)
AddMonoidHom__map_add : (M : Set) -> (N : Set) -> (_ : Proof (AddZero M)) -> (_ : Proof (AddZero N)) -> (f : Elem (AddMonoidHom M N)) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt N (f (plus a b)) (plus (f a) (f b))).

(; doc: Additive group homomorphisms preserve negation. ;)
(; //LEAN:AddMonoidHom.map_neg ;)
AddMonoidHom__map_neg : (X : Set) -> (Y : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (SubtractionMonoid Y)) -> (f : Elem (AddMonoidHom X Y)) -> (a : Elem X) -> Proof (Eqt Y (f (Neg__neg X a)) (Neg__neg Y (f a))).

(; //LEAN:AddMonoidHom.mem_ker ;)
AddMonoidHom__mem_ker : (G : Set) -> (_ : Proof (AddGroup G)) -> (M : Set) -> (_ : Proof (AddZeroClass M)) -> (f : Elem (AddMonoidHom G M)) -> (x2 : Elem G) -> Proof (iff (Membership__mem G (AddSubgroup G) (AddMonoidHom__ker G M f) x2) (Eqt M (f x2) 0)).

(; //LEAN:AddMonoidHom.mk ;)
AddMonoidHom__mk : (M : Set) -> (N : Set) -> (toZeroHom : Elem (ZeroHom M N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (ZeroHom__toFun M N toZeroHom (plus x2 y)) (plus (ZeroHom__toFun M N toZeroHom x2) (ZeroHom__toFun M N toZeroHom y)))))) -> Elem (AddMonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `AddMonoidHomClass F M N` into an actual `AddMonoidHom`. This is declared as the default coercion from `F` to `M →+ N`. ;)
(; //LEAN:AddMonoidHom.ofClass ;)
AddMonoidHom__ofClass : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> Elem (AddMonoidHom M N).

(; doc: The range of an `AddMonoidHom` from an `AddGroup` is an `AddSubgroup`. ;)
(; //LEAN:AddMonoidHom.range ;)
AddMonoidHom__range : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> Elem (AddSubgroup N).

(; doc: The canonical surjective `AddGroup` homomorphism `G →+ f(G)` induced by a group homomorphism `G →+ N`. ;)
(; //LEAN:AddMonoidHom.rangeRestrict ;)
AddMonoidHom__rangeRestrict : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> Elem (AddMonoidHom G (Subtype N (x2 => Membership__mem N (AddSubgroup N) (AddMonoidHom__range G N f) x2))).

(; doc: Given a pair of additive monoid homomorphisms `f`, `g` such that `g.comp f = id` and `f.comp g = id`, returns an additive equivalence with `toFun = f` and `invFun = g`.  This constructor is useful if the underlying type(s) have specialized `ext` lemmas for additive monoid homomorphisms. ;)
(; //LEAN:AddMonoidHom.toAddEquiv ;)
AddMonoidHom__toAddEquiv : (M : Set) -> (N : Set) -> (f : Elem (AddMonoidHom M N)) -> (g : Elem (AddMonoidHom N M)) -> (h : Proof (Eqt (AddMonoidHom M M) (AddMonoidHom__comp M N M g f) (AddMonoidHom__id M))) -> (h1 : Proof (Eqt (AddMonoidHom N N) (AddMonoidHom__comp N M N f g) (AddMonoidHom__id N))) -> Elem (AddEquiv M N).

(; doc: Additive opposite of a type. This type inherits all multiplicative structures on `α` and reverses left and right in addition. ;)
(; //LEAN:AddOpposite ;)
AddOpposite : (X : Set) -> Set.

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: An `AddSubgroup` is characteristic if it is fixed by all automorphisms. Several equivalent conditions are provided by lemmas of the form `Characteristic.iff...` ;)
(; //LEAN:AddSubgroup.Characteristic ;)
AddSubgroup__Characteristic : (A : Set) -> (H : Elem (AddSubgroup A)) -> Prop.

(; doc: An AddSubgroup `H` is normal if whenever `n ∈ H`, then `g + n - g ∈ H` for every `g : A`  [Wikidata Q743179](https://www.wikidata.org/wiki/Q743179) ;)
(; //LEAN:AddSubgroup.Normal ;)
AddSubgroup__Normal : (A : Set) -> (H : Elem (AddSubgroup A)) -> Prop.

(; doc: For any subgroups `H` and `K`, view `H ⊓ K` as a subgroup of `K`. ;)
(; //LEAN:AddSubgroup.addSubgroupOf ;)
AddSubgroup__addSubgroupOf : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> Elem (AddSubgroup (Subtype G (x1 => Membership__mem G (AddSubgroup G) K x1))).

(; doc: The center of an additive group `G` is the set of elements that commute with everything in `G` ;)
(; //LEAN:AddSubgroup.center ;)
AddSubgroup__center : (G : Set) -> Elem (AddSubgroup G).

(; //LEAN:AddSubgroup.characteristic_iff_comap_eq ;)
AddSubgroup__characteristic_iff_comap_eq : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (iff (AddSubgroup__Characteristic G H) (forall (AddEquiv G G) (x1 => Eqt (AddSubgroup G) (AddSubgroup__comap G G (AddEquiv__toAddMonoidHom G G x1) H) H))).

(; //LEAN:AddSubgroup.characteristic_iff_map_eq ;)
AddSubgroup__characteristic_iff_map_eq : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> Proof (iff (AddSubgroup__Characteristic G H) (forall (AddEquiv G G) (x1 => Eqt (AddSubgroup G) (AddSubgroup__map G G (AddEquiv__toAddMonoidHom G G x1) H) H))).

(; doc: The preimage of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.comap ;)
AddSubgroup__comap : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup N)) -> Elem (AddSubgroup G).

(; doc: The inclusion homomorphism from an additive subgroup `H` contained in `K` to `K`. ;)
(; //LEAN:AddSubgroup.inclusion ;)
AddSubgroup__inclusion : (G : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> (h : Proof (Leq H K)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) (Subtype G (x2 => Membership__mem G (AddSubgroup G) K x2))).

(; //LEAN:AddSubgroup.le_normalizer_of_normal ;)
AddSubgroup__le_normalizer_of_normal : (G : Set) -> (_ : Proof (AddGroup G)) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup G)) -> (_ : Proof (AddSubgroup__Normal G H)) -> Proof (Leq K (AddSubgroup__normalizer G (SetLike__coe (AddSubgroup G) G H))).

(; doc: The image of an `AddSubgroup` along an `AddMonoid` homomorphism is an `AddSubgroup`. ;)
(; //LEAN:AddSubgroup.map ;)
AddSubgroup__map : (G : Set) -> (N : Set) -> (f : Elem (AddMonoidHom G N)) -> (H : Elem (AddSubgroup G)) -> Elem (AddSubgroup N).

(; doc: The `normalizer` of `S` is the subgroup of `G` whose elements satisfy `g + S - g = S`. When `S` is a subgroup, this is the largest subgroup of `G` inside which `S` is normal. ;)
(; //LEAN:AddSubgroup.normalizer ;)
AddSubgroup__normalizer : (G : Set) -> (S : Elem (powerset G)) -> Elem (AddSubgroup G).

(; doc: Pull an additive subgroup back to an opposite additive subgroup along `AddOpposite.unop` ;)
(; //LEAN:AddSubgroup.op ;)
AddSubgroup__op : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem (AddSubgroup (AddOpposite G)).

(; doc: Given `AddSubgroup`s `H`, `K` of `AddGroup`s `A`, `B` respectively, `H × K` as an `AddSubgroup` of `A × B`. ;)
(; //LEAN:AddSubgroup.prod ;)
AddSubgroup__prod : (G : Set) -> (N : Set) -> (H : Elem (AddSubgroup G)) -> (K : Elem (AddSubgroup N)) -> Elem (AddSubgroup (Prod G N)).

(; doc: If two subgroups `M` and `N` of `G` are equal, their quotients are in bijection. ;)
(; //LEAN:AddSubgroup.quotientEquivOfEq ;)
AddSubgroup__quotientEquivOfEq : (X : Set) -> (s : Elem (AddSubgroup X)) -> (t : Elem (AddSubgroup X)) -> (h : Proof (Eqt (AddSubgroup X) s t)) -> Elem (Equiv (HasQuotient__Quotient X (AddSubgroup X) s) (HasQuotient__Quotient X (AddSubgroup X) t)).

(; doc: The natural group hom from an `AddSubgroup` of `AddGroup` `G` to `G`. ;)
(; //LEAN:AddSubgroup.subtype ;)
AddSubgroup__subtype : (G : Set) -> (H : Elem (AddSubgroup G)) -> Elem (AddMonoidHom (Subtype G (x1 => Membership__mem G (AddSubgroup G) H x1)) G).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : (X : Set) -> Elem X.

(; doc: A commutative group is a group with commutative `(*)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:CommGroup ;)
CommGroup : (G : Set) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: Extract an element from an existential statement, using `Classical.choose`. ;)
(; //LEAN:Exists.choose ;)
Exists__choose : (X : Set) -> (p : (Elem X -> Prop)) -> (P : Proof (exists X (a => p a))) -> Elem X.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: `RightInverse g f` means that `g` is a right inverse to `f`. That is, `f ∘ g = id`. ;)
(; //LEAN:Function.RightInverse ;)
Function__RightInverse : (X : Set) -> (Y : Set) -> (g : (Elem Y -> X)) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: Function composition, usually written with the infix operator `∘`. A new function is created from two existing functions, where one function's output is used as input to the other.  Examples:  * `Function.comp List.reverse (List.drop 2) [3, 2, 4, 1] = [1, 4]`  * `(List.reverse ∘ List.drop 2) [3, 2, 4, 1] = [1, 4]`  Conventions for notations in identifiers:   * The recommended spelling of `∘` in identifiers is `comp`. ;)
(; //LEAN:Function.comp ;)
Function__comp : (X : Set) -> (Y : Set) -> (W : Set) -> (f : (Elem Y -> W)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> Elem W.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `a +ᵥ b` computes the sum of `a` and `b`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `+ᵥ` in identifiers is `vadd`. ;)
(; //LEAN:HVAdd.hVAdd ;)
HVAdd__hVAdd : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: `HasQuotient.Quotient A b` (denoted as `A ⧸ b`) is the quotient of the type `A` by `b`. ;)
(; //LEAN:HasQuotient.Quotient ;)
HasQuotient__Quotient : (A : Set) -> (B : Set) -> (x : Elem B) -> Set.

(; doc: The canonical homomorphism `Int → R`. In most use cases, the target type will have a ring structure, and this homomorphism should be a ring homomorphism.  `IntCast` and `NatCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `IntCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus an `IntCast R` instance) whenever `R` is an additive group with a `1`. ;)
(; //LEAN:Int.cast ;)
Int__cast : (R : Set) -> (x1 : Elem Int) -> Elem R.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: `M →* N` is the type of functions `M → N` that preserve the `MulOne` structure. `MonoidHom` is used for both monoid and group homomorphisms.  When possible, instead of parametrizing results over `(f : M →* N)`, you should parametrize over `(F : Type*) [MonoidHomClass F M N] (f : F)`.  When you extend this structure, make sure to extend `MonoidHomClass`.  [Wikidata Q868169](https://www.wikidata.org/wiki/Q868169) ;)
(; //LEAN:MonoidHom ;)
MonoidHom : (M : Set) -> (N : Set) -> Set.

(; doc: Composition of monoid morphisms as a monoid morphism. ;)
(; //LEAN:MonoidHom.comp ;)
MonoidHom__comp : (M : Set) -> (N : Set) -> (P : Set) -> (hnp : Elem (MonoidHom N P)) -> (hmn : Elem (MonoidHom M N)) -> Elem (MonoidHom M P).

(; doc: A version of `MonoidHom.domRestrict` as a homomorphism. ;)
(; //LEAN:MonoidHom.domRestrictHom ;)
MonoidHom__domRestrictHom : (M : Set) -> (S : Set) -> (M' : Elem S) -> (A : Set) -> Elem (MonoidHom (MonoidHom M A) (MonoidHom (Subtype M (x3 => Membership__mem M S M' x3)) A)).

(; //LEAN:MonoidHom.ext ;)
MonoidHom__ext : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> (g : Elem (MonoidHom M N)) -> (h : Proof (forall M (x2 => Eqt N (f x2) (g x2)))) -> Proof (Eqt (MonoidHom M N) f g).

(; doc: The identity map from a monoid to itself. ;)
(; //LEAN:MonoidHom.id ;)
MonoidHom__id : (M : Set) -> Elem (MonoidHom M M).

(; doc: The multiplicative kernel of a monoid homomorphism is the subgroup of elements `x : G` such that `f x = 1` ;)
(; //LEAN:MonoidHom.ker ;)
MonoidHom__ker : (G : Set) -> (M : Set) -> (f : Elem (MonoidHom G M)) -> Elem (Subgroup G).

(; doc: Group homomorphisms preserve inverse. ;)
(; //LEAN:MonoidHom.map_inv ;)
MonoidHom__map_inv : (X : Set) -> (Y : Set) -> (_ : Proof (Group X)) -> (_ : Proof (DivisionMonoid Y)) -> (f : Elem (MonoidHom X Y)) -> (a : Elem X) -> Proof (Eqt Y (f (Inv__inv X a)) (Inv__inv Y (f a))).

(; doc: If `f` is a monoid homomorphism then `f (a * b) = f a * f b`. ;)
(; //LEAN:MonoidHom.map_mul ;)
MonoidHom__map_mul : (M : Set) -> (N : Set) -> (_ : Proof (MulOne M)) -> (_ : Proof (MulOne N)) -> (f : Elem (MonoidHom M N)) -> (a : Elem M) -> (b : Elem M) -> Proof (Eqt N (f (times a b)) (times (f a) (f b))).

(; //LEAN:MonoidHom.mem_ker ;)
MonoidHom__mem_ker : (G : Set) -> (_ : Proof (Group G)) -> (M : Set) -> (_ : Proof (MulOneClass M)) -> (f : Elem (MonoidHom G M)) -> (x2 : Elem G) -> Proof (iff (Membership__mem G (Subgroup G) (MonoidHom__ker G M f) x2) (Eqt M (f x2) 1)).

(; //LEAN:MonoidHom.mk ;)
MonoidHom__mk : (M : Set) -> (N : Set) -> (toOneHom : Elem (OneHom M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun M N toOneHom (times x2 y)) (times (OneHom__toFun M N toOneHom x2) (OneHom__toFun M N toOneHom y)))))) -> Elem (MonoidHom M N).

(; doc: Turn an element of a type `F` satisfying `MonoidHomClass F M N` into an actual `MonoidHom`. This is declared as the default coercion from `F` to `M →* N`. ;)
(; //LEAN:MonoidHom.ofClass ;)
MonoidHom__ofClass : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> Elem (MonoidHom M N).

(; doc: The range of a monoid homomorphism from a group is a subgroup. ;)
(; //LEAN:MonoidHom.range ;)
MonoidHom__range : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> Elem (Subgroup N).

(; doc: The canonical surjective group homomorphism `G →* f(G)` induced by a group homomorphism `G →* N`. ;)
(; //LEAN:MonoidHom.rangeRestrict ;)
MonoidHom__rangeRestrict : (G : Set) -> (N : Set) -> (f : Elem (MonoidHom G N)) -> Elem (MonoidHom G (Subtype N (x2 => Membership__mem N (Subgroup N) (MonoidHom__range G N f) x2))).

(; doc: Given a pair of monoid homomorphisms `f`, `g` such that `g.comp f = id` and `f.comp g = id`, returns a multiplicative equivalence with `toFun = f` and `invFun = g`.  This constructor is useful if the underlying type(s) have specialized `ext` lemmas for monoid homomorphisms. ;)
(; //LEAN:MonoidHom.toMulEquiv ;)
MonoidHom__toMulEquiv : (M : Set) -> (N : Set) -> (f : Elem (MonoidHom M N)) -> (g : Elem (MonoidHom N M)) -> (h : Proof (Eqt (MonoidHom M M) (MonoidHom__comp M N M g f) (MonoidHom__id M))) -> (h1 : Proof (Eqt (MonoidHom N N) (MonoidHom__comp N M N f g) (MonoidHom__id N))) -> Elem (MulEquiv M N).

(; doc: `MulEquiv α β` is the type of an equiv `α ≃ β` which preserves multiplication. ;)
(; //LEAN:MulEquiv ;)
MulEquiv : (M : Set) -> (N : Set) -> Set.

(; //LEAN:MulEquiv.mk ;)
MulEquiv__mk : (M : Set) -> (N : Set) -> (toEquiv : Elem (Equiv M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (Equiv__toFun M N toEquiv (times x2 y)) (times (Equiv__toFun M N toEquiv x2) (Equiv__toFun M N toEquiv y)))))) -> Elem (MulEquiv M N).

(; doc: A bijective `Semigroup` homomorphism is an isomorphism ;)
(; //LEAN:MulEquiv.ofBijective ;)
MulEquiv__ofBijective : (M : Set) -> (N : Set) -> (F : Set) -> (f : Elem F) -> (hf : Proof (Function__Bijective M N f)) -> Elem (MulEquiv M N).

(; doc: The identity map is a multiplicative isomorphism. ;)
(; //LEAN:MulEquiv.refl ;)
MulEquiv__refl : (M : Set) -> Elem (MulEquiv M M).

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:MulEquiv.symm ;)
MulEquiv__symm : (M : Set) -> (N : Set) -> (h : Elem (MulEquiv M N)) -> Elem (MulEquiv N M).

(; doc: Extract the forward direction of a multiplicative equivalence as a multiplication-preserving function. ;)
(; //LEAN:MulEquiv.toMonoidHom ;)
MulEquiv__toMonoidHom : (M : Set) -> (N : Set) -> (h : Elem (MulEquiv M N)) -> Elem (MonoidHom M N).

(; doc: Transitivity of multiplication-preserving isomorphisms ;)
(; //LEAN:MulEquiv.trans ;)
MulEquiv__trans : (M : Set) -> (N : Set) -> (P : Set) -> (h1 : Elem (MulEquiv M N)) -> (h2 : Elem (MulEquiv N P)) -> Elem (MulEquiv M P).

(; doc: Multiplicative opposite of a type. This type inherits all additive structures on `α` and reverses left and right in multiplication. ;)
(; //LEAN:MulOpposite ;)
MulOpposite : (X : Set) -> Set.

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: A unital but not-necessarily-associative ring. ;)
(; //LEAN:NonAssocRing ;)
NonAssocRing : (X : Set) -> Prop.

(; //LEAN:OneHom.mk ;)
OneHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_one' : Proof (Eqt N (toFun 1) 1)) -> Elem (OneHom M N).

(; doc: An order isomorphism is an equivalence such that `a ≤ b ↔ (f a) ≤ (f b)`. This definition is an abbreviation of `RelIso (≤) (≤)`. ;)
(; //LEAN:OrderIso ;)
OrderIso : (X : Set) -> (Y : Set) -> Set.

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: Places an element of a type into the quotient that equates terms according to the provided relation.  Given `v : α` and relation `r : α → α → Prop`, `Quot.mk r v : Quot r` is like `v`, except all observations of `v`'s value must respect `r`.  `Quot.mk` is a built-in primitive:  * `Quot` is the built-in quotient type.  * `Quot.lift` allows the definition of functions from the quotient to some other type.  * `Quot.sound` asserts the equality of elements related by `r`.  * `Quot.ind` is used to write proofs about quotients by assuming that all elements are constructed    with `Quot.mk`. ;)
(; //LEAN:Quot.mk ;)
Quot__mk : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (a : Elem X) -> Elem (Quot X r).

(; doc: Quotient types coarsen the propositional equality for a type so that terms related by some equivalence relation are considered equal. The equivalence relation is given by an instance of `Setoid`.  Set-theoretically, `Quotient s` can seen as the set of equivalence classes of `α` modulo the `Setoid` instance's relation `s.r`. Functions from `Quotient s` must prove that they respect `s.r`: to define a function `f : Quotient s → β`, it is necessary to provide `f' : α → β` and prove that for all `x : α` and `y : α`, `s.r x y → f' x = f' y`. `Quotient.lift` implements this operation.  The key quotient operators are:  * `Quotient.mk` places elements of the underlying type `α` into the quotient.  * `Quotient.lift` allows the definition of functions from the quotient to some other type.  * `Quotient.sound` asserts the equality of elements related by `r`  * `Quotient.ind` is used to write proofs about quotients by assuming that all elements are    constructed with `Quotient.mk`.  `Quotient` is built on top of the primitive quotient type `Quot`, which does not require a proof that the relation is an equivalence relation. `Quotient` should be used instead of `Quot` for relations that actually are equivalence relations. ;)
(; //LEAN:Quotient ;)
Quotient : (X : Set) -> (s : Proof (Setoid X)) -> Set.

(; doc: A version of `Quotient.inductionOn₂` taking `{s₁ : Setoid α} {s₂ : Setoid β}` as implicit arguments instead of instance arguments. ;)
(; //LEAN:Quotient.inductionOn₂' ;)
Quotient__inductionOn_u2082_' : (X : Set) -> (Y : Set) -> (x : Proof (Setoid X)) -> (x1 : Proof (Setoid Y)) -> (p : (Elem (Quotient X x) -> Elem (Quotient Y x1) -> Prop)) -> (x2 : Elem (Quotient X x)) -> (x3 : Elem (Quotient Y x1)) -> (h : Proof (forall X (x4 => forall Y (x5 => p (Quotient__mk'' X x x4) (Quotient__mk'' Y x1 x5))))) -> Proof (p x2 x3).

(; doc: A version of `Quotient.liftOn` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.liftOn' ;)
Quotient__liftOn' : (X : Set) -> (X1 : Set) -> (x : Proof (Setoid X)) -> (q : Elem (Quotient X x)) -> (f : (Elem X -> X1)) -> (h : Proof (forall X (a => forall X (b => if (Setoid__r X a b) (Eqt X1 (f a) (f b)))))) -> Elem X1.

(; doc: A version of `Quotient.liftOn₂` taking `{s₁ : Setoid α} {s₂ : Setoid β}` as implicit arguments instead of instance arguments. ;)
(; //LEAN:Quotient.liftOn₂' ;)
Quotient__liftOn_u2082_' : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Proof (Setoid X)) -> (x1 : Proof (Setoid Y)) -> (x2 : Elem (Quotient X x)) -> (x3 : Elem (Quotient Y x1)) -> (f : (Elem X -> Elem Y -> Z)) -> (h : Proof (forall X (x4 => forall Y (x5 => forall X (x6 => forall Y (x7 => if (Setoid__r X x4 x6) (if (Setoid__r Y x5 x7) (Eqt Z (f x4 x5) (f x6 x7))))))))) -> Elem Z.

(; doc: A version of `Quotient.mk` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.mk'' ;)
Quotient__mk'' : (X : Set) -> (x : Proof (Setoid X)) -> (a : Elem X) -> Elem (Quotient X x).

(; //LEAN:Quotient.sound' ;)
Quotient__sound' : (X : Set) -> (x : Proof (Setoid X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Setoid__r X a b)) -> Proof (Eqt (Quotient X x) (Quotient__mk'' X x a) (Quotient__mk'' X x b)).

