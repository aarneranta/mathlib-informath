(; //LEAN:QuotientGroup.liftEquiv ;)
QuotientGroup__liftEquiv : (N : Elem (Subgroup G)) -> (h : Proof (Function__Surjective x2)) -> (HN : Proof (Eqt (Subgroup G) N (MonoidHom__ker x2))) -> Elem (MulEquiv (HasQuotient__Quotient G N) H).

