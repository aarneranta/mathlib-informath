QuotientGroup__kerLift___proof_2 : (G : Set) -> (_ : Proof (Group G)) -> (H : Set) -> (_ : Proof (Group H)) -> (x2 : Elem (MonoidHom G H)) -> (_g : Elem G) -> (h : Proof (Membership__mem (MonoidHom__ker x2) _g)) -> Proof (Eqt H (x2 _g) 1).

(; doc: The equivalence relation corresponding to the partition of a group by left cosets of a subgroup. ;)
(; //LEAN:QuotientGroup.leftRel ;)
