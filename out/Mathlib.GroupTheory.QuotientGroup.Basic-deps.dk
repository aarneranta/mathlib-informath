QuotientAddGroup__prodEquiv__match_1 : (motive : (Elem (Prod G H) -> Set)) -> (x : Elem (Prod G H)) -> (h_1 : ((g : Elem G) -> (h : Elem H) -> motive (Prod__mk g h))) -> Elem (motive x).

