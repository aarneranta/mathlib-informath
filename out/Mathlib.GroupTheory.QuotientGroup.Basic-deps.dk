QuotientGroup__prodMulEquiv__app : (a1 : Elem (Subgroup G)) -> (a2 : Elem (Subgroup H)) -> (a3 : Elem (HasQuotient__Quotient (Prod G H) (Subgroup (Prod G H)) (Subgroup__prod G H A B))) -> Elem (Prod (HasQuotient__Quotient G (Subgroup G) A) (HasQuotient__Quotient H (Subgroup H) B)).

