QuotientGroup__comapMk'OrderIso___proof_6 : (G : Set) -> (_ : Proof (Group G)) -> (N : Elem (Subgroup G)) -> (_ : Proof (Subgroup__Normal N)) -> (x1 : Elem (Subgroup (HasQuotient__Quotient G N))) -> (x2 : Elem (Subgroup (HasQuotient__Quotient G N))) -> Proof (iff (Leq (Subgroup__comap (QuotientGroup__mk' N) x1) (Subgroup__comap (QuotientGroup__mk' N) x2)) (Leq x1 x2)).

(; doc: `QuotientGroup.congr` lifts the isomorphism `e : G ≃ H` to `G ⧸ G' ≃ H ⧸ H'`, given that `e` maps `G` to `H`. ;)
(; //LEAN:QuotientGroup.congr ;)
QuotientGroup__congr : (G' : Elem (Subgroup G)) -> (H' : Elem (Subgroup H)) -> (e : Elem (MulEquiv G H)) -> (he : Proof (Eqt (Subgroup H) (Subgroup__map (MonoidHom__ofClass e) G') H')) -> Elem (MulEquiv (HasQuotient__Quotient G G') (HasQuotient__Quotient H H')).

