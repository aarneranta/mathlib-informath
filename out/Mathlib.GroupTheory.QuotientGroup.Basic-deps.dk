QuotientGroup__quotientKerEquivOfRightInverse__app : (a1 : Elem (MonoidHom G H)) -> (a2 : (Elem H -> G)) -> (a3 : Proof (Function__RightInverse G H x3 x2)) -> (a4 : Elem (HasQuotient__Quotient G (Subgroup G) (MonoidHom__ker G H x2))) -> Elem H.

(; a constant applied as a function: DFunLike.coe ;)
QuotientGroup__quotientMapSubgroupOfOfLe__app : (a1 : Proof (Leq A' B')) -> (a2 : Proof (Leq A B)) -> (a3 : Elem (HasQuotient__Quotient (Subtype G (x4 => Membership__mem G (Subgroup G) A x4)) (Subgroup (Subtype G (x5 => Membership__mem G (Subgroup G) A x5))) (Subgroup__subgroupOf G A' A))) -> Elem (HasQuotient__Quotient (Subtype G (x6 => Membership__mem G (Subgroup G) B x6)) (Subgroup (Subtype G (x7 => Membership__mem G (Subgroup G) B x7))) (Subgroup__subgroupOf G B' B)).

(; a constant applied as a function: DFunLike.coe ;)
QuotientGroup__quotientMulEquivOfEq__app : (a1 : Proof (Eqt (Subgroup G) M N)) -> (a2 : Elem (HasQuotient__Quotient G (Subgroup G) M)) -> Elem (HasQuotient__Quotient G (Subgroup G) N).

