Finsupp__mapRange__linearEquiv__in_9 : (X : Set) -> (M : Set) -> (N : Set) -> (R : Set) -> (X1 : Set) -> (x3 : Elem (Module__on R M)) -> (x6 : Elem (RingHom R X1)) -> (x7 : Elem (RingHom X1 R)) -> (e : Elem (LinearEquiv R X1 x6 x7 M N)) -> Elem (LinearEquiv R X1 x6 x7 (Finsupp X M) (Finsupp X N)).

(; a constant with an instance argument that the statement gives ;)
Finsupp__module__in_6 : (X : Set) -> (M : Set) -> (R : Set) -> (x2 : Elem (Module__on R M)) -> Elem (Module__on R (Finsupp X M)).

(; a constant with an instance argument that the statement gives ;)
LinearEquiv__restrictScalars__in_10 : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (x5 : Elem (Module__on R X)) -> (f : Elem (LinearEquiv S S (RingHom__id S) (RingHom__id S) M X)) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M X).

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__symm__app : (a1 : Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M (Elem I -> R))) -> (a2 : (Elem I -> R)) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__trans__app : (a1 : Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M M')) -> (a2 : Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M' M'')) -> (a3 : Elem M) -> Elem M''.

(; a constant applied as a function: DFunLike.coe ;)
LinearMap__comp__app : (a1 : Elem (LinearMap R R (RingHom__id R) M' M')) -> (a2 : Elem (LinearMap R R (RingHom__id R) M M')) -> (a3 : Elem M) -> Elem M'.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__constr__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Set) -> (a3 : (Elem I -> M')) -> Elem (LinearMap R R (RingHom__id R) M M').

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__coord__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem I) -> (a3 : Elem M) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__equiv'__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (Module__Basis X R M')) -> (a3 : (Elem M -> M')) -> (a4 : (Elem M' -> M)) -> (a5 : Proof (forall I (i1 => Membership__mem M' (powerset M') (Set__range M' X b') (f (b i1))))) -> (a6 : Proof (forall X (i2 => Membership__mem M (powerset M) (Set__range M I b) (g (b' i2))))) -> (a7 : Proof (forall I (i3 => Eqt M (g (f (b i3))) (b i3)))) -> (a8 : Proof (forall X (i4 => Eqt M' (f (g (b' i4))) (b' i4)))) -> (a9 : Elem M) -> Elem M'.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__equivFun__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem M) -> (a3 : Elem I) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__equiv__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (Module__Basis X1 R M'')) -> (a3 : Elem (Equiv I X1)) -> (a4 : Elem M) -> Elem M''.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__mapCoeffs__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (RingEquiv R R')) -> (a3 : Proof (forall R (c => forall M (x5 => Eqt M (HSMul__hSMul R' M M (f c) x5) (HSMul__hSMul R M M c x5))))) -> (a4 : Elem I) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__map__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M M')) -> (a3 : Elem I) -> Elem M'.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__reindexFinsetRange__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (Subtype M (x6 => Membership__mem M (Finset M) (Finset__image I M b (Finset__univ I)) x6))) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__reindexRange__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (Set__Elem M (Set__range M I b))) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__reindex__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem (Equiv I X)) -> (a3 : Elem X) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__repr__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem M) -> Elem (Finsupp I R).

(; a constant applied as a function: DFunLike.coe ;)
Module__Basis__sumCoords__app : (a1 : Elem (Module__Basis I R M)) -> (a2 : Elem M) -> Elem R.

(; the structures of a class on its parameters ;)
Module__on : (R : Set) -> (M : Set) -> Set.

(; the structures of a class on its parameters ;)
Semiring__on : (X : Set) -> Set.

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; //LEAN:AddHom.mk ;)
AddHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (toFun (plus x2 y)) (plus (toFun x2) (toFun y)))))) -> Elem (AddHom M N).

(; doc: A commutative semiring is a semiring with commutative multiplication. ;)
(; //LEAN:CommSemiring ;)
CommSemiring : (R : Set) -> Prop.

(; doc: The coercion from `F` to a function. ;)
(; //LEAN:DFunLike.coe ;)
DFunLike__coe : (F : Set) -> (X : Set) -> (x : (Elem X -> Set)) -> (x1 : Elem F) -> (a : Elem X) -> Elem (x a).

(; //LEAN:DFunLike.ext ;)
DFunLike__ext : (F : Set) -> (X : Set) -> (x : (Elem X -> Set)) -> (f : Elem F) -> (g : Elem F) -> (h : Proof (forall X (x1 => Eqt (x x1) (f x1) (g x1)))) -> Proof (Eqt F f g).

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: `α ≃ β` is the type of functions from `α → β` with a two-sided inverse. ;)
(; //LEAN:Equiv ;)
Equiv : (X : Set) -> (Y : Set) -> Set.

(; //LEAN:Equiv.apply_symm_apply ;)
Equiv__apply_symm_apply : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> (x : Elem Y) -> Proof (Eqt Y (e (Equiv__symm__app e x)) x).

(; doc: The backward map of an equivalence.  Do NOT use `e.invFun` directly. Use the coercion of `e.symm` instead. ;)
(; //LEAN:Equiv.invFun ;)
Equiv__invFun : (X : Set) -> (Y : Set) -> (self : Elem (Equiv X Y)) -> (x : Elem Y) -> Elem X.

(; doc: If `f : α → β` is an injective function, then domain `α` is equivalent to the range of `f`. ;)
(; //LEAN:Equiv.ofInjective ;)
Equiv__ofInjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective X Y f)) -> Elem (Equiv X (Set__Elem Y (Set__range Y X f))).

(; doc: Any type is equivalent to itself. ;)
(; //LEAN:Equiv.refl ;)
Equiv__refl : (X : Set) -> Elem (Equiv X X).

(; doc: If `α` is equivalent to `β` and the predicates `p : α → Prop` and `q : β → Prop` are equivalent at corresponding points, then `{a // p a}` is equivalent to `{b // q b}`. For the statement where `α = β`, that is, `e : perm α`, see `Perm.subtypePerm`. ;)
(; //LEAN:Equiv.subtypeEquiv ;)
Equiv__subtypeEquiv : (X : Set) -> (Y : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem Y -> Prop)) -> (e : Elem (Equiv X Y)) -> (h : Proof (forall X (a1 => iff (p a1) (q (e a1))))) -> Elem (Equiv (Subtype X (a => p a)) (Subtype Y (b => q b))).

(; doc: Inverse of an equivalence `e : α ≃ β`. ;)
(; //LEAN:Equiv.symm ;)
Equiv__symm : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (Equiv Y X).

(; doc: Composition of equivalences `e₁ : α ≃ β` and `e₂ : β ≃ γ`. ;)
(; //LEAN:Equiv.trans ;)
Equiv__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem (Equiv X Y)) -> (x1 : Elem (Equiv Y Z)) -> Elem (Equiv X Z).

(; doc: A type is `Finite` if it is in bijective correspondence to some `Fin n`.  This is similar to `Fintype`, but `Finite` is a proposition rather than data. A particular benefit to this is that `Finite` instances are definitionally equal to one another (due to proof irrelevance) rather than being merely propositionally equal, and, furthermore, `Finite` instances generally avoid the need for `Decidable` instances. One other notable difference is that `Finite` allows there to be `Finite p` instances for all `p : Prop`, which is not allowed by `Fintype` due to universe constraints. An application of this is that `Finite (x ∈ s → β x)` follows from the general instance for pi types, assuming `[∀ x, Finite (β x)]`. Implementation note: this is a reason `Finite α` is not defined as `Nonempty (Fintype α)`.  Every `Fintype` instance provides a `Finite` instance via `Finite.of_fintype`. Conversely, one can noncomputably create a `Fintype` instance from a `Finite` instance via `Fintype.ofFinite`. In a proof one might write ```lean   have := Fintype.ofFinite α ``` to obtain such an instance.  Do not write noncomputable `Fintype` instances; instead write `Finite` instances and use this `Fintype.ofFinite` interface. The `Fintype` instances should be relied upon to be computable for evaluation purposes.  Theorems should use `Finite` instead of `Fintype`, unless definitions in the theorem statement require `Fintype`. Definitions should prefer `Finite` as well, unless it is important that the definitions are meant to be computable in the reduction or `#eval` sense. ;)
(; //LEAN:Finite ;)
Finite : (X : Set) -> Prop.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: `image f s` is the forward image of `s` under `f`. ;)
(; //LEAN:Finset.image ;)
Finset__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (Finset X)) -> Elem (Finset Y).

(; //LEAN:Finset.mem_image_of_mem ;)
Finset__mem_image_of_mem : (X : Set) -> (Y : Set) -> (s : Elem (Finset X)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (h : Proof (Membership__mem X (Finset X) s a)) -> Proof (Membership__mem Y (Finset Y) (Finset__image X Y f s) (f a)).

(; //LEAN:Finset.mem_univ ;)
Finset__mem_univ : (X : Set) -> (_ : Proof (Fintype X)) -> (x1 : Elem X) -> Proof (Membership__mem X (Finset X) (Finset__univ X) x1).

(; doc: `∑ x ∈ s, f x` is the sum of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∑ x, f x`, is a shorthand for `∑ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.sum ;)
Finset__sum : (I : Set) -> (M : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; doc: `univ` is the universal finite set of type `Finset α` implied from the assumption `Fintype α`. ;)
(; //LEAN:Finset.univ ;)
Finset__univ : (X : Set) -> Elem (Finset X).

(; doc: `Finsupp α M`, denoted `α →₀ M`, is the type of functions `f : α → M` such that `f x = 0` for all but finitely many `x`. ;)
(; //LEAN:Finsupp ;)
Finsupp : (X : Set) -> (M : Set) -> Set.

(; //LEAN:Finsupp.domCongr_apply ;)
Finsupp__domCongr_apply : (X : Set) -> (Y : Set) -> (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (e : Elem (Equiv X Y)) -> (l : Elem (Finsupp X M)) -> Proof (Eqt (Finsupp Y M) (Finsupp__domCongr__app e l) (Finsupp__equivMapDomain X Y M e l)).

(; doc: An equivalence of domains induces a linear equivalence of finitely supported functions.  This is `Finsupp.domCongr` as a `LinearEquiv`. See also `LinearMap.funCongrLeft` for the case of arbitrary functions. ;)
(; //LEAN:Finsupp.domLCongr ;)
Finsupp__domLCongr : (M : Set) -> (R : Set) -> (X : Set) -> (X1 : Set) -> (e : Elem (Equiv X X1)) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) (Finsupp X M) (Finsupp X1 M)).

(; doc: Given `Finite α`, `equivFunOnFinite` is the `Equiv` between `α →₀ β` and `α → β`. (All functions on a finite type are finitely supported.) ;)
(; //LEAN:Finsupp.equivFunOnFinite ;)
Finsupp__equivFunOnFinite : (X : Set) -> (M : Set) -> Elem (Equiv (Finsupp X M) (Elem X -> M)).

(; doc: Given `f : α ≃ β`, we can map `l : α →₀ M` to `equivMapDomain f l : β →₀ M` (computably) by mapping the support forwards and the function backwards. ;)
(; //LEAN:Finsupp.equivMapDomain ;)
Finsupp__equivMapDomain : (X : Set) -> (Y : Set) -> (M : Set) -> (f : Elem (Equiv X Y)) -> (l : Elem (Finsupp X M)) -> Elem (Finsupp Y M).

(; //LEAN:Finsupp.ext ;)
Finsupp__ext : (X : Set) -> (M : Set) -> (f : Elem (Finsupp X M)) -> (g : Elem (Finsupp X M)) -> (h : Proof (forall X (a => Eqt M (f a) (g a)))) -> Proof (Eqt (Finsupp X M) f g).

(; doc: Interpret `fun f : α →₀ M ↦ f a` as a linear map. ;)
(; //LEAN:Finsupp.lapply ;)
Finsupp__lapply : (X : Set) -> (M : Set) -> (R : Set) -> (a : Elem X) -> Elem (LinearMap R R (RingHom__id R) (Finsupp X M) M).

(; doc: Interprets (l : α →₀ R) as a linear combination of the elements in the family (v : α → M) and evaluates this linear combination. ;)
(; //LEAN:Finsupp.linearCombination ;)
Finsupp__linearCombination : (X : Set) -> (M : Set) -> (R : Set) -> (v : (Elem X -> M)) -> Elem (LinearMap R R (RingHom__id R) (Finsupp X R) M).

(; doc: Given `Finite α`, `linearEquivFunOnFinite R` is the natural `R`-linear equivalence between `α →₀ β` and `α → β`. ;)
(; //LEAN:Finsupp.linearEquivFunOnFinite ;)
Finsupp__linearEquivFunOnFinite : (R : Set) -> (M : Set) -> (X : Set) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) (Finsupp X M) (Elem X -> M)).

(; doc: Interpret `Finsupp.mapDomain` as a linear map. ;)
(; //LEAN:Finsupp.lmapDomain ;)
Finsupp__lmapDomain : (X : Set) -> (M : Set) -> (R : Set) -> (X1 : Set) -> (f : (Elem X -> X1)) -> Elem (LinearMap R R (RingHom__id R) (Finsupp X M) (Finsupp X1 M)).

(; //LEAN:Finsupp.module ;)
Finsupp__module : (X : Set) -> (M : Set) -> (R : Set) -> Elem (Module__on R (Finsupp X M)).

(; doc: `single a b` is the finitely supported function with value `b` at `a` and zero otherwise. ;)
(; //LEAN:Finsupp.single ;)
Finsupp__single : (X : Set) -> (M : Set) -> (a : Elem X) -> (b : Elem M) -> Elem (Finsupp X M).

(; //LEAN:Finsupp.single_left_inj ;)
Finsupp__single_left_inj : (X : Set) -> (M : Set) -> (a : Elem X) -> (a' : Elem X) -> (b : Elem M) -> (h : Proof (Neq b 0)) -> Proof (iff (Eqt (Finsupp X M) (Finsupp__single X M a b) (Finsupp__single X M a' b)) (Eqt X a a')).

(; //LEAN:Finsupp.smul_single' ;)
Finsupp__smul_single' : (X : Set) -> (R : Set) -> (x : Proof (Semiring R)) -> (c : Elem R) -> (a : Elem X) -> (b : Elem R) -> Proof (Eqt (Finsupp X R) (HSMul__hSMul R (Finsupp X R) (Finsupp X R) c (Finsupp__single X R a b)) (Finsupp__single X R a (times c b))).

(; doc: `sum f g` is the sum of `g a (f a)` over the support of `f`. ;)
(; //LEAN:Finsupp.sum ;)
Finsupp__sum : (X : Set) -> (M : Set) -> (N : Set) -> (f : Elem (Finsupp X M)) -> (g : (Elem X -> Elem M -> N)) -> Elem N.

(; //LEAN:Finsupp.sum_single ;)
Finsupp__sum_single : (X : Set) -> (M : Set) -> (_ : Proof (AddCommMonoid M)) -> (f : Elem (Finsupp X M)) -> Proof (Eqt (Finsupp X M) (Finsupp__sum X M (Finsupp X M) f (Finsupp__single X M)) f).

(; doc: `Fintype α` means that `α` is finite, i.e. there are only finitely many distinct elements of type `α`. The evidence of this is a finset `elems` (a list up to permutation without duplicates), together with a proof that everything of type `α` is in the list. ;)
(; //LEAN:Fintype ;)
Fintype : (X : Set) -> Prop.

(; doc: If `f : α ≃ β` and `α` is a fintype, then `β` is also a fintype. ;)
(; //LEAN:Fintype.ofEquiv ;)
Fintype__ofEquiv : (Y : Set) -> (X : Set) -> (f : Elem (Equiv X Y)) -> Proof (Fintype Y).

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Function.Injective.comp ;)
Function__Injective__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (g : (Elem Y -> Z)) -> (f : (Elem X -> Y)) -> (hg : Proof (Function__Injective Y Z g)) -> (hf : Proof (Function__Injective X Y f)) -> Proof (Function__Injective X Z (Function__comp X Y Z g f)).

(; doc: Function composition, usually written with the infix operator `∘`. A new function is created from two existing functions, where one function's output is used as input to the other.  Examples:  * `Function.comp List.reverse (List.drop 2) [3, 2, 4, 1] = [1, 4]`  * `(List.reverse ∘ List.drop 2) [3, 2, 4, 1] = [1, 4]`  Conventions for notations in identifiers:   * The recommended spelling of `∘` in identifiers is `comp`. ;)
(; //LEAN:Function.comp ;)
Function__comp : (X : Set) -> (Y : Set) -> (W : Set) -> (f : (Elem Y -> W)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> Elem W.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: A linear equivalence is an invertible linear map. ;)
(; //LEAN:LinearEquiv ;)
LinearEquiv : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (x3 : Elem (RingHom S R)) -> (M : Set) -> (X : Set) -> Set.

(; //LEAN:LinearEquiv.apply_symm_apply ;)
LinearEquiv__apply_symm_apply : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (module_M : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (h : Proof (RingHomInvPair R S x5 x6)) -> (h1 : Proof (RingHomInvPair S R x6 x5)) -> (e : Elem (LinearEquiv R S x5 x6 M X)) -> (c : Elem X) -> Proof (Eqt X (e (LinearEquiv__symm__app e c)) c).

(; //LEAN:LinearEquiv.ext ;)
LinearEquiv__ext : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (module_M : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (h : Proof (RingHomInvPair R S x5 x6)) -> (h1 : Proof (RingHomInvPair S R x6 x5)) -> (e : Elem (LinearEquiv R S x5 x6 M X)) -> (e' : Elem (LinearEquiv R S x5 x6 M X)) -> (h2 : Proof (forall M (x7 => Eqt X (e x7) (e' x7)))) -> Proof (Eqt (LinearEquiv R S x5 x6 M X) e e').

(; //LEAN:LinearEquiv.injective ;)
LinearEquiv__injective : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (module_M : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (h : Proof (RingHomInvPair R S x5 x6)) -> (h1 : Proof (RingHomInvPair S R x6 x5)) -> (e : Elem (LinearEquiv R S x5 x6 M X)) -> Proof (Function__Injective M X e).

(; //LEAN:LinearEquiv.mk ;)
LinearEquiv__mk : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (x3 : Elem (RingHom S R)) -> (M : Set) -> (X : Set) -> (toLinearMap : Elem (LinearMap R S x2 M X)) -> (invFun : (Elem X -> M)) -> (left_inv : Proof (autoParam (Function__LeftInverse M X invFun (AddHom__toFun M X (LinearMap__toAddHom R S x2 M X toLinearMap))) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse M X invFun (AddHom__toFun M X (LinearMap__toAddHom R S x2 M X toLinearMap))) Equiv__right_inv___autoParam)) -> Elem (LinearEquiv R S x2 x3 M X).

(; doc: The identity map is a linear equivalence. ;)
(; //LEAN:LinearEquiv.refl ;)
LinearEquiv__refl : (R : Set) -> (M : Set) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M M).

(; doc: Linear equivalences are symmetric. ;)
(; //LEAN:LinearEquiv.symm ;)
LinearEquiv__symm : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (module_M : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (h : Proof (RingHomInvPair R S x5 x6)) -> (h1 : Proof (RingHomInvPair S R x6 x5)) -> (e : Elem (LinearEquiv R S x5 x6 M X)) -> Elem (LinearEquiv S R x6 x5 X M).

(; doc: The equivalence of types underlying a linear equivalence. ;)
(; //LEAN:LinearEquiv.toEquiv ;)
LinearEquiv__toEquiv : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (modM : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (e : Elem (LinearEquiv R S x5 x6 M X)) -> Elem (Equiv M X).

(; doc: The linear map underlying a linear equivalence. ;)
(; //LEAN:LinearEquiv.toLinearMap ;)
LinearEquiv__toLinearMap : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (x3 : Elem (RingHom S R)) -> (M : Set) -> (X : Set) -> (self : Elem (LinearEquiv R S x2 x3 M X)) -> Elem (LinearMap R S x2 M X).

(; doc: Linear equivalences are transitive. ;)
(; //LEAN:LinearEquiv.trans ;)
LinearEquiv__trans : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (X4 : Set) -> (X5 : Set) -> (x6 : Proof (Module X X3)) -> (x7 : Proof (Module X1 X4)) -> (x8 : Proof (Module X2 X5)) -> (x9 : Elem (RingHom X X1)) -> (x10 : Elem (RingHom X1 X)) -> (x11 : Elem (RingHom X X2)) -> (x12 : Elem (RingHom X2 X)) -> (x13 : Elem (RingHom X1 X2)) -> (x14 : Elem (RingHom X2 X1)) -> (h2 : Proof (RingHomInvPair X X1 x9 x10)) -> (h3 : Proof (RingHomInvPair X1 X2 x13 x14)) -> (h5 : Proof (RingHomInvPair X1 X x10 x9)) -> (h6 : Proof (RingHomInvPair X2 X1 x14 x13)) -> (x15 : Elem (LinearEquiv X X1 x9 x10 X3 X4)) -> (x16 : Elem (LinearEquiv X1 X2 x13 x14 X4 X5)) -> Elem (LinearEquiv X X2 x11 x12 X3 X5).

(; doc: A map `f` between an `R`-module and an `S`-module over a ring homomorphism `σ : R →+* S` is semilinear if it satisfies the two properties `f (x + y) = f x + f y` and `f (c • x) = (σ c) • f x`. Elements of `LinearMap σ M M₂` (available under the notation `M →ₛₗ[σ] M₂`) are bundled versions of such maps. For plain linear maps (i.e. for which `σ = RingHom.id R`), the notation `M →ₗ[R] M₂` is available. An unbundled version of plain linear maps is available with the predicate `IsLinearMap`, but it should be avoided most of the time. ;)
(; //LEAN:LinearMap ;)
LinearMap : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> Set.

(; doc: Composition of two linear maps is a linear map ;)
(; //LEAN:LinearMap.comp ;)
LinearMap__comp : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (X4 : Set) -> (X5 : Set) -> (x6 : Proof (Module X X3)) -> (x7 : Proof (Module X1 X4)) -> (x8 : Proof (Module X2 X5)) -> (x9 : Elem (RingHom X X1)) -> (x10 : Elem (RingHom X1 X2)) -> (x11 : Elem (RingHom X X2)) -> (f : Elem (LinearMap X1 X2 x10 X4 X5)) -> (g : Elem (LinearMap X X1 x9 X3 X4)) -> Elem (LinearMap X X2 x11 X3 X5).

(; //LEAN:LinearMap.ext ;)
LinearMap__ext : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module S X)) -> (x6 : Elem (RingHom R S)) -> (f : Elem (LinearMap R S x6 M X)) -> (g : Elem (LinearMap R S x6 M X)) -> (h : Proof (forall M (x7 => Eqt X (f x7) (g x7)))) -> Proof (Eqt (LinearMap R S x6 M X) f g).

(; doc: Identity map as a `LinearMap` ;)
(; //LEAN:LinearMap.id ;)
LinearMap__id : (R : Set) -> (M : Set) -> Elem (LinearMap R R (RingHom__id R) M M).

(; //LEAN:LinearMap.mk ;)
LinearMap__mk : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> (toAddHom : Elem (AddHom M X)) -> (map_smul' : Proof (forall R (m => forall M (x7 => Eqt X (AddHom__toFun M X toAddHom (HSMul__hSMul R M M m x7)) (HSMul__hSMul S X X (x2 m) (AddHom__toFun M X toAddHom x7)))))) -> Elem (LinearMap R S x2 M X).

(; doc: The range of a linear map `f : M → M₂` is a submodule of `M₂`. See Note [range copy pattern]. ;)
(; //LEAN:LinearMap.range ;)
LinearMap__range : (R : Set) -> (X : Set) -> (M : Set) -> (X1 : Set) -> (x6 : Elem (RingHom R X)) -> (f : Elem (LinearMap R X x6 M X1)) -> Elem (Submodule X X1).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: A module is a generalization of vector spaces to a scalar semiring. It consists of a scalar semiring `R` and an additive monoid of "vectors" `M`, connected by a "scalar multiplication" operation `r • x : M` (where `r : R` and `x : M`) with some natural associativity and distributivity axioms similar to those on a ring. ;)
(; //LEAN:Module ;)
Module : (R : Set) -> (M : Set) -> Prop.

