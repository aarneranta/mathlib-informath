Module__Basis__equiv'___proof_6 : (X : Set) -> (I : Set) -> (R : Set) -> (M : Set) -> (M' : Set) -> (_ : Proof (CommSemiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (b : Elem (Module__Basis I R M)) -> (b' : Elem (Module__Basis X R M')) -> (f : (Elem M -> M')) -> (g : (Elem M' -> M)) -> (hg : Proof (forall X (i1 => Membership__mem M (powerset M) (Set__range M I b) (g (b' i1))))) -> (hfg : Proof (forall X (i => Eqt M' (f (g (b' i))) (b' i)))) -> (x5 : Elem M') -> Proof (Eqt M' (AddHom__toFun M M' (LinearMap__toAddHom R R (RingHom__id R) M M' (Module__Basis__constr__app b R (Function__comp I M M' f b))) (DFunLike__coe__app (Module__Basis__constr M X R M' b' R) (Function__comp X M' M g b') x5)) x5).

(; //LEAN:Module.Basis.equivFun._proof_1 ;)
Module__Basis__equivFun___proof_1 : (I : Set) -> (R : Set) -> (_ : Proof (Semiring R)) -> (f : Elem (Finsupp I R)) -> (g : Elem (Finsupp I R)) -> Proof (Eqt (Elem I -> R) (plus f g) (plus f g)).

(; //LEAN:Module.Basis.equivFun._proof_2 ;)
Module__Basis__equivFun___proof_2 : (I : Set) -> (R : Set) -> (_ : Proof (Semiring R)) -> (b : Elem R) -> (v : Elem (Finsupp I R)) -> Proof (Eqt (Elem I -> R) (HSMul__hSMul R (Finsupp I R) (Finsupp I R) b v) (HSMul__hSMul R (Elem I -> R) (Elem I -> R) b v)).

(; //LEAN:Module.Basis.equivFun._proof_3 ;)
Module__Basis__equivFun___proof_3 : (I : Set) -> (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Finite I)) -> Proof (Function__LeftInverse (Finsupp I R) (Elem I -> R) (Equiv__invFun (Finsupp I R) (Elem I -> R) (Finsupp__equivFunOnFinite I R)) (Equiv__toFun (Finsupp I R) (Elem I -> R) (Finsupp__equivFunOnFinite I R))).

(; //LEAN:Module.Basis.equivFun._proof_4 ;)
Module__Basis__equivFun___proof_4 : (I : Set) -> (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Finite I)) -> Proof (Function__RightInverse (Finsupp I R) (Elem I -> R) (Equiv__invFun (Finsupp I R) (Elem I -> R) (Finsupp__equivFunOnFinite I R)) (Equiv__toFun (Finsupp I R) (Elem I -> R) (Finsupp__equivFunOnFinite I R))).

(; //LEAN:Module.Basis.reindexFinsetRange._proof_1 ;)
Module__Basis__reindexFinsetRange___proof_1 : (I : Set) -> (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (b : Elem (Module__Basis I R M)) -> (_ : Proof (Fintype I)) -> (a : Elem M) -> Proof (iff (Membership__mem M (powerset M) (Set__range M I b) a) (Membership__mem M (Finset M) (Finset__image I M b (Finset__univ I)) (Equiv__refl__app M a))).

(; doc: Compose a `Module` with a `RingHom`, with action `f s • m`.  See note [reducible non-instances]. ;)
(; //LEAN:Module.compHom ;)
Module__compHom : (R : Set) -> (S : Set) -> (M : Set) -> (f : Elem (RingHom S R)) -> Elem (Module__on S M).

(; doc: `g : R ≃+* S` is `R`-linear when the module structure on `S` is `Module.compHom S g` . ;)
(; //LEAN:Module.compHom.toLinearEquiv ;)
Module__compHom__toLinearEquiv : (R : Set) -> (S : Set) -> (g : Elem (RingEquiv R S)) -> Elem (LinearEquiv__in_14 R R (RingHom__id R) (RingHom__id R) R S (Module__compHom S R S (RingHomClass__toRingHom (RingEquiv R S) R S (Semiring__toNonAssocSemiring R) (Semiring__toNonAssocSemiring S) g))).

(; doc: If `Subsingleton R`, then `M ≃ₗ[R] ι →₀ R` for any type `ι`. ;)
(; //LEAN:Module.subsingletonEquiv ;)
Module__subsingletonEquiv : (R : Set) -> (M : Set) -> (I : Set) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) M (Finsupp I R)).

(; doc: Predicate typeclass for expressing that a type is not reduced to a single element. In rings, this is equivalent to `0 ≠ 1`. In vector spaces, this is equivalent to positive dimension. ;)
(; //LEAN:Nontrivial ;)
Nontrivial : (X : Set) -> Prop.

(; doc: A special case of `Pi.module` for non-dependent types. Lean struggles to elaborate definitions elsewhere in the library without this. ;)
(; //LEAN:Pi.Function.module ;)
Pi__Function__module : (I : Set) -> (X : Set) -> (Y : Set) -> Elem (Module__on X (Elem I -> Y)).

(; doc: The function supported at `i`, with value `x` there, and `0` elsewhere. ;)
(; //LEAN:Pi.single ;)
Pi__single : (I : Set) -> (M : (Elem I -> Set)) -> (i : Elem I) -> (x2 : Elem (M i)) -> (j : Elem I) -> Elem (M j).

(; doc: An equivalence between two (non-unital non-associative semi)rings that preserves the algebraic structure. ;)
(; //LEAN:RingEquiv ;)
RingEquiv : (R : Set) -> (S : Set) -> Set.

(; doc: The inverse of a ring isomorphism is a ring isomorphism. ;)
(; //LEAN:RingEquiv.symm ;)
RingEquiv__symm : (R : Set) -> (S : Set) -> (e : Elem (RingEquiv R S)) -> Elem (RingEquiv S R).

(; doc: Bundled semiring homomorphisms; use this for bundled ring homomorphisms too.  This extends from both `MonoidHom` and `MonoidWithZeroHom` in order to put the fields in a sensible order, even though `MonoidWithZeroHom` already extends `MonoidHom`. ;)
(; //LEAN:RingHom ;)
RingHom : (X : Set) -> (Y : Set) -> Set.

(; doc: The identity ring homomorphism from a semiring to itself. ;)
(; //LEAN:RingHom.id ;)
RingHom__id : (X : Set) -> Elem (RingHom X X).

(; doc: Turn an element of a type `F` satisfying `RingHomClass F α β` into an actual `RingHom`. This is declared as the default coercion from `F` to `α →+* β`. ;)
(; //LEAN:RingHomClass.toRingHom ;)
RingHomClass__toRingHom : (F : Set) -> (X : Set) -> (Y : Set) -> (x1 : Proof (NonAssocSemiring X)) -> (x2 : Proof (NonAssocSemiring Y)) -> (f : Elem F) -> Elem (RingHom X Y).

(; doc: Class that expresses the fact that two ring homomorphisms are inverses of each other. This is used to handle `symm` for semilinear equivalences. ;)
(; //LEAN:RingHomInvPair ;)
RingHomInvPair : (X : Set) -> (X1 : Set) -> (x2 : Elem (RingHom X X1)) -> (x3 : Elem (RingHom X1 X)) -> Prop.

(; //LEAN:RingHomInvPair.ids ;)
RingHomInvPair__ids : (X : Set) -> (_ : Proof (Semiring X)) -> Proof (RingHomInvPair X X (RingHom__id X) (RingHom__id X)).

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; //LEAN:Semiring.toModule ;)
Semiring__toModule : (R : Set) -> Elem (Module__on R R).

(; //LEAN:Semiring.toNonAssocSemiring ;)
Semiring__toNonAssocSemiring : (X : Set) -> Elem (NonAssocSemiring__on X).

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (X : Set) -> (s : Elem (powerset X)) -> Set.

(; //LEAN:Set.mem_range_self ;)
Set__mem_range_self : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (i : Elem I) -> Proof (Membership__mem X (powerset X) (Set__range X I f) (f i)).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Elem (powerset X).

(; doc: A submodule of a module is one which is closed under vector operations. This is a sufficient condition for the subset of vectors in the submodule to themselves form a module. ;)
(; //LEAN:Submodule ;)
Submodule : (R : Set) -> (M : Set) -> Set.

(; doc: The span of a set `s ⊆ M` is the smallest submodule of M that contains `s`. ;)
(; //LEAN:Submodule.span ;)
Submodule__span : (R : Set) -> (M : Set) -> (s : Elem (powerset M)) -> Elem (Submodule R M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.mk ;)
Subtype__mk : (X : Set) -> (p : (Elem X -> Prop)) -> (val : Elem X) -> (property : Proof (p val)) -> Elem (Subtype X (x => p x)).

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (r : (Elem X -> Elem Y -> Set)) -> (s : (Elem Y -> Elem Z -> Set)) -> (t : (Elem X -> Elem Z -> Set)) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Z) -> (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; doc: **Alias** of `congrArg`. ;)
(; //LEAN:congr_arg ;)
congr_arg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: "Dependent" if-then-else, normally written via the notation `if h : c then t(h) else e(h)`, is sugar for `dite c (fun h => t(h)) (fun h => e(h))`, and it is the same as `if c then t else e` except that `t` is allowed to depend on a proof `h : c`, and `e` can depend on `h : ¬c`. (Both branches use the same name for the hypothesis, even though it has different types in the two cases.)  We use this to be able to communicate the if-then-else condition to the branches. For example, `Array.get arr i h` expects a proof `h : i < arr.size` in order to avoid a bounds check, so you can write `if h : i < arr.size then arr.get i h else ...` to avoid the bounds check inside the if branch. (Of course in this case we have only lifted the check into an explicit `if`, but we could also use this proof multiple times or derive `i < arr.size` from some other proposition that we are checking in the `if`.)  Conventions for notations in identifiers:   * The recommended spelling of `if h : c then t else e` in identifiers is `dite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:dite ;)
dite : (X : Set) -> (c : Prop) -> (t : (Proof c -> X)) -> (e : (Proof (not c) -> X)) -> Elem X.

(; //LEAN:eq_self ;)
eq_self : (X : Set) -> (a : Elem X) -> Proof (Eqt Prop (Eqt X a a) True).

(; doc: Sum of `f x` as `x` ranges over the elements of the support of `f`, if it's finite. Zero otherwise. ;)
(; //LEAN:finsum ;)
finsum : (M : Set) -> (X : Set) -> (f : (Elem X -> M)) -> Elem M.

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: **Function extensionality.** If two functions return equal results for all possible arguments, then they are equal.  It is called “extensionality” because it provides a way to prove two objects equal based on the properties of the underlying mathematical functions, rather than based on the syntax used to denote them. Function extensionality is a theorem that can be [proved using quotient types](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=quotient-funext). ;)
(; //LEAN:funext ;)
funext : (X : Set) -> (x : (Elem X -> Set)) -> (f : ((x4 : Elem X) -> x x4)) -> (g : ((x3 : Elem X) -> x x3)) -> (h : Proof (forall X (x2 => Eqt (x x2) (f x2) (g x2)))) -> Proof (Eqt ((x1 : Elem X) -> x x1) f g).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:implies_true ;)
implies_true : (X : Set) -> Proof (Eqt Prop (forall X (x => True)) True).

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (X : Set) -> (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; //LEAN:map_finsuppSum ;)
map_finsuppSum : (X : Set) -> (M : Set) -> (N : Set) -> (P : Set) -> (_ : Proof (AddCommMonoid N)) -> (_ : Proof (AddCommMonoid P)) -> (H : Set) -> (h1 : Elem H) -> (f : Elem (Finsupp X M)) -> (g : (Elem X -> Elem M -> N)) -> Proof (Eqt P (h1 (Finsupp__sum X M N f g)) (Finsupp__sum X M P f (a => b => h1 (g a b)))).

(; //LEAN:map_smul ;)
map_smul : (F : Set) -> (M : Set) -> (X : Set) -> (Y : Set) -> (f : Elem F) -> (c : Elem M) -> (x3 : Elem X) -> Proof (Eqt Y (f (HSMul__hSMul M X X c x3)) (HSMul__hSMul M Y Y c (f x3))).

(; //LEAN:mul_one ;)
mul_one : (M : Set) -> (_ : Proof (MulOneClass M)) -> (a : Elem M) -> Proof (Eqt M (times a 1) a).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_ne_zero ;)
one_ne_zero : (X : Set) -> (_ : Proof (NeZero X 1)) -> Proof (Neq 1 0).

(; doc: Gadget for optional parameter support.  A binder like `(x : α := default)` in a declaration is syntax sugar for `x : optParam α default`, and triggers the elaborator to attempt to use `default` to supply the argument if it is not supplied. ;)
(; //LEAN:optParam ;)
optParam : (X : Set) -> (default : Elem X) -> Set.

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

