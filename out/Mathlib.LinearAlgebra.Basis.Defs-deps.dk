Equiv__symm__app : (a1 : Elem (Equiv (Finsupp I R) (Elem I -> R))) -> (a2 : (Elem I -> R)) -> Elem (Finsupp I R).

(; a constant applied as a function: DFunLike.coe ;)
Finsupp__domLCongr__app : (a1 : Elem (Equiv I X)) -> (a2 : Elem (Finsupp I R)) -> Elem (Finsupp X R).

(; a constant applied as a function: DFunLike.coe ;)
Finsupp__linearCombination__app : (a1 : Set) -> (a2 : (Elem I -> M)) -> (a3 : Elem (Finsupp I R)) -> Elem M.

