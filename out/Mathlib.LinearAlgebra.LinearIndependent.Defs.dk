(; //LEAN:LinearIndependent ;)
def LinearIndependent : (R : Set) -> (v : (Elem I -> M)) -> Prop :=
  R => v => Function__Injective (Finsupp__linearCombination R v).

(; //LEAN:delabLinearIndependent ;)
