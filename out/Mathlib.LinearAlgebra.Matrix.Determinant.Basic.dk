  R => x => a => Matrix__det_fin_one R (Matrix__of__app (Matrix__vecCons (Matrix__vecCons a Matrix__vecEmpty) Matrix__vecEmpty)).

(; //LEAN:Matrix.det_fin_two ;)
Matrix__det_fin_two : (R : Set) -> (_ : Proof (CommRing R)) -> (A : (Matrix (Fin 2) (Fin 2) R)) -> Proof (Eqt R (Matrix__det A) (minus (times (A 0 0) (A 1 1)) (times (A 0 1) (A 1 0)))).

(; //LEAN:Matrix.det_fin_two_of ;)
def Matrix__det_fin_two_of : (R : Set) -> (_ : Proof (CommRing R)) -> (a : Elem R) -> (b : Elem R) -> (c : Elem R) -> (d : Elem R) -> Proof (Eqt R (Matrix__det (Matrix__of__app (Matrix__vecCons (Matrix__vecCons a (Matrix__vecCons b Matrix__vecEmpty)) (Matrix__vecCons (Matrix__vecCons c (Matrix__vecCons d Matrix__vecEmpty)) Matrix__vecEmpty)))) (minus (times a d) (times b c))) :=
  R => x => a => b => c => d => Matrix__det_fin_two R (Matrix__of__app (Matrix__vecCons (Matrix__vecCons a (Matrix__vecCons b Matrix__vecEmpty)) (Matrix__vecCons (Matrix__vecCons c (Matrix__vecCons d Matrix__vecEmpty)) Matrix__vecEmpty))).

(; //LEAN:Matrix.det_fin_three ;)
Matrix__det_fin_three : (R : Set) -> (_ : Proof (CommRing R)) -> (A : (Matrix (Fin 3) (Fin 3) R)) -> Proof (Eqt R (Matrix__det A) (minus (plus (plus (minus (minus (times (times (A 0 0) (A 1 1)) (A 2 2)) (times (times (A 0 0) (A 1 2)) (A 2 1))) (times (times (A 0 1) (A 1 0)) (A 2 2))) (times (times (A 0 1) (A 1 2)) (A 2 0))) (times (times (A 0 2) (A 1 0)) (A 2 1))) (times (times (A 0 2) (A 1 1)) (A 2 0)))).

