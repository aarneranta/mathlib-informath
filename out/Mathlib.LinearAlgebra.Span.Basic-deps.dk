(; constants used by Mathlib.LinearAlgebra.Span.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
AddSubgroup__toIntSubmodule__app : (a1 : Elem (AddSubgroup M)) -> Elem (Submodule Int M).

(; a constant applied as a function: DFunLike.coe ;)
AddSubmonoid__toNatSubmodule__app : (a1 : Elem (AddSubmonoid M)) -> Elem (Submodule Nat M).

(; a constant applied as a function: DFunLike.coe ;)
DFunLike__coe__app : (a1 : Elem (LinearMap (RingHom__id R) M (LinearMap (RingHom__id R) N P))) -> (a2 : Elem M) -> (a3 : Elem N) -> Elem P.

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__coord__app : (a1 : Set) -> (a2 : Set) -> (a3 : Elem M) -> (a4 : Proof (Neq x3 0)) -> (a5 : Elem (Subtype (x4 => Membership__mem (Submodule__span R (Singleton__singleton x3)) x4))) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__symm__app : (a1 : Elem (LinearEquiv (RingHom__id R) R (Subtype (x6 => Membership__mem (Submodule__span R (Singleton__singleton x3)) x6)))) -> (a2 : Elem (Subtype (x7 => Membership__mem (Submodule__span R (Singleton__singleton x3)) x7))) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
LinearEquiv__toSpanNonzeroSingleton__app : (a1 : Set) -> (a2 : Set) -> (a3 : Elem M) -> (a4 : Proof (Neq x3 0)) -> (a5 : Elem R) -> Elem (Subtype (x5 => Membership__mem (Submodule__span R (Singleton__singleton x3)) x5)).

(; a constant applied as a function: DFunLike.coe ;)
LinearMap__id__app : (a1 : Elem R) -> Elem R.

(; a constant applied as a function: DFunLike.coe ;)
LinearMap__toSpanSingleton__app : (a1 : Set) -> (a2 : Set) -> (a3 : Elem M) -> (a4 : Elem R) -> Elem M.

(; a constant applied as a function: DFunLike.coe ;)
Submodule__inclusionSpan__app : (a1 : Set) -> (a2 : Elem (Submodule R M)) -> (a3 : Elem (Subtype (x7 => Membership__mem p x7))) -> Elem (Subtype (x8 => Membership__mem (Submodule__span S p) x8)).

(; a constant applied as a function: DFunLike.coe ;)
Submodule__prodEquiv__app : (a1 : Elem (Submodule R M)) -> (a2 : Elem (Submodule R M')) -> (a3 : Elem (Subtype (x8 => Membership__mem (Submodule__prod p q) x8))) -> Elem (Prod (Subtype (x9 => Membership__mem p x9)) (Subtype (x10 => Membership__mem q x10))).

(; doc: An additive commutative group is an additive group with commutative `(+)`.  [Wikidata Q181296](https://www.wikidata.org/wiki/Q181296) ;)
(; //LEAN:AddCommGroup ;)
AddCommGroup : (G : Set) -> Prop.

(; doc: An additive commutative monoid is an additive monoid with commutative `(+)`. ;)
(; //LEAN:AddCommMonoid ;)
AddCommMonoid : (M : Set) -> Prop.

(; //LEAN:AddHom.mk ;)
AddHom__mk : (toFun : (Elem M -> N)) -> (map_add' : Proof (forall M (x2 => forall M (y => Eqt N (toFun (plus x2 y)) (plus (toFun x2) (toFun y)))))) -> Elem (AddHom M N).

(; doc: A substructure satisfying `AddMemClass` is closed under addition. ;)
(; //LEAN:AddMemClass.add_mem ;)
AddMemClass__add_mem : (S : Set) -> (M : Elem (outParam Set)) -> (x : Proof (Add M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (AddMemClass S M)) -> (s : Elem S) -> (a : Elem M) -> (b : Elem M) -> (h : Proof (Membership__mem s a)) -> (h1 : Proof (Membership__mem s b)) -> Proof (Membership__mem s (plus a b)).

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; doc: The `AddSubgroup` generated by a set ;)
(; //LEAN:AddSubgroup.closure ;)
AddSubgroup__closure : (k : Elem (powerset G)) -> Elem (AddSubgroup G).

(; doc: An additive subgroup `K` includes `closure k` if and only if it includes `k` ;)
(; //LEAN:AddSubgroup.closure_le ;)
AddSubgroup__closure_le : (G : Set) -> (_ : Proof (AddGroup G)) -> (K : Elem (AddSubgroup G)) -> (k : Elem (powerset G)) -> Proof (iff (Leq (AddSubgroup__closure k) K) (Set__Subset k K)).

(; doc: The `AddSubgroup` generated by a set includes the set. ;)
(; //LEAN:AddSubgroup.subset_closure ;)
AddSubgroup__subset_closure : (G : Set) -> (_ : Proof (AddGroup G)) -> (k : Elem (powerset G)) -> Proof (Set__Subset k (AddSubgroup__closure k)).

(; doc: An additive submonoid of an additive monoid `M` is a subset containing 0 and closed under addition. ;)
(; //LEAN:AddSubmonoid ;)
AddSubmonoid : (M : Set) -> Set.

(; doc: The `AddSubmonoid` generated by a set ;)
(; //LEAN:AddSubmonoid.closure ;)
AddSubmonoid__closure : (s : Elem (powerset M)) -> Elem (AddSubmonoid M).

(; doc: An additive submonoid `S` includes `closure s` if and only if it includes `s`. ;)
(; //LEAN:AddSubmonoid.closure_le ;)
AddSubmonoid__closure_le : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (s : Elem (powerset M)) -> (S : Elem (AddSubmonoid M)) -> Proof (iff (Leq (AddSubmonoid__closure s) S) (Set__Subset s S)).

(; //LEAN:AddSubmonoid.mk ;)
AddSubmonoid__mk : (toAddSubsemigroup : Elem (AddSubsemigroup M)) -> (zero_mem' : Proof (Membership__mem (AddSubsemigroup__carrier toAddSubsemigroup) 0)) -> Elem (AddSubmonoid M).

(; doc: The `AddSubmonoid` generated by a set includes the set. ;)
(; //LEAN:AddSubmonoid.subset_closure ;)
AddSubmonoid__subset_closure : (M : Set) -> (_ : Proof (AddZeroClass M)) -> (s : Elem (powerset M)) -> Proof (Set__Subset s (AddSubmonoid__closure s)).

(; //LEAN:AddSubsemigroup.mk ;)
AddSubsemigroup__mk : (carrier : Elem (powerset M)) -> (add_mem' : Proof (forall M (a => forall M (b => if (Membership__mem carrier a) (if (Membership__mem carrier b) (Membership__mem carrier (plus a b))))))) -> Elem (AddSubsemigroup M).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: Two elements of a lattice are codisjoint if their sup is the top element.  Note that we define this without reference to `⊔`, as this allows us to talk about orders where the supremum is not unique, or where implementing `Sup` would require additional `Decidable` arguments. ;)
(; //LEAN:Codisjoint ;)
Codisjoint : (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: A commutative semiring is a semiring with commutative multiplication. ;)
(; //LEAN:CommSemiring ;)
CommSemiring : (R : Set) -> Prop.

(; doc: `CovBy a b` means that `b` covers `a`. This means that `a < b` and there is no element in between. This is denoted `a ⋖ b`. ;)
(; //LEAN:CovBy ;)
CovBy : (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:DFunLike.ext ;)
DFunLike__ext : (F : Set) -> (X : Set) -> (x : (Elem X -> Set)) -> (f : Elem F) -> (g : Elem F) -> (h : Proof (forall X (x1 => Eqt (x x1) (f x1) (g x1)))) -> Proof (Eqt F f g).

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:Disjoint.symm ;)
Disjoint__symm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Disjoint a b)) -> Proof (Disjoint b a).

(; doc: Typeclass for multiplicative actions on additive structures.  For example, if `G` is a group (with group law written as multiplication) and `A` is an abelian group (with group law written as addition), then to give `A` a `G`-module structure (for example, to use the theory of group cohomology) is to say `[DistribMulAction G A]`. Note in that we do not use the `Module` typeclass for `G`-modules, as the `Module` typeclass is for modules over a ring rather than a group.  Mathematically, `DistribMulAction G A` is equivalent to giving `A` the structure of a `ℤ[G]`-module. ;)
(; //LEAN:DistribMulAction ;)
DistribMulAction : (M : Set) -> (A : Set) -> Prop.

(; doc: Each element of the monoid defines a linear map.  This is a stronger version of `DistribSMul.toAddMonoidHom`. ;)
(; //LEAN:DistribSMul.toLinearMap ;)
DistribSMul__toLinearMap : (R : Set) -> (M : Set) -> (s : Elem S) -> Elem (LinearMap (RingHom__id R) M M).

(; doc: A `DivisionRing` is a `Ring` with multiplicative inverses for nonzero elements.  An instance of `DivisionRing K` includes maps `ratCast : ℚ → K` and `qsmul : ℚ → K → K`. Those two fields are needed to implement the `DivisionRing K → Algebra ℚ K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ` itself). See also note [forgetful inheritance]. Similarly, there are maps `nnratCast ℚ≥0 → K` and `nnqsmul : ℚ≥0 → K → K` to implement the `DivisionSemiring K → Algebra ℚ≥0 K` instance.  If the division ring has positive characteristic `p`, our division by zero convention forces `ratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:DivisionRing ;)
DivisionRing : (K : Set) -> Prop.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: **Alias** of `ge_of_eq`. ;)
(; //LEAN:Eq.ge ;)
Eq__ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; doc: If `h : α = β` is a proof of type equality, then `h.mp : α → β` is the induced "cast" operation, mapping elements of `α` to elements of `β`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mp` is definitionally the identity function. ;)
(; //LEAN:Eq.mp ;)
Eq__mp : (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; //LEAN:Eq.not_lt ;)
Eq__not_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (not (Lt a b)).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: A `Field` is a `CommRing` with multiplicative inverses for nonzero elements.  An instance of `Field K` includes maps `ratCast : ℚ → K` and `qsmul : ℚ → K → K`. Those two fields are needed to implement the `DivisionRing K → Algebra ℚ K` instance since we need to control the specific definitions for some special cases of `K` (in particular `K = ℚ` itself). See also note [forgetful inheritance].  If the field has positive characteristic `p`, our division by zero convention forces `ratCast (1 / p) = 1 / 0 = 0`. ;)
(; //LEAN:Field ;)
Field : (K : Set) -> Prop.

(; doc: `Finset α` is the type of finite sets of elements of `α`. It is implemented as a multiset (a list up to permutation) which has no duplicate elements. ;)
(; //LEAN:Finset ;)
Finset : (X : Set) -> Set.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (f : (Elem X -> Y)) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: A coatom of an `OrderTop` is an element with no other element between it and `⊤`, which is not `⊤`. ;)
(; //LEAN:IsCoatom ;)
IsCoatom : (a : Elem X) -> Prop.

(; doc: An element `k` is compact if any directed set with `LUB` (least upper bound) above `k` has already got above `k` at some point in the set. Such an element is also called "finite" or "S-compact". ;)
(; //LEAN:IsCompactElement ;)
IsCompactElement : (k : Elem X) -> Prop.

(; doc: Two elements `x` and `y` are complements of each other if `x ⊔ y = ⊤` and `x ⊓ y = ⊥`. ;)
(; //LEAN:IsCompl ;)
IsCompl : (x2 : Elem X) -> (y : Elem X) -> Prop.

(; doc: A domain is a nontrivial semiring such that multiplication by a nonzero element is cancellative on both sides. In other words, a nontrivial semiring `R` satisfying `∀ {a b c : R}, a ≠ 0 → a * b = a * c → b = c` and `∀ {a b c : R}, b ≠ 0 → a * b = c * b → a = c`.  This is implemented as a mixin for `Semiring α`. To obtain an integral domain use `[CommRing α] [IsDomain α]`. ;)
(; //LEAN:IsDomain ;)
IsDomain : (X : Set) -> Prop.

(; doc: An element `a` is said to be idempotent if `a * a = a`. ;)
(; //LEAN:IsIdempotentElem ;)
IsIdempotentElem : (a : Elem M) -> Prop.

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (a : Elem M) -> Prop.

(; doc: **Alias** of `le_antisymm`. ;)
(; //LEAN:LE.le.antisymm ;)
LE__le__antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; doc: **Alias** of `ge_antisymm`. ;)
(; //LEAN:LE.le.antisymm' ;)
LE__le__antisymm' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq a b)) -> Proof (Eqt X a b).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: A linear equivalence is an invertible linear map. ;)
(; //LEAN:LinearEquiv ;)
LinearEquiv : (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> Set.

(; //LEAN:LinearEquiv.apply_symm_apply ;)
LinearEquiv__apply_symm_apply : (R : Set) -> (S : Set) -> (M : Set) -> (X : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (Semiring S)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (AddCommMonoid X)) -> (module_M : Proof (Module R M)) -> (x4 : Proof (Module S X)) -> (x5 : Elem (RingHom R S)) -> (x6 : Elem (RingHom S R)) -> (h : Proof (RingHomInvPair x5 x6)) -> (h1 : Proof (RingHomInvPair x6 x5)) -> (e : Elem (LinearEquiv x5 M X)) -> (c : Elem X) -> Proof (Eqt X (e (LinearEquiv__symm__app e c)) c).

(; //LEAN:LinearEquiv.mk ;)
LinearEquiv__mk : (toLinearMap : Elem (LinearMap x2 M X)) -> (invFun : (Elem X -> M)) -> (left_inv : Proof (autoParam (Function__LeftInverse invFun (AddHom__toFun (LinearMap__toAddHom toLinearMap))) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse invFun (AddHom__toFun (LinearMap__toAddHom toLinearMap))) Equiv__right_inv___autoParam)) -> Elem (LinearEquiv x2 M X).

(; doc: Linear equivalence between two equal submodules. ;)
(; //LEAN:LinearEquiv.ofEq ;)
LinearEquiv__ofEq : (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M)) -> (h : Proof (Eqt (Submodule R M) p q)) -> Elem (LinearEquiv (RingHom__id R) (Subtype (x2 => Membership__mem p x2)) (Subtype (x3 => Membership__mem q x3))).

(; doc: An `Injective` linear map `f : M →ₗ[R] M₂` defines a linear equivalence between `M` and `f.range`. See also `LinearMap.ofLeftInverse`. ;)
(; //LEAN:LinearEquiv.ofInjective ;)
LinearEquiv__ofInjective : (f : Elem (LinearMap x5 M X1)) -> (h2 : Proof (Function__Injective f)) -> Elem (LinearEquiv x5 M (Subtype (x7 => Membership__mem (LinearMap__range f) x7))).

(; doc: Linear equivalences are symmetric. ;)
(; //LEAN:LinearEquiv.symm ;)
LinearEquiv__symm : (e : Elem (LinearEquiv x5 M X)) -> Elem (LinearEquiv x6 X M).

(; doc: The linear map underlying a linear equivalence. ;)
(; //LEAN:LinearEquiv.toLinearMap ;)
LinearEquiv__toLinearMap : (self : Elem (LinearEquiv x2 M X)) -> Elem (LinearMap x2 M X).

(; //LEAN:LinearEquiv.toSpanNonzeroSingleton._proof_4 ;)
LinearEquiv__toSpanNonzeroSingleton___proof_4 : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (IsDomain R)) -> (_ : Proof (AddCommGroup M)) -> (_ : Proof (Module R M)) -> (_ : Proof (Module__IsTorsionFree R M)) -> (x3 : Elem M) -> (h2 : Proof (Neq x3 0)) -> Proof (Function__Injective (LinearMap__toSpanSingleton R M x3)).

(; //LEAN:LinearEquiv.toSpanNonzeroSingleton._proof_5 ;)
LinearEquiv__toSpanNonzeroSingleton___proof_5 : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (_ : Proof (Module R M)) -> (x3 : Elem M) -> Proof (Eqt (Submodule R M) (LinearMap__range (LinearMap__toSpanSingleton R M x3)) (Submodule__span R (Singleton__singleton x3))).

(; doc: Linear equivalences are transitive. ;)
(; //LEAN:LinearEquiv.trans ;)
LinearEquiv__trans : (x15 : Elem (LinearEquiv x9 X3 X4)) -> (x16 : Elem (LinearEquiv x13 X4 X5)) -> Elem (LinearEquiv x11 X3 X5).

(; doc: A map `f` between an `R`-module and an `S`-module over a ring homomorphism `σ : R →+* S` is semilinear if it satisfies the two properties `f (x + y) = f x + f y` and `f (c • x) = (σ c) • f x`. Elements of `LinearMap σ M M₂` (available under the notation `M →ₛₗ[σ] M₂`) are bundled versions of such maps. For plain linear maps (i.e. for which `σ = RingHom.id R`), the notation `M →ₗ[R] M₂` is available. An unbundled version of plain linear maps is available with the predicate `IsLinearMap`, but it should be avoided most of the time. ;)
(; //LEAN:LinearMap ;)
LinearMap : (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> Set.

(; doc: Composition of two linear maps is a linear map ;)
(; //LEAN:LinearMap.comp ;)
LinearMap__comp : (f : Elem (LinearMap x10 X4 X5)) -> (g : Elem (LinearMap x9 X3 X4)) -> Elem (LinearMap x11 X3 X5).

(; doc: The restriction of a linear map `f : M → M₂` to a submodule `p ⊆ M` gives a linear map `p → M₂`. ;)
(; //LEAN:LinearMap.domRestrict ;)
LinearMap__domRestrict : (f : Elem (LinearMap x6 M X1)) -> (p : Elem (Submodule R M)) -> Elem (LinearMap x6 (Subtype (x7 => Membership__mem p x7)) X1).

(; doc: Identity map as a `LinearMap` ;)
(; //LEAN:LinearMap.id ;)
LinearMap__id : Elem (LinearMap (RingHom__id R) M M).

(; doc: The kernel of a linear map `f : M → M₂` is defined to be `comap f ⊥`. This is equivalent to the set of `x : M` such that `f x = 0`. The kernel is a submodule of `M`. ;)
(; //LEAN:LinearMap.ker ;)
LinearMap__ker : (f : Elem (LinearMap x6 M X1)) -> Elem (Submodule R M).

(; //LEAN:LinearMap.mk ;)
LinearMap__mk : (toAddHom : Elem (AddHom M X)) -> (map_smul' : Proof (forall R (m => forall M (x7 => Eqt X (AddHom__toFun toAddHom (HSMul__hSMul m x7)) (HSMul__hSMul (x2 m) (AddHom__toFun toAddHom x7)))))) -> Elem (LinearMap x2 M X).

(; doc: The range of a linear map `f : M → M₂` is a submodule of `M₂`. See Note [range copy pattern]. ;)
(; //LEAN:LinearMap.range ;)
LinearMap__range : (f : Elem (LinearMap x6 M X1)) -> Elem (Submodule X X1).

(; doc: When `f` is an `R`-linear map taking values in `S`, then `fun b ↦ f b • x` is an `R`-linear map. ;)
(; //LEAN:LinearMap.smulRight ;)
LinearMap__smulRight : (f : Elem (LinearMap (RingHom__id R) X S)) -> (x8 : Elem M) -> Elem (LinearMap (RingHom__id R) X M).

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: A module is a generalization of vector spaces to a scalar semiring. It consists of a scalar semiring `R` and an additive monoid of "vectors" `M`, connected by a "scalar multiplication" operation `r • x : M` (where `r : R` and `x : M`) with some natural associativity and distributivity axioms similar to those on a ring. ;)
(; //LEAN:Module ;)
Module : (R : Set) -> (M : Set) -> Prop.

(; doc: Linear endomorphisms of a module, with associated ring structure `Module.End.semiring` and algebra structure `Module.End.algebra`. ;)
(; //LEAN:Module.End ;)
Module__End : (R : Set) -> (M : Set) -> Set.

(; doc: An `R`-module `M` is torsion-free if scalar multiplication by an element `r : R` is injective if multiplication (on `R`) by `r` is.  For domains, this is equivalent to the usual condition of `r • m = 0 → r = 0 ∨ m = 0`. See `smul_eq_zero`. ;)
(; //LEAN:Module.IsTorsionFree ;)
Module__IsTorsionFree : (R : Set) -> (M : Set) -> Prop.

(; doc: A `Monoid` is a `Semigroup` with an element `1` such that `1 * a = a * 1 = a`. ;)
(; //LEAN:Monoid ;)
Monoid : (M : Set) -> Prop.

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (f : (Elem X -> Y)) -> Prop.

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; //LEAN:Not.imp ;)
Not__imp : (a : Prop) -> (b : Prop) -> (H2 : Proof (not b)) -> (H1 : Proof (if a b)) -> Proof (not a).

(; doc: A chain is a monotone sequence.  This is made a one-field structure around order homomorphisms `ℕ →o α` because we want to endow chains with the domination order rather than the pointwise order. See `Chain.instLE`.  See the definition on page 114 of [gunter1992]. ;)
(; //LEAN:OmegaCompletePartialOrder.Chain ;)
OmegaCompletePartialOrder__Chain : (X : Set) -> Set.

(; doc: `map` function for `Chain` ;)
(; //LEAN:OmegaCompletePartialOrder.Chain.map ;)
OmegaCompletePartialOrder__Chain__map : (c : Elem (OmegaCompletePartialOrder__Chain X)) -> (f : Elem (OrderHom X Y)) -> Elem (OmegaCompletePartialOrder__Chain Y).

(; //LEAN:OmegaCompletePartialOrder.Chain.toOrderHom ;)
OmegaCompletePartialOrder__Chain__toOrderHom : (self : Elem (OmegaCompletePartialOrder__Chain X)) -> Elem (OrderHom Nat X).

(; doc: A function `f` between `ω`-complete partial orders is `ωScottContinuous` if it is Scott continuous over chains. ;)
(; //LEAN:OmegaCompletePartialOrder.ωScottContinuous ;)
OmegaCompletePartialOrder___u3c9_ScottContinuous : (f : (Elem X -> Y)) -> Prop.

(; doc: **Alias** of the reverse direction of `OmegaCompletePartialOrder.ωScottContinuous_iff_monotone_map_ωSup`.  ---  `ωScottContinuous f` asserts that `f` is both monotone and distributes over ωSup. ;)
(; //LEAN:OmegaCompletePartialOrder.ωScottContinuous.of_monotone_map_ωSup ;)
OmegaCompletePartialOrder___u3c9_ScottContinuous__of_monotone_map__u3c9_Sup : (X : Set) -> (Y : Set) -> (_ : Proof (OmegaCompletePartialOrder X)) -> (_ : Proof (OmegaCompletePartialOrder Y)) -> (f : (Elem X -> Y)) -> (h : Proof (exists (Monotone f) (hf => forall (OmegaCompletePartialOrder__Chain X) (c => Eqt Y (f (OmegaCompletePartialOrder___u3c9_Sup c)) (OmegaCompletePartialOrder___u3c9_Sup (OmegaCompletePartialOrder__Chain__map c (OrderHom__mk f hf))))))) -> Proof (OmegaCompletePartialOrder___u3c9_ScottContinuous f).

(; doc: The supremum of an increasing sequence ;)
(; //LEAN:OmegaCompletePartialOrder.ωSup ;)
OmegaCompletePartialOrder___u3c9_Sup : (x : Elem (OmegaCompletePartialOrder__Chain X)) -> Elem X.

(; //LEAN:Or.resolve_left ;)
Or__resolve_left : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (na : Proof (not a)) -> Proof b.

(; //LEAN:Or.resolve_right ;)
Or__resolve_right : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (nb : Proof (not b)) -> Proof a.

(; //LEAN:OrderHom.mk ;)
OrderHom__mk : (toFun : (Elem X -> Y)) -> (monotone' : Proof (Monotone toFun)) -> Elem (OrderHom X Y).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: Bundled semiring homomorphisms; use this for bundled ring homomorphisms too.  This extends from both `MonoidHom` and `MonoidWithZeroHom` in order to put the fields in a sensible order, even though `MonoidWithZeroHom` already extends `MonoidHom`. ;)
(; //LEAN:RingHom ;)
RingHom : (X : Set) -> (Y : Set) -> Set.

(; doc: The identity ring homomorphism from a semiring to itself. ;)
(; //LEAN:RingHom.id ;)
RingHom__id : (X : Set) -> Elem (RingHom X X).

(; doc: Class that expresses the fact that two ring homomorphisms are inverses of each other. This is used to handle `symm` for semilinear equivalences. ;)
(; //LEAN:RingHomInvPair ;)
RingHomInvPair : (x2 : Elem (RingHom X X1)) -> (x3 : Elem (outParam (RingHom X1 X))) -> Prop.

(; //LEAN:RingHomInvPair.ids ;)
RingHomInvPair__ids : (X : Set) -> (_ : Proof (Semiring X)) -> Proof (RingHomInvPair (RingHom__id X) (RingHom__id X)).

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; //LEAN:Semiring.toModule ;)
Semiring__toModule : Proof (Module R R).

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (s : Elem (powerset X)) -> Set.

(; doc: Two functions `f₁ f₂ : α → β` are equal on `s` if `f₁ x = f₂ x` for all `x ∈ s`. ;)
(; //LEAN:Set.EqOn ;)
Set__EqOn : (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A set is finite if the corresponding `Subtype` is finite, i.e., if there exists a natural `n : ℕ` and an equivalence `s ≃ Fin n`. ;)
(; //LEAN:Set.Finite ;)
Set__Finite : (s : Elem (powerset X)) -> Prop.

(; doc: `MapsTo f s t` means that the image of `s` is contained in `t`. ;)
(; //LEAN:Set.MapsTo ;)
Set__MapsTo : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> Prop.

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (s : Elem (powerset X)) -> Prop.

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.forall_mem_range ;)
Set__forall_mem_range : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (p : (Elem X -> Prop)) -> Proof (iff (forall X (a => if (Membership__mem (Set__range f) a) (p a))) (forall I (i => p (f i)))).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.image_mono ;)
Set__image_mono : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset s t)) -> Proof (Set__Subset (Set__image f s) (Set__image f t)).

(; doc: image and preimage are a Galois connection ;)
(; //LEAN:Set.image_subset_iff ;)
Set__image_subset_iff : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> (f : (Elem X -> Y)) -> Proof (iff (Set__Subset (Set__image f s) t) (Set__Subset s (Set__preimage f t))).

(; //LEAN:Set.mem_prod ;)
Set__mem_prod : (X : Set) -> (Y : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset Y)) -> (p : Elem (Prod X Y)) -> Proof (iff (Membership__mem (SProd__sprod s t) p) (and (Membership__mem s (Prod__fst p)) (Membership__mem t (Prod__snd p)))).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; //LEAN:Set.prod_inter_prod ;)
Set__prod_inter_prod : (X : Set) -> (Y : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset Y)) -> (x3 : Elem (powerset Y)) -> Proof (Eqt (powerset (Prod X Y)) (Inter__inter (SProd__sprod x x2) (SProd__sprod x1 x3)) (SProd__sprod (Inter__inter x x1) (Inter__inter x2 x3))).

(; //LEAN:Set.prod_mono ;)
Set__prod_mono : (X : Set) -> (Y : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset Y)) -> (x3 : Elem (powerset Y)) -> (hs : Proof (Set__Subset x x1)) -> (ht : Proof (Set__Subset x2 x3)) -> Proof (Set__Subset (SProd__sprod x x2) (SProd__sprod x1 x3)).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (f : (Elem I -> X)) -> Elem (powerset X).

(; doc: The coercion from a term of a `SetLike` to its corresponding `Set` is injective. ;)
(; //LEAN:SetLike.coe_injective ;)
SetLike__coe_injective : (A : Set) -> (B : Elem (outParam Set)) -> Proof (Function__Injective self).

(; //LEAN:SetLike.coe_mono ;)
SetLike__coe_mono : (A : Set) -> (B : Set) -> (_ : Proof (Preorder A)) -> (_ : Proof (IsConcreteLE A B)) -> Proof (Monotone x).

(; doc: Note: implementers of `SetLike` must copy this lemma in order to tag it with `@[ext]`. ;)
(; //LEAN:SetLike.ext ;)
SetLike__ext : (A : Set) -> (B : Set) -> (p : Elem A) -> (q : Elem A) -> (h : Proof (forall B (x => iff (Membership__mem p x) (Membership__mem q x)))) -> Proof (Eqt A p q).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; //LEAN:Std.le_refl._simp_1 ;)
Std__le_refl___simp_1 : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (Std__Refl (x1 => x2 => Leq x1 x2))) -> (a : Elem X) -> Proof (Eqt Prop (Leq a a) True).

(; doc: A submodule of a module is one which is closed under vector operations. This is a sufficient condition for the subset of vectors in the submodule to themselves form a module. ;)
(; //LEAN:Submodule ;)
Submodule : (R : Set) -> (M : Set) -> Set.

(; //LEAN:Submodule.coe_iSup_of_chain ;)
Submodule__coe_iSup_of_chain : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (a : Elem (OrderHom Nat (Submodule R M))) -> Proof (Eqt (powerset M) (iSup (k => a k)) (Set__iUnion (k1 => a k1))).

(; doc: The pullback of a submodule `p ⊆ M₂` along `f : M → M₂` ;)
(; //LEAN:Submodule.comap ;)
Submodule__comap : (f : Elem (LinearMap x6 M X1)) -> (p : Elem (Submodule X X1)) -> Elem (Submodule R M).

(; //LEAN:Submodule.eq_top_iff' ;)
Submodule__eq_top_iff' : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Proof (iff (Eqt (Submodule R M) p Top__top) (forall M (x3 => Membership__mem p x3))).

(; doc: If two submodules `p` and `p'` satisfy `p ⊆ p'`, then `inclusion p p'` is the linear map version of this inclusion. ;)
(; //LEAN:Submodule.inclusion ;)
Submodule__inclusion : (h : Proof (Leq p p')) -> Elem (LinearMap (RingHom__id R) (Subtype (x3 => Membership__mem p x3)) (Subtype (x4 => Membership__mem p' x4))).

(; //LEAN:Submodule.inclusionSpan._proof_1 ;)
Submodule__inclusionSpan___proof_1 : (R : Set) -> (M : Set) -> (S : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (_ : Proof (Semiring S)) -> (_ : Proof (Module S M)) -> (p : Elem (Submodule R M)) -> (x5 : Elem (Subtype (x8 => Membership__mem p x8))) -> (y : Elem (Subtype (x7 => Membership__mem p x7))) -> Proof (Eqt (Subtype (x6 => Membership__mem (Submodule__span S p) x6)) (plus x5 y) (plus x5 y)).

(; //LEAN:Submodule.inclusionSpan._proof_2 ;)
Submodule__inclusionSpan___proof_2 : (R : Set) -> (M : Set) -> (S : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (_ : Proof (Semiring S)) -> (_ : Proof (Module S M)) -> (p : Elem (Submodule R M)) -> (t : Elem R) -> (x6 : Elem (Subtype (x8 => Membership__mem p x8))) -> Proof (Eqt (Subtype (x7 => Membership__mem (Submodule__span S p) x7)) (HSMul__hSMul t x6) (HSMul__hSMul (RingHom__id__app R t) x6)).

(; doc: The pushforward of a submodule `p ⊆ M` by `f : M → M₂` ;)
(; //LEAN:Submodule.map ;)
Submodule__map : (f : Elem (LinearMap x6 M X1)) -> (p : Elem (Submodule R M)) -> Elem (Submodule X X1).

(; //LEAN:Submodule.mem_iSup_of_mem ;)
Submodule__mem_iSup_of_mem : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (I : Set) -> (b : Elem M) -> (p : (Elem I -> Submodule R M)) -> (i : Elem I) -> (h : Proof (Membership__mem (p i) b)) -> Proof (Membership__mem (iSup (i1 => p i1)) b).

(; //LEAN:Submodule.mk ;)
Submodule__mk : (toAddSubmonoid : Elem (AddSubmonoid M)) -> (smul_mem' : Proof (forall R (c => forall M (x3 => if (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup toAddSubmonoid)) x3) (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup toAddSubmonoid)) (HSMul__hSMul c x3)))))) -> Elem (Submodule R M).

(; //LEAN:Submodule.module ;)
Submodule__module : (p : Elem (Submodule R M)) -> Proof (Module R (Subtype (x2 => Membership__mem p x2))).

(; //LEAN:Submodule.prod._proof_1 ;)
Submodule__prod___proof_1 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (x5 : Elem (Submodule R M')) -> (c : Elem R) -> (x6 : Elem (Prod M M')) -> (h : Proof (Membership__mem (SProd__sprod p x5) x6)) -> Proof (Membership__mem (SProd__sprod p x5) (HSMul__hSMul c x6)).

(; //LEAN:Submodule.prod._proof_2 ;)
Submodule__prod___proof_2 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (x5 : Elem (Submodule R M')) -> (a : Elem (Prod M M')) -> (b : Elem (Prod M M')) -> (h : Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__prod (Submodule__toAddSubmonoid p) (Submodule__toAddSubmonoid x5)))) a)) -> (h1 : Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__prod (Submodule__toAddSubmonoid p) (Submodule__toAddSubmonoid x5)))) b)) -> Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__prod (Submodule__toAddSubmonoid p) (Submodule__toAddSubmonoid x5)))) (plus a b)).

(; //LEAN:Submodule.prod._proof_3 ;)
Submodule__prod___proof_3 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (x5 : Elem (Submodule R M')) -> Proof (Membership__mem (AddSubsemigroup__carrier (AddSubmonoid__toAddSubsemigroup (AddSubmonoid__prod (Submodule__toAddSubmonoid p) (Submodule__toAddSubmonoid x5)))) 0).

(; //LEAN:Submodule.prodEquiv._proof_1 ;)
Submodule__prodEquiv___proof_1 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M')) -> Proof (Function__LeftInverse (y => Prod__mk (Prod__fst y) (Prod__snd y)) (x5 => Prod__mk (Prod__fst x5) (Prod__snd x5))).

(; //LEAN:Submodule.prodEquiv._proof_10 ;)
Submodule__prodEquiv___proof_10 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M')) -> (x5 : Elem R) -> (x6 : Elem (Subtype (x9 => Membership__mem (Submodule__prod p q) x9))) -> Proof (Eqt (Prod (Subtype (x7 => Membership__mem p x7)) (Subtype (x8 => Membership__mem q x8))) (Prod__mk (Prod__fst (HSMul__hSMul x5 x6)) (Prod__snd (HSMul__hSMul x5 x6))) (Prod__mk (Prod__fst (HSMul__hSMul x5 x6)) (Prod__snd (HSMul__hSMul x5 x6)))).

(; //LEAN:Submodule.prodEquiv._proof_2 ;)
Submodule__prodEquiv___proof_2 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M')) -> Proof (Function__RightInverse (y => Prod__mk (Prod__fst y) (Prod__snd y)) (x5 => Prod__mk (Prod__fst x5) (Prod__snd x5))).

(; //LEAN:Submodule.prodEquiv._proof_7 ;)
Submodule__prodEquiv___proof_7 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (M' : Set) -> (_ : Proof (AddCommMonoid M')) -> (_ : Proof (Module R M')) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M')) -> (x5 : Elem (Subtype (x10 => Membership__mem (Submodule__prod p q) x10))) -> (x6 : Elem (Subtype (x9 => Membership__mem (Submodule__prod p q) x9))) -> Proof (Eqt (Prod (Subtype (x7 => Membership__mem p x7)) (Subtype (x8 => Membership__mem q x8))) (Prod__mk (Prod__fst (plus x5 x6)) (Prod__snd (plus x5 x6))) (Prod__mk (Prod__fst (plus x5 x6)) (Prod__snd (plus x5 x6)))).

(; doc: `V.restrictScalars S` is the `S`-submodule of the `S`-module given by restriction of scalars, corresponding to `V`, an `R`-submodule of the original `R`-module. ;)
(; //LEAN:Submodule.restrictScalars ;)
Submodule__restrictScalars : (S : Set) -> (V : Elem (Submodule R M)) -> Elem (Submodule S M).

(; //LEAN:Submodule.setLike ;)
Submodule__setLike : Proof (SetLike (Submodule R M) M).

(; doc: The span of a set `s ⊆ M` is the smallest submodule of M that contains `s`. ;)
(; //LEAN:Submodule.span ;)
Submodule__span : (R : Set) -> (s : Elem (powerset M)) -> Elem (Submodule R M).

(; //LEAN:Submodule.span_eq ;)
Submodule__span_eq : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Proof (Eqt (Submodule R M) (Submodule__span R p) p).

(; //LEAN:Submodule.span_eq_of_le ;)
Submodule__span_eq_of_le : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (s : Elem (powerset M)) -> (h : Proof (Set__Subset s p)) -> (h1 : Proof (Leq p (Submodule__span R s))) -> Proof (Eqt (Submodule R M) (Submodule__span R s) p).

(; //LEAN:Submodule.span_le ;)
Submodule__span_le : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> (p : Elem (Submodule R M)) -> Proof (iff (Leq (Submodule__span R s) p) (Set__Subset s p)).

(; //LEAN:Submodule.span_mono ;)
Submodule__span_mono : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> (t : Elem (powerset M)) -> (h : Proof (Set__Subset s t)) -> Proof (Leq (Submodule__span R s) (Submodule__span R t)).

(; //LEAN:Submodule.span_singleton_eq_range ;)
Submodule__span_singleton_eq_range : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (y : Elem M) -> Proof (Eqt (powerset M) (Submodule__span R (Singleton__singleton y)) (Set__range (x3 => HSMul__hSMul x3 y))).

(; //LEAN:Submodule.span_singleton_le_iff_mem._simp_1 ;)
Submodule__span_singleton_le_iff_mem___simp_1 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (m : Elem M) -> (p : Elem (Submodule R M)) -> Proof (Eqt Prop (Leq (Submodule__span R (Singleton__singleton m)) p) (Membership__mem p m)).

(; doc: For any `R` submodules `p` and `q`, `p ⊓ q` as a submodule of `q`. ;)
(; //LEAN:Submodule.submoduleOf ;)
Submodule__submoduleOf : (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M)) -> Elem (Submodule R (Subtype (x3 => Membership__mem q x3))).

(; //LEAN:Submodule.subset_span ;)
Submodule__subset_span : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> Proof (Set__Subset s (Submodule__span R s)).

(; doc: Embedding of a submodule `p` to the ambient space `M`. ;)
(; //LEAN:Submodule.subtype ;)
Submodule__subtype : (p : Elem (Submodule R M)) -> Elem (LinearMap (RingHom__id R) (Subtype (x2 => Membership__mem p x2)) M).

(; doc: Reinterpret a submodule as an additive subgroup. ;)
(; //LEAN:Submodule.toAddSubgroup ;)
Submodule__toAddSubgroup : (p : Elem (Submodule R M)) -> Elem (AddSubgroup M).

(; doc: Reinterpret a `Submodule` as an `AddSubmonoid`. ;)
(; //LEAN:Submodule.toAddSubmonoid ;)
Submodule__toAddSubmonoid : (self : Elem (Submodule R M)) -> Elem (AddSubmonoid M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.ext_iff ;)
Subtype__ext_iff : (X : Set) -> (p : (Elem X -> Prop)) -> (a1 : Elem (Subtype (x2 => p x2))) -> (a2 : Elem (Subtype (x1 => p x1))) -> Proof (iff (Eqt (Subtype (x => p x)) a1 a2) (Eqt X a1 a2)).

(; doc: Supremum of a set ;)
(; //LEAN:SupSet.sSup ;)
SupSet__sSup : (x : Elem (powerset X)) -> Elem X.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Units of a `Monoid`, bundled version. Notation: `αˣ`.  An element of a `Monoid` is a unit if it has a two-sided inverse. This version bundles the inverse element so that it can be computed. For a predicate see `IsUnit`. ;)
(; //LEAN:Units ;)
Units : (X : Set) -> Set.

(; doc: `WCovBy a b` means that `a = b` or `b` covers `a`. This means that `a ≤ b` and there is no element in between. This is denoted `a ⩿ b`. ;)
(; //LEAN:WCovBy ;)
WCovBy : (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: By definition, if we have `ZeroMemClass S M`, we have `0 ∈ s` for all `s : S`. ;)
(; //LEAN:ZeroMemClass.zero_mem ;)
ZeroMemClass__zero_mem : (S : Set) -> (M : Elem (outParam Set)) -> (x : Proof (Zero M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (ZeroMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem s 0).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (x : (Elem X -> Y)) -> (x1 : (Elem X -> Y)) -> (x2 : Elem X) -> (x3 : Elem X) -> (h : Proof (Eqt (Elem X -> Y) x x1)) -> (h1 : Proof (Eqt X x2 x3)) -> Proof (Eqt Y (x x2) (x1 x3)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; //LEAN:ge_of_eq ;)
ge_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (s : (Elem I -> X)) -> Elem X.

(; doc: Indexed supremum ;)
(; //LEAN:iSup ;)
iSup : (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_bot_iff ;)
le_bot_iff : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> Proof (iff (Leq a Bot__bot) (Eqt X a Bot__bot)).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_sSup ;)
le_sSup : (X : Set) -> (_ : Proof (CompleteSemilatticeSup X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (h : Proof (Membership__mem s a)) -> Proof (Leq a (SupSet__sSup s)).

(; //LEAN:le_top ;)
le_top : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Leq a Top__top).

(; doc: The collection of elements of a `MonoidWithZero` that are not right zero divisors form a `Submonoid`. ;)
(; //LEAN:nonZeroDivisorsRight ;)
nonZeroDivisorsRight : (X : Set) -> Elem (Submonoid X).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_smul ;)
one_smul : (M : Set) -> (X : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (MulAction M X)) -> (b : Elem X) -> Proof (Eqt X (HSMul__hSMul 1 b) b).

(; //LEAN:or_iff_left_of_imp ;)
or_iff_left_of_imp : (b : Prop) -> (a : Prop) -> (hb : Proof (if b a)) -> Proof (iff (or a b) a).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:right_lt_sup._simp_2 ;)
right_lt_sup___simp_2 : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Prop (Lt b (Max__max a b)) (not (Leq a b))).

(; //LEAN:smul_eq_zero ;)
smul_eq_zero : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (r : Elem R) -> (m : Elem M) -> (_ : Proof (Module__IsTorsionFree R M)) -> (_ : Proof (IsCancelMulZero R)) -> Proof (iff (Eqt M (HSMul__hSMul r m) 0) (or (Eqt R r 0) (Eqt M m 0))).

