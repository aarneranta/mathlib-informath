(; doc: `V.restrictScalars S` is the `S`-submodule of the `S`-module given by restriction of scalars, corresponding to `V`, an `R`-submodule of the original `R`-module. ;)
(; //LEAN:Submodule.restrictScalars ;)
Submodule__restrictScalars : (S : Set) -> (R : Set) -> (M : Set) -> (V : Elem (Submodule R M)) -> Elem (Submodule S M).

(; //LEAN:Submodule.setLike ;)
Submodule__setLike : (R : Set) -> (M : Set) -> Proof (SetLike (Submodule R M) M).

(; //LEAN:Submodule.smul_mem ;)
Submodule__smul_mem : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (r : Elem R) -> (h : Proof (Membership__mem M (Submodule R M) p x2)) -> Proof (Membership__mem M (Submodule R M) p (HSMul__hSMul R M M r x2)).

(; doc: The span of a set `s ⊆ M` is the smallest submodule of M that contains `s`. ;)
(; //LEAN:Submodule.span ;)
Submodule__span : (R : Set) -> (M : Set) -> (s : Elem (powerset M)) -> Elem (Submodule R M).

(; //LEAN:Submodule.span_eq ;)
Submodule__span_eq : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Proof (Eqt (Submodule R M) (Submodule__span R M (SetLike__coe (Submodule R M) M p)) p).

(; //LEAN:Submodule.span_eq_of_le ;)
Submodule__span_eq_of_le : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (s : Elem (powerset M)) -> (h1 : Proof (Set__Subset M s (SetLike__coe (Submodule R M) M p))) -> (h2 : Proof (Leq p (Submodule__span R M s))) -> Proof (Eqt (Submodule R M) (Submodule__span R M s) p).

(; //LEAN:Submodule.span_le ;)
Submodule__span_le : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> (p : Elem (Submodule R M)) -> Proof (iff (Leq (Submodule__span R M s) p) (Set__Subset M s (SetLike__coe (Submodule R M) M p))).

(; //LEAN:Submodule.span_mono ;)
Submodule__span_mono : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> (t : Elem (powerset M)) -> (h : Proof (Set__Subset M s t)) -> Proof (Leq (Submodule__span R M s) (Submodule__span R M t)).

(; //LEAN:Submodule.span_singleton_eq_range ;)
Submodule__span_singleton_eq_range : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (y : Elem M) -> Proof (Eqt (powerset M) (SetLike__coe (Submodule R M) M (Submodule__span R M (Singleton__singleton M (powerset M) y))) (Set__range M R (x3 => HSMul__hSMul R M M x3 y))).

(; //LEAN:Submodule.span_singleton_le_iff_mem._simp_1 ;)
Submodule__span_singleton_le_iff_mem___simp_1 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (m : Elem M) -> (p : Elem (Submodule R M)) -> Proof (Eqt Prop (Leq (Submodule__span R M (Singleton__singleton M (powerset M) m)) p) (Membership__mem M (Submodule R M) p m)).

(; doc: For any `R` submodules `p` and `q`, `p ⊓ q` as a submodule of `q`. ;)
(; //LEAN:Submodule.submoduleOf ;)
Submodule__submoduleOf : (R : Set) -> (M : Set) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M)) -> Elem (Submodule R (Subtype M (x3 => Membership__mem M (Submodule R M) q x3))).

(; //LEAN:Submodule.subset_span ;)
Submodule__subset_span : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (s : Elem (powerset M)) -> Proof (Set__Subset M s (SetLike__coe (Submodule R M) M (Submodule__span R M s))).

(; doc: Embedding of a submodule `p` to the ambient space `M`. ;)
(; //LEAN:Submodule.subtype ;)
Submodule__subtype : (R : Set) -> (M : Set) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Elem (LinearMap R R (RingHom__id R) (Subtype M (x2 => Membership__mem M (Submodule R M) p x2)) M).

(; doc: Reinterpret a submodule as an additive subgroup. ;)
(; //LEAN:Submodule.toAddSubgroup ;)
Submodule__toAddSubgroup : (R : Set) -> (M : Set) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Elem (AddSubgroup M).

(; doc: Reinterpret a `Submodule` as an `AddSubmonoid`. ;)
(; //LEAN:Submodule.toAddSubmonoid ;)
Submodule__toAddSubmonoid : (R : Set) -> (M : Set) -> (self : Elem (Submodule R M)) -> Elem (AddSubmonoid M).

(; doc: A submonoid of a monoid `M` is a subset containing 1 and closed under multiplication. ;)
(; //LEAN:Submonoid ;)
Submonoid : (M : Set) -> Set.

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; //LEAN:Subtype.ext_iff ;)
Subtype__ext_iff : (X : Set) -> (p : (Elem X -> Prop)) -> (a1 : Elem (Subtype X (x4 => p x4))) -> (a2 : Elem (Subtype X (x3 => p x3))) -> Proof (iff (Eqt (Subtype X (x => p x)) a1 a2) (Eqt X (Subtype__val X (x1 => p x1) a1) (Subtype__val X (x2 => p x2) a2))).

(; //LEAN:Subtype.mk ;)
Subtype__mk : (X : Set) -> (p : (Elem X -> Prop)) -> (val : Elem X) -> (property : Proof (p val)) -> Elem (Subtype X (x => p x)).

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: Supremum of a set ;)
(; //LEAN:SupSet.sSup ;)
SupSet__sSup : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : (X : Set) -> Elem X.

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; doc: Units of a `Monoid`, bundled version. Notation: `αˣ`.  An element of a `Monoid` is a unit if it has a two-sided inverse. This version bundles the inverse element so that it can be computed. For a predicate see `IsUnit`. ;)
(; //LEAN:Units ;)
Units : (X : Set) -> Set.

(; doc: `WCovBy a b` means that `a = b` or `b` covers `a`. This means that `a ≤ b` and there is no element in between. This is denoted `a ⩿ b`. ;)
(; //LEAN:WCovBy ;)
WCovBy : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: By definition, if we have `ZeroMemClass S M`, we have `0 ∈ s` for all `s : S`. ;)
(; //LEAN:ZeroMemClass.zero_mem ;)
ZeroMemClass__zero_mem : (S : Set) -> (M : Set) -> (x : Proof (Zero M)) -> (x1 : Proof (SetLike S M)) -> (_ : Proof (ZeroMemClass S M)) -> (s : Elem S) -> Proof (Membership__mem M S s 0).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (f1 : (Elem X -> Y)) -> (f2 : (Elem X -> Y)) -> (a1 : Elem X) -> (a2 : Elem X) -> (h1 : Proof (Eqt (Elem X -> Y) f1 f2)) -> (h2 : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f1 a1) (f2 a2)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (a1 : Elem X) -> (a2 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f a1) (f a2)).

(; //LEAN:ge_of_eq ;)
ge_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; doc: Indexed supremum ;)
(; //LEAN:iSup ;)
iSup : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_bot_iff ;)
le_bot_iff : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> Proof (iff (Leq a (Bot__bot X)) (Eqt X a (Bot__bot X))).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_sSup ;)
le_sSup : (X : Set) -> (_ : Proof (CompleteSemilatticeSup X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (h : Proof (Membership__mem X (powerset X) s a)) -> Proof (Leq a (SupSet__sSup X s)).

(; //LEAN:le_top ;)
le_top : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Leq a (Top__top X)).

(; doc: The collection of elements of a `MonoidWithZero` that are not right zero divisors form a `Submonoid`. ;)
(; //LEAN:nonZeroDivisorsRight ;)
nonZeroDivisorsRight : (X : Set) -> Elem (Submonoid X).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_smul ;)
one_smul : (M : Set) -> (X : Set) -> (_ : Proof (Monoid M)) -> (_ : Proof (MulAction M X)) -> (b : Elem X) -> Proof (Eqt X (HSMul__hSMul M X X 1 b) b).

(; //LEAN:or_iff_left_of_imp ;)
or_iff_left_of_imp : (b : Prop) -> (a : Prop) -> (hb : Proof (if b a)) -> Proof (iff (or a b) a).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:right_lt_sup._simp_2 ;)
right_lt_sup___simp_2 : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Prop (Lt b (Max__max X a b)) (not (Leq a b))).

(; //LEAN:smul_eq_zero ;)
smul_eq_zero : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (r : Elem R) -> (m : Elem M) -> (_ : Proof (Module__IsTorsionFree R M)) -> (_ : Proof (IsCancelMulZero R)) -> Proof (iff (Eqt M (HSMul__hSMul R M M r m) 0) (or (Eqt R r 0) (Eqt M m 0))).

