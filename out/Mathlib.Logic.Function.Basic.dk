(; //LEAN:Function.invFun_comp ;)
def Function__invFun_comp : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective X Y f)) -> Proof (Eqt (Elem X -> X) (Function__comp X Y X (Function__invFun X Y f) f) (id X)) :=
  X => Y => f => hf => funext X (x => X) (Function__comp X Y X (Function__invFun X Y f) f) (id X) (Function__leftInverse_invFun X Y f hf).

(; //LEAN:Function.Injective.hasLeftInverse ;)
def Function__Injective__hasLeftInverse : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective X Y f)) -> Proof (Function__HasLeftInverse X Y f) :=
  X => Y => f => hf => existsI (Elem Y -> X) (finv => Function__LeftInverse X Y finv f) (Function__invFun X Y f) (Function__leftInverse_invFun X Y f hf).

(; //LEAN:Function.injective_iff_hasLeftInverse ;)
def Function__injective_iff_hasLeftInverse : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Proof (iff (Function__Injective X Y f) (Function__HasLeftInverse X Y f)) :=
  X => Y => f => iffI (Function__Injective X Y f) (Function__HasLeftInverse X Y f) (Function__Injective__hasLeftInverse X Y f) (Function__HasLeftInverse__injective X Y f).

(; //LEAN:Function.surjInv ;)
def Function__surjInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (h : Proof (Function__Surjective X Y f)) -> (b : Elem Y) -> Elem X :=
  X => Y => f => h => b => Classical__choose X (x => Eqt Y (f x) b) (h b).

(; //LEAN:Function.surjInv_eq ;)
def Function__surjInv_eq : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (h : Proof (Function__Surjective X Y f)) -> (b : Elem Y) -> Proof (Eqt Y (f (Function__surjInv X Y f h b)) b) :=
  X => Y => f => h => b => Classical__choose_spec X (x => Eqt Y (f x) b) (forallE Y (b1 => exists X (a => Eqt Y (f a) b1)) h b).

(; //LEAN:Function.comp_surjInv ;)
def Function__comp_surjInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Surjective X Y f)) -> Proof (Eqt (Elem Y -> Y) (Function__comp Y X Y f (Function__surjInv X Y f hf)) (id Y)) :=
  X => Y => f => hf => funext Y (x => Y) (Function__comp Y X Y f (Function__surjInv X Y f hf)) (id Y) (Function__surjInv_eq X Y f hf).

(; //LEAN:Function.rightInverse_surjInv ;)
def Function__rightInverse_surjInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Surjective X Y f)) -> Proof (Function__RightInverse X Y (Function__surjInv X Y f hf) f) :=
