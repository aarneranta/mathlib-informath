  s => f => g => i => ite (Membership__mem s i) (f i) (g i).

(; //LEAN:eq_rec_on_bijective ;)
eq_rec_on_bijective : (X : Set) -> (C : (Elem X -> Set)) -> (a : Elem X) -> (a' : Elem X) -> (h : Proof (Eqt X a a')) -> Proof (Function__Bijective (x => Eq__ndrec x h)).

(; //LEAN:eq_mp_bijective ;)
eq_mp_bijective : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> Proof (Function__Bijective (Eq__mp h)).

(; //LEAN:eq_mpr_bijective ;)
eq_mpr_bijective : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> Proof (Function__Bijective (Eq__mpr h)).

(; //LEAN:cast_bijective ;)
cast_bijective : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> Proof (Function__Bijective (cast h)).

(; //LEAN:eq_rec_inj ;)
def eq_rec_inj : (X : Set) -> (a : Elem X) -> (a' : Elem X) -> (h : Proof (Eqt X a a')) -> (C : (Elem X -> Set)) -> (x : Elem (C a)) -> (y : Elem (C a)) -> Proof (iff (Eqt (C a') (Eq__ndrec x h) (Eq__ndrec y h)) (Eqt (C a) x y)) :=
  X => a => a' => h => C => x => y => Function__Injective__eq_iff (C a) (C a') (x1 => Eq__ndrec x1 h) (Function__Bijective__injective (C a) (C a') (x2 => Eq__ndrec x2 h) (eq_rec_on_bijective X C a a' h)) x y.

(; //LEAN:cast_inj ;)
def cast_inj : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (x : Elem X) -> (y : Elem X) -> Proof (iff (Eqt Y (cast h x) (cast h y)) (Eqt X x y)) :=
  X => Y => h => x => y => Function__Injective__eq_iff X Y (cast h) (Function__Bijective__injective X Y (cast h) (cast_bijective X Y h)) x y.

(; //LEAN:Function.LeftInverse.eq_rec_eq ;)
Function__LeftInverse__eq_rec_eq : (X : Set) -> (Y : Set) -> (x : (Elem Y -> Set)) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> X)) -> (h : Proof (Function__LeftInverse g f)) -> (C : ((a1 : Elem X) -> x (f a1))) -> (a : Elem X) -> Proof (Eqt (x (f a)) (Eq__rec (C (g (f a))) (congr_arg f (h a))) (C a)).

(; //LEAN:Function.LeftInverse.eq_rec_on_eq ;)
def Function__LeftInverse__eq_rec_on_eq : (X : Set) -> (Y : Set) -> (x : (Elem Y -> Set)) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> X)) -> (h : Proof (Function__LeftInverse g f)) -> (C : ((a1 : Elem X) -> x (f a1))) -> (a : Elem X) -> Proof (Eqt (x (f a)) (Eq__recOn (congr_arg f (h a)) (C (g (f a)))) (C a)) :=
  X => Y => x => f => g => h => C => a => Function__LeftInverse__eq_rec_eq X Y x f g h C a.

(; //LEAN:Function.LeftInverse.cast_eq ;)
Function__LeftInverse__cast_eq : (X : Set) -> (Y : Set) -> (x : (Elem Y -> Set)) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> X)) -> (h : Proof (Function__LeftInverse g f)) -> (C : ((a2 : Elem X) -> x (f a2))) -> (a : Elem X) -> Proof (Eqt (x (f a)) (cast (congr_arg (a1 => x (f a1)) (h a)) (C (g (f a)))) (C a)).

(; //LEAN:Set.SeparatesPoints ;)
def Set__SeparatesPoints : (A : Elem (powerset (Elem X -> Y))) -> Prop :=
  A => forall X (x => forall X (y => if (Neq x y) (exists (Elem X -> Y) (f => and (Membership__mem A f) (Neq (f x) (f y)))))).

(; //LEAN:Set.separatesPoints_mono ;)
Set__separatesPoints_mono : (X : Set) -> (Y : Set) -> (A : Elem (powerset (Elem X -> Y))) -> (B : Elem (powerset (Elem X -> Y))) -> (hAB : Proof (Set__Subset A B)) -> (hA : Proof (Set__SeparatesPoints A)) -> Proof (Set__SeparatesPoints B).

(; //LEAN:InvImage.equivalence ;)
def InvImage__equivalence : (X : Set) -> (Y : Set) -> (r : (Elem Y -> Elem Y -> Prop)) -> (f : (Elem X -> Y)) -> (h : Proof (Equivalence r)) -> Proof (Equivalence (InvImage r f)) :=
  X => Y => r => f => h => Equivalence__mk X (InvImage r f) (forallI X (x => r (f x) (f x)) (x => Equivalence__refl Y r h (f x))) (forallI X (x1 => forall X (x3 => if (r (f x1) (f x3)) (r (f x3) (f x1)))) (x1 => forallI X (x2 => if (r (f x1) (f x2)) (r (f x2) (f x1))) (x2 => Equivalence__symm Y r h (f x1) (f x2)))) (forallI X (x4 => forall X (x8 => forall X (x9 => if (r (f x4) (f x8)) (if (r (f x8) (f x9)) (r (f x4) (f x9)))))) (x4 => forallI X (x5 => forall X (x7 => if (r (f x4) (f x5)) (if (r (f x5) (f x7)) (r (f x4) (f x7))))) (x5 => forallI X (x6 => if (r (f x4) (f x5)) (if (r (f x5) (f x6)) (r (f x4) (f x6)))) (x6 => Equivalence__trans Y r h (f x4) (f x5) (f x6))))).

(; //LEAN:Pi.map_id ;)
def Pi__map_id : (I : Set) -> (x : (Elem I -> Set)) -> Proof (Eqt (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x i) (Pi__map (i2 => id)) id) :=
  I => x => rfl (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x i) (Pi__map (i2 => id)).

(; //LEAN:Pi.map_id' ;)
def Pi__map_id' : (I : Set) -> (x : (Elem I -> Set)) -> Proof (Eqt (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x i) (Pi__map (i2 => a => a)) (x2 => x2)) :=
  I => x => rfl (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x i) (Pi__map (i2 => a => a)).

(; //LEAN:Pi.map_comp_map ;)
def Pi__map_comp_map : (I : Set) -> (x : (Elem I -> Set)) -> (x1 : (Elem I -> Set)) -> (x2 : (Elem I -> Set)) -> (f : ((i4 : Elem I) -> Elem (x i4) -> x1 i4)) -> (g : ((i3 : Elem I) -> Elem (x1 i3) -> x2 i3)) -> Proof (Eqt (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x2 i) (Function__comp (Pi__map g) (Pi__map f)) (Pi__map (i2 => Function__comp (g i2) (f i2)))) :=
  I => x => x1 => x2 => f => g => rfl (((i1 : Elem I) -> x i1) -> (i : Elem I) -> x2 i) (Function__comp (Pi__map g) (Pi__map f)).

