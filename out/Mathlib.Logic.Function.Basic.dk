(; //LEAN:Function.rightInverse_invFun ;)
def Function__rightInverse_invFun : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Surjective X Y f)) -> Proof (Function__RightInverse X Y (Function__invFun X Y f) f) :=
  X => Y => f => hf => forallI Y (b => Eqt Y (f (Function__invFun X Y f b)) b) (b => Function__invFun_eq X Y f b (forallE Y (b1 => exists X (a => Eqt Y (f a) b1)) hf b)).

(; //LEAN:Function.leftInverse_invFun ;)
