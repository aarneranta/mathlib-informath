  X => Y => r => f => h => Equivalence__mk X (InvImage X Y r f) (forallI X (x => r (f x) (f x)) (x => Equivalence__refl Y r h (f x))) (forallI X (x1 => forall X (x3 => if (r (f x1) (f x3)) (r (f x3) (f x1)))) (x1 => forallI X (x2 => if (r (f x1) (f x2)) (r (f x2) (f x1))) (x2 => Equivalence__symm Y r h (f x1) (f x2)))) (forallI X (x4 => forall X (x8 => forall X (x9 => if (r (f x4) (f x8)) (if (r (f x8) (f x9)) (r (f x4) (f x9)))))) (x4 => forallI X (x5 => forall X (x7 => if (r (f x4) (f x5)) (if (r (f x5) (f x7)) (r (f x4) (f x7))))) (x5 => forallI X (x6 => if (r (f x4) (f x5)) (if (r (f x5) (f x6)) (r (f x4) (f x6)))) (x6 => Equivalence__trans Y r h (f x4) (f x5) (f x6))))).

(; //LEAN:Pi.map_id ;)
def Pi__map_id : (I : Set) -> (alpha : (Elem I -> Set)) -> Proof (Eqt (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> alpha i) (Pi__map I alpha alpha (i2 => id (alpha i2))) (id ((i3 : Elem I) -> alpha i3))) :=
  I => alpha => rfl (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> alpha i) (Pi__map I alpha alpha (i2 => id (alpha i2))).

(; //LEAN:Pi.map_id' ;)
def Pi__map_id' : (I : Set) -> (alpha : (Elem I -> Set)) -> Proof (Eqt (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> alpha i) (Pi__map I alpha alpha (i2 => a => a)) (x1 => x1)) :=
  I => alpha => rfl (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> alpha i) (Pi__map I alpha alpha (i2 => a => a)).

(; //LEAN:Pi.map_comp_map ;)
def Pi__map_comp_map : (I : Set) -> (alpha : (Elem I -> Set)) -> (beta : (Elem I -> Set)) -> (gamma : (Elem I -> Set)) -> (f : ((i7 : Elem I) -> Elem (alpha i7) -> beta i7)) -> (g : ((i6 : Elem I) -> Elem (beta i6) -> gamma i6)) -> Proof (Eqt (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> gamma i) (Function__comp ((i2 : Elem I) -> alpha i2) ((i3 : Elem I) -> beta i3) ((i4 : Elem I) -> gamma i4) (Pi__map I beta gamma g) (Pi__map I alpha beta f)) (Pi__map I alpha gamma (i5 => Function__comp (alpha i5) (beta i5) (gamma i5) (g i5) (f i5)))) :=
  I => alpha => beta => gamma => f => g => rfl (((i1 : Elem I) -> alpha i1) -> (i : Elem I) -> gamma i) (Function__comp ((i2 : Elem I) -> alpha i2) ((i3 : Elem I) -> beta i3) ((i4 : Elem I) -> gamma i4) (Pi__map I beta gamma g) (Pi__map I alpha beta f)).

