(; //LEAN:Function.invFun_surjective ;)
def Function__invFun_surjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective X Y f)) -> Proof (Function__Surjective Y X (Function__invFun X Y f)) :=
