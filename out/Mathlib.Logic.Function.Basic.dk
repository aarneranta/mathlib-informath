(; //LEAN:Function.partialInv ;)
def Function__partialInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (b : Elem Y) -> Elem (Option X) :=
  X => Y => f => b => dite (Option X) (exists X (a => Eqt Y (f a) b)) (h => Option__some X (Classical__choose X (x => Eqt Y (f x) b) h)) (h1 => Option__none X).

(; //LEAN:Function.Injective.isPartialInv ;)
Function__Injective__isPartialInv : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (I : Proof (Function__Injective X Y f)) -> Proof (Function__IsPartialInv X Y f (Function__partialInv X Y f)).

(; //LEAN:Function.partialInv_left ;)
def Function__partialInv_left : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (I : Proof (Function__Injective X Y f)) -> (x : Elem X) -> Proof (Eqt (Option X) (Function__partialInv X Y f (f x)) (Option__some X x)) :=
  X => Y => f => I => Function__IsPartialInv__eq X Y f (Function__partialInv X Y f) (Function__Injective__isPartialInv X Y f I).

(; //LEAN:Function.invFun ;)
def Function__invFun : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x : Elem Y) -> Elem X :=
  X => Y => f => x => dite X (exists X (x1 => Eqt Y (f x1) x)) (h1 => Exists__choose X (x2 => Eqt Y (f x2) x) h1) (h2 => Classical__arbitrary X).

(; //LEAN:Function.invFun_eq ;)
Function__invFun_eq : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (b : Elem Y) -> (h1 : Proof (exists X (a => Eqt Y (f a) b))) -> Proof (Eqt Y (f (Function__invFun X Y f b)) b).

(; //LEAN:Function.apply_invFun_apply ;)
def Function__apply_invFun_apply : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (a : Elem X) -> Proof (Eqt Y (f (Function__invFun X Y f (f a))) (f a)) :=
  X => Y => f => a => Function__invFun_eq X Y f (f a) (existsI X (a1 => Eqt Y (f a1) (f a)) a (rfl Y (f a))).

(; //LEAN:Function.invFun_neg ;)
def Function__invFun_neg : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (b : Elem Y) -> (h1 : Proof (not (exists X (a => Eqt Y (f a) b)))) -> Proof (Eqt X (Function__invFun X Y f b) (Classical__choice X h)) :=
  X => Y => f => b => h1 => dite_eq_right (exists X (a => Eqt Y (f a) b)) (Classical__propDecidable (exists X (x => Eqt Y (f x) b))) h1 X (h2 => Exists__choose X (x1 => Eqt Y (f x1) b) h2) (h3 => Classical__arbitrary X).

