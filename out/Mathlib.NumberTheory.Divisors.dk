(; //LEAN:Nat.divisors ;)
def Nat__divisors : (n : Elem Nat) -> Elem (Finset Nat) :=
  n => Finset__filter (d => divide d n) (Finset__Ico 1 (plus n 1)).

(; //LEAN:Nat.properDivisors ;)
def Nat__properDivisors : (n : Elem Nat) -> Elem (Finset Nat) :=
  n => Finset__filter (d => divide d n) (Finset__Ico 1 n).

