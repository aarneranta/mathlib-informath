(; constants used by Mathlib.Order.Basic, declared with their translated types ;)

(; //LEAN:Classical.or_iff_not_imp_left ;)
Classical__or_iff_not_imp_left : (a : Prop) -> (b : Prop) -> Proof (iff (or a b) (if (not a) b)).

(; doc: Set / lattice complement ;)
(; //LEAN:Compl ;)
Compl : (X : Set) -> Prop.

(; doc: Set / lattice complement  Conventions for notations in identifiers:   * The recommended spelling of `ᶜ` in identifiers is `compl`. ;)
(; //LEAN:Compl.compl ;)
Compl__compl : (x : Elem X) -> Elem X.

(; doc: Construct a `q` if some proposition `p` is decidable, and both the truth and falsity of `p` are sufficient to construct a `q`.  This is a synonym for `dite`, the dependent if-then-else operator. ;)
(; //LEAN:Decidable.byCases ;)
Decidable__byCases : (h1 : (Proof p -> q)) -> (h2 : (Proof (not p) -> q)) -> Elem q.

(; //LEAN:Decidable.le_iff_lt_or_eq ;)
Decidable__le_iff_lt_or_eq : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Leq a b) (or (Lt a b) (Eqt X a b))).

(; //LEAN:Decidable.lt_or_eq_of_le ;)
Decidable__lt_or_eq_of_le : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> Proof (or (Lt a b) (Eqt X a b)).

(; //LEAN:Decidable.lt_or_eq_of_le' ;)
Decidable__lt_or_eq_of_le' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq b a)) -> Proof (or (Lt b a) (Eqt X a b)).

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Function.Injective.linearOrder._proof_2 ;)
Function__Injective__linearOrder___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (le : Proof (forall X (x6 => forall X (y1 => iff (Leq (f x6) (f y1)) (Leq x6 y1))))) -> (lt : Proof (forall X (x5 => forall X (y => iff (Lt (f x5) (f y)) (Lt x5 y))))) -> (x3 : Elem X) -> (x4 : Elem X) -> Proof (or (Leq x3 x4) (Leq x4 x3)).

(; //LEAN:Function.Injective.linearOrder._proof_4 ;)
Function__Injective__linearOrder___proof_4 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (_ : Proof (Min X)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (le : Proof (forall X (x9 => forall X (y2 => iff (Leq (f x9) (f y2)) (Leq x9 y2))))) -> (lt : Proof (forall X (x8 => forall X (y1 => iff (Lt (f x8) (f y1)) (Lt x8 y1))))) -> (min : Proof (forall X (x7 => forall X (y => Eqt Y (f (Min__min x7 y)) (Min__min (f x7) (f y)))))) -> (x5 : Elem X) -> (x6 : Elem X) -> Proof (Eqt X (Min__min x5 x6) (ite (Leq x5 x6) x5 x6)).

(; //LEAN:Function.Injective.linearOrder._proof_6 ;)
Function__Injective__linearOrder___proof_6 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (_ : Proof (Max X)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (le : Proof (forall X (x9 => forall X (y2 => iff (Leq (f x9) (f y2)) (Leq x9 y2))))) -> (lt : Proof (forall X (x8 => forall X (y1 => iff (Lt (f x8) (f y1)) (Lt x8 y1))))) -> (max : Proof (forall X (x7 => forall X (y => Eqt Y (f (Max__max x7 y)) (Max__max (f x7) (f y)))))) -> (x5 : Elem X) -> (x6 : Elem X) -> Proof (Eqt X (Max__max x5 x6) (ite (Leq x5 x6) x6 x5)).

(; //LEAN:Function.Injective.linearOrder._proof_7 ;)
Function__Injective__linearOrder___proof_7 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (_ : Proof (Ord X)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (le : Proof (forall X (x10 => forall X (y2 => iff (Leq (f x10) (f y2)) (Leq x10 y2))))) -> (lt : Proof (forall X (x9 => forall X (y1 => iff (Lt (f x9) (f y1)) (Lt x9 y1))))) -> (compare : Proof (forall X (x8 => forall X (y => Eqt Ordering (Ord__compare (f x8) (f y)) (Ord__compare x8 y))))) -> (x6 : Elem X) -> (x7 : Elem X) -> Proof (Eqt Ordering (Ord__compare x6 x7) (compareOfLessAndEq x6 x7)).

(; //LEAN:Function.Injective.partialOrder._proof_1 ;)
Function__Injective__partialOrder___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (PartialOrder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Injective f)) -> (le : Proof (forall X (x6 => forall X (y1 => iff (Leq (f x6) (f y1)) (Leq x6 y1))))) -> (lt : Proof (forall X (x5 => forall X (y => iff (Lt (f x5) (f y)) (Lt x5 y))))) -> (x3 : Elem X) -> (x4 : Elem X) -> (h : Proof (Leq x3 x4)) -> (h1 : Proof (Leq x4 x3)) -> Proof (Eqt X x3 x4).

(; //LEAN:Function.Injective.preorder._proof_1 ;)
Function__Injective__preorder___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder Y)) -> (_ : Proof (LE X)) -> (_ : Proof (LT X)) -> (f : (Elem X -> Y)) -> (le : Proof (forall X (x6 => forall X (y1 => iff (Leq (f x6) (f y1)) (Leq x6 y1))))) -> (lt : Proof (forall X (x5 => forall X (y => iff (Lt (f x5) (f y)) (Lt x5 y))))) -> (x3 : Elem X) -> (x4 : Elem X) -> Proof (iff (Lt x3 x4) (and (Leq x3 x4) (not (Leq x4 x3)))).

(; //LEAN:Function.Injective.preorder._proof_2 ;)
Function__Injective__preorder___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder Y)) -> (_ : Proof (LE X)) -> (f : (Elem X -> Y)) -> (le : Proof (forall X (x3 => forall X (y => iff (Leq (f x3) (f y)) (Leq x3 y))))) -> (x2 : Elem X) -> Proof (Leq x2 x2).

(; //LEAN:Function.Injective.preorder._proof_3 ;)
Function__Injective__preorder___proof_3 : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder Y)) -> (_ : Proof (LE X)) -> (f : (Elem X -> Y)) -> (le : Proof (forall X (x5 => forall X (y => iff (Leq (f x5) (f y)) (Leq x5 y))))) -> (x2 : Elem X) -> (x3 : Elem X) -> (x4 : Elem X) -> (h : Proof (Leq x2 x3)) -> (h1 : Proof (Leq x3 x4)) -> Proof (Leq x2 x4).

(; doc: Function composition, usually written with the infix operator `∘`. A new function is created from two existing functions, where one function's output is used as input to the other.  Examples:  * `Function.comp List.reverse (List.drop 2) [3, 2, 4, 1] = [1, 4]`  * `(List.reverse ∘ List.drop 2) [3, 2, 4, 1] = [1, 4]`  Conventions for notations in identifiers:   * The recommended spelling of `∘` in identifiers is `comp`. ;)
(; //LEAN:Function.comp ;)
Function__comp : (f : (Elem Y -> W)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> Elem W.

(; doc: The constant function that ignores its argument.  If `a : α`, then `Function.const β a : β → α` is the “constant function with value `a`”. For all arguments `b : β`, `Function.const β a b = a`. It is often written directly as `fun _ => a`.  Examples:  * `Function.const Bool 10 true = 10`  * `Function.const Bool 10 false = 10`  * `Function.const String 10 "any string" = 10` ;)
(; //LEAN:Function.const ;)
Function__const : (Y : Set) -> (a : Elem X) -> (x : Elem Y) -> Elem X.

(; //LEAN:Function.forall_update_iff ;)
Function__forall_update_iff : (X : Set) -> (x : (Elem X -> Set)) -> (f : ((a2 : Elem X) -> x a2)) -> (a : Elem X) -> (b : Elem (x a)) -> (p : ((a1 : Elem X) -> Elem (x a1) -> Prop)) -> Proof (iff (forall X (x2 => p x2 (Function__update f a b x2))) (and (p a b) (forall X (x3 => if (Neq x3 a) (p x3 (f x3)))))).

(; doc: Replacing the value of a function at a given point by a given value. ;)
(; //LEAN:Function.update ;)
Function__update : (f : ((a1 : Elem X) -> x a1)) -> (a' : Elem X) -> (v : Elem (x a')) -> (a : Elem X) -> Elem (x a).

(; doc: Syntax typeclass for Heyting implication `⇨`. ;)
(; //LEAN:HImp ;)
HImp : (X : Set) -> Prop.

(; doc: Heyting implication `⇨`  Conventions for notations in identifiers:   * The recommended spelling of `⇨` in identifiers is `himp`. ;)
(; //LEAN:HImp.himp ;)
HImp__himp : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Syntax typeclass for Heyting negation `￢`.  The difference between `Compl` and `HNot` is that the former belongs to Heyting algebras, while the latter belongs to co-Heyting algebras. They are both pseudo-complements, but `compl` underestimates while `HNot` overestimates. In Boolean algebras, they are equal. See `hnot_eq_compl`. ;)
(; //LEAN:HNot ;)
HNot : (X : Set) -> Prop.

(; doc: Heyting negation `￢`  Conventions for notations in identifiers:   * The recommended spelling of `￢` in identifiers is `hnot`. ;)
(; //LEAN:HNot.hnot ;)
HNot__hnot : (x : Elem X) -> Elem X.

(; doc: **Alias** of `not_congr`. ;)
(; //LEAN:Iff.not ;)
Iff__not : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff (not a) (not b)).

(; //LEAN:Iff.not_left ;)
Iff__not_left : (a : Prop) -> (b : Prop) -> (h : Proof (iff a (not b))) -> Proof (iff (not a) b).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `LE α` is the typeclass which supports the notation `x ≤ y` where `x y : α`. ;)
(; //LEAN:LE ;)
LE : (X : Set) -> Prop.

(; doc: **Alias** of `not_lt_of_ge`. ;)
(; //LEAN:LE.le.not_gt ;)
LE__le__not_gt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> Proof (not (Lt b a)).

(; doc: `LT α` is the typeclass which supports the notation `x < y` where `x y : α`. ;)
(; //LEAN:LT ;)
LT : (X : Set) -> Prop.

(; doc: Although `TrailingParserDescr` is an abbreviation for `ParserDescr`, Lean will look at the declared type in order to determine whether to add the parser to the leading or trailing parser table. The determination is done automatically by the `syntax` command. ;)
(; //LEAN:Lean.TrailingParserDescr ;)
Lean__TrailingParserDescr : Set.

(; doc: A linear order is reflexive, transitive, antisymmetric and total relation `≤`. We assume that every linear ordered type has decidable `(≤)`, `(<)`, and `(=)`. ;)
(; //LEAN:LinearOrder ;)
LinearOrder : (X : Set) -> Prop.

(; //LEAN:LinearOrder.lift'._proof_1 ;)
LinearOrder__lift'___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (Eqt Y (f (ite (Leq (f x1) (f x2)) x2 x1)) (Max__max (f x1) (f x2))).

(; //LEAN:LinearOrder.lift'._proof_2 ;)
LinearOrder__lift'___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (Eqt Y (f (ite (Leq (f x1) (f x2)) x1 x2)) (Min__min (f x1) (f x2))).

(; //LEAN:LinearOrder.lift._proof_1 ;)
LinearOrder__lift___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Leq (f x1) (f x2)) (Leq (f x1) (f x2))).

(; //LEAN:LinearOrder.lift._proof_2 ;)
LinearOrder__lift___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Lt (f x1) (f x2)) (Lt (f x1) (f x2))).

(; //LEAN:LinearOrder.lift._proof_3 ;)
LinearOrder__lift___proof_3 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (Eqt Ordering (Ord__compare (f x1) (f x2)) (Ord__compare (f x1) (f x2))).

(; //LEAN:LinearOrder.liftWithOrd._proof_1 ;)
LinearOrder__liftWithOrd___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (LinearOrder Y)) -> (_ : Proof (Ord X)) -> (f : (Elem X -> Y)) -> (compare_f : Proof (forall X (a => forall X (b => Eqt Ordering (Ord__compare a b) (Ord__compare (f a) (f b)))))) -> (x2 : Elem X) -> (x3 : Elem X) -> Proof (Eqt Ordering (Ord__compare (f x2) (f x3)) (Ord__compare x2 x3)).

(; //LEAN:LinearOrder.mk ;)
LinearOrder__mk : (le_total : Proof (forall X (a3 => forall X (b3 => or (Leq a3 b3) (Leq b3 a3))))) -> (toDecidableLE : Proof (DecidableLE X)) -> (toDecidableEq : Proof (DecidableEq X)) -> (toDecidableLT : Proof (DecidableLT X)) -> (min_def : Proof (autoParam (forall X (a2 => forall X (b2 => Eqt X (Min__min a2 b2) (ite (Leq a2 b2) a2 b2)))) LinearOrder__min_def___autoParam)) -> (max_def : Proof (autoParam (forall X (a1 => forall X (b1 => Eqt X (Max__max a1 b1) (ite (Leq a1 b1) b1 a1)))) LinearOrder__max_def___autoParam)) -> (compare_eq_compareOfLessAndEq : Proof (autoParam (forall X (a => forall X (b => Eqt Ordering (Ord__compare a b) (compareOfLessAndEq a b)))) LinearOrder__compare_eq_compareOfLessAndEq___autoParam)) -> Proof (LinearOrder X).

(; //LEAN:LinearOrder.ofSubsingleton._proof_2 ;)
LinearOrder__ofSubsingleton___proof_2 : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (ite ((x => x1 => True) a b) a b) (ite True a b)).

(; //LEAN:LinearOrder.ofSubsingleton._proof_3 ;)
LinearOrder__ofSubsingleton___proof_3 : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (ite ((x => x1 => True) a b) b a) (ite True b a)).

(; //LEAN:LinearOrder.ofSubsingleton._proof_4 ;)
LinearOrder__ofSubsingleton___proof_4 : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Ordering (compareOfLessAndEq a b) (compareOfLessAndEq a b)).

(; //LEAN:LinearOrder.toPartialOrder ;)
LinearOrder__toPartialOrder : Proof (PartialOrder X).

(; doc: An extension for `gcongr_forward`. ;)
(; //LEAN:Mathlib.Tactic.GCongr.ForwardExt ;)
Mathlib__Tactic__GCongr__ForwardExt : Set.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Nonempty α` is a typeclass that says that `α` is not an empty type, that is, there exists an element in the type. It differs from `Inhabited α` in that `Nonempty α` is a `Prop`, which means that it does not actually carry an element of `α`, only a proof that *there exists* such an element. Given `Nonempty α`, you can construct an element of `α` *nonconstructively* using `Classical.choice`. ;)
(; //LEAN:Nonempty ;)
Nonempty : (X : Set) -> Prop.

(; //LEAN:Or.imp ;)
Or__imp : (a : Prop) -> (c : Prop) -> (b : Prop) -> (d : Prop) -> (f : Proof (if a c)) -> (g : Proof (if b d)) -> (h : Proof (or a b)) -> Proof (or c d).

(; //LEAN:Or.resolve_right ;)
Or__resolve_right : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (nb : Proof (not b)) -> Proof a.

(; //LEAN:Or.symm ;)
Or__symm : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> Proof (or b a).

(; doc: Compare two elements in `α` using the comparator contained in an `[Ord α]` instance. ;)
(; //LEAN:Ord.compare ;)
Ord__compare : (x : Elem X) -> (x1 : Elem X) -> Elem Ordering.

(; doc: The result of a comparison according to a total order.  The relationship between the compared items may be: * `Ordering.lt`: less than * `Ordering.eq`: equal * `Ordering.gt`: greater than ;)
(; //LEAN:Ordering ;)
Ordering : Set.

(; doc: The canonical universe-polymorphic type with just one element.  It should be used in contexts that require a type to be universe polymorphic, thus disallowing `Unit`. ;)
(; //LEAN:PUnit ;)
PUnit : Set.

(; doc: The only element of the universe-polymorphic unit type. ;)
(; //LEAN:PUnit.unit ;)
PUnit__unit : Elem PUnit.

(; doc: A partial order is a reflexive, transitive, antisymmetric relation `≤`. ;)
(; //LEAN:PartialOrder ;)
PartialOrder : (X : Set) -> Prop.

(; //LEAN:PartialOrder.lift._proof_1 ;)
PartialOrder__lift___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (PartialOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Leq (f x1) (f x2)) (Leq (f x1) (f x2))).

(; //LEAN:PartialOrder.lift._proof_2 ;)
PartialOrder__lift___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (PartialOrder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Lt (f x1) (f x2)) (Lt (f x1) (f x2))).

(; //LEAN:PartialOrder.mk ;)
PartialOrder__mk : (le_antisymm : Proof (forall X (a => forall X (b => if (Leq a b) (if (Leq b a) (Eqt X a b)))))) -> Proof (PartialOrder X).

(; //LEAN:PartialOrder.toPreorder ;)
PartialOrder__toPreorder : Proof (Preorder X).

(; doc: A preorder is a reflexive, transitive relation `≤`. In a preorder, `a < b` means `a ≤ b ∧ ¬b ≤ a`, and `<` is defined this way by default. You can override this definition to set a better def-eq. ;)
(; //LEAN:Preorder ;)
Preorder : (X : Set) -> Prop.

(; //LEAN:Preorder.lift._proof_1 ;)
Preorder__lift___proof_1 : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Leq (f x1) (f x2)) (Leq (f x1) (f x2))).

(; //LEAN:Preorder.lift._proof_2 ;)
Preorder__lift___proof_2 : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (x1 : Elem X) -> (x2 : Elem X) -> Proof (iff (Lt (f x1) (f x2)) (Lt (f x1) (f x2))).

(; //LEAN:Preorder.mk ;)
Preorder__mk : (le_refl : Proof (forall X (a2 => Leq a2 a2))) -> (le_trans : Proof (forall X (a1 => forall X (b1 => forall X (c => if (Leq a1 b1) (if (Leq b1 c) (Leq a1 c))))))) -> (lt_iff_le_not_ge : Proof (autoParam (forall X (a => forall X (b => iff (Lt a b) (and (Leq a b) (not (Leq b a)))))) Preorder__lt_iff_le_not_ge___autoParam)) -> Proof (Preorder X).

(; //LEAN:Preorder.toLE ;)
Preorder__toLE : Proof (LE X).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; doc: Swaps the elements in a pair.  Examples: * `(1, 2).swap = (2, 1)` * `("orange", -87).swap = (-87, "orange")` ;)
(; //LEAN:Prod.swap ;)
Prod__swap : (x : Elem (Prod X Y)) -> Elem (Prod Y X).

(; doc: Notation type class for the set difference `\`. ;)
(; //LEAN:SDiff ;)
SDiff : (X : Set) -> Prop.

(; doc: `a \ b` is the set difference of `a` and `b`, consisting of all elements in `a` that are not in `b`.  Conventions for notations in identifiers:   * The recommended spelling of `\` in identifiers is `sdiff`. ;)
(; //LEAN:SDiff.sdiff ;)
SDiff__sdiff : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Associative op` indicates `op` is an associative operation, i.e. `(a ∘ b) ∘ c = a ∘ (b ∘ c)`. ;)
(; //LEAN:Std.Associative ;)
Std__Associative : (op : (Elem X -> Elem X -> X)) -> Prop.

(; //LEAN:Std.Associative.mk ;)
Std__Associative__mk : (X : Set) -> (op : (Elem X -> Elem X -> X)) -> (assoc : Proof (forall X (a => forall X (b => forall X (c => Eqt X (op (op a b) c) (op a (op b c))))))) -> Proof (Std__Associative op).

(; doc: `Commutative op` says that `op` is a commutative operation, i.e. `a ∘ b = b ∘ a`. ;)
(; //LEAN:Std.Commutative ;)
Std__Commutative : (op : (Elem X -> Elem X -> X)) -> Prop.

(; doc: A commutative operation satisfies `a ∘ b = b ∘ a`. ;)
(; //LEAN:Std.Commutative.comm ;)
Std__Commutative__comm : (X : Set) -> (op : (Elem X -> Elem X -> X)) -> (_ : Proof (Std__Commutative op)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (op a b) (op b a)).

(; doc: `Symm r` means that the binary relation `r` is symmetric, that is, `r a b → r b a`. ;)
(; //LEAN:Std.Symm ;)
Std__Symm : (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: `Subrelation q r` means that `q ⊆ r` or `∀ x y, q x y → r x y`. It is the analogue of the subset relation on relations. ;)
(; //LEAN:Subrelation ;)
Subrelation : (q : (Elem X -> Elem X -> Prop)) -> (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (p : (Elem X -> Prop)) -> Set.

(; doc: The disjoint union of types `α` and `β`, ordinarily written `α ⊕ β`.  An element of `α ⊕ β` is either an `a : α` wrapped in `Sum.inl` or a `b : β` wrapped in `Sum.inr`. `α ⊕ β` is not equivalent to the set-theoretic union of `α` and `β` because its values include an indication of which of the two types was chosen. The union of a singleton set with itself contains one element, while `Unit ⊕ Unit` contains distinct values `inl ()` and `inr ()`. ;)
(; //LEAN:Sum ;)
Sum : (X : Set) -> (Y : Set) -> Set.

(; doc: Case analysis for sums that applies the appropriate function `f` or `g` after checking which constructor is present. ;)
(; //LEAN:Sum.elim ;)
Sum__elim : (f : (Elem X -> Z)) -> (g : (Elem Y -> Z)) -> (x : Elem (Sum X Y)) -> Elem Z.

(; //LEAN:Sum.forall ;)
Sum__forall : (X : Set) -> (Y : Set) -> (p : (Elem (Sum X Y) -> Prop)) -> Proof (iff (forall (Sum X Y) (x => p x)) (and (forall X (a => p (Sum__inl a))) (forall Y (b => p (Sum__inr b))))).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; //LEAN:and_comm ;)
and_comm : (a : Prop) -> (b : Prop) -> Proof (iff (and a b) (and b a)).

(; //LEAN:and_congr ;)
and_congr : (a : Prop) -> (c : Prop) -> (b : Prop) -> (d : Prop) -> (h : Proof (iff a c)) -> (h1 : Proof (iff b d)) -> Proof (iff (and a b) (and c d)).

(; //LEAN:and_iff_left ;)
and_iff_left : (b : Prop) -> (a : Prop) -> (hb : Proof b) -> Proof (iff (and a b) a).

(; //LEAN:and_iff_right ;)
and_iff_right : (a : Prop) -> (b : Prop) -> (ha : Proof a) -> Proof (iff (and a b) b).

(; doc: Uses decidable less-than and equality relations to find an `Ordering`.  In particular, if `x < y` then the result is `Ordering.lt`. If `x = y` then the result is `Ordering.eq`. Otherwise, it is `Ordering.gt`.  `compareOfLessAndBEq` uses `BEq` instead of `DecidableEq`. ;)
(; //LEAN:compareOfLessAndEq ;)
compareOfLessAndEq : (x : Elem X) -> (y : Elem X) -> Elem Ordering.

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Equality is decidable if `≤` is. ;)
(; //LEAN:decidableEqOfDecidableLE ;)
decidableEqOfDecidableLE : Proof (DecidableEq X).

(; doc: `<` is decidable if `≤` is. ;)
(; //LEAN:decidableLTOfDecidableLE ;)
decidableLTOfDecidableLE : Proof (DecidableLT X).

(; //LEAN:eq_comm ;)
eq_comm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a b) (Eqt X b a)).

(; doc: `flip f a b` is `f b a`. It is useful for "point-free" programming, since it can sometimes be used to avoid introducing variables. For example, `(·<·)` is the less-than relation, and `flip (·<·)` is the greater-than relation. ;)
(; //LEAN:flip ;)
flip : (f : (Elem X -> Elem Y -> X1)) -> (x : Elem Y) -> (x1 : Elem X) -> Elem X1.

(; //LEAN:ge_antisymm ;)
ge_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq a b)) -> Proof (Eqt X a b).

(; //LEAN:ge_of_eq ;)
ge_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; //LEAN:ge_trans ;)
ge_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Leq c b)) -> Proof (Leq c a).

(; //LEAN:gt_trans ;)
gt_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt b a)) -> (h1 : Proof (Lt c b)) -> Proof (Lt c a).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; //LEAN:instDecidableTrue ;)
instDecidableTrue : Proof (Decidable True).

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_antisymm_iff ;)
le_antisymm_iff : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a b) (and (Leq a b) (Leq b a))).

(; //LEAN:le_iff_lt_or_eq ;)
le_iff_lt_or_eq : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Leq a b) (or (Lt a b) (Eqt X a b))).

(; //LEAN:le_imp_le_of_lt_imp_lt ;)
le_imp_le_of_lt_imp_lt : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (LinearOrder Y)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem Y) -> (d : Elem Y) -> (H : Proof (if (Lt d c) (Lt b a))) -> (h : Proof (Leq a b)) -> Proof (Leq c d).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_of_eq_of_le ;)
le_of_eq_of_le : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; //LEAN:le_of_eq_of_le'' ;)
le_of_eq_of_le'' : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Leq c b)) -> Proof (Leq c a).

(; //LEAN:le_of_le_of_eq ;)
le_of_le_of_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; //LEAN:le_of_le_of_eq'' ;)
le_of_le_of_eq'' : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq b a)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq c a).

(; //LEAN:le_of_lt ;)
le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; //LEAN:le_of_not_gt ;)
le_of_not_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (not (Lt b a))) -> Proof (Leq a b).

(; //LEAN:le_or_gt ;)
le_or_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (or (Leq a b) (Lt b a)).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: The relation `≤` on a preorder is transitive. ;)
(; //LEAN:le_trans ;)
le_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; //LEAN:lt_asymm ;)
lt_asymm : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (not (Lt b a)).

(; //LEAN:lt_iff_le_not_ge ;)
lt_iff_le_not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt a b) (and (Leq a b) (not (Leq b a)))).

(; //LEAN:lt_irrefl ;)
lt_irrefl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (not (Lt a a)).

(; //LEAN:lt_of_eq_of_lt ;)
lt_of_eq_of_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_eq_of_lt'' ;)
lt_of_eq_of_lt'' : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Lt c b)) -> Proof (Lt c a).

(; //LEAN:lt_of_le_not_ge ;)
lt_of_le_not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> (hba : Proof (not (Leq b a))) -> Proof (Lt a b).

(; //LEAN:lt_of_le_of_lt ;)
lt_of_le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_le_of_lt' ;)
lt_of_le_of_lt' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq b a)) -> (hbc : Proof (Lt c b)) -> Proof (Lt c a).

(; //LEAN:lt_of_le_of_ne ;)
lt_of_le_of_ne : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Neq a b)) -> Proof (Lt a b).

(; //LEAN:lt_of_le_of_ne' ;)
lt_of_le_of_ne' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Neq a b)) -> Proof (Lt b a).

(; //LEAN:lt_of_lt_of_eq ;)
lt_of_lt_of_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Lt a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_lt_of_eq'' ;)
lt_of_lt_of_eq'' : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Lt b a)) -> (h1 : Proof (Eqt X b c)) -> Proof (Lt c a).

(; //LEAN:lt_of_lt_of_le ;)
lt_of_lt_of_le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Lt a b)) -> (hbc : Proof (Leq b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_lt_of_le' ;)
lt_of_lt_of_le' : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Lt b a)) -> (hbc : Proof (Leq c b)) -> Proof (Lt c a).

(; //LEAN:lt_of_not_ge ;)
lt_of_not_ge : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (not (Leq b a))) -> Proof (Lt a b).

(; //LEAN:lt_or_eq_of_le ;)
lt_or_eq_of_le : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> Proof (or (Lt a b) (Eqt X a b)).

(; //LEAN:lt_or_eq_of_le' ;)
lt_or_eq_of_le' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> Proof (or (Lt b a) (Eqt X a b)).

(; //LEAN:lt_or_ge ;)
lt_or_ge : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (or (Lt a b) (Leq b a)).

(; //LEAN:lt_or_gt_of_ne ;)
lt_or_gt_of_ne : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Neq a b)) -> Proof (or (Lt a b) (Lt b a)).

(; //LEAN:lt_trans ;)
lt_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:ne_iff_lt_or_gt ;)
ne_iff_lt_or_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Neq a b) (or (Lt a b) (Lt b a))).

(; //LEAN:ne_of_gt ;)
ne_of_gt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; //LEAN:ne_of_lt ;)
ne_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; doc: One of **de Morgan's laws**: the negation of a conjunction is logically equivalent to the disjunction of the negations. ;)
(; //LEAN:not_and_or ;)
not_and_or : (a : Prop) -> (b : Prop) -> Proof (iff (not (and a b)) (or (not a) (not b))).

(; //LEAN:not_congr ;)
not_congr : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff (not a) (not b)).

(; //LEAN:not_false ;)
not_false : Proof (not false).

(; //LEAN:not_le ;)
not_le : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (not (Leq a b)) (Lt b a)).

(; //LEAN:not_lt ;)
not_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (not (Lt a b)) (Leq b a)).

(; //LEAN:or_comm ;)
or_comm : (a : Prop) -> (b : Prop) -> Proof (iff (or a b) (or b a)).

(; //LEAN:or_congr ;)
or_congr : (a : Prop) -> (c : Prop) -> (b : Prop) -> (d : Prop) -> (h : Proof (iff a c)) -> (h1 : Proof (iff b d)) -> Proof (iff (or a b) (or c d)).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:symm ;)
symm : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (Std__Symm r)) -> (h1 : Proof (r a b)) -> Proof (r b a).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

