(; //LEAN:PUnit.min_eq ;)
PUnit__min_eq : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Eqt PUnit (Min__min PUnit a b) PUnit__unit).

(; //LEAN:PUnit.max_eq ;)
def PUnit__max_eq : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Eqt PUnit (Max__max PUnit a b) PUnit__unit) :=
  a => b => rfl PUnit (Max__max PUnit a b).

(; //LEAN:PUnit.le ;)
def PUnit__le : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Leq a b) :=
  a => b => trivial.

(; //LEAN:PUnit.not_lt ;)
