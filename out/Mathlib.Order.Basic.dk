(; //LEAN:StrongLT ;)
def StrongLT : (I : Set) -> (pi : (Elem I -> Set)) -> (a : ((i1 : Elem I) -> pi i1)) -> (b : ((i : Elem I) -> pi i)) -> Prop :=
  I => pi => a => b => forall I (i => Lt (a i) (b i)).

