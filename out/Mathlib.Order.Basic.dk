def LinearOrder__ofSubsingleton : Proof (LinearOrder X) :=
  LinearOrder__mk (x => x1 => orIl True True trivial) (x2 => x3 => instDecidableTrue) decidableEqOfDecidableLE decidableLTOfDecidableLE LinearOrder__ofSubsingleton___proof_2 LinearOrder__ofSubsingleton___proof_3 LinearOrder__ofSubsingleton___proof_4.

(; //LEAN:PUnit.min_eq ;)
PUnit__min_eq : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Eqt PUnit (Min__min a b) PUnit__unit).

(; //LEAN:PUnit.max_eq ;)
def PUnit__max_eq : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Eqt PUnit (Max__max a b) PUnit__unit) :=
  a => b => rfl.

(; //LEAN:PUnit.le ;)
def PUnit__le : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (Leq a b) :=
  a => b => trivial.

(; //LEAN:PUnit.not_lt ;)
def PUnit__not_lt : (a : Elem PUnit) -> (b : Elem PUnit) -> Proof (not (Lt a b)) :=
  a => b => not_false.

(; //LEAN:subrelation_iff_le ;)
def subrelation_iff_le : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (s : (Elem X -> Elem X -> Prop)) -> Proof (iff (Subrelation r s) (Leq r s)) :=
  X => r => s => Iff__rfl (Subrelation r s).

