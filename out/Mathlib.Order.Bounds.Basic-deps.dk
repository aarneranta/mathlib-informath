(; constants used by Mathlib.Order.Bounds.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__toDual__app : (a1 : Elem Z) -> Elem (OrderDual Z).

(; doc: The antisymmetrization relation `AntisymmRel r` is defined so that `AntisymmRel r a b ↔ r a b ∧ r b a`. ;)
(; //LEAN:AntisymmRel ;)
AntisymmRel : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: A set is bounded above if there exists an upper bound. ;)
(; //LEAN:BddAbove ;)
BddAbove : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: A set is bounded below if there exists a lower bound. ;)
(; //LEAN:BddBelow ;)
BddBelow : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : (X : Set) -> Elem X.

(; doc: Two elements of a lattice are codisjoint if their sup is the top element.  Note that we define this without reference to `⊔`, as this allows us to talk about orders where the supremum is not unique, or where implementing `Sup` would require additional `Decidable` arguments. ;)
(; //LEAN:Codisjoint ;)
Codisjoint : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: A co-Heyting algebra is a bounded lattice with an additional binary difference operation `\` such that `(· \ a)` is left adjoint to `(· ⊔ a)`. ;)
(; //LEAN:CoheytingAlgebra ;)
CoheytingAlgebra : (X : Set) -> Prop.

(; doc: Set / lattice complement  Conventions for notations in identifiers:   * The recommended spelling of `ᶜ` in identifiers is `compl`. ;)
(; //LEAN:Compl.compl ;)
Compl__compl : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: An order is dense if there is an element between any pair of distinct comparable elements. ;)
(; //LEAN:DenselyOrdered ;)
DenselyOrdered : (X : Set) -> Prop.

(; doc: A subset of `α` is directed if there is an element of the set `≼`-above any pair of elements in the set. ;)
(; //LEAN:DirectedOn ;)
DirectedOn : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (s : Elem (powerset X)) -> Prop.

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : (X : Set) -> Elem X.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; //LEAN:Exists.imp ;)
Exists__imp : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => if (p a2) (q a2)))) -> (h1 : Proof (exists X (a1 => p a1))) -> Proof (exists X (a => q a)).

(; doc: Function composition, usually written with the infix operator `∘`. A new function is created from two existing functions, where one function's output is used as input to the other.  Examples:  * `Function.comp List.reverse (List.drop 2) [3, 2, 4, 1] = [1, 4]`  * `(List.reverse ∘ List.drop 2) [3, 2, 4, 1] = [1, 4]`  Conventions for notations in identifiers:   * The recommended spelling of `∘` in identifiers is `comp`. ;)
(; //LEAN:Function.comp ;)
Function__comp : (X : Set) -> (Y : Set) -> (W : Set) -> (f : (Elem Y -> W)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> Elem W.

(; doc: A generalized co-Heyting algebra is a lattice with an additional binary difference operation `\` such that `(· \ a)` is left adjoint to `(· ⊔ a)`.  This generalizes `CoheytingAlgebra` by not requiring a top element. ;)
(; //LEAN:GeneralizedCoheytingAlgebra ;)
GeneralizedCoheytingAlgebra : (X : Set) -> Prop.

(; doc: A generalized Heyting algebra is a lattice with an additional binary operation `⇨` called Heyting implication such that `(a ⇨ ·)` is right adjoint to `(a ⊓ ·)`.  This generalizes `HeytingAlgebra` by not requiring a bottom element. ;)
(; //LEAN:GeneralizedHeytingAlgebra ;)
GeneralizedHeytingAlgebra : (X : Set) -> Prop.

(; doc: Heyting implication `⇨`  Conventions for notations in identifiers:   * The recommended spelling of `⇨` in identifiers is `himp`. ;)
(; //LEAN:HImp.himp ;)
HImp__himp : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: Heyting negation `￢`  Conventions for notations in identifiers:   * The recommended spelling of `￢` in identifiers is `hnot`. ;)
(; //LEAN:HNot.hnot ;)
HNot__hnot : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: A Heyting algebra is a bounded lattice with an additional binary operation `⇨` called Heyting implication such that `(a ⇨ ·)` is right adjoint to `(a ⊓ ·)`. ;)
(; //LEAN:HeytingAlgebra ;)
HeytingAlgebra : (X : Set) -> Prop.

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; doc: Class for the `sInf` operator ;)
(; //LEAN:InfSet ;)
InfSet : (X : Set) -> Prop.

(; doc: Infimum of a set ;)
(; //LEAN:InfSet.sInf ;)
InfSet__sInf : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: `default` is a function that produces a "default" element of any `Inhabited` type. This element does not have any particular specified properties, but it is often an all-zeroes value. ;)
(; //LEAN:Inhabited.default ;)
Inhabited__default : (X : Set) -> Elem X.

(; doc: `insert x xs` inserts the element `x` into the collection `xs`. ;)
(; //LEAN:Insert.insert ;)
Insert__insert : (X : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Z) -> Elem Z.

(; doc: `a ∩ b` is the intersection of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∩` in identifiers is `inter`. ;)
(; //LEAN:Inter.inter ;)
Inter__inter : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `a : α` is a bottom element of `α` if it is less than or equal to any other element of `α`. This predicate is roughly an unbundled version of `OrderBot`, except that a preorder may have several bottom elements. When `α` is linear, this is useful to make a case disjunction on `NoMinOrder α` within a proof. ;)
(; //LEAN:IsBot ;)
IsBot : (X : Set) -> (a : Elem X) -> Prop.

(; doc: A class for an `IsDirected` relation `≥`. ;)
(; //LEAN:IsCodirectedOrder ;)
IsCodirectedOrder : (X : Set) -> Prop.

(; doc: A set `s` is said to be cofinal for a set `t` if, for all `a ∈ s` there exists `b ∈ t` such that `a ≤ b`. ;)
(; //LEAN:IsCofinalFor ;)
IsCofinalFor : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Prop.

(; doc: A set `s` is said to be coinitial for a set `t` if, for all `a ∈ s` there exists `b ∈ t` such that `b ≤ a`. ;)
(; //LEAN:IsCoinitialFor ;)
IsCoinitialFor : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Prop.

(; doc: A class for an `IsDirected` relation `≤`. ;)
(; //LEAN:IsDirectedOrder ;)
IsDirectedOrder : (X : Set) -> Prop.

(; doc: `IsEmpty α` expresses that `α` is empty. ;)
(; //LEAN:IsEmpty ;)
IsEmpty : (X : Set) -> Prop.

(; doc: `a` is a greatest lower bound of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsGLB ;)
IsGLB : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> Prop.

(; doc: `a` is a greatest element of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsGreatest ;)
IsGreatest : (X : Set) -> (s : Elem (powerset X)) -> (a : Elem X) -> Prop.

(; doc: `a` is a least upper bound of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsLUB ;)
IsLUB : (X : Set) -> (s : Elem (powerset X)) -> (x1 : Elem X) -> Prop.

(; doc: `a` is a least element of a set `s`; for a partial order, it is unique if exists. ;)
(; //LEAN:IsLeast ;)
IsLeast : (X : Set) -> (s : Elem (powerset X)) -> (a : Elem X) -> Prop.

(; //LEAN:IsLeast.orderBot._proof_2 ;)
IsLeast__orderBot___proof_2 : (X : Set) -> (_ : Proof (Preorder X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (h : Proof (IsLeast X s a)) -> (x1 : Elem (Subtype X (a1 => Membership__mem X (powerset X) s a1))) -> Proof (Leq (Subtype__mk X (x2 => Membership__mem X (powerset X) s x2) a (IsLeast__orderBot___proof_1 X s a h)) x1).

(; doc: `a : α` is a top element of `α` if it is greater than or equal to any other element of `α`. This predicate is roughly an unbundled version of `OrderBot`, except that a preorder may have several top elements. When `α` is linear, this is useful to make a case disjunction on `NoMaxOrder α` within a proof. ;)
(; //LEAN:IsTop ;)
IsTop : (X : Set) -> (a : Elem X) -> Prop.

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `lt_of_le_of_lt`. ;)
(; //LEAN:LE.le.trans_lt ;)
LE__le__trans_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: A lattice is a join-semilattice which is also a meet-semilattice. ;)
(; //LEAN:Lattice ;)
Lattice : (X : Set) -> Prop.

(; //LEAN:Lattice.mk ;)
Lattice__mk : (X : Set) -> (inf : (Elem X -> Elem X -> X)) -> (inf_le_left : Proof (forall X (a2 => forall X (b2 => Leq (inf a2 b2) a2)))) -> (inf_le_right : Proof (forall X (a1 => forall X (b1 => Leq (inf a1 b1) b1)))) -> (le_inf : Proof (forall X (a => forall X (b => forall X (c => if (Leq a b) (if (Leq a c) (Leq a (inf b c)))))))) -> Proof (Lattice X).

(; doc: A `ParserDescr` is a grammar for parsers. This is used by the `syntax` command to produce parsers without having to `import Lean`. ;)
(; //LEAN:Lean.ParserDescr ;)
Lean__ParserDescr : Set.

(; doc: A linear order is reflexive, transitive, antisymmetric and total relation `≤`. We assume that every linear ordered type has decidable `(≤)`, `(<)`, and `(=)`. ;)
(; //LEAN:LinearOrder ;)
LinearOrder : (X : Set) -> Prop.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Maximal P x` means that `x` is a maximal element satisfying `P`. ;)
(; //LEAN:Maximal ;)
Maximal : (X : Set) -> (P : (Elem X -> Prop)) -> (x1 : Elem X) -> Prop.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Minimal P x` means that `x` is a minimal element satisfying `P`. ;)
(; //LEAN:Minimal ;)
Minimal : (X : Set) -> (P : (Elem X -> Prop)) -> (x1 : Elem X) -> Prop.

(; doc: Order without bottom elements. ;)
(; //LEAN:NoBotOrder ;)
NoBotOrder : (X : Set) -> Prop.

(; doc: Order without top elements. ;)
(; //LEAN:NoTopOrder ;)
NoTopOrder : (X : Set) -> Prop.

(; doc: The elimination principle for `Nonempty α`. If `Nonempty α`, and we can prove `p` given any element `x : α`, then `p` holds. Note that it is essential that `p` is a `Prop` here; the version with `p` being a `Sort u` is equivalent to `Classical.choice`. ;)
(; //LEAN:Nonempty.elim ;)
Nonempty__elim : (X : Set) -> (p : Prop) -> (h : Proof (Nonempty X)) -> (h1 : Proof (forall X (x => p))) -> Proof p.

(; doc: An order is an `OrderBot` if it has a least element. We state this using a data mixin, holding the value of `⊥` and the least element constraint. ;)
(; //LEAN:OrderBot ;)
OrderBot : (X : Set) -> Prop.

(; //LEAN:OrderBot.mk ;)
OrderBot__mk : (X : Set) -> (bot_le : Proof (forall X (a => Leq (Bot__bot X) a))) -> Proof (OrderBot X).

(; doc: Type synonym to equip a type with the dual order: `≤` means `≥` and `<` means `>`. `αᵒᵈ` is notation for `OrderDual α`. ;)
(; //LEAN:OrderDual ;)
OrderDual : (X : Set) -> Set.

(; doc: `ofDual` is the identity function from the `OrderDual` of a linear order. ;)
(; //LEAN:OrderDual.ofDual ;)
OrderDual__ofDual : (X : Set) -> Elem (Equiv (OrderDual X) X).

(; doc: `toDual` is the identity function to the `OrderDual` of a linear order. ;)
(; //LEAN:OrderDual.toDual ;)
OrderDual__toDual : (X : Set) -> Elem (Equiv X (OrderDual X)).

(; doc: `OrderInfSet α` expresses that `α` is equipped with the operation `sInf` that returns the greatest lower bound of a set whenever one exists. ;)
(; //LEAN:OrderInfSet ;)
OrderInfSet : (X : Set) -> Prop.

(; //LEAN:OrderInfSet.mk ;)
OrderInfSet__mk : (X : Set) -> (isGLB_sInf_of_isGLB : Proof (forall (powerset X) (s => forall X (a => if (IsGLB X s a) (IsGLB X s (InfSet__sInf X s)))))) -> Proof (OrderInfSet X).

(; //LEAN:OrderInfSet.ofOrderSupSet._proof_1 ;)
OrderInfSet__ofOrderSupSet___proof_1 : (X : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (OrderSupSet X)) -> (x2 : Elem (powerset X)) -> (x3 : Elem X) -> (h : Proof (IsGLB X x2 x3)) -> Proof (IsGLB X x2 (SupSet__sSup X (lowerBounds X x2))).

(; doc: `OrderSupSet α` expresses that `α` is equipped with the operation `sSup` that returns the least upper bound of a set whenever one exists. ;)
(; //LEAN:OrderSupSet ;)
OrderSupSet : (X : Set) -> Prop.

(; //LEAN:OrderSupSet.choose._proof_1 ;)
OrderSupSet__choose___proof_1 : (X : Set) -> (_ : Proof (Preorder X)) -> (d : Elem X) -> (x1 : Elem (powerset X)) -> (x2 : Elem X) -> (h : Proof (IsLUB X x1 x2)) -> Proof (IsLUB X x1 (dite X (exists X (x => (IsLUB X x1) x)) (h1 => Exists__choose X (IsLUB X x1) h1) (h2 => d))).

(; //LEAN:OrderSupSet.isLUB_sSup_of_isLUB ;)
OrderSupSet__isLUB_sSup_of_isLUB : (X : Set) -> (x : Proof (LE X)) -> (_ : Proof (OrderSupSet X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (h : Proof (IsLUB X s a)) -> Proof (IsLUB X s (SupSet__sSup X s)).

(; //LEAN:OrderSupSet.mk ;)
OrderSupSet__mk : (X : Set) -> (isLUB_sSup_of_isLUB : Proof (forall (powerset X) (s => forall X (a => if (IsLUB X s a) (IsLUB X s (SupSet__sSup X s)))))) -> Proof (OrderSupSet X).

(; doc: An order is an `OrderTop` if it has a greatest element. We state this using a data mixin, holding the value of `⊤` and the greatest element constraint. ;)
(; //LEAN:OrderTop ;)
OrderTop : (X : Set) -> Prop.

(; doc: `⊤` is the greatest element ;)
(; //LEAN:OrderTop.le_top ;)
OrderTop__le_top : (X : Set) -> (x : Proof (LE X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Leq a (Top__top X)).

(; doc: A partial order is a reflexive, transitive, antisymmetric relation `≤`. ;)
(; //LEAN:PartialOrder ;)
PartialOrder : (X : Set) -> Prop.

(; doc: A preorder is a reflexive, transitive relation `≤`. In a preorder, `a < b` means `a ≤ b ∧ ¬b ≤ a`, and `<` is defined this way by default. You can override this definition to set a better def-eq. ;)
(; //LEAN:Preorder ;)
Preorder : (X : Set) -> Prop.

(; //LEAN:Preorder.toLE ;)
Preorder__toLE : (X : Set) -> Proof (LE X).

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; doc: `a \ b` is the set difference of `a` and `b`, consisting of all elements in `a` that are not in `b`.  Conventions for notations in identifiers:   * The recommended spelling of `\` in identifiers is `sdiff`. ;)
(; //LEAN:SDiff.sdiff ;)
SDiff__sdiff : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: A `SemilatticeInf` is a meet-semilattice, that is, a partial order with a meet (a.k.a. glb / greatest lower bound, inf / infimum) operation `⊓` which is the greatest element smaller than both factors. ;)
(; //LEAN:SemilatticeInf ;)
SemilatticeInf : (X : Set) -> Prop.

(; doc: The binary infimum, used to derive `Min α` ;)
(; //LEAN:SemilatticeInf.inf ;)
SemilatticeInf__inf : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The infimum is a lower bound on the first argument ;)
(; //LEAN:SemilatticeInf.inf_le_left ;)
SemilatticeInf__inf_le_left : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (SemilatticeInf__inf X a b) a).

(; doc: The infimum is a lower bound on the second argument ;)
(; //LEAN:SemilatticeInf.inf_le_right ;)
SemilatticeInf__inf_le_right : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (SemilatticeInf__inf X a b) b).

(; doc: The infimum is the *greatest* lower bound ;)
(; //LEAN:SemilatticeInf.le_inf ;)
SemilatticeInf__le_inf : (X : Set) -> (_ : Proof (SemilatticeInf X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq a c)) -> Proof (Leq a (SemilatticeInf__inf X b c)).

(; doc: A `SemilatticeSup` is a join-semilattice, that is, a partial order with a join (a.k.a. lub / least upper bound, sup / supremum) operation `⊔` which is the least element larger than both factors. ;)
(; //LEAN:SemilatticeSup ;)
SemilatticeSup : (X : Set) -> Prop.

(; //LEAN:SemilatticeSup.mk ;)
SemilatticeSup__mk : (X : Set) -> (sup : (Elem X -> Elem X -> X)) -> (le_sup_left : Proof (forall X (a2 => forall X (b2 => Leq a2 (sup a2 b2))))) -> (le_sup_right : Proof (forall X (a1 => forall X (b1 => Leq b1 (sup a1 b1))))) -> (sup_le : Proof (forall X (a => forall X (b => forall X (c => if (Leq a c) (if (Leq b c) (Leq (sup a b) c))))))) -> Proof (SemilatticeSup X).

(; //LEAN:SemilatticeSup.ofIsLUB._proof_1 ;)
SemilatticeSup__ofIsLUB___proof_1 : (X : Set) -> (_ : Proof (PartialOrder X)) -> (sup : (Elem X -> Elem X -> X)) -> (isLUB_pair : Proof (forall X (a1 => forall X (b1 => IsLUB X (Insert__insert X (powerset X) a1 (Singleton__singleton X (powerset X) b1)) (sup a1 b1))))) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq a (sup a b)).

(; //LEAN:SemilatticeSup.ofIsLUB._proof_2 ;)
SemilatticeSup__ofIsLUB___proof_2 : (X : Set) -> (_ : Proof (PartialOrder X)) -> (sup : (Elem X -> Elem X -> X)) -> (isLUB_pair : Proof (forall X (a1 => forall X (b1 => IsLUB X (Insert__insert X (powerset X) a1 (Singleton__singleton X (powerset X) b1)) (sup a1 b1))))) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq b (sup a b)).

(; //LEAN:SemilatticeSup.ofIsLUB._proof_3 ;)
SemilatticeSup__ofIsLUB___proof_3 : (X : Set) -> (_ : Proof (PartialOrder X)) -> (sup : (Elem X -> Elem X -> X)) -> (isLUB_pair : Proof (forall X (a1 => forall X (b1 => IsLUB X (Insert__insert X (powerset X) a1 (Singleton__singleton X (powerset X) b1)) (sup a1 b1))))) -> (a : Elem X) -> (b : Elem X) -> (x1 : Elem X) -> (hac : Proof (Leq a x1)) -> (hbc : Proof (Leq b x1)) -> Proof (Leq (sup a b) x1).

(; doc: A bounded or final set. Not to be confused with `Bornology.IsBounded`. ;)
(; //LEAN:Set.Bounded ;)
Set__Bounded : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (s : Elem (powerset X)) -> Prop.

(; doc: Given the set `s`, `Elem s` is the `Type` of element of `s`.  It is currently an abbreviation so that instance coming from `Subtype` are available. If you're interested in making it a `def`, as it probably should be, you'll then need to create additional instances (and possibly prove lemmas about them). See e.g. `Mathlib/Data/Set/Order.lean`. ;)
(; //LEAN:Set.Elem ;)
Set__Elem : (X : Set) -> (s : Elem (powerset X)) -> Set.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ici a` is the left-closed right-infinite interval $[a, ∞)$. ;)
(; //LEAN:Set.Ici ;)
Set__Ici : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ico a b` is the left-closed right-open interval $[a, b)$. ;)
(; //LEAN:Set.Ico ;)
Set__Ico : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; //LEAN:Set.Ico_subset_Icc_self ;)
Set__Ico_subset_Icc_self : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Set__Subset X (Set__Ico X b a) (Set__Icc X b a)).

(; doc: `Iic b` is the left-infinite right-closed interval $(-∞, b]$. ;)
(; //LEAN:Set.Iic ;)
Set__Iic : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Iio b` is the left-infinite right-open interval $(-∞, b)$. ;)
(; //LEAN:Set.Iio ;)
Set__Iio : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ioc a b` is the left-open right-closed interval $(a, b]$. ;)
(; //LEAN:Set.Ioc ;)
Set__Ioc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; //LEAN:Set.Ioc_subset_Icc_self ;)
Set__Ioc_subset_Icc_self : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Set__Subset X (Set__Ioc X a b) (Set__Icc X a b)).

(; doc: `Ioi a` is the left-open right-infinite interval $(a, ∞)$. ;)
(; //LEAN:Set.Ioi ;)
Set__Ioi : (X : Set) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ioo a b` is the left-open right-open interval $(a, b)$. ;)
(; //LEAN:Set.Ioo ;)
Set__Ioo : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; //LEAN:Set.Ioo_subset_Icc_self ;)
Set__Ioo_subset_Icc_self : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Set__Subset X (Set__Ioo X a b) (Set__Icc X a b)).

(; //LEAN:Set.Ioo_subset_Ioc_self ;)
Set__Ioo_subset_Ioc_self : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Set__Subset X (Set__Ioo X b a) (Set__Ioc X b a)).

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Nonempty.mono ;)
Set__Nonempty__mono : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (ht : Proof (Set__Subset X s t)) -> (hs : Proof (Set__Nonempty X s)) -> Proof (Set__Nonempty X t).

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Subset.antisymm ;)
Set__Subset__antisymm : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (Set__Subset X a b)) -> (h1 : Proof (Set__Subset X b a)) -> Proof (Eqt (powerset X) a b).

(; //LEAN:Set.Subset.rfl ;)
Set__Subset__rfl : (X : Set) -> (s : Elem (powerset X)) -> Proof (Set__Subset X s s).

(; doc: A set `s` is a `Subsingleton` if it has at most one element. ;)
(; //LEAN:Set.Subsingleton ;)
Set__Subsingleton : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Set.eq_empty_of_subset_empty ;)
Set__eq_empty_of_subset_empty : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (Set__Subset X s (EmptyCollection__emptyCollection (powerset X)))) -> Proof (Eqt (powerset X) s (EmptyCollection__emptyCollection (powerset X))).

(; //LEAN:Set.eq_of_mem_singleton ;)
Set__eq_of_mem_singleton : (X : Set) -> (x : Elem X) -> (y : Elem X) -> (h : Proof (Membership__mem X (powerset X) (Singleton__singleton X (powerset X) y) x)) -> Proof (Eqt X x y).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem X (powerset X) a x) (Membership__mem X (powerset X) b x)))) -> Proof (Eqt (powerset X) a b).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; //LEAN:Set.inter_subset_left ;)
Set__inter_subset_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X (Inter__inter (powerset X) s t) s).

(; //LEAN:Set.inter_subset_right ;)
Set__inter_subset_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X (Inter__inter (powerset X) s t) t).

(; //LEAN:Set.mem_singleton ;)
Set__mem_singleton : (X : Set) -> (a : Elem X) -> Proof (Membership__mem X (powerset X) (Singleton__singleton X (powerset X) a) a).

(; //LEAN:Set.mem_univ ;)
Set__mem_univ : (X : Set) -> (x : Elem X) -> Proof (Membership__mem X (powerset X) (Set__univ X) x).

(; doc: See also `Set.not_nonempty_iff_eq_empty`. ;)
(; //LEAN:Set.nonempty_iff_ne_empty ;)
Set__nonempty_iff_ne_empty : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (Set__Nonempty X s) (Neq s (EmptyCollection__emptyCollection (powerset X)))).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Elem (powerset X).

(; //LEAN:Set.range_comp_subset_range ;)
Set__range_comp_subset_range : (X : Set) -> (Y : Set) -> (Z : Set) -> (f : (Elem X -> Y)) -> (g : (Elem Y -> Z)) -> Proof (Set__Subset Z (Set__range Z X (Function__comp X Y Z g f)) (Set__range Z Y g)).

(; //LEAN:Set.range_eq_empty ;)
Set__range_eq_empty : (X : Set) -> (I : Set) -> (_ : Proof (IsEmpty I)) -> (f : (Elem I -> X)) -> Proof (Eqt (powerset X) (Set__range X I f) (EmptyCollection__emptyCollection (powerset X))).

(; //LEAN:Set.right_mem_Icc ;)
Set__right_mem_Icc : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Membership__mem X (powerset X) (Set__Icc X b a) a) (Leq b a)).

(; //LEAN:Set.right_mem_Ioc ;)
Set__right_mem_Ioc : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Membership__mem X (powerset X) (Set__Ioc X b a) a) (Lt b a)).

(; //LEAN:Set.self_mem_Ici ;)
Set__self_mem_Ici : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Membership__mem X (powerset X) (Set__Ici X a) a).

(; //LEAN:Set.subset_union_left ;)
Set__subset_union_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X s (Union__union (powerset X) s t)).

(; //LEAN:Set.subset_union_right ;)
Set__subset_union_right : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (Set__Subset X t (Union__union (powerset X) s t)).

(; //LEAN:Set.union_subset ;)
Set__union_subset : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (r : Elem (powerset X)) -> (sr : Proof (Set__Subset X s r)) -> (tr : Proof (Set__Subset X t r)) -> Proof (Set__Subset X (Union__union (powerset X) s t) r).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : (X : Set) -> Elem (powerset X).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (X : Set) -> (Y : Set) -> (x : Elem X) -> Elem Y.

(; //LEAN:Std.Total.directedOn ;)
Std__Total__directedOn : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Total X r)) -> (s : Elem (powerset X)) -> Proof (DirectedOn X r s).

(; doc: Class for the `sSup` operator ;)
(; //LEAN:SupSet ;)
SupSet : (X : Set) -> Prop.

(; doc: Supremum of a set ;)
(; //LEAN:SupSet.sSup ;)
SupSet__sSup : (X : Set) -> (x : Elem (powerset X)) -> Elem X.

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : (X : Set) -> Elem X.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (r : (Elem X -> Elem Y -> Set)) -> (s : (Elem Y -> Elem Z -> Set)) -> (t : (Elem X -> Elem Z -> Set)) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Z) -> (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `Unique α` expresses that `α` is a type with a unique term `default`.  This is implemented as a type, rather than a `Prop`-valued predicate, for good definitional properties of the default term. ;)
(; //LEAN:Unique ;)
Unique : (X : Set) -> Prop.

(; //LEAN:and_iff_left ;)
and_iff_left : (b : Prop) -> (a : Prop) -> (hb : Proof b) -> Proof (iff (and a b) a).

(; //LEAN:bot_unique ;)
bot_unique : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (h : Proof (Leq a (Bot__bot X))) -> Proof (Eqt X a (Bot__bot X)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: **Alias** of `congrArg`. ;)
(; //LEAN:congr_arg ;)
congr_arg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; doc: Indexed supremum ;)
(; //LEAN:iSup ;)
iSup : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:isTop_top ;)
isTop_top : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (OrderTop X)) -> Proof (IsTop X (Top__top X)).

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_of_forall_lt_imp_le_of_dense ;)
le_of_forall_lt_imp_le_of_dense : (X : Set) -> (_ : Proof (LinearOrder X)) -> (_ : Proof (DenselyOrdered X)) -> (x1 : Elem X) -> (x2 : Elem X) -> (h1 : Proof (forall X (a => if (Lt a x2) (Leq a x1)))) -> Proof (Leq x2 x1).

(; //LEAN:le_of_lt ;)
le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; //LEAN:le_top ;)
le_top : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (OrderTop X)) -> (a : Elem X) -> Proof (Leq a (Top__top X)).

(; //LEAN:le_total ;)
le_total : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (or (Leq a b) (Leq b a)).

(; doc: The relation `≤` on a preorder is transitive. ;)
(; //LEAN:le_trans ;)
le_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: The set of lower bounds of a set. ;)
(; //LEAN:lowerBounds ;)
lowerBounds : (X : Set) -> (s : Elem (powerset X)) -> Elem (powerset X).

(; //LEAN:lt_iff_le_not_ge ;)
lt_iff_le_not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt a b) (and (Leq a b) (not (Leq b a)))).

(; //LEAN:not_isBot ;)
not_isBot : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (NoBotOrder X)) -> (a : Elem X) -> Proof (not (IsBot X a)).

(; //LEAN:not_isTop ;)
not_isTop : (X : Set) -> (_ : Proof (LE X)) -> (_ : Proof (NoTopOrder X)) -> (a : Elem X) -> Proof (not (IsTop X a)).

(; doc: The set of upper bounds of a set. ;)
(; //LEAN:upperBounds ;)
upperBounds : (X : Set) -> (s : Elem (powerset X)) -> Elem (powerset X).

