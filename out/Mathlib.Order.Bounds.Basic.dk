(; //LEAN:SemilatticeSup.ofIsLUB ;)
def SemilatticeSup__ofIsLUB : (sup : (Elem X -> Elem X -> X)) -> (isLUB_pair : Proof (forall X (a => forall X (b => IsLUB (Insert__insert a (Singleton__singleton b)) (sup a b))))) -> Proof (SemilatticeSup X) :=
  sup => isLUB_pair => SemilatticeSup__mk sup (SemilatticeSup__ofIsLUB___proof_1 sup isLUB_pair) (SemilatticeSup__ofIsLUB___proof_2 sup isLUB_pair) (SemilatticeSup__ofIsLUB___proof_3 sup isLUB_pair).

