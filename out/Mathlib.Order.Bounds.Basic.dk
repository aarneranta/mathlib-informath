def isGLB_lt_isLUB_of_ne : (X : Set) -> (_ : Proof (PartialOrder X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> (Ha : Proof (IsGLB X s a)) -> (Hb : Proof (IsLUB X s b)) -> (x1 : Elem X) -> (y : Elem X) -> (Hx : Proof (Membership__mem X (powerset X) s x1)) -> (Hy : Proof (Membership__mem X (powerset X) s y)) -> (Hxy : Proof (Neq x1 y)) -> Proof (Lt a b) :=
