(; //LEAN:upperBounds_mono_set ;)
def upperBounds_mono_set : (X : Set) -> (_ : Proof (Preorder X)) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (hst : Proof (Set__Subset X s t)) -> Proof (Set__Subset X (upperBounds X t) (upperBounds X s)) :=
  X => x => s => t => hst => forallI X (x1 => if (Membership__mem X (powerset X) (upperBounds X t) x1) (forall X (x4 => if (Membership__mem X (powerset X) s x4) (Leq x4 x1)))) (x1 => ifI (Membership__mem X (powerset X) (upperBounds X t) x1) (forall X (x3 => if (Membership__mem X (powerset X) s x3) (Leq x3 x1))) (hb => forallI X (x2 => if (Membership__mem X (powerset X) s x2) (Leq x2 x1)) (x2 => ifI (Membership__mem X (powerset X) s x2) (Leq x2 x1) (h => ifE (Membership__mem X (powerset X) t x2) (Leq x2 x1) (forallE X (a => if (Membership__mem X (powerset X) t a) (Leq a x1)) hb x2) (ifE (Membership__mem X (powerset X) s x2) (Membership__mem X (powerset X) t x2) (forallE X (a1 => if (Membership__mem X (powerset X) s a1) (Membership__mem X (powerset X) t a1)) hst x2) h))))).

