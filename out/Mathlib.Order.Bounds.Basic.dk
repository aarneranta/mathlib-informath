(; //LEAN:upperBounds_mono_mem ;)
def upperBounds_mono_mem : (X : Set) -> (_ : Proof (Preorder X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> (h : Proof (Membership__mem X (powerset X) (upperBounds X s) a)) -> Proof (Membership__mem X (powerset X) (upperBounds X s) b) :=
  X => x => s => a => b => hab => h => forallI X (x1 => if (Membership__mem X (powerset X) s x1) (Leq x1 b)) (x1 => ifI (Membership__mem X (powerset X) s x1) (Leq x1 b) (h1 => le_trans X x1 a b (ifE (Membership__mem X (powerset X) s x1) (Leq x1 a) (forallE X (a1 => if (Membership__mem X (powerset X) s a1) (Leq a1 a)) h x1) h1) hab)).

