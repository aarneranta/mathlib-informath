(; //LEAN:BddAbove.mono ;)
def BddAbove__mono : (X : Set) -> (_ : Proof (Preorder X)) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset X s t)) -> (h1 : Proof (BddAbove X t)) -> Proof (BddAbove X s) :=
