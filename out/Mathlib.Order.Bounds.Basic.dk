def isGLB_lt_isLUB_of_ne : (X : Set) -> (_ : Proof (PartialOrder X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> (Ha : Proof (IsGLB s a)) -> (Hb : Proof (IsLUB s b)) -> (x1 : Elem X) -> (y : Elem X) -> (Hx : Proof (Membership__mem s x1)) -> (Hy : Proof (Membership__mem s y)) -> (Hxy : Proof (Neq x1 y)) -> Proof (Lt a b) :=
