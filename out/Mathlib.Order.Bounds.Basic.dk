def Set__subsingleton_of_isLUB_le_isGLB : (X : Set) -> (_ : Proof (PartialOrder X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> (b : Elem X) -> (Ha : Proof (IsGLB s a)) -> (Hb : Proof (IsLUB s b)) -> (hab : Proof (Leq b a)) -> Proof (Set__Subsingleton s) :=
