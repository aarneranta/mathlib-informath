  X => x => a => b => c => Trans__trans (Trans__trans (Trans__trans (Trans__trans (Eq__mpr (id (congrArg X Prop (Min__min a (Max__max a c)) a (_a => Eqt X (Min__min a (Max__max b c)) (Min__min _a (Max__max b c))) (inf_sup_self X a c))) (Eq__refl (Min__min a (Max__max b c)))) (of_eq_true (Eqt X (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Max__max (Min__min a b) c))) (Eq__trans Prop (Eqt X (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Max__max (Min__min a b) c))) (Eqt X (Min__min a (Min__min (Max__max a c) (Max__max b c))) (Min__min a (Min__min (Max__max a c) (Max__max b c)))) True (congr X Prop (Eq (Min__min (Min__min a (Max__max a c)) (Max__max b c))) (Eq (Min__min a (Min__min (Max__max a c) (Max__max b c)))) (Min__min a (Max__max (Min__min a b) c)) (Min__min a (Min__min (Max__max a c) (Max__max b c))) (congrArg X (Elem X -> Prop) (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Min__min (Max__max a c) (Max__max b c))) Eq (inf_assoc X a (Max__max a c) (Max__max b c))) (congrArg X X (Max__max (Min__min a b) c) (Min__min (Max__max a c) (Max__max b c)) (Min__min a) (sup_inf_right X a b c))) (eq_self X (Min__min a (Min__min (Max__max a c) (Max__max b c))))))) (Eq__mpr (id (congrArg X Prop (Max__max a (Min__min a b)) a (_a1 => Eqt X (Min__min a (Max__max (Min__min a b) c)) (Min__min _a1 (Max__max (Min__min a b) c))) (sup_inf_self X a b))) (Eq__refl (Min__min a (Max__max (Min__min a b) c))))) (Eq__mpr (id (congrArg X Prop (Max__max a (Min__min a b)) (Max__max (Min__min a b) a) (_a2 => Eqt X (Min__min _a2 (Max__max (Min__min a b) c)) (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c))) (sup_comm X a (Min__min a b)))) (Eq__refl (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c))))) (Eq__mpr (id (congrArg X Prop (Max__max (Min__min a b) (Min__min a c)) (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)) (_a3 => Eqt X (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)) _a3) (sup_inf_left X (Min__min a b) a c))) (Eq__refl (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)))).

(; //LEAN:inf_sup_le ;)
inf_sup_le : (X : Set) -> (_ : Proof (DistribLattice X)) -> (x1 : Elem X) -> (y : Elem X) -> (z : Elem X) -> Proof (Leq (Min__min x1 (Max__max y z)) (Max__max (Min__min x1 y) (Min__min x1 z))).

(; //LEAN:inf_sup_right ;)
inf_sup_right : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Min__min (Max__max a b) c) (Max__max (Min__min a c) (Min__min b c))).

(; //LEAN:le_of_inf_le_sup_le ;)
def le_of_inf_le_sup_le : (X : Set) -> (_ : Proof (DistribLattice X)) -> (x1 : Elem X) -> (y : Elem X) -> (z : Elem X) -> (h : Proof (Leq (Min__min x1 z) (Min__min y z))) -> (h1 : Proof (Leq (Max__max x1 z) (Max__max y z))) -> Proof (Leq x1 y) :=
  X => x => x1 => y => z => h => h1 => Trans__trans (Trans__trans (Trans__trans (Trans__trans (Trans__trans (le_sup_right X (Min__min y z) x1) (Eq__mpr (id (congrArg X Prop (Max__max (Min__min y z) x1) (Min__min (Max__max y x1) (Max__max z x1)) (_a => Eqt X _a (Min__min (Max__max y x1) (Max__max x1 z))) (sup_inf_right X y z x1))) (Eq__mpr (id (congrArg X Prop (Max__max x1 z) (Max__max z x1) (_a1 => Eqt X (Min__min (Max__max y x1) (Max__max z x1)) (Min__min (Max__max y x1) _a1)) (sup_comm X x1 z))) (Eq__refl (Min__min (Max__max y x1) (Max__max z x1)))))) (inf_le_inf_left X (Max__max y z) (Max__max x1 z) (Max__max y x1) h1)) (Eq__mpr (id (congrArg X Prop (Min__min (Max__max y x1) (Max__max y z)) (Max__max y (Min__min x1 z)) (_a2 => Eqt X _a2 (Max__max y (Min__min x1 z))) (Eq__symm X (Max__max y (Min__min x1 z)) (Min__min (Max__max y x1) (Max__max y z)) (sup_inf_left X y x1 z)))) (Eq__refl (Max__max y (Min__min x1 z))))) (sup_le_sup_left X (Min__min x1 z) (Min__min y z) h y)) (sup_le X y (Min__min y z) y (le_refl X y) (inf_le_left X y z)).

(; //LEAN:eq_of_inf_eq_sup_eq ;)
def eq_of_inf_eq_sup_eq : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X (Min__min b a) (Min__min c a))) -> (h1 : Proof (Eqt X (Max__max b a) (Max__max c a))) -> Proof (Eqt X b c) :=
  X => x => a => b => c => h => h1 => le_antisymm X b c (le_of_inf_le_sup_le X b c a (le_of_eq X (Min__min b a) (Min__min c a) h) (le_of_eq X (Max__max b a) (Max__max c a) h1)) (le_of_inf_le_sup_le X c b a (le_of_eq X (Min__min c a) (Min__min b a) (Eq__symm X (Min__min b a) (Min__min c a) h)) (le_of_eq X (Max__max c a) (Max__max b a) (Eq__symm X (Max__max b a) (Max__max c a) h1))).

