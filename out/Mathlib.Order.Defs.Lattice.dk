(; //LEAN:le_of_inf_le_sup_le ;)
def le_of_inf_le_sup_le : (X : Set) -> (_ : Proof (DistribLattice X)) -> (x1 : Elem X) -> (y : Elem X) -> (z : Elem X) -> (h1 : Proof (Leq (Min__min X x1 z) (Min__min X y z))) -> (h2 : Proof (Leq (Max__max X x1 z) (Max__max X y z))) -> Proof (Leq x1 y) :=
  X => x => x1 => y => z => h1 => h2 => Trans__trans X X X Leq Leq Leq x1 (Max__max X y (Min__min X y z)) y (Trans__trans X X X Leq Leq Leq x1 (Max__max X y (Min__min X x1 z)) (Max__max X y (Min__min X y z)) (Trans__trans X X X Leq (Eq X) Leq x1 (Min__min X (Max__max X y x1) (Max__max X y z)) (Max__max X y (Min__min X x1 z)) (Trans__trans X X X Leq Leq Leq x1 (Min__min X (Max__max X y x1) (Max__max X x1 z)) (Min__min X (Max__max X y x1) (Max__max X y z)) (Trans__trans X X X Leq (Eq X) Leq x1 (Max__max X (Min__min X y z) x1) (Min__min X (Max__max X y x1) (Max__max X x1 z)) (le_sup_right X (Min__min X y z) x1) (Eq__mpr (Eqt X (Max__max X (Min__min X y z) x1) (Min__min X (Max__max X y x1) (Max__max X x1 z))) (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X x1 z))) (id (Eqt Prop (Eqt X (Max__max X (Min__min X y z) x1) (Min__min X (Max__max X y x1) (Max__max X x1 z))) (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X x1 z)))) (congrArg X Prop (Max__max X (Min__min X y z) x1) (Min__min X (Max__max X y x1) (Max__max X z x1)) (_a => Eqt X _a (Min__min X (Max__max X y x1) (Max__max X x1 z))) (sup_inf_right X y z x1))) (Eq__mpr (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X x1 z))) (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X z x1))) (id (Eqt Prop (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X x1 z))) (Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) (Max__max X z x1)))) (congrArg X Prop (Max__max X x1 z) (Max__max X z x1) (_a1 => Eqt X (Min__min X (Max__max X y x1) (Max__max X z x1)) (Min__min X (Max__max X y x1) _a1)) (sup_comm X x1 z))) (Eq__refl X (Min__min X (Max__max X y x1) (Max__max X z x1)))))) (inf_le_inf_left X (Max__max X y z) (Max__max X x1 z) (Max__max X y x1) h2)) (Eq__mpr (Eqt X (Min__min X (Max__max X y x1) (Max__max X y z)) (Max__max X y (Min__min X x1 z))) (Eqt X (Max__max X y (Min__min X x1 z)) (Max__max X y (Min__min X x1 z))) (id (Eqt Prop (Eqt X (Min__min X (Max__max X y x1) (Max__max X y z)) (Max__max X y (Min__min X x1 z))) (Eqt X (Max__max X y (Min__min X x1 z)) (Max__max X y (Min__min X x1 z)))) (congrArg X Prop (Min__min X (Max__max X y x1) (Max__max X y z)) (Max__max X y (Min__min X x1 z)) (_a2 => Eqt X _a2 (Max__max X y (Min__min X x1 z))) (Eq__symm X (Max__max X y (Min__min X x1 z)) (Min__min X (Max__max X y x1) (Max__max X y z)) (sup_inf_left X y x1 z)))) (Eq__refl X (Max__max X y (Min__min X x1 z))))) (sup_le_sup_left X (Min__min X x1 z) (Min__min X y z) h1 y)) (sup_le X y (Min__min X y z) y (le_refl X y) (inf_le_left X y z)).

(; //LEAN:eq_of_inf_eq_sup_eq ;)
def eq_of_inf_eq_sup_eq : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Eqt X (Min__min X b a) (Min__min X c a))) -> (h2 : Proof (Eqt X (Max__max X b a) (Max__max X c a))) -> Proof (Eqt X b c) :=
  X => x => a => b => c => h1 => h2 => le_antisymm X b c (le_of_inf_le_sup_le X b c a (le_of_eq X (Min__min X b a) (Min__min X c a) h1) (le_of_eq X (Max__max X b a) (Max__max X c a) h2)) (le_of_inf_le_sup_le X c b a (le_of_eq X (Min__min X c a) (Min__min X b a) (Eq__symm X (Min__min X b a) (Min__min X c a) h1)) (le_of_eq X (Max__max X c a) (Max__max X b a) (Eq__symm X (Max__max X b a) (Max__max X c a) h2))).

