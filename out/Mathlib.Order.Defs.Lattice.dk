(; //LEAN:sup_right_comm ;)
sup_right_comm : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max (Max__max a b) c) (Max__max (Max__max a c) b)).

(; //LEAN:sup_sup_sup_comm ;)
sup_sup_sup_comm : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (d : Elem x) -> Proof (Eqt x (Max__max (Max__max a b) (Max__max c d)) (Max__max (Max__max a c) (Max__max b d))).

(; //LEAN:inf_inf_inf_comm ;)
inf_inf_inf_comm : (x : Set) -> (_ : Proof (SemilatticeInf x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (d : Elem x) -> Proof (Eqt x (Min__min (Min__min a b) (Min__min c d)) (Min__min (Min__min a c) (Min__min b d))).

(; //LEAN:inf_rotate ;)
inf_rotate : (x : Set) -> (_ : Proof (SemilatticeInf x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min (Min__min a b) c) (Min__min (Min__min b c) a)).

(; //LEAN:sup_rotate ;)
sup_rotate : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max (Max__max a b) c) (Max__max (Max__max b c) a)).

(; //LEAN:sup_rotate' ;)
sup_rotate' : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max a (Max__max b c)) (Max__max b (Max__max c a))).

(; //LEAN:inf_rotate' ;)
inf_rotate' : (x : Set) -> (_ : Proof (SemilatticeInf x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min a (Min__min b c)) (Min__min b (Min__min c a))).

(; //LEAN:sup_sup_distrib_left ;)
sup_sup_distrib_left : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max a (Max__max b c)) (Max__max (Max__max a b) (Max__max a c))).

(; //LEAN:inf_inf_distrib_left ;)
inf_inf_distrib_left : (x : Set) -> (_ : Proof (SemilatticeInf x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min a (Min__min b c)) (Min__min (Min__min a b) (Min__min a c))).

(; //LEAN:sup_sup_distrib_right ;)
sup_sup_distrib_right : (x : Set) -> (_ : Proof (SemilatticeSup x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max (Max__max a b) c) (Max__max (Max__max a c) (Max__max b c))).

(; //LEAN:inf_inf_distrib_right ;)
inf_inf_distrib_right : (x : Set) -> (_ : Proof (SemilatticeInf x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min (Min__min a b) c) (Min__min (Min__min a c) (Min__min b c))).

(; //LEAN:Lattice ;)
Lattice : (x : Set) -> Prop.

(; //LEAN:Lattice.le_inf ;)
Lattice__le_inf : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq a c)) -> Proof (Leq a (Lattice__inf b c)).

(; //LEAN:Lattice.inf_le_left ;)
Lattice__inf_le_left : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (Leq (Lattice__inf a b) a).

(; //LEAN:Lattice.inf_le_right ;)
Lattice__inf_le_right : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (Leq (Lattice__inf a b) b).

(; //LEAN:Lattice.mk ;)
Lattice__mk : (inf : (Elem x -> Elem x -> x)) -> (inf_le_left : Proof (forall x (a2 => forall x (b2 => Leq (inf a2 b2) a2)))) -> (inf_le_right : Proof (forall x (a1 => forall x (b1 => Leq (inf a1 b1) b1)))) -> (le_inf : Proof (forall x (a => forall x (b => forall x (c => if (Leq a b) (if (Leq a c) (Leq a (inf b c)))))))) -> Proof (Lattice x).

(; //LEAN:Lattice.inf ;)
Lattice__inf : (x1 : Elem x) -> (x2 : Elem x) -> Elem x.

(; //LEAN:inf_le_sup ;)
def inf_le_sup : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (Leq (Min__min a b) (Max__max a b)) :=
  x => x1 => a => b => le_trans x (Min__min a b) a (Max__max a b) (inf_le_left x a b) (le_sup_left x a b).

(; //LEAN:sup_le_inf ;)
sup_le_inf : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (iff (Leq (Max__max a b) (Min__min a b)) (Eqt x a b)).

(; //LEAN:inf_right_le_sup_left ;)
inf_right_le_sup_left : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Min__min b c) (Max__max a b)).

(; //LEAN:inf_left_le_sup_right ;)
def inf_left_le_sup_right : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Min__min a b) (Max__max b c)) :=
  x => x1 => a => b => c => le_trans x (Min__min a b) b (Max__max b c) (inf_le_right x a b) (le_sup_left x b c).

(; //LEAN:inf_right_le_sup_right ;)
def inf_right_le_sup_right : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Min__min b a) (Max__max b c)) :=
  x => x1 => a => b => c => le_trans x (Min__min b a) b (Max__max b c) (inf_le_left x b a) (le_sup_left x b c).

(; //LEAN:inf_left_le_sup_left ;)
def inf_left_le_sup_left : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Min__min a b) (Max__max c b)) :=
  x => x1 => a => b => c => le_trans x (Min__min a b) b (Max__max c b) (inf_le_right x a b) (le_sup_right x c b).

(; //LEAN:le_inf_sup ;)
le_inf_sup : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Max__max (Min__min a b) (Min__min a c)) (Min__min a (Max__max b c))).

(; //LEAN:sup_inf_le ;)
def sup_inf_le : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Leq (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c))) :=
  x => x1 => a => b => c => le_inf x (Max__max a (Min__min b c)) (Max__max a b) (Max__max a c) (sup_le_sup_left x (Min__min b c) b (inf_le_left x b c) a) (sup_le_sup_left x (Min__min b c) c (inf_le_right x b c) a).

(; //LEAN:inf_sup_self ;)
inf_sup_self : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (Eqt x (Min__min a (Max__max a b)) a).

(; //LEAN:sup_inf_self ;)
sup_inf_self : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (Eqt x (Max__max a (Min__min a b)) a).

(; //LEAN:sup_eq_iff_inf_eq ;)
sup_eq_iff_inf_eq : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (iff (Eqt x (Max__max a b) b) (Eqt x (Min__min a b) a)).

(; //LEAN:inf_eq_iff_sup_eq ;)
inf_eq_iff_sup_eq : (x : Set) -> (_ : Proof (Lattice x)) -> (a : Elem x) -> (b : Elem x) -> Proof (iff (Eqt x (Min__min a b) b) (Eqt x (Max__max a b) a)).

(; //LEAN:DistribLattice ;)
DistribLattice : (x : Set) -> Prop.

(; //LEAN:DistribLattice.mk ;)
DistribLattice__mk : (le_sup_inf : Proof (forall x (x1 => forall x (y => forall x (z => Leq (Min__min (Max__max x1 y) (Max__max x1 z)) (Max__max x1 (Min__min y z))))))) -> Proof (DistribLattice x).

(; //LEAN:DistribLattice.le_sup_inf ;)
DistribLattice__le_sup_inf : (x : Set) -> (_ : Proof (DistribLattice x)) -> (x1 : Elem x) -> (y : Elem x) -> (z : Elem x) -> Proof (Leq (Min__min (Max__max x1 y) (Max__max x1 z)) (Max__max x1 (Min__min y z))).

(; //LEAN:DistribLattice.ofInfSupLe ;)
DistribLattice__ofInfSupLe : (inf_sup_le : Proof (forall x (a => forall x (b => forall x (c => Leq (Min__min a (Max__max b c)) (Max__max (Min__min a b) (Min__min a c))))))) -> Proof (DistribLattice x).

(; //LEAN:le_sup_inf ;)
def le_sup_inf : (x : Set) -> (_ : Proof (DistribLattice x)) -> (x2 : Elem x) -> (y : Elem x) -> (z : Elem x) -> Proof (Leq (Min__min (Max__max x2 y) (Max__max x2 z)) (Max__max x2 (Min__min y z))) :=
  x => x1 => x2 => y => z => DistribLattice__le_sup_inf x x2 y z.

(; //LEAN:sup_inf_left ;)
def sup_inf_left : (x : Set) -> (_ : Proof (DistribLattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c))) :=
  x => x1 => a => b => c => le_antisymm x (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c)) (sup_inf_le x a b c) (le_sup_inf x a b c).

(; //LEAN:sup_inf_right ;)
sup_inf_right : (x : Set) -> (_ : Proof (DistribLattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Max__max (Min__min a b) c) (Min__min (Max__max a c) (Max__max b c))).

(; //LEAN:inf_sup_left ;)
def inf_sup_left : (x : Set) -> (_ : Proof (DistribLattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min a (Max__max b c)) (Max__max (Min__min a b) (Min__min a c))) :=
  x => x1 => a => b => c => Trans__trans (Trans__trans (Trans__trans (Trans__trans (Eq__mpr (id (congrArg x Prop (Min__min a (Max__max a c)) a (_a => Eqt x (Min__min a (Max__max b c)) (Min__min _a (Max__max b c))) (inf_sup_self x a c))) (Eq__refl (Min__min a (Max__max b c)))) (of_eq_true (Eqt x (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Max__max (Min__min a b) c))) (Eq__trans Prop (Eqt x (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Max__max (Min__min a b) c))) (Eqt x (Min__min a (Min__min (Max__max a c) (Max__max b c))) (Min__min a (Min__min (Max__max a c) (Max__max b c)))) True (congr x Prop (Eq (Min__min (Min__min a (Max__max a c)) (Max__max b c))) (Eq (Min__min a (Min__min (Max__max a c) (Max__max b c)))) (Min__min a (Max__max (Min__min a b) c)) (Min__min a (Min__min (Max__max a c) (Max__max b c))) (congrArg x (Elem x -> Prop) (Min__min (Min__min a (Max__max a c)) (Max__max b c)) (Min__min a (Min__min (Max__max a c) (Max__max b c))) Eq (inf_assoc x a (Max__max a c) (Max__max b c))) (congrArg x x (Max__max (Min__min a b) c) (Min__min (Max__max a c) (Max__max b c)) (Min__min a) (sup_inf_right x a b c))) (eq_self x (Min__min a (Min__min (Max__max a c) (Max__max b c))))))) (Eq__mpr (id (congrArg x Prop (Max__max a (Min__min a b)) a (_a1 => Eqt x (Min__min a (Max__max (Min__min a b) c)) (Min__min _a1 (Max__max (Min__min a b) c))) (sup_inf_self x a b))) (Eq__refl (Min__min a (Max__max (Min__min a b) c))))) (Eq__mpr (id (congrArg x Prop (Max__max a (Min__min a b)) (Max__max (Min__min a b) a) (_a2 => Eqt x (Min__min _a2 (Max__max (Min__min a b) c)) (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c))) (sup_comm x a (Min__min a b)))) (Eq__refl (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c))))) (Eq__mpr (id (congrArg x Prop (Max__max (Min__min a b) (Min__min a c)) (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)) (_a3 => Eqt x (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)) _a3) (sup_inf_left x (Min__min a b) a c))) (Eq__refl (Min__min (Max__max (Min__min a b) a) (Max__max (Min__min a b) c)))).

(; //LEAN:inf_sup_le ;)
inf_sup_le : (x : Set) -> (_ : Proof (DistribLattice x)) -> (x2 : Elem x) -> (y : Elem x) -> (z : Elem x) -> Proof (Leq (Min__min x2 (Max__max y z)) (Max__max (Min__min x2 y) (Min__min x2 z))).

(; //LEAN:inf_sup_right ;)
inf_sup_right : (x : Set) -> (_ : Proof (DistribLattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> Proof (Eqt x (Min__min (Max__max a b) c) (Max__max (Min__min a c) (Min__min b c))).

(; //LEAN:le_of_inf_le_sup_le ;)
def le_of_inf_le_sup_le : (x : Set) -> (_ : Proof (DistribLattice x)) -> (x2 : Elem x) -> (y : Elem x) -> (z : Elem x) -> (h : Proof (Leq (Min__min x2 z) (Min__min y z))) -> (h1 : Proof (Leq (Max__max x2 z) (Max__max y z))) -> Proof (Leq x2 y) :=
  x => x1 => x2 => y => z => h => h1 => Trans__trans (Trans__trans (Trans__trans (Trans__trans (Trans__trans (le_sup_right x (Min__min y z) x2) (Eq__mpr (id (congrArg x Prop (Max__max (Min__min y z) x2) (Min__min (Max__max y x2) (Max__max z x2)) (_a => Eqt x _a (Min__min (Max__max y x2) (Max__max x2 z))) (sup_inf_right x y z x2))) (Eq__mpr (id (congrArg x Prop (Max__max x2 z) (Max__max z x2) (_a1 => Eqt x (Min__min (Max__max y x2) (Max__max z x2)) (Min__min (Max__max y x2) _a1)) (sup_comm x x2 z))) (Eq__refl (Min__min (Max__max y x2) (Max__max z x2)))))) (inf_le_inf_left x (Max__max y z) (Max__max x2 z) (Max__max y x2) h1)) (Eq__mpr (id (congrArg x Prop (Min__min (Max__max y x2) (Max__max y z)) (Max__max y (Min__min x2 z)) (_a2 => Eqt x _a2 (Max__max y (Min__min x2 z))) (Eq__symm x (Max__max y (Min__min x2 z)) (Min__min (Max__max y x2) (Max__max y z)) (sup_inf_left x y x2 z)))) (Eq__refl (Max__max y (Min__min x2 z))))) (sup_le_sup_left x (Min__min x2 z) (Min__min y z) h y)) (sup_le x y (Min__min y z) y (le_refl x y) (inf_le_left x y z)).

(; //LEAN:eq_of_inf_eq_sup_eq ;)
def eq_of_inf_eq_sup_eq : (x : Set) -> (_ : Proof (DistribLattice x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (h : Proof (Eqt x (Min__min b a) (Min__min c a))) -> (h1 : Proof (Eqt x (Max__max b a) (Max__max c a))) -> Proof (Eqt x b c) :=
  x => x1 => a => b => c => h => h1 => le_antisymm x b c (le_of_inf_le_sup_le x b c a (le_of_eq x (Min__min b a) (Min__min c a) h) (le_of_eq x (Max__max b a) (Max__max c a) h1)) (le_of_inf_le_sup_le x c b a (le_of_eq x (Min__min c a) (Min__min b a) (Eq__symm x (Min__min b a) (Min__min c a) h)) (le_of_eq x (Max__max c a) (Max__max b a) (Eq__symm x (Max__max b a) (Max__max c a) h1))).

