sup_rotate : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max (Max__max a b) c) (Max__max (Max__max b c) a)).

