sup_rotate' : (X : Set) -> (_ : Proof (SemilatticeSup X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max a (Max__max b c)) (Max__max b (Max__max c a))).

