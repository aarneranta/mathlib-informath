(; //LEAN:Lattice ;)
Lattice : (X : Set) -> Prop.

(; //LEAN:Lattice.le_inf ;)
Lattice__le_inf : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq a c)) -> Proof (Leq a (Lattice__inf b c)).

(; //LEAN:Lattice.inf_le_left ;)
Lattice__inf_le_left : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (Lattice__inf a b) a).

(; //LEAN:Lattice.inf_le_right ;)
Lattice__inf_le_right : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (Lattice__inf a b) b).

(; //LEAN:Lattice.mk ;)
Lattice__mk : (inf : (Elem X -> Elem X -> X)) -> (inf_le_left : Proof (forall X (a2 => forall X (b2 => Leq (inf a2 b2) a2)))) -> (inf_le_right : Proof (forall X (a1 => forall X (b1 => Leq (inf a1 b1) b1)))) -> (le_inf : Proof (forall X (a => forall X (b => forall X (c => if (Leq a b) (if (Leq a c) (Leq a (inf b c)))))))) -> Proof (Lattice X).

(; //LEAN:Lattice.inf ;)
Lattice__inf : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:inf_le_sup ;)
def inf_le_sup : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (Min__min a b) (Max__max a b)) :=
  X => x => a => b => le_trans X (Min__min a b) a (Max__max a b) (inf_le_left X a b) (le_sup_left X a b).

(; //LEAN:sup_le_inf ;)
sup_le_inf : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Leq (Max__max a b) (Min__min a b)) (Eqt X a b)).

(; //LEAN:inf_right_le_sup_left ;)
inf_right_le_sup_left : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Min__min b c) (Max__max a b)).

(; //LEAN:inf_left_le_sup_right ;)
def inf_left_le_sup_right : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Min__min a b) (Max__max b c)) :=
  X => x => a => b => c => le_trans X (Min__min a b) b (Max__max b c) (inf_le_right X a b) (le_sup_left X b c).

(; //LEAN:inf_right_le_sup_right ;)
def inf_right_le_sup_right : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Min__min b a) (Max__max b c)) :=
  X => x => a => b => c => le_trans X (Min__min b a) b (Max__max b c) (inf_le_left X b a) (le_sup_left X b c).

(; //LEAN:inf_left_le_sup_left ;)
def inf_left_le_sup_left : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Min__min a b) (Max__max c b)) :=
  X => x => a => b => c => le_trans X (Min__min a b) b (Max__max c b) (inf_le_right X a b) (le_sup_right X c b).

(; //LEAN:le_inf_sup ;)
le_inf_sup : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Max__max (Min__min a b) (Min__min a c)) (Min__min a (Max__max b c))).

(; //LEAN:sup_inf_le ;)
def sup_inf_le : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Leq (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c))) :=
  X => x => a => b => c => le_inf X (Max__max a (Min__min b c)) (Max__max a b) (Max__max a c) (sup_le_sup_left X (Min__min b c) b (inf_le_left X b c) a) (sup_le_sup_left X (Min__min b c) c (inf_le_right X b c) a).

(; //LEAN:inf_sup_self ;)
inf_sup_self : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (Min__min a (Max__max a b)) a).

(; //LEAN:sup_inf_self ;)
sup_inf_self : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X (Max__max a (Min__min a b)) a).

(; //LEAN:sup_eq_iff_inf_eq ;)
sup_eq_iff_inf_eq : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Max__max a b) b) (Eqt X (Min__min a b) a)).

(; //LEAN:inf_eq_iff_sup_eq ;)
inf_eq_iff_sup_eq : (X : Set) -> (_ : Proof (Lattice X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X (Min__min a b) b) (Eqt X (Max__max a b) a)).

(; //LEAN:DistribLattice ;)
DistribLattice : (X : Set) -> Prop.

(; //LEAN:DistribLattice.mk ;)
DistribLattice__mk : (le_sup_inf : Proof (forall X (x => forall X (y => forall X (z => Leq (Min__min (Max__max x y) (Max__max x z)) (Max__max x (Min__min y z))))))) -> Proof (DistribLattice X).

(; //LEAN:DistribLattice.le_sup_inf ;)
DistribLattice__le_sup_inf : (X : Set) -> (_ : Proof (DistribLattice X)) -> (x : Elem X) -> (y : Elem X) -> (z : Elem X) -> Proof (Leq (Min__min (Max__max x y) (Max__max x z)) (Max__max x (Min__min y z))).

(; //LEAN:DistribLattice.ofInfSupLe ;)
DistribLattice__ofInfSupLe : (inf_sup_le : Proof (forall X (a => forall X (b => forall X (c => Leq (Min__min a (Max__max b c)) (Max__max (Min__min a b) (Min__min a c))))))) -> Proof (DistribLattice X).

(; //LEAN:le_sup_inf ;)
def le_sup_inf : (X : Set) -> (_ : Proof (DistribLattice X)) -> (x1 : Elem X) -> (y : Elem X) -> (z : Elem X) -> Proof (Leq (Min__min (Max__max x1 y) (Max__max x1 z)) (Max__max x1 (Min__min y z))) :=
  X => x => x1 => y => z => DistribLattice__le_sup_inf X x1 y z.

(; //LEAN:sup_inf_left ;)
def sup_inf_left : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c))) :=
  X => x => a => b => c => le_antisymm X (Max__max a (Min__min b c)) (Min__min (Max__max a b) (Max__max a c)) (sup_inf_le X a b c) (le_sup_inf X a b c).

(; //LEAN:sup_inf_right ;)
sup_inf_right : (X : Set) -> (_ : Proof (DistribLattice X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (Eqt X (Max__max (Min__min a b) c) (Min__min (Max__max a c) (Max__max b c))).

