(; constants used by Mathlib.Order.Defs.LinearOrder, declared with their translated types ;)

(; //LEAN:Decidable.lt_or_eq_of_le' ;)
Decidable__lt_or_eq_of_le' : (x : Set) -> (_ : Proof (PartialOrder x)) -> (a : Elem x) -> (b : Elem x) -> (hab : Proof (Leq b a)) -> Proof (or (Lt b a) (Eqt x a b)).

(; doc: Propositional equality is `Decidable` for all elements of a type.  In other words, an instance of `DecidableEq α` is a means of deciding the proposition `a = b` is for all `a b : α`. ;)
(; //LEAN:DecidableEq ;)
DecidableEq : (x : Set) -> Set.

(; doc: Abbreviation for `DecidableRel (· ≤ · : α → α → Prop)`. ;)
(; //LEAN:DecidableLE ;)
DecidableLE : (x : Set) -> Set.

(; doc: Abbreviation for `DecidableRel (· < · : α → α → Prop)`. ;)
(; //LEAN:DecidableLT ;)
DecidableLT : (x : Set) -> Set.

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (x : Set) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Eqt x a b)) -> Proof (Eqt x b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (x : Set) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (h : Proof (Eqt x a b)) -> (h1 : Proof (Eqt x b c)) -> Proof (Eqt x a c).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; doc: A `ParserDescr` is a grammar for parsers. This is used by the `syntax` command to produce parsers without having to `import Lean`. ;)
(; //LEAN:Lean.ParserDescr ;)
Lean__ParserDescr : Set.

(; //LEAN:LinearOrder.compare_eq_compareOfLessAndEq._autoParam ;)
LinearOrder__compare_eq_compareOfLessAndEq___autoParam : Elem Lean__Syntax.

(; //LEAN:LinearOrder.max_def._autoParam ;)
LinearOrder__max_def___autoParam : Elem Lean__Syntax.

(; //LEAN:LinearOrder.min_def._autoParam ;)
LinearOrder__min_def___autoParam : Elem Lean__Syntax.

(; doc: Returns the greater of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `max` in identifiers is `max`.   * The recommended spelling of `⊔` in identifiers is `sup` (`⊔` is the preferred notation for `max` when the type is not linearly ordered.). ;)
(; //LEAN:Max.max ;)
Max__max : (x1 : Elem x) -> (x2 : Elem x) -> Elem x.

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x1 : Elem x) -> (x2 : Elem x) -> Elem x.

(; //LEAN:Or.imp_right ;)
Or__imp_right : (b : Prop) -> (c : Prop) -> (a : Prop) -> (f : Proof (if b c)) -> (h : Proof (or a b)) -> Proof (or a c).

(; //LEAN:Or.resolve_left ;)
Or__resolve_left : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (na : Proof (not a)) -> Proof b.

(; //LEAN:Or.resolve_right ;)
Or__resolve_right : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> (nb : Proof (not b)) -> Proof a.

(; //LEAN:Or.symm ;)
Or__symm : (a : Prop) -> (b : Prop) -> (h : Proof (or a b)) -> Proof (or b a).

(; doc: Compare two elements in `α` using the comparator contained in an `[Ord α]` instance. ;)
(; //LEAN:Ord.compare ;)
Ord__compare : (x1 : Elem x) -> (x2 : Elem x) -> Elem Ordering.

(; doc: The result of a comparison according to a total order.  The relationship between the compared items may be: * `Ordering.lt`: less than * `Ordering.eq`: equal * `Ordering.gt`: greater than ;)
(; //LEAN:Ordering ;)
Ordering : Set.

(; doc: `Compares o a b` means that `a` and `b` have the ordering relation `o` between them, assuming that the relation `a < b` is defined. ;)
(; //LEAN:Ordering.Compares ;)
Ordering__Compares : (x2 : Elem Ordering) -> (x3 : Elem x) -> (x4 : Elem x) -> Prop.

(; doc: Equal. ;)
(; //LEAN:Ordering.eq ;)
Ordering__eq : Elem Ordering.

(; doc: Greater than. ;)
(; //LEAN:Ordering.gt ;)
Ordering__gt : Elem Ordering.

(; doc: Less than. ;)
(; //LEAN:Ordering.lt ;)
Ordering__lt : Elem Ordering.

(; doc: A preorder is a reflexive, transitive relation `≤`. In a preorder, `a < b` means `a ≤ b ∧ ¬b ≤ a`, and `<` is defined this way by default. You can override this definition to set a better def-eq. ;)
(; //LEAN:Preorder ;)
Preorder : (x : Set) -> Prop.

(; doc: Gadget for automatic parameter support. This is similar to the `optParam` gadget, but it uses the given tactic. Like `optParam`, this gadget only affects elaboration. For example, the tactic will *not* be invoked during type class resolution. ;)
(; //LEAN:autoParam ;)
autoParam : (x : Set) -> (tactic : Elem Lean__Syntax) -> Set.

(; doc: Construct an `Ordering` from a type with a decidable `LT` instance, assuming that incomparable terms are `Ordering.eq`. ;)
(; //LEAN:cmp ;)
cmp : (a : Elem x) -> (b : Elem x) -> Elem Ordering.

(; doc: Uses decidable less-than and equality relations to find an `Ordering`.  In particular, if `x < y` then the result is `Ordering.lt`. If `x = y` then the result is `Ordering.eq`. Otherwise, it is `Ordering.gt`.  `compareOfLessAndBEq` uses `BEq` instead of `DecidableEq`. ;)
(; //LEAN:compareOfLessAndEq ;)
compareOfLessAndEq : (x1 : Elem x) -> (y : Elem x) -> Elem Ordering.

(; doc: "Dependent" if-then-else, normally written via the notation `if h : c then t(h) else e(h)`, is sugar for `dite c (fun h => t(h)) (fun h => e(h))`, and it is the same as `if c then t else e` except that `t` is allowed to depend on a proof `h : c`, and `e` can depend on `h : ¬c`. (Both branches use the same name for the hypothesis, even though it has different types in the two cases.)  We use this to be able to communicate the if-then-else condition to the branches. For example, `Array.get arr i h` expects a proof `h : i < arr.size` in order to avoid a bounds check, so you can write `if h : i < arr.size then arr.get i h else ...` to avoid the bounds check inside the if branch. (Of course in this case we have only lifted the check into an explicit `if`, but we could also use this proof multiple times or derive `i < arr.size` from some other proposition that we are checking in the `if`.)  Conventions for notations in identifiers:   * The recommended spelling of `if h : c then t else e` in identifiers is `dite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:dite ;)
dite : (c : Prop) -> (t : (Proof c -> x)) -> (e : (Proof (not c) -> x)) -> Elem x.

(; //LEAN:iff_and_self ;)
iff_and_self : (p : Prop) -> (q : Prop) -> Proof (iff (iff p (and q p)) (if p q)).

(; //LEAN:iff_or_self ;)
iff_or_self : (a : Prop) -> (b : Prop) -> Proof (iff (iff b (or a b)) (if a b)).

(; //LEAN:iff_self_and ;)
iff_self_and : (p : Prop) -> (q : Prop) -> Proof (iff (iff p (and p q)) (if p q)).

(; //LEAN:iff_self_or ;)
iff_self_or : (a : Prop) -> (b : Prop) -> Proof (iff (iff a (or a b)) (if b a)).

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (c : Prop) -> (t : Elem x) -> (e : Elem x) -> Elem x.

(; //LEAN:le_antisymm ;)
le_antisymm : (x : Set) -> (_ : Proof (PartialOrder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt x a b).

(; //LEAN:le_of_lt ;)
le_of_lt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> Proof (Leq a a).

(; doc: The relation `≤` on a preorder is transitive. ;)
(; //LEAN:le_trans ;)
le_trans : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; //LEAN:lt_of_le_not_ge ;)
lt_of_le_not_ge : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (hab : Proof (Leq a b)) -> (hba : Proof (not (Leq b a))) -> Proof (Lt a b).

(; //LEAN:lt_of_le_of_lt ;)
lt_of_le_of_lt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (c : Elem x) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_le_of_ne ;)
lt_of_le_of_ne : (x : Set) -> (_ : Proof (PartialOrder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Leq a b)) -> (h1 : Proof (Neq a b)) -> Proof (Lt a b).

(; //LEAN:ne_of_gt ;)
ne_of_gt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Lt b a)) -> Proof (Neq a b).

(; //LEAN:ne_of_lt ;)
ne_of_lt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; //LEAN:not_le_of_gt ;)
not_le_of_gt : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (hab : Proof (Lt a b)) -> Proof (not (Leq b a)).

(; //LEAN:not_lt_of_ge ;)
not_lt_of_ge : (x : Set) -> (_ : Proof (Preorder x)) -> (a : Elem x) -> (b : Elem x) -> (hab : Proof (Leq a b)) -> Proof (not (Lt b a)).

