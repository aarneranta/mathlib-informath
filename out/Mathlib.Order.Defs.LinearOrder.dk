  X => x => a => b => h => max_eq_left X a b (le_of_lt X b a h).

(; //LEAN:min_eq_right_of_lt ;)
def min_eq_right_of_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt b a)) -> Proof (Eqt X (Min__min a b) b) :=
  X => x => a => b => h => min_eq_right X a b (le_of_lt X b a h).

(; //LEAN:max_eq_right_of_lt ;)
def max_eq_right_of_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Eqt X (Max__max a b) b) :=
  X => x => a => b => h => max_eq_right X a b (le_of_lt X a b h).

(; //LEAN:lt_min ;)
def lt_min : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt a b)) -> (h1 : Proof (Lt a c)) -> Proof (Lt a (Min__min b c)) :=
  X => x => a => b => c => h => h1 => iffEr (Lt a (Min__min b c)) (and (Lt a b) (Lt a c)) (lt_min_iff X b c a) (andI (Lt a b) (Lt a c) h h1).

(; //LEAN:max_lt ;)
max_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt b a)) -> (h1 : Proof (Lt c a)) -> Proof (Lt (Max__max b c) a).

(; //LEAN:compare_lt_iff_lt ;)
compare_lt_iff_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt Ordering (Ord__compare a b) Ordering__lt) (Lt a b)).

(; //LEAN:compare_eq_iff_eq ;)
compare_eq_iff_eq : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt Ordering (Ord__compare a b) Ordering__eq) (Eqt X a b)).

(; //LEAN:compare_gt_iff_gt ;)
compare_gt_iff_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt Ordering (Ord__compare a b) Ordering__gt) (Lt b a)).

(; //LEAN:compare_le_iff_le ;)
compare_le_iff_le : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Neq (Ord__compare a b) Ordering__gt) (Leq a b)).

(; //LEAN:compare_ge_iff_ge ;)
compare_ge_iff_ge : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Neq (Ord__compare a b) Ordering__lt) (Leq b a)).

(; //LEAN:compare_iff ;)
compare_iff : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (o : Elem Ordering) -> Proof (iff (Eqt Ordering (Ord__compare a b) o) (Ordering__Compares o a b)).

(; //LEAN:cmp_eq_compare ;)
cmp_eq_compare : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Ordering (cmp a b) (Ord__compare a b)).

(; //LEAN:cmp_eq_compareOfLessAndEq ;)
def cmp_eq_compareOfLessAndEq : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt Ordering (cmp a b) (compareOfLessAndEq a b)) :=
  X => x => a => b => Eq__trans Ordering (cmp a b) (Ord__compare a b) (compareOfLessAndEq a b) (cmp_eq_compare X a b) (LinearOrder__compare_eq_compareOfLessAndEq X a b).

(; //LEAN:LinOrd ;)
LinOrd : Set.

(; //LEAN:LinOrd.of ;)
LinOrd__of : (carrier : Set) -> Elem LinOrd.

(; //LEAN:LinOrd.carrier ;)
LinOrd__carrier : (self : Elem LinOrd) -> Set.

