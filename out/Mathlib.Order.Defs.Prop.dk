(; Mathlib.Order.Defs.Prop: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Pi.le_def ;)
def Pi__le_def : (I : Set) -> (pi : (Elem I -> Set)) -> (_ : Proof ((i3 : Elem I) -> LE (pi i3))) -> (x1 : ((i2 : Elem I) -> pi i2)) -> (y : ((i1 : Elem I) -> pi i1)) -> Proof (iff (Leq x1 y) (forall I (i => Leq (x1 i) (y i)))) :=
  I => pi => x => x1 => y => Iff__rfl (Leq x1 y).

(; //LEAN:le_Prop_eq ;)
def le_Prop_eq : Proof (Eqt (Prop -> Prop -> Prop) (x2 => x3 => Leq x2 x3) (x4 => x5 => if x4 x5)) :=
  rfl (Prop -> Prop -> Prop) (x2 => x3 => Leq x2 x3).

