(; Mathlib.Order.Defs.Prop: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Pi.le_def ;)
def Pi__le_def : (I : Set) -> (x : (Elem I -> Set)) -> (_ : Proof ((i3 : Elem I) -> LE (x i3))) -> (x2 : ((i2 : Elem I) -> x i2)) -> (y : ((i1 : Elem I) -> x i1)) -> Proof (iff (Leq x2 y) (forall I (i => Leq (x2 i) (y i)))) :=
  I => x => x1 => x2 => y => Iff__rfl (Leq x2 y).

(; //LEAN:le_Prop_eq ;)
def le_Prop_eq : Proof (Eqt (Prop -> Prop -> Prop) (x2 => x3 => Leq x2 x3) (x4 => x5 => if x4 x5)) :=
  rfl (Prop -> Prop -> Prop) (x2 => x3 => Leq x2 x3).

