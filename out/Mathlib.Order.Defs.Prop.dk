(; Mathlib.Order.Defs.Prop: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Pi.le_def ;)
def Pi__le_def : (x : Set) -> (x1 : (Elem x -> Set)) -> (_ : Proof ((i3 : Elem x) -> LE (x1 i3))) -> (x3 : ((i2 : Elem x) -> x1 i2)) -> (y : ((i1 : Elem x) -> x1 i1)) -> Proof (iff (Leq x3 y) (forall x (i => Leq (x3 i) (y i)))) :=
  x => x1 => x2 => x3 => y => Iff__rfl (Leq x3 y).

(; //LEAN:le_Prop_eq ;)
def le_Prop_eq : Proof (Eqt (Prop -> Prop -> Prop) (x2 => x3 => Leq x2 x3) (x4 => x5 => if x4 x5)) :=
  rfl.

