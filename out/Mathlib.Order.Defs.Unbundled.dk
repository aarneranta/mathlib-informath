(; //LEAN:Equivalence.stdSymm ;)
def Equivalence__stdSymm : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (h : Proof (Equivalence r)) -> Proof (Std__Symm r) :=
  X => r => h => Std__Symm__mk X r (forallI X (x => forall X (x2 => if (r x x2) (r x2 x))) (x => forallI X (x1 => if (r x x1) (r x1 x)) (x1 => Equivalence__symm X r h x x1))).

(; //LEAN:Equivalence.isTrans ;)
def Equivalence__isTrans : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (h : Proof (Equivalence r)) -> Proof (IsTrans X r) :=
  X => r => h => IsTrans__mk X r (forallI X (x => forall X (x4 => forall X (x5 => if (r x x4) (if (r x4 x5) (r x x5))))) (x => forallI X (x1 => forall X (x3 => if (r x x1) (if (r x1 x3) (r x x3)))) (x1 => forallI X (x2 => if (r x x1) (if (r x1 x2) (r x x2))) (x2 => Equivalence__trans X r h x x1 x2)))).

