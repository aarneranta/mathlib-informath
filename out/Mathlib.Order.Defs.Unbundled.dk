def Equivalence__isEquiv : (x : Set) -> (r : (Elem x -> Elem x -> Prop)) -> (h : Proof (Equivalence r)) -> Proof (IsEquiv x r) :=
  x => r => h => IsEquiv__mk.

(; //LEAN:Minimal ;)
def Minimal : (P : (Elem x -> Prop)) -> (x2 : Elem x) -> Prop :=
  P => x2 => and (P x2) (forall x (y => if (P y) (if (Leq y x2) (Leq x2 y)))).

(; //LEAN:Maximal ;)
Maximal : (P : (Elem x -> Prop)) -> (x2 : Elem x) -> Prop.

(; //LEAN:Maximal.prop ;)
Maximal__prop : (x : Set) -> (_ : Proof (LE x)) -> (P : (Elem x -> Prop)) -> (x2 : Elem x) -> (h : Proof (Maximal P x2)) -> Proof (P x2).

(; //LEAN:Minimal.prop ;)
def Minimal__prop : (x : Set) -> (_ : Proof (LE x)) -> (P : (Elem x -> Prop)) -> (x2 : Elem x) -> (h : Proof (Minimal P x2)) -> Proof (P x2) :=
  x => x1 => P => x2 => h => andEl (P x2) (forall x (y => if (P y) (if (Leq y x2) (Leq x2 y)))) h.

(; //LEAN:Maximal.le_of_ge ;)
Maximal__le_of_ge : (x : Set) -> (_ : Proof (LE x)) -> (P : (Elem x -> Prop)) -> (x2 : Elem x) -> (y : Elem x) -> (h : Proof (Maximal P x2)) -> (hy : Proof (P y)) -> (hle : Proof (Leq x2 y)) -> Proof (Leq y x2).

(; //LEAN:Minimal.le_of_le ;)
def Minimal__le_of_le : (x : Set) -> (_ : Proof (LE x)) -> (P : (Elem x -> Prop)) -> (x2 : Elem x) -> (y : Elem x) -> (h : Proof (Minimal P x2)) -> (hy : Proof (P y)) -> (hle : Proof (Leq y x2)) -> Proof (Leq x2 y) :=
  x => x1 => P => x2 => y => h => hy => hle => andEr (P x2) (forall x (y1 => if (P y1) (if (Leq y1 x2) (Leq x2 y1)))) h y hy hle.

(; //LEAN:MinimalFor ;)
def MinimalFor : (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> Prop :=
  P => f => i => and (P i) (forall x (j => if (P j) (if (Leq (f j) (f i)) (Leq (f i) (f j))))).

(; //LEAN:MaximalFor ;)
MaximalFor : (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> Prop.

(; //LEAN:MaximalFor.prop ;)
MaximalFor__prop : (x : Set) -> (x1 : Set) -> (_ : Proof (LE x1)) -> (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> (h : Proof (MaximalFor P f i)) -> Proof (P i).

(; //LEAN:MinimalFor.prop ;)
def MinimalFor__prop : (x : Set) -> (x1 : Set) -> (_ : Proof (LE x1)) -> (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> (h : Proof (MinimalFor P f i)) -> Proof (P i) :=
  x => x1 => x2 => P => f => i => h => andEl (P i) (forall x (j => if (P j) (if (Leq (f j) (f i)) (Leq (f i) (f j))))) h.

(; //LEAN:MaximalFor.le_of_le ;)
MaximalFor__le_of_le : (x : Set) -> (x1 : Set) -> (_ : Proof (LE x1)) -> (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> (j : Elem x) -> (h : Proof (MaximalFor P f i)) -> (hj : Proof (P j)) -> (hji : Proof (Leq (f i) (f j))) -> Proof (Leq (f j) (f i)).

(; //LEAN:MinimalFor.le_of_le ;)
def MinimalFor__le_of_le : (x : Set) -> (x1 : Set) -> (_ : Proof (LE x1)) -> (P : (Elem x -> Prop)) -> (f : (Elem x -> x1)) -> (i : Elem x) -> (j : Elem x) -> (h : Proof (MinimalFor P f i)) -> (hj : Proof (P j)) -> (hji : Proof (Leq (f j) (f i))) -> Proof (Leq (f i) (f j)) :=
  x => x1 => x2 => P => f => i => j => h => hj => hji => andEr (P i) (forall x (j1 => if (P j1) (if (Leq (f j1) (f i)) (Leq (f i) (f j1))))) h j hj hji.

(; //LEAN:IsUpperSet ;)
def IsUpperSet : (s : Elem (powerset x)) -> Prop :=
  s => forall x (a => forall x (b => if (Leq a b) (if (Membership__mem s a) (Membership__mem s b)))).

(; //LEAN:IsLowerSet ;)
IsLowerSet : (s : Elem (powerset x)) -> Prop.

