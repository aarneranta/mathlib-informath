  x => r => h => Std__Refl__mk (Equivalence__refl x r h).

(; //LEAN:Equivalence.stdSymm ;)
def Equivalence__stdSymm : (x : Set) -> (r : (Elem x -> Elem x -> Prop)) -> (h : Proof (Equivalence r)) -> Proof (Std__Symm r) :=
  x => r => h => Std__Symm__mk (forallI x (x1 => forall x (x3 => if (r x1 x3) (r x3 x1))) (x1 => forallI x (x2 => if (r x1 x2) (r x2 x1)) (x2 => Equivalence__symm x r h x1 x2))).

(; //LEAN:Equivalence.isTrans ;)
def Equivalence__isTrans : (x : Set) -> (r : (Elem x -> Elem x -> Prop)) -> (h : Proof (Equivalence r)) -> Proof (IsTrans x r) :=
  x => r => h => IsTrans__mk (forallI x (x1 => forall x (x5 => forall x (x6 => if (r x1 x5) (if (r x5 x6) (r x1 x6))))) (x1 => forallI x (x2 => forall x (x4 => if (r x1 x2) (if (r x2 x4) (r x1 x4)))) (x2 => forallI x (x3 => if (r x1 x2) (if (r x2 x3) (r x1 x3))) (x3 => Equivalence__trans x r h x1 x2 x3)))).

