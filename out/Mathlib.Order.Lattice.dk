(; //LEAN:Subtype.distribLattice ;)
def Subtype__distribLattice : (X : Set) -> (P : (Elem X -> Prop)) -> (Psup : Proof (forall X (s1 => forall X (t1 => if (P s1) (if (P t1) (P (Max__max X s1 t1))))))) -> (Pinf : Proof (forall X (s => forall X (t => if (P s) (if (P t) (P (Min__min X s t))))))) -> Elem (DistribLattice__on (Subtype X (x1 => P x1))) :=
  X => P => Psup => Pinf => Function__Injective__distribLattice (Subtype X (x1 => P x1)) X (a => Subtype__val X P a) (Subtype__coe_injective X P) (Subtype__distribLattice___proof_1 X P) (Subtype__distribLattice___proof_2 X P) (Subtype__distribLattice___proof_3 X P Psup) (Subtype__distribLattice___proof_4 X P Pinf).

(; //LEAN:Equiv.preorder ;)
Equiv__preorder : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (Preorder__on X).

(; //LEAN:Equiv.partialOrder ;)
Equiv__partialOrder : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (PartialOrder__on X).

(; //LEAN:Equiv.linearOrder ;)
Equiv__linearOrder : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (LinearOrder__on X).

(; //LEAN:Equiv.semilatticeSup ;)
Equiv__semilatticeSup : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (SemilatticeSup__on X).

(; //LEAN:Equiv.semilatticeInf ;)
Equiv__semilatticeInf : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (SemilatticeInf__on X).

(; //LEAN:Equiv.lattice ;)
Equiv__lattice : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (Lattice__on X).

(; //LEAN:Equiv.distribLattice ;)
Equiv__distribLattice : (X : Set) -> (Y : Set) -> (e : Elem (Equiv X Y)) -> Elem (DistribLattice__on X).

(; //LEAN:pairwise_iff_lt ;)
pairwise_iff_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm X p)) -> Proof (iff (Pairwise X p) (forall X (a => forall X (b => if (Lt a b) (p a b))))).

(; //LEAN:pairwise_iff_gt ;)
pairwise_iff_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm X p)) -> Proof (iff (Pairwise X p) (forall X (a => forall X (b => if (Lt b a) (p a b))))).

(; //LEAN:Pairwise.of_lt ;)
def Pairwise__of_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm X p)) -> (h1 : Proof (forall X (a => forall X (b => if (Lt a b) (p a b))))) -> Proof (Pairwise X p) :=
  X => x => p => h => iffEr (Pairwise X p) (forall X (a => forall X (b => if (Lt a b) (p a b)))) (pairwise_iff_lt X p).

(; //LEAN:Pairwise.of_gt ;)
def Pairwise__of_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm X p)) -> (h1 : Proof (forall X (a => forall X (b => if (Lt b a) (p a b))))) -> Proof (Pairwise X p) :=
  X => x => p => h => iffEr (Pairwise X p) (forall X (a => forall X (b => if (Lt b a) (p a b)))) (pairwise_iff_gt X p).

