pairwise_iff_lt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm p)) -> Proof (iff (Pairwise p) (forall X (a => forall X (b => if (Lt a b) (p a b))))).

(; //LEAN:pairwise_iff_gt ;)
pairwise_iff_gt : (X : Set) -> (_ : Proof (LinearOrder X)) -> (p : (Elem X -> Elem X -> Prop)) -> (_ : Proof (Std__Symm p)) -> Proof (iff (Pairwise p) (forall X (a => forall X (b => if (Lt b a) (p a b))))).

(; //LEAN:Pairwise.of_lt ;)
