(; constants used by Mathlib.Order.Monotone.Basic, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__toDual__app : (a1 : Elem X) -> Elem (OrderDual X).

(; doc: A function `f` is antitone if `a ≤ b` implies `f b ≤ f a`. ;)
(; //LEAN:Antitone ;)
Antitone : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Antitone.strictAnti_of_injective ;)
Antitone__strictAnti_of_injective : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (PartialOrder Y)) -> (f : (Elem X -> Y)) -> (h : Proof (Antitone f)) -> (h1 : Proof (Function__Injective f)) -> Proof (StrictAnti f).

(; doc: A function `f` is antitone on `s` if, for all `a, b ∈ s`, `a ≤ b` implies `f b ≤ f a`. ;)
(; //LEAN:AntitoneOn ;)
AntitoneOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: **Alias** of `ge_of_eq`. ;)
(; //LEAN:Eq.ge ;)
Eq__ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq b a).

(; doc: **Alias** of `le_of_eq`. ;)
(; //LEAN:Eq.le ;)
Eq__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; doc: Non-dependent recursor for the equality type. ;)
(; //LEAN:Eq.ndrec ;)
Eq__ndrec : (m : Elem (motive a)) -> (h : Proof (Eqt X a b)) -> Elem (motive b).

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: A function `f : α → β` is called injective if `f x = f y` implies `x = y`. ;)
(; //LEAN:Function.Injective ;)
Function__Injective : (f : (Elem X -> Y)) -> Prop.

(; doc: Function composition, usually written with the infix operator `∘`. A new function is created from two existing functions, where one function's output is used as input to the other.  Examples:  * `Function.comp List.reverse (List.drop 2) [3, 2, 4, 1] = [1, 4]`  * `(List.reverse ∘ List.drop 2) [3, 2, 4, 1] = [1, 4]`  Conventions for notations in identifiers:   * The recommended spelling of `∘` in identifiers is `comp`. ;)
(; //LEAN:Function.comp ;)
Function__comp : (f : (Elem Y -> W)) -> (g : (Elem X -> Y)) -> (x : Elem X) -> Elem W.

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: The inverse image of `r : β → β → Prop` by a function `α → β` is the relation `s : α → α → Prop` defined by `s a b = r (f a) (f b)`. ;)
(; //LEAN:InvImage ;)
InvImage : (r : (Elem Y -> Elem Y -> Prop)) -> (f : (Elem X -> Y)) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: `a` is a maximal element of `α` if no element is strictly greater than it. We spell it without `<` to avoid having to convert between `≤` and `<`. Instead, `isMax_iff_forall_not_lt` does the conversion. ;)
(; //LEAN:IsMax ;)
IsMax : (a : Elem X) -> Prop.

(; doc: `a` is a minimal element of `α` if no element is strictly less than it. We spell it without `<` to avoid having to convert between `≤` and `<`. Instead, `isMin_iff_forall_not_lt` does the conversion. ;)
(; //LEAN:IsMin ;)
IsMin : (a : Elem X) -> Prop.

(; doc: `σ` is *stable* for `f` if it breaks ties by increasing index: among elements with equal `f`-value, `σ` preserves their order. This property does not use the order on the codomain of `f`, only its equality, so it is unchanged by reversing that order. ;)
(; //LEAN:IsStable ;)
IsStable : (f : (Elem X -> Z)) -> (x1 : (Elem X -> X)) -> Prop.

(; doc: `IsTrans X r` means the binary relation `r` on `X` is transitive. ;)
(; //LEAN:IsTrans ;)
IsTrans : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: **Alias** of `lt_of_le_of_ne`. ;)
(; //LEAN:LE.le.lt_of_ne ;)
LE__le__lt_of_ne : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Neq a b)) -> Proof (Lt a b).

(; doc: **Alias** of `lt_of_le_of_ne'`. ;)
(; //LEAN:LE.le.lt_of_ne' ;)
LE__le__lt_of_ne' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> (h1 : Proof (Neq a b)) -> Proof (Lt b a).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `lt_of_le_of_lt`. ;)
(; //LEAN:LE.le.trans_lt ;)
LE__le__trans_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: **Alias** of `ne_of_lt`. ;)
(; //LEAN:LT.lt.ne ;)
LT__lt__ne : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; doc: **Alias** of `lt_of_lt_of_le`. ;)
(; //LEAN:LT.lt.trans_le ;)
LT__lt__trans_le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Lt a b)) -> (hbc : Proof (Leq b c)) -> Proof (Lt a c).

(; doc: A linear order is reflexive, transitive, antisymmetric and total relation `≤`. We assume that every linear ordered type has decidable `(≤)`, `(<)`, and `(=)`. ;)
(; //LEAN:LinearOrder ;)
LinearOrder : (X : Set) -> Prop.

(; doc: Linked lists: ordered lists, in which each element has a reference to the next element.  Most operations on linked lists take time proportional to the length of the list, because each element must be traversed to find the next element.  `List α` is isomorphic to `Array α`, but they are useful for different things: * `List α` is easier for reasoning, and `Array α` is modeled as a wrapper around `List α`. * `List α` works well as a persistent data structure, when many copies of the tail are shared. When   the value is not shared, `Array α` will have better performance because it can do destructive   updates. ;)
(; //LEAN:List ;)
List : (X : Set) -> Set.

(; doc: Folds a function over a list from the left, accumulating a value starting with `init`. The accumulated value is combined with the each element of the list in order, using `f`.  Examples:  * `[a, b, c].foldl f z  = f (f (f z a) b) c`  * `[1, 2, 3].foldl (· ++ toString ·) "" = "123"`  * `[1, 2, 3].foldl (s!"({·} {·})") "" = "((( 1) 2) 3)"` ;)
(; //LEAN:List.foldl ;)
List__foldl : (f : (Elem X -> Elem Y -> X)) -> (init : Elem X) -> (x : Elem (List Y)) -> Elem X.

(; doc: Folds a function over a list from the right, accumulating a value starting with `init`. The accumulated value is combined with each element of the list in reverse order, using `f`.  `O(|l|)`. Replaced at runtime with `List.foldrTR`.  Examples:  * `[a, b, c].foldr f init  = f a (f b (f c init))`  * `[1, 2, 3].foldr (toString · ++ ·) "" = "123"`  * `[1, 2, 3].foldr (s!"({·} {·})") "!" = "(1 (2 (3 !)))"` ;)
(; //LEAN:List.foldr ;)
List__foldr : (f : (Elem X -> Elem Y -> Y)) -> (init : Elem Y) -> (l : Elem (List X)) -> Elem Y.

(; //LEAN:List.recOn ;)
List__recOn : (t : Elem (List X)) -> (nil : Elem (motive List__nil)) -> (cons : ((head : Elem X) -> (tail : Elem (List X)) -> Elem (motive tail) -> motive (List__cons head tail))) -> Elem (motive t).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: A function `f` is monotone if `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:Monotone ;)
Monotone : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:Monotone.strictMono_of_injective ;)
Monotone__strictMono_of_injective : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (PartialOrder Y)) -> (f : (Elem X -> Y)) -> (h : Proof (Monotone f)) -> (h1 : Proof (Function__Injective f)) -> Proof (StrictMono f).

(; doc: A function `f` is monotone on `s` if, for all `a, b ∈ s`, `a ≤ b` implies `f a ≤ f b`. ;)
(; //LEAN:MonotoneOn ;)
MonotoneOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Nat.add_le_add_iff_right ;)
Nat__add_le_add_iff_right : (m : Elem Nat) -> (k : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Leq (plus m n) (plus k n)) (Leq m k)).

(; //LEAN:Nat.le_add_left ;)
Nat__le_add_left : (n : Elem Nat) -> (m : Elem Nat) -> Proof (Leq n (plus m n)).

(; //LEAN:Nat.pos_iff_ne_zero ;)
Nat__pos_iff_ne_zero : (n : Elem Nat) -> Proof (iff (Lt 0 n) (Neq n 0)).

(; //LEAN:Nat.pow_le_pow_left ;)
Nat__pow_le_pow_left : (n : Elem Nat) -> (m : Elem Nat) -> (h : Proof (Leq n m)) -> (i : Elem Nat) -> Proof (Leq (pow n i) (pow m i)).

(; //LEAN:Nat.pow_le_pow_right ;)
Nat__pow_le_pow_right : (n : Elem Nat) -> (hx : Proof (Gt n 0)) -> (i : Elem Nat) -> (j : Elem Nat) -> (h : Proof (Leq i j)) -> Proof (Leq (pow n i) (pow n j)).

(; //LEAN:Nat.pow_lt_pow_left ;)
Nat__pow_lt_pow_left : (a : Elem Nat) -> (b : Elem Nat) -> (n : Elem Nat) -> (hab : Proof (Lt a b)) -> (h : Proof (Neq n 0)) -> Proof (Lt (pow a n) (pow b n)).

(; doc: Order without maximal elements. Sometimes called cofinal. ;)
(; //LEAN:NoMaxOrder ;)
NoMaxOrder : (X : Set) -> Prop.

(; doc: Order without minimal elements. Sometimes called coinitial or dense. ;)
(; //LEAN:NoMinOrder ;)
NoMinOrder : (X : Set) -> Prop.

(; doc: Type synonym to equip a type with the dual order: `≤` means `≥` and `<` means `>`. `αᵒᵈ` is notation for `OrderDual α`. ;)
(; //LEAN:OrderDual ;)
OrderDual : (X : Set) -> Set.

(; doc: `ofDual` is the identity function from the `OrderDual` of a linear order. ;)
(; //LEAN:OrderDual.ofDual ;)
OrderDual__ofDual : Elem (Equiv (OrderDual X) X).

(; doc: `toDual` is the identity function to the `OrderDual` of a linear order. ;)
(; //LEAN:OrderDual.toDual ;)
OrderDual__toDual : Elem (Equiv X (OrderDual X)).

(; doc: The result of a comparison according to a total order.  The relationship between the compared items may be: * `Ordering.lt`: less than * `Ordering.eq`: equal * `Ordering.gt`: greater than ;)
(; //LEAN:Ordering ;)
Ordering : Set.

(; doc: `Compares o a b` means that `a` and `b` have the ordering relation `o` between them, assuming that the relation `a < b` is defined. ;)
(; //LEAN:Ordering.Compares ;)
Ordering__Compares : (x1 : Elem Ordering) -> (x2 : Elem X) -> (x3 : Elem X) -> Prop.

(; //LEAN:Ordering.Compares.cmp_eq ;)
Ordering__Compares__cmp_eq : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (o : Elem Ordering) -> (h : Proof (Ordering__Compares o a b)) -> Proof (Eqt Ordering (cmp a b) o).

(; doc: Equal. ;)
(; //LEAN:Ordering.eq ;)
Ordering__eq : Elem Ordering.

(; doc: A partial order is a reflexive, transitive, antisymmetric relation `≤`. ;)
(; //LEAN:PartialOrder ;)
PartialOrder : (X : Set) -> Prop.

(; doc: A preorder is a reflexive, transitive relation `≤`. In a preorder, `a < b` means `a ≤ b ∧ ¬b ≤ a`, and `<` is defined this way by default. You can override this definition to set a better def-eq. ;)
(; //LEAN:Preorder ;)
Preorder : (X : Set) -> Prop.

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; doc: `f` is injective on `s` if the restriction of `f` to `s` is injective. ;)
(; //LEAN:Set.InjOn ;)
Set__InjOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : Elem (powerset X).

(; doc: `Refl r` means the binary relation `r` is reflexive, that is, `r x x` always holds. ;)
(; //LEAN:Std.Refl ;)
Std__Refl : (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: A function `f` is strictly antitone if `a < b` implies `f b < f a`. ;)
(; //LEAN:StrictAnti ;)
StrictAnti : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:StrictAnti.imp ;)
StrictAnti__imp : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (StrictAnti f)) -> (h : Proof (Lt a b)) -> Proof (Lt (f b) (f a)).

(; //LEAN:StrictAnti.strictAntiOn ;)
StrictAnti__strictAntiOn : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (hf : Proof (StrictAnti f)) -> (s : Elem (powerset X)) -> Proof (StrictAntiOn f s).

(; doc: A function `f` is strictly antitone on `s` if, for all `a, b ∈ s`, `a < b` implies `f b < f a`. ;)
(; //LEAN:StrictAntiOn ;)
StrictAntiOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A function `f` is strictly monotone if `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMono ;)
StrictMono : (f : (Elem X -> Y)) -> Prop.

(; //LEAN:StrictMono.imp ;)
StrictMono__imp : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem X) -> (hf : Proof (StrictMono f)) -> (h : Proof (Lt a b)) -> Proof (Lt (f a) (f b)).

(; //LEAN:StrictMono.strictMonoOn ;)
StrictMono__strictMonoOn : (X : Set) -> (Y : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (Preorder Y)) -> (f : (Elem X -> Y)) -> (hf : Proof (StrictMono f)) -> (s : Elem (powerset X)) -> Proof (StrictMonoOn f s).

(; doc: A function `f` is strictly monotone on `s` if, for all `a, b ∈ s`, `a < b` implies `f a < f b`. ;)
(; //LEAN:StrictMonoOn ;)
StrictMonoOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Subrelation.isWellFounded ;)
Subrelation__isWellFounded : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (_ : Proof (WellFounded r)) -> (s : (Elem X -> Elem X -> Prop)) -> (h : Proof (Subrelation s r)) -> Proof (WellFounded s).

(; doc: A class for a well-founded relation `>`. ;)
(; //LEAN:WellFoundedGT ;)
WellFoundedGT : (X : Set) -> Prop.

(; doc: A class for a well-founded relation `<`. ;)
(; //LEAN:WellFoundedLT ;)
WellFoundedLT : (X : Set) -> Prop.

(; doc: Construct an `Ordering` from a type with a decidable `LT` instance, assuming that incomparable terms are `Ordering.eq`. ;)
(; //LEAN:cmp ;)
cmp : (a : Elem X) -> (b : Elem X) -> Elem Ordering.

(; //LEAN:cmp_compares ;)
cmp_compares : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Ordering__Compares (cmp a b) a b).

(; //LEAN:eq_comm ;)
eq_comm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Eqt X a b) (Eqt X b a)).

(; //LEAN:forall_comm ;)
forall_comm : (X : Set) -> (Y : Set) -> (p : (Elem X -> Elem Y -> Prop)) -> Proof (iff (forall X (a => forall Y (b => p a b))) (forall Y (b1 => forall X (a1 => p a1 b1)))).

(; //LEAN:forall₂_comm ;)
forall_u2082__comm : (X : Set) -> (X1 : Set) -> (x : (Elem X -> Set)) -> (x1 : (Elem X1 -> Set)) -> (p : ((x10 : Elem X) -> Elem (x x10) -> (x12 : Elem X1) -> Elem (x1 x12) -> Prop)) -> Proof (iff (forall X (x2 => forall (x x2) (x3 => forall X1 (x4 => forall (x1 x4) (x5 => p x2 x3 x4 x5))))) (forall X1 (x6 => forall (x1 x6) (x7 => forall X (x8 => forall (x x8) (x9 => p x8 x9 x6 x7)))))).

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; doc: `if c then t else e` is notation for `ite c t e`, "if-then-else", which decides to return `t` or `e` depending on whether `c` is true or false. The explicit argument `c : Prop` does not have any actual computational content, but there is an additional `[Decidable c]` argument synthesized by typeclass inference which actually determines how to evaluate `c` to true or false. Write `if h : c then t else e` instead for a "dependent if-then-else" `dite`, which allows `t`/`e` to use the fact that `c` is true/false.  Conventions for notations in identifiers:   * The recommended spelling of `if c then t else e` in identifiers is `ite` (use `left` for `t` and `right` for `e`). ;)
(; //LEAN:ite ;)
ite : (c : Prop) -> (t : Elem X) -> (e : Elem X) -> Elem X.

(; //LEAN:le_antisymm ;)
le_antisymm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b a)) -> Proof (Eqt X a b).

(; doc: A version of `le_refl` where the argument is implicit ;)
(; //LEAN:le_rfl ;)
le_rfl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; //LEAN:mt ;)
mt : (a : Prop) -> (b : Prop) -> (h : Proof (if a b)) -> (h1 : Proof (not b)) -> Proof (not a).

(; //LEAN:toDual_compares_toDual ;)
toDual_compares_toDual : (X : Set) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (o : Elem Ordering) -> Proof (iff (Ordering__Compares o (OrderDual__toDual__app a) (OrderDual__toDual__app b)) (Ordering__Compares o b a)).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

