(; //LEAN:monotone_int_of_le_succ ;)
def monotone_int_of_le_succ : (X : Set) -> (_ : Proof (Preorder X)) -> (f : (Elem Int -> X)) -> (hf : Proof (forall Int (n => Leq (f n) (f (plus n 1))))) -> Proof (Monotone Int X f) :=
  X => x => f => hf => Int__rel_of_forall_rel_succ_of_le X (x1 => x2 => Leq x1 x2) f hf.

(; //LEAN:antitone_int_of_succ_le ;)
