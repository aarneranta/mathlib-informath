(; Mathlib.RingTheory.Ideal.Basic: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:Ideal.pi ;)
def Ideal__pi : (I1 : ((i1 : Elem I) -> Ideal (R i1))) -> Elem (Ideal ((i : Elem I) -> R i)) :=
  I1 => Submodule__mk (AddSubmonoid__mk (AddSubsemigroup__mk (Set__ofPred (r => forall I (i => Membership__mem (I1 i) (r i)))) (Ideal__pi___proof_1 I1)) (Ideal__pi___proof_2 I1)) (Ideal__pi___proof_3 I1).

(; //LEAN:Ideal.mem_pi ;)
def Ideal__mem_pi : (I : Set) -> (R : (Elem I -> Set)) -> (_ : Proof ((i3 : Elem I) -> Semiring (R i3))) -> (I1 : ((i2 : Elem I) -> Ideal (R i2))) -> (r : ((i1 : Elem I) -> R i1)) -> Proof (iff (Membership__mem (Ideal__pi I1) r) (forall I (i => Membership__mem (I1 i) (r i)))) :=
  I => R => x => I1 => r => Iff__rfl (Membership__mem (Ideal__pi I1) r).

(; //LEAN:Ideal.pi_span ;)
Ideal__pi_span : (I : Set) -> (R : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Semiring (R i2))) -> (r : ((i1 : Elem I) -> R i1)) -> Proof (Eqt (Ideal ((i : Elem I) -> R i)) (Ideal__pi (x1 => Ideal__span (Singleton__singleton (r x1)))) (Ideal__span (Singleton__singleton r))).

(; //LEAN:Ideal.single_mem_pi ;)
Ideal__single_mem_pi : (I : Set) -> (R : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Semiring (R i2))) -> (I1 : ((i1 : Elem I) -> Ideal (R i1))) -> (i : Elem I) -> (r : Elem (R i)) -> (hr : Proof (Membership__mem (I1 i) r)) -> Proof (Membership__mem (Ideal__pi I1) (Pi__single i r)).

(; //LEAN:Ideal.pi_le_pi_iff ;)
Ideal__pi_le_pi_iff : (I : Set) -> (R : (Elem I -> Set)) -> (_ : Proof ((i2 : Elem I) -> Semiring (R i2))) -> (I1 : ((i1 : Elem I) -> Ideal (R i1))) -> (J : ((i : Elem I) -> Ideal (R i))) -> Proof (iff (Leq (Ideal__pi I1) (Ideal__pi J)) (Leq I1 J)).

(; //LEAN:Ideal.add_pow_mem_of_pow_mem_of_le_of_commute ;)
Ideal__add_pow_mem_of_pow_mem_of_le_of_commute : (X : Set) -> (_ : Proof (Semiring X)) -> (I : Elem (Ideal X)) -> (a : Elem X) -> (b : Elem X) -> (m : Elem Nat) -> (n : Elem Nat) -> (k : Elem Nat) -> (ha : Proof (Membership__mem I (pow a m))) -> (hb : Proof (Membership__mem I (pow b n))) -> (hk : Proof (Leq (plus m n) (plus k 1))) -> (hab : Proof (Commute a b)) -> Proof (Membership__mem I (pow (plus a b) k)).

(; //LEAN:Ideal.add_pow_add_pred_mem_of_pow_mem_of_commute ;)
def Ideal__add_pow_add_pred_mem_of_pow_mem_of_commute : (X : Set) -> (_ : Proof (Semiring X)) -> (I : Elem (Ideal X)) -> (a : Elem X) -> (b : Elem X) -> (m : Elem Nat) -> (n : Elem Nat) -> (ha : Proof (Membership__mem I (pow a m))) -> (hb : Proof (Membership__mem I (pow b n))) -> (hab : Proof (Commute a b)) -> Proof (Membership__mem I (pow (plus a b) (minus (plus m n) 1))) :=
  X => x => I => a => b => m => n => ha => hb => hab => Ideal__add_pow_mem_of_pow_mem_of_le_of_commute X I a b m n (minus (plus m n) 1) ha hb (Eq__mpr (id (congrArg Prop Prop (Leq (plus m n) (plus (minus (plus m n) 1) 1)) (Leq (minus (plus m n) 1) (minus (plus m n) 1)) (_a => _a) (Eq__symm Prop (Leq (minus (plus m n) 1) (minus (plus m n) 1)) (Leq (plus m n) (plus (minus (plus m n) 1) 1)) (propext (Leq (minus (plus m n) 1) (minus (plus m n) 1)) (Leq (plus m n) (plus (minus (plus m n) 1) 1)) (Nat__sub_le_iff_le_add (plus m n) 1 (minus (plus m n) 1)))))) (le_refl Nat (minus (plus m n) 1))) hab.

(; //LEAN:Ideal.add_pow_mem_of_pow_mem_of_le ;)
def Ideal__add_pow_mem_of_pow_mem_of_le : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (CommSemiring X)) -> (I : Elem (Ideal X)) -> (m : Elem Nat) -> (n : Elem Nat) -> (k : Elem Nat) -> (ha : Proof (Membership__mem I (pow a m))) -> (hb : Proof (Membership__mem I (pow b n))) -> (hk : Proof (Leq (plus m n) (plus k 1))) -> Proof (Membership__mem I (pow (plus a b) k)) :=
  X => a => b => x => I => m => n => k => ha => hb => hk => Ideal__add_pow_mem_of_pow_mem_of_le_of_commute X I a b m n k ha hb hk (Commute__all X a b).

(; //LEAN:Ideal.add_pow_add_pred_mem_of_pow_mem ;)
def Ideal__add_pow_add_pred_mem_of_pow_mem : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (_ : Proof (CommSemiring X)) -> (I : Elem (Ideal X)) -> (m : Elem Nat) -> (n : Elem Nat) -> (ha : Proof (Membership__mem I (pow a m))) -> (hb : Proof (Membership__mem I (pow b n))) -> Proof (Membership__mem I (pow (plus a b) (minus (plus m n) 1))) :=
  X => a => b => x => I => m => n => ha => hb => Ideal__add_pow_add_pred_mem_of_pow_mem_of_commute X I a b m n ha hb (Commute__all X a b).

(; //LEAN:Ideal.pow_multiset_sum_mem_span_pow ;)
Ideal__pow_multiset_sum_mem_span_pow : (X : Set) -> (_ : Proof (CommSemiring X)) -> (s : Elem (Multiset X)) -> (n : Elem Nat) -> Proof (Membership__mem (Ideal__span (Multiset__toFinset (Multiset__map (x2 => pow x2 (plus n 1)) s))) (pow (Multiset__sum s) (plus (times (Multiset__card s) n) 1))).

(; //LEAN:Ideal.sum_pow_mem_span_pow ;)
Ideal__sum_pow_mem_span_pow : (X : Set) -> (_ : Proof (CommSemiring X)) -> (I : Set) -> (s : Elem (Finset I)) -> (f : (Elem I -> X)) -> (n : Elem Nat) -> Proof (Membership__mem (Ideal__span (Set__image (i => pow (f i) (plus n 1)) s)) (pow (Finset__sum s (i1 => f i1)) (plus (times (Finset__card s) n) 1))).

(; //LEAN:Ideal.span_pow_eq_top ;)
Ideal__span_pow_eq_top : (X : Set) -> (_ : Proof (CommSemiring X)) -> (s : Elem (powerset X)) -> (hs : Proof (Eqt (Ideal X) (Ideal__span s) Top__top)) -> (n : Elem Nat) -> Proof (Eqt (Ideal X) (Ideal__span (Set__image (x1 => pow x1 n) s)) Top__top).

(; //LEAN:Ideal.span_range_pow_eq_top ;)
Ideal__span_range_pow_eq_top : (X : Set) -> (_ : Proof (CommSemiring X)) -> (s : Elem (powerset X)) -> (hs : Proof (Eqt (Ideal X) (Ideal__span s) Top__top)) -> (n : (Elem (Set__Elem s) -> Nat)) -> Proof (Eqt (Ideal X) (Ideal__span (Set__range (x1 => pow x1 (n x1)))) Top__top).

(; //LEAN:Ideal.prod_mem ;)
Ideal__prod_mem : (X : Set) -> (_ : Proof (CommSemiring X)) -> (I : Set) -> (f : (Elem I -> X)) -> (s : Elem (Finset I)) -> (I1 : Elem (Ideal X)) -> (i : Elem I) -> (hi : Proof (Membership__mem s i)) -> (hfi : Proof (Membership__mem I1 (f i))) -> Proof (Membership__mem I1 (Finset__prod s (i1 => f i1))).

(; //LEAN:Ideal.span_single_eq_top ;)
Ideal__span_single_eq_top : (I : Set) -> (_ : Proof (Finite I)) -> (R : (Elem I -> Set)) -> (_ : Proof ((i1 : Elem I) -> Semiring (R i1))) -> Proof (Eqt (Ideal ((j : Elem I) -> R j)) (Ideal__span (Set__range (i => Pi__single i 1))) Top__top).

(; //LEAN:Ideal.equivFinTwo ;)
def Ideal__equivFinTwo : (K : Set) -> Elem (Equiv (Ideal K) (Fin 2)) :=
  K => Equiv__mk (I => ite (Eqt (Ideal K) I Bot__bot) 0 1) (Matrix__vecCons Bot__bot (Matrix__vecCons Top__top Matrix__vecEmpty)) (I1 => Ideal__equivFinTwo___proof_1 K I1) (i => Ideal__equivFinTwo___proof_2 K i).

(; //LEAN:Ring.exists_not_isUnit_of_not_isField ;)
Ring__exists_not_isUnit_of_not_isField : (R : Set) -> (_ : Proof (CommSemiring R)) -> (hf : Proof (not (IsField R))) -> Proof (exists R (x1 => exists (Neq x1 0) (_hx => not (IsUnit x1)))).

(; //LEAN:Ring.isField_iff_maximal_bot ;)
Ring__isField_iff_maximal_bot : (R : Set) -> (_ : Proof (CommSemiring R)) -> Proof (iff (IsField R) (Ideal__IsMaximal Bot__bot)).

(; //LEAN:Ring.exists_maximal_of_not_isField ;)
Ring__exists_maximal_of_not_isField : (R : Set) -> (_ : Proof (CommSemiring R)) -> (h1 : Proof (not (IsField R))) -> Proof (exists (Ideal R) (p => and (Neq p Bot__bot) (Ideal__IsMaximal p))).

(; //LEAN:Ring.not_isField_of_ne_of_ne ;)
Ring__not_isField_of_ne_of_ne : (R : Set) -> (_ : Proof (CommSemiring R)) -> (I : Elem (Ideal R)) -> (h_bot : Proof (Neq I Bot__bot)) -> (h_top : Proof (Neq I Top__top)) -> Proof (not (IsField R)).

(; //LEAN:Ring.not_isField_iff_exists_ideal_bot_lt_and_lt_top ;)
Ring__not_isField_iff_exists_ideal_bot_lt_and_lt_top : (R : Set) -> (_ : Proof (CommSemiring R)) -> Proof (iff (not (IsField R)) (exists (Ideal R) (I => and (Lt Bot__bot I) (Lt I Top__top)))).

(; //LEAN:Ring.not_isField_iff_exists_prime ;)
Ring__not_isField_iff_exists_prime : (R : Set) -> (_ : Proof (CommSemiring R)) -> Proof (iff (not (IsField R)) (exists (Ideal R) (p => and (Neq p Bot__bot) (Ideal__IsPrime p)))).

(; //LEAN:Ring.isField_iff_isSimpleOrder_ideal ;)
Ring__isField_iff_isSimpleOrder_ideal : (R : Set) -> (_ : Proof (CommSemiring R)) -> Proof (iff (IsField R) (IsSimpleOrder (Ideal R))).

(; //LEAN:Ring.ne_bot_of_isMaximal_of_not_isField ;)
Ring__ne_bot_of_isMaximal_of_not_isField : (R : Set) -> (_ : Proof (CommSemiring R)) -> (M : Elem (Ideal R)) -> (max : Proof (Ideal__IsMaximal M)) -> (not_field : Proof (not (IsField R))) -> Proof (Neq M Bot__bot).

(; //LEAN:Ideal.bot_lt_of_maximal ;)
def Ideal__bot_lt_of_maximal : (R : Set) -> (_ : Proof (CommSemiring R)) -> (M : Elem (Ideal R)) -> (_ : Proof (Ideal__IsMaximal M)) -> (non_field : Proof (not (IsField R))) -> Proof (Lt Bot__bot M) :=
  R => x => M => hm => non_field => Ne__bot_lt (Ideal R) M (Ring__ne_bot_of_isMaximal_of_not_isField R M hm non_field).

