(; constants used by Mathlib.RingTheory.Ideal.Defs, declared with their translated types ;)

(; //LEAN:AddSubgroup.coe_mem_inertia ;)
AddSubgroup__coe_mem_inertia : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (H : Elem (Subgroup G)) -> (x3 : Elem (Subtype G (x8 => Membership__mem G (Subgroup G) H x8))) -> Proof (iff (Membership__mem G (Subgroup G) (AddSubgroup__inertia M I G) (Subtype__val G (x4 => Membership__mem G (Subgroup G) H x4) x3)) (Membership__mem (Subtype G (x5 => Membership__mem G (Subgroup G) H x5)) (Subgroup (Subtype G (x6 => Membership__mem G (Subgroup G) H x6))) (AddSubgroup__inertia M I (Subtype G (x7 => Membership__mem G (Subgroup G) H x7))) x3)).

(; doc: Suppose `G` acts on `M` and `I` is a subgroup of `M`. The inertia subgroup of `I` is the subgroup of `G` whose action is trivial mod `I`. ;)
(; //LEAN:AddSubgroup.inertia ;)
AddSubgroup__inertia : (M : Set) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> Elem (Subgroup G).

(; //LEAN:AddSubgroup.mem_inertia ;)
AddSubgroup__mem_inertia : (M : Set) -> (_ : Proof (AddGroup M)) -> (I : Elem (AddSubgroup M)) -> (G : Set) -> (_ : Proof (Group G)) -> (_ : Proof (MulAction G M)) -> (x3 : Elem G) -> Proof (iff (Membership__mem G (Subgroup G) (AddSubgroup__inertia M I G) x3) (forall M (x4 => Membership__mem M (AddSubgroup M) I (minus (HSMul__hSMul G M M x3 x4) x4)))).

(; //LEAN:AddSubmonoid.mk ;)
AddSubmonoid__mk : (M : Set) -> (toAddSubsemigroup : Elem (AddSubsemigroup M)) -> (zero_mem' : Proof (Membership__mem M (powerset M) (AddSubsemigroup__carrier M toAddSubsemigroup) 0)) -> Elem (AddSubmonoid M).

(; //LEAN:AddSubsemigroup.mk ;)
AddSubsemigroup__mk : (M : Set) -> (carrier : Elem (powerset M)) -> (add_mem' : Proof (forall M (a => forall M (b => if (Membership__mem M (powerset M) carrier a) (if (Membership__mem M (powerset M) carrier b) (Membership__mem M (powerset M) carrier (plus a b))))))) -> Elem (AddSubsemigroup M).

(; doc: A commutative semiring is a semiring with commutative multiplication. ;)
(; //LEAN:CommSemiring ;)
CommSemiring : (R : Set) -> Prop.

(; doc: A `Group` is a `Monoid` with an operation `⁻¹` satisfying `a⁻¹ * a = 1`.  There is also a division operation `/` such that `a / b = a * b⁻¹`, with a default so that `a / b = a * b⁻¹` holds by definition.  Use `Group.ofLeftAxioms` or `Group.ofRightAxioms` to define a group structure on a type with the minimum proof obligations.  [Wikidata Q83478](https://www.wikidata.org/wiki/Q83478) ;)
(; //LEAN:Group ;)
Group : (G : Set) -> Prop.

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (M : Set) -> (a : Elem M) -> Prop.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; //LEAN:Module.eqIdeal._proof_1 ;)
Module__eqIdeal___proof_1 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (m : Elem M) -> (m' : Elem M) -> (x3 : Elem R) -> (x4 : Elem R) -> (h : Proof (Membership__mem R (powerset R) (Set__ofPred R (r2 => Eqt M (HSMul__hSMul R M M r2 m) (HSMul__hSMul R M M r2 m'))) x3)) -> (h' : Proof (Membership__mem R (powerset R) (Set__ofPred R (r1 => Eqt M (HSMul__hSMul R M M r1 m) (HSMul__hSMul R M M r1 m'))) x4)) -> Proof (Membership__mem R (powerset R) (Set__ofPred R (r => Eqt M (HSMul__hSMul R M M r m) (HSMul__hSMul R M M r m'))) (plus x3 x4)).

(; //LEAN:Module.eqIdeal._proof_3 ;)
Module__eqIdeal___proof_3 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (m : Elem M) -> (m' : Elem M) -> Proof (Membership__mem R (powerset R) (Set__ofPred R (r => Eqt M (HSMul__hSMul R M M r m) (HSMul__hSMul R M M r m'))) 0).

(; //LEAN:Module.eqIdeal._proof_4 ;)
Module__eqIdeal___proof_4 : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (m : Elem M) -> (m' : Elem M) -> (x3 : Elem R) -> (x4 : Elem R) -> (h : Proof (Membership__mem R (powerset R) (Set__ofPred R (r1 => Eqt M (HSMul__hSMul R M M r1 m) (HSMul__hSMul R M M r1 m'))) x4)) -> Proof (Membership__mem R (powerset R) (Set__ofPred R (r => Eqt M (HSMul__hSMul R M M r m) (HSMul__hSMul R M M r m'))) (HSMul__hSMul R R R x3 x4)).

(; doc: Type class for monoid actions on types, with notation `g • p`.  The `MulAction G P` typeclass says that the monoid `G` acts multiplicatively on a type `P`. More precisely this means that the action satisfies the two axioms `1 • p = p` and `(g₁ * g₂) • p = g₁ • (g₂ • p)`. A mathematician might simply say that the monoid `G` acts on `P`.  For example, if `G` is a group and `X` is a type, if a mathematician says say "let `G` act on the set `X`" they will probably mean `[MulAction G X]`.  [Wikidata Q288465](https://www.wikidata.org/wiki/Q288465) ;)
(; //LEAN:MulAction ;)
MulAction : (X : Set) -> (Y : Set) -> Prop.

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; //LEAN:Semiring.toModule ;)
Semiring__toModule : (R : Set) -> Proof (Module R R).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: A subgroup of a group `G` is a subset containing 1, closed under multiplication and closed under multiplicative inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:Subgroup ;)
Subgroup : (G : Set) -> Set.

(; doc: A submodule of a module is one which is closed under vector operations. This is a sufficient condition for the subset of vectors in the submodule to themselves form a module. ;)
(; //LEAN:Submodule ;)
Submodule : (R : Set) -> (M : Set) -> Set.

(; //LEAN:Submodule.add_mem ;)
Submodule__add_mem : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (y : Elem M) -> (h : Proof (Membership__mem M (Submodule R M) p x2)) -> (h1 : Proof (Membership__mem M (Submodule R M) p y)) -> Proof (Membership__mem M (Submodule R M) p (plus x2 y)).

(; //LEAN:Submodule.add_mem_iff_left ;)
Submodule__add_mem_iff_left : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (y : Elem M) -> (h : Proof (Membership__mem M (Submodule R M) p y)) -> Proof (iff (Membership__mem M (Submodule R M) p (plus x2 y)) (Membership__mem M (Submodule R M) p x2)).

(; //LEAN:Submodule.add_mem_iff_right ;)
Submodule__add_mem_iff_right : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (y : Elem M) -> (h : Proof (Membership__mem M (Submodule R M) p x2)) -> Proof (iff (Membership__mem M (Submodule R M) p (plus x2 y)) (Membership__mem M (Submodule R M) p y)).

(; //LEAN:Submodule.ext ;)
Submodule__ext : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (q : Elem (Submodule R M)) -> (h : Proof (forall M (x3 => iff (Membership__mem M (Submodule R M) p x3) (Membership__mem M (Submodule R M) q x3)))) -> Proof (Eqt (Submodule R M) p q).

(; //LEAN:Submodule.mk ;)
Submodule__mk : (R : Set) -> (M : Set) -> (toAddSubmonoid : Elem (AddSubmonoid M)) -> (smul_mem' : Proof (forall R (c => forall M (x3 => if (Membership__mem M (powerset M) (AddSubsemigroup__carrier M (AddSubmonoid__toAddSubsemigroup M toAddSubmonoid)) x3) (Membership__mem M (powerset M) (AddSubsemigroup__carrier M (AddSubmonoid__toAddSubsemigroup M toAddSubmonoid)) (HSMul__hSMul R M M c x3)))))) -> Elem (Submodule R M).

(; //LEAN:Submodule.neg_mem_iff ;)
Submodule__neg_mem_iff : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> Proof (iff (Membership__mem M (Submodule R M) p (Neg__neg M x2)) (Membership__mem M (Submodule R M) p x2)).

(; //LEAN:Submodule.smul_mem ;)
Submodule__smul_mem : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (r : Elem R) -> (h : Proof (Membership__mem M (Submodule R M) p x2)) -> Proof (Membership__mem M (Submodule R M) p (HSMul__hSMul R M M r x2)).

(; //LEAN:Submodule.sub_mem ;)
Submodule__sub_mem : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x2 : Elem M) -> (y : Elem M) -> (h : Proof (Membership__mem M (Submodule R M) p x2)) -> (h1 : Proof (Membership__mem M (Submodule R M) p y)) -> Proof (Membership__mem M (Submodule R M) p (minus x2 y)).

(; doc: Reinterpret a submodule as an additive subgroup. ;)
(; //LEAN:Submodule.toAddSubgroup ;)
Submodule__toAddSubgroup : (R : Set) -> (M : Set) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Elem (AddSubgroup M).

(; //LEAN:Submodule.zero_mem ;)
Submodule__zero_mem : (R : Set) -> (M : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (AddCommMonoid M)) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Proof (Membership__mem M (Submodule R M) p 0).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

