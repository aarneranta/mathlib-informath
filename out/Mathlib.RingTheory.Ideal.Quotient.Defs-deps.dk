(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: The backward map of an equivalence.  Do NOT use `e.invFun` directly. Use the coercion of `e.symm` instead. ;)
(; //LEAN:LinearEquiv.invFun ;)
LinearEquiv__invFun : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (x3 : Elem (RingHom S R)) -> (M : Set) -> (X : Set) -> (self : Elem (LinearEquiv R S x2 x3 M X)) -> (x8 : Elem X) -> Elem M.

(; doc: The linear map underlying a linear equivalence. ;)
(; //LEAN:LinearEquiv.toLinearMap ;)
LinearEquiv__toLinearMap : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (x3 : Elem (RingHom S R)) -> (M : Set) -> (X : Set) -> (self : Elem (LinearEquiv R S x2 x3 M X)) -> Elem (LinearMap R S x2 M X).

(; doc: The `AddHom` underlying a `LinearMap`. ;)
(; //LEAN:LinearMap.toAddHom ;)
LinearMap__toAddHom : (R : Set) -> (S : Set) -> (x2 : Elem (RingHom R S)) -> (M : Set) -> (X : Set) -> (self : Elem (LinearMap R S x2 M X)) -> Elem (AddHom M X).

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; //LEAN:MonoidHom.mk ;)
MonoidHom__mk : (M : Set) -> (N : Set) -> (toOneHom : Elem (OneHom M N)) -> (map_mul' : Proof (forall M (x2 => forall M (y => Eqt N (OneHom__toFun M N toOneHom (times x2 y)) (times (OneHom__toFun M N toOneHom x2) (OneHom__toFun M N toOneHom y)))))) -> Elem (MonoidHom M N).

(; doc: A unital but not-necessarily-associative semiring. ;)
(; //LEAN:NonAssocSemiring ;)
NonAssocSemiring : (X : Set) -> Prop.

(; //LEAN:OneHom.mk ;)
OneHom__mk : (M : Set) -> (N : Set) -> (toFun : (Elem M -> N)) -> (map_one' : Proof (Eqt N (toFun 1) 1)) -> Elem (OneHom M N).

(; doc: A version of `Quotient.inductionOn` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.inductionOn' ;)
Quotient__inductionOn' : (X : Set) -> (x : Proof (Setoid X)) -> (p : (Elem (Quotient X x) -> Prop)) -> (q : Elem (Quotient X x)) -> (h : Proof (forall X (a => p (Quotient__mk'' X x a)))) -> Proof (p q).

(; doc: A version of `Quotient.mk` taking `{s : Setoid α}` as an implicit argument instead of an instance argument. ;)
(; //LEAN:Quotient.mk'' ;)
Quotient__mk'' : (X : Set) -> (x : Proof (Setoid X)) -> (a : Elem X) -> Elem (Quotient X x).

(; doc: Choose an element of the equivalence class using the axiom of choice. Sound but noncomputable. ;)
(; //LEAN:Quotient.out ;)
Quotient__out : (X : Set) -> (s : Proof (Setoid X)) -> (x : Elem (Quotient X s)) -> Elem X.

(; //LEAN:Quotient.out_eq ;)
Quotient__out_eq : (X : Set) -> (s : Proof (Setoid X)) -> (q : Elem (Quotient X s)) -> Proof (Eqt (Quotient X s) (Quotient__mk X s (Quotient__out X s q)) q).

(; doc: The additive congruence relation generated by a normal additive subgroup. ;)
(; //LEAN:QuotientAddGroup.con ;)
QuotientAddGroup__con : (G : Set) -> (N : Elem (AddSubgroup G)) -> Elem (AddCon G).

(; doc: An `AddGroup` homomorphism `φ : G →+ M` with `N ⊆ ker(φ)` descends (i.e. `lift`s) to an `AddGroup` homomorphism `G/N →+ M`. ;)
(; //LEAN:QuotientAddGroup.lift ;)
QuotientAddGroup__lift : (G : Set) -> (M : Set) -> (N : Elem (AddSubgroup G)) -> (x2 : Elem (AddMonoidHom G M)) -> (HN : Proof (Leq N (AddMonoidHom__ker G M x2))) -> Elem (AddMonoidHom (HasQuotient__Quotient G (AddSubgroup G) N) M).

(; doc: A `Ring` is a `Semiring` with negation making it an additive group. ;)
(; //LEAN:Ring ;)
Ring : (R : Set) -> Prop.

(; doc: A congruence relation on a type with an addition and multiplication is an equivalence relation which preserves both. ;)
(; //LEAN:RingCon ;)
RingCon : (R : Set) -> Set.

(; //LEAN:RingCon.mk ;)
RingCon__mk : (R : Set) -> (toCon : Elem (Con R)) -> (add' : Proof (forall R (w => forall R (x2 => forall R (y => forall R (z => if (Setoid__r__in R (Con__toSetoid R toCon) w x2) (if (Setoid__r__in R (Con__toSetoid R toCon) y z) (Setoid__r__in R (Con__toSetoid R toCon) (plus w y) (plus x2 z))))))))) -> Elem (RingCon R).

(; doc: An equivalence between two (non-unital non-associative semi)rings that preserves the algebraic structure. ;)
(; //LEAN:RingEquiv ;)
RingEquiv : (R : Set) -> (S : Set) -> Set.

(; //LEAN:RingEquiv.mk ;)
RingEquiv__mk : (R : Set) -> (S : Set) -> (toEquiv : Elem (Equiv R S)) -> (map_mul' : Proof (forall R (x5 => forall R (y1 => Eqt S (Equiv__toFun R S toEquiv (times x5 y1)) (times (Equiv__toFun R S toEquiv x5) (Equiv__toFun R S toEquiv y1)))))) -> (map_add' : Proof (forall R (x4 => forall R (y => Eqt S (Equiv__toFun R S toEquiv (plus x4 y)) (plus (Equiv__toFun R S toEquiv x4) (Equiv__toFun R S toEquiv y)))))) -> Elem (RingEquiv R S).

(; doc: The inverse of a ring isomorphism is a ring isomorphism. ;)
(; //LEAN:RingEquiv.symm ;)
RingEquiv__symm : (R : Set) -> (S : Set) -> (e : Elem (RingEquiv R S)) -> Elem (RingEquiv S R).

(; doc: Bundled semiring homomorphisms; use this for bundled ring homomorphisms too.  This extends from both `MonoidHom` and `MonoidWithZeroHom` in order to put the fields in a sensible order, even though `MonoidWithZeroHom` already extends `MonoidHom`. ;)
(; //LEAN:RingHom ;)
RingHom : (X : Set) -> (Y : Set) -> Set.

(; doc: Composition of ring homomorphisms is a ring homomorphism. ;)
(; //LEAN:RingHom.comp ;)
RingHom__comp : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Proof (NonAssocSemiring X)) -> (x1 : Proof (NonAssocSemiring Y)) -> (x2 : Proof (NonAssocSemiring Z)) -> (g : Elem (RingHom Y Z)) -> (f : Elem (RingHom X Y)) -> Elem (RingHom X Z).

(; //LEAN:RingHom.congr_fun ;)
RingHom__congr_fun : (X : Set) -> (Y : Set) -> (x : Proof (NonAssocSemiring X)) -> (x1 : Proof (NonAssocSemiring Y)) -> (f : Elem (RingHom X Y)) -> (g : Elem (RingHom X Y)) -> (h : Proof (Eqt (RingHom X Y) f g)) -> (x2 : Elem X) -> Proof (Eqt Y (f x2) (g x2)).

(; //LEAN:RingHom.ext ;)
RingHom__ext : (X : Set) -> (Y : Set) -> (x : Proof (NonAssocSemiring X)) -> (x1 : Proof (NonAssocSemiring Y)) -> (f : Elem (RingHom X Y)) -> (g : Elem (RingHom X Y)) -> (h : Proof (forall X (x2 => Eqt Y (f x2) (g x2)))) -> Proof (Eqt (RingHom X Y) f g).

(; doc: The identity ring homomorphism from a semiring to itself. ;)
(; //LEAN:RingHom.id ;)
RingHom__id : (X : Set) -> Elem (RingHom X X).

(; //LEAN:RingHom.mk ;)
RingHom__mk : (X : Set) -> (Y : Set) -> (toMonoidHom : Elem (MonoidHom X Y)) -> (map_zero' : Proof (Eqt Y (OneHom__toFun X Y (MonoidHom__toOneHom X Y toMonoidHom) 0) 0)) -> (map_add' : Proof (forall X (x2 => forall X (y => Eqt Y (OneHom__toFun X Y (MonoidHom__toOneHom X Y toMonoidHom) (plus x2 y)) (plus (OneHom__toFun X Y (MonoidHom__toOneHom X Y toMonoidHom) x2) (OneHom__toFun X Y (MonoidHom__toOneHom X Y toMonoidHom) y)))))) -> Elem (RingHom X Y).

(; doc: Reinterpret a ring homomorphism `f : α →+* β` as an additive monoid homomorphism `α →+ β`. The `simp`-normal form is `(f : α →+ β)`. ;)
(; //LEAN:RingHom.toAddMonoidHom ;)
RingHom__toAddMonoidHom : (X : Set) -> (Y : Set) -> (self : Elem (RingHom X Y)) -> Elem (AddMonoidHom X Y).

(; doc: A `Semiring` is a type with addition, multiplication, a `0` and a `1` where addition is commutative and associative, multiplication is associative and left and right distributive over addition, and `0` and `1` are additive and multiplicative identities. ;)
(; //LEAN:Semiring ;)
Semiring : (X : Set) -> Prop.

(; //LEAN:Semiring.toModule ;)
Semiring__toModule : (R : Set) -> Elem (Module__on R R).

(; //LEAN:Semiring.toNonAssocSemiring ;)
Semiring__toNonAssocSemiring : (X : Set) -> Elem (NonAssocSemiring__on X).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (X : Set) -> (I : Set) -> (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: The image of `s : Set α` by `f : α → β`, written `f '' s`, is the set of `b : β` such that `f a = b` for some `a ∈ s`. ;)
(; //LEAN:Set.image ;)
Set__image : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Elem (powerset Y).

(; doc: The preimage of `s : Set β` by `f : α → β`, written `f ⁻¹' s`, is the set of `x : α` such that `f x ∈ s`. ;)
(; //LEAN:Set.preimage ;)
Set__preimage : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset Y)) -> Elem (powerset X).

(; doc: A submodule of a module is one which is closed under vector operations. This is a sufficient condition for the subset of vectors in the submodule to themselves form a module. ;)
(; //LEAN:Submodule ;)
Submodule : (R : Set) -> (M : Set) -> Set.

(; //LEAN:Submodule.Quotient.eq ;)
Submodule__Quotient__eq : (R : Set) -> (M : Set) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> (x3 : Elem M) -> (y : Elem M) -> Proof (iff (Eqt (HasQuotient__Quotient M (Submodule R M) p) (Submodule__Quotient__mk R M p x3) (Submodule__Quotient__mk R M p y)) (Membership__mem M (Submodule R M) p (minus x3 y))).

(; doc: Map associating to an element of `M` the corresponding element of `M/p`, when `p` is a submodule of `M`. ;)
(; //LEAN:Submodule.Quotient.mk ;)
Submodule__Quotient__mk : (R : Set) -> (M : Set) -> (p : Elem (Submodule R M)) -> (x3 : Elem M) -> Elem (HasQuotient__Quotient M (Submodule R M) p).

(; //LEAN:Submodule.Quotient.mk_eq_zero ;)
Submodule__Quotient__mk_eq_zero : (R : Set) -> (M : Set) -> (x : Elem M) -> (_ : Proof (Ring R)) -> (_ : Proof (AddCommGroup M)) -> (_ : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Proof (iff (Eqt (HasQuotient__Quotient M (Submodule R M) p) (Submodule__Quotient__mk R M p x) 0) (Membership__mem M (Submodule R M) p x)).

(; doc: Quotienting by equal submodules gives linearly equivalent quotients. ;)
(; //LEAN:Submodule.quotEquivOfEq ;)
Submodule__quotEquivOfEq : (R : Set) -> (M : Set) -> (p : Elem (Submodule R M)) -> (p' : Elem (Submodule R M)) -> (h : Proof (Eqt (Submodule R M) p p')) -> Elem (LinearEquiv R R (RingHom__id R) (RingHom__id R) (HasQuotient__Quotient M (Submodule R M) p) (HasQuotient__Quotient M (Submodule R M) p')).

(; doc: The equivalence relation associated to a submodule `p`, defined by `x ≈ y` iff `-x + y ∈ p`.  Note this is equivalent to `y - x ∈ p`, but defined this way to be defeq to the `AddSubgroup` version, where commutativity can't be assumed. ;)
(; //LEAN:Submodule.quotientRel ;)
Submodule__quotientRel : (R : Set) -> (M : Set) -> (p : Elem (Submodule R M)) -> Elem (Setoid__on M).

(; doc: Reinterpret a submodule as an additive subgroup. ;)
(; //LEAN:Submodule.toAddSubgroup ;)
Submodule__toAddSubgroup : (R : Set) -> (M : Set) -> (module_M : Proof (Module R M)) -> (p : Elem (Submodule R M)) -> Elem (AddSubgroup M).

(; doc: All the elements of a type that satisfy a predicate.  `Subtype p`, usually written `{ x : α // p x }` or `{ x // p x }`, contains all elements `x : α` for which `p x` is true. Its constructor is a pair of the value and the proof that it satisfies the predicate. In run-time code, `{ x : α // p x }` is represented identically to `α`.  There is a coercion from `{ x : α // p x }` to `α`, so elements of a subtype may be used where the underlying type is expected.  Examples:  * `{ n : Nat // n % 2 = 0 }` is the type of even numbers.  * `{ xs : Array String // xs.size = 5 }` is the type of arrays with five `String`s.  * Given `xs : List α`, `List { x : α // x ∈ xs }` is the type of lists in which all elements are    contained in `xs`.  Conventions for notations in identifiers:   * The recommended spelling of `{ x // p x }` in identifiers is `subtype`. ;)
(; //LEAN:Subtype ;)
Subtype : (X : Set) -> (p : (Elem X -> Prop)) -> Set.

(; doc: The value in the underlying type that satisfies the predicate. ;)
(; //LEAN:Subtype.val ;)
Subtype__val : (X : Set) -> (p : (Elem X -> Prop)) -> (self : Elem (Subtype X (x => p x))) -> Elem X.

(; doc: The underlying function ;)
(; //LEAN:ZeroHom.toFun ;)
ZeroHom__toFun : (M : Set) -> (N : Set) -> (self : Elem (ZeroHom M N)) -> (x2 : Elem M) -> Elem N.

(; doc: The relation `≤` on a preorder is reflexive. ;)
(; //LEAN:le_refl ;)
le_refl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

