Ideal__Quotient__mk___proof_2 : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (x1 : Elem R) -> (x2 : Elem R) -> Proof (Eqt (HasQuotient__Quotient R (Ideal R) I) (Submodule__Quotient__mk R R I (times x1 x2)) (Submodule__Quotient__mk R R I (times x1 x2))).

