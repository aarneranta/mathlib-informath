(; constants used by Mathlib.RingTheory.Ideal.Quotient.Defs, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Ideal__Quotient__factor__app : (a1 : Proof (Leq I J)) -> (a2 : Elem (HasQuotient__Quotient R (Ideal R) I)) -> Elem (HasQuotient__Quotient R (Ideal R) J).

(; a constant applied as a function: DFunLike.coe ;)
Ideal__Quotient__lift__app : (a1 : Elem (Ideal R)) -> (a2 : Elem (RingHom R S)) -> (a3 : Proof (forall R (a1 => if (Membership__mem R (Ideal R) I a1) (Eqt S (f a1) 0)))) -> (a4 : Elem (HasQuotient__Quotient R (Ideal R) I)) -> Elem S.

(; a constant applied as a function: DFunLike.coe ;)
Ideal__Quotient__mk__app : (a1 : Elem (Ideal R)) -> (a2 : Elem R) -> Elem (HasQuotient__Quotient R (Ideal R) I).

(; a constant applied as a function: DFunLike.coe ;)
Ideal__quotEquivOfEq__app : (a1 : Proof (Eqt (Ideal R) I J)) -> (a2 : Elem (HasQuotient__Quotient R (Ideal R) I)) -> Elem (HasQuotient__Quotient R (Ideal R) J).

(; doc: The equivalence relation underlying an additive congruence relation. ;)
(; //LEAN:AddCon.toSetoid ;)
AddCon__toSetoid : (M : Set) -> (self : Elem (AddCon M)) -> Elem (Setoid__on M).

(; doc: The underlying function ;)
(; //LEAN:AddHom.toFun ;)
AddHom__toFun : (M : Set) -> (N : Set) -> (self : Elem (AddHom M N)) -> (x2 : Elem M) -> Elem N.

(; //LEAN:AddMonoidHom.toZeroHom ;)
AddMonoidHom__toZeroHom : (M : Set) -> (N : Set) -> (self : Elem (AddMonoidHom M N)) -> Elem (ZeroHom M N).

(; doc: An additive subgroup of an additive group `G` is a subset containing 0, closed under addition and additive inverse.  [Wikidata Q466109](https://www.wikidata.org/wiki/Q466109) ;)
(; //LEAN:AddSubgroup ;)
AddSubgroup : (G : Set) -> Set.

(; //LEAN:Con.mk ;)
Con__mk : (M : Set) -> (toSetoid : Proof (Setoid M)) -> (mul' : Proof (forall M (w => forall M (x1 => forall M (y => forall M (z => if (Setoid__r M w x1) (if (Setoid__r M y z) (Setoid__r M (times w y) (times x1 z))))))))) -> Elem (Con M).

(; //LEAN:Eq.rec ;)
Eq__rec : (X : Set) -> (x : Elem X) -> (motive : ((x2 : Elem X) -> Proof (Eqt X x x2) -> Set)) -> (refl : Elem (motive x (Eq__refl X x))) -> (x1 : Elem X) -> (t : Proof (Eqt X x x1)) -> Elem (motive x1 t).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; //LEAN:Equiv.mk ;)
Equiv__mk : (X : Set) -> (Y : Set) -> (toFun : (Elem X -> Y)) -> (invFun : (Elem Y -> X)) -> (left_inv : Proof (autoParam (Function__LeftInverse X Y invFun toFun) Equiv__left_inv___autoParam)) -> (right_inv : Proof (autoParam (Function__RightInverse X Y invFun toFun) Equiv__right_inv___autoParam)) -> Elem (Equiv X Y).

(; doc: A function `f : α → β` is called surjective if every `b : β` is equal to `f a` for some `a : α`. ;)
(; //LEAN:Function.Surjective ;)
Function__Surjective : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: `HasQuotient.Quotient A b` (denoted as `A ⧸ b`) is the quotient of the type `A` by `b`. ;)
(; //LEAN:HasQuotient.Quotient ;)
HasQuotient__Quotient : (A : Set) -> (B : Set) -> (x : Elem B) -> Set.

(; doc: A (left) ideal in a semiring `R` is an additive submonoid `s` such that `a * b ∈ s` whenever `b ∈ s`. If `R` is a ring, then `s` is an additive subgroup. ;)
(; //LEAN:Ideal ;)
Ideal : (R : Set) -> Set.

(; doc: A left ideal `I : Ideal R` is two-sided if it is also a right ideal. ;)
(; //LEAN:Ideal.IsTwoSided ;)
Ideal__IsTwoSided : (X : Set) -> (I : Elem (Ideal X)) -> Prop.

(; //LEAN:Ideal.Quotient.factor._proof_1 ;)
Ideal__Quotient__factor___proof_1 : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided R T)) -> (H : Proof (Leq S T)) -> (x1 : Elem R) -> (hx : Proof (Membership__mem R (Ideal R) S x1)) -> Proof (Eqt (HasQuotient__Quotient R (Ideal R) T) (Ideal__Quotient__mk__app T x1) 0).

