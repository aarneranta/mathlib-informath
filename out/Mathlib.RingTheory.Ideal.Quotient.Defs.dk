(; //LEAN:Ideal.Quotient.ringCon ;)
def Ideal__Quotient__ringCon : (I : Elem (Ideal R)) -> Elem (RingCon R) :=
  I => RingCon__mk (Con__mk (AddCon__toSetoid (QuotientAddGroup__con (Submodule__toAddSubgroup I))) (x1 => x2 => x3 => x4 => h1 => h2 => Ideal__Quotient__ringCon___proof_1 I h1 h2)) (Ideal__Quotient__ringCon___proof_3 I).

(; //LEAN:Ideal.Quotient.mk ;)
def Ideal__Quotient__mk : (I : Elem (Ideal R)) -> Elem (RingHom R (HasQuotient__Quotient R I)) :=
  I => RingHom__mk (MonoidHom__mk (OneHom__mk (a => Submodule__Quotient__mk a) (Ideal__Quotient__mk___proof_1 I)) (Ideal__Quotient__mk___proof_2 I)) (Ideal__Quotient__mk___proof_3 I) (Ideal__Quotient__mk___proof_4 I).

(; //LEAN:Ideal.Quotient.ringHom_ext ;)
def Ideal__Quotient__ringHom_ext : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (S : Set) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (NonAssocSemiring S)) -> (f : Elem (RingHom (HasQuotient__Quotient R I) S)) -> (g : Elem (RingHom (HasQuotient__Quotient R I) S)) -> (h1 : Proof (Eqt (RingHom R S) (RingHom__comp f (Ideal__Quotient__mk I)) (RingHom__comp g (Ideal__Quotient__mk I)))) -> Proof (Eqt (RingHom (HasQuotient__Quotient R I) S) f g) :=
  R => x => I => S => h => x1 => f => g => h1 => RingHom__ext (HasQuotient__Quotient R I) S Semiring__toNonAssocSemiring x1 f g (forallI (HasQuotient__Quotient R I) (x2 => Eqt S (f x2) (g x2)) (x2 => Quotient__inductionOn' R (Submodule__quotientRel I) (x3 => Eqt S (f x3) (g x3)) x2 (RingHom__congr_fun R S Semiring__toNonAssocSemiring x1 (RingHom__comp f (Ideal__Quotient__mk I)) (RingHom__comp g (Ideal__Quotient__mk I)) h1))).

(; //LEAN:Ideal.Quotient.ringHom_ext_iff ;)
Ideal__Quotient__ringHom_ext_iff : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (S : Set) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (NonAssocSemiring S)) -> (f : Elem (RingHom (HasQuotient__Quotient R I) S)) -> (g : Elem (RingHom (HasQuotient__Quotient R I) S)) -> Proof (iff (Eqt (RingHom (HasQuotient__Quotient R I) S) f g) (Eqt (RingHom R S) (RingHom__comp f (Ideal__Quotient__mk I)) (RingHom__comp g (Ideal__Quotient__mk I)))).

(; //LEAN:Ideal.Quotient.eq ;)
def Ideal__Quotient__eq : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (x1 : Elem R) -> (y : Elem R) -> (_ : Proof (Ideal__IsTwoSided I)) -> Proof (iff (Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I x1) (Ideal__Quotient__mk__app I y)) (Membership__mem I (minus x1 y))) :=
  R => x => I => x1 => y => h => Submodule__Quotient__eq R R I x1 y.

(; //LEAN:Ideal.Quotient.mk_eq_mk ;)
def Ideal__Quotient__mk_eq_mk : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (x1 : Elem R) -> Proof (Eqt (HasQuotient__Quotient R I) (Submodule__Quotient__mk x1) (Ideal__Quotient__mk__app I x1)) :=
  R => x => I => h => x1 => rfl (HasQuotient__Quotient R I) (Submodule__Quotient__mk x1).

(; //LEAN:Ideal.Quotient.eq_zero_iff_mem ;)
def Ideal__Quotient__eq_zero_iff_mem : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (a : Elem R) -> (_ : Proof (Ideal__IsTwoSided I)) -> Proof (iff (Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I a) 0) (Membership__mem I a)) :=
  R => x => I => a => h => Submodule__Quotient__mk_eq_zero R R a I.

(; //LEAN:Ideal.Quotient.mk_eq_mk_iff_sub_mem ;)
Ideal__Quotient__mk_eq_mk_iff_sub_mem : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (x1 : Elem R) -> (y : Elem R) -> Proof (iff (Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I x1) (Ideal__Quotient__mk__app I y)) (Membership__mem I (minus x1 y))).

(; //LEAN:Ideal.Quotient.mk_eq_one_iff_sub_mem ;)
Ideal__Quotient__mk_eq_one_iff_sub_mem : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (x1 : Elem R) -> Proof (iff (Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I x1) 1) (Membership__mem I (minus x1 1))).

(; //LEAN:Ideal.Quotient.mk_out ;)
def Ideal__Quotient__mk_out : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (x1 : Elem (HasQuotient__Quotient R I)) -> Proof (Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I (Quotient__out x1)) x1) :=
  R => x => I => h => x1 => Quotient__out_eq R (Submodule__quotientRel I) x1.

(; //LEAN:Ideal.Quotient.mk_surjective ;)
def Ideal__Quotient__mk_surjective : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> Proof (Function__Surjective (Ideal__Quotient__mk I)) :=
  R => x => I => h => forallI (HasQuotient__Quotient R I) (y => exists R (a3 => Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I a3) y)) (y => Quotient__inductionOn' R (Submodule__quotientRel I) (x1 => exists R (a => Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I a) x1)) y (forallI R (x2 => exists R (a2 => Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I a2) (Quotient__mk'' x2))) (x2 => existsI R (a1 => Eqt (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I a1) (Quotient__mk'' x2)) x2 (rfl (HasQuotient__Quotient R I) (Ideal__Quotient__mk__app I x2))))).

(; //LEAN:Ideal.Quotient.quotient_ring_saturate ;)
Ideal__Quotient__quotient_ring_saturate : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (s : Elem (powerset R)) -> Proof (Eqt (powerset R) (Set__preimage (Ideal__Quotient__mk I) (Set__image (Ideal__Quotient__mk I) s)) (Set__iUnion (x1 => Set__image (y => plus x1 y) s))).

(; //LEAN:Ideal.Quotient.lift ;)
def Ideal__Quotient__lift : (I : Elem (Ideal R)) -> (f : Elem (RingHom R S)) -> (H : Proof (forall R (a => if (Membership__mem I a) (Eqt S (f a) 0)))) -> Elem (RingHom (HasQuotient__Quotient R I) S) :=
  I => f => H => RingHom__mk (MonoidHom__mk (OneHom__mk (ZeroHom__toFun (AddMonoidHom__toZeroHom (QuotientAddGroup__lift (Submodule__toAddSubgroup I) (RingHom__toAddMonoidHom f) H))) (Ideal__Quotient__lift___proof_1 f)) (Ideal__Quotient__lift___proof_2 I f H)) (Ideal__Quotient__lift___proof_3 I f H) (Ideal__Quotient__lift___proof_4 I f H).

(; //LEAN:Ideal.Quotient.lift_mk ;)
def Ideal__Quotient__lift_mk : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (a : Elem R) -> (S : Set) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Semiring S)) -> (f : Elem (RingHom R S)) -> (H : Proof (forall R (a2 => if (Membership__mem I a2) (Eqt S (f a2) 0)))) -> Proof (Eqt S (Ideal__Quotient__lift__app I f H (Ideal__Quotient__mk__app I a)) (f a)) :=
  R => x => I => a => S => h => x1 => f => H => rfl S (Ideal__Quotient__lift__app I f H (Ideal__Quotient__mk__app I a)).

(; //LEAN:Ideal.Quotient.lift_comp_mk ;)
def Ideal__Quotient__lift_comp_mk : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (S : Set) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Semiring S)) -> (f : Elem (RingHom R S)) -> (H : Proof (forall R (a => if (Membership__mem I a) (Eqt S (f a) 0)))) -> Proof (Eqt (RingHom R S) (RingHom__comp (Ideal__Quotient__lift I f H) (Ideal__Quotient__mk I)) f) :=
  R => x => I => S => h => x1 => f => H => rfl (RingHom R S) (RingHom__comp (Ideal__Quotient__lift I f H) (Ideal__Quotient__mk I)).

(; //LEAN:Ideal.Quotient.lift_surjective_of_surjective ;)
Ideal__Quotient__lift_surjective_of_surjective : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (S : Set) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Semiring S)) -> (f : Elem (RingHom R S)) -> (H : Proof (forall R (a => if (Membership__mem I a) (Eqt S (f a) 0)))) -> (hf : Proof (Function__Surjective f)) -> Proof (Function__Surjective (Ideal__Quotient__lift I f H)).

(; //LEAN:Ideal.Quotient.factor ;)
def Ideal__Quotient__factor : (H : Proof (Leq S T)) -> Elem (RingHom (HasQuotient__Quotient R S) (HasQuotient__Quotient R T)) :=
  H => Ideal__Quotient__lift S (Ideal__Quotient__mk T) (Ideal__Quotient__factor___proof_1 H).

(; //LEAN:Ideal.Quotient.factor_mk ;)
def Ideal__Quotient__factor_mk : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> (_ : Proof (Ideal__IsTwoSided T)) -> (H : Proof (Leq S T)) -> (x1 : Elem R) -> Proof (Eqt (HasQuotient__Quotient R T) (Ideal__Quotient__factor__app H (Ideal__Quotient__mk__app S x1)) (Ideal__Quotient__mk__app T x1)) :=
  R => x => S => T => h => h1 => H => x1 => rfl (HasQuotient__Quotient R T) (Ideal__Quotient__factor__app H (Ideal__Quotient__mk__app S x1)).

(; //LEAN:Ideal.Quotient.factor_eq ;)
Ideal__Quotient__factor_eq : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> Proof (Eqt (RingHom (HasQuotient__Quotient R S) (HasQuotient__Quotient R S)) (Ideal__Quotient__factor (le_refl S)) (RingHom__id (HasQuotient__Quotient R S))).

(; //LEAN:Ideal.Quotient.factor_comp_mk ;)
Ideal__Quotient__factor_comp_mk : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> (_ : Proof (Ideal__IsTwoSided T)) -> (H : Proof (Leq S T)) -> Proof (Eqt (RingHom R (HasQuotient__Quotient R T)) (RingHom__comp (Ideal__Quotient__factor H) (Ideal__Quotient__mk S)) (Ideal__Quotient__mk T)).

(; //LEAN:Ideal.Quotient.factor_comp ;)
Ideal__Quotient__factor_comp : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (U : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> (_ : Proof (Ideal__IsTwoSided T)) -> (_ : Proof (Ideal__IsTwoSided U)) -> (H1 : Proof (Leq S T)) -> (H2 : Proof (Leq T U)) -> Proof (Eqt (RingHom (HasQuotient__Quotient R S) (HasQuotient__Quotient R U)) (RingHom__comp (Ideal__Quotient__factor H2) (Ideal__Quotient__factor H1)) (Ideal__Quotient__factor (LE__le__trans H1 H2))).

(; //LEAN:Ideal.Quotient.factor_comp_apply ;)
Ideal__Quotient__factor_comp_apply : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (U : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> (_ : Proof (Ideal__IsTwoSided T)) -> (_ : Proof (Ideal__IsTwoSided U)) -> (H1 : Proof (Leq S T)) -> (H2 : Proof (Leq T U)) -> (x1 : Elem (HasQuotient__Quotient R S)) -> Proof (Eqt (HasQuotient__Quotient R U) (Ideal__Quotient__factor__app H2 (Ideal__Quotient__factor__app H1 x1)) (Ideal__Quotient__factor__app (LE__le__trans H1 H2) x1)).

(; //LEAN:Ideal.Quotient.factor_surjective ;)
def Ideal__Quotient__factor_surjective : (R : Set) -> (_ : Proof (Ring R)) -> (S : Elem (Ideal R)) -> (T : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided S)) -> (_ : Proof (Ideal__IsTwoSided T)) -> (H : Proof (Leq S T)) -> Proof (Function__Surjective (Ideal__Quotient__factor H)) :=
  R => x => S => T => h => h1 => H => Ideal__Quotient__lift_surjective_of_surjective R S (HasQuotient__Quotient R T) (Ideal__Quotient__mk T) (Ideal__Quotient__factor___proof_1 R S T H) (Ideal__Quotient__mk_surjective R T).

(; //LEAN:Ideal.quotEquivOfEq ;)
def Ideal__quotEquivOfEq : (h2 : Proof (Eqt (Ideal R) I J)) -> Elem (RingEquiv (HasQuotient__Quotient R I) (HasQuotient__Quotient R J)) :=
  h2 => RingEquiv__mk (Equiv__mk (AddHom__toFun (LinearMap__toAddHom (LinearEquiv__toLinearMap (Submodule__quotEquivOfEq I J h2)))) (LinearEquiv__invFun (Submodule__quotEquivOfEq I J h2)) (Ideal__quotEquivOfEq___proof_3 h2) (Ideal__quotEquivOfEq___proof_4 h2)) (Ideal__quotEquivOfEq___proof_1 h2) (Ideal__quotEquivOfEq___proof_5 h2).

(; //LEAN:Ideal.quotEquivOfEq_mk ;)
def Ideal__quotEquivOfEq_mk : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (J : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Ideal__IsTwoSided J)) -> (h2 : Proof (Eqt (Ideal R) I J)) -> (x1 : Elem R) -> Proof (Eqt (HasQuotient__Quotient R J) (Ideal__quotEquivOfEq__app h2 (Ideal__Quotient__mk__app I x1)) (Ideal__Quotient__mk__app J x1)) :=
  R => x => I => J => h => h1 => h2 => x1 => rfl (HasQuotient__Quotient R J) (Ideal__quotEquivOfEq__app h2 (Ideal__Quotient__mk__app I x1)).

(; //LEAN:Ideal.quotEquivOfEq_symm ;)
Ideal__quotEquivOfEq_symm : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (J : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Ideal__IsTwoSided J)) -> (h2 : Proof (Eqt (Ideal R) I J)) -> Proof (Eqt (RingEquiv (HasQuotient__Quotient R J) (HasQuotient__Quotient R I)) (RingEquiv__symm (Ideal__quotEquivOfEq h2)) (Ideal__quotEquivOfEq (Eq__symm h2))).

(; //LEAN:Ideal.quotEquivOfEq_eq_factor ;)
def Ideal__quotEquivOfEq_eq_factor : (R : Set) -> (_ : Proof (Ring R)) -> (I : Elem (Ideal R)) -> (J : Elem (Ideal R)) -> (_ : Proof (Ideal__IsTwoSided I)) -> (_ : Proof (Ideal__IsTwoSided J)) -> (h2 : Proof (Eqt (Ideal R) I J)) -> (x1 : Elem (HasQuotient__Quotient R I)) -> Proof (Eqt (HasQuotient__Quotient R J) (Ideal__quotEquivOfEq__app h2 x1) (Ideal__Quotient__factor__app (Eq__rec (le_refl I) h2) x1)) :=
  R => x => I => J => h => h1 => h2 => x1 => rfl (HasQuotient__Quotient R J) (Ideal__quotEquivOfEq__app h2 x1).

