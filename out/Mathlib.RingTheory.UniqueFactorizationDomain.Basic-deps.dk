(; constants used by Mathlib.RingTheory.UniqueFactorizationDomain.Basic, declared with their translated types ;)

(; doc: Two elements of a `Monoid` are `Associated` if one of them is another one multiplied by a unit on the right. ;)
(; //LEAN:Associated ;)
Associated : (x1 : Elem M) -> (y : Elem M) -> Prop.

(; doc: The quotient of a monoid by the `Associated` relation. Two elements `x` and `y` are associated iff there is a unit `u` such that `x * u = y`. There is a natural monoid structure on `Associates M`. ;)
(; //LEAN:Associates ;)
Associates : (M : Set) -> Set.

(; //LEAN:Associates.dvdNotUnit_of_lt ;)
Associates__dvdNotUnit_of_lt : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (a : Elem (Associates M)) -> (b : Elem (Associates M)) -> (hlt : Proof (Lt a b)) -> Proof (DvdNotUnit a b).

(; doc: The canonical quotient map from a monoid `M` into the `Associates` of `M` ;)
(; //LEAN:Associates.mk ;)
Associates__mk : (a : Elem M) -> Elem (Associates M).

(; //LEAN:Associates.mk_dvdNotUnit_mk_iff ;)
Associates__mk_dvdNotUnit_mk_iff : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (a : Elem M) -> (b : Elem M) -> Proof (iff (DvdNotUnit (Associates__mk a) (Associates__mk b)) (DvdNotUnit a b)).

(; //LEAN:Associates.mk_surjective ;)
Associates__mk_surjective : (M : Set) -> (_ : Proof (Monoid M)) -> Proof (Function__Surjective Associates__mk).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: A type `M` is a commutative “monoid with zero” if it is a commutative monoid with zero element, and `0` is left and right absorbing. ;)
(; //LEAN:CommMonoidWithZero ;)
CommMonoidWithZero : (X : Set) -> Prop.

(; doc: `DvdNotUnit a b` expresses that `a` divides `b` "strictly", i.e. that `b` divided by `a` is not a unit. ;)
(; //LEAN:DvdNotUnit ;)
DvdNotUnit : (a : Elem X) -> (b : Elem X) -> Prop.

(; doc: `∏ x ∈ s, f x` is the product of `f x` as `x` ranges over the elements of the finite set `s`.  When the index type is a `Fintype`, the notation `∏ x, f x`, is a shorthand for `∏ x ∈ Finset.univ, f x`. ;)
(; //LEAN:Finset.prod ;)
Finset__prod : (s : Elem (Finset I)) -> (f : (Elem I -> M)) -> Elem M.

(; //LEAN:Function.Surjective.wellFounded_iff ;)
Function__Surjective__wellFounded_iff : (X : Set) -> (Y : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (s : (Elem Y -> Elem Y -> Prop)) -> (f : (Elem X -> Y)) -> (hf : Proof (Function__Surjective f)) -> (o : Proof (forall X (a => forall X (b => iff (r a b) (s (f a) (f b)))))) -> Proof (iff (WellFounded r) (WellFounded s)).

(; doc: `a • b` computes the product of `a` and `b`. The meaning of this notation is type-dependent, but it is intended to be used for left actions.  Conventions for notations in identifiers:   * The recommended spelling of `•` in identifiers is `smul`. ;)
(; //LEAN:HSMul.hSMul ;)
HSMul__hSMul : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `Irreducible p` states that `p` is non-unit and only factors into units.  We explicitly avoid stating that `p` is non-zero, this would require a semiring. Assuming only a monoid allows us to reuse irreducible for associated elements.  [Wikidata Q2989575](https://www.wikidata.org/wiki/Q2989575) ;)
(; //LEAN:Irreducible ;)
Irreducible : (p : Elem M) -> Prop.

(; doc: A mixin for cancellative multiplication by nonzero elements. ;)
(; //LEAN:IsCancelMulZero ;)
IsCancelMulZero : (X : Set) -> Prop.

(; doc: `x` and `y` are relatively prime if every common divisor is a unit. ;)
(; //LEAN:IsRelPrime ;)
IsRelPrime : (x1 : Elem X) -> (y : Elem X) -> Prop.

(; //LEAN:IsRelPrime.dvd_of_dvd_mul_right ;)
IsRelPrime__dvd_of_dvd_mul_right : (X : Set) -> (_ : Proof (CommMonoid X)) -> (x1 : Elem X) -> (y : Elem X) -> (z : Elem X) -> (_ : Proof (DecompositionMonoid X)) -> (H1 : Proof (IsRelPrime x1 z)) -> (H2 : Proof (divide x1 (times y z))) -> Proof (divide x1 y).

(; doc: An element `a : M` of a `Monoid` is a unit if it has a two-sided inverse. The actual definition says that `a` is equal to some `u : Mˣ`, where `Mˣ` is a bundled version of `IsUnit`. ;)
(; //LEAN:IsUnit ;)
IsUnit : (a : Elem M) -> Prop.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: `MulEquiv α β` is the type of an equiv `α ≃ β` which preserves multiplication. ;)
(; //LEAN:MulEquiv ;)
MulEquiv : (M : Set) -> (N : Set) -> Set.

(; doc: The inverse of an isomorphism is an isomorphism. ;)
(; //LEAN:MulEquiv.symm ;)
MulEquiv__symm : (h : Elem (MulEquiv M N)) -> Elem (MulEquiv N M).

(; doc: `Multiset α` is the quotient of `List α` by list permutation. The result is a type of finite sets with duplicates allowed. ;)
(; //LEAN:Multiset ;)
Multiset : (X : Set) -> Set.

(; doc: `Rel r s t` -- lift the relation `r` between two elements to a relation between `s` and `t`, s.t. there is a one-to-one mapping between elements in `s` and `t` following `r`. ;)
(; //LEAN:Multiset.Rel ;)
Multiset__Rel : (r : (Elem X -> Elem Y -> Prop)) -> (x : Elem (Multiset X)) -> (x1 : Elem (Multiset Y)) -> Prop.

(; doc: The cardinality of a multiset is the sum of the multiplicities of all its elements, or simply the length of the underlying list. ;)
(; //LEAN:Multiset.card ;)
Multiset__card : (x : Elem (Multiset X)) -> Elem Nat.

(; doc: `count a s` is the multiplicity of `a` in `s`. ;)
(; //LEAN:Multiset.count ;)
Multiset__count : (a : Elem X) -> (x1 : Elem (Multiset X)) -> Elem Nat.

(; doc: Product of a multiset given a commutative monoid structure on `M`. `prod {a, b, c} = a * b * c` ;)
(; //LEAN:Multiset.prod ;)
Multiset__prod : (x1 : Elem (Multiset M)) -> Elem M.

(; doc: `toFinset s` removes duplicates from the multiset `s` to produce a finset. ;)
(; //LEAN:Multiset.toFinset ;)
Multiset__toFinset : (s : Elem (Multiset X)) -> Elem (Finset X).

(; doc: An element `p` of a commutative monoid with zero (e.g., a ring) is called *prime*, if it's not zero, not a unit, and `p ∣ a * b → p ∣ a ∨ p ∣ b` for all `a`, `b`. ;)
(; //LEAN:Prime ;)
Prime : (p : Elem M) -> Prop.

(; //LEAN:Prime.not_isUnit ;)
Prime__not_isUnit : (M : Set) -> (_ : Proof (CommMonoidWithZero M)) -> (p : Elem M) -> (hp : Proof (Prime p)) -> Proof (not (IsUnit p)).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; //LEAN:Subrelation.wf ;)
Subrelation__wf : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> (q : (Elem X -> Elem X -> Prop)) -> (h : Proof (Subrelation q r)) -> (h1 : Proof (WellFounded r)) -> Proof (WellFounded q).

(; doc: Unique factorization monoids are defined as cancellative `CommMonoidWithZero`s with well-founded strict divisibility relations, but this is equivalent to more familiar definitions:  Each element (except zero) is uniquely represented as a multiset of irreducible factors. Uniqueness is only up to associated elements.  Each element (except zero) is non-uniquely represented as a multiset of prime factors.  To define a UFD using the definition in terms of multisets of irreducible factors, use the definition `of_existsUnique_irreducible_factors`  To define a UFD using the definition in terms of multisets of prime factors, use the definition `of_exists_prime_factors` ;)
(; //LEAN:UniqueFactorizationMonoid ;)
UniqueFactorizationMonoid : (X : Set) -> Prop.

(; //LEAN:UniqueFactorizationMonoid.exists_prime_factors ;)
UniqueFactorizationMonoid__exists_prime_factors : (X : Set) -> (_ : Proof (CommMonoidWithZero X)) -> (_ : Proof (UniqueFactorizationMonoid X)) -> (a : Elem X) -> (h1 : Proof (Neq a 0)) -> Proof (exists (Multiset X) (f => and (forall X (b => if (Membership__mem f b) (Prime b))) (Associated (Multiset__prod f) a))).

(; doc: Noncomputably determines the multiset of prime factors. ;)
(; //LEAN:UniqueFactorizationMonoid.factors ;)
UniqueFactorizationMonoid__factors : (a : Elem X) -> Elem (Multiset X).

(; //LEAN:UniqueFactorizationMonoid.irreducible_iff_prime ;)
UniqueFactorizationMonoid__irreducible_iff_prime : (X : Set) -> (x : Proof (CommMonoidWithZero X)) -> (_ : Proof (UniqueFactorizationMonoid X)) -> (a : Elem X) -> Proof (iff (Irreducible a) (Prime a)).

(; //LEAN:UniqueFactorizationMonoid.mk ;)
UniqueFactorizationMonoid__mk : (X : Set) -> (_ : Proof (CommMonoidWithZero X)) -> (_ : Proof (IsCancelMulZero X)) -> (_ : Proof (WellFounded DvdNotUnit)) -> (irreducible_iff_prime : Proof (forall X (a => iff (Irreducible a) (Prime a)))) -> Proof (UniqueFactorizationMonoid X).

(; doc: A relation `r` is `WellFounded` if all elements of `α` are accessible within `r`. If a relation is `WellFounded`, it does not allow for an infinite descent along the relation.  If the arguments of the recursive calls in a function definition decrease according to a well founded relation, then the function terminates. Well-founded relations are sometimes called _Artinian_ or said to satisfy the “descending chain condition”. ;)
(; //LEAN:WellFounded ;)
WellFounded : (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: A class for a well-founded relation `<`. ;)
(; //LEAN:WellFoundedLT ;)
WellFoundedLT : (X : Set) -> Prop.

(; doc: Well-foundedness of the strict version of ∣, which is equivalent to the descending chain condition on divisibility and to the ascending chain condition on principal ideals in an integral domain. ;)
(; //LEAN:WfDvdMonoid ;)
WfDvdMonoid : (X : Set) -> Prop.

(; //LEAN:WfDvdMonoid.isRelPrime_of_no_irreducible_factors ;)
WfDvdMonoid__isRelPrime_of_no_irreducible_factors : (X : Set) -> (_ : Proof (CommMonoidWithZero X)) -> (_ : Proof (WfDvdMonoid X)) -> (x1 : Elem X) -> (y : Elem X) -> (nonzero : Proof (not (and (Eqt X x1 0) (Eqt X y 0)))) -> (H : Proof (forall X (z => if (Irreducible z) (if (divide z x1) (not (divide z y)))))) -> Proof (IsRelPrime x1 y).

(; //LEAN:bot_lt_iff_ne_bot ;)
bot_lt_iff_ne_bot : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> Proof (iff (Lt Bot__bot a) (Neq a Bot__bot)).

(; //LEAN:not_iff_not ;)
not_iff_not : (a : Prop) -> (b : Prop) -> Proof (iff (iff (not a) (not b)) (iff a b)).

(; //LEAN:wellFounded_dvdNotUnit ;)
wellFounded_dvdNotUnit : (X : Set) -> (_ : Proof (CommMonoidWithZero X)) -> (_ : Proof (WfDvdMonoid X)) -> Proof (WellFounded DvdNotUnit).

