(; //LEAN:IsPreconnected ;)
def IsPreconnected : (X : Set) -> (s : Elem (powerset X)) -> Prop :=
  X => s => forall (powerset X) (u => forall (powerset X) (v => if (IsOpen X u) (if (IsOpen X v) (if (Set__Subset X s (Union__union (powerset X) u v)) (if (Set__Nonempty X (Inter__inter (powerset X) s u)) (if (Set__Nonempty X (Inter__inter (powerset X) s v)) (Set__Nonempty X (Inter__inter (powerset X) s (Inter__inter (powerset X) u v))))))))).

(; //LEAN:IsConnected ;)
def IsConnected : (X : Set) -> (s : Elem (powerset X)) -> Prop :=
  X => s => and (Set__Nonempty X s) (IsPreconnected X s).

(; //LEAN:IsConnected.nonempty ;)
def IsConnected__nonempty : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (h : Proof (IsConnected X s)) -> Proof (Set__Nonempty X s) :=
  X => x => s => h => andEl (Set__Nonempty X s) (IsPreconnected X s) h.

(; //LEAN:IsConnected.isPreconnected ;)
def IsConnected__isPreconnected : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (h : Proof (IsConnected X s)) -> Proof (IsPreconnected X s) :=
  X => x => s => h => andEr (Set__Nonempty X s) (IsPreconnected X s) h.

