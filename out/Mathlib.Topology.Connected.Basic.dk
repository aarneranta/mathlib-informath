(; //LEAN:IsIrreducible.isConnected ;)
def IsIrreducible__isConnected : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (H : Proof (IsIrreducible X s)) -> Proof (IsConnected X s) :=
  X => x => s => H => andI (Set__Nonempty X s) (IsPreconnected X s) (IsIrreducible__nonempty X s H) (IsPreirreducible__isPreconnected X s (IsIrreducible__isPreirreducible X s H)).

