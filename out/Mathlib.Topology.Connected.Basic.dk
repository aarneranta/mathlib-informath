(; //LEAN:IsPreconnected ;)
def IsPreconnected : (s : Elem (powerset X)) -> Prop :=
  s => forall (powerset X) (u => forall (powerset X) (v => if (IsOpen u) (if (IsOpen v) (if (Set__Subset s (Union__union u v)) (if (Set__Nonempty (Inter__inter s u)) (if (Set__Nonempty (Inter__inter s v)) (Set__Nonempty (Inter__inter s (Inter__inter u v))))))))).

(; //LEAN:IsConnected ;)
def IsConnected : (s : Elem (powerset X)) -> Prop :=
  s => and (Set__Nonempty s) (IsPreconnected s).

(; //LEAN:IsConnected.nonempty ;)
def IsConnected__nonempty : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (h : Proof (IsConnected s)) -> Proof (Set__Nonempty s) :=
  X => x => s => h => andEl (Set__Nonempty s) (IsPreconnected s) h.

