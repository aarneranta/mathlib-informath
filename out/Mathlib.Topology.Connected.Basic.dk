def IsConnected__isPreconnected : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (h : Proof (IsConnected s)) -> Proof (IsPreconnected s) :=
  X => x => s => h => andEr (Set__Nonempty s) (IsPreconnected s) h.

