(; constants used by Mathlib.Topology.MetricSpace.Pseudo.Defs, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Additive__ofMul__app : (a1 : Elem X) -> Elem (Additive X).

(; a constant applied as a function: DFunLike.coe ;)
Additive__toMul__app : (a1 : Elem (Additive X)) -> Elem X.

(; a constant applied as a function: DFunLike.coe ;)
Multiplicative__ofAdd__app : (a1 : Elem X) -> Elem (Multiplicative X).

(; a constant applied as a function: DFunLike.coe ;)
Multiplicative__toAdd__app : (a1 : Elem (Multiplicative X)) -> Elem X.

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__ofDual__app : (a1 : Elem (OrderDual X)) -> Elem X.

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__toDual__app : (a1 : Elem X) -> Elem (OrderDual X).

(; a constant applied as a function: DFunLike.coe ;)
Real__nnabs__app : (a1 : Elem Real) -> Elem NNReal.

(; doc: If `α` carries some multiplicative structure, then `Additive α` carries the corresponding additive structure. ;)
(; //LEAN:Additive ;)
Additive : (X : Set) -> Set.

(; doc: A **bornology** on a type `α` is a filter of cobounded sets which contains the cofinite filter. Such spaces are equivalently specified by their bounded sets, see `Bornology.ofBounded` and `Bornology.ext_iff_isBounded` ;)
(; //LEAN:Bornology ;)
Bornology : (X : Set) -> Prop.

(; doc: `IsBounded` is the predicate that `s` is bounded relative to the ambient bornology on `α`. ;)
(; //LEAN:Bornology.IsBounded ;)
Bornology__IsBounded : (s : Elem (powerset X)) -> Prop.

(; doc: The filter of cobounded sets in a bornology. ;)
(; //LEAN:Bornology.cobounded ;)
Bornology__cobounded : (X : Set) -> Elem (Filter X).

(; doc: A constructor for bornologies by specifying the bounded sets, and showing that they satisfy the appropriate conditions. ;)
(; //LEAN:Bornology.ofBounded ;)
Bornology__ofBounded : (B : Elem (powerset (powerset X))) -> (empty_mem : Proof (Membership__mem B EmptyCollection__emptyCollection)) -> (subset_mem : Proof (forall (powerset X) (x3 => if (Membership__mem B x3) (forall (powerset X) (x4 => if (Set__Subset x4 x3) (Membership__mem B x4)))))) -> (union_mem : Proof (forall (powerset X) (x1 => if (Membership__mem B x1) (forall (powerset X) (x2 => if (Membership__mem B x2) (Membership__mem B (Union__union x1 x2))))))) -> (singleton_mem : Proof (forall X (x => Membership__mem B (Singleton__singleton x)))) -> Proof (Bornology X).

(; //LEAN:Bornology.ofDist._proof_1 ;)
Bornology__ofDist___proof_1 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> Proof (exists Real (C => forall X (x => if (Membership__mem EmptyCollection__emptyCollection x) (forall X (y => if (Membership__mem EmptyCollection__emptyCollection y) (Leq (dist x y) C)))))).

(; //LEAN:Bornology.ofDist._proof_2 ;)
Bornology__ofDist___proof_2 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (x : Elem (powerset X)) -> (h : Proof (Membership__mem (Set__ofPred (s1 => exists Real (C1 => forall X (x3 => if (Membership__mem s1 x3) (forall X (y1 => if (Membership__mem s1 y1) (Leq (dist x3 y1) C1))))))) x)) -> (x1 : Elem (powerset X)) -> (h1 : Proof (Set__Subset x1 x)) -> Proof (Membership__mem (Set__ofPred (s => exists Real (C => forall X (x2 => if (Membership__mem s x2) (forall X (y => if (Membership__mem s y) (Leq (dist x2 y) C))))))) x1).

(; //LEAN:Bornology.ofDist._proof_3 ;)
Bornology__ofDist___proof_3 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_comm : Proof (forall X (x4 => forall X (y4 => Eq (dist x4 y4) (dist y4 x4))))) -> (dist_triangle : Proof (forall X (x3 => forall X (y3 => forall X (z => Leq (dist x3 z) (plus (dist x3 y3) (dist y3 z))))))) -> (s : Elem (powerset X)) -> (hs : Proof (Membership__mem (Set__ofPred (s3 => exists Real (C2 => forall X (x2 => if (Membership__mem s3 x2) (forall X (y2 => if (Membership__mem s3 y2) (Leq (dist x2 y2) C2))))))) s)) -> (t : Elem (powerset X)) -> (ht : Proof (Membership__mem (Set__ofPred (s2 => exists Real (C1 => forall X (x1 => if (Membership__mem s2 x1) (forall X (y1 => if (Membership__mem s2 y1) (Leq (dist x1 y1) C1))))))) t)) -> Proof (Membership__mem (Set__ofPred (s1 => exists Real (C => forall X (x => if (Membership__mem s1 x) (forall X (y => if (Membership__mem s1 y) (Leq (dist x y) C))))))) (Union__union s t)).

(; //LEAN:Bornology.ofDist._proof_4 ;)
Bornology__ofDist___proof_4 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (z : Elem X) -> Proof (exists Real (C => forall X (x => if (Membership__mem (Singleton__singleton z) x) (forall X (y => if (Membership__mem (Singleton__singleton z) y) (Leq (dist x y) C)))))).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : Elem X.

(; doc: A space with a `Bornology` is a **bounded space** if `Set.univ : Set α` is bounded. ;)
(; //LEAN:BoundedSpace ;)
BoundedSpace : (X : Set) -> Prop.

(; doc: Set / lattice complement  Conventions for notations in identifiers:   * The recommended spelling of `ᶜ` in identifiers is `compl`. ;)
(; //LEAN:Compl.compl ;)
Compl__compl : (x : Elem X) -> Elem X.

(; doc: A function between topological spaces is continuous if the preimage of every open set is open. Registered as a structure to make sure it is not unfolded by Lean. ;)
(; //LEAN:Continuous ;)
Continuous : (f : (Elem X -> Y)) -> Prop.

(; doc: A function between topological spaces is continuous at a point `x₀` if `f x` tends to `f x₀` when `x` tends to `x₀`. ;)
(; //LEAN:ContinuousAt ;)
ContinuousAt : (f : (Elem X -> Y)) -> (x2 : Elem X) -> Prop.

(; doc: A function between topological spaces is continuous on a subset `s` when it's continuous at every point of `s` within `s`. ;)
(; //LEAN:ContinuousOn ;)
ContinuousOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A function between topological spaces is continuous at a point `x₀` within a subset `s` if `f x` tends to `f x₀` when `x` tends to `x₀` while staying within `s`. ;)
(; //LEAN:ContinuousWithinAt ;)
ContinuousWithinAt : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> (x2 : Elem X) -> Prop.

(; doc: A set is dense in a topological space if every point belongs to its closure. ;)
(; //LEAN:Dense ;)
Dense : (s : Elem (powerset X)) -> Prop.

(; doc: `f : α → X` has dense range if its range (image) is a dense subset of `X`. ;)
(; //LEAN:DenseRange ;)
DenseRange : (f : (Elem X1 -> X)) -> Prop.

(; doc: A topological space is discrete if every set is open, that is, its topology equals the discrete topology `⊥`. ;)
(; //LEAN:DiscreteTopology ;)
DiscreteTopology : (X : Set) -> Prop.

(; //LEAN:DiscreteTopology.mk ;)
DiscreteTopology__mk : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (eq_bot : Proof (Eqt (TopologicalSpace X) t Bot__bot)) -> Proof (DiscreteTopology X).

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:Disjoint.mono_left ;)
Disjoint__mono_left : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Disjoint b c)) -> Proof (Disjoint a c).

(; //LEAN:Disjoint.symm ;)
Disjoint__symm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Disjoint a b)) -> Proof (Disjoint b a).

(; doc: Extended distance between two points ;)
(; //LEAN:EDist.edist ;)
EDist__edist : (x : Elem X) -> (x1 : Elem X) -> Elem ENNReal.

(; doc: The extended nonnegative real numbers. This is usually denoted [0, ∞], and is relevant as the codomain of a measure. ;)
(; //LEAN:ENNReal ;)
ENNReal : Set.

(; doc: Coercion from `ℝ≥0` to `ℝ≥0∞`. ;)
(; //LEAN:ENNReal.ofNNReal ;)
ENNReal__ofNNReal : (x : Elem NNReal) -> Elem ENNReal.

(; doc: `ofReal x` returns `x` if it is nonnegative, `0` otherwise. ;)
(; //LEAN:ENNReal.ofReal ;)
ENNReal__ofReal : (r : Elem Real) -> Elem ENNReal.

(; doc: `toNNReal x` returns `x` if it is real, otherwise 0. ;)
(; //LEAN:ENNReal.toNNReal ;)
ENNReal__toNNReal : (x : Elem ENNReal) -> Elem NNReal.

(; doc: `toReal x` returns `x` if it is real, `0` otherwise. ;)
(; //LEAN:ENNReal.toReal ;)
ENNReal__toReal : (a : Elem ENNReal) -> Elem Real.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : Elem X.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: If `h : α = β` is a proof of type equality, then `h.mpr : β → α` is the induced "cast" operation in the reverse direction, mapping elements of `β` to elements of `α`.  You can prove theorems about the resulting element by induction on `h`, since `rfl.mpr` is definitionally the identity function. ;)
(; //LEAN:Eq.mpr ;)
Eq__mpr : (h : Proof (Eqt Set X Y)) -> (b : Elem Y) -> Elem X.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: **Alias** of `lt_of_eq_of_lt`. ;)
(; //LEAN:Eq.trans_lt ;)
Eq__trans_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h : Proof (Eqt X a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:Exists.imp ;)
Exists__imp : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => if (p a2) (q a2)))) -> (h1 : Proof (exists X (a1 => p a1))) -> Proof (exists X (a => q a)).

(; doc: A filter `F` on a type `α` is a collection of sets of `α` which contains the whole `α`, is upwards-closed, and is stable under intersection. We do not forbid this collection to be all sets of `α`. ;)
(; //LEAN:Filter ;)
Filter : (X : Set) -> Set.

(; doc: `f.Eventually p` or `∀ᶠ x in f, p x` mean that `{x | p x} ∈ f`. E.g., `∀ᶠ x in atTop, p x` means that `p` holds true for sufficiently large `x`. ;)
(; //LEAN:Filter.Eventually ;)
Filter__Eventually : (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> Prop.

(; //LEAN:Filter.Eventually.and ;)
Filter__Eventually__and : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> (h : Proof (Filter__Eventually (x2 => p x2) f)) -> (h1 : Proof (Filter__Eventually (x1 => q x1) f)) -> Proof (Filter__Eventually (x => and (p x) (q x)) f).

(; //LEAN:Filter.Eventually.exists ;)
Filter__Eventually__exists : (X : Set) -> (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> (_ : Proof (Filter__NeBot f)) -> (hp : Proof (Filter__Eventually (x1 => p x1) f)) -> Proof (exists X (x => p x)).

(; doc: `f.Frequently p` or `∃ᶠ x in f, p x` mean that `{x | ¬p x} ∉ f`. E.g., `∃ᶠ x in atTop, p x` means that there exist arbitrarily large `x` for which `p` holds true. ;)
(; //LEAN:Filter.Frequently ;)
Filter__Frequently : (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> Prop.

(; doc: We say that a filter `l` has a basis `s : ι → Set α` bounded by `p : ι → Prop`, if `t ∈ l` if and only if `t` includes `s i` for some `i` such that `p i`. ;)
(; //LEAN:Filter.HasBasis ;)
Filter__HasBasis : (l : Elem (Filter X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> Prop.

(; doc: Definition of `HasBasis` unfolded with implicit set argument. ;)
(; //LEAN:Filter.HasBasis.mem_iff ;)
Filter__HasBasis__mem_iff : (X : Set) -> (I : Set) -> (l : Elem (Filter X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> (t : Elem (powerset X)) -> (hl : Proof (Filter__HasBasis l p s)) -> Proof (iff (Membership__mem l t) (exists I (i => and (p i) (Set__Subset (s i) t)))).

(; //LEAN:Filter.HasBasis.mem_uniformity_iff ;)
Filter__HasBasis__mem_uniformity_iff : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace X)) -> (p : (Elem Y -> Prop)) -> (s : (Elem Y -> SetRel X X)) -> (h : Proof (Filter__HasBasis (uniformity X) p s)) -> (t : Elem (SetRel X X)) -> Proof (iff (Membership__mem (uniformity X) t) (exists Y (i => and (p i) (forall X (a => forall X (b => if (Membership__mem (s i) (Prod__mk a b)) (Membership__mem t (Prod__mk a b)))))))).

(; //LEAN:Filter.HasBasis.tendsto_iff ;)
Filter__HasBasis__tendsto_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (X1 : Set) -> (la : Elem (Filter X)) -> (pa : (Elem I -> Prop)) -> (sa : (Elem I -> powerset X)) -> (lb : Elem (Filter Y)) -> (pb : (Elem X1 -> Prop)) -> (sb : (Elem X1 -> powerset Y)) -> (f : (Elem X -> Y)) -> (hla : Proof (Filter__HasBasis la pa sa)) -> (hlb : Proof (Filter__HasBasis lb pb sb)) -> Proof (iff (Filter__Tendsto f la lb) (forall X1 (ib => if (pb ib) (exists I (ia => and (pa ia) (forall X (x => if (Membership__mem (sa ia) x) (Membership__mem (sb ib) (f x))))))))).

(; //LEAN:Filter.HasBasis.tendsto_right_iff ;)
Filter__HasBasis__tendsto_right_iff : (X : Set) -> (Y : Set) -> (X1 : Set) -> (la : Elem (Filter X)) -> (lb : Elem (Filter Y)) -> (pb : (Elem X1 -> Prop)) -> (sb : (Elem X1 -> powerset Y)) -> (f : (Elem X -> Y)) -> (hlb : Proof (Filter__HasBasis lb pb sb)) -> Proof (iff (Filter__Tendsto f la lb) (forall X1 (i => if (pb i) (Filter__Eventually (x => Membership__mem (sb i) (f x)) la)))).

(; //LEAN:Filter.HasBasis.uniformContinuousOn_iff ;)
Filter__HasBasis__uniformContinuousOn_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (_ : Proof (UniformSpace Y)) -> (X1 : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (ha : Proof (Filter__HasBasis (uniformity X) p s)) -> (q : (Elem X1 -> Prop)) -> (t : (Elem X1 -> powerset (Prod Y Y))) -> (hb : Proof (Filter__HasBasis (uniformity Y) q t)) -> (f : (Elem X -> Y)) -> (S : Elem (powerset X)) -> Proof (iff (UniformContinuousOn f S) (forall X1 (i => if (q i) (exists I (j => and (p j) (forall X (x2 => if (Membership__mem S x2) (forall X (y => if (Membership__mem S y) (if (Membership__mem (s j) (Prod__mk x2 y)) (Membership__mem (t i) (Prod__mk (f x2) (f y))))))))))))).

(; //LEAN:Filter.HasBasis.uniformContinuous_iff ;)
Filter__HasBasis__uniformContinuous_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (_ : Proof (UniformSpace Y)) -> (X1 : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (ha : Proof (Filter__HasBasis (uniformity X) p s)) -> (q : (Elem X1 -> Prop)) -> (t : (Elem X1 -> powerset (Prod Y Y))) -> (hb : Proof (Filter__HasBasis (uniformity Y) q t)) -> (f : (Elem X -> Y)) -> Proof (iff (UniformContinuous f) (forall X1 (i => if (q i) (exists I (j => and (p j) (forall X (x2 => forall X (y => if (Membership__mem (s j) (Prod__mk x2 y)) (Membership__mem (t i) (Prod__mk (f x2) (f y))))))))))).

(; doc: A filter is `NeBot` if it is not equal to `⊥`, or equivalently the empty set does not belong to the filter. Bourbaki include this assumption in the definition of a filter but we prefer to have a `CompleteLattice` structure on `Filter _`, so we use a typeclass argument in lemmas instead. ;)
(; //LEAN:Filter.NeBot ;)
Filter__NeBot : (f : Elem (Filter X)) -> Prop.

(; doc: `Filter.Tendsto` is the generic "limit of a function" predicate. `Tendsto f l₁ l₂` asserts that for every `l₂` neighborhood `a`, the `f`-preimage of `a` is an `l₁` neighborhood. ;)
(; //LEAN:Filter.Tendsto ;)
Filter__Tendsto : (f : (Elem X -> Y)) -> (x : Elem (Filter X)) -> (x1 : Elem (Filter Y)) -> Prop.

(; //LEAN:Filter.Tendsto.congr_uniformity ;)
Filter__Tendsto__congr_uniformity : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace Y)) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (l : Elem (Filter X)) -> (b : Elem Y) -> (hf : Proof (Filter__Tendsto f l (nhds b))) -> (hg : Proof (Filter__Tendsto (x1 => Prod__mk (f x1) (g x1)) l (uniformity Y))) -> Proof (Filter__Tendsto g l (nhds b)).

(; doc: `atTop` is the filter representing the limit `→ ∞` on an ordered set. It is generated by the collection of up-sets `{b | a ≤ b}`. (The preorder need not have a top element for this to be well defined, and indeed is trivial when a top element `x` exists, i.e., it coincides with `pure x`.) ;)
(; //LEAN:Filter.atTop ;)
Filter__atTop : Elem (Filter X).

(; doc: The inverse map of a filter. A set `s` belongs to `Filter.comap m f` if either of the following equivalent conditions hold.  1. There exists a set `t ∈ f` such that `m ⁻¹' t ⊆ s`. This is used as a definition. 2. The set `kernImage m s = {y | ∀ x, m x = y → x ∈ s}` belongs to `f`, see `Filter.mem_comap'`. 3. The set `(m '' sᶜ)ᶜ` belongs to `f`, see `Filter.mem_comap_iff_compl` and    `Filter.compl_mem_comap`. ;)
(; //LEAN:Filter.comap ;)
Filter__comap : (m : (Elem X -> Y)) -> (f : Elem (Filter Y)) -> Elem (Filter X).

(; //LEAN:Filter.eventually_ge_atTop ;)
Filter__eventually_ge_atTop : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Filter__Eventually (x1 => Leq a x1) Filter__atTop).

(; //LEAN:Filter.mem_of_superset ;)
Filter__mem_of_superset : (X : Set) -> (f : Elem (Filter X)) -> (x : Elem (powerset X)) -> (y : Elem (powerset X)) -> (hx : Proof (Membership__mem f x)) -> (hxy : Proof (Set__Subset x y)) -> Proof (Membership__mem f y).

(; doc: The principal filter of `s` is the collection of all supersets of `s`. ;)
(; //LEAN:Filter.principal ;)
Filter__principal : (s : Elem (powerset X)) -> Elem (Filter X).

(; doc: The set of sets that belong to the filter. ;)
(; //LEAN:Filter.sets ;)
Filter__sets : (self : Elem (Filter X)) -> Elem (powerset (powerset X)).

(; doc: For a two-argument function `f`, `swap f` is the same function but taking the arguments in the reverse order. `swap f y x = f x y`. ;)
(; //LEAN:Function.swap ;)
Function__swap : (f : ((x2 : Elem X) -> (y1 : Elem Y) -> x x2 y1)) -> (y : Elem Y) -> (x1 : Elem X) -> Elem (x x1 y).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h : Proof (iff a b)) -> (h1 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `insert x xs` inserts the element `x` into the collection `xs`. ;)
(; //LEAN:Insert.insert ;)
Insert__insert : (x1 : Elem x) -> (x2 : Elem Z) -> Elem Z.

(; doc: `a ∩ b` is the intersection of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∩` in identifiers is `inter`. ;)
(; //LEAN:Inter.inter ;)
Inter__inter : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: A set is closed if its complement is open ;)
(; //LEAN:IsClosed ;)
IsClosed : (s : Elem (powerset X)) -> Prop.

(; doc: `IsOpen s` means that `s` is open in the ambient topological space on `X` ;)
(; //LEAN:IsOpen ;)
IsOpen : (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:IsOpen.mem_nhds ;)
IsOpen__mem_nhds : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> (hs : Proof (IsOpen s)) -> (hx : Proof (Membership__mem s x1)) -> Proof (Membership__mem (nhds x1) s).

(; //LEAN:LE.le.ge_iff_eq' ;)
LE__le__ge_iff_eq' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> Proof (iff (Leq a b) (Eqt X a b)).

(; doc: **Alias** of `not_lt_of_ge`. ;)
(; //LEAN:LE.le.not_gt ;)
LE__le__not_gt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> Proof (not (Lt b a)).

