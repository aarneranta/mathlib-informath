LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h : Proof (Leq a b)) -> (h1 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: **Alias** of `lt_of_le_of_lt`. ;)
(; //LEAN:LE.le.trans_lt ;)
LE__le__trans_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: **Alias** of `ne_of_lt`. ;)
(; //LEAN:LT.lt.ne ;)
LT__lt__ne : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; doc: **Alias** of `not_le_of_gt`. ;)
(; //LEAN:LT.lt.not_ge ;)
LT__lt__not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (not (Leq b a)).

