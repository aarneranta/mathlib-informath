(; constants used by Mathlib.Topology.MetricSpace.Pseudo.Defs, declared with their translated types ;)

(; a constant applied as a function: DFunLike.coe ;)
Additive__ofMul__app : (a1 : Elem X) -> Elem (Additive X).

(; a constant applied as a function: DFunLike.coe ;)
Additive__toMul__app : (a1 : Elem (Additive X)) -> Elem X.

(; a constant with an instance argument that the statement gives ;)
Bornology__IsBounded__in : (X : Set) -> (x : Elem (Bornology__on X)) -> (s : Elem (powerset X)) -> Prop.

(; the structures of a class on its parameters ;)
Bornology__on : (X : Set) -> Set.

(; a constant with an instance argument that the statement gives ;)
Dist__dist__in : (X : Set) -> (self : Elem (Dist__on X)) -> (x : Elem X) -> (x1 : Elem X) -> Elem Real.

(; the structures of a class on its parameters ;)
Dist__on : (X : Set) -> Set.

(; a constant applied as a function: DFunLike.coe ;)
Multiplicative__ofAdd__app : (a1 : Elem X) -> Elem (Multiplicative X).

(; a constant applied as a function: DFunLike.coe ;)
Multiplicative__toAdd__app : (a1 : Elem (Multiplicative X)) -> Elem X.

(; the structures of a class on its parameters ;)
NNDist__on : (X : Set) -> Set.

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__ofDual__app : (a1 : Elem (OrderDual X)) -> Elem X.

(; a constant applied as a function: DFunLike.coe ;)
OrderDual__toDual__app : (a1 : Elem X) -> Elem (OrderDual X).

(; the structures of a class on its parameters ;)
PseudoMetricSpace__on : (X : Set) -> Set.

(; a constant with an instance argument that the statement gives ;)
PseudoMetricSpace__replaceBornology__in : (X : Set) -> (B : Elem (Bornology__on X)) -> (m : Elem (PseudoMetricSpace__on X)) -> (H : Proof (forall (powerset X) (s => iff (Bornology__IsBounded__in X B s) (Bornology__IsBounded__in X m s)))) -> Elem (PseudoMetricSpace__on X).

(; a constant with an instance argument that the statement gives ;)
PseudoMetricSpace__replaceUniformity__in : (X : Set) -> (U : Elem (UniformSpace__on X)) -> (m : Elem (PseudoMetricSpace__on X)) -> (H : Proof (Eqt (Filter (Prod X X)) (uniformity__in X U) (uniformity__in X m))) -> Elem (PseudoMetricSpace__on X).

(; a constant with an instance argument that the statement gives ;)
PseudoMetricSpace__toDist__in : (X : Set) -> (self : Elem (PseudoMetricSpace__on X)) -> Elem (Dist__on X).

(; a constant applied as a function: DFunLike.coe ;)
Real__nnabs__app : (a1 : Elem Real) -> Elem NNReal.

(; the structures of a class on its parameters ;)
TopologicalSpace__on : (X : Set) -> Set.

(; the structures of a class on its parameters ;)
UniformSpace__on : (X : Set) -> Set.

(; a constant with an instance argument that the statement gives ;)
uniformity__in : (X : Set) -> (x : Elem (UniformSpace__on X)) -> Elem (Filter (Prod X X)).

(; doc: If `α` carries some multiplicative structure, then `Additive α` carries the corresponding additive structure. ;)
(; //LEAN:Additive ;)
Additive : (X : Set) -> Set.

(; doc: A **bornology** on a type `α` is a filter of cobounded sets which contains the cofinite filter. Such spaces are equivalently specified by their bounded sets, see `Bornology.ofBounded` and `Bornology.ext_iff_isBounded` ;)
(; //LEAN:Bornology ;)
Bornology : (X : Set) -> Prop.

(; doc: `IsBounded` is the predicate that `s` is bounded relative to the ambient bornology on `α`. ;)
(; //LEAN:Bornology.IsBounded ;)
Bornology__IsBounded : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: The filter of cobounded sets in a bornology. ;)
(; //LEAN:Bornology.cobounded ;)
Bornology__cobounded : (X : Set) -> Elem (Filter X).

(; doc: A constructor for bornologies by specifying the bounded sets, and showing that they satisfy the appropriate conditions. ;)
(; //LEAN:Bornology.ofBounded ;)
Bornology__ofBounded : (X : Set) -> (B : Elem (powerset (powerset X))) -> (empty_mem : Proof (Membership__mem (powerset X) (powerset (powerset X)) B (EmptyCollection__emptyCollection (powerset X)))) -> (subset_mem : Proof (forall (powerset X) (s11 => if (Membership__mem (powerset X) (powerset (powerset X)) B s11) (forall (powerset X) (s21 => if (Set__Subset X s21 s11) (Membership__mem (powerset X) (powerset (powerset X)) B s21)))))) -> (union_mem : Proof (forall (powerset X) (s1 => if (Membership__mem (powerset X) (powerset (powerset X)) B s1) (forall (powerset X) (s2 => if (Membership__mem (powerset X) (powerset (powerset X)) B s2) (Membership__mem (powerset X) (powerset (powerset X)) B (Union__union (powerset X) s1 s2))))))) -> (singleton_mem : Proof (forall X (x => Membership__mem (powerset X) (powerset (powerset X)) B (Singleton__singleton X (powerset X) x)))) -> Elem (Bornology__on X).

(; //LEAN:Bornology.ofDist._proof_1 ;)
Bornology__ofDist___proof_1 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> Proof (exists Real (C => forall X (x => if (Membership__mem X (powerset X) (EmptyCollection__emptyCollection (powerset X)) x) (forall X (y => if (Membership__mem X (powerset X) (EmptyCollection__emptyCollection (powerset X)) y) (Leq (dist x y) C)))))).

(; //LEAN:Bornology.ofDist._proof_2 ;)
Bornology__ofDist___proof_2 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (x : Elem (powerset X)) -> (h : Proof (Membership__mem (powerset X) (powerset (powerset X)) (Set__ofPred (powerset X) (s1 => exists Real (C1 => forall X (x3 => if (Membership__mem X (powerset X) s1 x3) (forall X (y1 => if (Membership__mem X (powerset X) s1 y1) (Leq (dist x3 y1) C1))))))) x)) -> (x1 : Elem (powerset X)) -> (h1 : Proof (Set__Subset X x1 x)) -> Proof (Membership__mem (powerset X) (powerset (powerset X)) (Set__ofPred (powerset X) (s => exists Real (C => forall X (x2 => if (Membership__mem X (powerset X) s x2) (forall X (y => if (Membership__mem X (powerset X) s y) (Leq (dist x2 y) C))))))) x1).

(; //LEAN:Bornology.ofDist._proof_3 ;)
Bornology__ofDist___proof_3 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_comm : Proof (forall X (x4 => forall X (y4 => Eq (dist x4 y4) (dist y4 x4))))) -> (dist_triangle : Proof (forall X (x3 => forall X (y3 => forall X (z => Leq (dist x3 z) (plus (dist x3 y3) (dist y3 z))))))) -> (s : Elem (powerset X)) -> (hs : Proof (Membership__mem (powerset X) (powerset (powerset X)) (Set__ofPred (powerset X) (s3 => exists Real (C2 => forall X (x2 => if (Membership__mem X (powerset X) s3 x2) (forall X (y2 => if (Membership__mem X (powerset X) s3 y2) (Leq (dist x2 y2) C2))))))) s)) -> (t : Elem (powerset X)) -> (ht : Proof (Membership__mem (powerset X) (powerset (powerset X)) (Set__ofPred (powerset X) (s2 => exists Real (C1 => forall X (x1 => if (Membership__mem X (powerset X) s2 x1) (forall X (y1 => if (Membership__mem X (powerset X) s2 y1) (Leq (dist x1 y1) C1))))))) t)) -> Proof (Membership__mem (powerset X) (powerset (powerset X)) (Set__ofPred (powerset X) (s1 => exists Real (C => forall X (x => if (Membership__mem X (powerset X) s1 x) (forall X (y => if (Membership__mem X (powerset X) s1 y) (Leq (dist x y) C))))))) (Union__union (powerset X) s t)).

(; //LEAN:Bornology.ofDist._proof_4 ;)
Bornology__ofDist___proof_4 : (X : Set) -> (dist : (Elem X -> Elem X -> Real)) -> (z : Elem X) -> Proof (exists Real (C => forall X (x => if (Membership__mem X (powerset X) (Singleton__singleton X (powerset X) z) x) (forall X (y => if (Membership__mem X (powerset X) (Singleton__singleton X (powerset X) z) y) (Leq (dist x y) C)))))).

(; doc: The bot (`⊥`, `\bot`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊥` in identifiers is `bot`. ;)
(; //LEAN:Bot.bot ;)
Bot__bot : (X : Set) -> Elem X.

(; doc: A space with a `Bornology` is a **bounded space** if `Set.univ : Set α` is bounded. ;)
(; //LEAN:BoundedSpace ;)
BoundedSpace : (X : Set) -> Prop.

(; doc: Set / lattice complement  Conventions for notations in identifiers:   * The recommended spelling of `ᶜ` in identifiers is `compl`. ;)
(; //LEAN:Compl.compl ;)
Compl__compl : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: A function between topological spaces is continuous if the preimage of every open set is open. Registered as a structure to make sure it is not unfolded by Lean. ;)
(; //LEAN:Continuous ;)
Continuous : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function between topological spaces is continuous at a point `x₀` if `f x` tends to `f x₀` when `x` tends to `x₀`. ;)
(; //LEAN:ContinuousAt ;)
ContinuousAt : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (x2 : Elem X) -> Prop.

(; doc: A function between topological spaces is continuous on a subset `s` when it's continuous at every point of `s` within `s`. ;)
(; //LEAN:ContinuousOn ;)
ContinuousOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A function between topological spaces is continuous at a point `x₀` within a subset `s` if `f x` tends to `f x₀` when `x` tends to `x₀` while staying within `s`. ;)
(; //LEAN:ContinuousWithinAt ;)
ContinuousWithinAt : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> (x2 : Elem X) -> Prop.

(; doc: A set is dense in a topological space if every point belongs to its closure. ;)
(; //LEAN:Dense ;)
Dense : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: `f : α → X` has dense range if its range (image) is a dense subset of `X`. ;)
(; //LEAN:DenseRange ;)
DenseRange : (X : Set) -> (X1 : Set) -> (f : (Elem X1 -> X)) -> Prop.

(; doc: A topological space is discrete if every set is open, that is, its topology equals the discrete topology `⊥`. ;)
(; //LEAN:DiscreteTopology ;)
DiscreteTopology : (X : Set) -> Prop.

(; //LEAN:DiscreteTopology.mk ;)
DiscreteTopology__mk : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (eq_bot : Proof (Eqt (TopologicalSpace__on X) t (Bot__bot (TopologicalSpace__on X)))) -> Proof (DiscreteTopology X).

(; doc: Two elements of a lattice are disjoint if their inf is the bottom element.   (This generalizes disjoint sets, viewed as members of the subset lattice.)  Note that we define this without reference to `⊓`, as this allows us to talk about orders where the infimum is not unique, or where implementing `Inf` would require additional `Decidable` arguments. ;)
(; //LEAN:Disjoint ;)
Disjoint : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Prop.

(; //LEAN:Disjoint.mono_left ;)
Disjoint__mono_left : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Disjoint X b c)) -> Proof (Disjoint X a c).

(; //LEAN:Disjoint.symm ;)
Disjoint__symm : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (OrderBot X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Disjoint X a b)) -> Proof (Disjoint X b a).

(; doc: Extended distance between two points ;)
(; //LEAN:EDist.edist ;)
EDist__edist : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem ENNReal.

(; doc: The extended nonnegative real numbers. This is usually denoted [0, ∞], and is relevant as the codomain of a measure. ;)
(; //LEAN:ENNReal ;)
ENNReal : Set.

(; doc: Coercion from `ℝ≥0` to `ℝ≥0∞`. ;)
(; //LEAN:ENNReal.ofNNReal ;)
ENNReal__ofNNReal : (x : Elem NNReal) -> Elem ENNReal.

(; doc: `ofReal x` returns `x` if it is nonnegative, `0` otherwise. ;)
(; //LEAN:ENNReal.ofReal ;)
ENNReal__ofReal : (r : Elem Real) -> Elem ENNReal.

(; doc: `toNNReal x` returns `x` if it is real, otherwise 0. ;)
(; //LEAN:ENNReal.toNNReal ;)
ENNReal__toNNReal : (x : Elem ENNReal) -> Elem NNReal.

(; doc: `toReal x` returns `x` if it is real, `0` otherwise. ;)
(; //LEAN:ENNReal.toReal ;)
ENNReal__toReal : (a : Elem ENNReal) -> Elem Real.

(; doc: `∅` or `{}` is the empty set or empty collection. It is supported by the `EmptyCollection` typeclass.  Conventions for notations in identifiers:   * The recommended spelling of `{}` in identifiers is `empty`.   * The recommended spelling of `∅` in identifiers is `empty`. ;)
(; //LEAN:EmptyCollection.emptyCollection ;)
EmptyCollection__emptyCollection : (X : Set) -> Elem X.

(; doc: The equality relation. It has one introduction rule, `Eq.refl`. We use `a = b` as notation for `Eq a b`. A fundamental property of equality is that it is an equivalence relation. ``` variable (α : Type) (a b c d : α) variable (hab : a = b) (hcb : c = b) (hcd : c = d)  example : a = d :=   Eq.trans (Eq.trans hab (Eq.symm hcb)) hcd ``` Equality is much more than an equivalence relation, however. It has the important property that every assertion respects the equivalence, in the sense that we can substitute equal expressions without changing the truth value. That is, given `h1 : a = b` and `h2 : p a`, we can construct a proof for `p b` using substitution: `Eq.subst h1 h2`. Example: ``` example (α : Type) (a b : α) (p : α → Prop)         (h1 : a = b) (h2 : p a) : p b :=   Eq.subst h1 h2  example (α : Type) (a b : α) (p : α → Prop)     (h1 : a = b) (h2 : p a) : p b :=   h1 ▸ h2 ``` The triangle in the second presentation is a macro built on top of `Eq.subst` and `Eq.symm`, and you can enter it by typing `\t`. For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality)  Conventions for notations in identifiers:   * The recommended spelling of `=` in identifiers is `eq`. ;)
(; //LEAN:Eq ;)
Eq : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Prop.

(; doc: `Eq.refl a : a = a` is reflexivity, the unique constructor of the equality type. See also `rfl`, which is usually used instead. ;)
(; //LEAN:Eq.refl ;)
Eq__refl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; doc: Equality is symmetric: if `a = b` then `b = a`.  Because this is in the `Eq` namespace, if you have a variable `h : a = b`, `h.symm` can be used as shorthand for `Eq.symm h` as a proof of `b = a`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.symm ;)
Eq__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Eqt X a b)) -> Proof (Eqt X b a).

(; doc: Equality is transitive: if `a = b` and `b = c` then `a = c`.  Because this is in the `Eq` namespace, if you have variables or expressions `h₁ : a = b` and `h₂ : b = c`, you can use `h₁.trans h₂ : a = c` as shorthand for `Eq.trans h₁ h₂`.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:Eq.trans ;)
Eq__trans : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Eqt X a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Eqt X a c).

(; doc: **Alias** of `lt_of_eq_of_lt`. ;)
(; //LEAN:Eq.trans_lt ;)
Eq__trans_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (h1 : Proof (Eqt X a b)) -> (h2 : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: Existential quantification. If `p : α → Prop` is a predicate, then `∃ x : α, p x` asserts that there is some `x` of type `α` such that `p x` holds. To create an existential proof, use the `exists` tactic, or the anonymous constructor notation `⟨x, h⟩`. To unpack an existential, use `cases h` where `h` is a proof of `∃ x : α, p x`, or `let ⟨x, hx⟩ := h`.  Because Lean has proof irrelevance, any two proofs of an existential are definitionally equal. One consequence of this is that it is impossible to recover the witness of an existential from the mere fact of its existence. For example, the following does not compile: ``` example (h : ∃ x : Nat, x = x) : Nat :=   let ⟨x, _⟩ := h  -- fail, because the goal is `Nat : Type`   x ``` The error message `recursor 'Exists.casesOn' can only eliminate into Prop` means that this only works when the current goal is another proposition: ``` example (h : ∃ x : Nat, x = x) : True :=   let ⟨x, _⟩ := h  -- ok, because the goal is `True : Prop`   trivial ``` ;)
(; //LEAN:Exists ;)
Exists : (X : Set) -> (p : (Elem X -> Prop)) -> Prop.

(; //LEAN:Exists.imp ;)
Exists__imp : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => if (p a2) (q a2)))) -> (h1 : Proof (exists X (a1 => p a1))) -> Proof (exists X (a => q a)).

(; doc: A filter `F` on a type `α` is a collection of sets of `α` which contains the whole `α`, is upwards-closed, and is stable under intersection. We do not forbid this collection to be all sets of `α`. ;)
(; //LEAN:Filter ;)
Filter : (X : Set) -> Set.

(; doc: `f.Eventually p` or `∀ᶠ x in f, p x` mean that `{x | p x} ∈ f`. E.g., `∀ᶠ x in atTop, p x` means that `p` holds true for sufficiently large `x`. ;)
(; //LEAN:Filter.Eventually ;)
Filter__Eventually : (X : Set) -> (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> Prop.

(; //LEAN:Filter.Eventually.and ;)
Filter__Eventually__and : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> (h : Proof (Filter__Eventually X (x2 => p x2) f)) -> (h1 : Proof (Filter__Eventually X (x1 => q x1) f)) -> Proof (Filter__Eventually X (x => and (p x) (q x)) f).

(; //LEAN:Filter.Eventually.exists ;)
Filter__Eventually__exists : (X : Set) -> (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> (_ : Proof (Filter__NeBot X f)) -> (hp : Proof (Filter__Eventually X (x1 => p x1) f)) -> Proof (exists X (x => p x)).

(; doc: `f.Frequently p` or `∃ᶠ x in f, p x` mean that `{x | ¬p x} ∉ f`. E.g., `∃ᶠ x in atTop, p x` means that there exist arbitrarily large `x` for which `p` holds true. ;)
(; //LEAN:Filter.Frequently ;)
Filter__Frequently : (X : Set) -> (p : (Elem X -> Prop)) -> (f : Elem (Filter X)) -> Prop.

(; doc: We say that a filter `l` has a basis `s : ι → Set α` bounded by `p : ι → Prop`, if `t ∈ l` if and only if `t` includes `s i` for some `i` such that `p i`. ;)
(; //LEAN:Filter.HasBasis ;)
Filter__HasBasis : (X : Set) -> (I : Set) -> (l : Elem (Filter X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> Prop.

(; doc: Definition of `HasBasis` unfolded with implicit set argument. ;)
(; //LEAN:Filter.HasBasis.mem_iff ;)
Filter__HasBasis__mem_iff : (X : Set) -> (I : Set) -> (l : Elem (Filter X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> (t : Elem (powerset X)) -> (hl : Proof (Filter__HasBasis X I l p s)) -> Proof (iff (Membership__mem (powerset X) (Filter X) l t) (exists I (i => and (p i) (Set__Subset X (s i) t)))).

(; //LEAN:Filter.HasBasis.mem_uniformity_iff ;)
Filter__HasBasis__mem_uniformity_iff : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace X)) -> (p : (Elem Y -> Prop)) -> (s : (Elem Y -> SetRel X X)) -> (h : Proof (Filter__HasBasis (Prod X X) Y (uniformity X) p s)) -> (t : Elem (SetRel X X)) -> Proof (iff (Membership__mem (SetRel X X) (Filter (Prod X X)) (uniformity X) t) (exists Y (i => and (p i) (forall X (a => forall X (b => if (Membership__mem (Prod X X) (SetRel X X) (s i) (Prod__mk X X a b)) (Membership__mem (Prod X X) (SetRel X X) t (Prod__mk X X a b)))))))).

(; //LEAN:Filter.HasBasis.tendsto_iff ;)
Filter__HasBasis__tendsto_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (X1 : Set) -> (la : Elem (Filter X)) -> (pa : (Elem I -> Prop)) -> (sa : (Elem I -> powerset X)) -> (lb : Elem (Filter Y)) -> (pb : (Elem X1 -> Prop)) -> (sb : (Elem X1 -> powerset Y)) -> (f : (Elem X -> Y)) -> (hla : Proof (Filter__HasBasis X I la pa sa)) -> (hlb : Proof (Filter__HasBasis Y X1 lb pb sb)) -> Proof (iff (Filter__Tendsto X Y f la lb) (forall X1 (ib => if (pb ib) (exists I (ia => and (pa ia) (forall X (x => if (Membership__mem X (powerset X) (sa ia) x) (Membership__mem Y (powerset Y) (sb ib) (f x))))))))).

(; //LEAN:Filter.HasBasis.tendsto_right_iff ;)
Filter__HasBasis__tendsto_right_iff : (X : Set) -> (Y : Set) -> (X1 : Set) -> (la : Elem (Filter X)) -> (lb : Elem (Filter Y)) -> (pb : (Elem X1 -> Prop)) -> (sb : (Elem X1 -> powerset Y)) -> (f : (Elem X -> Y)) -> (hlb : Proof (Filter__HasBasis Y X1 lb pb sb)) -> Proof (iff (Filter__Tendsto X Y f la lb) (forall X1 (i => if (pb i) (Filter__Eventually X (x => Membership__mem Y (powerset Y) (sb i) (f x)) la)))).

(; //LEAN:Filter.HasBasis.uniformContinuousOn_iff ;)
Filter__HasBasis__uniformContinuousOn_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (_ : Proof (UniformSpace Y)) -> (X1 : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (ha : Proof (Filter__HasBasis (Prod X X) I (uniformity X) p s)) -> (q : (Elem X1 -> Prop)) -> (t : (Elem X1 -> powerset (Prod Y Y))) -> (hb : Proof (Filter__HasBasis (Prod Y Y) X1 (uniformity Y) q t)) -> (f : (Elem X -> Y)) -> (S : Elem (powerset X)) -> Proof (iff (UniformContinuousOn X Y f S) (forall X1 (i => if (q i) (exists I (j => and (p j) (forall X (x2 => if (Membership__mem X (powerset X) S x2) (forall X (y => if (Membership__mem X (powerset X) S y) (if (Membership__mem (Prod X X) (SetRel X X) (s j) (Prod__mk X X x2 y)) (Membership__mem (Prod Y Y) (powerset (Prod Y Y)) (t i) (Prod__mk Y Y (f x2) (f y))))))))))))).

(; //LEAN:Filter.HasBasis.uniformContinuous_iff ;)
Filter__HasBasis__uniformContinuous_iff : (X : Set) -> (Y : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (_ : Proof (UniformSpace Y)) -> (X1 : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (ha : Proof (Filter__HasBasis (Prod X X) I (uniformity X) p s)) -> (q : (Elem X1 -> Prop)) -> (t : (Elem X1 -> powerset (Prod Y Y))) -> (hb : Proof (Filter__HasBasis (Prod Y Y) X1 (uniformity Y) q t)) -> (f : (Elem X -> Y)) -> Proof (iff (UniformContinuous X Y f) (forall X1 (i => if (q i) (exists I (j => and (p j) (forall X (x2 => forall X (y => if (Membership__mem (Prod X X) (SetRel X X) (s j) (Prod__mk X X x2 y)) (Membership__mem (Prod Y Y) (powerset (Prod Y Y)) (t i) (Prod__mk Y Y (f x2) (f y))))))))))).

(; doc: A filter is `NeBot` if it is not equal to `⊥`, or equivalently the empty set does not belong to the filter. Bourbaki include this assumption in the definition of a filter but we prefer to have a `CompleteLattice` structure on `Filter _`, so we use a typeclass argument in lemmas instead. ;)
(; //LEAN:Filter.NeBot ;)
Filter__NeBot : (X : Set) -> (f : Elem (Filter X)) -> Prop.

(; doc: `Filter.Tendsto` is the generic "limit of a function" predicate. `Tendsto f l₁ l₂` asserts that for every `l₂` neighborhood `a`, the `f`-preimage of `a` is an `l₁` neighborhood. ;)
(; //LEAN:Filter.Tendsto ;)
Filter__Tendsto : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (l1 : Elem (Filter X)) -> (l2 : Elem (Filter Y)) -> Prop.

(; //LEAN:Filter.Tendsto.congr_uniformity ;)
Filter__Tendsto__congr_uniformity : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace Y)) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (l : Elem (Filter X)) -> (b : Elem Y) -> (hf : Proof (Filter__Tendsto X Y f l (nhds Y b))) -> (hg : Proof (Filter__Tendsto X (Prod Y Y) (x1 => Prod__mk Y Y (f x1) (g x1)) l (uniformity Y))) -> Proof (Filter__Tendsto X Y g l (nhds Y b)).

(; doc: `atTop` is the filter representing the limit `→ ∞` on an ordered set. It is generated by the collection of up-sets `{b | a ≤ b}`. (The preorder need not have a top element for this to be well defined, and indeed is trivial when a top element `x` exists, i.e., it coincides with `pure x`.) ;)
(; //LEAN:Filter.atTop ;)
Filter__atTop : (X : Set) -> Elem (Filter X).

(; doc: The inverse map of a filter. A set `s` belongs to `Filter.comap m f` if either of the following equivalent conditions hold.  1. There exists a set `t ∈ f` such that `m ⁻¹' t ⊆ s`. This is used as a definition. 2. The set `kernImage m s = {y | ∀ x, m x = y → x ∈ s}` belongs to `f`, see `Filter.mem_comap'`. 3. The set `(m '' sᶜ)ᶜ` belongs to `f`, see `Filter.mem_comap_iff_compl` and    `Filter.compl_mem_comap`. ;)
(; //LEAN:Filter.comap ;)
Filter__comap : (X : Set) -> (Y : Set) -> (m : (Elem X -> Y)) -> (f : Elem (Filter Y)) -> Elem (Filter X).

(; //LEAN:Filter.eventually_atTop ;)
Filter__eventually_atTop : (X : Set) -> (_ : Proof (Preorder X)) -> (_ : Proof (IsDirectedOrder X)) -> (p : (Elem X -> Prop)) -> Proof (iff (Filter__Eventually X (x1 => p x1) (Filter__atTop X)) (exists X (a => forall X (b => if (Leq a b) (p b))))).

(; //LEAN:Filter.eventually_ge_atTop ;)
Filter__eventually_ge_atTop : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Filter__Eventually X (x1 => Leq a x1) (Filter__atTop X)).

(; //LEAN:Filter.mem_of_superset ;)
Filter__mem_of_superset : (X : Set) -> (f : Elem (Filter X)) -> (x : Elem (powerset X)) -> (y : Elem (powerset X)) -> (hx : Proof (Membership__mem (powerset X) (Filter X) f x)) -> (hxy : Proof (Set__Subset X x y)) -> Proof (Membership__mem (powerset X) (Filter X) f y).

(; doc: The principal filter of `s` is the collection of all supersets of `s`. ;)
(; //LEAN:Filter.principal ;)
Filter__principal : (X : Set) -> (s : Elem (powerset X)) -> Elem (Filter X).

(; doc: The set of sets that belong to the filter. ;)
(; //LEAN:Filter.sets ;)
Filter__sets : (X : Set) -> (self : Elem (Filter X)) -> Elem (powerset (powerset X)).

(; doc: For a two-argument function `f`, `swap f` is the same function but taking the arguments in the reverse order. `swap f y x = f x y`. ;)
(; //LEAN:Function.swap ;)
Function__swap : (X : Set) -> (Y : Set) -> (phi : (Elem X -> Elem Y -> Set)) -> (f : ((x1 : Elem X) -> (y1 : Elem Y) -> phi x1 y1)) -> (y : Elem Y) -> (x : Elem X) -> Elem (phi x y).

(; //LEAN:Iff.rfl ;)
Iff__rfl : (a : Prop) -> Proof (iff a a).

(; //LEAN:Iff.symm ;)
Iff__symm : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (iff b a).

(; //LEAN:Iff.trans ;)
Iff__trans : (a : Prop) -> (b : Prop) -> (c : Prop) -> (h1 : Proof (iff a b)) -> (h2 : Proof (iff b c)) -> Proof (iff a c).

(; doc: `insert x xs` inserts the element `x` into the collection `xs`. ;)
(; //LEAN:Insert.insert ;)
Insert__insert : (X : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Z) -> Elem Z.

(; doc: `a ∩ b` is the intersection of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∩` in identifiers is `inter`. ;)
(; //LEAN:Inter.inter ;)
Inter__inter : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `a⁻¹` computes the inverse of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `⁻¹` in identifiers is `inv`. ;)
(; //LEAN:Inv.inv ;)
Inv__inv : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: A set is closed if its complement is open ;)
(; //LEAN:IsClosed ;)
IsClosed : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; doc: `IsOpen s` means that `s` is open in the ambient topological space on `X` ;)
(; //LEAN:IsOpen ;)
IsOpen : (X : Set) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:IsOpen.mem_nhds ;)
IsOpen__mem_nhds : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> (hs : Proof (IsOpen X s)) -> (hx : Proof (Membership__mem X (powerset X) s x1)) -> Proof (Membership__mem (powerset X) (Filter X) (nhds X x1) s).

(; //LEAN:LE.le.ge_iff_eq' ;)
LE__le__ge_iff_eq' : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Leq b a)) -> Proof (iff (Leq a b) (Eqt X a b)).

(; doc: **Alias** of `not_lt_of_ge`. ;)
(; //LEAN:LE.le.not_gt ;)
LE__le__not_gt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Leq a b)) -> Proof (not (Lt b a)).

(; doc: **Alias** of `le_trans`. ;)
(; //LEAN:LE.le.trans ;)
LE__le__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; doc: **Alias** of `le_of_le_of_eq`. ;)
(; //LEAN:LE.le.trans_eq ;)
LE__le__trans_eq : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LE X)) -> (h1 : Proof (Leq a b)) -> (h2 : Proof (Eqt X b c)) -> Proof (Leq a c).

(; doc: **Alias** of `lt_of_le_of_lt`. ;)
(; //LEAN:LE.le.trans_lt ;)
LE__le__trans_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: **Alias** of `le_of_lt`. ;)
(; //LEAN:LT.lt.le ;)
LT__lt__le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: **Alias** of `ne_of_lt`. ;)
(; //LEAN:LT.lt.ne ;)
LT__lt__ne : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; doc: **Alias** of `not_le_of_gt`. ;)
(; //LEAN:LT.lt.not_ge ;)
LT__lt__not_ge : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (not (Leq b a)).

(; doc: **Alias** of `lt_trans`. ;)
(; //LEAN:LT.lt.trans ;)
LT__lt__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: An extension for `positivity`. ;)
(; //LEAN:Mathlib.Meta.Positivity.PositivityExt ;)
Mathlib__Meta__Positivity__PositivityExt : Set.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; doc: `Metric.closedEBall x ε` is the set of all points `y` with `edist y x ≤ ε` ;)
(; //LEAN:Metric.closedEBall ;)
Metric__closedEBall : (X : Set) -> (x : Elem X) -> (epsilon : Elem ENNReal) -> Elem (powerset X).

(; doc: `Metric.eball x ε` is the set of all points `y` with `edist y x < ε` ;)
(; //LEAN:Metric.eball ;)
Metric__eball : (X : Set) -> (x1 : Elem X) -> (epsilon : Elem ENNReal) -> Elem (powerset X).

(; //LEAN:Metric.mem_ball._simp_1 ;)
Metric__mem_ball___simp_1 : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (y : Elem X) -> (epsilon : Elem Real) -> Proof (Eqt Prop (Membership__mem X (powerset X) (Metric__ball X x1 epsilon) y) (Lt (Dist__dist X y x1) epsilon)).

(; //LEAN:Metric.mem_sphere._simp_1 ;)
Metric__mem_sphere___simp_1 : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (y : Elem X) -> (epsilon : Elem Real) -> Proof (Eqt Prop (Membership__mem X (powerset X) (Metric__sphere X x1 epsilon) y) (Eq (Dist__dist X y x1) epsilon)).

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: If `α` carries some additive structure, then `Multiplicative α` carries the corresponding multiplicative structure. ;)
(; //LEAN:Multiplicative ;)
Multiplicative : (X : Set) -> Set.

(; doc: Nonnegative real numbers, denoted as `ℝ≥0` within the NNReal namespace ;)
(; //LEAN:NNReal ;)
NNReal : Set.

(; //LEAN:NNReal.coe_eq_zero ;)
NNReal__coe_eq_zero : (r : Elem NNReal) -> Proof (iff (Eq (NNReal__toReal r) 0) (Eqt NNReal r 0)).

(; //LEAN:NNReal.eq ;)
NNReal__eq : (n : Elem NNReal) -> (m : Elem NNReal) -> (h : Proof (Eq (NNReal__toReal n) (NNReal__toReal m))) -> Proof (Eqt NNReal n m).

(; doc: Coercion `ℝ≥0 → ℝ`. ;)
(; //LEAN:NNReal.toReal ;)
NNReal__toReal : (x : Elem NNReal) -> Elem Real.

(; doc: The canonical homomorphism `Nat → R`. In most use cases, the target type will have a (semi)ring structure, and this homomorphism should be a (semi)ring homomorphism.  `NatCast` and `IntCast` exist to allow different libraries with their own types that can be notated as natural numbers to have consistent `simp` normal forms without needing to create coercion simplification sets that are aware of all combinations. Libraries should make it easy to work with `NatCast` where possible. For instance, in Mathlib there will be such a homomorphism (and thus a `NatCast R` instance) whenever `R` is an additive monoid with a `1`.  The prototypical example is `Int.ofNat`. ;)
(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; //LEAN:Nat.cast_add ;)
Nat__cast_add : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt R (Nat__cast R (plus m n)) (plus (Nat__cast R m) (Nat__cast R n))).

(; //LEAN:Nat.cast_add._simp_1 ;)
Nat__cast_add___simp_1 : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (Eqt R (plus (Nat__cast R m) (Nat__cast R n)) (Nat__cast R (plus m n))).

(; //LEAN:Nat.cast_add_one_pos ;)
Nat__cast_add_one_pos : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> (n : Elem Nat) -> Proof (Lt 0 (plus (Nat__cast X n) 1)).

(; //LEAN:Nat.cast_one ;)
Nat__cast_one : (R : Set) -> (_ : Proof (AddMonoidWithOne R)) -> Proof (Eqt R (Nat__cast R 1) 1).

(; doc: Specialisation of `Nat.cast_pos'`, which seems to be easier for Lean to use. ;)
(; //LEAN:Nat.cast_pos ;)
Nat__cast_pos : (X : Set) -> (_ : Proof (Semiring X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (IsOrderedRing X)) -> (n : Elem Nat) -> Proof (iff (Lt 0 (Nat__cast X n)) (Lt 0 n)).

(; //LEAN:Nat.succ_pos ;)
Nat__succ_pos : (n : Elem Nat) -> Proof (Lt 0 (succ n)).

(; //LEAN:Ne.symm ;)
Ne__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Neq a b)) -> Proof (Neq b a).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (X : Set) -> (x : Elem X) -> Elem X.

(; doc: Order without maximal elements. Sometimes called cofinal. ;)
(; //LEAN:NoMaxOrder ;)
NoMaxOrder : (X : Set) -> Prop.

(; doc: Type synonym to equip a type with the dual order: `≤` means `≥` and `<` means `>`. `αᵒᵈ` is notation for `OrderDual α`. ;)
(; //LEAN:OrderDual ;)
OrderDual : (X : Set) -> Set.

(; doc: A relation `r` holds pairwise if `r i j` for all `i ≠ j`. ;)
(; //LEAN:Pairwise ;)
Pairwise : (X : Set) -> (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (X : Set) -> (Y : Set) -> (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (X : Set) -> (Y : Set) -> (self : Elem (Prod X Y)) -> Elem Y.

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpace._proof_1 ;)
PseudoEMetricSpace__toPseudoMetricSpace___proof_1 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Leq 0 (ENNReal__toReal (EDist__edist X x1 y))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpace._proof_2 ;)
PseudoEMetricSpace__toPseudoMetricSpace___proof_2 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (h : Proof (forall X (x2 => forall X (y1 => Neq (EDist__edist X x2 y1) (Top__top ENNReal))))) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt ENNReal (EDist__edist X x1 y) (ENNReal__ofReal (ENNReal__toReal (EDist__edist X x1 y)))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_1 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_1 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y1 => Leq 0 (dist x2 y1))))) -> (h : Proof (forall X (x1 => forall X (y => Eqt ENNReal (EDist__edist X x1 y) (ENNReal__ofReal (dist x1 y)))))) -> (x : Elem X) -> Proof (Eq (dist x x) 0).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_2 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_2 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y2 => Leq 0 (dist x2 y2))))) -> (h : Proof (forall X (x1 => forall X (y1 => Eqt ENNReal (EDist__edist X x1 y1) (ENNReal__ofReal (dist x1 y1)))))) -> (x : Elem X) -> (y : Elem X) -> Proof (Eq (dist x y) (dist y x)).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_3 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_3 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x1 => forall X (y1 => Leq 0 (dist x1 y1))))) -> (h : Proof (forall X (x => forall X (y => Eqt ENNReal (EDist__edist X x y) (ENNReal__ofReal (dist x y)))))) -> Proof (Eqt (Filter (Prod X X)) (uniformity X) (iInf (Filter (Prod X X)) Real (epsilon => iInf (Filter (Prod X X)) (Gt epsilon 0) (h1 => Filter__principal (Prod X X) (Set__ofPred (Prod X X) (p => Lt (dist (Prod__fst X X p) (Prod__snd X X p)) epsilon)))))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_4 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_4 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y2 => Leq 0 (dist x2 y2))))) -> (h : Proof (forall X (x1 => forall X (y1 => Eqt ENNReal (EDist__edist X x1 y1) (ENNReal__ofReal (dist x1 y1)))))) -> (x : Elem X) -> (y : Elem X) -> (z : Elem X) -> Proof (Leq (dist x z) (plus (dist x y) (dist y z))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_5 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_5 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (h : Proof (forall X (x2 => forall X (y => Eqt ENNReal (EDist__edist X x2 y) (ENNReal__ofReal (dist x2 y)))))) -> (x : Elem X) -> (x1 : Elem X) -> Proof (Eqt ENNReal (EDist__edist X x x1) (ENNReal__ofReal (dist x x1))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_7 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_7 : (X : Set) -> (e : Elem (PseudoEMetricSpace__on X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x4 => forall X (y4 => Leq 0 (dist x4 y4))))) -> (h : Proof (forall X (x3 => forall X (y3 => Eqt ENNReal (EDist__edist X x3 y3) (ENNReal__ofReal (dist x3 y3)))))) -> Proof (Eqt (powerset (powerset X)) (Filter__sets X (Bornology__cobounded__in X (Bornology__ofDist X dist (x => y => PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_2 X dist dist_nonneg h x y) (x1 => y1 => z => PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_4 X dist dist_nonneg h x1 y1 z)))) (Set__ofPred (powerset X) (s => exists Real (C => forall X (x2 => if (Membership__mem X (powerset X) (Compl__compl (powerset X) s) x2) (forall X (y2 => if (Membership__mem X (powerset X) (Compl__compl (powerset X) s) y2) (Leq (dist x2 y2) C)))))))).

(; //LEAN:PseudoEMetricSpace.toUniformSpace ;)
PseudoEMetricSpace__toUniformSpace : (X : Set) -> Elem (UniformSpace__on X).

(; //LEAN:PseudoMetricSpace.cobounded_sets._autoParam ;)
PseudoMetricSpace__cobounded_sets___autoParam : Elem Lean__Syntax.

(; //LEAN:PseudoMetricSpace.edist_dist._autoParam ;)
PseudoMetricSpace__edist_dist___autoParam : Elem Lean__Syntax.

(; //LEAN:PseudoMetricSpace.replaceBornology._proof_2 ;)
PseudoMetricSpace__replaceBornology___proof_2 : (X : Set) -> (B : Elem (Bornology__on X)) -> (m : Elem (PseudoMetricSpace__on X)) -> (H : Proof (forall (powerset X) (s1 => iff (Bornology__IsBounded__in X B s1) (Bornology__IsBounded__in X m s1)))) -> Proof (Eqt (powerset (powerset X)) (Filter__sets X (Bornology__cobounded__in X B)) (Set__ofPred (powerset X) (s => exists Real (C => forall X (x => if (Membership__mem X (powerset X) (Compl__compl (powerset X) s) x) (forall X (y => if (Membership__mem X (powerset X) (Compl__compl (powerset X) s) y) (Leq (Dist__dist X x y) C)))))))).

(; //LEAN:PseudoMetricSpace.replaceTopology._proof_1 ;)
PseudoMetricSpace__replaceTopology___proof_1 : (Z : Set) -> (U : Elem (TopologicalSpace__on Z)) -> (m : Elem (PseudoMetricSpace__on Z)) -> (H : Proof (Eqt (TopologicalSpace__on Z) U (UniformSpace__toTopologicalSpace__in Z m))) -> Proof (Eqt (Filter (Prod Z Z)) (uniformity__in Z (UniformSpace__replaceTopology Z (PseudoMetricSpace__toUniformSpace Z) H)) (uniformity__in Z (UniformSpace__replaceTopology Z (PseudoMetricSpace__toUniformSpace Z) H))).

(; //LEAN:PseudoMetricSpace.replaceUniformity._proof_1 ;)
PseudoMetricSpace__replaceUniformity___proof_1 : (X : Set) -> (U : Elem (UniformSpace__on X)) -> (m : Elem (PseudoMetricSpace__on X)) -> (H : Proof (Eqt (Filter (Prod X X)) (uniformity__in X U) (uniformity__in X m))) -> Proof (Eqt (Filter (Prod X X)) (uniformity__in X U) (iInf (Filter (Prod X X)) Real (epsilon => iInf (Filter (Prod X X)) (Gt epsilon 0) (h => Filter__principal (Prod X X) (Set__ofPred (Prod X X) (p => Lt (Dist__dist X (Prod__fst X X p) (Prod__snd X X p)) epsilon)))))).

(; //LEAN:PseudoMetricSpace.toBornology ;)
PseudoMetricSpace__toBornology : (X : Set) -> Elem (Bornology__on X).

(; //LEAN:PseudoMetricSpace.toUniformSpace ;)
PseudoMetricSpace__toUniformSpace : (X : Set) -> Elem (UniformSpace__on X).

(; //LEAN:PseudoMetricSpace.uniformity_dist._autoParam ;)
PseudoMetricSpace__uniformity_dist___autoParam : Elem Lean__Syntax.

(; doc: Canonical homomorphism from `Rat` to a division ring `K`. This is just the bare function in order to aid in creating instances of `DivisionRing`. ;)
(; //LEAN:Rat.cast ;)
Rat__cast : (K : Set) -> (x1 : Elem Rat) -> Elem K.

(; //LEAN:Rat.cast_pos ;)
Rat__cast_pos : (q : Elem Rat) -> (K : Set) -> (_ : Proof (Field K)) -> (_ : Proof (LinearOrder K)) -> (_ : Proof (IsStrictOrderedRing K)) -> Proof (iff (Lt 0 (Rat__cast K q)) (Lt 0 q)).

(; doc: Reinterpret a real number `r` as a non-negative real number. Returns `0` if `r < 0`. ;)
(; //LEAN:Real.toNNReal ;)
Real__toNNReal : (r : Elem Real) -> Elem NNReal.

(; doc: `a \ b` is the set difference of `a` and `b`, consisting of all elements in `a` that are not in `b`.  Conventions for notations in identifiers:   * The recommended spelling of `\` in identifiers is `sdiff`. ;)
(; //LEAN:SDiff.sdiff ;)
SDiff__sdiff : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (X : Set) -> (Y : Set) -> (Z : Set) -> (x : Elem X) -> (x1 : Elem Y) -> Elem Z.

(; doc: A `SemilatticeSup` is a join-semilattice, that is, a partial order with a join (a.k.a. lub / least upper bound, sup / supremum) operation `⊔` which is the least element larger than both factors. ;)
(; //LEAN:SemilatticeSup ;)
SemilatticeSup : (X : Set) -> Prop.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ioo a b` is the left-open right-open interval $(a, b)$. ;)
(; //LEAN:Set.Ioo ;)
Set__Ioo : (X : Set) -> (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (X : Set) -> (s : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Nonempty.mono ;)
Set__Nonempty__mono : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (ht : Proof (Set__Subset X s t)) -> (hs : Proof (Set__Nonempty X s)) -> Proof (Set__Nonempty X t).

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (X : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Subset.rfl ;)
Set__Subset__rfl : (X : Set) -> (s : Elem (powerset X)) -> Proof (Set__Subset X s s).

(; //LEAN:Set.disjoint_left ;)
Set__disjoint_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Disjoint (powerset X) s t) (forall X (a => if (Membership__mem X (powerset X) s a) (not (Membership__mem X (powerset X) t a))))).

(; //LEAN:Set.eq_empty_iff_forall_notMem ;)
Set__eq_empty_iff_forall_notMem : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) s (EmptyCollection__emptyCollection (powerset X))) (forall X (x => not (Membership__mem X (powerset X) s x)))).

(; //LEAN:Set.eq_univ_iff_forall ;)
Set__eq_univ_iff_forall : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) s (Set__univ X)) (forall X (x => Membership__mem X (powerset X) s x))).

(; //LEAN:Set.eq_univ_of_forall ;)
Set__eq_univ_of_forall : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (forall X (x => Membership__mem X (powerset X) s x))) -> Proof (Eqt (powerset X) s (Set__univ X)).

(; //LEAN:Set.exists_range_iff ;)
Set__exists_range_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (p : (Elem X -> Prop)) -> Proof (iff (exists X (a => and (Membership__mem X (powerset X) (Set__range X I f) a) (p a))) (exists I (i => p (f i)))).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem X (powerset X) a x) (Membership__mem X (powerset X) b x)))) -> Proof (Eqt (powerset X) a b).

(; doc: Indexed intersection of a family of sets ;)
(; //LEAN:Set.iInter ;)
Set__iInter : (X : Set) -> (I : Set) -> (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (X : Set) -> (I : Set) -> (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; //LEAN:Set.iUnion_eq_univ_iff ;)
Set__iUnion_eq_univ_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> powerset X)) -> Proof (iff (Eqt (powerset X) (Set__iUnion X I (i => f i)) (Set__univ X)) (forall X (x => exists I (i1 => Membership__mem X (powerset X) (f i1) x)))).

(; //LEAN:Set.inter_subset_inter ;)
Set__inter_subset_inter : (X : Set) -> (s1 : Elem (powerset X)) -> (s2 : Elem (powerset X)) -> (t1 : Elem (powerset X)) -> (t2 : Elem (powerset X)) -> (h1 : Proof (Set__Subset X s1 t1)) -> (h2 : Proof (Set__Subset X s2 t2)) -> Proof (Set__Subset X (Inter__inter (powerset X) s1 s2) (Inter__inter (powerset X) t1 t2)).

(; //LEAN:Set.mem_Ioo ;)
Set__mem_Ioo : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (x1 : Elem X) -> Proof (iff (Membership__mem X (powerset X) (Set__Ioo X a b) x1) (and (Lt a x1) (Lt x1 b))).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (X : Set) -> (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> Elem (powerset X).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : (X : Set) -> Elem (powerset X).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (X : Set) -> (Y : Set) -> (x : Elem X) -> Elem Y.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : (X : Set) -> Elem X.

(; doc: A topology on `X`. ;)
(; //LEAN:TopologicalSpace ;)
TopologicalSpace : (X : Set) -> Prop.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (X : Set) -> (Y : Set) -> (Z : Set) -> (r : (Elem X -> Elem Y -> Set)) -> (s : (Elem Y -> Elem Z -> Set)) -> (t : (Elem X -> Elem Z -> Set)) -> (a : Elem X) -> (b : Elem Y) -> (c : Elem Z) -> (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; //LEAN:Uniform.tendsto_congr ;)
Uniform__tendsto_congr : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace Y)) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (l : Elem (Filter X)) -> (b : Elem Y) -> (hfg : Proof (Filter__Tendsto X (Prod Y Y) (x1 => Prod__mk Y Y (f x1) (g x1)) l (uniformity Y))) -> Proof (iff (Filter__Tendsto X Y f l (nhds Y b)) (Filter__Tendsto X Y g l (nhds Y b))).

(; doc: A function `f : α → β` is *uniformly continuous* if `(f x, f y)` tends to the diagonal as `(x, y)` tends to the diagonal. In other words, if `x` is sufficiently close to `y`, then `f x` is close to `f y` no matter where `x` and `y` are located in `α`. ;)
(; //LEAN:UniformContinuous ;)
UniformContinuous : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is *uniformly continuous* on `s : Set α` if `(f x, f y)` tends to the diagonal as `(x, y)` tends to the diagonal while remaining in `s ×ˢ s`. In other words, if `x` is sufficiently close to `y`, then `f x` is close to `f y` no matter where `x` and `y` are located in `s`. ;)
(; //LEAN:UniformContinuousOn ;)
UniformContinuousOn : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A uniform space is a generalization of the "uniform" topological aspects of a metric space. It consists of a filter on `α × α` called the "uniformity", which satisfies properties analogous to the reflexivity, symmetry, and triangle properties of a metric.  A metric space has a natural uniformity, and a uniform space has a natural topology. A topological group also has a natural uniformity, even when it is not metrizable. ;)
(; //LEAN:UniformSpace ;)
UniformSpace : (X : Set) -> Prop.

(; doc: The ball around `(x : β)` with respect to `(V : Set (β × β))`. Intended to be used for `V ∈ 𝓤 β`, but this is not needed for the definition. Recovers the notions of metric space ball when `V = {p | dist p.1 p.2 < r }`. ;)
(; //LEAN:UniformSpace.ball ;)
UniformSpace__ball : (Y : Set) -> (x : Elem Y) -> (V : Elem (powerset (Prod Y Y))) -> Elem (powerset Y).

(; //LEAN:UniformSpace.ext ;)
UniformSpace__ext : (X : Set) -> (u1 : Elem (UniformSpace__on X)) -> (u2 : Elem (UniformSpace__on X)) -> (h : Proof (Eqt (Filter (Prod X X)) (uniformity__in X u1) (uniformity__in X u2))) -> Proof (Eqt (UniformSpace__on X) u1 u2).

(; doc: Define a `UniformSpace` using a "distance" function. The function can be, e.g., the distance in a (usual or extended) metric space or an absolute value on a ring. ;)
(; //LEAN:UniformSpace.ofFun ;)
UniformSpace__ofFun : (X : Set) -> (M : Set) -> (d : (Elem X -> Elem X -> M)) -> (refl : Proof (forall X (x5 => Eqt M (d x5 x5) 0))) -> (symm : Proof (forall X (x4 => forall X (y2 => Eqt M (d x4 y2) (d y2 x4))))) -> (triangle : Proof (forall X (x3 => forall X (y1 => forall X (z => Leq (d x3 z) (plus (d x3 y1) (d y1 z))))))) -> (half : Proof (forall M (epsilon => if (Gt epsilon 0) (exists M (delta => and (Gt delta 0) (forall M (x2 => if (Lt x2 delta) (forall M (y => if (Lt y delta) (Lt (plus x2 y) epsilon)))))))))) -> Elem (UniformSpace__on X).

(; //LEAN:UniformSpace.toTopologicalSpace ;)
UniformSpace__toTopologicalSpace : (X : Set) -> Elem (TopologicalSpace__on X).

(; //LEAN:UniformSpace.toTopologicalSpace_bot ;)
UniformSpace__toTopologicalSpace_bot : (X : Set) -> Proof (Eqt (TopologicalSpace__on X) (UniformSpace__toTopologicalSpace__in X (Bot__bot (UniformSpace__on X))) (Bot__bot (TopologicalSpace__on X))).

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `abs a`, denoted `|a|`, is the absolute value of `a` ;)
(; //LEAN:abs ;)
abs : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:abs_of_nonneg ;)
abs_of_nonneg : (X : Set) -> (_ : Proof (Lattice X)) -> (_ : Proof (AddGroup X)) -> (a : Elem X) -> (h1 : Proof (Leq 0 a)) -> Proof (Eqt X (abs X a) a).

(; //LEAN:abs_sub_le_iff ;)
abs_sub_le_iff : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (_ : Proof (LinearOrder G)) -> (_ : Proof (IsOrderedAddMonoid G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Leq (abs G (minus a b)) c) (and (Leq (minus a b) c) (Leq (minus b a) c))).

(; //LEAN:abs_sub_lt_iff ;)
abs_sub_lt_iff : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (_ : Proof (LinearOrder G)) -> (_ : Proof (IsOrderedAddMonoid G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Lt (abs G (minus a b)) c) (and (Lt (minus a b) c) (Lt (minus b a) c))).

(; doc: Anything follows from two contradictory hypotheses. Example: ``` example (hp : p) (hnp : ¬p) : q := absurd hp hnp ``` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:absurd ;)
absurd : (a : Prop) -> (b : Set) -> (h1 : Proof a) -> (h2 : Proof (not a)) -> Elem b.

(; //LEAN:add_comm ;)
add_comm : (G : Set) -> (_ : Proof (AddCommMagma G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a b) (plus b a)).

(; //LEAN:add_le_add ;)
add_le_add : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h11 : Proof (Leq a b)) -> (h2 : Proof (Leq c d)) -> Proof (Leq (plus a c) (plus b d)).

(; //LEAN:add_lt_add_left ;)
add_lt_add_left : (X : Set) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (bc : Proof (Lt b c)) -> (a : Elem X) -> Proof (Lt (plus b a) (plus c a)).

(; //LEAN:add_lt_add_of_le_of_lt ;)
add_lt_add_of_le_of_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h11 : Proof (Leq a b)) -> (h2 : Proof (Lt c d)) -> Proof (Lt (plus a c) (plus b d)).

(; //LEAN:add_lt_add_of_lt_of_le ;)
add_lt_add_of_lt_of_le : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h11 : Proof (Lt a b)) -> (h2 : Proof (Leq c d)) -> Proof (Lt (plus a c) (plus b d)).

(; //LEAN:add_sub_cancel ;)
add_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a (minus b a)) b).

(; doc: Gadget for automatic parameter support. This is similar to the `optParam` gadget, but it uses the given tactic. Like `optParam`, this gadget only affects elaboration. For example, the tactic will *not* be invoked during type class resolution. ;)
(; //LEAN:autoParam ;)
autoParam : (X : Set) -> (tactic : Elem Lean__Syntax) -> Set.

(; doc: Cast across a type equality. If `h : α = β` is an equality of types, and `a : α`, then `a : β` will usually not typecheck directly, but this function will allow you to work around this and embed `a` in type `β` as `cast h a : β`.  It is best to avoid this function if you can, because it is more complicated to reason about terms containing casts, but if the types don't match up definitionally sometimes there isn't anything better you can do.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:cast ;)
cast : (X : Set) -> (Y : Set) -> (h : Proof (Eqt Set X Y)) -> (a : Elem X) -> Elem Y.

(; doc: The closure of `s` is the smallest closed set containing `s`. ;)
(; //LEAN:closure ;)
closure : (X : Set) -> (s : Elem (powerset X)) -> Elem (powerset X).

(; doc: Congruence in both function and argument. If `f₁ = f₂` and `a₁ = a₂` then `f₁ a₁ = f₂ a₂`. This only works for nondependent functions; the theorem statement is more complex in the dependent case.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congr ;)
congr : (X : Set) -> (Y : Set) -> (f1 : (Elem X -> Y)) -> (f2 : (Elem X -> Y)) -> (a1 : Elem X) -> (a2 : Elem X) -> (h1 : Proof (Eqt (Elem X -> Y) f1 f2)) -> (h2 : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f1 a1) (f2 a2)).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (a1 : Elem X) -> (a2 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X a1 a2)) -> Proof (Eqt Y (f a1) (f a2)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; //LEAN:continuous_iff_continuousAt ;)
continuous_iff_continuousAt : (X : Set) -> (Y : Set) -> (_ : Proof (TopologicalSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (Continuous X Y f) (forall X (x2 => ContinuousAt X Y f x2))).

(; //LEAN:div_pos ;)
div_pos : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (Lt 0 (div a b)).

(; //LEAN:exists_nat_ge ;)
exists_nat_ge : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (PartialOrder R)) -> (_ : Proof (IsOrderedRing R)) -> (_ : Proof (Archimedean R)) -> (x2 : Elem R) -> Proof (exists Nat (n => Leq x2 (Nat__cast R n))).

(; //LEAN:exists_nat_gt ;)
exists_nat_gt : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (PartialOrder R)) -> (_ : Proof (IsStrictOrderedRing R)) -> (_ : Proof (Archimedean R)) -> (x2 : Elem R) -> Proof (exists Nat (n => Lt x2 (Nat__cast R n))).

(; //LEAN:exists_nat_one_div_lt ;)
exists_nat_one_div_lt : (K : Set) -> (_ : Proof (Semifield K)) -> (_ : Proof (LinearOrder K)) -> (_ : Proof (IsStrictOrderedRing K)) -> (_ : Proof (Archimedean K)) -> (epsilon : Elem K) -> (hepsilon : Proof (Lt 0 epsilon)) -> Proof (exists Nat (n => Lt (div 1 (plus (Nat__cast K n) 1)) epsilon)).

(; doc: For any `y < 1` and any positive `x`, there exists `n : ℕ` with `y ^ n < x`. ;)
(; //LEAN:exists_pow_lt_of_lt_one ;)
exists_pow_lt_of_lt_one : (K : Set) -> (_ : Proof (Semifield K)) -> (_ : Proof (LinearOrder K)) -> (_ : Proof (IsStrictOrderedRing K)) -> (_ : Proof (Archimedean K)) -> (x2 : Elem K) -> (y : Elem K) -> (_ : Proof (ExistsAddOfLE K)) -> (hx : Proof (Lt 0 x2)) -> (hy : Proof (Lt y 1)) -> Proof (exists Nat (n => Lt (pow y n) x2)).

(; //LEAN:exists_rat_btwn ;)
exists_rat_btwn : (K : Set) -> (_ : Proof (Field K)) -> (_ : Proof (LinearOrder K)) -> (_ : Proof (IsStrictOrderedRing K)) -> (_ : Proof (Archimedean K)) -> (x2 : Elem K) -> (y : Elem K) -> (h2 : Proof (Lt x2 y)) -> Proof (exists Rat (q => and (Lt x2 (Rat__cast K q)) (Lt (Rat__cast K q) y))).

(; //LEAN:forall_congr ;)
forall_congr : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => Eqt Prop (p a2) (q a2)))) -> Proof (Eqt Prop (forall X (a => p a)) (forall X (a1 => q a1))).

(; //LEAN:forall_congr' ;)
forall_congr' : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => iff (p a2) (q a2)))) -> Proof (iff (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: **Function extensionality.** If two functions return equal results for all possible arguments, then they are equal.  It is called “extensionality” because it provides a way to prove two objects equal based on the properties of the underlying mathematical functions, rather than based on the syntax used to denote them. Function extensionality is a theorem that can be [proved using quotient types](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=quotient-funext). ;)
(; //LEAN:funext ;)
funext : (X : Set) -> (beta : (Elem X -> Set)) -> (f : ((x3 : Elem X) -> beta x3)) -> (g : ((x2 : Elem X) -> beta x2)) -> (h : Proof (forall X (x1 => Eqt (beta x1) (f x1) (g x1)))) -> Proof (Eqt ((x : Elem X) -> beta x) f g).

(; doc: **Alias** of the reverse direction of `half_lt_self_iff`. ;)
(; //LEAN:half_lt_self ;)
half_lt_self : (X : Set) -> (_ : Proof (Semifield X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (_ : Proof (IsStrictOrderedRing X)) -> (h2 : Proof (Lt 0 a)) -> Proof (Lt (div a 2) a).

(; //LEAN:half_pos ;)
half_pos : (X : Set) -> (_ : Proof (Semifield X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (_ : Proof (IsStrictOrderedRing X)) -> (h2 : Proof (Lt 0 a)) -> Proof (Lt 0 (div a 2)).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (X : Set) -> (I : Set) -> (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (X : Set) -> (a : Elem X) -> Elem X.

(; //LEAN:iff_self ;)
iff_self : (p : Prop) -> Proof (Eqt Prop (iff p p) True).

(; //LEAN:implies_congr ;)
implies_congr : (X : Set) -> (X1 : Set) -> (X2 : Set) -> (X3 : Set) -> (h1 : Proof (Eqt Set X X1)) -> (h2 : Proof (Eqt Set X2 X3)) -> Proof (Eqt Set (Elem X -> X2) (Elem X1 -> X3)).

(; doc: The interior of a set `s` is the largest open subset of `s`. ;)
(; //LEAN:interior ;)
interior : (X : Set) -> (s : Elem (powerset X)) -> Elem (powerset X).

(; //LEAN:interior_maximal ;)
interior_maximal : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h1 : Proof (Set__Subset X t s)) -> (h2 : Proof (IsOpen X t)) -> Proof (Set__Subset X t (interior X s)).

(; //LEAN:le_iff_lt_or_eq ;)
le_iff_lt_or_eq : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Leq a b) (or (Lt a b) (Eqt X a b))).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_of_lt ;)
le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: The relation `≤` on a preorder is reflexive. ;)
(; //LEAN:le_refl ;)
le_refl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: The relation `≤` on a preorder is transitive. ;)
(; //LEAN:le_trans ;)
le_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; //LEAN:lt_add_one ;)
lt_add_one : (X : Set) -> (_ : Proof (AddZeroClass X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> (a : Elem X) -> Proof (Lt a (plus a 1)).

(; //LEAN:lt_min ;)
lt_min : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h1 : Proof (Lt a b)) -> (h2 : Proof (Lt a c)) -> Proof (Lt a (Min__min X b c)).

(; //LEAN:lt_of_le_of_lt ;)
lt_of_le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_lt_of_le ;)
lt_of_lt_of_le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Lt a b)) -> (hbc : Proof (Leq b c)) -> Proof (Lt a c).

(; //LEAN:mem_closure_iff_nhds_basis ;)
mem_closure_iff_nhds_basis : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (I : Set) -> (x1 : Elem X) -> (t : Elem (powerset X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> (h : Proof (Filter__HasBasis X I (nhds X x1) p s)) -> Proof (iff (Membership__mem X (powerset X) (closure X t) x1) (forall I (i => if (p i) (exists X (y => and (Membership__mem X (powerset X) t y) (Membership__mem X (powerset X) (s i) y)))))).

(; //LEAN:min_le_left ;)
min_le_left : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (Min__min X a b) a).

(; //LEAN:min_lt_iff ;)
min_lt_iff : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (Min__min X a b) c) (or (Lt a c) (Lt b c))).

(; //LEAN:ne_of_lt ;)
ne_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; //LEAN:ne_of_mem_of_not_mem ;)
ne_of_mem_of_not_mem : (X : Set) -> (Y : Set) -> (_ : Proof (Membership X Y)) -> (s : Elem Y) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Membership__mem X Y s a)) -> (h1 : Proof (not (Membership__mem X Y s b))) -> Proof (Neq a b).

(; doc: A set is called a neighborhood of `x` if it contains an open set around `x`. The set of all neighborhoods of `x` forms a filter, the neighborhood filter at `x`, is here defined as the infimum over the principal filters of all open sets containing `x`.  [Wikidata Q3275652](https://www.wikidata.org/wiki/Q3275652) ;)
(; //LEAN:nhds ;)
nhds : (X : Set) -> (x1 : Elem X) -> Elem (Filter X).

(; doc: The "neighborhood within" filter. Elements of `𝓝[s] x` are sets containing the intersection of `s` and a neighborhood of `x`. ;)
(; //LEAN:nhdsWithin ;)
nhdsWithin : (X : Set) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> Elem (Filter X).

(; //LEAN:nhdsWithin_hasBasis ;)
nhdsWithin_hasBasis : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (I : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> (a : Elem X) -> (h : Proof (Filter__HasBasis X I (nhds X a) p s)) -> (t : Elem (powerset X)) -> Proof (Filter__HasBasis X I (nhdsWithin X a t) p (i => Inter__inter (powerset X) (s i) t)).

(; //LEAN:nhds_basis_uniformity ;)
nhds_basis_uniformity : (X : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (h : Proof (Filter__HasBasis (Prod X X) I (uniformity X) p s)) -> (x1 : Elem X) -> Proof (Filter__HasBasis X I (nhds X x1) p (i => Set__ofPred X (y => Membership__mem (Prod X X) (SetRel X X) (s i) (Prod__mk X X y x1)))).

(; //LEAN:of_eq_true ;)
of_eq_true : (p : Prop) -> (h : Proof (Eqt Prop p True)) -> Proof p.

(; //LEAN:one_div ;)
one_div : (G : Set) -> (_ : Proof (DivInvMonoid G)) -> (a : Elem G) -> Proof (Eqt G (div 1 a) (Inv__inv G a)).

(; //LEAN:pow_pos ;)
pow_pos : (X : Set) -> (_ : Proof (MonoidWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (_ : Proof (ZeroLEOneClass X)) -> (ha : Proof (Lt 0 a)) -> (n : Elem Nat) -> Proof (Lt 0 (pow a n)).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:sub_le_iff_le_add ;)
sub_le_iff_le_add : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LE X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Leq (minus a c) b) (Leq a (plus b c))).

(; //LEAN:sub_lt_comm ;)
sub_lt_comm : (X : Set) -> (_ : Proof (AddCommGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (minus a b) c) (Lt (minus a c) b)).

(; //LEAN:sub_lt_iff_lt_add' ;)
sub_lt_iff_lt_add' : (X : Set) -> (_ : Proof (AddCommGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (minus a b) c) (Lt a (plus b c))).

(; //LEAN:sub_pos ;)
sub_pos : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt 0 (minus a b)) (Lt b a)).

(; //LEAN:sub_self_div_two ;)
sub_self_div_two : (X : Set) -> (_ : Proof (Field X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (IsStrictOrderedRing X)) -> (a : Elem X) -> Proof (Eqt X (minus a (div a 2)) (div a 2)).

(; //LEAN:sub_sub_self ;)
sub_sub_self : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus a (minus a b)) b).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

(; doc: The uniformity is a filter on α × α (inferred from an ambient uniform space structure on α). ;)
(; //LEAN:uniformity ;)
uniformity : (X : Set) -> Elem (Filter (Prod X X)).

(; doc: See `zero_lt_one'` for a version with the type explicit. ;)
(; //LEAN:zero_lt_one ;)
zero_lt_one : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero X 1)) -> Proof (Lt 0 1).

