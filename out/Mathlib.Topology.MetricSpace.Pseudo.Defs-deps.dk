(; //LEAN:LT.lt.trans ;)
LT__lt__trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt a b)) -> (h1 : Proof (Lt b c)) -> Proof (Lt a c).

(; doc: An extension for `positivity`. ;)
(; //LEAN:Mathlib.Meta.Positivity.PositivityExt ;)
Mathlib__Meta__Positivity__PositivityExt : Set.

(; doc: The membership relation `a ∈ s : Prop` where `a : α`, `s : γ`.  Conventions for notations in identifiers:   * The recommended spelling of `∈` in identifiers is `mem`. ;)
(; //LEAN:Membership.mem ;)
Membership__mem : (x1 : Elem Z) -> (x2 : Elem x) -> Prop.

(; doc: `Metric.closedEBall x ε` is the set of all points `y` with `edist y x ≤ ε` ;)
(; //LEAN:Metric.closedEBall ;)
Metric__closedEBall : (x : Elem X) -> (x1 : Elem ENNReal) -> Elem (powerset X).

(; doc: `Metric.eball x ε` is the set of all points `y` with `edist y x < ε` ;)
(; //LEAN:Metric.eball ;)
Metric__eball : (x1 : Elem X) -> (x2 : Elem ENNReal) -> Elem (powerset X).

(; //LEAN:Metric.mem_sphere._simp_1 ;)
Metric__mem_sphere___simp_1 : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (y : Elem X) -> (x2 : Elem Real) -> Proof (Eqt Prop (Membership__mem (Metric__sphere x1 x2) y) (Eq (Dist__dist y x1) x2)).

(; doc: Returns the lesser of its two arguments.  Conventions for notations in identifiers:   * The recommended spelling of `min` in identifiers is `min`.   * The recommended spelling of `⊓` in identifiers is `inf` (`⊓` is the preferred notation for `min` when the type is not linearly ordered.). ;)
(; //LEAN:Min.min ;)
Min__min : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: If `α` carries some additive structure, then `Multiplicative α` carries the corresponding multiplicative structure. ;)
(; //LEAN:Multiplicative ;)
Multiplicative : (X : Set) -> Set.

(; doc: Nonnegative real numbers, denoted as `ℝ≥0` within the NNReal namespace ;)
(; //LEAN:NNReal ;)
NNReal : Set.

(; //LEAN:NNReal.coe_eq_zero ;)
NNReal__coe_eq_zero : (r : Elem NNReal) -> Proof (iff (Eq (NNReal__toReal r) 0) (Eqt NNReal r 0)).

(; //LEAN:NNReal.eq ;)
NNReal__eq : (n : Elem NNReal) -> (m : Elem NNReal) -> (h : Proof (Eq (NNReal__toReal n) (NNReal__toReal m))) -> Proof (Eqt NNReal n m).

(; doc: Coercion `ℝ≥0 → ℝ`. ;)
(; //LEAN:NNReal.toReal ;)
NNReal__toReal : (x : Elem NNReal) -> Elem Real.

(; //LEAN:Nat.cast_add_one_pos ;)
Nat__cast_add_one_pos : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero 1)) -> (n : Elem Nat) -> Proof (Lt 0 (plus n 1)).

(; //LEAN:Ne.symm ;)
Ne__symm : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Neq a b)) -> Proof (Neq b a).

(; doc: `-a` computes the negative or opposite of `a`. The meaning of this notation is type-dependent.  Conventions for notations in identifiers:   * The recommended spelling of `-` in identifiers is `neg` (when used as a unary operator). ;)
(; //LEAN:Neg.neg ;)
Neg__neg : (x : Elem X) -> Elem X.

(; doc: Order without maximal elements. Sometimes called cofinal. ;)
(; //LEAN:NoMaxOrder ;)
NoMaxOrder : (X : Set) -> Prop.

(; doc: Type synonym to equip a type with the dual order: `≤` means `≥` and `<` means `>`. `αᵒᵈ` is notation for `OrderDual α`. ;)
(; //LEAN:OrderDual ;)
OrderDual : (X : Set) -> Set.

(; doc: A relation `r` holds pairwise if `r i j` for all `i ≠ j`. ;)
(; //LEAN:Pairwise ;)
Pairwise : (r : (Elem X -> Elem X -> Prop)) -> Prop.

(; doc: The product type, usually written `α × β`. Product types are also called pair or tuple types. Elements of this type are pairs in which the first element is an `α` and the second element is a `β`.  Products nest to the right, so `(x, y, z) : α × β × γ` is equivalent to `(x, (y, z)) : α × (β × γ)`.  Conventions for notations in identifiers:   * The recommended spelling of `×` in identifiers is `Prod`. ;)
(; //LEAN:Prod ;)
Prod : (X : Set) -> (Y : Set) -> Set.

(; doc: The first element of a pair. ;)
(; //LEAN:Prod.fst ;)
Prod__fst : (self : Elem (Prod X Y)) -> Elem X.

(; doc: Constructs a pair. This is usually written `(x, y)` instead of `Prod.mk x y`.  Conventions for notations in identifiers:   * The recommended spelling of `(a, b)` in identifiers is `mk`. ;)
(; //LEAN:Prod.mk ;)
Prod__mk : (fst : Elem X) -> (snd : Elem Y) -> Elem (Prod X Y).

(; doc: The second element of a pair. ;)
(; //LEAN:Prod.snd ;)
Prod__snd : (self : Elem (Prod X Y)) -> Elem Y.

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpace._proof_1 ;)
PseudoEMetricSpace__toPseudoMetricSpace___proof_1 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Leq 0 (ENNReal__toReal (EDist__edist x1 y))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpace._proof_2 ;)
PseudoEMetricSpace__toPseudoMetricSpace___proof_2 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (h : Proof (forall X (x2 => forall X (y1 => Neq (EDist__edist x2 y1) Top__top)))) -> (x1 : Elem X) -> (y : Elem X) -> Proof (Eqt ENNReal (EDist__edist x1 y) (ENNReal__ofReal (ENNReal__toReal (EDist__edist x1 y)))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_1 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_1 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y1 => Leq 0 (dist x2 y1))))) -> (h : Proof (forall X (x1 => forall X (y => Eqt ENNReal (EDist__edist x1 y) (ENNReal__ofReal (dist x1 y)))))) -> (x : Elem X) -> Proof (Eq (dist x x) 0).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_2 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_2 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y2 => Leq 0 (dist x2 y2))))) -> (h : Proof (forall X (x1 => forall X (y1 => Eqt ENNReal (EDist__edist x1 y1) (ENNReal__ofReal (dist x1 y1)))))) -> (x : Elem X) -> (y : Elem X) -> Proof (Eq (dist x y) (dist y x)).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_3 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_3 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y1 => Leq 0 (dist x2 y1))))) -> (h : Proof (forall X (x1 => forall X (y => Eqt ENNReal (EDist__edist x1 y) (ENNReal__ofReal (dist x1 y)))))) -> Proof (Eqt (Filter (Prod X X)) (uniformity X) (iInf (x => iInf (h1 => Filter__principal (Set__ofPred (p => Lt (dist (Prod__fst p) (Prod__snd p)) x)))))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_4 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_4 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y2 => Leq 0 (dist x2 y2))))) -> (h : Proof (forall X (x1 => forall X (y1 => Eqt ENNReal (EDist__edist x1 y1) (ENNReal__ofReal (dist x1 y1)))))) -> (x : Elem X) -> (y : Elem X) -> (z : Elem X) -> Proof (Leq (dist x z) (plus (dist x y) (dist y z))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_5 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_5 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (h : Proof (forall X (x2 => forall X (y => Eqt ENNReal (EDist__edist x2 y) (ENNReal__ofReal (dist x2 y)))))) -> (x : Elem X) -> (x1 : Elem X) -> Proof (Eqt ENNReal (EDist__edist x x1) (ENNReal__ofReal (dist x x1))).

(; //LEAN:PseudoEMetricSpace.toPseudoMetricSpaceOfDist._proof_7 ;)
PseudoEMetricSpace__toPseudoMetricSpaceOfDist___proof_7 : (X : Set) -> (_ : Proof (PseudoEMetricSpace X)) -> (dist : (Elem X -> Elem X -> Real)) -> (dist_nonneg : Proof (forall X (x2 => forall X (y2 => Leq 0 (dist x2 y2))))) -> (h : Proof (forall X (x1 => forall X (y1 => Eqt ENNReal (EDist__edist x1 y1) (ENNReal__ofReal (dist x1 y1)))))) -> Proof (Eqt (powerset (powerset X)) (Filter__sets (Bornology__cobounded X)) (Set__ofPred (s => exists Real (C => forall X (x => if (Membership__mem (Compl__compl s) x) (forall X (y => if (Membership__mem (Compl__compl s) y) (Leq (dist x y) C)))))))).

(; //LEAN:PseudoEMetricSpace.toUniformSpace ;)
PseudoEMetricSpace__toUniformSpace : Proof (UniformSpace X).

(; //LEAN:PseudoMetricSpace.cobounded_sets._autoParam ;)
PseudoMetricSpace__cobounded_sets___autoParam : Elem Lean__Syntax.

(; //LEAN:PseudoMetricSpace.edist_dist._autoParam ;)
PseudoMetricSpace__edist_dist___autoParam : Elem Lean__Syntax.

(; //LEAN:PseudoMetricSpace.replaceBornology._proof_2 ;)
PseudoMetricSpace__replaceBornology___proof_2 : (X : Set) -> (_ : Proof (Bornology X)) -> (m : Proof (PseudoMetricSpace X)) -> (H : Proof (forall (powerset X) (s1 => iff (Bornology__IsBounded s1) (Bornology__IsBounded s1)))) -> Proof (Eqt (powerset (powerset X)) (Filter__sets (Bornology__cobounded X)) (Set__ofPred (s => exists Real (C => forall X (x => if (Membership__mem (Compl__compl s) x) (forall X (y => if (Membership__mem (Compl__compl s) y) (Leq (Dist__dist x y) C)))))))).

(; //LEAN:PseudoMetricSpace.replaceTopology._proof_1 ;)
PseudoMetricSpace__replaceTopology___proof_1 : (Z : Set) -> (_ : Proof (TopologicalSpace Z)) -> (m : Proof (PseudoMetricSpace Z)) -> (H : Proof (Eqt (TopologicalSpace Z) U UniformSpace__toTopologicalSpace)) -> Proof (Eqt (Filter (Prod Z Z)) (uniformity Z) (uniformity Z)).

(; //LEAN:PseudoMetricSpace.replaceUniformity._proof_1 ;)
PseudoMetricSpace__replaceUniformity___proof_1 : (X : Set) -> (_ : Proof (UniformSpace X)) -> (m : Proof (PseudoMetricSpace X)) -> (H : Proof (Eqt (Filter (Prod X X)) (uniformity X) (uniformity X))) -> Proof (Eqt (Filter (Prod X X)) (uniformity X) (iInf (x => iInf (h => Filter__principal (Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) x)))))).

(; //LEAN:PseudoMetricSpace.toBornology ;)
PseudoMetricSpace__toBornology : Proof (Bornology X).

(; //LEAN:PseudoMetricSpace.toDist ;)
PseudoMetricSpace__toDist : Proof (Dist X).

(; //LEAN:PseudoMetricSpace.toUniformSpace ;)
PseudoMetricSpace__toUniformSpace : Proof (UniformSpace X).

(; //LEAN:PseudoMetricSpace.uniformity_dist._autoParam ;)
PseudoMetricSpace__uniformity_dist___autoParam : Elem Lean__Syntax.

(; doc: Canonical homomorphism from `Rat` to a division ring `K`. This is just the bare function in order to aid in creating instances of `DivisionRing`. ;)
(; //LEAN:Rat.cast ;)
Rat__cast : (x1 : Elem Rat) -> Elem K.

(; doc: Reinterpret a real number `r` as a non-negative real number. Returns `0` if `r < 0`. ;)
(; //LEAN:Real.toNNReal ;)
Real__toNNReal : (r : Elem Real) -> Elem NNReal.

(; doc: `a \ b` is the set difference of `a` and `b`, consisting of all elements in `a` that are not in `b`.  Conventions for notations in identifiers:   * The recommended spelling of `\` in identifiers is `sdiff`. ;)
(; //LEAN:SDiff.sdiff ;)
SDiff__sdiff : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: The Cartesian product `s ×ˢ t` is the set of `(a, b)` such that `a ∈ s` and `b ∈ t`. ;)
(; //LEAN:SProd.sprod ;)
SProd__sprod : (x1 : Elem X) -> (x2 : Elem Y) -> Elem x.

(; doc: A `SemilatticeSup` is a join-semilattice, that is, a partial order with a join (a.k.a. lub / least upper bound, sup / supremum) operation `⊔` which is the least element larger than both factors. ;)
(; //LEAN:SemilatticeSup ;)
SemilatticeSup : (X : Set) -> Prop.

(; doc: `Icc a b` is the left-closed right-closed interval $[a, b]$. ;)
(; //LEAN:Set.Icc ;)
Set__Icc : (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: `Ioo a b` is the left-open right-open interval $(a, b)$. ;)
(; //LEAN:Set.Ioo ;)
Set__Ioo : (a : Elem X) -> (b : Elem X) -> Elem (powerset X).

(; doc: The property `s.Nonempty` expresses the fact that the set `s` is not empty. It should be used in theorem assumptions instead of `∃ x, x ∈ s` or `s ≠ ∅` as it gives access to a nice API thanks to the dot notation. ;)
(; //LEAN:Set.Nonempty ;)
Set__Nonempty : (s : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Nonempty.mono ;)
Set__Nonempty__mono : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (ht : Proof (Set__Subset s t)) -> (hs : Proof (Set__Nonempty s)) -> Proof (Set__Nonempty t).

(; doc: The subset relation on sets. `s ⊆ t` means that all elements of `s` are elements of `t`.  Note that you should **not** use this definition directly, but instead write `s ⊆ t`. ;)
(; //LEAN:Set.Subset ;)
Set__Subset : (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> Prop.

(; //LEAN:Set.Subset.rfl ;)
Set__Subset__rfl : (X : Set) -> (s : Elem (powerset X)) -> Proof (Set__Subset s s).

(; //LEAN:Set.disjoint_left ;)
Set__disjoint_left : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Disjoint s t) (forall X (a => if (Membership__mem s a) (not (Membership__mem t a))))).

(; //LEAN:Set.eq_empty_iff_forall_notMem ;)
Set__eq_empty_iff_forall_notMem : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) s EmptyCollection__emptyCollection) (forall X (x => not (Membership__mem s x)))).

(; //LEAN:Set.eq_univ_iff_forall ;)
Set__eq_univ_iff_forall : (X : Set) -> (s : Elem (powerset X)) -> Proof (iff (Eqt (powerset X) s Set__univ) (forall X (x => Membership__mem s x))).

(; //LEAN:Set.eq_univ_of_forall ;)
Set__eq_univ_of_forall : (X : Set) -> (s : Elem (powerset X)) -> (h : Proof (forall X (x => Membership__mem s x))) -> Proof (Eqt (powerset X) s Set__univ).

(; //LEAN:Set.exists_range_iff ;)
Set__exists_range_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> X)) -> (p : (Elem X -> Prop)) -> Proof (iff (exists X (a => and (Membership__mem (Set__range f) a) (p a))) (exists I (i => p (f i)))).

(; //LEAN:Set.ext ;)
Set__ext : (X : Set) -> (a : Elem (powerset X)) -> (b : Elem (powerset X)) -> (h : Proof (forall X (x => iff (Membership__mem a x) (Membership__mem b x)))) -> Proof (Eqt (powerset X) a b).

(; doc: Indexed intersection of a family of sets ;)
(; //LEAN:Set.iInter ;)
Set__iInter : (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; doc: Indexed union of a family of sets ;)
(; //LEAN:Set.iUnion ;)
Set__iUnion : (s : (Elem I -> powerset X)) -> Elem (powerset X).

(; //LEAN:Set.iUnion_eq_univ_iff ;)
Set__iUnion_eq_univ_iff : (X : Set) -> (I : Set) -> (f : (Elem I -> powerset X)) -> Proof (iff (Eqt (powerset X) (Set__iUnion (i => f i)) Set__univ) (forall X (x => exists I (i1 => Membership__mem (f i1) x)))).

(; //LEAN:Set.inter_subset_inter ;)
Set__inter_subset_inter : (X : Set) -> (x : Elem (powerset X)) -> (x1 : Elem (powerset X)) -> (x2 : Elem (powerset X)) -> (x3 : Elem (powerset X)) -> (h : Proof (Set__Subset x x2)) -> (h1 : Proof (Set__Subset x1 x3)) -> Proof (Set__Subset (Inter__inter x x1) (Inter__inter x2 x3)).

(; //LEAN:Set.mem_Ioo ;)
Set__mem_Ioo : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (x1 : Elem X) -> Proof (iff (Membership__mem (Set__Ioo a b) x1) (and (Lt a x1) (Lt x1 b))).

(; doc: Turn a predicate `p : α → Prop` into a set, also written as `{x | p x}` ;)
(; //LEAN:Set.ofPred ;)
Set__ofPred : (Mem : (Elem X -> Prop)) -> Elem (powerset X).

(; doc: Range of a function.  This function is more flexible than `f '' univ`, as the image requires that the domain is in Type and not an arbitrary Sort. ;)
(; //LEAN:Set.range ;)
Set__range : (f : (Elem I -> X)) -> Elem (powerset X).

(; doc: The universal set on a type `α` is the set containing all elements of `α`.  This is conceptually the "same as" `α` (in set theory, it is actually the same), but type theory makes the distinction that `α` is a type while `Set.univ` is a term of type `Set α`. `Set.univ` can itself be coerced to a type `↥Set.univ` which is in bijection with (but distinct from) `α`. ;)
(; //LEAN:Set.univ ;)
Set__univ : Elem (powerset X).

(; doc: `singleton x` is a collection with the single element `x` (notation: `{x}`).  Conventions for notations in identifiers:   * The recommended spelling of `{x}` in identifiers is `singleton`. ;)
(; //LEAN:Singleton.singleton ;)
Singleton__singleton : (x1 : Elem x) -> Elem Y.

(; doc: A _subsingleton_ is a type with at most one element. It is either empty or has a unique element.  All propositions are subsingletons because of proof irrelevance: false propositions are empty, and all proofs of a true proposition are equal to one another. Some non-propositional types are also subsingletons. ;)
(; //LEAN:Subsingleton ;)
Subsingleton : (X : Set) -> Prop.

(; doc: If a type is a subsingleton, then all of its elements are equal. ;)
(; //LEAN:Subsingleton.elim ;)
Subsingleton__elim : (X : Set) -> (_ : Proof (Subsingleton X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt X a b).

(; doc: The top (`⊤`, `\top`) element  Conventions for notations in identifiers:   * The recommended spelling of `⊤` in identifiers is `top`. ;)
(; //LEAN:Top.top ;)
Top__top : Elem X.

(; doc: A topology on `X`. ;)
(; //LEAN:TopologicalSpace ;)
TopologicalSpace : (X : Set) -> Prop.

(; doc: Compose two proofs by transitivity, generalized over the relations involved. ;)
(; //LEAN:Trans.trans ;)
Trans__trans : (x : Elem (r a b)) -> (x1 : Elem (s b c)) -> Elem (t a c).

(; doc: `True` is a proposition and has only an introduction rule, `True.intro : True`. In other words, `True` is simply true, and has a canonical proof, `True.intro` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:True ;)
True : Prop.

(; //LEAN:Uniform.tendsto_congr ;)
Uniform__tendsto_congr : (X : Set) -> (Y : Set) -> (_ : Proof (UniformSpace Y)) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (l : Elem (Filter X)) -> (b : Elem Y) -> (hfg : Proof (Filter__Tendsto (x1 => Prod__mk (f x1) (g x1)) l (uniformity Y))) -> Proof (iff (Filter__Tendsto f l (nhds b)) (Filter__Tendsto g l (nhds b))).

(; doc: A function `f : α → β` is *uniformly continuous* if `(f x, f y)` tends to the diagonal as `(x, y)` tends to the diagonal. In other words, if `x` is sufficiently close to `y`, then `f x` is close to `f y` no matter where `x` and `y` are located in `α`. ;)
(; //LEAN:UniformContinuous ;)
UniformContinuous : (f : (Elem X -> Y)) -> Prop.

(; doc: A function `f : α → β` is *uniformly continuous* on `s : Set α` if `(f x, f y)` tends to the diagonal as `(x, y)` tends to the diagonal while remaining in `s ×ˢ s`. In other words, if `x` is sufficiently close to `y`, then `f x` is close to `f y` no matter where `x` and `y` are located in `s`. ;)
(; //LEAN:UniformContinuousOn ;)
UniformContinuousOn : (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Prop.

(; doc: A uniform space is a generalization of the "uniform" topological aspects of a metric space. It consists of a filter on `α × α` called the "uniformity", which satisfies properties analogous to the reflexivity, symmetry, and triangle properties of a metric.  A metric space has a natural uniformity, and a uniform space has a natural topology. A topological group also has a natural uniformity, even when it is not metrizable. ;)
(; //LEAN:UniformSpace ;)
UniformSpace : (X : Set) -> Prop.

(; doc: The ball around `(x : β)` with respect to `(V : Set (β × β))`. Intended to be used for `V ∈ 𝓤 β`, but this is not needed for the definition. Recovers the notions of metric space ball when `V = {p | dist p.1 p.2 < r }`. ;)
(; //LEAN:UniformSpace.ball ;)
UniformSpace__ball : (x : Elem Y) -> (V : Elem (powerset (Prod Y Y))) -> Elem (powerset Y).

(; //LEAN:UniformSpace.ext ;)
UniformSpace__ext : (X : Set) -> (x : Proof (UniformSpace X)) -> (x1 : Proof (UniformSpace X)) -> (h : Proof (Eqt (Filter (Prod X X)) (uniformity X) (uniformity X))) -> Proof (Eqt (UniformSpace X) x x1).

(; doc: Define a `UniformSpace` using a "distance" function. The function can be, e.g., the distance in a (usual or extended) metric space or an absolute value on a ring. ;)
(; //LEAN:UniformSpace.ofFun ;)
UniformSpace__ofFun : (d : (Elem X -> Elem X -> M)) -> (refl : Proof (forall X (x7 => Eqt M (d x7 x7) 0))) -> (symm : Proof (forall X (x6 => forall X (y2 => Eqt M (d x6 y2) (d y2 x6))))) -> (triangle : Proof (forall X (x5 => forall X (y1 => forall X (z => Leq (d x5 z) (plus (d x5 y1) (d y1 z))))))) -> (half : Proof (forall M (x2 => if (Gt x2 0) (exists M (x3 => and (Gt x3 0) (forall M (x4 => if (Lt x4 x3) (forall M (y => if (Lt y x3) (Lt (plus x4 y) x2)))))))))) -> Proof (UniformSpace X).

(; //LEAN:UniformSpace.toTopologicalSpace ;)
UniformSpace__toTopologicalSpace : Proof (TopologicalSpace X).

(; //LEAN:UniformSpace.toTopologicalSpace_bot ;)
UniformSpace__toTopologicalSpace_bot : (X : Set) -> Proof (Eqt (TopologicalSpace X) UniformSpace__toTopologicalSpace Bot__bot).

(; doc: `a ∪ b` is the union of `a` and `b`.  Conventions for notations in identifiers:   * The recommended spelling of `∪` in identifiers is `union`. ;)
(; //LEAN:Union.union ;)
Union__union : (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; doc: `abs a`, denoted `|a|`, is the absolute value of `a` ;)
(; //LEAN:abs ;)
abs : (a : Elem X) -> Elem X.

(; //LEAN:abs_of_nonneg ;)
abs_of_nonneg : (X : Set) -> (_ : Proof (Lattice X)) -> (_ : Proof (AddGroup X)) -> (a : Elem X) -> (h1 : Proof (Leq 0 a)) -> Proof (Eqt X (abs a) a).

(; //LEAN:abs_sub_le_iff ;)
abs_sub_le_iff : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (_ : Proof (LinearOrder G)) -> (_ : Proof (IsOrderedAddMonoid G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Leq (abs (minus a b)) c) (and (Leq (minus a b) c) (Leq (minus b a) c))).

(; //LEAN:abs_sub_lt_iff ;)
abs_sub_lt_iff : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (_ : Proof (LinearOrder G)) -> (_ : Proof (IsOrderedAddMonoid G)) -> (a : Elem G) -> (b : Elem G) -> (c : Elem G) -> Proof (iff (Lt (abs (minus a b)) c) (and (Lt (minus a b) c) (Lt (minus b a) c))).

(; doc: Anything follows from two contradictory hypotheses. Example: ``` example (hp : p) (hnp : ¬p) : q := absurd hp hnp ``` For more information: [Propositional Logic](https://lean-lang.org/theorem_proving_in_lean4/propositions_and_proofs.html#propositional-logic) ;)
(; //LEAN:absurd ;)
absurd : (h : Proof a) -> (h1 : Proof (not a)) -> Elem b.

(; //LEAN:add_comm ;)
add_comm : (G : Set) -> (_ : Proof (AddCommMagma G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a b) (plus b a)).

(; //LEAN:add_le_add ;)
add_le_add : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h2 : Proof (Leq a b)) -> (h3 : Proof (Leq c d)) -> Proof (Leq (plus a c) (plus b d)).

(; //LEAN:add_lt_add_left ;)
add_lt_add_left : (X : Set) -> (b : Elem X) -> (c : Elem X) -> (_ : Proof (LT X)) -> (bc : Proof (Lt b c)) -> (a : Elem X) -> Proof (Lt (plus b a) (plus c a)).

(; //LEAN:add_lt_add_of_le_of_lt ;)
add_lt_add_of_le_of_lt : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h2 : Proof (Leq a b)) -> (h3 : Proof (Lt c d)) -> Proof (Lt (plus a c) (plus b d)).

(; //LEAN:add_lt_add_of_lt_of_le ;)
add_lt_add_of_lt_of_le : (X : Set) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (d : Elem X) -> (_ : Proof (Preorder X)) -> (h2 : Proof (Lt a b)) -> (h3 : Proof (Leq c d)) -> Proof (Lt (plus a c) (plus b d)).

(; //LEAN:add_sub_cancel ;)
add_sub_cancel : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (plus a (minus b a)) b).

(; doc: Gadget for automatic parameter support. This is similar to the `optParam` gadget, but it uses the given tactic. Like `optParam`, this gadget only affects elaboration. For example, the tactic will *not* be invoked during type class resolution. ;)
(; //LEAN:autoParam ;)
autoParam : (X : Set) -> (tactic : Elem Lean__Syntax) -> Set.

(; doc: The closure of `s` is the smallest closed set containing `s`. ;)
(; //LEAN:closure ;)
closure : (s : Elem (powerset X)) -> Elem (powerset X).

(; doc: Congruence in the function argument: if `a₁ = a₂` then `f a₁ = f a₂` for any (nondependent) function `f`. This is more powerful than it might look at first, because you can also use a lambda expression for `f` to prove that `<something containing a₁> = <something containing a₂>`. This function is used internally by tactics like `congr` and `simp` to apply equalities inside subterms.  For more information: [Equality](https://lean-lang.org/theorem_proving_in_lean4/quantifiers_and_equality.html#equality) ;)
(; //LEAN:congrArg ;)
congrArg : (X : Set) -> (Y : Set) -> (x : Elem X) -> (x1 : Elem X) -> (f : (Elem X -> Y)) -> (h : Proof (Eqt X x x1)) -> Proof (Eqt Y (f x) (f x1)).

(; doc: Similar to `congrFun` but `β` does not depend on `α`. ;)
(; //LEAN:congrFun' ;)
congrFun' : (X : Set) -> (Y : Set) -> (f : (Elem X -> Y)) -> (g : (Elem X -> Y)) -> (h : Proof (Eqt (Elem X -> Y) f g)) -> (a : Elem X) -> Proof (Eqt Y (f a) (g a)).

(; //LEAN:continuous_iff_continuousAt ;)
continuous_iff_continuousAt : (X : Set) -> (Y : Set) -> (_ : Proof (TopologicalSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (Continuous f) (forall X (x2 => ContinuousAt f x2))).

(; //LEAN:div_pos ;)
div_pos : (X : Set) -> (_ : Proof (GroupWithZero X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> (ha : Proof (Lt 0 a)) -> (hb : Proof (Lt 0 b)) -> Proof (Lt 0 (div a b)).

(; //LEAN:exists_nat_ge ;)
exists_nat_ge : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (PartialOrder R)) -> (_ : Proof (IsOrderedRing R)) -> (_ : Proof (Archimedean R)) -> (x2 : Elem R) -> Proof (exists Nat (n => Leq x2 n)).

(; //LEAN:exists_nat_gt ;)
exists_nat_gt : (R : Set) -> (_ : Proof (Semiring R)) -> (_ : Proof (PartialOrder R)) -> (_ : Proof (IsStrictOrderedRing R)) -> (_ : Proof (Archimedean R)) -> (x2 : Elem R) -> Proof (exists Nat (n => Lt x2 n)).

(; //LEAN:exists_nat_one_div_lt ;)
exists_nat_one_div_lt : (K : Set) -> (_ : Proof (Semifield K)) -> (_ : Proof (LinearOrder K)) -> (_ : Proof (IsStrictOrderedRing K)) -> (_ : Proof (Archimedean K)) -> (x2 : Elem K) -> (h2 : Proof (Lt 0 x2)) -> Proof (exists Nat (n => Lt (div 1 (plus n 1)) x2)).

(; //LEAN:forall_congr' ;)
forall_congr' : (X : Set) -> (p : (Elem X -> Prop)) -> (q : (Elem X -> Prop)) -> (h : Proof (forall X (a2 => iff (p a2) (q a2)))) -> Proof (iff (forall X (a => p a)) (forall X (a1 => q a1))).

(; doc: **Alias** of the reverse direction of `half_lt_self_iff`. ;)
(; //LEAN:half_lt_self ;)
half_lt_self : (X : Set) -> (_ : Proof (Semifield X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (_ : Proof (IsStrictOrderedRing X)) -> (h2 : Proof (Lt 0 a)) -> Proof (Lt (div a 2) a).

(; //LEAN:half_pos ;)
half_pos : (X : Set) -> (_ : Proof (Semifield X)) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (_ : Proof (IsStrictOrderedRing X)) -> (h2 : Proof (Lt 0 a)) -> Proof (Lt 0 (div a 2)).

(; doc: Indexed infimum ;)
(; //LEAN:iInf ;)
iInf : (s : (Elem I -> X)) -> Elem X.

(; doc: The identity function. `id` takes an implicit argument `α : Sort u` (a type in any universe), and an argument `a : α`, and returns `a`.  Although this may look like a useless function, one application of the identity function is to explicitly put a type on an expression. If `e` has type `T`, and `T'` is definitionally equal to `T`, then `@id T' e` typechecks, and Lean knows that this expression has type `T'` rather than `T`. This can make a difference for typeclass inference, since `T` and `T'` may have different typeclass instances on them. `show T' from e` is sugar for an `@id T' e` expression. ;)
(; //LEAN:id ;)
id : (a : Elem X) -> Elem X.

(; doc: The interior of a set `s` is the largest open subset of `s`. ;)
(; //LEAN:interior ;)
interior : (s : Elem (powerset X)) -> Elem (powerset X).

(; //LEAN:interior_maximal ;)
interior_maximal : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (h : Proof (Set__Subset t s)) -> (h1 : Proof (IsOpen t)) -> Proof (Set__Subset t (interior s)).

(; //LEAN:le_iff_lt_or_eq ;)
le_iff_lt_or_eq : (X : Set) -> (_ : Proof (PartialOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Leq a b) (or (Lt a b) (Eqt X a b))).

(; //LEAN:le_of_eq ;)
le_of_eq : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Eqt X a b)) -> Proof (Leq a b).

(; //LEAN:le_of_lt ;)
le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (hab : Proof (Lt a b)) -> Proof (Leq a b).

(; doc: The relation `≤` on a preorder is reflexive. ;)
(; //LEAN:le_refl ;)
le_refl : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> Proof (Leq a a).

(; doc: The relation `≤` on a preorder is transitive. ;)
(; //LEAN:le_trans ;)
le_trans : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Leq a b)) -> (h1 : Proof (Leq b c)) -> Proof (Leq a c).

(; //LEAN:lt_add_one ;)
lt_add_one : (X : Set) -> (_ : Proof (AddZeroClass X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero 1)) -> (a : Elem X) -> Proof (Lt a (plus a 1)).

(; //LEAN:lt_min ;)
lt_min : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (h : Proof (Lt a b)) -> (h1 : Proof (Lt a c)) -> Proof (Lt a (Min__min b c)).

(; //LEAN:lt_of_le_of_lt ;)
lt_of_le_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Leq a b)) -> (hbc : Proof (Lt b c)) -> Proof (Lt a c).

(; //LEAN:lt_of_lt_of_le ;)
lt_of_lt_of_le : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> (hab : Proof (Lt a b)) -> (hbc : Proof (Leq b c)) -> Proof (Lt a c).

(; //LEAN:min_le_left ;)
min_le_left : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Leq (Min__min a b) a).

(; //LEAN:min_lt_iff ;)
min_lt_iff : (X : Set) -> (_ : Proof (LinearOrder X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (Min__min a b) c) (or (Lt a c) (Lt b c))).

(; //LEAN:ne_of_lt ;)
ne_of_lt : (X : Set) -> (_ : Proof (Preorder X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Lt a b)) -> Proof (Neq a b).

(; //LEAN:ne_of_mem_of_not_mem ;)
ne_of_mem_of_not_mem : (X : Set) -> (Y : Set) -> (_ : Proof (Membership X Y)) -> (s : Elem Y) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (Membership__mem s a)) -> (h1 : Proof (not (Membership__mem s b))) -> Proof (Neq a b).

(; doc: A set is called a neighborhood of `x` if it contains an open set around `x`. The set of all neighborhoods of `x` forms a filter, the neighborhood filter at `x`, is here defined as the infimum over the principal filters of all open sets containing `x`.  [Wikidata Q3275652](https://www.wikidata.org/wiki/Q3275652) ;)
(; //LEAN:nhds ;)
nhds : (x1 : Elem X) -> Elem (Filter X).

(; doc: The "neighborhood within" filter. Elements of `𝓝[s] x` are sets containing the intersection of `s` and a neighborhood of `x`. ;)
(; //LEAN:nhdsWithin ;)
nhdsWithin : (x1 : Elem X) -> (s : Elem (powerset X)) -> Elem (Filter X).

(; //LEAN:nhdsWithin_hasBasis ;)
nhdsWithin_hasBasis : (X : Set) -> (_ : Proof (TopologicalSpace X)) -> (I : Set) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> powerset X)) -> (a : Elem X) -> (h : Proof (Filter__HasBasis (nhds a) p s)) -> (t : Elem (powerset X)) -> Proof (Filter__HasBasis (nhdsWithin a t) p (i => Inter__inter (s i) t)).

(; //LEAN:nhds_basis_uniformity ;)
nhds_basis_uniformity : (X : Set) -> (I : Set) -> (_ : Proof (UniformSpace X)) -> (p : (Elem I -> Prop)) -> (s : (Elem I -> SetRel X X)) -> (h : Proof (Filter__HasBasis (uniformity X) p s)) -> (x1 : Elem X) -> Proof (Filter__HasBasis (nhds x1) p (i => Set__ofPred (y => Membership__mem (s i) (Prod__mk y x1)))).

(; doc: The [axiom](https://lean-lang.org/doc/reference/4.36.0-rc1/find/?domain=Verso.Genre.Manual.section&name=axioms) of **propositional extensionality**. It asserts that if propositions `a` and `b` are logically equivalent (that is, if `a` can be proved from `b` and vice versa), then `a` and `b` are *equal*, meaning `a` can be replaced with `b` in all contexts.  The standard logical connectives provably respect propositional extensionality. However, an axiom is needed for higher order expressions like `P a` where `P : Prop → Prop` is unknown, as well as for equality. Propositional extensionality is intuitionistically valid. ;)
(; //LEAN:propext ;)
propext : (a : Prop) -> (b : Prop) -> (h : Proof (iff a b)) -> Proof (Eqt Prop a b).

(; doc: `rfl : a = a` is the unique constructor of the equality type. This is the same as `Eq.refl` except that it takes `a` implicitly instead of explicitly.  This is a more powerful theorem than it may appear at first, because although the statement of the theorem is `a = a`, Lean will allow anything that is definitionally equal to that type. So, for instance, `2 + 2 = 4` is proven in Lean by `rfl`, because both sides are the same up to definitional equality. ;)
(; //LEAN:rfl ;)
rfl : (X : Set) -> (a : Elem X) -> Proof (Eqt X a a).

(; //LEAN:sub_le_iff_le_add ;)
sub_le_iff_le_add : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LE X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Leq (minus a c) b) (Leq a (plus b c))).

(; //LEAN:sub_lt_comm ;)
sub_lt_comm : (X : Set) -> (_ : Proof (AddCommGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (minus a b) c) (Lt (minus a c) b)).

(; //LEAN:sub_lt_iff_lt_add' ;)
sub_lt_iff_lt_add' : (X : Set) -> (_ : Proof (AddCommGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> (c : Elem X) -> Proof (iff (Lt (minus a b) c) (Lt a (plus b c))).

(; //LEAN:sub_pos ;)
sub_pos : (X : Set) -> (_ : Proof (AddGroup X)) -> (_ : Proof (LT X)) -> (a : Elem X) -> (b : Elem X) -> Proof (iff (Lt 0 (minus a b)) (Lt b a)).

(; //LEAN:sub_self_div_two ;)
sub_self_div_two : (X : Set) -> (_ : Proof (Field X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (IsStrictOrderedRing X)) -> (a : Elem X) -> Proof (Eqt X (minus a (div a 2)) (div a 2)).

(; //LEAN:sub_sub_self ;)
sub_sub_self : (G : Set) -> (_ : Proof (AddCommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (minus a (minus a b)) b).

(; doc: `True` is true, and `True.intro` (or more commonly, `trivial`) is the proof. ;)
(; //LEAN:trivial ;)
trivial : Proof True.

(; doc: The uniformity is a filter on α × α (inferred from an ambient uniform space structure on α). ;)
(; //LEAN:uniformity ;)
uniformity : (X : Set) -> Elem (Filter (Prod X X)).

(; doc: See `zero_lt_one'` for a version with the type explicit. ;)
(; //LEAN:zero_lt_one ;)
zero_lt_one : (X : Set) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (NeZero 1)) -> Proof (Lt 0 1).

