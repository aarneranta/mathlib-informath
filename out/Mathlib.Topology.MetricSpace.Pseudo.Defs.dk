def Metric__mem_nhds_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> Proof (iff (Membership__mem (nhds x1) s) (exists Real (x2 => and (Gt x2 0) (Set__Subset (Metric__ball x1 x2) s)))) :=
  X => x => x1 => s => Filter__HasBasis__mem_iff X Real (nhds x1) (x2 => Lt 0 x2) (Metric__ball x1) s (Metric__nhds_basis_ball X x1).

(; //LEAN:Metric.eventually_nhds_iff ;)
def Metric__eventually_nhds_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (p : (Elem X -> Prop)) -> Proof (iff (Filter__Eventually (y => p y) (nhds x1)) (exists Real (x2 => and (Gt x2 0) (forall X (y1 => if (Lt (Dist__dist y1 x1) x2) (p y1)))))) :=
  X => x => x1 => p => Metric__mem_nhds_iff X x1 (Set__ofPred (x2 => p x2)).

(; //LEAN:Metric.eventually_nhds_iff_ball ;)
def Metric__eventually_nhds_iff_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (p : (Elem X -> Prop)) -> Proof (iff (Filter__Eventually (y => p y) (nhds x1)) (exists Real (x2 => and (Gt x2 0) (forall X (y1 => if (Membership__mem (Metric__ball x1 x2) y1) (p y1)))))) :=
  X => x => x1 => p => Metric__mem_nhds_iff X x1 (Set__ofPred (x2 => p x2)).

(; //LEAN:Metric.eventually_nhds_prod_iff ;)
Metric__eventually_nhds_prod_iff : (X : Set) -> (I : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : Elem (Filter I)) -> (x1 : Elem X) -> (p : (Elem (Prod X I) -> Prop)) -> Proof (iff (Filter__Eventually (x2 => p x2) (SProd__sprod (nhds x1) f)) (exists Real (x3 => and (Gt x3 0) (exists (Elem I -> Prop) (pa => and (Filter__Eventually (i => pa i) f) (forall X (x4 => if (Lt (Dist__dist x4 x1) x3) (forall I (i1 => if (pa i1) (p (Prod__mk x4 i1))))))))))).

(; //LEAN:Metric.eventually_prod_nhds_iff ;)
Metric__eventually_prod_nhds_iff : (X : Set) -> (I : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : Elem (Filter I)) -> (x1 : Elem X) -> (p : (Elem (Prod I X) -> Prop)) -> Proof (iff (Filter__Eventually (x2 => p x2) (SProd__sprod f (nhds x1))) (exists (Elem I -> Prop) (pa => and (Filter__Eventually (i => pa i) f) (exists Real (x3 => and (Gt x3 0) (forall I (i1 => if (pa i1) (forall X (x4 => if (Lt (Dist__dist x4 x1) x3) (p (Prod__mk i1 x4))))))))))).

(; //LEAN:Metric.nhds_basis_closedBall ;)
def Metric__nhds_basis_closedBall : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> Proof (Filter__HasBasis (nhds x1) (x2 => Lt 0 x2) (Metric__closedBall x1)) :=
  X => x => x1 => nhds_basis_uniformity X Real (x2 => Lt 0 x2) (x3 => Set__ofPred (p => Leq (Dist__dist (Prod__fst p) (Prod__snd p)) x3)) (Metric__uniformity_basis_dist_le X) x1.

