def Metric__nhds_basis_ball_pow : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (r : Elem Real) -> (h0 : Proof (Lt 0 r)) -> (h1 : Proof (Lt r 1)) -> Proof (Filter__HasBasis (nhds x1) (x2 => True) (n => Metric__ball x1 (pow r n))) :=
  X => x => x1 => r => h0 => h1 => nhds_basis_uniformity X Nat (x2 => True) (n => Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) (pow r n))) (Metric__uniformity_basis_dist_pow X r h0 h1) x1.

