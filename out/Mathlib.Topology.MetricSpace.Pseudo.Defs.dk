def Metric__nhds_basis_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> Proof (Filter__HasBasis (nhds x1) (x2 => Lt 0 x2) (Metric__ball x1)) :=
