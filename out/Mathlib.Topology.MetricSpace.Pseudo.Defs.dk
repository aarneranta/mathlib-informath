def Metric__nhds_basis_closedBall_inv_nat_succ : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> Proof (Filter__HasBasis (nhds x1) (x2 => True) (n => Metric__closedBall x1 (div 1 (plus n 1)))) :=
