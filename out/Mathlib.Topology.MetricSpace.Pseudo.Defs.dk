  X => x => x1 => r => h0 => h1 => nhds_basis_uniformity X Nat (x2 => True) (n => Set__ofPred (p => Leq (Dist__dist (Prod__fst p) (Prod__snd p)) (pow r n))) (Metric__uniformity_basis_dist_le_pow X r h0 h1) x1.

(; //LEAN:Metric.isOpen_iff ;)
Metric__isOpen_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> Proof (iff (IsOpen s) (forall X (x1 => if (Membership__mem s x1) (exists Real (x2 => and (Gt x2 0) (Set__Subset (Metric__ball x1 x2) s)))))).

(; //LEAN:Metric.isOpen_ball ;)
def Metric__isOpen_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (x2 : Elem Real) -> Proof (IsOpen (Metric__ball x1 x2)) :=
  X => x => x1 => x2 => iffEr (IsOpen (Metric__ball x1 x2)) (forall X (x3 => if (Membership__mem (Metric__ball x1 x2) x3) (exists Real (x4 => and (Gt x4 0) (Set__Subset (Metric__ball x3 x4) (Metric__ball x1 x2)))))) (Metric__isOpen_iff X (Metric__ball x1 x2)) (x5 => Metric__exists_ball_subset_ball X x1 x5 x2).

(; //LEAN:Metric.ball_mem_nhds ;)
def Metric__ball_mem_nhds : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (x2 : Elem Real) -> (h : Proof (Lt 0 x2)) -> Proof (Membership__mem (nhds x1) (Metric__ball x1 x2)) :=
  X => x => x1 => x2 => h => IsOpen__mem_nhds X x1 (Metric__ball x1 x2) (Metric__isOpen_ball X x1 x2) (Metric__mem_ball_self X x1 x2 h).

(; //LEAN:Metric.closedBall_mem_nhds ;)
def Metric__closedBall_mem_nhds : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (x2 : Elem Real) -> (h : Proof (Lt 0 x2)) -> Proof (Membership__mem (nhds x1) (Metric__closedBall x1 x2)) :=
  X => x => x1 => x2 => h => Filter__mem_of_superset X (nhds x1) (Metric__ball x1 x2) (Metric__closedBall x1 x2) (Metric__ball_mem_nhds X x1 x2 h) (Metric__ball_subset_closedBall X x1 x2).

(; //LEAN:Metric.closedBall_mem_nhds_of_mem ;)
def Metric__closedBall_mem_nhds_of_mem : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (c : Elem X) -> (x2 : Elem Real) -> (h : Proof (Membership__mem (Metric__ball c x2) x1)) -> Proof (Membership__mem (nhds x1) (Metric__closedBall c x2)) :=
  X => x => x1 => c => x2 => h => Filter__mem_of_superset X (nhds x1) (Metric__ball c x2) (Metric__closedBall c x2) (IsOpen__mem_nhds X x1 (Metric__ball c x2) (Metric__isOpen_ball X c x2) h) (Metric__ball_subset_closedBall X c x2).

(; //LEAN:Metric.nhdsWithin_basis_ball ;)
