Metric__tendsto_atTop' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (SemilatticeSup Y)) -> (_ : Proof (NoMaxOrder Y)) -> (u : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Filter__Tendsto Y X u (Filter__atTop Y) (nhds X a)) (forall Real (x2 => if (Gt x2 0) (exists Y (N => forall Y (n => if (Gt n N) (Lt (Dist__dist X (u n) a) x2))))))).

