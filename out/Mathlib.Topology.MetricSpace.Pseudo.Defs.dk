Metric__continuousOn_iff' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem Y -> X)) -> (s : Elem (powerset Y)) -> Proof (iff (ContinuousOn Y X f s) (forall Y (b => if (Membership__mem Y (powerset Y) s b) (forall Real (x2 => if (Gt x2 0) (Filter__Eventually Y (x3 => Lt (Dist__dist X (f x3) (f b)) x2) (nhdsWithin Y b s))))))).

