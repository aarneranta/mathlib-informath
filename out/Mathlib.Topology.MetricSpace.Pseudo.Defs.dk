(; //LEAN:Metric.isOpen_ball ;)
def Metric__isOpen_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (x2 : Elem Real) -> Proof (IsOpen X (Metric__ball X x1 x2)) :=
  X => x => x1 => x2 => iffEr (IsOpen X (Metric__ball X x1 x2)) (forall X (x3 => if (Membership__mem X (powerset X) (Metric__ball X x1 x2) x3) (exists Real (x4 => and (Gt x4 0) (Set__Subset X (Metric__ball X x3 x4) (Metric__ball X x1 x2)))))) (Metric__isOpen_iff X (Metric__ball X x1 x2)) (x5 => Metric__exists_ball_subset_ball X x1 x5 x2).

