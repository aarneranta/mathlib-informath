Metric__continuousOn_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Proof (iff (ContinuousOn X Y f s) (forall X (b => if (Membership__mem X (powerset X) s b) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => if (Membership__mem X (powerset X) s a) (if (Lt (Dist__dist X a b) x3) (Lt (Dist__dist Y (f a) (f b)) x2))))))))))).

(; //LEAN:Metric.continuous_iff ;)
def Metric__continuous_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (Continuous X Y f) (forall X (b => forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => if (Lt (Dist__dist X a b) x3) (Lt (Dist__dist Y (f a) (f b)) x2))))))))) :=
  X => Y => x => x1 => f => Iff__trans (Continuous X Y f) (forall X (x2 => ContinuousAt X Y f x2)) (forall X (b => forall Real (x3 => if (Gt x3 0) (exists Real (x4 => and (Gt x4 0) (forall X (a => if (Lt (Dist__dist X a b) x4) (Lt (Dist__dist Y (f a) (f b)) x3)))))))) (continuous_iff_continuousAt X Y f) (forall_congr' X (ContinuousAt X Y f) (b1 => forall Real (x5 => if (Gt x5 0) (exists Real (x6 => and (Gt x6 0) (forall X (a1 => if (Lt (Dist__dist X a1 b1) x6) (Lt (Dist__dist Y (f a1) (f b1)) x5))))))) (forallI X (x7 => iff (Filter__Tendsto X Y f (nhds X x7) (nhds Y (f x7))) (forall Real (x8 => if (Gt x8 0) (exists Real (x9 => and (Gt x9 0) (forall X (x10 => if (Lt (Dist__dist X x10 x7) x9) (Lt (Dist__dist Y (f x10) (f x7)) x8)))))))) (x7 => Metric__tendsto_nhds_nhds X Y f x7 (f x7)))).

