def DiscreteTopology__of_forall_le_dist : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (r : Elem Real) -> (hpos : Proof (Lt 0 r)) -> (hr : Proof (Pairwise (x1 => x2 => Leq r (Dist__dist x1 x2)))) -> Proof (DiscreteTopology X) :=
