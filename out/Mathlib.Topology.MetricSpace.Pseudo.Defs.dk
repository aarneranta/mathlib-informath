  X => x => x1 => h => iffEr (Membership__mem (uniformity X) (Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) x1))) (exists Real (x2 => and (Gt x2 0) (forall X (a => forall X (b => if (Lt (Dist__dist a b) x2) (Membership__mem (Set__ofPred (p1 => Lt (Dist__dist (Prod__fst p1) (Prod__snd p1)) x1)) (Prod__mk a b))))))) (Metric__mem_uniformity_dist X (Set__ofPred (p2 => Lt (Dist__dist (Prod__fst p2) (Prod__snd p2)) x1))) (existsI Real (x3 => and (Gt x3 0) (forall X (a1 => forall X (b1 => if (Lt (Dist__dist a1 b1) x3) (Membership__mem (Set__ofPred (p3 => Lt (Dist__dist (Prod__fst p3) (Prod__snd p3)) x1)) (Prod__mk a1 b1)))))) x1 (andI (Gt x1 0) (forall X (a2 => forall X (b2 => if (Lt (Dist__dist a2 b2) x1) (Membership__mem (Set__ofPred (p4 => Lt (Dist__dist (Prod__fst p4) (Prod__snd p4)) x1)) (Prod__mk a2 b2))))) h (x4 => forallI X (x5 => if (Lt (Dist__dist x4 x5) x1) (Lt (Dist__dist x4 x5) x1)) (x5 => id)))).

(; //LEAN:Metric.uniformContinuous_iff ;)
def Metric__uniformContinuous_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (UniformContinuous f) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => forall X (b => if (Lt (Dist__dist a b) x3) (Lt (Dist__dist (f a) (f b)) x2))))))))) :=
  X => Y => x => x1 => f => Filter__HasBasis__uniformContinuous_iff X Y Real Real (x2 => Lt 0 x2) (x3 => Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) x3)) (Metric__uniformity_basis_dist X) (x4 => Lt 0 x4) (x5 => Set__ofPred (p1 => Lt (Dist__dist (Prod__fst p1) (Prod__snd p1)) x5)) (Metric__uniformity_basis_dist Y) f.

(; //LEAN:Metric.uniformContinuousOn_iff ;)
def Metric__uniformContinuousOn_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Proof (iff (UniformContinuousOn f s) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem s x4) (forall X (y => if (Membership__mem s y) (if (Lt (Dist__dist x4 y) x3) (Lt (Dist__dist (f x4) (f y)) x2))))))))))) :=
  X => Y => x => x1 => f => s => Filter__HasBasis__uniformContinuousOn_iff X Y Real Real (x2 => Lt 0 x2) (x3 => Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) x3)) (Metric__uniformity_basis_dist X) (x4 => Lt 0 x4) (x5 => Set__ofPred (p1 => Lt (Dist__dist (Prod__fst p1) (Prod__snd p1)) x5)) (Metric__uniformity_basis_dist Y) f s.

(; //LEAN:Metric.uniformContinuous_iff_le ;)
def Metric__uniformContinuous_iff_le : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (UniformContinuous f) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => forall X (b => if (Leq (Dist__dist a b) x3) (Leq (Dist__dist (f a) (f b)) x2))))))))) :=
  X => Y => x => x1 => f => Filter__HasBasis__uniformContinuous_iff X Y Real Real (x2 => Lt 0 x2) (x3 => Set__ofPred (p => Leq (Dist__dist (Prod__fst p) (Prod__snd p)) x3)) (Metric__uniformity_basis_dist_le X) (x4 => Lt 0 x4) (x5 => Set__ofPred (p1 => Leq (Dist__dist (Prod__fst p1) (Prod__snd p1)) x5)) (Metric__uniformity_basis_dist_le Y) f.

(; //LEAN:Metric.uniformContinuousOn_iff_le ;)
def Metric__uniformContinuousOn_iff_le : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Proof (iff (UniformContinuousOn f s) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem s x4) (forall X (y => if (Membership__mem s y) (if (Leq (Dist__dist x4 y) x3) (Leq (Dist__dist (f x4) (f y)) x2))))))))))) :=
  X => Y => x => x1 => f => s => Filter__HasBasis__uniformContinuousOn_iff X Y Real Real (x2 => Lt 0 x2) (x3 => Set__ofPred (p => Leq (Dist__dist (Prod__fst p) (Prod__snd p)) x3)) (Metric__uniformity_basis_dist_le X) (x4 => Lt 0 x4) (x5 => Set__ofPred (p1 => Leq (Dist__dist (Prod__fst p1) (Prod__snd p1)) x5)) (Metric__uniformity_basis_dist_le Y) f s.

