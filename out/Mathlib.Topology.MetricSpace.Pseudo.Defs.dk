def Metric__nhds_basis_ball_inv_nat_succ : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> Proof (Filter__HasBasis (nhds x1) (x2 => True) (n => Metric__ball x1 (div 1 (plus n 1)))) :=
  X => x => x1 => nhds_basis_uniformity X Nat (x2 => True) (n => Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) (div 1 (plus n 1)))) (Metric__uniformity_basis_dist_inv_nat_succ X) x1.

