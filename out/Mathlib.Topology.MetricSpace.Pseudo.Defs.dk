tendsto_iff_dist_tendsto_zero : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : (Elem Y -> X)) -> (x1 : Elem (Filter Y)) -> (a : Elem X) -> Proof (iff (Filter__Tendsto f x1 (nhds a)) (Filter__Tendsto (b => Dist__dist (f b) a) x1 (nhds 0))).

(; //LEAN:Metric.mk_uniformity_basis_of_tendsto ;)
Metric__mk_uniformity_basis_of_tendsto : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (Y : Set) -> (p : (Elem Y -> Prop)) -> (f : (Elem Y -> Real)) -> (l : Elem (Filter Y)) -> (_ : Proof (Filter__NeBot l)) -> (h1 : Proof (forall Y (i2 => if (p i2) (Lt 0 (f i2))))) -> (h2 : Proof (Filter__Eventually (i1 => p i1) l)) -> (hf : Proof (Filter__Tendsto f l (nhds 0))) -> Proof (Filter__HasBasis (uniformity X) p (i => Set__ofPred (x1 => Lt (Dist__dist (Prod__fst x1) (Prod__snd x1)) (f i)))).

(; //LEAN:Metric.ball_subset_interior_closedBall ;)
def Metric__ball_subset_interior_closedBall : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (x2 : Elem Real) -> Proof (Set__Subset (Metric__ball x1 x2) (interior (Metric__closedBall x1 x2))) :=
  X => x => x1 => x2 => interior_maximal X (Metric__closedBall x1 x2) (Metric__ball x1 x2) (Metric__ball_subset_closedBall X x1 x2) (Metric__isOpen_ball X x1 x2).

(; //LEAN:Metric.mem_closure_iff ;)
Metric__mem_closure_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (a : Elem X) -> Proof (iff (Membership__mem (closure s) a) (forall Real (x1 => if (Gt x1 0) (exists X (b => and (Membership__mem s b) (Lt (Dist__dist a b) x1)))))).

(; //LEAN:Metric.mem_closure_range_iff ;)
Metric__mem_closure_range_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (e : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Membership__mem (closure (Set__range e)) a) (forall Real (x1 => if (Gt x1 0) (exists Y (k => Lt (Dist__dist a (e k)) x1))))).

(; //LEAN:Metric.mem_closure_range_iff_nat ;)
Metric__mem_closure_range_iff_nat : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (e : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Membership__mem (closure (Set__range e)) a) (forall Nat (n => exists Y (k => Lt (Dist__dist a (e k)) (div 1 (plus n 1)))))).

(; //LEAN:Metric.mem_of_closed' ;)
Metric__mem_of_closed' : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (hs : Proof (IsClosed s)) -> (a : Elem X) -> Proof (iff (Membership__mem s a) (forall Real (x1 => if (Gt x1 0) (exists X (b => and (Membership__mem s b) (Lt (Dist__dist a b) x1)))))).

(; //LEAN:Metric.dense_iff ;)
Metric__dense_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> Proof (iff (Dense s) (forall X (x1 => forall Real (r => if (Gt r 0) (Set__Nonempty (Inter__inter (Metric__ball x1 r) s)))))).

(; //LEAN:Metric.dense_iff_iUnion_ball ;)
Metric__dense_iff_iUnion_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> Proof (iff (Dense s) (forall Real (r => if (Gt r 0) (Eqt (powerset X) (Set__iUnion (c => Set__iUnion (h1 => Metric__ball c r))) Set__univ)))).

(; //LEAN:Metric.denseRange_iff ;)
Metric__denseRange_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : (Elem Y -> X)) -> Proof (iff (DenseRange f) (forall X (x1 => forall Real (r => if (Gt r 0) (exists Y (y => Lt (Dist__dist x1 (f y)) r)))))).

(; //LEAN:nndist_ofMul ;)
def nndist_ofMul : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (Additive__ofMul__app a) (Additive__ofMul__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Additive__ofMul__app a) (Additive__ofMul__app b)).

(; //LEAN:nndist_ofAdd ;)
def nndist_ofAdd : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (Multiplicative__ofAdd__app a) (Multiplicative__ofAdd__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Multiplicative__ofAdd__app a) (Multiplicative__ofAdd__app b)).

(; //LEAN:nndist_toMul ;)
def nndist_toMul : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (Additive X)) -> (b : Elem (Additive X)) -> Proof (Eqt NNReal (NNDist__nndist (Additive__toMul__app a) (Additive__toMul__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Additive__toMul__app a) (Additive__toMul__app b)).

(; //LEAN:nndist_toAdd ;)
def nndist_toAdd : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (Multiplicative X)) -> (b : Elem (Multiplicative X)) -> Proof (Eqt NNReal (NNDist__nndist (Multiplicative__toAdd__app a) (Multiplicative__toAdd__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Multiplicative__toAdd__app a) (Multiplicative__toAdd__app b)).

(; //LEAN:nndist_toDual ;)
def nndist_toDual : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (OrderDual__toDual__app a) (OrderDual__toDual__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (OrderDual__toDual__app a) (OrderDual__toDual__app b)).

(; //LEAN:nndist_ofDual ;)
def nndist_ofDual : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (OrderDual X)) -> (b : Elem (OrderDual X)) -> Proof (Eqt NNReal (NNDist__nndist (OrderDual__ofDual__app a) (OrderDual__ofDual__app b)) (NNDist__nndist a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (OrderDual__ofDual__app a) (OrderDual__ofDual__app b)).

