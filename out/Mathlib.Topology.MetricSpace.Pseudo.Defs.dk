(; //LEAN:Metric.tendsto_nhdsWithin_nhdsWithin ;)
Metric__tendsto_nhdsWithin_nhdsWithin : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (t : Elem (powerset Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (iff (Filter__Tendsto X Y f (nhdsWithin X a s) (nhdsWithin Y b t)) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem X (powerset X) s x4) (if (Lt (Dist__dist X x4 a) x3) (and (Membership__mem Y (powerset Y) t (f x4)) (Lt (Dist__dist Y (f x4) b) x2)))))))))).

