rship__mem X (powerset X) s y8) (Membership__mem X (powerset X) (Metric__ball X a a1) y8)))) (a2 => if (Lt 0 a2) (exists X (y9 => and (Membership__mem X (powerset X) s y9) (Lt (Dist__dist X a y9) a2)))) (forallI Real (i8 => Eqt Prop (if (Lt 0 i8) (exists X (y16 => and (Membership__mem X (powerset X) s y16) (Membership__mem X (powerset X) (Metric__ball X a i8) y16)))) (if (Lt 0 i8) (exists X (y17 => and (Membership__mem X (powerset X) s y17) (Lt (Dist__dist X a y17) i8))))) (i8 => implies_congr (Lt 0 i8) (Lt 0 i8) (exists X (y10 => and (Membership__mem X (powerset X) s y10) (Membership__mem X (powerset X) (Metric__ball X a i8) y10))) (exists X (y11 => and (Membership__mem X (powerset X) s y11) (Lt (Dist__dist X a y11) i8))) (Eq__refl Prop (Lt 0 i8)) (congrArg (Elem X -> Prop) Prop (y13 => and (Membership__mem X (powerset X) s y13) (Membership__mem X (powerset X) (Metric__ball X a i8) y13)) (y14 => and (Membership__mem X (powerset X) s y14) (Lt (Dist__dist X a y14) i8)) (Exists X) (funext X (x6 => Prop) (x7 => and (Membership__mem X (powerset X) s x7) (Membership__mem X (powerset X) (Metric__ball X a i8) x7)) (x8 => and (Membership__mem X (powerset X) s x8) (Lt (Dist__dist X a x8) i8)) (forallI X (y15 => Eqt Prop (and (Membership__mem X (powerset X) s y15) (Membership__mem X (powerset X) (Metric__ball X a i8) y15)) (and (Membership__mem X (powerset X) s y15) (Lt (Dist__dist X a y15) i8))) (y15 => congrArg Prop Prop (Membership__mem X (powerset X) (Metric__ball X a i8) y15) (Lt (Dist__dist X a y15) i8) (and (Membership__mem X (powerset X) s y15)) (Eq__trans Prop (Membership__mem X (powerset X) (Metric__ball X a i8) y15) (Lt (Dist__dist X y15 a) i8) (Lt (Dist__dist X a y15) i8) (Metric__mem_ball___simp_1 X a y15 i8) (congrFun' Real Prop (Lt (Dist__dist X y15 a)) (Lt (Dist__dist X a y15)) (congrArg Real (Elem Real -> Prop) (Dist__dist X y15 a) (Dist__dist X a y15) Lt (dist_comm X y15 a)) i8)))))))))) (forall Real (x10 => if (Gt x10 0) (exists X (b5 => and (Membership__mem X (powerset X) s b5) (Lt (Dist__dist X a b5) x10)))))) (iff_self (forall Real (i9 => if (Lt 0 i9) (exists X (y18 => and (Membership__mem X (powerset X) s y18) (Lt (Dist__dist X a y18) i9)))))))).

(; //LEAN:Metric.mem_closure_range_iff ;)
Metric__mem_closure_range_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (e : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Membership__mem X (powerset X) (closure X (Set__range X Y e)) a) (forall Real (x1 => if (Gt x1 0) (exists Y (k => Lt (Dist__dist X a (e k)) x1))))).

(; //LEAN:Metric.mem_closure_range_iff_nat ;)
Metric__mem_closure_range_iff_nat : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (e : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Membership__mem X (powerset X) (closure X (Set__range X Y e)) a) (forall Nat (n => exists Y (k => Lt (Dist__dist X a (e k)) (div 1 (plus (Nat__cast Real n) 1)))))).

(; //LEAN:Metric.mem_of_closed' ;)
Metric__mem_of_closed' : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (hs : Proof (IsClosed X s)) -> (a : Elem X) -> Proof (iff (Membership__mem X (powerset X) s a) (forall Real (x1 => if (Gt x1 0) (exists X (b => and (Membership__mem X (powerset X) s b) (Lt (Dist__dist X a b) x1)))))).

(; //LEAN:Metric.dense_iff ;)
Metric__dense_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> Proof (iff (Dense X s) (forall X (x1 => forall Real (r => if (Gt r 0) (Set__Nonempty X (Inter__inter (powerset X) (Metric__ball X x1 r) s)))))).

(; //LEAN:Metric.dense_iff_iUnion_ball ;)
Metric__dense_iff_iUnion_ball : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> Proof (iff (Dense X s) (forall Real (r => if (Gt r 0) (Eqt (powerset X) (Set__iUnion X X (c => Set__iUnion X (Membership__mem X (powerset X) s c) (h1 => Metric__ball X c r))) (Set__univ X))))).

(; //LEAN:Metric.denseRange_iff ;)
Metric__denseRange_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : (Elem Y -> X)) -> Proof (iff (DenseRange X Y f) (forall X (x1 => forall Real (r => if (Gt r 0) (exists Y (y => Lt (Dist__dist X x1 (f y)) r)))))).

(; //LEAN:nndist_ofMul ;)
def nndist_ofMul : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (Additive X) (Additive__ofMul__app a) (Additive__ofMul__app b)) (NNDist__nndist X a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Additive X) (Additive__ofMul__app a) (Additive__ofMul__app b)).

(; //LEAN:nndist_ofAdd ;)
def nndist_ofAdd : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (Multiplicative X) (Multiplicative__ofAdd__app a) (Multiplicative__ofAdd__app b)) (NNDist__nndist X a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (Multiplicative X) (Multiplicative__ofAdd__app a) (Multiplicative__ofAdd__app b)).

(; //LEAN:nndist_toMul ;)
def nndist_toMul : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (Additive X)) -> (b : Elem (Additive X)) -> Proof (Eqt NNReal (NNDist__nndist X (Additive__toMul__app a) (Additive__toMul__app b)) (NNDist__nndist (Additive X) a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist X (Additive__toMul__app a) (Additive__toMul__app b)).

(; //LEAN:nndist_toAdd ;)
def nndist_toAdd : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (Multiplicative X)) -> (b : Elem (Multiplicative X)) -> Proof (Eqt NNReal (NNDist__nndist X (Multiplicative__toAdd__app a) (Multiplicative__toAdd__app b)) (NNDist__nndist (Multiplicative X) a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist X (Multiplicative__toAdd__app a) (Multiplicative__toAdd__app b)).

(; //LEAN:nndist_toDual ;)
def nndist_toDual : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem X) -> (b : Elem X) -> Proof (Eqt NNReal (NNDist__nndist (OrderDual X) (OrderDual__toDual__app a) (OrderDual__toDual__app b)) (NNDist__nndist X a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist (OrderDual X) (OrderDual__toDual__app a) (OrderDual__toDual__app b)).

(; //LEAN:nndist_ofDual ;)
def nndist_ofDual : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (a : Elem (OrderDual X)) -> (b : Elem (OrderDual X)) -> Proof (Eqt NNReal (NNDist__nndist X (OrderDual__ofDual__app a) (OrderDual__ofDual__app b)) (NNDist__nndist (OrderDual X) a b)) :=
  X => x => a => b => rfl NNReal (NNDist__nndist X (OrderDual__ofDual__app a) (OrderDual__ofDual__app b)).

