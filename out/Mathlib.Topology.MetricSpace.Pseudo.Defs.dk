  X => x => x1 => nhds_basis_uniformity X Nat (n => Lt 0 n) (n1 => Set__ofPred (p => Lt (Dist__dist (Prod__fst p) (Prod__snd p)) (div 1 n1))) (Metric__uniformity_basis_dist_inv_nat_pos X) x1.

