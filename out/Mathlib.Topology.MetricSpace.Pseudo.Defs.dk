Metric__uniformSpace_eq_bot : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> Proof (iff (Eqt (UniformSpace X) PseudoMetricSpace__toUniformSpace Bot__bot) (exists Real (r => and (Lt 0 r) (Pairwise (x1 => x2 => Leq r (Dist__dist x1 x2)))))).

