  X => x => x1 => s => nhdsWithin_hasBasis X Real (x2 => Lt 0 x2) (Metric__ball x1) x1 (Metric__nhds_basis_ball X x1) s.

(; //LEAN:Metric.mem_nhdsWithin_iff ;)
def Metric__mem_nhdsWithin_iff : (X : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (x1 : Elem X) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> Proof (iff (Membership__mem (nhdsWithin x1 t) s) (exists Real (x2 => and (Gt x2 0) (Set__Subset (Inter__inter (Metric__ball x1 x2) t) s)))) :=
  X => x => x1 => s => t => Filter__HasBasis__mem_iff X Real (nhdsWithin x1 t) (x2 => Lt 0 x2) (x3 => Inter__inter (Metric__ball x1 x3) t) s (Metric__nhdsWithin_basis_ball X x1 t).

(; //LEAN:Metric.tendsto_nhdsWithin_nhdsWithin ;)
Metric__tendsto_nhdsWithin_nhdsWithin : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (t : Elem (powerset Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (iff (Filter__Tendsto f (nhdsWithin a s) (nhdsWithin b t)) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem s x4) (if (Lt (Dist__dist x4 a) x3) (and (Membership__mem t (f x4)) (Lt (Dist__dist (f x4) b) x2)))))))))).

(; //LEAN:Metric.tendsto_nhdsWithin_nhds ;)
Metric__tendsto_nhdsWithin_nhds : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (s : Elem (powerset X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (iff (Filter__Tendsto f (nhdsWithin a s) (nhds b)) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem s x4) (if (Lt (Dist__dist x4 a) x3) (Lt (Dist__dist (f x4) b) x2))))))))).

(; //LEAN:Metric.tendsto_nhds_nhds ;)
def Metric__tendsto_nhds_nhds : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (b : Elem Y) -> Proof (iff (Filter__Tendsto f (nhds a) (nhds b)) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Lt (Dist__dist x4 a) x3) (Lt (Dist__dist (f x4) b) x2)))))))) :=
  X => Y => x => x1 => f => a => b => Filter__HasBasis__tendsto_iff X Y Real Real (nhds a) (x2 => Lt 0 x2) (Metric__ball a) (nhds b) (x3 => Lt 0 x3) (Metric__ball b) f (Metric__nhds_basis_ball X a) (Metric__nhds_basis_ball Y b).

(; //LEAN:Metric.continuousAt_iff ;)
Metric__continuousAt_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> Proof (iff (ContinuousAt f a) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Lt (Dist__dist x4 a) x3) (Lt (Dist__dist (f x4) (f a)) x2)))))))).

(; //LEAN:Metric.continuousWithinAt_iff ;)
Metric__continuousWithinAt_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (a : Elem X) -> (s : Elem (powerset X)) -> Proof (iff (ContinuousWithinAt f s a) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (x4 => if (Membership__mem s x4) (if (Lt (Dist__dist x4 a) x3) (Lt (Dist__dist (f x4) (f a)) x2))))))))).

(; //LEAN:Metric.continuousOn_iff ;)
Metric__continuousOn_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> (s : Elem (powerset X)) -> Proof (iff (ContinuousOn f s) (forall X (b => if (Membership__mem s b) (forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => if (Membership__mem s a) (if (Lt (Dist__dist a b) x3) (Lt (Dist__dist (f a) (f b)) x2))))))))))).

(; //LEAN:Metric.continuous_iff ;)
def Metric__continuous_iff : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (PseudoMetricSpace Y)) -> (f : (Elem X -> Y)) -> Proof (iff (Continuous f) (forall X (b => forall Real (x2 => if (Gt x2 0) (exists Real (x3 => and (Gt x3 0) (forall X (a => if (Lt (Dist__dist a b) x3) (Lt (Dist__dist (f a) (f b)) x2))))))))) :=
  X => Y => x => x1 => f => Iff__trans (Continuous f) (forall X (x2 => ContinuousAt f x2)) (forall X (b => forall Real (x3 => if (Gt x3 0) (exists Real (x4 => and (Gt x4 0) (forall X (a => if (Lt (Dist__dist a b) x4) (Lt (Dist__dist (f a) (f b)) x3)))))))) (continuous_iff_continuousAt X Y f) (forall_congr' X (ContinuousAt f) (b1 => forall Real (x5 => if (Gt x5 0) (exists Real (x6 => and (Gt x6 0) (forall X (a1 => if (Lt (Dist__dist a1 b1) x6) (Lt (Dist__dist (f a1) (f b1)) x5))))))) (forallI X (x7 => iff (Filter__Tendsto f (nhds x7) (nhds (f x7))) (forall Real (x8 => if (Gt x8 0) (exists Real (x9 => and (Gt x9 0) (forall X (x10 => if (Lt (Dist__dist x10 x7) x9) (Lt (Dist__dist (f x10) (f x7)) x8)))))))) (x7 => Metric__tendsto_nhds_nhds X Y f x7 (f x7)))).

(; //LEAN:Metric.tendsto_nhds ;)
def Metric__tendsto_nhds : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (f : Elem (Filter Y)) -> (u : (Elem Y -> X)) -> (a : Elem X) -> Proof (iff (Filter__Tendsto u f (nhds a)) (forall Real (x1 => if (Gt x1 0) (Filter__Eventually (x2 => Lt (Dist__dist (u x2) a) x1) f)))) :=
  X => Y => x => f => u => a => Filter__HasBasis__tendsto_right_iff Y X Real f (nhds a) (x1 => Lt 0 x1) (Metric__ball a) u (Metric__nhds_basis_ball X a).

(; //LEAN:Metric.continuousAt_iff' ;)
Metric__continuousAt_iff' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem Y -> X)) -> (b : Elem Y) -> Proof (iff (ContinuousAt f b) (forall Real (x2 => if (Gt x2 0) (Filter__Eventually (x3 => Lt (Dist__dist (f x3) (f b)) x2) (nhds b))))).

(; //LEAN:Metric.continuousWithinAt_iff' ;)
Metric__continuousWithinAt_iff' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem Y -> X)) -> (b : Elem Y) -> (s : Elem (powerset Y)) -> Proof (iff (ContinuousWithinAt f s b) (forall Real (x2 => if (Gt x2 0) (Filter__Eventually (x3 => Lt (Dist__dist (f x3) (f b)) x2) (nhdsWithin b s))))).

(; //LEAN:Metric.continuousOn_iff' ;)
Metric__continuousOn_iff' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem Y -> X)) -> (s : Elem (powerset Y)) -> Proof (iff (ContinuousOn f s) (forall Y (b => if (Membership__mem s b) (forall Real (x2 => if (Gt x2 0) (Filter__Eventually (x3 => Lt (Dist__dist (f x3) (f b)) x2) (nhdsWithin b s))))))).

(; //LEAN:Metric.continuous_iff' ;)
def Metric__continuous_iff' : (X : Set) -> (Y : Set) -> (_ : Proof (PseudoMetricSpace X)) -> (_ : Proof (TopologicalSpace Y)) -> (f : (Elem Y -> X)) -> Proof (iff (Continuous f) (forall Y (a => forall Real (x2 => if (Gt x2 0) (Filter__Eventually (x3 => Lt (Dist__dist (f x3) (f a)) x2) (nhds a)))))) :=
