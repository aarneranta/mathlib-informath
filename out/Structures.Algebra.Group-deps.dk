Structure : Type.

Oper : (A : Set) -> Type.

appOper : (A : Set) -> (op : Oper A) -> (x : Elem A) -> (y : Elem A) -> Elem A.

UOper : (A : Set) -> Type.

appUOper : (A : Set) -> (op : UOper A) -> (x : Elem A) -> Elem A.

appPrefixUOper : (A : Set) -> (op : UOper A) -> (x : Elem A) -> Elem A.

Rel : (A : Set) -> Type.

appRel : (A : Set) -> (r : Rel A) -> (x : Elem A) -> (y : Elem A) -> Prop.

latticeSup : (A : Set) -> Elem A -> Elem A -> Elem A.

latticeInf : (A : Set) -> Elem A -> Elem A -> Elem A.

Action : (A : Set) -> (B : Set) -> Type.

appAction : (A : Set) -> (B : Set) -> (op : Action A B) -> (r : Elem A) -> (x : Elem B) -> Elem B.
