(; Structures.Algebra.Group: Mathlib's classes as Informath's structures, by MathlibInformath/Export.lean ;)

(; //LEAN:Mul ;)
Mul__structure : (G : Set) -> ({|*|} : Oper G) -> Structure.

(; //LEAN:CommMagma ;)
CommMagma__structure : (G : Set) -> (h : Proof (Mul G)) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (times a b) (times b a))))) -> Structure.

(; //LEAN:CommMagma (predicate) ;)
def CommMagma : (G : Set) -> Prop :=
  G => and (Mul G) (forall G (a => forall G (b => Eqt G (times a b) (times b a)))).

(; //LEAN:Semigroup ;)
Semigroup__structure : (G : Set) -> (h : Proof (Mul G)) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (times (times a b) c) (times a (times b c))))))) -> Structure.

(; //LEAN:Semigroup (predicate) ;)
def Semigroup : (G : Set) -> Prop :=
  G => and (Mul G) (forall G (a => forall G (b => forall G (c => Eqt G (times (times a b) c) (times a (times b c)))))).

(; //LEAN:CommSemigroup ;)
CommSemigroup__structure : (G : Set) -> (h : Proof (Semigroup G)) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (times a b) (times b a))))) -> Structure.

(; //LEAN:CommSemigroup (predicate) ;)
def CommSemigroup : (G : Set) -> Prop :=
  G => and (Semigroup G) (forall G (a => forall G (b => Eqt G (times a b) (times b a)))).

(; //LEAN:MulOneClass ;)
MulOneClass__structure : (M : Set) -> (h : Proof (Mul M)) -> ({|1|} : Elem M) -> (one_mul : Proof (forall M (a => Eqt M (times {|1|} a) a))) -> (mul_one : Proof (forall M (a => Eqt M (times a {|1|}) a))) -> Structure.

(; //LEAN:MulOneClass (predicate) ;)
def MulOneClass : (M : Set) -> Prop :=
  M => and (Mul M) (exists M (e => and (forall M (a => Eqt M (times e a) a)) (forall M (a => Eqt M (times a e) a)))).

(; //LEAN:Monoid ;)
Monoid__structure : (M : Set) -> (h : Proof (Semigroup M)) -> ({|1|} : Elem M) -> (one_mul : Proof (forall M (a => Eqt M (times {|1|} a) a))) -> (mul_one : Proof (forall M (a => Eqt M (times a {|1|}) a))) -> Structure.

(; //LEAN:Monoid (predicate) ;)
def Monoid : (M : Set) -> Prop :=
  M => and (Semigroup M) (exists M (e => and (forall M (a => Eqt M (times e a) a)) (forall M (a => Eqt M (times a e) a)))).

(; //LEAN:CommMonoid ;)
CommMonoid__structure : (M : Set) -> (h : Proof (Monoid M)) -> (mul_comm : Proof (forall M (a => forall M (b => Eqt M (times a b) (times b a))))) -> Structure.

(; //LEAN:CommMonoid (predicate) ;)
def CommMonoid : (M : Set) -> Prop :=
  M => and (Monoid M) (forall M (a => forall M (b => Eqt M (times a b) (times b a)))).

(; //LEAN:DivInvMonoid ;)
DivInvMonoid__structure : (G : Set) -> (h : Proof (Monoid G)) -> ({|⁻¹|} : UOper G) -> Structure.

(; //LEAN:Group ;)
Group__structure : (G : Set) -> (h : Proof (Monoid G)) -> ({|⁻¹|} : UOper G) -> (inv_mul_cancel : Proof (forall G (a => Eqt G (times (appUOper G {|⁻¹|} a) a) 1))) -> Structure.

(; //LEAN:Group (predicate) ;)
def Group : (G : Set) -> Prop :=
  G => and (Monoid G) (exists (G -> G) (i => forall G (a => Eqt G (times (i a) a) 1))).

(; //LEAN:CommGroup ;)
CommGroup__structure : (G : Set) -> (h : Proof (Group G)) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (times a b) (times b a))))) -> Structure.

(; //LEAN:CommGroup (predicate) ;)
def CommGroup : (G : Set) -> Prop :=
  G => and (Group G) (forall G (a => forall G (b => Eqt G (times a b) (times b a)))).

(; //LEAN:AddCommGroup ;)
AddCommGroup__structure : (G : Set) -> (h : Proof (AddGroup G)) -> (add_comm : Proof (forall G (a => forall G (b => Eqt G (plus a b) (plus b a))))) -> Structure.

(; //LEAN:AddCommGroup (predicate) ;)
def AddCommGroup : (G : Set) -> Prop :=
  G => and (AddGroup G) (forall G (a => forall G (b => Eqt G (plus a b) (plus b a)))).

