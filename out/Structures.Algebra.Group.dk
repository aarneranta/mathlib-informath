(; Structures.Algebra.Group: Mathlib's classes as Informath's structures, by MathlibInformath/Export.lean ;)

(; //LEAN:Mul ;)
Mul__structure : (G : Set) -> ({|*|} : Oper G) -> Structure.

(; //LEAN:CommMagma ;)
CommMagma__structure : (G : Set) -> ({|*|} : Oper G) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (appOper G {|*|} a b) (appOper G {|*|} b a))))) -> Structure.

(; //LEAN:Semigroup ;)
Semigroup__structure : (G : Set) -> ({|*|} : Oper G) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|*|} (appOper G {|*|} a b) c) (appOper G {|*|} a (appOper G {|*|} b c))))))) -> Structure.

(; //LEAN:CommSemigroup ;)
CommSemigroup__structure : (G : Set) -> ({|*|} : Oper G) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|*|} (appOper G {|*|} a b) c) (appOper G {|*|} a (appOper G {|*|} b c))))))) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (appOper G {|*|} a b) (appOper G {|*|} b a))))) -> Structure.

(; //LEAN:MulOneClass ;)
MulOneClass__structure : (M : Set) -> (one : Elem M) -> ({|*|} : Oper M) -> (one_mul : Proof (forall M (a => Eqt M (appOper M {|*|} one a) a))) -> (mul_one : Proof (forall M (a => Eqt M (appOper M {|*|} a one) a))) -> Structure.

(; //LEAN:Monoid ;)
Monoid__structure : (M : Set) -> (one : Elem M) -> ({|*|} : Oper M) -> (mul_assoc : Proof (forall M (a => forall M (b => forall M (c => Eqt M (appOper M {|*|} (appOper M {|*|} a b) c) (appOper M {|*|} a (appOper M {|*|} b c))))))) -> (one_mul : Proof (forall M (a => Eqt M (appOper M {|*|} one a) a))) -> (mul_one : Proof (forall M (a => Eqt M (appOper M {|*|} a one) a))) -> Structure.

(; //LEAN:CommMonoid ;)
CommMonoid__structure : (M : Set) -> (one : Elem M) -> ({|*|} : Oper M) -> (mul_assoc : Proof (forall M (a => forall M (b => forall M (c => Eqt M (appOper M {|*|} (appOper M {|*|} a b) c) (appOper M {|*|} a (appOper M {|*|} b c))))))) -> (one_mul : Proof (forall M (a => Eqt M (appOper M {|*|} one a) a))) -> (mul_one : Proof (forall M (a => Eqt M (appOper M {|*|} a one) a))) -> (mul_comm : Proof (forall M (a => forall M (b => Eqt M (appOper M {|*|} a b) (appOper M {|*|} b a))))) -> Structure.

(; //LEAN:DivInvMonoid ;)
DivInvMonoid__structure : (G : Set) -> (one : Elem G) -> ({|*|} : Oper G) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|*|} (appOper G {|*|} a b) c) (appOper G {|*|} a (appOper G {|*|} b c))))))) -> (one_mul : Proof (forall G (a => Eqt G (appOper G {|*|} one a) a))) -> (mul_one : Proof (forall G (a => Eqt G (appOper G {|*|} a one) a))) -> (inv : (Elem G -> Elem G)) -> Structure.

(; //LEAN:Group ;)
Group__structure : (G : Set) -> (one : Elem G) -> ({|*|} : Oper G) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|*|} (appOper G {|*|} a b) c) (appOper G {|*|} a (appOper G {|*|} b c))))))) -> (one_mul : Proof (forall G (a => Eqt G (appOper G {|*|} one a) a))) -> (mul_one : Proof (forall G (a => Eqt G (appOper G {|*|} a one) a))) -> (inv : (Elem G -> Elem G)) -> (inv_mul_cancel : Proof (forall G (a => Eqt G (appOper G {|*|} (inv a) a) one))) -> Structure.

(; //LEAN:CommGroup ;)
CommGroup__structure : (G : Set) -> (one : Elem G) -> ({|*|} : Oper G) -> (mul_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|*|} (appOper G {|*|} a b) c) (appOper G {|*|} a (appOper G {|*|} b c))))))) -> (one_mul : Proof (forall G (a => Eqt G (appOper G {|*|} one a) a))) -> (mul_one : Proof (forall G (a => Eqt G (appOper G {|*|} a one) a))) -> (inv : (Elem G -> Elem G)) -> (inv_mul_cancel : Proof (forall G (a => Eqt G (appOper G {|*|} (inv a) a) one))) -> (mul_comm : Proof (forall G (a => forall G (b => Eqt G (appOper G {|*|} a b) (appOper G {|*|} b a))))) -> Structure.

(; //LEAN:AddCommGroup ;)
AddCommGroup__structure : (G : Set) -> (zero : Elem G) -> ({|+|} : Oper G) -> (add_assoc : Proof (forall G (a => forall G (b => forall G (c => Eqt G (appOper G {|+|} (appOper G {|+|} a b) c) (appOper G {|+|} a (appOper G {|+|} b c))))))) -> (zero_add : Proof (forall G (a => Eqt G (appOper G {|+|} zero a) a))) -> (add_zero : Proof (forall G (a => Eqt G (appOper G {|+|} a zero) a))) -> (nsmul : (Elem Nat -> Elem G -> Elem G)) -> (nsmul_zero : Proof (forall G (x => Eqt G (nsmul 0 x) zero))) -> (nsmul_succ : Proof (forall Nat (n => forall G (x => Eqt G (nsmul (plus n 1) x) (appOper G {|+|} (nsmul n x) x))))) -> (neg : (Elem G -> Elem G)) -> (zsmul : (Elem Int -> Elem G -> Elem G)) -> (zsmul_zero' : Proof (forall G (a => Eqt G (zsmul 0 a) zero))) -> (zsmul_succ' : Proof (forall Nat (n => forall G (a => Eqt G (zsmul (succ n) a) (appOper G {|+|} (zsmul n a) a))))) -> (zsmul_neg' : Proof (forall Nat (n => forall G (a => Eqt G (zsmul (Int__negSucc n) a) (neg (zsmul (succ n) a)))))) -> (neg_add_cancel : Proof (forall G (a => Eqt G (appOper G {|+|} (neg a) a) zero))) -> (add_comm : Proof (forall G (a => forall G (b => Eqt G (appOper G {|+|} a b) (appOper G {|+|} b a))))) -> Structure.

