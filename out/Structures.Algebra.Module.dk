(; Structures.Algebra.Module: Mathlib's classes as Informath's structures, by MathlibInformath/Export.lean ;)

(; //LEAN:Module ;)
Module__structure : (R : Set) -> (hR : Proof (Semiring R)) -> (M : Set) -> (h : Proof (AddCommMonoid M)) -> ({|•|} : Action R M) -> (mul_smul : Proof (forall R (x => forall R (y => forall M (b => Eqt M (appAction R M {|•|} (times x y) b) (appAction R M {|•|} x (appAction R M {|•|} y b))))))) -> (one_smul : Proof (forall M (b => Eqt M (appAction R M {|•|} 1 b) b))) -> (smul_zero : Proof (forall R (a => Eqt M (appAction R M {|•|} a 0) 0))) -> (smul_add : Proof (forall R (a => forall M (x => forall M (y => Eqt M (appAction R M {|•|} a (plus x y)) (plus (appAction R M {|•|} a x) (appAction R M {|•|} a y))))))) -> (add_smul : Proof (forall R (r => forall R (s => forall M (x => Eqt M (appAction R M {|•|} (plus r s) x) (plus (appAction R M {|•|} r x) (appAction R M {|•|} s x))))))) -> (zero_smul : Proof (forall M (x => Eqt M (appAction R M {|•|} 0 x) 0))) -> Structure.

(; //LEAN:Module (predicate) ;)
def Module : (R : Set) -> (M : Set) -> Prop :=
  R => M => and ((Semiring R)) (and (AddCommMonoid M) (exists (R -> M -> M) ({|•|} => and (forall R (x => forall R (y => forall M (b => Eqt M (appAction R M {|•|} (times x y) b) (appAction R M {|•|} x (appAction R M {|•|} y b)))))) (and (forall M (b => Eqt M (appAction R M {|•|} 1 b) b)) (and (forall R (a => Eqt M (appAction R M {|•|} a 0) 0)) (and (forall R (a => forall M (x => forall M (y => Eqt M (appAction R M {|•|} a (plus x y)) (plus (appAction R M {|•|} a x) (appAction R M {|•|} a y)))))) (and (forall R (r => forall R (s => forall M (x => Eqt M (appAction R M {|•|} (plus r s) x) (plus (appAction R M {|•|} r x) (appAction R M {|•|} s x)))))) (forall M (x => Eqt M (appAction R M {|•|} 0 x) 0))))))))).

