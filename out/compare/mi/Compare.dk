(; Compare: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:oddSum ;)
oddSum : (x : Elem Nat) -> Elem Nat.

(; //LEAN:prime_two' ;)
def prime_two' : Proof (prime 2) :=
  Nat__prime_two.

(; //LEAN:dvd_mul_self' ;)
def dvd_mul_self' : (a : Elem Nat) -> (b : Elem Nat) -> (h : Proof (divide a b)) -> Proof (divide a (times b b)) :=
  a => b => h => Dvd__dvd__mul_right Nat a b h b.

(; //LEAN:mul_comm_group ;)
def mul_comm_group : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (times a b) (times b a)) :=
  G => x => a => b => mul_comm G a b.

(; //LEAN:cast_le' ;)
def cast_le' : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Leq m n)) -> Proof (Leq (Nat__cast Real m) (Nat__cast Real n)) :=
  m => n => h => iffEr (Leq (Nat__cast Real m) (Nat__cast Real n)) (Leq m n) (Nat__cast_le Real m n) h.

(; //LEAN:mem_inter' ;)
def mem_inter' : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (x : Elem X) -> (hs : Proof (Membership__mem X (powerset X) s x)) -> (ht : Proof (Membership__mem X (powerset X) t x)) -> Proof (Membership__mem X (powerset X) (Inter__inter (powerset X) s t) x) :=
  X => s => t => x => hs => ht => andI (Membership__mem X (powerset X) s x) (Membership__mem X (powerset X) t x) hs ht.

(; //LEAN:even_or_odd' ;)
def even_or_odd' : (n : Elem Nat) -> Proof (or (even n) (odd n)) :=
  n => Nat__even_or_odd n.

