(; Core: statements exported from Mathlib by MathlibInformath/Export.lean ;)

(; //LEAN:sumTo ;)
sumTo : (x : Elem Nat) -> Elem Nat.

(; //LEAN:double ;)
def double : (n : Elem Nat) -> Elem Nat :=
  n => plus n n.

(; //LEAN:double_eq ;)
double_eq : (n : Elem Nat) -> Proof (Eq (double n) (times 2 n)).

(; //LEAN:le_double ;)
le_double : (n : Elem Nat) -> (h : Proof (Lt 0 n)) -> Proof (Leq n (double n)).

(; //LEAN:Color ;)
Color : Set.

(; //LEAN:Color.red ;)
Color__red : Elem Color.

(; //LEAN:Color.green ;)
Color__green : Elem Color.

(; //LEAN:instReprColor.repr ;)
instReprColor__repr : (x : Elem Color) -> (x1 : Elem Nat) -> Elem Std__Format.

(; //LEAN:Point.mk ;)
Point__mk : (x : Elem Nat) -> (y : Elem Nat) -> Elem Point.

(; //LEAN:Point ;)
Point : Set.

(; //LEAN:Point.x ;)
Point__x : (self : Elem Point) -> Elem Nat.

(; //LEAN:Point.y ;)
Point__y : (self : Elem Point) -> Elem Nat.

(; //LEAN:Point.swap ;)
def Point__swap : (p : Elem Point) -> Elem Point :=
  p => Point__mk (Point__y p) (Point__x p).

(; //LEAN:exists_bigger ;)
def exists_bigger : (n : Elem Nat) -> Proof (exists Nat (m => Lt n m)) :=
  n => existsI Nat (m => Lt n m) (plus n 1) (Nat__lt_succ_self n).

(; //LEAN:and_swap' ;)
def and_swap' : (p : Prop) -> (q : Prop) -> (h : Proof (and p q)) -> Proof (and q p) :=
  p => q => h => andI q p (andEr p q h) (andEl p q h).

(; //LEAN:evenNum ;)
def evenNum : (n : Elem Nat) -> Prop :=
  n => exists Nat (k => Eq n (times 2 k)).

(; //LEAN:myAxiom ;)
myAxiom : (n : Elem Nat) -> Proof (evenNum (times 2 n)).

(; //LEAN:list_len ;)
def list_len : (X : Set) -> (xs : Elem (List X)) -> Proof (Eq (List__length X xs) (List__length X xs)) :=
  X => xs => rfl Nat (List__length X xs).

(; //LEAN:add_comm' ;)
def add_comm' : (a : Elem Nat) -> (b : Elem Nat) -> Proof (Eq (plus a b) (plus b a)) :=
  a => b => Nat__add_comm a b.

(; //LEAN:and_left' ;)
def and_left' : (p : Prop) -> (q : Prop) -> (h : Proof (and p q)) -> Proof p :=
  p => q => h => andEl p q h.

(; //LEAN:Magma.mk ;)
Magma__mk : (X : Set) -> (op : (Elem X -> (Elem X -> Elem X))) -> Elem (Magma__on X).

(; //LEAN:Magma ;)
Magma : (X : Set) -> Prop.

(; //LEAN:Magma.op ;)
Magma__op : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:op_self ;)
def op_self : (X : Set) -> (_ : Proof (Magma X)) -> (x1 : Elem X) -> Proof (Eqt X (Magma__op X x1 x1) (Magma__op X x1 x1)) :=
  X => x => x1 => rfl X (Magma__op X x1 x1).

