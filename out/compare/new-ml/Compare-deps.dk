(; constants used by Compare, declared with their translated types ;)

(; //LEAN:CommGroup ;)
CommGroup : (G : Set) -> Set.

(; //LEAN:Dvd.dvd.mul_right ;)
Dvd__dvd__mul_right : (X : Set) -> (_ : Proof (Semigroup X)) -> (a : Elem X) -> (b : Elem X) -> (h : Proof (divide a b)) -> (c : Elem X) -> Proof (divide a (times b c)).

(; //LEAN:Inter.inter ;)
Inter__inter : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:Membership.mem ;)
Membership__mem : (X : Set) -> (Z : Set) -> (x : Elem Z) -> (x1 : Elem X) -> Prop.

(; //LEAN:Nat.cast ;)
Nat__cast : (R : Set) -> (x1 : Elem Nat) -> Elem R.

(; //LEAN:Nat.cast_le ;)
Nat__cast_le : (X : Set) -> (_ : Proof (AddMonoidWithOne X)) -> (_ : Proof (PartialOrder X)) -> (_ : Proof (AddLeftMono X)) -> (_ : Proof (ZeroLEOneClass X)) -> (_ : Proof (CharZero X)) -> (m : Elem Nat) -> (n : Elem Nat) -> Proof (iff (Leq (Nat__cast X m) (Nat__cast X n)) (Leq m n)).

(; //LEAN:Nat.even_or_odd ;)
Nat__even_or_odd : (n : Elem Nat) -> Proof (or (even n) (odd n)).

(; //LEAN:Nat.prime_two ;)
Nat__prime_two : Proof (prime 2).

(; //LEAN:mul_comm ;)
mul_comm : (G : Set) -> (_ : Proof (CommMagma G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (times a b) (times b a)).

