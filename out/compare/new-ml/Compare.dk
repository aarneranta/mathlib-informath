(; Compare: declarations exported from Compare.lean by scripts/lean/Export.lean ;)

(; //LEAN:oddSum ;)
def oddSum : (x : Elem Nat) -> Elem Nat.
[] oddSum 0 --> 0
[n] oddSum (succ n) --> plus (oddSum n) (plus (times 2 n) 1).

(; //LEAN:prime_two' ;)
prime_two' : Proof (prime 2).

(; //LEAN:dvd_mul_self' ;)
dvd_mul_self' : (a : Elem Nat) -> (b : Elem Nat) -> (h : Proof (divide a b)) -> Proof (divide a (times b b)).

(; //LEAN:mul_comm_group ;)
mul_comm_group : (G : Set) -> (_ : Proof (CommGroup G)) -> (a : Elem G) -> (b : Elem G) -> Proof (Eqt G (times a b) (times b a)).

(; //LEAN:cast_le' ;)
cast_le' : (m : Elem Nat) -> (n : Elem Nat) -> (h : Proof (Leq m n)) -> Proof (Leq (Nat__cast Real m) (Nat__cast Real n)).

(; //LEAN:mem_inter' ;)
mem_inter' : (X : Set) -> (s : Elem (powerset X)) -> (t : Elem (powerset X)) -> (x : Elem X) -> (hs : Proof (Membership__mem X (powerset X) s x)) -> (ht : Proof (Membership__mem X (powerset X) t x)) -> Proof (Membership__mem X (powerset X) (Inter__inter (powerset X) s t) x).

(; //LEAN:even_or_odd' ;)
even_or_odd' : (n : Elem Nat) -> Proof (or (even n) (odd n)).

