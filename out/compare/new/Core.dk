(; Core: declarations exported from Core.lean by scripts/lean/Export.lean ;)

(; //LEAN:sumTo ;)
def sumTo : (x : Elem Nat) -> Elem Nat.
[] sumTo 0 --> 0
[n] sumTo (succ n) --> plus (sumTo n) (plus n 1).

(; //LEAN:double ;)
def double : (n : Elem Nat) -> Elem Nat :=
  n => plus n n.

(; //LEAN:double_eq ;)
double_eq : (n : Elem Nat) -> Proof (Eq (double n) (times 2 n)).

(; //LEAN:le_double ;)
le_double : (n : Elem Nat) -> (h : Proof (Lt 0 n)) -> Proof (Leq n (double n)).

(; //LEAN:Color ;)
Color : Set.

(; //LEAN:Color.red ;)
Color__red : Elem Color.

(; //LEAN:Color.green ;)
Color__green : Elem Color.

(; //LEAN:Point ;)
Point : Set.

(; //LEAN:Point.mk ;)
Point__mk : (x : Elem Nat) -> (y : Elem Nat) -> Elem Point.

(; //LEAN:Point.x ;)
Point__x : (self : Elem Point) -> Elem Nat.

(; //LEAN:Point.y ;)
Point__y : (self : Elem Point) -> Elem Nat.

(; //LEAN:Point.swap ;)
def Point__swap : (p : Elem Point) -> Elem Point :=
  p => Point__mk (Point__y p) (Point__x p).

(; //LEAN:exists_bigger ;)
exists_bigger : (n : Elem Nat) -> Proof (exists Nat (m => Lt n m)).

(; //LEAN:and_swap' ;)
and_swap' : (p : Prop) -> (q : Prop) -> (h : Proof (and p q)) -> Proof (and q p).

(; //LEAN:evenNum ;)
def evenNum : (n : Elem Nat) -> Prop :=
  n => exists Nat (k => Eq n (times 2 k)).

(; //LEAN:myAxiom ;)
myAxiom : (n : Elem Nat) -> Proof (evenNum (times 2 n)).

(; //LEAN:list_len ;)
list_len : (X : Set) -> (xs : Elem (List X)) -> Proof (Eq (List__length X xs) (List__length X xs)).

(; //LEAN:add_comm' ;)
add_comm' : (a : Elem Nat) -> (b : Elem Nat) -> Proof (Eq (plus a b) (plus b a)).

(; //LEAN:and_left' ;)
and_left' : (p : Prop) -> (q : Prop) -> (h : Proof (and p q)) -> Proof p.

(; //LEAN:Magma ;)
Magma : (X : Set) -> Set.

(; //LEAN:Magma.mk ;)
Magma__mk : (X : Set) -> (op : (Elem X -> (Elem X -> Elem X))) -> Elem (Magma X).

(; //LEAN:Magma.op ;)
Magma__op : (X : Set) -> (x : Elem X) -> (x1 : Elem X) -> Elem X.

(; //LEAN:op_self ;)
op_self : (X : Set) -> (_ : Proof (Magma X)) -> (x1 : Elem X) -> Proof (Eqt X (Magma__op X x1 x1) (Magma__op X x1 x1)).

